      "id": "HIG-PATTERNS-PLAYING-HAPTICS-0016",
      "previous": {
        "title": "Use default Digital Crown haptic detents",
        "statement": {
          "en": "Use the default linear Digital Crown haptic detents on supported Apple Watch models.",
          "ja": "対応するApple Watchではdefaultのlinear Digital Crown haptic detentを使う。"
        },
        "conditions": [
          "Apple Watch Series 4 or later provides detents as people rotate the Digital Crown; some controls add item-based detents."
        ]
      },
      "current": {
        "title": "Account for system-provided Digital Crown haptic detents",
        "statement": {
          "en": "Account for system-provided Digital Crown haptic detents, including control-specific item detents, on supported Apple Watch models.",
          "ja": "対応するApple Watchでは、コントロールごとの項目単位の反応を含む、システムのDigital Crown触覚フィードバックを考慮する。"
        },
        "conditions": [
          "Apple Watch Series 4 or later provides haptic feedback as people rotate the Digital Crown.",
          "The system provides linear detents by default; some system controls, such as table views, provide detents as items enter the screen."
        ]
      },
      "normative_level": "SHOULD",
      "rationale": "Do not turn a descriptive system default into an instruction that overrides item-based control behavior."
    }
  ],
