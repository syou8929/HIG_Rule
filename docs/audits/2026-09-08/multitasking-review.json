        "source_hash": "6d052f56f6853a79f667a25f7415cba083626b904fc07357e075f5b35f267b77",
        "source_sentence_hash": "2d36e48ffa06a2bf427c542b63a130a79e186521bf29bbdfa515cbb5ab370bd3",
        "section_path": [
          "Multitasking",
          "Platform considerations",
          "visionOS"
        ]
      },
      "title": "Avoid pausing visionOS video when gaze moves away",
      "statement": {
        "en": "Avoid pausing a visionOS window's video when people look away from it.",
        "ja": "利用者が視線を外したときvisionOS windowのvideoをpauseしない。"
      },
      "conditions": [
        "People expect playback started in one window to continue while they use another window."
      ],
      "review_note": "Retained AVOID under the conservative don't policy and recorded cross-window playback continuity."
    },
    "HIG-PATTERNS-MULTITASKING-0005": {
      "source": {
        "source_hash": "6d052f56f6853a79f667a25f7415cba083626b904fc07357e075f5b35f267b77",
        "source_sentence_hash": "d7c67a5d8b1c4ad2dd92e0a69ebe1d7fe255717fe1a281b3d97cd7528f9fbd00",
        "section_path": [
          "Multitasking",
          "Platform considerations",
          "visionOS"
        ]
      },
      "title": "Handle visionOS audio ducking",
      "statement": {
        "en": "Prepare for visionOS audio to duck when people look from the app to another app.",
        "ja": "利用者が別appへ視線を移したときvisionOS audioがduckする状況へ備える。"
      },
      "exceptions": [
        "The current Now Playing app does not duck for this reason."
      ],
      "review_note": "Recorded the gaze transition and Now Playing exception."
    },
    "HIG-PATTERNS-MULTITASKING-0007": {
      "source": {
        "source_hash": "6d052f56f6853a79f667a25f7415cba083626b904fc07357e075f5b35f267b77",
        "source_sentence_hash": "ddc1a89566554870941c62649f0c306412ed47acc0f69f25addbf81c12e6c494",
        "section_path": [
          "Multitasking",
          "Best practices"
        ]
      },
      "title": "Always save and restore multitasking context",
      "statement": {
        "en": "Always prepare to save and restore people's context when multitasking begins or ends.",
        "ja": "multitaskingの開始・終了時に利用者のcontextをsave・restoreできるよう常に備える。"
      },
      "conditions": [
        "The app cannot predict when people will initiate multitasking."
      ],
      "review_note": "Recovered and retained the explicit always need with its unpredictable-timing rationale."
    },
    "HIG-PATTERNS-MULTITASKING-0008": {
      "source": {
        "source_hash": "6d052f56f6853a79f667a25f7415cba083626b904fc07357e075f5b35f267b77",
        "source_sentence_hash": "bf551ce583a3f5afce20300fda3c924a7700c678fbbf29952aeb9f1e83529fb1",
        "section_path": [
          "Multitasking",
          "Best practices"
        ]
      },
      "title": "Prevent missed activity content during app switching",
      "statement": {
        "en": "Make sure people do not miss attention-dependent activity content when they switch apps.",
        "ja": "app切替時にattention-dependentなactivity contentを見逃さないようにする。"
      },
      "conditions": [
        "This is especially relevant to games and media-viewing apps."
      ],
      "review_note": "Recovered and retained the explicit make sure requirement and its two example app types."
    },
    "HIG-PATTERNS-MULTITASKING-0009": {
      "source": {
        "source_hash": "6d052f56f6853a79f667a25f7415cba083626b904fc07357e075f5b35f267b77",
        "source_sentence_hash": "bf551ce583a3f5afce20300fda3c924a7700c678fbbf29952aeb9f1e83529fb1",
        "section_path": [
          "Multitasking",
          "Best practices"
        ]
      },
      "title": "Resume activities from their prior context",
      "statement": {
        "en": "When people return after app switching, let them continue an activity from where they left it.",
        "ja": "app切替後に戻ったとき、離れたcontextからactivityを続行できるようにする。"
      },
      "review_note": "Recovered the return-path continuation rule as a separate state-restoration outcome."
    },
    "HIG-PATTERNS-MULTITASKING-0010": {
      "source": {
        "source_hash": "6d052f56f6853a79f667a25f7415cba083626b904fc07357e075f5b35f267b77",
        "source_sentence_hash": "ce80bb7f60ebd443f29489e3326ba96f867854d0cbaf3540a90cc5a24246fd30",
        "section_path": [
          "Multitasking",
          "Best practices"
        ]
      },
      "title": "Consider important background-task completion notifications",
      "statement": {
        "en": "Consider notifying people when an important or time-sensitive background task completes.",
        "ja": "重要またはtime-sensitiveなbackground task完了時の通知を検討する。"
      },
      "normative_level": "MAY",
      "conditions": [
        "A notification can help people return and take the next step."
      ],
      "review_note": "Recovered the optional notification case and retained both importance qualifiers."
    },
    "HIG-PATTERNS-MULTITASKING-0011": {
      "source": {
        "source_hash": "6d052f56f6853a79f667a25f7415cba083626b904fc07357e075f5b35f267b77",
        "source_sentence_hash": "ce80bb7f60ebd443f29489e3326ba96f867854d0cbaf3540a90cc5a24246fd30",
        "section_path": [
          "Multitasking",
          "Best practices"
        ]
      },
      "title": "Avoid routine background-task completion notifications",
      "statement": {
        "en": "Avoid notifying people immediately when a routine or secondary background task completes.",
        "ja": "routineまたはsecondaryなbackground task完了直後の通知を避ける。"
      },
      "exceptions": [
        "Let people check the task when they return to the app."
      ],
      "review_note": "Recovered the unnecessary-notification AVOID and its passive-return alternative."
    },
    "HIG-PATTERNS-MULTITASKING-0014": {
      "source": {
        "source_hash": "6d052f56f6853a79f667a25f7415cba083626b904fc07357e075f5b35f267b77",
        "source_sentence_hash": "448f6b1031f83624fc684b9aa2a30029a78f484b9512c6f14f599f335c99e0d1",
        "section_path": [
          "Multitasking",
          "Best practices"
        ]
      },
      "title": "Pause attention-dependent activities during app switching",
      "statement": {
        "en": "Pause activities that require attention or active participation when people switch away.",
        "ja": "利用者が切り替えたときattentionまたはactive participationを要するactivityをpauseする。"
      },
      "review_note": "Recovered the activity-pause rule and preserved both applicability criteria."
    },
    "HIG-PATTERNS-MULTITASKING-0017": {
      "source": {
        "source_hash": "6d052f56f6853a79f667a25f7415cba083626b904fc07357e075f5b35f267b77",
        "source_sentence_hash": "7034c419e96cf212885223e6032fb8fc3459e2dab00759231158a819fce5c935",
        "section_path": [
          "Multitasking",
          "Best practices"
        ]
      },
      "title": "Finish user-initiated background tasks before suspension",
      "statement": {
        "en": "Finish a user-initiated task that needs no more input in the background before suspending.",
        "ja": "追加input不要のuser-initiated taskをsuspend前にbackgroundで完了する。"
      },
      "conditions": [
        "Examples include downloading assets and processing a video file."
      ],
      "review_note": "Recovered the completion rule and preserved its no-more-input condition and examples."
    },
    "HIG-PATTERNS-MULTITASKING-0006": {
      "source": {
        "source_hash": "6d052f56f6853a79f667a25f7415cba083626b904fc07357e075f5b35f267b77",
        "source_sentence_hash": "368b4d12ed4fc6281a7037c51be98ede79195f089a5d94a43f95352a9a1089b7",
        "section_path": [
          "Multitasking"
        ]
      },
      "title": "Support multitasking except in rare cases",
      "statement": {
        "en": "Make every app work well with multitasking except in rare justified cases.",
        "ja": "正当な稀な例外を除き、すべてのappをmultitaskingへ適切に対応させる。"
      },
      "exceptions": [
        "Some games and visionOS apps running in a Full Space can be rare exceptions."
      ],
      "review_note": "Recovered and retained the explicit every-app need while preserving both named exception classes."
    }
  },
