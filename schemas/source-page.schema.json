{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/apple-hig-source-page.schema.json",
  "title": "Copyright-safe Apple HIG Source Page Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "url", "canonical_url", "slug", "title", "category", "page_kind",
    "platforms", "retrieved_at", "source_hash", "summary", "section_paths",
    "guidance_candidates", "reference_notes", "related_hig_urls"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "url": { "type": "string", "format": "uri" },
    "canonical_url": { "type": "string", "format": "uri" },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "category": { "enum": ["getting-started", "foundations", "patterns", "components", "inputs", "technologies", "unclassified"] },
    "page_kind": { "enum": ["root", "category", "subcategory", "guidance", "unknown"] },
    "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["ios", "ipados", "macos", "tvos", "visionos", "watchos", "carplay", "web"] } },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "source_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "summary": { "$ref": "#/$defs/localizedText" },
    "section_paths": { "type": "array", "items": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } },
    "guidance_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "section_path", "source_sentence_hash", "word_count"],
        "properties": {
          "text": { "type": "string", "minLength": 2, "maxLength": 180 },
          "section_path": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "source_sentence_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "word_count": { "type": "integer", "minimum": 1, "maximum": 19 }
        }
      }
    },
    "reference_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_path", "note"],
        "properties": {
          "section_path": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "related_hig_urls": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "uri" } }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ja"],
      "properties": { "en": { "type": "string", "minLength": 1 }, "ja": { "type": "string", "minLength": 1 } }
    }
  }
}
