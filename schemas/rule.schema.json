{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/apple-hig-rule.schema.json",
  "title": "Apple HIG Atomic Rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "title", "category", "topic", "subtopic", "statement", "normative_level",
    "confidence", "review_required", "polarity", "scope", "conditions", "exceptions",
    "rationale", "checks", "testability", "severity", "anti_patterns", "positive_examples",
    "source", "tags", "priority_rank", "status"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^HIG-[A-Z0-9-]+-[0-9]{4}$" },
    "title": { "type": "string", "minLength": 3, "maxLength": 180 },
    "category": { "enum": ["getting-started", "foundations", "patterns", "components", "inputs", "technologies"] },
    "topic": { "type": "string", "minLength": 1 },
    "subtopic": { "type": "string", "minLength": 1 },
    "statement": { "$ref": "#/$defs/localizedText" },
    "normative_level": { "enum": ["MUST", "SHOULD", "MAY", "AVOID", "MUST_NOT"] },
    "confidence": { "enum": ["high", "medium", "low"] },
    "review_required": { "type": "boolean" },
    "polarity": { "enum": ["require", "recommend", "permit", "discourage", "prohibit"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portability", "platforms", "devices", "components", "modalities"],
      "properties": {
        "portability": { "enum": ["universal", "apple-platform", "platform-specific", "apple-component-specific", "technology-specific"] },
        "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["ios", "ipados", "macos", "tvos", "visionos", "watchos", "carplay", "web"] } },
        "devices": { "type": "array", "uniqueItems": true, "items": { "enum": ["iphone", "ipad", "mac", "apple-tv", "apple-watch", "apple-vision-pro", "carplay-display"] } },
        "components": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "modalities": { "type": "array", "uniqueItems": true, "items": { "enum": ["touch", "keyboard", "pointer", "screen-reader", "voice", "gaze", "gesture", "remote-control", "game-controller", "digital-crown"] } }
      }
    },
    "conditions": { "$ref": "#/$defs/stringArray" },
    "exceptions": { "$ref": "#/$defs/stringArray" },
    "rationale": { "$ref": "#/$defs/localizedText" },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automated", "manual"],
      "properties": {
        "automated": { "$ref": "#/$defs/stringArray" },
        "manual": { "$ref": "#/$defs/stringArray" }
      }
    },
    "testability": { "enum": ["automated", "manual", "hybrid"] },
    "severity": { "enum": ["error", "warning", "info"] },
    "anti_patterns": { "$ref": "#/$defs/stringArray" },
    "positive_examples": { "$ref": "#/$defs/stringArray" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "page_title", "section_path", "retrieved_at", "source_hash", "source_sentence_hash", "evidence_paraphrase"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://developer\\.apple\\.com/design/human-interface-guidelines" },
        "page_title": { "type": "string", "minLength": 1 },
        "section_path": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "source_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_sentence_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "evidence_paraphrase": { "type": "string", "minLength": 3, "maxLength": 280 }
      }
    },
    "apple_native_rule": { "type": "string", "minLength": 3 },
    "portable_interpretation": { "type": "string", "minLength": 3 },
    "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
    "priority_rank": { "type": "integer", "minimum": 1, "maximum": 9 },
    "status": { "enum": ["active", "deprecated"] },
    "deprecated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ja"],
      "properties": {
        "en": { "type": "string", "minLength": 3 },
        "ja": { "type": "string", "minLength": 1 }
      }
    },
    "stringArray": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
