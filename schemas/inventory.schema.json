{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/apple-hig-inventory.schema.json",
  "title": "Apple HIG Source Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_root", "generated_at", "discovery_method", "categories", "pages"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "source_root": { "type": "string", "format": "uri", "pattern": "^https://developer\\.apple\\.com/design/human-interface-guidelines$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "discovery_method": { "type": "string", "minLength": 1 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["getting-started", "foundations", "patterns", "components", "inputs", "technologies"] }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "status": { "enum": ["discovered", "fetched", "parsed", "classified", "rules_extracted", "validated", "skipped", "blocked"] },
    "category": { "enum": ["getting-started", "foundations", "patterns", "components", "inputs", "technologies", "unclassified"] },
    "statusEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "at"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "at": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url", "canonical_url", "slug", "title", "category", "parent_url", "depth", "page_kind",
        "status", "status_history", "discovered_at", "retrieved_at", "source_hash", "section_count",
        "candidate_count", "rule_count", "error"
      ],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "canonical_url": { "type": "string", "format": "uri" },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/category" },
        "parent_url": { "anyOf": [{ "type": "string", "format": "uri" }, { "type": "null" }] },
        "depth": { "type": "integer", "minimum": 0 },
        "page_kind": { "enum": ["root", "category", "subcategory", "guidance", "unknown"] },
        "status": { "$ref": "#/$defs/status" },
        "status_history": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/statusEntry" } },
        "discovered_at": { "type": "string", "format": "date-time" },
        "retrieved_at": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
        "source_hash": { "anyOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }] },
        "section_count": { "type": "integer", "minimum": 0 },
        "candidate_count": { "type": "integer", "minimum": 0 },
        "rule_count": { "type": "integer", "minimum": 0 },
        "error": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    }
  }
}
