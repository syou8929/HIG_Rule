  "guidance_candidates": [
    {
      "text": "For each menu item, write a label that clearly and succinctly describes it",
      "section_path": [
        "Menus",
        "Labels"
      ],
      "source_sentence_hash": "a66e118313d741fe466683a89dc6c0394999d16af11ade4c10a0b6812fb70bec",
      "word_count": 13
    },
    {
      "text": "To be consistent with platform experiences, use title-style capitalization",
      "section_path": [
        "Menus",
        "Labels"
      ],
      "source_sentence_hash": "5194602aff4fd1faf5f71eae65e34c39af42b963674df11ab575b776e20b0b69",
      "word_count": 9
    },
    {
      "text": "Remove articles like a, an, and the from menu-item labels to save space",
      "section_path": [
        "Menus",
        "Labels"
      ],
      "source_sentence_hash": "e1dca0eebe0560d8a0e813fd3a7fde51d0cee4818db3aecd34e470f4be921ea8",
      "word_count": 13
    },
    {
      "text": "Show people when a menu item is unavailable",
      "section_path": [
        "Menus",
        "Labels"
      ],
      "source_sentence_hash": "337cd5c2235f7ceaf747790292f41c8aaf31220213f0195d16b2f83d745ddc31",
      "word_count": 8
    },
    {
      "text": "Append an ellipsis to a menu item’s label when the action requires more information before it can complete",
      "section_path": [
        "Menus",
        "Labels"
      ],
      "source_sentence_hash": "cd5b2c29bd673e3cff324703eaac8bc9e583fc17b470d6de1c6348e1986792c5",
      "word_count": 18
    },
    {
      "text": "Represent common actions consistently",
      "section_path": [
        "Menus",
        "Icons"
      ],
      "source_sentence_hash": "437e6c622ecacf143035223a8fc838ed701b37999cb04162625b38194ed19a3b",
      "word_count": 4
    },
    {
      "text": "Use menu item icons sparingly and with purpose",
      "section_path": [
        "Menus",
        "Icons"
      ],
      "source_sentence_hash": "04a52c0362240a0143df25b8cfe703fa93c4aad4ca633df8005425b1e920bfed",
      "word_count": 8
    },
    {
      "text": "Apply a uniform visual treatment across menu items in the same group",
      "section_path": [
        "Menus",
        "Icons"
      ],
      "source_sentence_hash": "ce531e77a80522cecfb2fa3ed224321bbbbed12cd048f1e25b88aed4b243dc28",
      "word_count": 12
    },
    {
      "text": "Prefer listing important or frequently used menu items first",
      "section_path": [
        "Menus",
        "Organization"
      ],
      "source_sentence_hash": "772118b9fe6822fa179bd8e9c535b8598a30493620f68e4905569d490d573690",
      "word_count": 9
    },
    {
      "text": "Consider grouping logically related items",
      "section_path": [
        "Menus",
        "Organization"
      ],
      "source_sentence_hash": "1ba3887326fd47825c2753ead445149df5a2db2aa5c263090797f8e6e1344c92",
      "word_count": 5
    },
    {
      "text": "Prefer keeping all logically related commands in the same group, even if the commands don’t all have the same",
      "section_path": [
        "Menus",
        "Organization"
      ],
      "source_sentence_hash": "4c68d60a63d809584fe40818b2c263072ce1b0264106bd2f784ec64ed0ed96a3",
      "word_count": 19
    },
    {
      "text": "Be mindful of menu length",
      "section_path": [
        "Menus",
        "Organization"
      ],
      "source_sentence_hash": "49b92638c46a33bfa135138d9e80e99bf9e6853c85739269c976080821777e3c",
      "word_count": 5
    },
    {
      "text": "Use submenus sparingly",
      "section_path": [
        "Menus",
        "Submenus"
      ],
      "source_sentence_hash": "a04270cf9058ef9d71fce68f64b2007f6b11527a99c9345ece7a7c45ba97aea1",
      "word_count": 3
    },
    {
      "text": "Limit the depth and length of submenus",
      "section_path": [
        "Menus",
        "Submenus"
      ],
      "source_sentence_hash": "1d39f7fef16791424f166f16a5f9476d0be86afa315446fbf665d79c6ed953f5",
      "word_count": 7
    },
    {
      "text": "Make sure a submenu remains available even when its nested menu items are unavailable",
      "section_path": [
        "Menus",
        "Submenus"
      ],
      "source_sentence_hash": "ea6ef854e6cecd51c4ff47f22eca8bdd5de405388f6c67ae5a40e43761d1a0ee",
      "word_count": 14
    },
    {
      "text": "Prefer using a submenu to indenting menu items",
      "section_path": [
        "Menus",
        "Submenus"
      ],
      "source_sentence_hash": "3683771cb4d03102cc6e32d09f323d3b48dc1686ca61ebb5cd0c9e34451cb35d",
      "word_count": 8
    },
    {
      "text": "Consider using a changeable label that describes an item’s current state",
      "section_path": [
        "Menus",
        "Toggled items"
      ],
      "source_sentence_hash": "beaafcefa2cf286f3d03daa495d77b65ec1b4ad6b5eabf673d0118143c5a4d48",
      "word_count": 11
    },
    {
      "text": "Include a verb if a changeable label isn’t clear enough",
      "section_path": [
        "Menus",
        "Toggled items"
      ],
      "source_sentence_hash": "6ee087724735e489ed0c37c185f15178107c8e0cb7cbe2232f2c1addc05c5ffa",
      "word_count": 10
    },
    {
      "text": "If necessary, display both menu items instead of one toggled item",
      "section_path": [
        "Menus",
        "Toggled items"
      ],
      "source_sentence_hash": "e900d983ba5742371143b527d4895a3690c8dd4c563a5daa61f7760c3485293f",
      "word_count": 11
    },
    {
      "text": "Consider using a checkmark to show that an attribute is currently in effect",
      "section_path": [
        "Menus",
        "Toggled items"
      ],
      "source_sentence_hash": "741aaa8e4ffb03cdb911c470d411678499ddb614a97531152403b841086aa71d",
      "word_count": 13
    },
    {
      "text": "Consider offering a menu item that makes it easy to remove multiple toggled attributes",
      "section_path": [
        "Menus",
        "Toggled items"
      ],
      "source_sentence_hash": "e18d94aa62a108a941da479e2eb01dfe6d93a3377841875b96a82f77eb2d1d4c",
      "word_count": 14
    },
    {
      "text": "Let players navigate in-game menus using the platform’s default interaction method",
      "section_path": [
        "Menus",
        "In-game menus"
      ],
      "source_sentence_hash": "ea2b3c191996ce13fee5333fdda8616be33344c67b5c676f21696de00197544c",
      "word_count": 11
    },
    {
      "text": "Make sure your menus remain easy to open and read on all platforms you support",
      "section_path": [
        "Menus",
        "In-game menus"
      ],
      "source_sentence_hash": "59b275601c278297af0a3bea33418f19b38d4e5a640955ba09e072c3cd88df17",
      "word_count": 15
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "Menus",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "Large (the default)",
      "section_path": [
        "Menus",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "4a197ef2cb91e276abb751064298f93947d9d17db75cce4a8090ed0f0d90ec51",
      "word_count": 3
    },
    {
      "text": "Choose a small or medium menu layout when it can help streamline people’s choices",
      "section_path": [
        "Menus",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "4680af00d57e9460c06f26127f75bcb91ba8b3e9b51e3d4c0de6e5aa053753c1",
      "word_count": 14
    },
    {
      "text": "Prefer displaying a menu near the content it controls",
      "section_path": [
        "Menus",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "fab27157c9ae10f16e19979d591d90442faafa6641025e9466967dd7af4e88d7",
      "word_count": 9
    },
    {
      "text": "Prefer the subtle breakthrough effect in most cases",
      "section_path": [
        "Menus",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "9dd9fc1d86449b64aa22fe855206444e63ae48384cb61a1e82081e770fbf3623",
      "word_count": 8
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Menus",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
