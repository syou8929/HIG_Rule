  "guidance_candidates": [
    {
      "text": "Identify essential, dynamic content that people want to view at a glance",
      "section_path": [
        "Complications",
        "Best practices"
      ],
      "source_sentence_hash": "3a07a53bfed76c3af73f00e55b1e585019740f6bf0f7f0afcd3e4386685c24ae",
      "word_count": 12
    },
    {
      "text": "Support all complication families when possible",
      "section_path": [
        "Complications",
        "Best practices"
      ],
      "source_sentence_hash": "ec65e92a6a8e88e1f69746068f3e2e20acc74f18101dfc8fbb794c570fcdb18f",
      "word_count": 6
    },
    {
      "text": "Consider creating multiple complications for each family",
      "section_path": [
        "Complications",
        "Best practices"
      ],
      "source_sentence_hash": "b2c301ae1e7d0e462191db94a30dc1fce5022b1daaa468da171ee370ee8df6aa",
      "word_count": 7
    },
    {
      "text": "Define a different deep link for each complication you support",
      "section_path": [
        "Complications",
        "Best practices"
      ],
      "source_sentence_hash": "0fdca55704357567e12ebf84efa7538ee6538d830a9d5c312cdd208bfff1dab6",
      "word_count": 10
    },
    {
      "text": "Keep privacy in mind",
      "section_path": [
        "Complications",
        "Best practices"
      ],
      "source_sentence_hash": "33749ad7a4b9d03aa2976ae7c0931f8ba7f63b8a02347e7591c34d9c540eae52",
      "word_count": 4
    },
    {
      "text": "Carefully consider when to update data",
      "section_path": [
        "Complications",
        "Best practices"
      ],
      "source_sentence_hash": "7af0ae8a72eedbc225fa872d25eba222e6c9d1e44b722e11f64f6c3224507057",
      "word_count": 6
    },
    {
      "text": "Choose a ring or gauge style based on the data you need to display",
      "section_path": [
        "Complications",
        "Visual design"
      ],
      "source_sentence_hash": "40a709cc4ea1e1502b4592f795d7963ee4be6a0a135c98ca33e3731d3db8462e",
      "word_count": 14
    },
    {
      "text": "Make sure images look good in tinted mode",
      "section_path": [
        "Complications",
        "Visual design"
      ],
      "source_sentence_hash": "a5b97b31f482c75907fd3fba9cbf5937d311366f0480db440b89b80c228fbea7",
      "word_count": 8
    },
    {
      "text": "Recognize that people might prefer to use tinted mode for complications, instead of viewing them in full color",
      "section_path": [
        "Complications",
        "Visual design"
      ],
      "source_sentence_hash": "8cc1445c7bc3001d714032489db18a0b336efdbb0fbade0fb12d34463ce1e498",
      "word_count": 18
    },
    {
      "text": "When creating complication content, generally use line widths of two points or greater",
      "section_path": [
        "Complications",
        "Visual design"
      ],
      "source_sentence_hash": "a216df599a0dc54afc28dc7ed289648d03d56a8b19c45308f512f9be6d68378c",
      "word_count": 13
    },
    {
      "text": "Provide a set of static placeholder images for each complication you support",
      "section_path": [
        "Complications",
        "Visual design"
      ],
      "source_sentence_hash": "31265aca5400107665740ad5834bf31eb1df623a4ce168af24956102e3947133",
      "word_count": 12
    },
