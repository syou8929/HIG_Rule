  "guidance_candidates": [
    {
      "text": "Prefer the system-provided media player",
      "section_path": [
        "AirPlay",
        "Best practices"
      ],
      "source_sentence_hash": "84fbca0df1b26801ec369f36fdb96905bd8732dfa48bdb1923d9214c19ff4968",
      "word_count": 5
    },
    {
      "text": "Provide content in the highest possible resolution",
      "section_path": [
        "AirPlay",
        "Best practices"
      ],
      "source_sentence_hash": "20d4c5eea47277b28928ed8e1aaf27819f017159d42bbe3c336023b93a879362",
      "word_count": 7
    },
    {
      "text": "Stream only the content people expect",
      "section_path": [
        "AirPlay",
        "Best practices"
      ],
      "source_sentence_hash": "d39f7e217e6f59da28bb58aa3c79352beb2c0c70178ee3f47f94bfb53c0f50d4",
      "word_count": 6
    },
    {
      "text": "Support both AirPlay streaming and mirroring",
      "section_path": [
        "AirPlay",
        "Best practices"
      ],
      "source_sentence_hash": "4a95e7c3ea1cd35473959c729c74f61ce52c96c400059ca87d1dc8791fe22620",
      "word_count": 6
    },
    {
      "text": "Support remote control events",
      "section_path": [
        "AirPlay",
        "Best practices"
      ],
      "source_sentence_hash": "41c504b711d0d3fc0bac08cd3bc25841c95508b90e35e9ab33f8d84e5975028d",
      "word_count": 4
    },
    {
      "text": "Don’t stop playback when your app enters the background or when the device locks",
      "section_path": [
        "AirPlay",
        "Best practices"
      ],
      "source_sentence_hash": "29bd2697cdd9899db0e97fc861a40d288b1b95378f1a32b4b4e7919fe47f7422",
      "word_count": 14
    },
    {
      "text": "Don’t interrupt another app’s playback unless your app is starting to play immersive content",
      "section_path": [
        "AirPlay",
        "Best practices"
      ],
      "source_sentence_hash": "e668722f7ea63f42511cd2b083e1b6ef4da23fe32f261f18560f8b8fbe1508c0",
      "word_count": 14
    },
    {
      "text": "Let people use other parts of your app during playback",
      "section_path": [
        "AirPlay",
        "Best practices"
      ],
      "source_sentence_hash": "3054441ae684c4161fc71696ef84624085f8c6109571247755d1d83437ab0325",
      "word_count": 10
    },
    {
      "text": "If necessary, provide a custom interface for controlling media playback",
      "section_path": [
        "AirPlay",
        "Best practices"
      ],
      "source_sentence_hash": "77cf9648be37993672ae40226761a7519f03d238744fd6977830b0988edd30ea",
      "word_count": 10
    },
    {
