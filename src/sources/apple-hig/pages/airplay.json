  "guidance_candidates": [
    {
      "text": "Prefer the system-provided media player",
      "section_path": [
        "AirPlay",
        "Best practices"
      ],
      "source_sentence_hash": "b7ff013831f9e3a7338fc025414b3e1236b8d489d3363fc5dbc4e93fd22df240",
      "word_count": 5
    },
    {
      "text": "Consider a custom video player only when the system-provided player cannot meet the app’s needs",
      "section_path": [
        "AirPlay",
        "Best practices"
      ],
      "source_sentence_hash": "b7ff013831f9e3a7338fc025414b3e1236b8d489d3363fc5dbc4e93fd22df240",
      "word_count": 15
    },
    {
      "text": "Provide content in the highest possible resolution",
      "section_path": [
        "AirPlay",
        "Best practices"
      ],
      "source_sentence_hash": "63f6cfc220cb28002b492613f068e54eec02e96bfd743435604dfe200d194b56",
      "word_count": 7
    },
    {
      "text": "Ensure an HLS playlist includes the full range of available content resolutions",
      "section_path": [
        "AirPlay",
        "Best practices"
      ],
      "source_sentence_hash": "63f6cfc220cb28002b492613f068e54eec02e96bfd743435604dfe200d194b56",
      "word_count": 12
    },
    {
      "text": "Use AirPlay to stream only the content people expect",
      "section_path": [
        "AirPlay",
        "Best practices"
      ],
      "source_sentence_hash": "ff3272cb4b716f882de42eb4bc47927ea477544bbfac583fa75f0f4716c9d3f4",
      "word_count": 9
    },
    {
      "text": "Support both AirPlay streaming and mirroring",
      "section_path": [
        "AirPlay",
        "Best practices"
      ],
      "source_sentence_hash": "843fdbf478e7082d8659d20ca7def4a4369a5eea22f8c6c8f000fc0b7302037a",
      "word_count": 6
    },
    {
      "text": "Support remote control events",
      "section_path": [
        "AirPlay",
        "Best practices"
      ],
      "source_sentence_hash": "364ab2ded29ee592789a70b8226baba0d99ffa255901e9c3d4e1b42ba2504ca4",
      "word_count": 4
    },
    {
      "text": "Don’t stop playback when your app enters the background or when the device locks",
      "section_path": [
        "AirPlay",
        "Best practices"
      ],
      "source_sentence_hash": "d6a4f1021da50e186fb67fee8b5002b80c4deacc127ad164045b00a5f6a9b94e",
      "word_count": 14
    },
    {
      "text": "Never mirror unrelated device content automatically while AirPlay playback continues in the background",
      "section_path": [
        "AirPlay",
        "Best practices"
      ],
      "source_sentence_hash": "d6a4f1021da50e186fb67fee8b5002b80c4deacc127ad164045b00a5f6a9b94e",
      "word_count": 13
    },
    {
      "text": "Don’t interrupt another app’s playback unless your app is starting to play immersive content",
      "section_path": [
        "AirPlay",
        "Best practices"
      ],
      "source_sentence_hash": "1624ac43b9551151342732a0c899967d1a011479def74eb694910e43218a9d5f",
      "word_count": 14
    },
    {
      "text": "Let people use other parts of your app during playback",
      "section_path": [
        "AirPlay",
        "Best practices"
      ],
      "source_sentence_hash": "de53283154b77835f2c1bd3bcaa9647070893f107d5332f511b84c2cbe496f8e",
      "word_count": 10
    },
    {
      "text": "Ensure the app remains functional while AirPlay is active",
      "section_path": [
        "AirPlay",
        "Best practices"
      ],
      "source_sentence_hash": "de53283154b77835f2c1bd3bcaa9647070893f107d5332f511b84c2cbe496f8e",
      "word_count": 9
    },
    {
      "text": "Ensure other in-app videos do not interrupt active AirPlay after navigation",
      "section_path": [
        "AirPlay",
        "Best practices"
      ],
      "source_sentence_hash": "de53283154b77835f2c1bd3bcaa9647070893f107d5332f511b84c2cbe496f8e",
      "word_count": 11
    },
    {
      "text": "Provide an intuitive AirPlay entry in a necessary custom media player",
      "section_path": [
        "AirPlay",
        "Best practices"
      ],
      "source_sentence_hash": "e10aefa1d2f37b4d0a7a2e03088a10a0b43f075083b951814eb6ed63743204c6",
      "word_count": 11
    },
    {
      "text": "Be sure to provide custom AirPlay buttons that match system-provided appearance and behavior",
      "section_path": [
        "AirPlay",
        "Best practices"
      ],
      "source_sentence_hash": "e10aefa1d2f37b4d0a7a2e03088a10a0b43f075083b951814eb6ed63743204c6",
      "word_count": 14
    },
    {
      "text": "Ensure custom AirPlay buttons show distinct playback states",
      "section_path": [
        "AirPlay",
        "Best practices"
      ],
      "source_sentence_hash": "e10aefa1d2f37b4d0a7a2e03088a10a0b43f075083b951814eb6ed63743204c6",
      "word_count": 9
    },
    {
      "text": "Use only Apple-provided symbols in custom controls that initiate AirPlay",
      "section_path": [
        "AirPlay",
        "Best practices"
      ],
      "source_sentence_hash": "e10aefa1d2f37b4d0a7a2e03088a10a0b43f075083b951814eb6ed63743204c6",
      "word_count": 10
    },
    {
      "text": "Position the AirPlay icon in the lower-right of custom players on supported iOS and iPadOS versions",
      "section_path": [
        "AirPlay",
        "Best practices"
      ],
      "source_sentence_hash": "e10aefa1d2f37b4d0a7a2e03088a10a0b43f075083b951814eb6ed63743204c6",
      "word_count": 17
    },
    {
      "text": "Use the black AirPlay icon on light backgrounds when other technology icons are black",
      "section_path": [
        "AirPlay",
        "Using AirPlay icons",
        "Black AirPlay icon"
      ],
      "source_sentence_hash": "f4c919c25cb343bcc63760e041056fc1173c22e22fc9e0ce3ed29816dc4a5184",
      "word_count": 14
    },
    {
      "text": "Use the white AirPlay icon on dark backgrounds when other technology icons are white",
      "section_path": [
        "AirPlay",
        "Using AirPlay icons",
        "White AirPlay icon"
      ],
      "source_sentence_hash": "cae0f8b05112ac78c52db13b86eb6ba0171effed6abd78672bf25f45d58f2783",
      "word_count": 14
    },
    {
      "text": "Use a custom AirPlay icon color when other technology icons use the same color",
      "section_path": [
        "AirPlay",
        "Using AirPlay icons",
        "Custom color AirPlay icon"
      ],
      "source_sentence_hash": "e3a39619653c9eb3d03880794d0b3ecbb409ac758bbae3f8798ddb4770df2ddc",
      "word_count": 14
    },
    {
      "text": "Position the AirPlay icon consistently with other technology icons",
      "section_path": [
        "AirPlay",
        "Using AirPlay icons",
        "Custom color AirPlay icon"
      ],
      "source_sentence_hash": "77b06bc52511ffd98e443046de28ad5c6c326bd72b121cece25e006a01fada7a",
      "word_count": 9
    },
    {
      "text": "Don’t use the AirPlay icon or name in custom buttons or interactive elements",
      "section_path": [
        "AirPlay",
        "Using AirPlay icons",
        "Custom color AirPlay icon"
      ],
      "source_sentence_hash": "c8db15440602c30ffb7e032856c9ca14e92f76b7c48823c30375d459c4ea0023",
      "word_count": 13
    },
    {
      "text": "Use the name AirPlay beside or below its icon when other technologies are labeled that way",
      "section_path": [
        "AirPlay",
        "Using AirPlay icons",
        "Custom color AirPlay icon"
      ],
      "source_sentence_hash": "839a9cc3a3f030bdc90713225003c68bc8905dacadcdfc18f685db52652b981f",
      "word_count": 16
    },
    {
      "text": "Use the layout’s existing font for the name AirPlay",
      "section_path": [
        "AirPlay",
        "Using AirPlay icons",
        "Custom color AirPlay icon"
      ],
      "source_sentence_hash": "839a9cc3a3f030bdc90713225003c68bc8905dacadcdfc18f685db52652b981f",
      "word_count": 9
    },
    {
      "text": "Avoid placing the AirPlay icon within text or using it as the AirPlay name",
      "section_path": [
        "AirPlay",
        "Using AirPlay icons",
        "Custom color AirPlay icon"
      ],
      "source_sentence_hash": "839a9cc3a3f030bdc90713225003c68bc8905dacadcdfc18f685db52652b981f",
      "word_count": 14
    },
    {
      "text": "Make AirPlay references less prominent than the app’s name or main identity",
      "section_path": [
        "AirPlay",
        "Using AirPlay icons",
        "Custom color AirPlay icon"
      ],
      "source_sentence_hash": "0b6f847373e0e5d58aba6ccf2b98ed7295ff89d7f69f08ab6501c1f0fd1ecb06",
      "word_count": 12
    },
    {
      "text": "Use correct capitalization when using the term AirPlay",
      "section_path": [
        "AirPlay",
        "Referring to AirPlay"
      ],
      "source_sentence_hash": "e14348ba7f37e32ad45c5f58e8fec6dd6e8b201d907aa7281413aa5a240d7c8d",
      "word_count": 8
    },
    {
      "text": "Always use AirPlay as a noun",
      "section_path": [
        "AirPlay",
        "Referring to AirPlay"
      ],
      "source_sentence_hash": "ef83e9297a4405aea48e62947334c9dff7d5aae5fe270e1bafaaab165c068d5f",
      "word_count": 6
    },
    {
      "text": "Use terms like works with, use, supports, and compatible",
      "section_path": [
        "AirPlay",
        "Referring to AirPlay"
      ],
      "source_sentence_hash": "6c85ddfd91d6342d82cbba1794b6720eceea0204b9d41aeced1c261ba8c31e2d",
      "word_count": 9
    },
    {
      "text": "Use the name Apple with the name AirPlay if desired",
      "section_path": [
        "AirPlay",
        "Referring to AirPlay"
      ],
      "source_sentence_hash": "145b8faaaabf86d1e931d65832fa80d7b4b8257345b73c8b5e97c8a0056bb560",
      "word_count": 10
    },
    {
      "text": "Refer to AirPlay if appropriate and to add clarity",
      "section_path": [
        "AirPlay",
        "Referring to AirPlay"
      ],
      "source_sentence_hash": "579134a8f3e25ea71a33266c97a4e1267a2a44b520fd329e92f3fe7ece49d841",
      "word_count": 9
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "AirPlay",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
