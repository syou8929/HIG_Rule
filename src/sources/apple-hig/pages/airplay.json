      "word_count": 3
    },
    {
      "text": "Custom color AirPlay icon",
      "section_path": [
        "AirPlay",
        "Using AirPlay icons",
        "Custom color AirPlay icon"
      ],
      "source_sentence_hash": "169b1c98fb98a5b3321694885c2533a38a2810f2b8506242ab97ca289a30c410",
      "word_count": 4
    },
    {
      "text": "Position the AirPlay icon consistently with other technology icons",
      "section_path": [
        "AirPlay",
        "Using AirPlay icons",
        "Custom color AirPlay icon"
      ],
      "source_sentence_hash": "eacc9b72ad588ee3331bf8d136e12ad9858178a7855948a888d898b278836110",
      "word_count": 9
    },
    {
      "text": "Don’t use the AirPlay icon or name in custom buttons or interactive elements",
      "section_path": [
        "AirPlay",
        "Using AirPlay icons",
        "Custom color AirPlay icon"
      ],
      "source_sentence_hash": "df9faa3478fd815ddf6c20efa933defffd166efc6bde5cc30e08f0d70c3d176f",
      "word_count": 13
    },
    {
      "text": "Pair the icon with the name AirPlay correctly",
      "section_path": [
        "AirPlay",
        "Using AirPlay icons",
        "Custom color AirPlay icon"
      ],
      "source_sentence_hash": "32bb938e3ad47219ece34698ab59072f91278dcf8e747356ba86cea46017a047",
      "word_count": 8
    },
    {
      "text": "Emphasize your app over AirPlay",
      "section_path": [
        "AirPlay",
        "Using AirPlay icons",
        "Custom color AirPlay icon"
      ],
      "source_sentence_hash": "c226e02c489f4a0f3d1e4592dc4763fb714f7d8f74a6b7682c85f277af3201b1",
      "word_count": 5
    },
    {
      "text": "Use correct capitalization when using the term AirPlay",
      "section_path": [
        "AirPlay",
        "Referring to AirPlay"
      ],
      "source_sentence_hash": "a01e450b021e34d57c4a7c5505f819c4316323ccec33df784909f0aefc4ca18e",
      "word_count": 8
    },
    {
      "text": "Always use AirPlay as a noun",
      "section_path": [
        "AirPlay",
        "Referring to AirPlay"
      ],
      "source_sentence_hash": "ef83e9297a4405aea48e62947334c9dff7d5aae5fe270e1bafaaab165c068d5f",
      "word_count": 6
    },
    {
      "text": "Use terms like works with, use, supports, and compatible",
      "section_path": [
        "AirPlay",
        "Referring to AirPlay"
      ],
      "source_sentence_hash": "6c85ddfd91d6342d82cbba1794b6720eceea0204b9d41aeced1c261ba8c31e2d",
      "word_count": 9
    },
    {
      "text": "Use the name Apple with the name AirPlay if desired",
      "section_path": [
        "AirPlay",
        "Referring to AirPlay"
      ],
      "source_sentence_hash": "145b8faaaabf86d1e931d65832fa80d7b4b8257345b73c8b5e97c8a0056bb560",
      "word_count": 10
    },
    {
      "text": "Refer to AirPlay if appropriate and to add clarity",
      "section_path": [
        "AirPlay",
        "Referring to AirPlay"
      ],
      "source_sentence_hash": "078a28a9ef602e14ccfe7ba54ef6d41329ba0f07e6b8f20778c140ccf8607212",
