  "guidance_candidates": [
    {
      "text": "Add motion purposefully, supporting the experience without overshadowing it",
      "section_path": [
        "Motion",
        "Best practices"
      ],
      "source_sentence_hash": "98efe078e03917f346d501d9e3d05c9a209a687c2cc1cf6d5457815f5a69d767",
      "word_count": 9
    },
    {
      "text": "Don’t add motion merely for the sake of adding motion",
      "section_path": [
        "Motion",
        "Best practices"
      ],
      "source_sentence_hash": "e4bf26b2c488953574f9dfaaba5911f9f3b91f62d696aa4bfaa2ddb2556a5c2f",
      "word_count": 10
    },
    {
      "text": "Make motion optional",
      "section_path": [
        "Motion",
        "Best practices"
      ],
      "source_sentence_hash": "78d24700a2d22c26626331f2cc825a5e52cf8a0b7c104f6f0e514bc338e81fe9",
      "word_count": 3
    },
    {
      "text": "Communicate important information through at least one non-motion channel",
      "section_path": [
        "Motion",
        "Best practices"
      ],
      "source_sentence_hash": "9b24aba9dada62f38134e7a7583c3b0c3c1e4c696800329063b67f8a7b14679d",
      "word_count": 9
    },
    {
      "text": "Strive for realistic feedback motion that follows people’s gestures and expectations",
      "section_path": [
        "Motion",
        "Providing feedback"
      ],
      "source_sentence_hash": "f3b917742cf77fdfd609c3a4e2548a57ab283afc0b4c5393cc421969e790cc0e",
      "word_count": 11
    },
    {
      "text": "Aim for brevity and precision in feedback animations",
      "section_path": [
        "Motion",
        "Providing feedback"
      ],
      "source_sentence_hash": "ccf32ebdfdea7068efb13015c9f4edd1b28dd4f1a087a921a22e6d18ba78ca7b",
      "word_count": 8
    },
    {
      "text": "In apps, generally avoid adding motion to UI interactions that occur frequently",
      "section_path": [
        "Motion",
        "Providing feedback"
      ],
      "source_sentence_hash": "2c50d6dcd5dfbf778300e6d63d2e554c7621949db01fb03776cc04fc696a1eb7",
      "word_count": 12
    },
    {
      "text": "Let people cancel motion",
      "section_path": [
        "Motion",
        "Providing feedback"
      ],
      "source_sentence_hash": "776815ac7b31767965cb0e4ff2d4ebd9d89239add137a069d4e397a24658a94c",
      "word_count": 4
    },
    {
      "text": "Avoid making people wait for animations to finish before they can act",
      "section_path": [
        "Motion",
        "Providing feedback"
      ],
      "source_sentence_hash": "ff2a58cda8da93a29674afac2392d51546af0d78e7cf45d32589d40a75452798",
      "word_count": 12
    },
    {
      "text": "Consider using animated symbols where it makes sense",
      "section_path": [
        "Motion",
        "Providing feedback"
      ],
      "source_sentence_hash": "e2326acbd43a4759bb53d1c304f8aaf698f593c6f442c40e8e55cce0528d3d0b",
      "word_count": 8
    },
    {
      "text": "Make sure your game’s motion looks great by default on each platform you support",
      "section_path": [
        "Motion",
        "Leveraging platform capabilities"
      ],
      "source_sentence_hash": "630e9e3d5c79fb68249b7c9743940c3062ea1266d8ad66739fb508623fede755",
      "word_count": 14
    },
    {
      "text": "Let people customize the visual experience of your game to optimize performance or battery life",
      "section_path": [
        "Motion",
        "Leveraging platform capabilities"
      ],
      "source_sentence_hash": "81f5b721361a5e2ad1723002680d87805dc87f7ee80d620e9cca0fe6e9fec4a8",
      "word_count": 15
    },
    {
      "text": "As much as possible, avoid displaying motion at the edges of a person’s field of view",
      "section_path": [
        "Motion",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "a4d688dc3a1b27208608c5f829684ffa0da05420e4f7d70eeb0ea9d9543e9902",
      "word_count": 16
    },
    {
      "text": "Make sure the object’s brightness level is similar to the rest of the visible content",
      "section_path": [
        "Motion",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "7dcef0de4eb457eb18c242389dc9c6119c11789e6af2bc1e597e0e243c988f55",
      "word_count": 15
    },
    {
      "text": "Help people remain comfortable when showing the movement of large virtual objects",
      "section_path": [
        "Motion",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "e20b96002c2e3f0ae72bdd2ccdb3d0970f026b35e7eb26c80ef679c7dda3d6bd",
      "word_count": 12
    },
    {
      "text": "Consider using fades when you need to relocate an object",
      "section_path": [
        "Motion",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "a9220230b834afc0f7f1675dd1f44fa18be04390fc6e4618e806f0df5e898e55",
      "word_count": 10
    },
    {
      "text": "In general, avoid letting people rotate a virtual world",
      "section_path": [
        "Motion",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "846a4d787679952efe24a3f6a690445d902d58e7082a0da23cf96e4169a84e7e",
      "word_count": 9
    },
    {
      "text": "Consider giving people a stationary frame of reference",
      "section_path": [
        "Motion",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "4539dfba066b7f82a4a490320af17d16aa55fd0fa0c9ea95db8e8e693cfe2b06",
      "word_count": 8
    },
    {
      "text": "Avoid showing objects that oscillate in a sustained way",
      "section_path": [
        "Motion",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "47d188383cfb194298dce68c095b7f7b36990b2a3b30f23a2d9bf05baf811acf",
      "word_count": 9
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Motion",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
