  "guidance_candidates": [
    {
      "text": "For complex or prolonged user flows, consider alternatives to sheets",
      "section_path": [
        "Sheets",
        "Best practices"
      ],
      "source_sentence_hash": "5629773af3bbc0ae57bf2f004864da6115340b2567a336a67a6eadba935df7e7",
      "word_count": 10
    },
    {
      "text": "Display only one sheet at a time from the main interface",
      "section_path": [
        "Sheets",
        "Best practices"
      ],
      "source_sentence_hash": "d7840d38c5245725bb6bd44ee0f310e4e0d3f4b10dd920e3fcdc778110d60db0",
      "word_count": 11
    },
    {
      "text": "Use a nonmodal view when you want to present supplementary items that affect the main task in the parent",
      "section_path": [
        "Sheets",
        "Best practices"
      ],
      "source_sentence_hash": "ea4132d9c4342c6103da42f0dbb7d8cac627af75a2a188b14efd2c9ca05eaa75",
      "word_count": 19
    },
    {
      "text": "Provide an alternative to the Done button",
      "section_path": [
        "Sheets",
        "Best practices"
      ],
      "source_sentence_hash": "878b9ffc916e639164c16ea7b51ea5addeab2d56b5c112a7f2e2e4df8e89fbf0",
      "word_count": 7
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "Sheets",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "In an iPhone app, consider supporting the medium detent to allow progressive disclosure of the sheet’s content",
      "section_path": [
        "Sheets",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "8c045e19de660a2de3a5f8adef0b226c0b781e58c9e81fb226c06fc5409df58d",
      "word_count": 17
    },
    {
      "text": "Include a grabber in a resizable sheet",
      "section_path": [
        "Sheets",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "f4714f565846f5c233fa2fc76e6e276d0cd9cbe275cecc3e207944c274af1823",
      "word_count": 7
    },
    {
      "text": "Support swiping to dismiss a sheet",
      "section_path": [
        "Sheets",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "d120e670e5ad98529e9bf7a0443b8846553053a496cb6682f1800f8f2f05a50d",
      "word_count": 6
    },
    {
      "text": "Prefer using the page or form sheet presentation styles in an iPadOS app",
      "section_path": [
        "Sheets",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "60f462633ce0a9dae9e165513cdf76168f0159513b12d204712f1ab544489506",
      "word_count": 13
    },
    {
      "text": "Present a sheet in a reasonable default size",
      "section_path": [
        "Sheets",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "74c5a9ce92f0a03bc03b174233902f1e0d72cf42ff929eaaf1225ad6502bc2e4",
      "word_count": 8
    },
    {
      "text": "Let people interact with other app windows without first dismissing a sheet",
      "section_path": [
        "Sheets",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "5f3ee0785d7e6d3b818f20ebb1aff1a48d817882e4a390e51cee42cee6bec920",
      "word_count": 12
    },
    {
      "text": "Use a panel instead of a sheet if people need to repeatedly provide input and observe results",
      "section_path": [
        "Sheets",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "a18bf5ee7723d1f886da703972cb7c1cba7ef1949e6b42cb158ade338a313707",
      "word_count": 17
    },
    {
      "text": "Avoid displaying a sheet that emerges from the bottom edge of a window",
      "section_path": [
        "Sheets",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "ad8c0704d2ea544671134e0567d8ebbb12cf24e314950e1f2ae5ba52509cfacd",
      "word_count": 13
    },
    {
      "text": "Present a sheet in a default size that helps people retain their context",
      "section_path": [
        "Sheets",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "483e8ace5665b25b17c0303d91a08fbcc45091f4023523c961b89350007e3bd3",
      "word_count": 13
    },
    {
      "text": "Use a sheet only when your modal task requires a custom title or custom content presentation",
      "section_path": [
        "Sheets",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "53ab81d2e1d2033e752296b4084ba7b85b988a5c4a53130d3d12c8ba7dc7262b",
      "word_count": 16
    },
    {
      "text": "Keep sheet interactions brief and occasional",
      "section_path": [
        "Sheets",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "8f808c4430eecf0aae83c5d7de915ae3011d5c463df06134badb25d30bcabe3e",
      "word_count": 6
    },
    {
      "text": "If you change the default label, prefer using SF Symbols to represent the action",
      "section_path": [
        "Sheets",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "bf718ab8fce9d41496b9b7bc5283e25cb38bb439986f4eef3de8b006e8a34bfc",
      "word_count": 14
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Sheets",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
