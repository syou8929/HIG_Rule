  "guidance_candidates": [
    {
      "text": "In general, make your map interactive",
      "section_path": [
        "Maps",
        "Best practices"
      ],
      "source_sentence_hash": "423f7abb74f5c5c8bffb25e0802ef8151883098db6482c6a9a2562754d6f19c6",
      "word_count": 6
    },
    {
      "text": "Pick a map emphasis style that suits the needs of your app",
      "section_path": [
        "Maps",
        "Best practices"
      ],
      "source_sentence_hash": "3e841a694bdd52320446575d13ef628d525d7086015e91b03cab84a6be8fe6a9",
      "word_count": 12
    },
    {
      "text": "The muted style, by contrast, presents a desaturated version of the map. This style is great if you have",
      "section_path": [
        "Maps",
        "Best practices"
      ],
      "source_sentence_hash": "de7ffe1a8a188b9c3dfa0e2683927acea4864ccbc046484ec0c31d10ae1dc8d1",
      "word_count": 19
    },
    {
      "text": "Help people find places in your map",
      "section_path": [
        "Maps",
        "Best practices"
      ],
      "source_sentence_hash": "cee26aca67947096fdd0b41dd82af55e488ab99f5e0fe9b96c1082fe6f0ab328",
      "word_count": 7
    },
    {
      "text": "Clearly identify elements that people select",
      "section_path": [
        "Maps",
        "Best practices"
      ],
      "source_sentence_hash": "d9d6945f27640103e1b0c5546ac7e1a7d198e024a57416aa771d69307f3de454",
      "word_count": 6
    },
    {
      "text": "Cluster overlapping points of interest to improve map legibility",
      "section_path": [
        "Maps",
        "Best practices"
      ],
      "source_sentence_hash": "aa29bb935a4faf8006fa306bc0c1d122768d3e8449329120575565fe8f76d435",
      "word_count": 9
    },
    {
      "text": "Help people see the Apple logo and legal link",
      "section_path": [
        "Maps",
        "Best practices"
      ],
      "source_sentence_hash": "97533616f60cc18d30d789966ffcf78f24a4ef98c9c0ec2bb62ca00d83f3da50",
      "word_count": 9
    },
    {
      "text": "Use adequate padding to separate the logo and link from the map boundaries and your custom controls. For example,",
      "section_path": [
        "Maps",
        "Best practices"
      ],
      "source_sentence_hash": "2e65f12b2f133db01a814590e65601f44ed8322d387b30ff91ec0477b1c1e378",
      "word_count": 19
    },
    {
      "text": "Avoid causing the logo and link to move with your interface. It’s best when the Apple logo and legal",
      "section_path": [
        "Maps",
        "Best practices"
      ],
      "source_sentence_hash": "05a9a4d2631bd9e7f42ae2b4e5cc7e7a89e4f7dcd38701ba26e4c90602a55d6f",
      "word_count": 19
    },
    {
      "text": "Use annotations that match the visual style of your app",
      "section_path": [
        "Maps",
        "Custom information"
      ],
      "source_sentence_hash": "7376a146290ee943d53edbc6bede7c0ac703b982ac6906436bbeae7c75154865",
      "word_count": 10
    },
    {
      "text": "If you want to display custom information that’s related to standard map features, consider making them independently selectable",
      "section_path": [
        "Maps",
        "Custom information"
      ],
      "source_sentence_hash": "89ba9056587431e3b92dcf3bf8501beba482c6e038738410b4ba21ec84ec508e",
      "word_count": 18
    },
    {
      "text": "Use overlays to define map areas with a specific relationship to your content",
      "section_path": [
        "Maps",
        "Custom information"
      ],
      "source_sentence_hash": "45b5c8fd1c75c3c54d462d285172770896098b0fad1945472ce16c03f01bbdeb",
      "word_count": 13
    },
    {
      "text": "Above labels places the overlay above both roads and labels, hiding everything beneath it. This is useful for content",
      "section_path": [
        "Maps",
        "Custom information"
      ],
      "source_sentence_hash": "846cce56581787c07577c0713db2349a9e50e65e7bd13df8e4594f37387944f0",
      "word_count": 19
    },
    {
      "text": "Make sure there’s enough contrast between custom controls and the map",
      "section_path": [
        "Maps",
        "Custom information"
      ],
      "source_sentence_hash": "ce7d0c7e589c360a39f0b9835d6a5c86142cba84b93e70d415467df31318515a",
      "word_count": 11
    },
    {
      "text": "Displaying place cards in a map",
      "section_path": [
        "Maps",
        "Place cards",
        "Displaying place cards in a map"
      ],
      "source_sentence_hash": "551c2e10a25f9ab4ed88c9de08deda52c2d068ecb9f3c1b95da0c4bae04e03e4",
      "word_count": 6
    },
    {
      "text": "The automatic style lets the system determine the place card style based on the size of your map view",
      "section_path": [
        "Maps",
        "Place cards",
        "Displaying place cards in a map"
      ],
      "source_sentence_hash": "9336a5b73e72eea506c62ff82b0eaed071d95d8402b673971a5262090f47d641",
      "word_count": 19
    },
    {
      "text": "The caption style displays an “Open in Apple Maps” link",
      "section_path": [
        "Maps",
        "Place cards",
        "Displaying place cards in a map"
      ],
      "source_sentence_hash": "550567704d4c11ed52d9f975f67b2469ef2255957bf7092c7bea73a4e56e2bd3",
      "word_count": 10
    },
    {
      "text": "The sheet style displays a place card in a sheet",
      "section_path": [
        "Maps",
        "Place cards",
        "Displaying place cards in a map"
      ],
      "source_sentence_hash": "38f611ae551e4d1b9c3205de54d2788091b993973ca2a765a46b19980e88cf1f",
      "word_count": 10
    },
    {
      "text": "Consider your map presentation when choosing a style",
      "section_path": [
        "Maps",
        "Place cards",
        "Displaying place cards in a map"
      ],
      "source_sentence_hash": "95188a7602e5c1d0b8ec584d377005cefb3a598772b780292793095195ace067",
      "word_count": 8
    },
    {
      "text": "Make sure your place card looks great on different devices and window sizes",
      "section_path": [
        "Maps",
        "Place cards",
        "Displaying place cards in a map"
      ],
      "source_sentence_hash": "d92181edeb54d77a2aed11c6b2de92a1fbb86ba62e63b856b171f6abbd345137",
      "word_count": 13
    },
    {
      "text": "Avoid duplicating information",
      "section_path": [
        "Maps",
        "Place cards",
        "Displaying place cards in a map"
      ],
      "source_sentence_hash": "d4c0c7128b3e371912f65eb2d1cf027f15cf3a272629c8d943dfdd02d5962f6c",
      "word_count": 3
    },
    {
      "text": "Keep the location on your map visible when displaying a place card",
      "section_path": [
        "Maps",
        "Place cards",
        "Displaying place cards in a map"
      ],
      "source_sentence_hash": "0b1e303502744b271e877195f2b9e1f64aefb11544493745db4e0dd08150bf6b",
      "word_count": 12
    },
    {
      "text": "Adding place cards outside of a map",
      "section_path": [
        "Maps",
        "Place cards",
        "Adding place cards outside of a map"
      ],
      "source_sentence_hash": "3a5f9bd49b068a35c03ca2b7d7b8f019bde2c2d11152d230360eaf896fc7fe1d",
      "word_count": 7
    },
    {
      "text": "Use location-related cues in surrounding content to help communicate that people can open a place card",
      "section_path": [
        "Maps",
        "Place cards",
        "Adding place cards outside of a map"
      ],
      "source_sentence_hash": "cd8ec6852168472a9b5c24a2dbdd64e32de33b0d04cdecd81f7fe25e9e8976cf",
      "word_count": 16
    },
    {
      "text": "Adjust map detail based on the zoom level",
      "section_path": [
        "Maps",
        "Indoor maps"
      ],
      "source_sentence_hash": "67a06d52dddd68796a54f12675c815e50893c8dfba45f8ecc7ad5490e923c29c",
      "word_count": 8
    },
    {
      "text": "Use distinctive styling to differentiate the features of your map",
      "section_path": [
        "Maps",
        "Indoor maps"
      ],
      "source_sentence_hash": "ea13e1ba9e51f76f872b0a0c2b7d09117738b49b890b014765d9c69c72bfd0c7",
      "word_count": 10
    },
    {
      "text": "Offer a floor picker if your venue includes multiple levels",
      "section_path": [
        "Maps",
        "Indoor maps"
      ],
      "source_sentence_hash": "9f8353413beb7664dd27c7d338028cf8870af1c3938c7d3e398aa59d80cc87ae",
      "word_count": 10
    },
    {
      "text": "Include surrounding areas to provide context",
      "section_path": [
        "Maps",
        "Indoor maps"
      ],
      "source_sentence_hash": "b1bff7d58722b88102cfde7a8171f0b17111f6d9687a57e9a056e8dbcdadac57",
      "word_count": 6
    },
    {
      "text": "Consider supporting navigation between your venue and nearby transit points",
      "section_path": [
        "Maps",
        "Indoor maps"
      ],
      "source_sentence_hash": "449abf7f3cdf5a57ae5f5222bf183b835339a7a796882247fea76bb1a2ddc649",
      "word_count": 10
    },
    {
      "text": "Limit scrolling outside of your venue",
      "section_path": [
        "Maps",
        "Indoor maps"
      ],
      "source_sentence_hash": "22640d3ea21f42be5c37f0556d7605126b6b305f02ccb6f1e283fe7790eeee7f",
      "word_count": 6
    },
    {
      "text": "Design an indoor map that feels like a natural extension of your app",
      "section_path": [
        "Maps",
        "Indoor maps"
      ],
      "source_sentence_hash": "7165f27142d00ac61f05a0be7d9e3ae23a1e3744f28070e6fb378e4ca465f288",
      "word_count": 13
    },
    {
      "text": "Fit the map interface element to the screen",
      "section_path": [
        "Maps",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "8d8e484fd69373ae8ff1b2a8673e140fba0d2b79b505b38524a0c4a983a94497",
      "word_count": 8
    },
    {
      "text": "Show the smallest region that encompasses the points of interest",
      "section_path": [
        "Maps",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "12204427f444363a5eda9675f848f66c59175146056e8948259bd4b579840faf",
      "word_count": 10
    },
    {
      "text": "Ensure the entire watchOS map element is visible without scrolling",
      "section_path": ["Maps", "Platform considerations", "watchOS"],
      "source_sentence_hash": "b97387c75b849b368b54d42abf3a0e57aae10436f70369b47b123804fd5cbade",
      "word_count": 10
    },
    {
      "text": "Ensure all key watchOS map content is visible within the displayed region",
      "section_path": ["Maps", "Platform considerations", "watchOS"],
      "source_sentence_hash": "12204427f444363a5eda9675f848f66c59175146056e8948259bd4b579840faf",
      "word_count": 12
    },
    {
      "text": "make your map interactive",
      "section_path": [
        "Maps",
        "Best practices"
      ],
      "source_sentence_hash": "81e961bab24f1e841828e8496813bc1ee9d288e14ca4e4203c552cd91d514321",
      "word_count": 4
    },
    {
      "text": "Consider offering a search feature combined with a way to filter locations by category",
      "section_path": [
        "Maps",
        "Best practices"
      ],
      "source_sentence_hash": "0575f4199363337cce3fae5fa3c14ec3c169606f72bc3313957909de0a5e2897",
      "word_count": 14
    },
    {
      "text": "don’t cover these elements all the time",
      "section_path": [
        "Maps",
        "Best practices"
      ],
      "source_sentence_hash": "455f1fb46072854c61fba10e1a0c8d3c307ce114328f2dd40b1243a76444b79b",
      "word_count": 7
    },
    {
      "text": "use the lowest position of the custom element to determine the placement of the logo and link",
      "section_path": [
        "Maps",
        "Best practices"
      ],
      "source_sentence_hash": "b33250f1fc571907653a83f0b81632eb2726d3fd60c88abbd388bbf32b312ea8",
      "word_count": 17
    },
    {
      "text": "keep it to two to three characters in length for readability",
      "section_path": [
        "Maps",
        "Custom information"
      ],
      "source_sentence_hash": "d7fbcf061d1bd8bdeaafac9ab86093ecaab861a98b2c671159c507a8e1c94ed2",
      "word_count": 11
    },
    {
      "text": "be sure to choose a place card style that fits in the context of your map",
      "section_path": [
        "Maps",
        "Place cards",
        "Displaying place cards in a map"
      ],
      "source_sentence_hash": "84ade4f8ee83703876ffafeb0ae3e5b8f4aa7ee99f742774fce249f2a1f5e1a0",
      "word_count": 16
    },
    {
      "text": "you must include a map in the place card",
      "section_path": [
        "Maps",
        "Place cards",
        "Adding place cards outside of a map"
      ],
      "source_sentence_hash": "fa6d4291193f336f8b1ce4ceefa87c57883cd434870f098d5115a4a05ca8fbbe",
      "word_count": 9
    },
    {
      "text": "Show large areas like rooms and buildings at all zoom levels",
      "section_path": [
        "Maps",
        "Indoor maps"
      ],
      "source_sentence_hash": "49639d5a886077c354019c508250ddf099eddf6242987dcc08bcbb98da1a5c86",
      "word_count": 11
    },
    {
      "text": "keep floor numbers concise for simplicity",
      "section_path": [
        "Maps",
        "Indoor maps"
      ],
      "source_sentence_hash": "e4c165d68e199197478d8ee9b492dc609b046535037bd9b971a8c2761a9a0725",
      "word_count": 6
    },
    {
      "text": "use dimming and a distinct color to make them appear supplemental",
      "section_path": [
        "Maps",
        "Indoor maps"
      ],
      "source_sentence_hash": "ddccbeaaf4a30f7f26265db7f5e69abff094dc2128539bcf72c585d4a99fe7a3",
      "word_count": 11
    },
    {
      "text": "Make it easy to enter and exit your venue",
      "section_path": [
        "Maps",
        "Indoor maps"
      ],
      "source_sentence_hash": "c521d4e2a009e76ae4024354b6f5db4bd41f106ed15b3eb7ab0139f36245c4d2",
      "word_count": 9
    },
    {
      "text": "keep at least part of your indoor map visible onscreen at all times",
      "section_path": [
        "Maps",
        "Indoor maps"
      ],
      "source_sentence_hash": "118c55ebe17a2d3ef40252ca63ec1db304425ffb3772168c14b92716762eedb6",
      "word_count": 13
    },
    {
      "text": "Don’t try to replicate the appearance of Apple Maps",
      "section_path": [
        "Maps",
        "Indoor maps"
      ],
      "source_sentence_hash": "a8f4020129ca054b1739c2028e4d4609e2cba803d513ee0f0b88815d53c8c253",
      "word_count": 9
    },
    {
      "text": "make sure area overlays, icons, and text match the visual style of your app",
      "section_path": [
        "Maps",
        "Indoor maps"
      ],
      "source_sentence_hash": "988d4ec86ecd7f1420d7d4a2a3619c8d263b0ef3e2f845d2d6865ff34df563bb",
      "word_count": 14
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Maps",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
