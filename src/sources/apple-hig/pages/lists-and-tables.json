  "guidance_candidates": [
    {
      "text": "Prefer displaying text in a list or table",
      "section_path": [
        "Lists and tables",
        "Best practices"
      ],
      "source_sentence_hash": "bcb8203573e9fea95bd033b97c67d5093419a5b78343f287d09548dd31b6b212",
      "word_count": 8
    },
    {
      "text": "Consider a collection for widely varying item sizes or many images",
      "section_path": ["Lists and tables", "Best practices"],
      "source_sentence_hash": "eed4eda2605ed7545937d8f134ee9d5399adeb35b844201ffb3b30897e78ec7f",
      "word_count": 11
    },
    {
      "text": "Let people edit a table when it makes sense",
      "section_path": [
        "Lists and tables",
        "Best practices"
      ],
      "source_sentence_hash": "1f8a582ed01e41e9ca36e7018534419f2dd23cfefec6fdeed0df524773534737",
      "word_count": 9
    },
    {
      "text": "Must enter edit mode before selecting iOS and iPadOS table items",
      "section_path": ["Lists and tables", "Best practices"],
      "source_sentence_hash": "9a0247a4b8d7549e3b8322720ce00059dd28cab05f6bfc1c60786515b1872ab7",
      "word_count": 11
    },
    {
      "text": "Provide appropriate feedback when people select a list item",
      "section_path": [
        "Lists and tables",
        "Best practices"
      ],
      "source_sentence_hash": "f9713c2f7a3baffe0fa7a5c061a05ce2fa7a49816836728affd5776fd73d1757",
      "word_count": 9
    },
    {
      "text": "Keep selected rows persistently highlighted during hierarchical navigation",
      "section_path": ["Lists and tables", "Best practices"],
      "source_sentence_hash": "6235d439dc9673b1fd51ce7b396ded9c6fe2213bc81a04727572b1d3ec9368d7",
      "word_count": 8
    },
    {
      "text": "Show brief row highlighting followed by a selection indicator for options",
      "section_path": ["Lists and tables", "Best practices"],
      "source_sentence_hash": "134cca628462f4f59e2ac72464759e6c6746928b2da7c6a093028cd7a829e378",
      "word_count": 11
    },
    {
      "text": "Keep item text succinct so row content is comfortable to read",
      "section_path": [
        "Lists and tables",
        "Content"
      ],
      "source_sentence_hash": "25829f934bddd0bf6b7d0dd8327e8cd31a17d1a29d286f57ea19ac69c58f9122",
      "word_count": 11
    },
    {
      "text": "Consider alternatives to oversized rows for items containing large amounts of text",
      "section_path": ["Lists and tables", "Content"],
      "source_sentence_hash": "3881ef5e53bf0067ee84426a5e80eb0a251918a537a2c96632a6e8de574c5ed2",
      "word_count": 12
    },
    {
      "text": "Consider ways to preserve readability of text that might otherwise get clipped or truncated",
      "section_path": [
        "Lists and tables",
        "Content"
      ],
      "source_sentence_hash": "04455faad6ad95aba018a2140f05e42d76f70af3abaa4587cf2ab59e8c038bae",
      "word_count": 14
    },
    {
      "text": "Consider middle ellipses to preserve recognizable text beginnings and endings",
      "section_path": ["Lists and tables", "Content"],
      "source_sentence_hash": "c464e85ded194f4b4afe23449bd5b240b7fb0fd9b8cfbf28b256239e52dbeeef",
      "word_count": 10
    },
    {
      "text": "Use descriptive column headings in a multicolumn table",
      "section_path": [
        "Lists and tables",
        "Content"
      ],
      "source_sentence_hash": "885e9306354d9ae348ab62c1ae65bb46284bf57bf0907cedae5502316f0c19ec",
      "word_count": 8
    },
    {
      "text": "Use nouns or short noun phrases for multicolumn table headings",
      "section_path": ["Lists and tables", "Content"],
      "source_sentence_hash": "825972899155e21bb0e716429e4efbc5fd453780d006a95f43a9227e30c01189",
      "word_count": 10
    },
    {
      "text": "Use title-style capitalization for multicolumn table headings",
      "section_path": ["Lists and tables", "Content"],
      "source_sentence_hash": "825972899155e21bb0e716429e4efbc5fd453780d006a95f43a9227e30c01189",
      "word_count": 7
    },
    {
      "text": "Avoid ending punctuation in multicolumn table headings",
      "section_path": ["Lists and tables", "Content"],
      "source_sentence_hash": "825972899155e21bb0e716429e4efbc5fd453780d006a95f43a9227e30c01189",
      "word_count": 7
    },
    {
      "text": "Use a label or header when a single-column table omits its heading",
      "section_path": ["Lists and tables", "Content"],
      "source_sentence_hash": "a867de6d6610dca715453b9ee9678b340c307585c6a3df73ee58d569d8f8c2aa",
      "word_count": 12
    },
    {
      "text": "Choose a table or list style that coordinates with your data and platform",
      "section_path": [
        "Lists and tables",
        "Style"
      ],
      "source_sentence_hash": "e7058d66653fc33683c13331a83e7ced34aabe6c44162d1a5c58e563473ab808",
      "word_count": 13
    },
    {
      "text": "Choose a row style that fits the information you need to display",
      "section_path": [
        "Lists and tables",
        "Style"
      ],
      "source_sentence_hash": "be6306ed3271c6162557a42a833b400852e30317f781937f6a62bbf91d46174e",
      "word_count": 12
    },
    {
      "text": "iOS, iPadOS, visionOS",
      "section_path": [
        "Lists and tables",
        "Platform considerations",
        "iOS, iPadOS, visionOS"
      ],
      "source_sentence_hash": "a23e8e55bab6437fa83bd1a2f7bc6e59bec8d6437fc18889c542eccb341c8498",
      "word_count": 3
    },
    {
      "text": "Use an info button only to reveal more information about a row’s content",
      "section_path": [
        "Lists and tables",
        "Platform considerations",
        "iOS, iPadOS, visionOS"
      ],
      "source_sentence_hash": "4e22cf31fbfeded183afc6aa1972ced53e02e325beed2d1735a4df4ae1b5f638",
      "word_count": 13
    },
    {
      "text": "Use a disclosure indicator for hierarchical list or table navigation",
      "section_path": ["Lists and tables", "Platform considerations", "iOS, iPadOS, visionOS"],
      "source_sentence_hash": "ea437b775213c06210dc27e3936a8c57809f8a84ec13e3cbaa1690820eb17edb",
      "word_count": 10
    },
    {
      "text": "Avoid adding an index to a table that displays controls — like disclosure indicators — in the trailing ends",
      "section_path": [
        "Lists and tables",
        "Platform considerations",
        "iOS, iPadOS, visionOS"
      ],
      "source_sentence_hash": "ecd78d713b9d447adc4444f086edf7193c2c7bde381471103fbfaf0346f19026",
      "word_count": 19
    },
    {
      "text": "Let people sort valuable macOS tables by clicking column headings",
      "section_path": [
        "Lists and tables",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "e3eb5aaa01eefe67a03602bfa7ff84fe91fc31a55b9d198a43c79ffb364d71a7",
      "word_count": 10
    },
    {
      "text": "Use opposite-direction sorting when people reselect a sorted macOS column",
      "section_path": ["Lists and tables", "Platform considerations", "macOS"],
      "source_sentence_hash": "428555cebb246db5d6431c51cb82270c77aca02c9de7b2ba5d310ff511a1dedb",
      "word_count": 10
    },
    {
      "text": "Let people resize columns",
      "section_path": [
        "Lists and tables",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "037373307c00fd6082a9a53cc5a19ce296876e8a5bcd914d47d1a4f4cd31323d",
      "word_count": 4
    },
    {
      "text": "Consider using alternating row colors in a multicolumn table",
      "section_path": [
        "Lists and tables",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "b556b6c7ddb0e721ef9ab0f681cd138910e9616c614a5cddc3326fdb3750a771",
      "word_count": 9
    },
    {
      "text": "Use an outline view instead of a table view to present hierarchical data",
      "section_path": [
        "Lists and tables",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "9ff464e5c91e47a3396f3591879f691379a21c0d5888625d89b7871a733a0580",
      "word_count": 13
    },
    {
      "text": "Confirm nearby images work with focused tvOS table-row highlighting scaling and rounded corners",
      "section_path": [
        "Lists and tables",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "60b855b3480cb2fd85e1b95b9ef34c55feac70a31ae9471e1f0127733fb56a5a",
      "word_count": 13
    },
    {
      "text": "Avoid custom masks for focused tvOS table-row corners",
      "section_path": ["Lists and tables", "Platform considerations", "tvOS"],
      "source_sentence_hash": "d4f02397839aead292e2f5f40c2579ef0134c0657b84d60fb8531da5b73faa07",
      "word_count": 8
    },
    {
      "text": "Aim to limit watchOS list rows when possible",
      "section_path": [
        "Lists and tables",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "63e965e572bf2461aefc473459abc79191766baed0706d6e8708dfe23c0fa5bd",
      "word_count": 8
    },
    {
      "text": "Keep watchOS detail views short for vertical page-based navigation",
      "section_path": [
        "Lists and tables",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "0d287724c69e285ba7f46712e01cb5015e4044883e4bb8f30c657402b37e073d",
