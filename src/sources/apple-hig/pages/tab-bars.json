  "guidance_candidates": [
    {
      "text": "Use a tab bar to support navigation, not to provide actions",
      "section_path": [
        "Tab bars",
        "Best practices"
      ],
      "source_sentence_hash": "04185f256456fc152552a2936ac026e644eddfabb03db8aba2ee74483298e08d",
      "word_count": 11
    },
    {
      "text": "Make sure the tab bar is visible when people navigate to different sections of your app",
      "section_path": [
        "Tab bars",
        "Best practices"
      ],
      "source_sentence_hash": "b7b769deff52a1cc675ae388913d301f5c1d84141cad8ad80ff434c46bb43ced",
      "word_count": 16
    },
    {
      "text": "Use the appropriate number of tabs required to help people navigate your app",
      "section_path": [
        "Tab bars",
        "Best practices"
      ],
      "source_sentence_hash": "a9bf2dbba164920cb957208881cfaa6496618288392c158e34116a5bf3811a9c",
      "word_count": 13
    },
    {
      "text": "Avoid overflow tabs",
      "section_path": [
        "Tab bars",
        "Best practices"
      ],
      "source_sentence_hash": "42bf50942a588b76d2eb1e2ebc3f504599ce66abb5fc4d421789f2e2b82cd7ce",
      "word_count": 3
    },
    {
      "text": "Don’t disable or hide tab bar buttons, even when their content is unavailable",
      "section_path": [
        "Tab bars",
        "Best practices"
      ],
      "source_sentence_hash": "34ef173d187a9fc909c68ccf9a9a33177371441b60851198bf164710f08266b0",
      "word_count": 13
    },
    {
      "text": "Include tab labels to help with navigation",
      "section_path": [
        "Tab bars",
        "Best practices"
      ],
      "source_sentence_hash": "c5e86e2e76f453758dee80af606ce8b9db8704cd267a5d487d9bb51114136ee0",
      "word_count": 7
    },
    {
      "text": "Consider using SF Symbols to provide familiar, scalable tab bar icons",
      "section_path": [
        "Tab bars",
        "Best practices"
      ],
      "source_sentence_hash": "6a14a581633ba402e76bf0e85da7ec48c86a06a7fbcb4c47ddf99b4914c9434e",
      "word_count": 11
    },
    {
      "text": "Use a badge to indicate that critical information is available",
      "section_path": [
        "Tab bars",
        "Best practices"
      ],
      "source_sentence_hash": "dfc5d7671774ab1c9f8104f95583a77bf3c05e48bd09c3f8df2044f88c8c7b8c",
      "word_count": 10
    },
    {
      "text": "Avoid applying a similar color to tab labels and content layer backgrounds",
      "section_path": [
        "Tab bars",
        "Best practices"
      ],
      "source_sentence_hash": "0fe534e48cd0248421a6f46dfd4fc6f36ffc01bc1b63455268873ad27101827f",
      "word_count": 12
    },
    {
      "text": "Prefer a tab bar for navigation",
      "section_path": [
        "Tab bars",
        "Platform considerations",
        "iPadOS"
      ],
      "source_sentence_hash": "e00f4623297caf5acd7601b1187b2d8122eef5066820cd7f1a8a8441f5d15d12",
      "word_count": 6
    },
    {
      "text": "Let people customize the tab bar",
      "section_path": [
        "Tab bars",
        "Platform considerations",
        "iPadOS"
      ],
      "source_sentence_hash": "a2cfed2fcfd1858fbcfe55024fc950451d5d2e5b3fb5b6f90be85cd02d29553c",
      "word_count": 6
    },
    {
      "text": "Be aware of tab bar scrolling behaviors",
      "section_path": [
        "Tab bars",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "f42bf9c2642c23425e235cdbd4f80cedbb75d971285ab87b76831cd2a8c3eece",
      "word_count": 7
    },
    {
      "text": "In a live-viewing app, organize tabs in a consistent way",
      "section_path": [
        "Tab bars",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "f071fe763f6ad8f83ad44236b92f9deaa9b9c4bdba9ac86afc9d75957274c017",
      "word_count": 10
    },
    {
      "text": "Supply a symbol and a text label for each tab",
      "section_path": [
        "Tab bars",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "16f3bb9692254e8cad26c0b671c058f4180f28c31e9f2a19d3c9009f2cdcf68e",
      "word_count": 10
    },
    {
      "text": "If it makes sense in your app, consider using a sidebar within a tab",
      "section_path": [
        "Tab bars",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "2f927ea8c3324e5b6119a9c168afae17641d3e0e54a450e698c0b24adc94b40c",
      "word_count": 14
    },
