  "guidance_candidates": [
    {
      "text": "Avoid creating duplicate versions of common actions that are already available in the activity view",
      "section_path": [
        "Activity views",
        "Best practices"
      ],
      "source_sentence_hash": "8752597d8883edd3c0901d7a7e3d2b5783e7cf4f61a1e41b90a5400a20bde600",
      "word_count": 15
    },
    {
      "text": "Consider using a symbol to represent your custom activity",
      "section_path": [
        "Activity views",
        "Best practices"
      ],
      "source_sentence_hash": "3c0f4dd2c08352296fe60277505044554e8c25fa0148505d0df302f53c6c9932",
      "word_count": 9
    },
    {
      "text": "Write a succinct, descriptive title for each custom action you provide",
      "section_path": [
        "Activity views",
        "Best practices"
      ],
      "source_sentence_hash": "b12c72bd854333009e116dea19cc12895d0db7960f2a5cbbaa843de563b49d93",
      "word_count": 11
    },
    {
      "text": "Make sure activities are appropriate for the current context",
      "section_path": [
        "Activity views",
        "Best practices"
      ],
      "source_sentence_hash": "dd64a781a3e2ac88525818332de0f1c23b8c95006ab005ddc46e4bcc00a8419f",
      "word_count": 9
    },
    {
      "text": "Use the Share button to display an activity view",
      "section_path": [
        "Activity views",
        "Best practices"
      ],
      "source_sentence_hash": "0d511628031e9b52443d66abb1ec1dad5009cf9350b2a518994a41b89c2c9e7b",
      "word_count": 9
    },
    {
      "text": "In iOS and iPadOS, share and action extensions are displayed in the share sheet that appears when people choose",
      "section_path": [
        "Activity views",
        "Share and action extensions"
      ],
      "source_sentence_hash": "2b7fac4b013839be851982d46942fad65d21dbe8682533d445ba347ef3d64676",
      "word_count": 19
    },
    {
      "text": "If necessary, create a custom interface that feels familiar to people",
      "section_path": [
        "Activity views",
        "Share and action extensions"
      ],
      "source_sentence_hash": "ca66d8f48b78e97dd2b2a4232727add65077aa0c3cbe0fc2033d9b982b103102",
      "word_count": 11
    },
    {
      "text": "Streamline and limit interaction",
      "section_path": [
        "Activity views",
        "Share and action extensions"
      ],
      "source_sentence_hash": "049372cfff9c822007fd7e0f7dd7c2fa91cd5ff803a647e9f6269d77fd098435",
      "word_count": 4
    },
    {
      "text": "Avoid placing a modal view above your extension",
      "section_path": [
        "Activity views",
        "Share and action extensions"
      ],
      "source_sentence_hash": "bf0d9253890a460bf611bf694a6777d8a085ed18a460789db05e2fa01a76537f",
      "word_count": 8
    },
    {
      "text": "If necessary, provide an image that communicates the purpose of your extension",
      "section_path": [
        "Activity views",
        "Share and action extensions"
      ],
      "source_sentence_hash": "a3e517b17f166d1ac3c03a1c8da2e99fc280b138637ccd68e82b71d01601392e",
      "word_count": 12
    },
    {
      "text": "Use your main app to denote the progress of a lengthy operation",
      "section_path": [
        "Activity views",
        "Share and action extensions"
      ],
      "source_sentence_hash": "8ee2f49236630be0345a68bc6d9f997483cef7861651258f2f189b85da8ef13b",
      "word_count": 12
    },
    {
      "text": "Give app-specific activity a custom title when it resembles an existing action",
      "section_path": [
        "Activity views",
        "Best practices"
      ],
      "source_sentence_hash": "8752597d8883edd3c0901d7a7e3d2b5783e7cf4f61a1e41b90a5400a20bde600",
      "word_count": 12
    },
    {
      "text": "Center custom activity icons in an area about 70 by 70 pixels",
      "section_path": [
        "Activity views",
        "Best practices"
      ],
      "source_sentence_hash": "3c0f4dd2c08352296fe60277505044554e8c25fa0148505d0df302f53c6c9932",
      "word_count": 12
    },
    {
      "text": "Prefer a single verb or brief verb phrase for custom action titles",
      "section_path": [
        "Activity views",
        "Best practices"
      ],
      "source_sentence_hash": "b12c72bd854333009e116dea19cc12895d0db7960f2a5cbbaa843de563b49d93",
      "word_count": 12
    },
    {
      "text": "Avoid including company or product names in custom action titles",
      "section_path": [
        "Activity views",
        "Best practices"
      ],
      "source_sentence_hash": "b12c72bd854333009e116dea19cc12895d0db7960f2a5cbbaa843de563b49d93",
      "word_count": 10
    },
    {
      "text": "Consider excluding activities that aren't applicable to the current app context",
      "section_path": [
        "Activity views",
        "Best practices"
      ],
      "source_sentence_hash": "dd64a781a3e2ac88525818332de0f1c23b8c95006ab005ddc46e4bcc00a8419f",
      "word_count": 11
    },
    {
      "text": "Avoid providing an alternate way to reveal the same activity view",
      "section_path": [
        "Activity views",
        "Best practices"
      ],
      "source_sentence_hash": "0d511628031e9b52443d66abb1ec1dad5009cf9350b2a518994a41b89c2c9e7b",
      "word_count": 11
    },
    {
      "text": "Create a familiar custom extension interface when necessary",
      "section_path": [
        "Activity views",
        "Share and action extensions"
      ],
      "source_sentence_hash": "ca66d8f48b78e97dd2b2a4232727add65077aa0c3cbe0fc2033d9b982b103102",
      "word_count": 8
    },
    {
      "text": "Prefer the system-provided composition view for share extensions",
      "section_path": [
        "Activity views",
        "Share and action extensions"
      ],
      "source_sentence_hash": "ca66d8f48b78e97dd2b2a4232727add65077aa0c3cbe0fc2033d9b982b103102",
      "word_count": 8
    },
    {
      "text": "Include your app name in action extension interfaces",
      "section_path": [
        "Activity views",
        "Share and action extensions"
      ],
      "source_sentence_hash": "ca66d8f48b78e97dd2b2a4232727add65077aa0c3cbe0fc2033d9b982b103102",
      "word_count": 8
    },
    {
      "text": "Include app interface elements when an extension presents a custom interface",
      "section_path": [
        "Activity views",
        "Share and action extensions"
      ],
      "source_sentence_hash": "ca66d8f48b78e97dd2b2a4232727add65077aa0c3cbe0fc2033d9b982b103102",
      "word_count": 11
    },
    {
      "text": "Simplify extension interactions and limit the steps required",
      "section_path": [
        "Activity views",
        "Share and action extensions"
      ],
      "source_sentence_hash": "049372cfff9c822007fd7e0f7dd7c2fa91cd5ff803a647e9f6269d77fd098435",
      "word_count": 8
    },
    {
      "text": "Provide an image that communicates extension purpose when necessary",
      "section_path": [
        "Activity views",
        "Share and action extensions"
      ],
      "source_sentence_hash": "a3e517b17f166d1ac3c03a1c8da2e99fc280b138637ccd68e82b71d01601392e",
      "word_count": 9
    },
    {
      "text": "Prefer a symbol or task-identifying interface icon for action extensions",
      "section_path": [
        "Activity views",
        "Share and action extensions"
      ],
      "source_sentence_hash": "a3e517b17f166d1ac3c03a1c8da2e99fc280b138637ccd68e82b71d01601392e",
      "word_count": 10
    },
    {
      "text": "Keep time-consuming extension tasks running in the background",
      "section_path": [
        "Activity views",
        "Share and action extensions"
      ],
      "source_sentence_hash": "8ee2f49236630be0345a68bc6d9f997483cef7861651258f2f189b85da8ef13b",
      "word_count": 8
    },
    {
      "text": "Avoid notifying people solely because an extension task completes",
      "section_path": [
        "Activity views",
        "Share and action extensions"
      ],
      "source_sentence_hash": "8ee2f49236630be0345a68bc6d9f997483cef7861651258f2f189b85da8ef13b",
      "word_count": 9
    },
    {
      "text": "Avoid activity views on macOS, tvOS, or watchOS",
      "section_path": [
        "Activity views",
        "Platform considerations"
      ],
      "source_sentence_hash": "619a3110f660b3f6db7d42155209d07a53cf8c487a9df7b7d7e3c53ecaf22786",
      "word_count": 8
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Activity views",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
