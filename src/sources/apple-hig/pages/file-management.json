  "guidance_candidates": [
    {
      "text": "Use app menus and keyboard shortcuts to give people convenient ways to create and open documents",
      "section_path": [
        "File management",
        "Creating and opening files"
      ],
      "source_sentence_hash": "c297e1ae10f98b37520ba4bd43798dcc3681cb68cbfad1401858dab135d448b6",
      "word_count": 16
    },
    {
      "text": "If your app requires a custom file browser, support people’s understanding of the platform’s file system",
      "section_path": [
        "File management",
        "Creating and opening files"
      ],
      "source_sentence_hash": "a8ed755d4341f62ec02b8e77ef3de2f94d714395819e6fd84821accf4d95a6d9",
      "word_count": 16
    },
    {
      "text": "Help people be confident that their work is always preserved unless they cancel or delete it",
      "section_path": [
        "File management",
        "Saving work"
      ],
      "source_sentence_hash": "9fa9b0761db449e4c29bee85af9d23e1aa8a3f5f35540d6196b7888f378bcf79",
      "word_count": 16
    },
    {
      "text": "Hide file extensions by default, but let people view them if they choose",
      "section_path": [
        "File management",
        "Saving work"
      ],
      "source_sentence_hash": "b95597c5005e678a4d4433927cbc1d497becc32f6679bcbb44d1d9c69ff03db8",
      "word_count": 13
    },
    {
      "text": "Use a Quick Look viewer to let people preview a file even when your app can’t open it",
      "section_path": [
        "File management",
        "Quick Look previews"
      ],
      "source_sentence_hash": "489f2837f9a887eecdfa71627c3a9a2b6c0d186ff142c24a10cde9b51eadfc36",
      "word_count": 18
    },
    {
      "text": "Consider implementing a Quick Look generator if your app produces custom file types",
      "section_path": [
        "File management",
        "Quick Look previews"
      ],
      "source_sentence_hash": "15ae5a7abf885d97116901392cc0e5a330ae97c801d47b5dd4ffd9b38fa89d56",
      "word_count": 13
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "File management",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "Document launcher",
      "section_path": [
        "File management",
        "Platform considerations",
        "iOS, iPadOS",
        "Document launcher"
      ],
      "source_sentence_hash": "de71f79b99d1a28c4b302243b2d76480b3f4409535c2d72c401f44e411e90e86",
      "word_count": 2
    },
    {
      "text": "A title card that displays the app title and two app-specific buttons",
      "section_path": [
        "File management",
        "Platform considerations",
        "iOS, iPadOS",
        "Document launcher"
      ],
      "source_sentence_hash": "5086225235de3d5e50704f95b7b25cae77089529aecd9c9bc064810426f7eb45",
      "word_count": 12
    },
    {
      "text": "A background image that appears behind the title card and additional images — called accessories — that can appear",
      "section_path": [
        "File management",
        "Platform considerations",
        "iOS, iPadOS",
        "Document launcher"
      ],
      "source_sentence_hash": "fe5829da247e38a69cc32634804ffe51aec9c65b7b807c8e3c972f4e941435a5",
      "word_count": 19
    },
    {
      "text": "A sheet that contains a file browser and optional app-specific controls",
      "section_path": [
        "File management",
        "Platform considerations",
        "iOS, iPadOS",
        "Document launcher"
      ],
      "source_sentence_hash": "0f6aa74b4bb8ffab707b4a7c6f53b5275f14a5fad85f8e1f850781677aee80c4",
      "word_count": 11
    },
    {
      "text": "Assign the title card’s buttons to your app’s most important functions",
      "section_path": [
        "File management",
        "Platform considerations",
        "iOS, iPadOS",
        "Document launcher"
      ],
      "source_sentence_hash": "73fc02609a265f857f0e28e6afecb32016e8a32eec85a72b0b60bde9484b0f23",
      "word_count": 11
    },
    {
      "text": "Provide a background that’s clearly distinct from the accessories and title card",
      "section_path": [
        "File management",
        "Platform considerations",
        "iOS, iPadOS",
        "Document launcher"
      ],
      "source_sentence_hash": "ac41c87231c86560b5375c9df2b88fb458477c81b00e914c76fac28106415cd7",
      "word_count": 12
    },
    {
      "text": "Be mindful of accessory placement",
      "section_path": [
        "File management",
        "Platform considerations",
        "iOS, iPadOS",
        "Document launcher"
      ],
      "source_sentence_hash": "fe8413e453c9f5c9bd8ea2fdd5acbce92534b75c2707028196bdc588e0856b68",
      "word_count": 5
    },
    {
      "text": "Use animation sparingly",
      "section_path": [
        "File management",
        "Platform considerations",
        "iOS, iPadOS",
        "Document launcher"
      ],
      "source_sentence_hash": "bde983cea6b25f93c6c4983332d57825d38aba4074d6ac857154cfe3ba6683c9",
      "word_count": 3
    },
    {
      "text": "File provider app extension",
      "section_path": [
        "File management",
        "Platform considerations",
        "iOS, iPadOS",
        "File provider app extension"
      ],
      "source_sentence_hash": "0f987cb8aee66818f6f56518a3235c5f26ceeeb1a755d9caa7568c057aa691c7",
      "word_count": 4
    },
    {
      "text": "When someone uses your file provider extension to open or import documents, display only documents that are appropriate in",
      "section_path": [
        "File management",
        "Platform considerations",
        "iOS, iPadOS",
        "File provider app extension"
      ],
      "source_sentence_hash": "329ff17fec7280b8cfc4006e4927ae4d76f7a72d8c8701b8f0f3941fd647aed0",
      "word_count": 19
    },
    {
      "text": "Let people select a destination when exporting and moving documents",
      "section_path": [
        "File management",
        "Platform considerations",
        "iOS, iPadOS",
        "File provider app extension"
      ],
      "source_sentence_hash": "6d6980fa9011409ec0853a608054b0147266feae0668ab8c1769694d49ef0129",
      "word_count": 10
    },
    {
      "text": "Avoid including a custom top toolbar",
      "section_path": [
        "File management",
        "Platform considerations",
        "iOS, iPadOS",
        "File provider app extension"
      ],
      "source_sentence_hash": "a593a46d4d0be16f127db8c7ccf78ee11d34bf56b0c9159d8324fa91910c074d",
      "word_count": 6
    },
    {
      "text": "Custom file management",
      "section_path": [
        "File management",
        "Platform considerations",
        "macOS",
        "Custom file management"
      ],
      "source_sentence_hash": "62fdaad76a9392dce27ae2804b0f0a32e199e07193d55bde48800ce99be5582c",
      "word_count": 3
    },
    {
      "text": "Make your custom file-opening interface convenient",
      "section_path": [
        "File management",
        "Platform considerations",
        "macOS",
        "Custom file management"
      ],
      "source_sentence_hash": "63d12680cca493902c5f52d90bbe520bc27e34ab5d6328188e994de581f40149",
      "word_count": 6
    },
    {
      "text": "Provide a save interface to let people change a file’s name, format, or location",
      "section_path": [
        "File management",
        "Platform considerations",
        "macOS",
        "Custom file management"
      ],
      "source_sentence_hash": "6a69f787793b027c6219191bf9363d6d89dda9d3f0fa5bb2d5d7069cb55c55df",
      "word_count": 14
    },
    {
      "text": "Consider extending the functionality of the Save dialog",
      "section_path": [
        "File management",
        "Platform considerations",
        "macOS",
        "Custom file management"
      ],
      "source_sentence_hash": "25508b4791ac4a0ca77ddedb5de0d68d6ab359a9d923a2473b27475754419cd3",
      "word_count": 8
    },
    {
      "text": "Finder Sync extensions",
      "section_path": [
        "File management",
        "Platform considerations",
        "macOS",
        "Finder Sync extensions"
      ],
      "source_sentence_hash": "3e2d62eeb4ce2b284f3bf5649ee1eccb3d13964a4ae84edd7212029134ac313e",
      "word_count": 3
    },
    {
      "text": "Display badges in the Finder to indicate the sync status of items",
      "section_path": [
        "File management",
        "Platform considerations",
        "macOS",
        "Finder Sync extensions"
      ],
      "source_sentence_hash": "d29f9e65aee825ef273452b9cb4eef358a638e6fe3476e5d3f57f8a769397372",
      "word_count": 12
    },
    {
      "text": "Provide custom contextual menu items that perform file and folder management tasks, like favoriting and adding password-protection",
      "section_path": [
        "File management",
        "Platform considerations",
        "macOS",
        "Finder Sync extensions"
      ],
      "source_sentence_hash": "0dce9feca6e112f14c3c081cd60f08bfe6b29288bcd55a1c0c06a0f70bc8b8d9",
      "word_count": 17
    },
    {
      "text": "Provide custom toolbar buttons that perform global actions, like initiating a sync operation",
      "section_path": [
        "File management",
        "Platform considerations",
        "macOS",
        "Finder Sync extensions"
      ],
      "source_sentence_hash": "8b290a7da353b6b0fb52958e3de9729967a55cdd11ccabb95c2f3cef72996255",
      "word_count": 13
    },
    {
      "text": "Help people avoid losing work if they turn off autosaving",
      "section_path": [
        "File management",
        "Platform considerations",
        "macOS",
        "Finder Sync extensions"
      ],
      "source_sentence_hash": "d988166c577e529420fa6acde1955ebb6682e17a4e5411d87614c529144fb5d4",
      "word_count": 10
    },
    {
      "text": "When autosaving is off, make sure people know when a document has unsaved changes",
      "section_path": [
        "File management",
        "Platform considerations",
        "macOS",
        "Finder Sync extensions"
      ],
      "source_sentence_hash": "91fa0a8c3ce99a122fba4e4618c1383a4d1e52044ca37d1ddc76e56b4e0346fb",
      "word_count": 14
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "File management",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
