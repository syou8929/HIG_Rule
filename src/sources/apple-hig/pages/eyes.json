  "guidance_candidates": [
    {
      "text": "Always give people multiple ways to interact with your app",
      "section_path": [
        "Eyes",
        "Best practices"
      ],
      "source_sentence_hash": "114a5cc3bd28f01e7020341018b234bca101106fd239c9801ecb563fc27e90d9",
      "word_count": 10
    },
    {
      "text": "Design for visual comfort",
      "section_path": [
        "Eyes",
        "Best practices"
      ],
      "source_sentence_hash": "dd09c5d3bbf95491947096d0104121f618d119303e77ee763848a9d6fa196c1f",
      "word_count": 4
    },
    {
      "text": "Place content at a comfortable viewing distance",
      "section_path": [
        "Eyes",
        "Best practices"
      ],
      "source_sentence_hash": "2824f95138cec91e9254e41ebd9323cec30b4a98e8c55b10d2016a6aec003e6f",
      "word_count": 7
    },
    {
      "text": "Prefer using standard UI components",
      "section_path": [
        "Eyes",
        "Best practices"
      ],
      "source_sentence_hash": "902702c53f4b9884fd59d8889854f429fd88dcf2c6fa363d3a1a5505db6478ec",
      "word_count": 5
    },
    {
      "text": "Minimize visual distractions",
      "section_path": [
        "Eyes",
        "Making items easy to see"
      ],
      "source_sentence_hash": "6524b82dfd976095280d0c10218ce4e1d47ab48927acb7890e64bb4cbd88d32a",
      "word_count": 3
    },
    {
      "text": "Make it easy for people to look at an item by providing enough space around it",
      "section_path": [
        "Eyes",
        "Making items easy to see"
      ],
      "source_sentence_hash": "fd3e8422bcd27810f397fff6cbcf9a5bc15fc89fc186d4a579a28fe5b5458c88",
      "word_count": 16
    },
    {
      "text": "Avoid using a repeating pattern or texture that fills the field of view",
      "section_path": [
        "Eyes",
        "Making items easy to see"
      ],
      "source_sentence_hash": "4803ff36c71e4f9e237c9b93642444c80fc292883d045c58b186d24b9c2ff8b9",
      "word_count": 13
    },
    {
      "text": "Consider using subtle visual cues to encourage people to look at the item they’re most likely to want",
      "section_path": [
        "Eyes",
        "Encouraging interaction"
      ],
      "source_sentence_hash": "78ac883900c3e2923b8dd04f0f1a61f999396409ede6b54e96193cedb14011f2",
      "word_count": 18
    },
    {
      "text": "In general, give an interactive item a rounded shape",
      "section_path": [
        "Eyes",
        "Encouraging interaction"
      ],
      "source_sentence_hash": "b49f85312f994b10c698181f76ef0405be7323076b23a592fbff6a38486df49b",
      "word_count": 9
    },
    {
      "text": "If you create an interactive component that consists of more than one element, be sure to provide an overall",
      "section_path": [
        "Eyes",
        "Encouraging interaction"
      ],
      "source_sentence_hash": "9f9f2b2e3b289d8e6d54882d010bf4e8d341cf80f1627912d281202f348e914e",
      "word_count": 19
    },
    {
      "text": "Prefer using a custom hover effect to emphasize or enhance a special moment in your experience",
      "section_path": [
        "Eyes",
        "Custom hover effects"
      ],
      "source_sentence_hash": "f6ab0e7c76053c44a703a97f343a7f7f36c9b1fee362594d442bd757f2d03cec",
      "word_count": 16
    },
    {
      "text": "Choose the right delay",
      "section_path": [
        "Eyes",
        "Custom hover effects"
      ],
      "source_sentence_hash": "76357c38cb11b769d44335de041e47037e3a11d9fa72516956cce642d1043d76",
      "word_count": 4
    },
    {
      "text": "No delay (default)",
      "section_path": [
        "Eyes",
        "Custom hover effects"
      ],
      "source_sentence_hash": "387013ae8a35bd5d88e3a894fef0d3ca9b67cadb7fa682a5ba9945e8db031fa3",
      "word_count": 3
    },
    {
      "text": "Short delay",
      "section_path": [
        "Eyes",
        "Custom hover effects"
      ],
      "source_sentence_hash": "3104f44a278356215015033fe4bd25740bb47f8608510d14dcafee0cfad77fe5",
      "word_count": 2
    },
    {
      "text": "Long delay",
      "section_path": [
        "Eyes",
        "Custom hover effects"
      ],
      "source_sentence_hash": "41bb7f50cd3cd3cebf09e76ddcf80863584fb920120eafd16d6f9ce1eba4e3fc",
      "word_count": 2
    },
    {
      "text": "Aim to keep one or more of the element’s primary views unchanged in both states of a custom hover",
      "section_path": [
        "Eyes",
        "Custom hover effects"
      ],
      "source_sentence_hash": "346e608a72151baae5263bbcabe45d64e22dcb793ee21887ff786286765b74e2",
      "word_count": 19
    },
    {
      "text": "Thoroughly test custom hover effects",
      "section_path": [
        "Eyes",
        "Custom hover effects"
      ],
      "source_sentence_hash": "ea60482e0b3fd1bdabff121f6499e1dcef39ff5a6033451d23081b93b15ec66f",
      "word_count": 5
    },
