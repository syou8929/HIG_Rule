  "guidance_candidates": [
    {
      "text": "Support full-screen mode when it makes sense for your experience",
      "section_path": [
        "Going full screen",
        "Best practices"
      ],
      "source_sentence_hash": "5abfb893d5dc48f7e503a799cc083ddae482611f4a8f4a1d27db071d87326b9f",
      "word_count": 10
    },
    {
      "text": "If necessary, adjust your layout in full-screen mode, but don’t programmatically resize your window",
      "section_path": [
        "Going full screen",
        "Best practices"
      ],
      "source_sentence_hash": "143c86728a13688b55e1b4d8df7d53e93c1ae695fcb8d3b3b707d09c3bd4b7be",
      "word_count": 14
    },
    {
      "text": "Don’t programmatically resize the full-screen window",
      "section_path": [
        "Going full screen",
        "Best practices"
      ],
      "source_sentence_hash": "143c86728a13688b55e1b4d8df7d53e93c1ae695fcb8d3b3b707d09c3bd4b7be",
      "word_count": 6
    },
    {
      "text": "Be sure they’re subtle enough to maintain a consistent interface and avoid visually jarring transitions",
      "section_path": [
        "Going full screen",
        "Best practices"
      ],
      "source_sentence_hash": "bf759e6ab6b9b89a9a6d80bf70b7022220588c97f805c66a4f8533649de55222",
      "word_count": 14
    },
    {
      "text": "Continue to provide access to essential features and controls so people can complete their task without exiting full-screen mode",
      "section_path": [
        "Going full screen",
        "Best practices"
      ],
      "source_sentence_hash": "1865c7a48d865af4409a92a5b4704dd233a48abd1a76e80b0066134eae9fa55b",
      "word_count": 19
    },
    {
      "text": "Except in games, let people reveal the Dock while your iPadOS or macOS app is in full-screen mode",
      "section_path": [
        "Going full screen",
        "Best practices"
      ],
      "source_sentence_hash": "0e6aea992d4c5d91184d8ade627744df5cb7fb1d238b7469babc45800201c540",
      "word_count": 18
    },
    {
      "text": "After people switch away from your full-screen experience, help them resume where they left off when they return",
      "section_path": [
        "Going full screen",
        "Best practices"
      ],
      "source_sentence_hash": "7e4d4cf687875adee0ccbd150766a2491adbf77330530c648621622f838c040c",
      "word_count": 18
    },
    {
      "text": "Pause a full-screen game or slideshow automatically when people leave",
      "section_path": [
        "Going full screen",
        "Best practices"
      ],
      "source_sentence_hash": "0cc5135db628fe8c196438a178825a3b1828c4fb458c350a698160d2778f08c8",
      "word_count": 10
    },
    {
      "text": "Let people choose when to exit full-screen mode",
      "section_path": [
        "Going full screen",
        "Best practices"
      ],
      "source_sentence_hash": "84224127b42131e72ac3a18e829d801f77f6a8d793aada3f4817a1ca95e1d3a6",
      "word_count": 8
    },
    {
      "text": "Prioritize content by temporarily hiding toolbars and navigation controls",
      "section_path": [
        "Going full screen",
        "Best practices"
      ],
      "source_sentence_hash": "99cec6c69403cf9ddc9b265ff8dd3cafc02dd7647dcf4483fda780b266e371a5",
      "word_count": 9
    },
    {
      "text": "Let people restore hidden controls with a familiar gesture or action",
      "section_path": [
        "Going full screen",
        "Best practices"
      ],
      "source_sentence_hash": "90928c2b2fe433927879af012b37a0fc67f5b26b93d2a396ec5ace651344514a",
      "word_count": 10
    },
    {
      "text": "Be sure to keep controls visible when they’re essential for navigation or performing tasks",
      "section_path": [
        "Going full screen",
        "Best practices"
      ],
      "source_sentence_hash": "6c052d819cabfc26ecb69715b18732f0a5f3d7e8dc231d1ce8814c69220f4367",
      "word_count": 14
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "Going full screen",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "Consider deferring system gestures to prevent accidental exits in a full-screen app or game",
      "section_path": [
        "Going full screen",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "9bd17e45b05f27500b5d7b3997db09c07fb984ae49bc3a4438410d37a50207b3",
      "word_count": 14
    },
    {
      "text": "Retain default full-screen exit gestures whenever possible",
      "section_path": [
        "Going full screen",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "9bd17e45b05f27500b5d7b3997db09c07fb984ae49bc3a4438410d37a50207b3",
      "word_count": 7
    },
    {
      "text": "Use the system-provided full-screen experience",
      "section_path": [
        "Going full screen",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "9fde92cf7d9eb929c162cb3381e6f3160f273b39f146b4d6c74ee2c04ee7349a",
      "word_count": 5
    },
    {
      "text": "Avoid changing display mode when macOS games enter full screen",
      "section_path": [
        "Going full screen",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "4afc7ee25b6868c5679f8880be895b3a06415d6440ba758a1e0f373033d0f9c5",
      "word_count": 9
    },
    {
      "text": "Always let people choose when to enter full-screen mode",
      "section_path": [
        "Going full screen",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "d041ef165e61b0543dc1bb4c5b917a7b3d31be0f674a96c9b394b88690a2200c",
      "word_count": 9
    },
    {
      "text": "Prefer standard macOS controls for entering full-screen mode",
      "section_path": [
        "Going full screen",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "d041ef165e61b0543dc1bb4c5b917a7b3d31be0f674a96c9b394b88690a2200c",
      "word_count": 8
    },
    {
      "text": "Avoid offering a custom menu of macOS window modes",
      "section_path": [
        "Going full screen",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "d041ef165e61b0543dc1bb4c5b917a7b3d31be0f674a96c9b394b88690a2200c",
      "word_count": 9
    },
    {
      "text": "Consider a custom full-screen toggle in a macOS game",
      "section_path": [
        "Going full screen",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "d041ef165e61b0543dc1bb4c5b917a7b3d31be0f674a96c9b394b88690a2200c",
      "word_count": 9
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Going full screen",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
