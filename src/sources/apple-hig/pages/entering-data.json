  "guidance_candidates": [
    {
      "text": "Get information from the system whenever possible",
      "section_path": [
        "Entering data",
        "Best practices"
      ],
      "source_sentence_hash": "f428ea4c6d3fcd59eb7fdb79bcb1e936aeb3bcddcd4fc59dc316d15f062d81f8",
      "word_count": 7
    },
    {
      "text": "Be clear about the data you need",
      "section_path": [
        "Entering data",
        "Best practices"
      ],
      "source_sentence_hash": "87a0c4c3cd780c8d57c4a40bf6562a0d27a107f17f67af6d79f45b5e6af5e2e0",
      "word_count": 7
    },
    {
      "text": "Use a secure text-entry field when appropriate",
      "section_path": [
        "Entering data",
        "Best practices"
      ],
      "source_sentence_hash": "82d1f53e33f9e13f79bb74903bd9c13c846d77383afceb09344f4e83224ce657",
      "word_count": 7
    },
    {
      "text": "Never prepopulate a password field",
      "section_path": [
        "Entering data",
        "Best practices"
      ],
      "source_sentence_hash": "05b6d8384470af948612689f851c4cd7949831615bb9b569aaf6d8d93547e00e",
      "word_count": 5
    },
    {
      "text": "When possible, offer choices instead of requiring text entry",
      "section_path": [
        "Entering data",
        "Best practices"
      ],
      "source_sentence_hash": "f7d2d7e933479c8f5cd4293d778e7f445740fb973477e934efbfb021c4156f98",
      "word_count": 9
    },
    {
      "text": "As much as possible, let people provide data by dragging and dropping it or by pasting it",
      "section_path": [
        "Entering data",
        "Best practices"
      ],
      "source_sentence_hash": "64496c2cb35803bddbfd87210d42d938976645647069e1d88f2a805963d0d63c",
      "word_count": 17
    },
    {
      "text": "Dynamically validate field values",
      "section_path": [
        "Entering data",
        "Best practices"
      ],
      "source_sentence_hash": "9a26c8a2d8faa99f2e62d3bf38a71a0d4dafb5461277a2990cfb960abd1e95a4",
      "word_count": 4
    },
    {
      "text": "When data entry is necessary, make sure people understand that they must provide the required data before they can",
      "section_path": [
        "Entering data",
        "Best practices"
      ],
      "source_sentence_hash": "56e1fdc00520f006968c376eb176dfb31bd702e764d6df7254a2ca5d70170024",
      "word_count": 19
    },
    {
      "text": "Consider using an expansion tooltip to show the full version of clipped or truncated text in a field",
      "section_path": [
        "Entering data",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "501285d414293459ef5043bb7b866edcdd7ab43354ab5aab43392572b75797db",
      "word_count": 18
    },
