  "guidance_candidates": [
    {
      "text": "Let people experience your app before making a purchase",
      "section_path": [
        "In-app purchase",
        "Best practices"
      ],
      "source_sentence_hash": "1c092630d81df1dfd6af99067d09369f196b47880ca0357b2143651e725bf173",
      "word_count": 9
    },
    {
      "text": "Design an integrated shopping experience",
      "section_path": [
        "In-app purchase",
        "Best practices"
      ],
      "source_sentence_hash": "ee2751c3ce8390dfa1f7f45d1d897c1c68d86c7c4c59584a3849f8a4bb45845a",
      "word_count": 5
    },
    {
      "text": "Use simple, succinct product names and descriptions",
      "section_path": [
        "In-app purchase",
        "Best practices"
      ],
      "source_sentence_hash": "2071bb3b75ee0fa9f1eccb613f0bf86adbc5352a951e08fe7631fe3abbcec0f5",
      "word_count": 7
    },
    {
      "text": "Display the total billing price for each in-app purchase you offer, regardless of type",
      "section_path": [
        "In-app purchase",
        "Best practices"
      ],
      "source_sentence_hash": "729a3705bf28afff6330c9601b49eec3e61c8e041d00e4d99d1410d2d2af27cd",
      "word_count": 14
    },
    {
      "text": "Display your store only when people can make payments",
      "section_path": [
        "In-app purchase",
        "Best practices"
      ],
      "source_sentence_hash": "7e7b7317b18abf7a427652633e54898ecb5ec2943b2f3f315afe43a2777420c9",
      "word_count": 9
    },
    {
      "text": "Use the default confirmation sheet",
      "section_path": [
        "In-app purchase",
        "Best practices"
      ],
      "source_sentence_hash": "9333de5402340fb88bf6cf28ad87c571b88b9844fbaa439d4baf90b59b7b0ada",
      "word_count": 5
    },
    {
      "text": "Supporting Family Sharing",
      "section_path": [
        "In-app purchase",
        "Best practices",
        "Supporting Family Sharing"
      ],
      "source_sentence_hash": "7b594defb98286aa15e1c4e863a6e9c11671d1abf26bb96fbbf6797c24d4f6af",
      "word_count": 3
    },
    {
      "text": "Prominently mention Family Sharing in places where people learn about the content you offer",
      "section_path": [
        "In-app purchase",
        "Best practices",
        "Supporting Family Sharing"
      ],
      "source_sentence_hash": "8ffe2038a6d6253230ed2aeb88f0d2b24ecdb48bd2186e79c661ac5ba618025d",
      "word_count": 14
    },
    {
      "text": "Help people understand the benefits of Family Sharing and how to participate",
      "section_path": [
        "In-app purchase",
        "Best practices",
        "Supporting Family Sharing"
      ],
      "source_sentence_hash": "158e5e11a2844a9a176fca832a4eb0def0d1b958f650b924e9b3146d88e38b61",
      "word_count": 12
    },
    {
      "text": "Aim to customize your in-app messaging so that it makes sense to both purchasers and family members",
      "section_path": [
        "In-app purchase",
        "Best practices",
        "Supporting Family Sharing"
      ],
      "source_sentence_hash": "e29b236bb882b0ad80aa43af984bc1d094f4b1e86c834c38c3183c7d608a37f0",
      "word_count": 17
    },
    {
      "text": "Providing help with in-app purchases",
      "section_path": [
        "In-app purchase",
        "Best practices",
        "Providing help with in-app purchases"
      ],
      "source_sentence_hash": "78ba7b810d1b3d9ca1961d75a7e31c2f71c56a882782a98112cf571f3aef0def",
      "word_count": 5
    },
    {
      "text": "Provide help that customers can view before they request a refund",
      "section_path": [
        "In-app purchase",
        "Best practices",
        "Providing help with in-app purchases"
      ],
      "source_sentence_hash": "8d468b8935a27ba55f09775a7794418637c98e8f5744a62534af69f31b59bc16",
      "word_count": 11
    },
    {
      "text": "Use a simple title for the refund action, like “Refund” or “Request a Refund”",
      "section_path": [
        "In-app purchase",
        "Best practices",
        "Providing help with in-app purchases"
      ],
      "source_sentence_hash": "8dea245d11e25eb228f7be2ed07c30e90176080c51fc4bac20725cec0499659b",
      "word_count": 14
    },
    {
      "text": "Help people find the problematic purchase",
      "section_path": [
        "In-app purchase",
        "Best practices",
        "Providing help with in-app purchases"
      ],
      "source_sentence_hash": "a2dfec474cad5d633927282c1e24b4bfcf3d8f4e351e2d9c8324e3352e46bffb",
      "word_count": 6
    },
    {
      "text": "Consider offering alternative solutions",
      "section_path": [
        "In-app purchase",
        "Best practices",
        "Providing help with in-app purchases"
      ],
      "source_sentence_hash": "f370fa3c5d97c2ef11209174bb774310039b9e6f002209d7721ab944a3ee4aef",
      "word_count": 4
    },
    {
      "text": "Make it easy for people to request a refund",
      "section_path": [
        "In-app purchase",
        "Best practices",
        "Providing help with in-app purchases"
      ],
      "source_sentence_hash": "8d9d4e615083bdbecba7a516bf4d6df52d4fdf8210c12b14b504a596c5f4904e",
      "word_count": 9
    },
    {
      "text": "Avoid characterizing or providing guidance on Apple’s refund policies",
      "section_path": [
        "In-app purchase",
        "Best practices",
        "Providing help with in-app purchases"
      ],
      "source_sentence_hash": "6f15143fa67c43f189a093a9dd694a0abdf041393e31baee96f9fdf9d678f33b",
      "word_count": 9
    },
    {
      "text": "Call attention to subscription benefits during onboarding",
      "section_path": [
        "In-app purchase",
        "Auto-renewable subscriptions"
      ],
      "source_sentence_hash": "3228bbe00e16dceb2174d2cabee5defe3c39f7a9bc76be7f32e669593c6e30a1",
      "word_count": 7
    },
    {
      "text": "Offer a range of content choices, service levels, and durations",
      "section_path": [
        "In-app purchase",
        "Auto-renewable subscriptions"
      ],
      "source_sentence_hash": "d95eb13854862632a9a8c9eb90adca9a92c756c63bd803ce7fc98283e088406c",
      "word_count": 10
    },
    {
      "text": "Consider letting people try your content for free before signing up",
      "section_path": [
        "In-app purchase",
        "Auto-renewable subscriptions"
      ],
      "source_sentence_hash": "3d7bca2cdbbe99a558a974ed99f9e3849783564f619b6d796e3b35a1da8f059b",
      "word_count": 11
    },
    {
      "text": "Prompt people to subscribe at relevant times, like when they near their monthly limit of free content",
      "section_path": [
        "In-app purchase",
        "Auto-renewable subscriptions"
      ],
      "source_sentence_hash": "e114f52cea2ebee284ea473d0e813d6e546131f574c7205a370998a14913e9a5",
      "word_count": 17
    },
    {
      "text": "Encourage a new subscription only when someone isn’t already a subscriber",
      "section_path": [
        "In-app purchase",
        "Auto-renewable subscriptions"
      ],
      "source_sentence_hash": "bafaeb9f0fb668ff7c57642e9ed83fbba8a69df75d9ea6f494720fd2127be6c2",
      "word_count": 11
    },
    {
      "text": "Making signup effortless",
      "section_path": [
        "In-app purchase",
        "Auto-renewable subscriptions",
        "Making signup effortless"
      ],
      "source_sentence_hash": "50bece63ac59c27c6af31fc08435632db47c595072bace9306d11fa17757eca0",
      "word_count": 3
    },
    {
      "text": "Provide clear, distinguishable subscription options",
      "section_path": [
        "In-app purchase",
        "Auto-renewable subscriptions",
        "Making signup effortless"
      ],
      "source_sentence_hash": "b7be07ad51e4ce3d2d807610f23ea898779c6a09f3795570b1facc89dd35e535",
      "word_count": 5
    },
    {
      "text": "Simplify initial signup by asking only for necessary information",
      "section_path": [
        "In-app purchase",
        "Auto-renewable subscriptions",
        "Making signup effortless"
      ],
      "source_sentence_hash": "d0eeca5b7abcd7be8dbe51de787b02713f33bc8ed784d15db3bd8ea4efa9c31d",
      "word_count": 9
    },
    {
      "text": "In your tvOS app, help people sign up or authenticate using another device",
      "section_path": [
        "In-app purchase",
        "Auto-renewable subscriptions",
        "Making signup effortless"
      ],
      "source_sentence_hash": "91e1cf0b89019955832913398571cb412664953fa59f2327d98562a7f7722b63",
      "word_count": 13
    },
    {
      "text": "Give people more information in your app’s sign-up screen",
      "section_path": [
        "In-app purchase",
        "Auto-renewable subscriptions",
        "Making signup effortless"
      ],
      "source_sentence_hash": "38a4a12305279189f6148fee9f48d74eed2454b053593c5ea591b953bf997088",
      "word_count": 9
    },
    {
      "text": "Clearly describe how a free trial works",
      "section_path": [
        "In-app purchase",
        "Auto-renewable subscriptions",
        "Making signup effortless"
      ],
      "source_sentence_hash": "1d0f998222c67475dcaa8f5c8c489d2a94bacdce3e010b076b9d761c3f10d2de",
      "word_count": 7
    },
    {
      "text": "Include a sign-up opportunity in your app’s settings",
      "section_path": [
        "In-app purchase",
        "Auto-renewable subscriptions",
        "Making signup effortless"
      ],
      "source_sentence_hash": "a93391ff638785f2443378c1561a20f9dc2ff5d987874d8793bb0ede29e105e8",
      "word_count": 8
    },
    {
      "text": "Supporting offer codes",
      "section_path": [
        "In-app purchase",
        "Auto-renewable subscriptions",
        "Supporting offer codes"
      ],
      "source_sentence_hash": "748e80e5d4f257cfc118279b3836dff67804f0848fbc5b346315364a186e38e3",
      "word_count": 3
    },
    {
      "text": "Clearly explain offer details",
      "section_path": [
        "In-app purchase",
        "Auto-renewable subscriptions",
        "Supporting offer codes"
      ],
      "source_sentence_hash": "836999acfd5a4760c2a7c5cf4c5f1a3b56600629ea4df1bc0103cb4033d211d4",
      "word_count": 4
    },
    {
      "text": "Follow guidelines for creating a custom code",
      "section_path": [
        "In-app purchase",
        "Auto-renewable subscriptions",
        "Supporting offer codes"
      ],
      "source_sentence_hash": "011b6986b57fe38efcf0d0c7647dc2ed40092c8a68e9412cb1680b331c1a25dc",
      "word_count": 7
    },
    {
      "text": "Tell people how to redeem a custom code",
      "section_path": [
        "In-app purchase",
        "Auto-renewable subscriptions",
        "Supporting offer codes"
      ],
      "source_sentence_hash": "68faaf7442896746cdfd277ffe7b834bdfa44759b8c0b85776ed8743cc981920",
      "word_count": 8
    },
    {
      "text": "Consider supporting offer redemption within your app",
      "section_path": [
        "In-app purchase",
        "Auto-renewable subscriptions",
        "Supporting offer codes"
      ],
      "source_sentence_hash": "001a22f1d661a397c122621e63e609757781b8ca50fd8d5e487b5f32bdece52d",
      "word_count": 7
    },
    {
      "text": "Supply an engaging and informative promotional image",
      "section_path": [
        "In-app purchase",
        "Auto-renewable subscriptions",
        "Supporting offer codes"
      ],
      "source_sentence_hash": "37e743c218b126f22e6fcb2ec7e8db25bd870895a34d363058b18072c43efeae",
      "word_count": 7
    },
    {
      "text": "Help people benefit from unlocked content as soon as they complete the redemption flow",
      "section_path": [
        "In-app purchase",
        "Auto-renewable subscriptions",
        "Supporting offer codes"
      ],
      "source_sentence_hash": "95f9d3f68a775f325a160d908923dc8af769842d5b5f2ea69d7786efd7a207de",
      "word_count": 14
    },
    {
      "text": "Helping people manage their subscriptions",
      "section_path": [
        "In-app purchase",
        "Auto-renewable subscriptions",
        "Helping people manage their subscriptions"
      ],
      "source_sentence_hash": "4d9e2205e6cadb2d67802210c3cc858a77b6a40ceab2365edcedd4fe4c19b3c3",
      "word_count": 5
    },
    {
      "text": "Provide summaries of the customer’s subscriptions",
      "section_path": [
        "In-app purchase",
        "Auto-renewable subscriptions",
        "Helping people manage their subscriptions"
      ],
      "source_sentence_hash": "289d13b6fa26f074605d62a447cd6d4b70a871b1f25ac4cec1c0cd95bacab603",
      "word_count": 6
    },
    {
      "text": "Consider using the system-provided subscription-management UI",
      "section_path": [
        "In-app purchase",
        "Auto-renewable subscriptions",
        "Helping people manage their subscriptions"
      ],
      "source_sentence_hash": "540f4a6e02709aa18266f2fdce001caae664c3bf50b23274cf18249bf571542d",
      "word_count": 6
    },
    {
      "text": "Consider ways to encourage a subscriber to keep their subscription or resubscribe later",
      "section_path": [
        "In-app purchase",
        "Auto-renewable subscriptions",
        "Helping people manage their subscriptions"
      ],
      "source_sentence_hash": "2f866f5eddb66e5462b0404059707576aa2301e053e382e33669f5bb97431093",
      "word_count": 13
    },
    {
      "text": "Always make it easy for customers to cancel an auto-renewable subscription",
      "section_path": [
        "In-app purchase",
        "Auto-renewable subscriptions",
        "Helping people manage their subscriptions"
      ],
      "source_sentence_hash": "3f1a85f55c51c9d411df9f4e7f67a68dc26199a0e334c02a6de6c4774d96e98d",
      "word_count": 11
    },
    {
      "text": "Consider creating a branded, contextual experience to complement the system-provided management UI",
      "section_path": [
        "In-app purchase",
        "Auto-renewable subscriptions",
        "Helping people manage their subscriptions"
      ],
      "source_sentence_hash": "5bc2482c47ac6c3309a9528b3a2d9b6bdf1c1f6cb03290d8a45236f5641bb771",
      "word_count": 12
    },
    {
      "text": "Clearly describe the differences between versions of your app that run on different devices",
      "section_path": [
        "In-app purchase",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "00792c2cb5f97877571b498b2f6483bb2d00bfac51538650fbd7aa93844ad8e7",
      "word_count": 14
    },
    {
      "text": "Consider using a modal sheet to display the required information",
      "section_path": [
        "In-app purchase",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "6a761c2fc52a10f7e0eca0691950f01c566ac03a88ec0609bfdf59e96ab28a49",
      "word_count": 10
    },
    {
      "text": "Make subscription options easy to compare on a small screen",
      "section_path": [
        "In-app purchase",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "dc36b4ad20ccede48b6ab65d05c59acff948e945f4f514949e17c98cb7454277",
      "word_count": 10
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "In-app purchase",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
