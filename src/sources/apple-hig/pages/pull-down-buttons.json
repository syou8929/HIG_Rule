  "guidance_candidates": [
    {
      "text": "Use a pull-down button to present commands or items that are directly related to the button’s action",
      "section_path": [
        "Pull-down buttons",
        "Best practices"
      ],
      "source_sentence_hash": "1c8d60ebb4b299a2aba627f1c05e6a3ad790ddcbebf6f4699b754db04e078f85",
      "word_count": 17
    },
    {
      "text": "An Add button could present a menu that lets people specify the item they want to add",
      "section_path": [
        "Pull-down buttons",
        "Best practices"
      ],
      "source_sentence_hash": "6a1c69c8135f6054950ca8de4e873bc87d520e895bef412df561a0cc9c3eeecb",
      "word_count": 17
    },
    {
      "text": "A Sort button could use a menu to let people select an attribute on which to sort",
      "section_path": [
        "Pull-down buttons",
        "Best practices"
      ],
      "source_sentence_hash": "382c59c10d3c180a3a4d00427afee936506f4848309a3d8936f5771a8aa8bf59",
      "word_count": 17
    },
    {
      "text": "A Back button could let people choose a specific location to revisit instead of opening the previous one",
      "section_path": [
        "Pull-down buttons",
        "Best practices"
      ],
      "source_sentence_hash": "f2fb434ea78b6dd7246f4fc7ab2f42d138504174ef94a529936517a5a2137f9b",
      "word_count": 18
    },
    {
      "text": "Avoid putting all of a view’s actions in one pull-down button",
      "section_path": [
        "Pull-down buttons",
        "Best practices"
      ],
      "source_sentence_hash": "1fbf6e5c733a127559867b2e7fb1c4ab5ab1fb877766480194fed4c508a93963",
      "word_count": 11
    },
    {
      "text": "Balance menu length with ease of use",
      "section_path": [
        "Pull-down buttons",
        "Best practices"
      ],
      "source_sentence_hash": "8e9ccd80c412fd54d792e885af5303db4c52cb7f991fb65f75d5dc029690c201",
      "word_count": 7
    },
    {
      "text": "Display a succinct menu title only if it adds meaning",
      "section_path": [
        "Pull-down buttons",
        "Best practices"
      ],
      "source_sentence_hash": "6d1029edf5bdb8437e285d100bb5fb7e3cf061d26ed36a478ee4be06d6e82e77",
      "word_count": 10
    },
    {
      "text": "Let people know when a pull-down button’s menu item is destructive, and ask them to confirm their intent",
      "section_path": [
        "Pull-down buttons",
        "Best practices"
      ],
      "source_sentence_hash": "8e67061593d50153d23492a418b84b2f4a31f4c2fcc5b80b16cf56b85d374e6f",
      "word_count": 18
    },
    {
      "text": "Include an interface icon with a menu item when it provides value",
      "section_path": [
        "Pull-down buttons",
        "Best practices"
      ],
      "source_sentence_hash": "ef890fe60dd4880a1b1667bc7029b0ce6e37aaa60092bcd94a7e4fc7e489ce9f",
      "word_count": 12
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "Pull-down buttons",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "Consider using a More pull-down button to present items that don’t need prominent positions in the main interface",
      "section_path": [
