    },
    {
      "text": "Keep consistent margins within a snippet custom view",
      "section_path": [
        "Snippets",
        "Best practices"
      ],
      "source_sentence_hash": "89ab7220d690bed36da0d78f8b38022f22759617ffde093d378cddc2187638fc",
      "word_count": 8
    },
    {
      "text": "Keep content concise",
      "section_path": [
        "Snippets",
        "Best practices"
      ],
      "source_sentence_hash": "93901a05d0b62d211650d3359981295fd224272baded12e08d35d6e39c845edf",
      "word_count": 3
    },
    {
      "text": "To ensure all content is visible, create custom views no taller than 400 points",
      "section_path": [
        "Snippets",
        "Best practices"
      ],
      "source_sentence_hash": "a32e200f691d12640c7ed98fa4345fad9ad278fe0b8c8383f2eba8ed4835f295",
      "word_count": 14
    },
    {
      "text": "Account for preferred text sizes when deciding how much text to include",
      "section_path": [
        "Snippets",
        "Best practices"
      ],
      "source_sentence_hash": "d62331b34e19a7da1143ee8c46477f50a1d8aed45a722ba1c1ead31afb958de8",
      "word_count": 12
    },
    {
      "text": "For detailed result content, deep-link to the app instead of expanding the custom view",
      "section_path": [
        "Snippets",
        "Best practices"
      ],
      "source_sentence_hash": "7da4b481da4344dbbcc979b84908c3c708810ee6390cddde876714ba9a499318",
      "word_count": 14
    },
    {
      "text": "Choose a descriptive label for a confirmation snippet’s primary button",
      "section_path": [
        "Snippets",
        "Best practices"
      ],
      "source_sentence_hash": "9c788f4d322d345e0fef3e808025c39666226f33d9f6d05835b746f6763edbac",
      "word_count": 10
    },
    {
      "text": "Communicate a snippet’s purpose visually",
      "section_path": [
        "Snippets",
        "Best practices"
      ],
      "source_sentence_hash": "a212ca7558bc86ee8ea2a54fbd86748cf002e792e21bfab530559c23389770dc",
      "word_count": 5
    },
    {
      "text": "Don’t rely on showing dialogue text to convey a snippet’s purpose",
      "section_path": [
        "Snippets",
        "Best practices"
      ],
      "source_sentence_hash": "68313592a607e7fff04bf69ccd39dc880ff4766b63de141a6ee437f27613d2ff",
      "word_count": 11
    },
    {
      "text": "Prefer omitting dialogue text from a snippet’s visual representation",
      "section_path": [
        "Snippets",
        "Best practices"
      ],
      "source_sentence_hash": "27f9098f708a2bd5de82a8b6ac922e9707ba4307bbad368d5a0945cd02d91822",
      "word_count": 9
    },
