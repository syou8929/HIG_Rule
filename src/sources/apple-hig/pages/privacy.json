  "guidance_candidates": [
    {
      "text": "Request access only to data that you actually need",
      "section_path": [
        "Privacy",
        "Best practices"
      ],
      "source_sentence_hash": "95837f76b4cafe31a27501fecf28cdb5e6336675dc505f7574caa9ecdbfc9017",
      "word_count": 9
    },
    {
      "text": "Be transparent about how your app collects and uses people’s data",
      "section_path": [
        "Privacy",
        "Best practices"
      ],
      "source_sentence_hash": "4ccf55b17fd518440eec830cb1999a377434d79c39d3320defc910ca3c05d26a",
      "word_count": 11
    },
    {
      "text": "Process data on the device where possible",
      "section_path": [
        "Privacy",
        "Best practices"
      ],
      "source_sentence_hash": "783f3d0c48a428ae0846bd94a7d16c0186a0bb216487d0bbde6116c92f37b1c9",
      "word_count": 7
    },
    {
      "text": "Adopt system-defined privacy protections and follow security best practices",
      "section_path": [
        "Privacy",
        "Best practices"
      ],
      "source_sentence_hash": "ab14123d457153341ec43670ccb5c19f5b9cfbd505ec9befc39050866eea0a75",
      "word_count": 9
    },
    {
      "text": "Personal data, including location, health, financial, contact, and other personally identifying information",
      "section_path": [
        "Privacy",
        "Requesting permission"
      ],
      "source_sentence_hash": "7b7c40c392246bedcef2ab670043ff0585b2f501b724a6526d3c87e88c19c4b7",
      "word_count": 12
    },
    {
      "text": "User-generated content like emails, messages, calendar data, contacts, gameplay information, Apple Music activity, HomeKit data, and audio, video, and",
      "section_path": [
        "Privacy",
        "Requesting permission"
      ],
      "source_sentence_hash": "eadea62cf7834960f34a111308b0c667aebca332b6a79f43209ec11b43a87142",
      "word_count": 19
    },
    {
      "text": "Protected resources like Bluetooth peripherals, home automation features, Wi-Fi connections, and local networks",
      "section_path": [
        "Privacy",
        "Requesting permission"
      ],
      "source_sentence_hash": "56e9120677d07bdff73ff9c8c27f636f8614f93e56567a39da60627934c593cc",
      "word_count": 13
    },
    {
      "text": "Device capabilities like camera and microphone",
      "section_path": [
        "Privacy",
        "Requesting permission"
      ],
      "source_sentence_hash": "59287fa7b87d51ce2fc6311eaa64707536999a055e271d9c69a13b67cfdfa652",
      "word_count": 6
    },
    {
      "text": "In a visionOS app running in a Full Space, ARKit data, such as hand tracking, plane estimation, image anchoring,",
      "section_path": [
        "Privacy",
        "Requesting permission"
      ],
      "source_sentence_hash": "ad986a5069e9c787e4968657eb47227bac61e3fe6a75a7dddff1d3898ba3bad8",
      "word_count": 19
    },
    {
      "text": "The device’s advertising identifier, which supports app tracking",
      "section_path": [
        "Privacy",
        "Requesting permission"
      ],
      "source_sentence_hash": "50616fa0f96dd62880f29f3992a59e9bd8e200f91ed5a277cd383f0d333eea67",
      "word_count": 8
    },
    {
      "text": "Request permission only when your app clearly needs access to the data or resource",
      "section_path": [
        "Privacy",
        "Requesting permission"
      ],
      "source_sentence_hash": "8e62562776a6f956a63efd2b0651c8ae9a851832bc638a05c83c3c8e2dd01318",
      "word_count": 14
    },
    {
      "text": "Avoid requesting permission at launch unless the data or resource is required for your app to function",
      "section_path": [
        "Privacy",
        "Requesting permission"
      ],
      "source_sentence_hash": "a9b24c39e846bf21c40d3098f7825c05747b35b0406a4a12787c0c2e684073d9",
      "word_count": 17
    },
    {
      "text": "Write copy that clearly describes how your app uses the ability, data, or resource you’re requesting",
      "section_path": [
        "Privacy",
        "Requesting permission"
      ],
      "source_sentence_hash": "941e6320b7f6240b97487c073f1e2d7fc482e2e362cac0c72aba92de2fc7b929",
      "word_count": 16
    },
    {
      "text": "Pre-alert screens, windows, or views",
      "section_path": [
        "Privacy",
        "Requesting permission",
        "Pre-alert screens, windows, or views"
      ],
      "source_sentence_hash": "c8d813ad17e3b2da06d75a109a61bc23f25ce6f9b8886c5ca18dacf8cc2e1d49",
      "word_count": 5
    },
    {
      "text": "Include only one button and make it clear that it opens the system alert",
      "section_path": [
        "Privacy",
        "Requesting permission",
        "Pre-alert screens, windows, or views"
      ],
      "source_sentence_hash": "16eb0bf131b444f748870cbb4dc89aa9f5226b53578651043cc05eb29960eb53",
      "word_count": 14
    },
    {
      "text": "Don’t include additional actions in your custom screen or window",
      "section_path": [
        "Privacy",
        "Requesting permission",
        "Pre-alert screens, windows, or views"
      ],
      "source_sentence_hash": "24278d7667fd56e75d54c27fd6f7b571a417cc962778f0bf22bb68bda5a8730c",
      "word_count": 10
    },
    {
      "text": "Tracking requests",
      "section_path": [
        "Privacy",
        "Requesting permission",
        "Tracking requests"
      ],
      "source_sentence_hash": "ed7fdc0b61e2d040f47abb42480029bc2b1dff97e21a362160fd54fb814f883f",
      "word_count": 2
    },
    {
      "text": "Never precede the system-provided alert with a custom screen or window that could confuse or mislead people",
      "section_path": [
        "Privacy",
        "Requesting permission",
        "Tracking requests"
      ],
      "source_sentence_hash": "e865d2e46e04643d4e26419fd150741d0d7cb5f576550476b1a324f7f6bfc7b5",
      "word_count": 17
    },
    {
      "text": "Consider using the location button to give people a lightweight way to share their location for specific app features",
      "section_path": [
        "Privacy",
        "Location button"
      ],
      "source_sentence_hash": "4b6dd0305158f884ac79da29d24beb490799d342e8e28c964a311318fa30b737",
      "word_count": 19
    },
    {
      "text": "Consider customizing the location button to harmonize with your UI",
      "section_path": [
        "Privacy",
        "Location button"
      ],
      "source_sentence_hash": "bffb5d55f0c417d6548138a0e9c75a74a69d38dc9928f841eec5f8c433c101e2",
      "word_count": 10
    },
    {
      "text": "Choose the system-provided title that works best with your feature, such as “Current Location” or “Share My Current Location.”",
      "section_path": [
        "Privacy",
        "Location button"
      ],
      "source_sentence_hash": "56d72583133e0c517ac8f65cdb3368d842b94a2bb5422dd891ee172c95f23333",
      "word_count": 19
    },
    {
      "text": "Choose the filled or outlined location glyph",
      "section_path": [
        "Privacy",
        "Location button"
      ],
      "source_sentence_hash": "313b4ffd23abf27dc1a530a0d76ee57c8fffb0f59a526c75ab4e6f60453a3500",
      "word_count": 7
    },
    {
      "text": "Select a background color and a color for the title and glyph",
      "section_path": [
        "Privacy",
        "Location button"
      ],
      "source_sentence_hash": "922bf81256d20933e3384db92b919e0b21fdc5df59eb3a96180bf47c3f608ee3",
      "word_count": 12
    },
    {
      "text": "Adjust the button’s corner radius",
      "section_path": [
        "Privacy",
        "Location button"
      ],
      "source_sentence_hash": "f9ef260ea6ac2ee4a4f5cab70774468d04da117457eb61c167fdeee2b4e0ca60",
      "word_count": 5
    },
    {
      "text": "Avoid relying solely on passwords for authentication",
      "section_path": [
        "Privacy",
        "Protecting data"
      ],
      "source_sentence_hash": "fe9a76edd304f1be276a9d5c46ff18ecc933ab6de8d969a880a6902f4cb25d8e",
      "word_count": 7
    },
    {
      "text": "Store sensitive information in a keychain",
      "section_path": [
        "Privacy",
        "Protecting data"
      ],
      "source_sentence_hash": "63df9c59463902045b9d7c3d9703b7660dcbebed0a432aa3030554b095ffb024",
      "word_count": 6
    },
    {
      "text": "Never store passwords or other secure content in plain-text files",
      "section_path": [
        "Privacy",
        "Protecting data"
      ],
      "source_sentence_hash": "2a6f8fa600f20a9b2f83c9e85a04a0d5d200e583f092a0c86a023f37469bc76c",
      "word_count": 10
    },
    {
      "text": "Avoid inventing custom authentication schemes",
      "section_path": [
        "Privacy",
        "Protecting data"
      ],
      "source_sentence_hash": "7115a7470f711882681e15dd0b6891eddf5a31ffef2fe3b9f592afe6d4b6c6bb",
      "word_count": 5
    },
    {
      "text": "Sign your app with a valid Developer ID",
      "section_path": [
        "Privacy",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "20856f05bd8e2420d2570a09eb780a532d35b7b0be9d2052dbaf95360640c722",
      "word_count": 8
    },
    {
      "text": "Protect people’s data with app sandboxing",
      "section_path": [
        "Privacy",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "baa0ea7708f592baa818821b6145092c852f21df74ad48c42970d843ec717b0c",
      "word_count": 6
    },
    {
      "text": "Avoid making assumptions about who is signed in",
      "section_path": [
        "Privacy",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "8abe13aaa1ff3157fabf18df3643d8de31472a92254a771d8f46ee9e23c97674",
      "word_count": 8
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Privacy",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
