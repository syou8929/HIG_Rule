  "guidance_candidates": [
    {
      "text": "Use an action sheet — not an alert — to offer choices related to an intentional action",
      "section_path": [
        "Action sheets",
        "Best practices"
      ],
      "source_sentence_hash": "e9753a1ca2a1623f203c33279ba3dd2d065d18f96dc17e8a61b7a1add0a2b945",
      "word_count": 17
    },
    {
      "text": "Use action sheets sparingly",
      "section_path": [
        "Action sheets",
        "Best practices"
      ],
      "source_sentence_hash": "4bdc5a41b66d0afbecfa7c06fadbdc3fe50165cd6ce1dc21f2a7eeea21e98c1c",
      "word_count": 4
    },
    {
      "text": "Aim to keep titles short enough to display on a single line",
      "section_path": [
        "Action sheets",
        "Best practices"
      ],
      "source_sentence_hash": "839cfebf4e9537a836cea3a3b4ba0de5b08e3a3737db727c32b6a84b0d67c253",
      "word_count": 12
    },
    {
      "text": "Provide a message only if necessary",
      "section_path": [
        "Action sheets",
        "Best practices"
      ],
      "source_sentence_hash": "e71282ff81dd1badbe630ded096265825bb14e6790d0c23bc0b834662ef5f617",
      "word_count": 6
    },
    {
      "text": "If necessary, provide a Cancel button that lets people reject an action that might destroy data",
      "section_path": [
        "Action sheets",
        "Best practices"
      ],
      "source_sentence_hash": "b2c3d3cef77340a08a99f5238c3706837a9d61dee01cabd5ac9773c708ea6eb7",
      "word_count": 16
    },
    {
      "text": "Make destructive choices visually prominent",
      "section_path": [
        "Action sheets",
        "Best practices"
      ],
      "source_sentence_hash": "90f0afecb58ce042b840dc8ed03b73d388351a84f1b15dbeb9f1aef9dffff25c",
      "word_count": 5
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "Action sheets",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "Use an action sheet — not a menu — to provide choices related to an action",
      "section_path": [
        "Action sheets",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "f97bfc2ab3935ebc873cb6a518e43763a3aecf2e585d894ccdfd419d318444ac",
      "word_count": 16
    },
    {
      "text": "Avoid letting an action sheet scroll",
      "section_path": [
        "Action sheets",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "5e90360213222aab82191c3131a2957874363a69c3fed666f59a2fee04d47962",
      "word_count": 6
    },
    {
      "text": "Avoid displaying more than four buttons in an action sheet, including the Cancel button",
      "section_path": [
        "Action sheets",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "2700d90e7a8caf5d74cc5c864deafb612c01b619f8a69b234885c0bf0eb7d8f8",
