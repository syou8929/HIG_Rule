  "guidance_candidates": [
    {
      "text": "Support the Action button with a set of your app’s essential functions",
      "section_path": [
        "Action button",
        "Best practices"
      ],
      "source_sentence_hash": "75af0a1791af76e1c1dea9d031befb29142e8d92620418fb3e6097a7fd77aba6",
      "word_count": 12
    },
    {
      "text": "Write a short label that succinctly describes each Action button action",
      "section_path": [
        "Action button",
        "Best practices"
      ],
      "source_sentence_hash": "e2185beae73eaf576b24904fbc60cec4fee3b677f385ddd81c7e57374c88acd2",
      "word_count": 11
    },
    {
      "text": "Use title-style capitalization for Action button labels",
      "section_path": [
        "Action button",
        "Best practices"
      ],
      "source_sentence_hash": "e2185beae73eaf576b24904fbc60cec4fee3b677f385ddd81c7e57374c88acd2",
      "word_count": 7
    },
    {
      "text": "Write Action button labels beginning with a verb",
      "section_path": [
        "Action button",
        "Best practices"
      ],
      "source_sentence_hash": "e2185beae73eaf576b24904fbc60cec4fee3b677f385ddd81c7e57374c88acd2",
      "word_count": 8
    },
    {
      "text": "Use present tense in Action button labels",
      "section_path": [
        "Action button",
        "Best practices"
      ],
      "source_sentence_hash": "e2185beae73eaf576b24904fbc60cec4fee3b677f385ddd81c7e57374c88acd2",
      "word_count": 7
    },
    {
      "text": "Avoid articles and prepositions in Action button labels",
      "section_path": [
        "Action button",
        "Best practices"
      ],
      "source_sentence_hash": "e2185beae73eaf576b24904fbc60cec4fee3b677f385ddd81c7e57374c88acd2",
      "word_count": 8
    },
    {
      "text": "Keep Action button labels to a maximum of three words",
      "section_path": [
        "Action button",
        "Best practices"
      ],
      "source_sentence_hash": "e2185beae73eaf576b24904fbc60cec4fee3b677f385ddd81c7e57374c88acd2",
      "word_count": 10
    },
    {
      "text": "Prefer letting the system show people how to use the Action button with your app",
      "section_path": [
        "Action button",
        "Best practices"
      ],
      "source_sentence_hash": "8fbfcd718793e71e7f42859a1f756087eacb3554e5917a8fdcae00c4cb0a1b1d",
      "word_count": 15
    },
    {
      "text": "Avoid repeating system Action button guidance or usage tips",
      "section_path": [
        "Action button",
        "Best practices"
      ],
      "source_sentence_hash": "8fbfcd718793e71e7f42859a1f756087eacb3554e5917a8fdcae00c4cb0a1b1d",
      "word_count": 9
    },
    {
      "text": "Let people use your actions without leaving their current context",
      "section_path": [
        "Action button",
        "Platform considerations",
        "iOS"
      ],
      "source_sentence_hash": "74b52b2c816e9e990c271d3eae63736826949e56dd81f1b0450d6786227afad3",
      "word_count": 10
    },
    {
      "text": "Consider offering a secondary function that supports or advances the primary action people choose",
      "section_path": [
        "Action button",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "1f5ba94bb7ee4ee4b74f634bcdfbfadf051911fd1fbcc2972fc0dedd8687bf73",
      "word_count": 14
    },
    {
      "text": "Ensure subsequent Action button presses flow logically from the first press and fit the current context",
      "section_path": [
        "Action button",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "1f5ba94bb7ee4ee4b74f634bcdfbfadf051911fd1fbcc2972fc0dedd8687bf73",
      "word_count": 16
    },
    {
      "text": "Prefer using subsequent button presses to support additional functionality rather than to stop or conclude a function",
      "section_path": [
        "Action button",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "1aedbd05008c7dbeb2d7454e4e34a26dc30be17e9dac58206d821091a89d409d",
      "word_count": 17
    },
    {
      "text": "Be sure to support combined-button pausing unless it creates a negative experience",
      "section_path": [
        "Action button",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "44e56a3bf7e44ab311fd8e6fca775517d8829fe4811a472d297fd1a575b04c3a",
      "word_count": 12
    }
