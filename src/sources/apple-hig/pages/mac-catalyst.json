      ],
      "source_sentence_hash": "ede3098ac0bc06cd1e98edc281b62863147c99739c5a004c0484a008214b94fe",
      "word_count": 2
    },
    {
      "text": "Color picker",
      "section_path": [
        "Mac Catalyst",
        "Before you start"
      ],
