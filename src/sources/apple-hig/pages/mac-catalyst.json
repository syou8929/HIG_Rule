  "guidance_candidates": [
    {
      "text": "Drag and drop",
      "section_path": [
        "Mac Catalyst",
        "Before you start"
      ],
      "source_sentence_hash": "ab20a79ffd5c77ac75547add15a2d19063844a093ed53a2e4f56c328d5209ef1",
      "word_count": 3
    },
    {
      "text": "Keyboard navigation and shortcuts",
      "section_path": [
        "Mac Catalyst",
        "Before you start"
      ],
      "source_sentence_hash": "fb24a159f233701a2f757bda850d88fd5c2932a5968eb46c1a9f78dedc5764af",
      "word_count": 4
    },
    {
      "text": "Multiple windows",
      "section_path": [
        "Mac Catalyst",
        "Before you start"
      ],
      "source_sentence_hash": "6774215e7eb9a17cb5286effb8d7cbe81d2296518e1946ba07299d928736c731",
      "word_count": 2
    },
    {
      "text": "When you adopt the Mac idiom, thoroughly audit your app’s layout, and plan to make changes to it",
      "section_path": [
        "Mac Catalyst",
        "Choose an idiom"
      ],
      "source_sentence_hash": "5219d7580b3dbb9107f7a70abff1081620ba2608f40d7f078022d4e8a97b960c",
      "word_count": 18
    },
    {
      "text": "Adjust font sizes as needed",
      "section_path": [
        "Mac Catalyst",
        "Choose an idiom"
      ],
      "source_sentence_hash": "10d8e15095c1994f4b87ce3c9ccc081333d84401b3b2c6559454150abae2b7fb",
      "word_count": 5
    },
    {
      "text": "Make sure views and images look good in the Mac version of your app",
      "section_path": [
        "Mac Catalyst",
        "Choose an idiom"
      ],
      "source_sentence_hash": "cfe78abf880dc35f2b62cfaf720ba457b942e6223399b90da5985105e3c63da3",
      "word_count": 14
    },
    {
      "text": "Limit your appearance customizations to standard macOS appearance customizations that are the same or similar to those available in",
      "section_path": [
        "Mac Catalyst",
        "Choose an idiom"
      ],
      "source_sentence_hash": "1bc32ebf21f882a9f69058c40eb583b5ec50b2f3b4b562639e82da2b4c93a767",
      "word_count": 19
    },
    {
      "text": "Make sure people retain access to important tab-bar items in the Mac version of your app",
      "section_path": [
        "Mac Catalyst",
        "Integrate the Mac experience",
        "Navigation"
      ],
      "source_sentence_hash": "e72992d345801d3f2a5e3c62840fc0d239af7499656ec8f077b6ccee8c554c76",
      "word_count": 16
    },
    {
      "text": "Offer multiple ways to move between pages",
      "section_path": [
        "Mac Catalyst",
        "Integrate the Mac experience",
        "Navigation"
      ],
      "source_sentence_hash": "b7de50bb99745073e9eb7214240ce569903bf40d36074a584c796a93d60b76d8",
      "word_count": 7
    },
    {
      "text": "App icons",
      "section_path": [
        "Mac Catalyst",
        "Integrate the Mac experience",
        "App icons"
      ],
      "source_sentence_hash": "3ffe846326f83f77d809c6f4f23e96099cad18c7d10bbf993c9f78c3fc5cff1a",
      "word_count": 2
    },
    {
      "text": "Create a macOS version of your app icon",
      "section_path": [
        "Mac Catalyst",
        "Integrate the Mac experience",
        "App icons"
      ],
      "source_sentence_hash": "6d7541461a4e9e4d62a002b54debff3dccacd1a5a42350886a73d055901fbc92",
      "word_count": 8
    },
    {
      "text": "Consider moving controls from the main UI of your iPad app to your Mac app’s toolbar",
      "section_path": [
        "Mac Catalyst",
        "Integrate the Mac experience",
        "Layout"
      ],
      "source_sentence_hash": "02c06c7adee7c2366f99260d2ac2c535815db8db951338f1151b05de3415fd6c",
      "word_count": 16
    },
    {
      "text": "As much as possible, adopt a top-down flow",
      "section_path": [
        "Mac Catalyst",
        "Integrate the Mac experience",
        "Layout"
      ],
      "source_sentence_hash": "bcbb4fd660371118193da000a2bdefb1ffdd1044759859783ffa7430887d5d50",
      "word_count": 8
    },
    {
      "text": "Relocate buttons from the side and bottom edges of the screen",
      "section_path": [
        "Mac Catalyst",
        "Integrate the Mac experience",
        "Layout"
      ],
      "source_sentence_hash": "13750986f315b2ab18772f9e0225af71649737bf4ef2c06cb8f88b172bcebdff",
      "word_count": 11
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Mac Catalyst",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
