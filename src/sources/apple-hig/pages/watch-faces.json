      "word_count": 13
    },
    {
      "text": "Support multiple complications in a shareable watch face when possible",
      "section_path": [
        "Watch faces",
        "Best practices"
      ],
      "source_sentence_hash": "df43eee45bdbb9ecb3c95c6f385707bfebb0bfe5290baac56e5b40d1ec6b194e",
      "word_count": 10
    },
    {
      "text": "Consider specifying a system accent color, images, or styles",
      "section_path": [
        "Watch faces",
        "Best practices"
      ],
      "source_sentence_hash": "df43eee45bdbb9ecb3c95c6f385707bfebb0bfe5290baac56e5b40d1ec6b194e",
      "word_count": 9
    },
    {
      "text": "Display a preview of each watch face you share",
      "section_path": [
        "Watch faces",
        "Best practices"
      ],
      "source_sentence_hash": "136255912a34f89e2fe40efb3b1f2d687ff18cc3854ac1d1b9e9f5f6487b947d",
      "word_count": 9
    },
    {
      "text": "Show the advantages of a shared watch face in its preview",
      "section_path": [
        "Watch faces",
        "Best practices"
      ],
      "source_sentence_hash": "6e7646c5ee37f846f541e7cd750d9ed563d0d85fe99a3cfc94ab3923ea694db8",
      "word_count": 11
    },
    {
      "text": "Consider an illustrated or high-fidelity hardware bezel for a watch-face preview",
      "section_path": [
        "Watch faces",
        "Best practices"
      ],
      "source_sentence_hash": "6e7646c5ee37f846f541e7cd750d9ed563d0d85fe99a3cfc94ab3923ea694db8",
      "word_count": 11
    },
    {
      "text": "Aim to offer shareable watch faces for all Apple Watch devices",
      "section_path": [
        "Watch faces",
        "Best practices"
      ],
      "source_sentence_hash": "b4984b6efa9a2fb1ce2f5c7fe7e70381860952ceeeb5504ea27c218e17f952bb",
      "word_count": 11
    },
    {
      "text": "Consider a similar configuration compatible with earlier Apple Watch devices",
      "section_path": [
        "Watch faces",
        "Best practices"
      ],
      "source_sentence_hash": "ce79f919b937edfa89965075bb416c5bc1f72ae54c493ae594e42abfd56f2e7d",
      "word_count": 10
    },
    {
      "text": "Consider labeling each shareable watch face with supported devices",
      "section_path": [
        "Watch faces",
        "Best practices"
      ],
      "source_sentence_hash": "ce79f919b937edfa89965075bb416c5bc1f72ae54c493ae594e42abfd56f2e7d",
      "word_count": 9
    },
    {
      "text": "Respond gracefully if people choose an incompatible watch face",
      "section_path": [
        "Watch faces",
        "Best practices"
