  "guidance_candidates": [
    {
      "text": "Use a segmented control to provide closely related choices that affect an object, state, or view",
      "section_path": [
        "Segmented controls",
        "Best practices"
      ],
      "source_sentence_hash": "94061e41d98c883ac6cb494fba45985722d7f80763f7198581f7ce37f7bd5c7f",
      "word_count": 16
    },
    {
      "text": "Consider a segmented control when it’s important to group functions together, or to clearly show their selection state",
      "section_path": [
        "Segmented controls",
        "Best practices"
      ],
      "source_sentence_hash": "c43ad9a70e444c1f5ab9878abbef30036cc19518f2d59ea833b230282764fbc9",
      "word_count": 18
    },
    {
      "text": "Keep control types consistent within a single segmented control",
      "section_path": [
        "Segmented controls",
        "Best practices"
      ],
      "source_sentence_hash": "1f2290ef5a907ecbada4103a1fea6fd530736a01b386f33a54d444b205c929a5",
      "word_count": 9
    },
    {
      "text": "Limit the number of segments in a control",
      "section_path": [
        "Segmented controls",
        "Best practices"
      ],
      "source_sentence_hash": "210dd9304d4002f36733ca70b12517933eced3c06dd991562ff3ca4501fd0a08",
      "word_count": 8
    },
    {
      "text": "In general, keep segment size consistent",
      "section_path": [
        "Segmented controls",
        "Best practices"
      ],
      "source_sentence_hash": "304f59f689057ce7cd8dd533ab630b7b8135b71942ad1807a4af91d717f40521",
      "word_count": 6
    },
    {
      "text": "Prefer using either text or images — not a mix of both — in a single segmented control",
      "section_path": [
        "Segmented controls",
        "Content"
      ],
      "source_sentence_hash": "bcde7fd32a99926ab6cabfd4812b11be00db7f9fb755985022879674252aa028",
      "word_count": 18
    },
    {
      "text": "As much as possible, use content with a similar size in each segment",
      "section_path": [
        "Segmented controls",
        "Content"
      ],
      "source_sentence_hash": "541312c085e7c22c1d696c63125d088c85f841c8ef0fc8335dcae7cbc73ee687",
      "word_count": 13
    },
    {
      "text": "Use nouns or noun phrases for segment labels",
      "section_path": [
        "Segmented controls",
        "Content"
      ],
      "source_sentence_hash": "011db4fa27049e84906bc3475d1bc53979a217deb608760a8e7456b277f41410",
      "word_count": 8
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "Segmented controls",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "Consider a segmented control to switch between closely related subviews",
      "section_path": [
        "Segmented controls",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "9e462f264448f697040fc93cd4b09b0dfcf13614fc406614b1e7c33789b6251c",
      "word_count": 10
    },
    {
      "text": "Consider using introductory text to clarify the purpose of a segmented control",
      "section_path": [
        "Segmented controls",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "d7e5a6c795ed5cfa70e62f3a7d473e5703477eab50485987c06dee7e22215dce",
      "word_count": 12
    },
    {
      "text": "Use a tab view in the main window area — instead of a segmented control — for view switching",
      "section_path": [
        "Segmented controls",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "179feaa5bafd3a4bf89451e87bdfd9c77b06760629a6d03b9e2fdaa79729d2f7",
      "word_count": 19
    },
    {
      "text": "Consider supporting spring loading",
      "section_path": [
        "Segmented controls",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "b691d5abdf7dfb9bab0cfa6565f0e38dd1bed3947f1da3f13256f907c27a859b",
      "word_count": 4
    },
    {
      "text": "Consider using a split view instead of a segmented control on screens that perform content filtering",
      "section_path": [
        "Segmented controls",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "a6af7f8dff6c8f643b071936f036502f8e10fe4d7ff450c12f15e466d865ab42",
      "word_count": 16
    },
    {
      "text": "Avoid putting other focusable elements close to segmented controls",
      "section_path": [
        "Segmented controls",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "3ceae23ca0fdccaebf3f4f71a8a6a8a8f7224b302efd15a7bd89f0a362617a5a",
      "word_count": 9
    },
    {
      "text": "Developer documentation",
      "section_path": [
