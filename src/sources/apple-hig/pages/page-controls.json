  "guidance_candidates": [
    {
      "text": "Use page controls to represent movement between an ordered list of pages",
      "section_path": [
        "Page controls",
        "Best practices"
      ],
      "source_sentence_hash": "00bafe689dad8509fd651c39df65cd5ccb8c565e81a7ee29227afbf4a1016809",
      "word_count": 12
    },
    {
      "text": "Center a page control at the bottom of the view or window",
      "section_path": [
        "Page controls",
        "Best practices"
      ],
      "source_sentence_hash": "014a7afe45919f0b56c6f67575e2064490aa76e989a72273c5ea15ef797779f3",
      "word_count": 12
    },
    {
      "text": "Although page controls can handle any number of pages, don’t display too many",
      "section_path": [
        "Page controls",
        "Best practices"
      ],
      "source_sentence_hash": "0bda46491fdc85e315c69b0cc1cf589932a1598eed6090bc8e1af6aa8ed8b124",
      "word_count": 13
    },
    {
      "text": "Make sure custom indicator images are simple and clear",
      "section_path": [
        "Page controls",
        "Customizing indicators"
      ],
      "source_sentence_hash": "89e92113a94e8b85955a0c0f9008d43d812c37ad17a06ccb9f024579ea06a9b3",
      "word_count": 9
    },
    {
      "text": "Customize the default indicator image only when it enhances the page control’s overall meaning",
      "section_path": [
        "Page controls",
        "Customizing indicators"
      ],
      "source_sentence_hash": "ea28b3f53d9379c0273573a46f0a32680303085337e53cf5a1188d41e6ffaf4c",
      "word_count": 14
    },
    {
      "text": "Avoid using more than two different indicator images in a page control",
      "section_path": [
        "Page controls",
        "Customizing indicators"
      ],
      "source_sentence_hash": "840dffb039682758f7dfdaeb86fe89701d1e6018d99be2edac5422fd65011bc1",
      "word_count": 12
    },
    {
      "text": "Avoid coloring indicator images",
      "section_path": [
        "Page controls",
        "Customizing indicators"
      ],
      "source_sentence_hash": "2d62b9656e6b93252d10347ef28a81900f25d0ab9f5a73e5abe1e3dd0f091001",
      "word_count": 4
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "Page controls",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "Avoid animating page transitions during scrubbing",
      "section_path": [
        "Page controls",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "84146d5d242361682191ff3aa22eddb0d1d085869df1fc7ac8a18cbd19bcbcfb",
      "word_count": 6
    },
    {
      "text": "Avoid supporting the scrubber when you use the minimal background style",
      "section_path": [
        "Page controls",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "8b526c8a6c9fc25e3d3aaaf88ed5bc26ae4b3b2e4ed4d527b664e44694c6b7c7",
      "word_count": 11
    },
    {
      "text": "Use page controls on collections of full-screen pages",
      "section_path": [
        "Page controls",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "296dffab6864318350a66bc4b879714a146b4c444102c5306ae5bcab5a05c279",
      "word_count": 8
    },
    {
      "text": "Use vertical pagination to separate multiple views into distinct, purposeful pages",
      "section_path": [
        "Page controls",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "86d1ee6bf063aa38902090649a895c3466cc0e749bf20a49c73f92ca99ee43d2",
      "word_count": 11
    },
    {
      "text": "Consider limiting the content of an individual page to a single screen height",
      "section_path": [
        "Page controls",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "fcaee8d3b8bd0e0fec09f439a0947621611cf3c78821cf619e49838323db6c42",
      "word_count": 13
    },
    {
