  "guidance_candidates": [
    {
      "text": "Make buttons easy for people to use",
      "section_path": [
        "Buttons",
        "Best practices"
      ],
      "source_sentence_hash": "ffb9387532afe104839eeed03030230c2ccc91eddd649ba3256d6abe92f11605",
      "word_count": 7
    },
    {
      "text": "Always include a press state for a custom button",
      "section_path": [
        "Buttons",
        "Best practices"
      ],
      "source_sentence_hash": "e3731ce15f96efe80aef3066be853f78603934c530165cbe655d08fa39ab8e2c",
      "word_count": 9
    },
    {
      "text": "In general, use a button that has a prominent visual style for the most likely action in a view",
      "section_path": [
        "Buttons",
        "Style"
      ],
      "source_sentence_hash": "32dce7ed037e5fd59000297a485b805ef9490573ce188813cbbe65dd39292af6",
      "word_count": 19
    },
    {
      "text": "Use style — not size — to visually distinguish the preferred choice among multiple options",
      "section_path": [
        "Buttons",
        "Style"
      ],
      "source_sentence_hash": "40fccc8eea5e8c1030899398e39fd382ba091ce51acd9db051b7fef941ff0847",
      "word_count": 15
    },
    {
      "text": "Avoid applying a similar color to button labels and content layer backgrounds",
      "section_path": [
        "Buttons",
        "Style"
      ],
      "source_sentence_hash": "ee7aa2b981cd8c54e37f7d46b5b9f4d055a5e7dd9333290ce7858cb4d7b1a3e1",
      "word_count": 12
    },
    {
      "text": "Ensure that each button clearly communicates its purpose",
      "section_path": [
        "Buttons",
        "Content"
      ],
      "source_sentence_hash": "82d3a592a19f080f7d9a98300bc1c29bbd8ff767a7c5e50974847510124ec1d9",
      "word_count": 8
    },
    {
      "text": "Try to associate familiar actions with familiar icons",
      "section_path": [
        "Buttons",
        "Content"
      ],
      "source_sentence_hash": "e4341c96d6b63bdaceee2be69335fbe46bad26ac7a62c60b3dd6dfa92e2a1781",
      "word_count": 8
    },
    {
      "text": "Consider using text when a short label communicates more clearly than an icon",
      "section_path": [
        "Buttons",
        "Content"
      ],
      "source_sentence_hash": "4e5b231d8f94e338f45d159d9ad6080c206e76049ac3749aa1efe7f6d7d3d6ad",
      "word_count": 13
    },
    {
      "text": "Assign the primary role to the button people are most likely to choose",
      "section_path": [
        "Buttons",
        "Role"
      ],
      "source_sentence_hash": "e84be916d04370a372e6bd020af444a5cf1ad035247806a01db12345451dfa4a",
      "word_count": 13
    },
    {
      "text": "Don’t assign the primary role to a button that performs a destructive action, even if that action is the",
      "section_path": [
        "Buttons",
        "Role"
      ],
      "source_sentence_hash": "7d77a0b0a1602ed1a68daabaadedb6dc75e13efd3bda188f2986af2a00777a61",
      "word_count": 19
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "Configure a button to display an activity indicator when you need to provide feedback about an action that doesn’t",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "8586b52f6cbf3340a46994936027c8b3b0c51692a66a1a1b19063c6da90dc34f",
      "word_count": 19
    },
    {
      "text": "Push buttons",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "macOS",
        "Push buttons"
      ],
      "source_sentence_hash": "860643da52311f8862dd57427a8587e9016b108b729ca83b0ca9df2045dadaf5",
      "word_count": 2
    },
    {
      "text": "Use a flexible-height push button only when you need to display tall or variable height content",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "macOS",
        "Push buttons"
      ],
      "source_sentence_hash": "813f53040826318df945db3674dc0754df856ff1a1a93548e978d7a708c34f9b",
      "word_count": 16
    },
    {
      "text": "Append a trailing ellipsis to the title when a push button opens another window, view, or app",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "macOS",
        "Push buttons"
      ],
      "source_sentence_hash": "558aafe4db6d4b8a498f6d54794c83c1cbb9e3d20de3bd4bf1ac99a9c6dc435b",
      "word_count": 17
    },
    {
      "text": "Consider supporting spring loading",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "macOS",
        "Push buttons"
      ],
      "source_sentence_hash": "b691d5abdf7dfb9bab0cfa6565f0e38dd1bed3947f1da3f13256f907c27a859b",
      "word_count": 4
    },
    {
      "text": "Square buttons",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "macOS",
        "Square buttons"
      ],
      "source_sentence_hash": "11302d1484f39644dbd81cd68902ff1b31223d5c3b9fd3ebc22c21f0c3fb4c9a",
      "word_count": 2
    },
    {
      "text": "Use square buttons in a view, not in the window frame",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "macOS",
        "Square buttons"
      ],
      "source_sentence_hash": "f3c5de7350e56842796c76f453132b76ad207b548d719bbdae0a866ed9a0e479",
      "word_count": 11
    },
    {
      "text": "Prefer using a symbol in a square button",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "macOS",
        "Square buttons"
      ],
      "source_sentence_hash": "a7f09751652b52cc1dbb9b85abdf405ff8ae0eb623a52388b5eae7515984608e",
      "word_count": 8
    },
    {
      "text": "Avoid using labels to introduce square buttons",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "macOS",
        "Square buttons"
      ],
      "source_sentence_hash": "1ba98bed7790a3098d187f55656cd8d1fbe0a6926bdf3fae9338768c61e7f6d3",
      "word_count": 7
    },
    {
      "text": "Help buttons",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "macOS",
        "Help buttons"
      ],
      "source_sentence_hash": "50c50bd9913b853fb515a9a31007d8344998042ff865b3dd78515215d650745c",
      "word_count": 2
    },
    {
      "text": "Use the system-provided help button to display your help documentation",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "macOS",
        "Help buttons"
      ],
      "source_sentence_hash": "9c1773fad01976e83ca04d65d36ef866b41c861c603b5b43bb2768c4ce201842",
      "word_count": 10
    },
    {
      "text": "When possible, open the help topic that’s related to the current context",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "macOS",
        "Help buttons"
      ],
      "source_sentence_hash": "f126352e288bd4cc17f317aec7e7972d4da0530dca99b3393b299278b7161a5a",
      "word_count": 12
    },
    {
      "text": "Include no more than one help button per window",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "macOS",
        "Help buttons"
      ],
      "source_sentence_hash": "c554706799a97bd9e51589dcb8dcd50b4acab9beb44302e3fe8446d151008916",
      "word_count": 9
    },
    {
      "text": "Position help buttons where people expect to find them",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "macOS",
        "Help buttons"
      ],
      "source_sentence_hash": "d6d2992e38a003fe644153bb4e26f46401dfddb83be5a3ad8a08ebc6786ef882",
      "word_count": 9
    },
    {
      "text": "Use a help button within a view, not in the window frame",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "macOS",
        "Help buttons"
      ],
      "source_sentence_hash": "737898b4884bf5efab8aa71a3cdd4c09806d65edfdbe1bf3623fb951f12c86da",
      "word_count": 12
    },
    {
      "text": "Avoid displaying text that introduces a help button",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "macOS",
        "Help buttons"
      ],
      "source_sentence_hash": "6bb483989efd3723f1f954d401c00da40700e1198e50e1e179157b8806f03ccd",
      "word_count": 8
    },
    {
      "text": "Image buttons",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "macOS",
        "Image buttons"
      ],
      "source_sentence_hash": "5a74b68cb323e3bdbcca5eb18d71fe45e5369ec2842f8754ba0fc8183aa5571c",
      "word_count": 2
    },
    {
      "text": "Use an image button in a view, not in the window frame",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "macOS",
        "Image buttons"
      ],
      "source_sentence_hash": "be829c99ca5c64107c330386b620e5c5c443ebe18d61043266fdbcc6e7cab63b",
      "word_count": 12
    },
    {
      "text": "Include about 10 pixels of padding between the edges of the image and the button edges",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "macOS",
        "Image buttons"
      ],
      "source_sentence_hash": "eefa413fee8d67b029395515e8647e3f5387de1764ddc045b14de5229a9ebc3e",
      "word_count": 16
    },
    {
      "text": "If you need to include a label, position it below the image button",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "macOS",
        "Image buttons"
      ],
      "source_sentence_hash": "38951385705851945fb375e94a8d3202047cec7c6d7e72b6b3cc5467b4a2b167",
      "word_count": 13
    },
    {
      "text": "Prefer buttons that have a discernible background shape and fill",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "ea3492354cb6b0d20d7f9ac994c036d57a75828ed6340ea89087d26c052fafa5",
      "word_count": 10
    },
    {
      "text": "Avoid creating a custom button that uses a white background fill and black text or icons",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "d66dfdbb71fbab9614fac186ab20b9f5355fc42c70551340b8994fd4eff4fdd1",
      "word_count": 16
    },
    {
      "text": "In general, prefer circular or capsule-shape buttons",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "170546e6732d5391d4d5024eba057b5477ac8e895201d2c3b211ef24752cfdc3",
      "word_count": 7
    },
    {
      "text": "Provide enough space around a button to make it easy for people to look at it",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "b4508ffcdfd16b2a921ae9b40720aff63e7e9f54b9e85ebdfb8ed5e336e5f865",
      "word_count": 16
    },
    {
      "text": "Choose the right shape if you need to display text-labeled buttons in a stack or row",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "e3228cc3012a45901b462cc0e13e70d62574ce1b2e5af6645eb79a110bdc4804",
      "word_count": 16
    },
    {
      "text": "Use standard controls to take advantage of the audible feedback sounds people already know",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "c4ef83336be27164e118bf512a227b10352885fc66474272ce0ddba0daed5fc6",
      "word_count": 14
    },
    {
      "text": "Use a toolbar to place buttons in the corners",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "366a659d2bf41e290e76e69bb9dd56bc3a1460fe01c5e2dbd7277334662caf63",
      "word_count": 9
    },
    {
      "text": "Prefer buttons that span the width of the screen for primary actions in your app",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "758cc1382af4ecb60231f6660f8f8497fdfcdbb8d5861fd413085a2f9aa31622",
      "word_count": 15
    },
    {
      "text": "Use toolbar buttons to provide either navigation to related areas or contextual actions for the view’s content",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "b2c5c1c7eee13433eb69d4d9dba8d54d508f3b94858013c23736819c3598d0c4",
      "word_count": 17
    },
    {
      "text": "Use the same height for vertical stacks of one- and two-line text buttons",
      "section_path": [
        "Buttons",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "c600d3c8996da21aabbbcc0de3849ba900fc83eb860c0385bfb46214870495a1",
      "word_count": 13
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Buttons",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
