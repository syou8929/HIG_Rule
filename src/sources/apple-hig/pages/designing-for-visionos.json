  "guidance_candidates": [
    {
      "text": "Prioritize user safety when designing for Apple Vision Pro",
      "section_path": [
        "Designing for visionOS"
      ],
      "source_sentence_hash": "9f429bce7136ca876b15956b94581d993218776e7b8804ecc34a99d9970cd3cd",
      "word_count": 9
    },
    {
      "text": "Avoid using Apple Vision Pro while operating vehicles or heavy machinery",
      "section_path": [
        "Designing for visionOS"
      ],
      "source_sentence_hash": "9f429bce7136ca876b15956b94581d993218776e7b8804ecc34a99d9970cd3cd",
      "word_count": 11
    },
    {
      "text": "Avoid using Apple Vision Pro while moving through unsafe environments",
      "section_path": [
        "Designing for visionOS"
      ],
      "source_sentence_hash": "9f429bce7136ca876b15956b94581d993218776e7b8804ecc34a99d9970cd3cd",
      "word_count": 10
    },
    {
      "text": "Use Apple Vision Pro only for people aged 13 or older",
      "section_path": [
        "Designing for visionOS"
      ],
      "source_sentence_hash": "9f429bce7136ca876b15956b94581d993218776e7b8804ecc34a99d9970cd3cd",
      "word_count": 11
    },
    {
      "text": "Spatial Audio",
      "section_path": [
        "Designing for visionOS"
      ],
      "source_sentence_hash": "4c7bba31d67224da30ea455265a006de5b930aa3f8ee46c0991846813b793925",
      "word_count": 2
    },
    {
      "text": "Eyes and hands",
      "section_path": [
        "Designing for visionOS"
      ],
      "source_sentence_hash": "1db3afecd2b2c2c361e025038b4e8fd3ff2537b7f7df919589c07b37da7835ed",
      "word_count": 3
    },
    {
      "text": "Use Apple Vision Pro’s unique spatial features",
      "section_path": [
        "Designing for visionOS",
        "Best practices"
      ],
      "source_sentence_hash": "87c4c5bc2de456bbb8682db44088479b8c8a3ed77ed5585b1141d13fad258d6f",
      "word_count": 7
    },
    {
      "text": "Consider different types of immersion as you design ways to present your app’s most distinctive moments",
      "section_path": [
        "Designing for visionOS",
        "Best practices"
      ],
      "source_sentence_hash": "446af20d2269091fa370d288536e6285ad28f681a9847b720d7fee3086127997",
      "word_count": 16
    },
    {
      "text": "Use windows for contained, UI-centric experiences",
      "section_path": [
        "Designing for visionOS",
        "Best practices"
      ],
      "source_sentence_hash": "553388b1012db6c55ff474cdb8c14930796d8a8a1acdfd3568e649666dbc65bb",
      "word_count": 6
    },
    {
      "text": "Prioritize comfort",
      "section_path": [
        "Designing for visionOS",
        "Best practices"
      ],
      "source_sentence_hash": "4e01b6389808861da60d686727eec0eb5e6f64eb4914543041152a6f8f404745",
      "word_count": 2
    },
    {
      "text": "Display content within a person’s field of view, positioning it relative to their head. Avoid placing content in places",
      "section_path": [
        "Designing for visionOS",
        "Best practices"
      ],
      "source_sentence_hash": "77b06d42a4381de64fd3c3b3c9a5f6dff48568828590bd483a4ba49f7fe454a5",
      "word_count": 19
    },
    {
      "text": "Avoid requiring head turns or position changes for interaction",
      "section_path": [
        "Designing for visionOS",
        "Best practices"
      ],
      "source_sentence_hash": "77b06d42a4381de64fd3c3b3c9a5f6dff48568828590bd483a4ba49f7fe454a5",
      "word_count": 9
    },
    {
      "text": "Avoid displaying motion that’s overwhelming, jarring, too fast, or missing a stationary frame of reference",
      "section_path": [
        "Designing for visionOS",
        "Best practices"
      ],
      "source_sentence_hash": "1e00a9955e191c3e51459f0b79c2a0734b820161e22754dd36c4bbd34b6e7dc2",
      "word_count": 15
    },
    {
      "text": "Support indirect gestures that let people interact with apps while their hands rest in their lap or at their",
      "section_path": [
        "Designing for visionOS",
        "Best practices"
      ],
      "source_sentence_hash": "678ce55b39559db130acd857b27b7a07984e32fa4c081c0e8238933a1673e22f",
      "word_count": 19
    },
    {
      "text": "If you support direct gestures, make sure the interactive content isn’t too far away and that people don’t need",
      "section_path": [
        "Designing for visionOS",
        "Best practices"
      ],
      "source_sentence_hash": "1dbd8f5031b514c2cd4299a59f706097f9d77a1db044f4faa75eee6128d4b125",
      "word_count": 19
    },
    {
      "text": "Make sure direct-gesture content is nearby and interactions are not extended",
      "section_path": [
        "Designing for visionOS",
        "Best practices"
      ],
      "source_sentence_hash": "1dbd8f5031b514c2cd4299a59f706097f9d77a1db044f4faa75eee6128d4b125",
      "word_count": 10
    },
    {
      "text": "Avoid encouraging people to move too much while they’re in a fully immersive experience",
      "section_path": [
        "Designing for visionOS",
        "Best practices"
      ],
      "source_sentence_hash": "efccc1d4d2e685468d730c4b97b79194a3b79fe2a69115b2ee70a85cc8718989",
      "word_count": 14
    },
    {
      "text": "Help people share activities with others",
      "section_path": [
        "Designing for visionOS",
        "Best practices"
      ],
      "source_sentence_hash": "67ad6f62155b892c02b8465fdc9febf867465f7fb574f212e3f136efcc57d0eb",
      "word_count": 6
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Designing for visionOS",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
