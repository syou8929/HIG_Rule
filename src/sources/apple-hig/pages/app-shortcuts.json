  "guidance_candidates": [
    {
      "text": "To surface common types of app functionality throughout the system, consider adopting app schemas instead",
      "section_path": [
        "App Shortcuts",
        "Best practices"
      ],
      "source_sentence_hash": "5ac535b3a194fb900d787e36ddfd90fadc61be21216b56cfec5cfee2911c0ae1",
      "word_count": 15
    },
    {
      "text": "Offer App Shortcuts for your app’s most common and important tasks",
      "section_path": [
        "App Shortcuts",
        "Best practices"
      ],
      "source_sentence_hash": "1f43c4c1bfcdd60f568987d2b1d314fb27481b0d3b104a75fc35fca6d9737939",
      "word_count": 11
    },
    {
      "text": "Add flexibility by letting people choose from a set of options",
      "section_path": [
        "App Shortcuts",
        "Best practices"
      ],
      "source_sentence_hash": "a3650956330a6db6c1a076f631d680b2eeefd69a36ffffea05f3a43ce87ea096",
      "word_count": 11
    },
    {
      "text": "Ask for clarification in response to a request that’s missing optional information",
      "section_path": [
        "App Shortcuts",
        "Best practices"
      ],
      "source_sentence_hash": "48aa27931d9e4db8671621a0ec40379d3399917ad75b0e6fc066b27de4d2bd2e",
      "word_count": 12
    },
    {
      "text": "Keep voice interactions simple",
      "section_path": [
        "App Shortcuts",
        "Best practices"
      ],
      "source_sentence_hash": "869810cdf9677bbed223f1bb2d673df16d3a545cad992a41705cb546b6bea43b",
      "word_count": 4
    },
    {
      "text": "Make App Shortcuts discoverable in your app",
      "section_path": [
        "App Shortcuts",
        "Best practices"
      ],
      "source_sentence_hash": "a7cfc1415cb8159c20f14b1576d646af7e99285ccb2aefbe14a8cd537936e4da",
      "word_count": 7
    },
    {
      "text": "Responding to App Shortcuts",
      "section_path": [
        "App Shortcuts",
        "Best practices",
        "Responding to App Shortcuts"
      ],
      "source_sentence_hash": "04443bf1a8883015c40617b200e3f7fe2f2f3a397bb470bd66189552f6206912",
      "word_count": 4
    },
    {
      "text": "Snippets are great for custom views that display static information or dialog options, like showing the weather at a",
      "section_path": [
        "App Shortcuts",
        "Best practices",
        "Responding to App Shortcuts"
      ],
      "source_sentence_hash": "2afdc08a4eade13bed0713c67c0e99e7f90ed9079cabd74451fd54677613aea0",
      "word_count": 19
    },
    {
      "text": "Live Activities offer continuous access to information that’s likely to remain relevant and change over a period of time,",
      "section_path": [
        "App Shortcuts",
        "Best practices",
        "Responding to App Shortcuts"
      ],
      "source_sentence_hash": "e2abe96b44e75ef755d78654f8f282548341ae142a9f7f2bc954bb2d49669919",
      "word_count": 19
    },
    {
      "text": "Provide enough detail for interaction on audio-only devices",
      "section_path": [
        "App Shortcuts",
        "Best practices",
        "Responding to App Shortcuts"
      ],
      "source_sentence_hash": "fa424efc5e18633751aa35ac2be408001192514dff3e884eadd86973ca9aff6b",
      "word_count": 8
    },
    {
      "text": "Provide brief, memorable activation phrases and natural variants",
      "section_path": [
        "App Shortcuts",
        "Editorial guidelines"
      ],
      "source_sentence_hash": "0d467a6e545fb244de35315cbd228c646d4f69afa75a9c9d75cf2f221042f47d",
      "word_count": 8
    },
    {
      "text": "When referring to App Shortcuts or the Shortcuts app, always use title case and make sure that Shortcuts is",
      "section_path": [
        "App Shortcuts",
        "Editorial guidelines"
      ],
      "source_sentence_hash": "20246bef18e094b9375421e674c1e3c1959815b40b087bc2cafc3745aa4c9148",
      "word_count": 19
    },
    {
      "text": "When referring to individual shortcuts (not App Shortcuts or the Shortcuts app), use lowercase",
      "section_path": [
        "App Shortcuts",
        "Editorial guidelines"
      ],
      "source_sentence_hash": "9200331ca2cf566a80042ad2782596a954a30cdbc0cecf2765cefb154cbcba60",
      "word_count": 14
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "App Shortcuts",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "Order shortcuts based on importance",
      "section_path": [
        "App Shortcuts",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "b366f46c7022136325f9d213912b0fa6d395fd3a6f8947b4fa034031dc007a14",
      "word_count": 5
    },
    {
      "text": "Each App Shortcut includes one or more actions",
      "section_path": [
        "App Shortcuts"
      ],
      "source_sentence_hash": "c97410ea4151d2ef991b078e87cb8892b7587eff04dfc0cb7e93f4fcfdb9241c",
      "word_count": 8
    },
    {
      "text": "Each app can include up to 10 App Shortcuts",
      "section_path": [
        "App Shortcuts"
      ],
      "source_sentence_hash": "c97410ea4151d2ef991b078e87cb8892b7587eff04dfc0cb7e93f4fcfdb9241c",
      "word_count": 9
    },
    {
      "text": "An App Shortcut can include a single optional value, or parameter",
      "section_path": [
        "App Shortcuts",
        "Best practices"
      ],
      "source_sentence_hash": "6db5529294ba1037f55c6482835941da4e224cdd99c8e74763820427800270c2",
      "word_count": 11
    },
    {
      "text": "Include all critical information in the full dialogue text of your App Shortcuts",
      "section_path": [
        "App Shortcuts",
        "Best practices",
        "Responding to App Shortcuts"
      ],
      "source_sentence_hash": "0f47482d75ecae5119f1e4386b118ca73e060e134f93806ec41e733e446f55ae",
      "word_count": 12
    },
    {
      "text": "You have to include your app name",
      "section_path": [
        "App Shortcuts",
        "Editorial guidelines"
      ],
      "source_sentence_hash": "fbd24d9de9a7f6413d157ba645f56a33d77331ffc4822f2539a61731f4a278ac",
      "word_count": 7
    },
    {
      "text": "Always use title case",
      "section_path": [
        "App Shortcuts",
        "Editorial guidelines"
      ],
      "source_sentence_hash": "81d8a69aff47960e5b48b9478e4cd66339e92a6e9a27653830edc5eaf0497187",
      "word_count": 4
    },
    {
      "text": "Make sure that Shortcuts is plural",
      "section_path": [
        "App Shortcuts",
        "Editorial guidelines"
      ],
      "source_sentence_hash": "81d8a69aff47960e5b48b9478e4cd66339e92a6e9a27653830edc5eaf0497187",
      "word_count": 6
    },
    {
      "text": "Each App Shortcut includes a symbol from SF Symbols or a preview image",
      "section_path": [
        "App Shortcuts",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "bb2b50c25c0f419bd4b953dec91a1df0351d03d8760a163658b0db3acc67f20a",
      "word_count": 13
    },
    {
      "text": "Developer documentation",
