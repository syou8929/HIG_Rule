  "guidance_candidates": [
    {
      "text": "Let people know that you support SharePlay",
      "section_path": [
        "SharePlay",
        "Best practices"
      ],
      "source_sentence_hash": "70e763a703b8d2c71f4ef06413efa579199a4f0570123149bdb564c452862bea",
      "word_count": 7
    },
    {
      "text": "If part of your app requires a subscription, consider ways to help nonsubscriber participants quickly join a group activity",
      "section_path": [
        "SharePlay",
        "Best practices"
      ],
      "source_sentence_hash": "90fef30c03ae04b14b8fd5e978bce386e24dfc39667b43a58a1a713b522699f4",
      "word_count": 19
    },
    {
      "text": "Support Picture in Picture (PiP) when possible",
      "section_path": [
        "SharePlay",
        "Best practices"
      ],
      "source_sentence_hash": "c6aa3cd774bc832459a58976e7225a9c0a6aefaf11a7790c04eeb8cdc44023e3",
      "word_count": 7
    },
    {
      "text": "Use the term SharePlay correctly",
      "section_path": [
        "SharePlay",
        "Best practices"
      ],
      "source_sentence_hash": "36a73abe62276682bb7658f235588692c92bd1b5245773a84456bed6833c1b6d",
      "word_count": 5
    },
    {
      "text": "Briefly describe each activity",
      "section_path": [
        "SharePlay",
        "Sharing activities"
      ],
      "source_sentence_hash": "60911db7ecd17c8dd83a7a8e74d33e29b1a3540ec39853dfddeb35e8fa4bac14",
      "word_count": 4
    },
    {
      "text": "Make it easy to start sharing an activity",
      "section_path": [
        "SharePlay",
        "Sharing activities"
      ],
      "source_sentence_hash": "10b0856007b41e68ddccd0e95d36bfafb1bfbe2a501a522213d8dd629954496d",
      "word_count": 8
    },
    {
      "text": "Help people prepare to join a session before displaying the activity",
      "section_path": [
        "SharePlay",
        "Sharing activities"
      ],
      "source_sentence_hash": "afd44f184f3407d7fb773b43eda37071d462500365b792fbbc828e55f13ad046",
      "word_count": 11
    },
    {
      "text": "When possible, defer app tasks that might delay a shared activity",
      "section_path": [
        "SharePlay",
        "Sharing activities"
      ],
      "source_sentence_hash": "b3c97b626f0f993f15d013b52c9abacdf496dadd0a906f172a4a30f1b0b98cea",
      "word_count": 11
    },
    {
      "text": "Choose the spatial Persona template that suits your shared activity",
      "section_path": [
        "SharePlay",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "3077440efd0cd65b34ee85777cbea3bcfbb7ee33eba18be4fac8aae2066f7973",
      "word_count": 10
    },
    {
      "text": "Be prepared to launch directly into your shared activity",
      "section_path": [
        "SharePlay",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "b4ccdc026114f13d18017924ec1632fb653bf0305469e8acd4a5038dc1567691",
      "word_count": 9
    },
    {
      "text": "Help people enter a shared activity together, but don’t force them",
      "section_path": [
        "SharePlay",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "6b8a20cdf6915f9f257184c574bcc6d2f6ae51a7a3ca598f4fdce6b2f6dae2c6",
      "word_count": 11
    },
    {
      "text": "Smoothly update a shared activity when new participants join",
      "section_path": [
        "SharePlay",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "f10d26826ac9e597e8918cbbb86d101d286773ac74734ff627f4b3c6a0799073",
      "word_count": 9
    },
    {
      "text": "Maintaining a shared context",
      "section_path": [
        "SharePlay",
        "Platform considerations",
        "visionOS",
        "Maintaining a shared context"
      ],
      "source_sentence_hash": "d05e72bcaeb9bd4216a565e873496d8e44817dffd71fdbe4a68c2dd16b5d2ad3",
      "word_count": 4
    },
    {
      "text": "Make sure everyone views the same state of your app",
      "section_path": [
        "SharePlay",
        "Platform considerations",
        "visionOS",
        "Maintaining a shared context"
      ],
      "source_sentence_hash": "f360226f62851ea15d15d9e89864bf34817617d90c9d4dc6fa96465375c57d22",
      "word_count": 10
    },
    {
      "text": "Use Spatial Audio to enrich your shared activity",
      "section_path": [
        "SharePlay",
        "Platform considerations",
        "visionOS",
        "Maintaining a shared context"
      ],
      "source_sentence_hash": "14a3c0fc097a824dfd7a906e54e691f8b9ed3f53d3bd4bf6ee259f13c7880fc1",
      "word_count": 8
    },
    {
      "text": "When possible, let people discover natural, social solutions to confusions or conflicts that might arise during a shared experience",
      "section_path": [
        "SharePlay",
        "Platform considerations",
        "visionOS",
        "Maintaining a shared context"
      ],
      "source_sentence_hash": "cb7f3e1158ce63e45395cc61989a2bb8abd4481cc672f657ecc4779697fa3781",
      "word_count": 19
    },
    {
      "text": "Help people keep their private and shared content separate",
      "section_path": [
        "SharePlay",
        "Platform considerations",
        "visionOS",
        "Maintaining a shared context"
      ],
      "source_sentence_hash": "6762163b802c07b274bfce835a5a5848f856187bbd900847c4fc98069ee5ba06",
      "word_count": 9
    },
    {
      "text": "Adjusting a shared context",
      "section_path": [
        "SharePlay",
        "Platform considerations",
        "visionOS",
        "Adjusting a shared context"
      ],
      "source_sentence_hash": "addd3b5ae78326649ae2e8c3173d5bb942319b5ae55f96e412f31a9f9324b368",
      "word_count": 4
    },
    {
      "text": "Let people personalize their experience without changing the experience for others",
      "section_path": [
        "SharePlay",
        "Platform considerations",
        "visionOS",
        "Adjusting a shared context"
      ],
      "source_sentence_hash": "7d2b361f52c78e09a83edf3142e9694faca41457a46729215995d38860b0b3bc",
      "word_count": 11
    },
    {
      "text": "Consider when to give each participant a unique view of the shared content",
      "section_path": [
        "SharePlay",
        "Platform considerations",
        "visionOS",
        "Adjusting a shared context"
      ],
      "source_sentence_hash": "d25bb308b77dfeb7797729f2329604e6f2f9eabab1ae7161dfae2f3352d982b3",
      "word_count": 13
    },
    {
      "text": "Make it easy for people to exit and rejoin a shared activity",
      "section_path": [
        "SharePlay",
        "Platform considerations",
        "visionOS",
        "Adjusting a shared context"
      ],
      "source_sentence_hash": "bef15636233ecb2ba3ea676e9267d8ff68c58a5ada4e135a0ca54e653274dbbf",
      "word_count": 12
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "SharePlay",
        "Resources",
        "Developer documentation"
      ],
