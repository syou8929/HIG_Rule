  "guidance_candidates": [
    {
      "text": "Use an image view when the primary purpose of the view is simply to display an image",
      "section_path": [
        "Image views",
        "Best practices"
      ],
      "source_sentence_hash": "cc4b690c75734af5c8f9e8f69615a304be3e0f3f9ec4b006b29c3c64eba8846b",
      "word_count": 17
    },
    {
      "text": "Consider a symbol or interface icon instead of an image view for interface icons",
      "section_path": [
        "Image views",
        "Best practices"
      ],
      "source_sentence_hash": "034ef2e09cffa66ed9b1d98ba32d7a0daa53e3d56b36fae963b039c466d8c6ce",
      "word_count": 14
    },
    {
      "text": "Use a system-provided button instead of adding button behavior to an interactive image view",
      "section_path": [
        "Image views",
        "Best practices"
      ],
      "source_sentence_hash": "3e1ac70e76a708391b190c0377bdd183bbf46386c2613a613bc45aec09eb6d82",
      "word_count": 14
    },
    {
      "text": "Use care when overlaying text on images",
      "section_path": [
        "Image views",
        "Content"
      ],
      "source_sentence_hash": "feb2ea484e0eecfb2a635808adcfcb87987d15177d1d8cabf3d06088dbbad0d1",
      "word_count": 7
    },
    {
      "text": "Ensure overlaid text contrasts well with the image",
      "section_path": [
        "Image views",
        "Content"
      ],
      "source_sentence_hash": "1a874597d2091d04f8b4a195da37ff9769c078cda80dc3e4059affedd1b05a51",
      "word_count": 8
    },
    {
      "text": "Consider a shadow or background layer to make overlaid text stand out",
      "section_path": [
        "Image views",
        "Content"
      ],
      "source_sentence_hash": "1a874597d2091d04f8b4a195da37ff9769c078cda80dc3e4059affedd1b05a51",
      "word_count": 12
    },
    {
      "text": "Aim to use a consistent size for all images in an animated sequence",
      "section_path": [
        "Image views",
        "Content"
      ],
      "source_sentence_hash": "cc9703fe35552286b01eefb914552a0f03ee9309c40836a640118f30f4b426a3",
      "word_count": 13
    },
    {
      "text": "If your app needs an editable image view, use an image well",
      "section_path": [
        "Image views",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "b54c949da69f16836209da26c2a997f450df082208e7ce7175a1106511c9657e",
      "word_count": 12
    },
    {
      "text": "Use an image button instead of an image view to make a clickable image",
      "section_path": [
        "Image views",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "c5df7af17475394d9eb36d73c121ff869407551439b344accad851756c6c6066",
      "word_count": 14
    },
    {
      "text": "Use SwiftUI to create animations when possible",
      "section_path": [
        "Image views",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "6759873f02f6f69795df9bc3aca73cf1e989cd8ca16b5e17a6e94a6a63d0a48b",
      "word_count": 7
    },
    {
      "text": "Consider WatchKit image-sequence animation when necessary",
      "section_path": [
        "Image views",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "cef853c7645998858358fea88a273f28a93c6b5033380eba6bdc29c1ecb8f672",
      "word_count": 6
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Image views",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
