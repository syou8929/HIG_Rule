  "guidance_candidates": [
    {
      "text": "The system-defined touch or pinch and hold gesture in visionOS, iOS, and iPadOS",
      "section_path": [
        "Context menus"
      ],
      "source_sentence_hash": "3f2ff7f791ac0724ec27a156b9c9dd33749965c6858e88323ff8d3726521bb69",
      "word_count": 13
    },
    {
      "text": "Pressing the Control key while clicking a pointing device in macOS and iPadOS",
      "section_path": [
        "Context menus"
      ],
      "source_sentence_hash": "3f31ca8742f9f3ce970d629a6dbb68088823de68ff242fae86d367ec61b1f83e",
      "word_count": 13
    },
    {
      "text": "Using a secondary click on a Magic Trackpad in macOS or iPadOS",
      "section_path": [
        "Context menus"
      ],
      "source_sentence_hash": "9d8a9a8246448f628f17f8f2cdf581a087e17983c359e7a56fc0391a7c4baf9d",
      "word_count": 12
    },
    {
      "text": "Prioritize relevancy when choosing items to include in a context menu",
      "section_path": [
        "Context menus",
        "Best practices"
      ],
      "source_sentence_hash": "afb5c9374d79d4c2b74aa4a2211e328cd9cb04b239fc34294db28dc9d529e5e1",
      "word_count": 11
    },
    {
      "text": "Aim for a small number of menu items",
      "section_path": [
        "Context menus",
        "Best practices"
      ],
      "source_sentence_hash": "8f9bb0b2fcec09566d81736bd390617c5bc42afa8cfeee11519288a8a2708db0",
      "word_count": 8
    },
    {
      "text": "Support context menus consistently throughout your app",
      "section_path": [
        "Context menus",
        "Best practices"
      ],
      "source_sentence_hash": "e40bdf28dc3df8bb94c93b9df3738d5edea1eb856814abf3cc08da602b1aba89",
      "word_count": 7
    },
    {
      "text": "Always make context menu items available in the main interface, too",
      "section_path": [
        "Context menus",
        "Best practices"
      ],
      "source_sentence_hash": "c4a9ead7f319e78f6c80ae18bcfe8bab53a0ca0f7c420d5c8a619f6fa6a2a59d",
      "word_count": 11
    },
    {
      "text": "If you need to use submenus to manage a menu’s complexity, keep them to one level",
      "section_path": [
        "Context menus",
        "Best practices"
      ],
      "source_sentence_hash": "843f74a0f58d976e9aada8fa2e45885115d759d904f87630f19234e966c9673e",
      "word_count": 16
    },
    {
      "text": "Hide unavailable menu items, don’t dim them",
      "section_path": [
        "Context menus",
        "Best practices"
      ],
      "source_sentence_hash": "635e67896ac6773bcb6c5e77bc255236af811bdebbc913faa91ab2378d899c9c",
      "word_count": 7
    },
    {
      "text": "Aim to place the most frequently used menu items where people are likely to encounter them first",
      "section_path": [
        "Context menus",
        "Best practices"
      ],
      "source_sentence_hash": "951f4963dd591c5824d79fbac5046666e3ca2bcd153cff2acb08f6a93dc59c3e",
      "word_count": 17
    },
    {
      "text": "Show keyboard shortcuts in your app’s main menus, not in context menus",
      "section_path": [
        "Context menus",
        "Best practices"
      ],
      "source_sentence_hash": "41b00588d71146101a3306654db84beb118443cd640e3bbea51a6cc8836c91f3",
      "word_count": 12
    },
    {
      "text": "Follow best practices for using separators",
      "section_path": [
        "Context menus",
        "Best practices"
      ],
      "source_sentence_hash": "894c9c9f1e0377975cc9fa2e413a42b9157f4b5849501455d348a7298563f45d",
      "word_count": 6
    },
    {
      "text": "In iOS, iPadOS, and visionOS, warn people about context menu items that can destroy data",
      "section_path": [
        "Context menus",
        "Best practices"
      ],
      "source_sentence_hash": "3e2c67dea460f7fc25cbe97cd7aa4f4d3f820a6c679032c44ab1b9663919c857",
      "word_count": 15
    },
    {
      "text": "Include a title in a context menu only if doing so clarifies the menu’s effect",
      "section_path": [
        "Context menus",
        "Content"
      ],
      "source_sentence_hash": "89d44d99c25a897d6670a08a1c8f98d225327f99b2fadd4991feafd462b0ab1c",
      "word_count": 15
    },
    {
      "text": "Represent menu item actions with familiar icons",
      "section_path": [
        "Context menus",
        "Content"
      ],
      "source_sentence_hash": "a5de0d14dbfbe14814f53341694d8542e16587c9a864a1a725949cbb750e1d11",
      "word_count": 7
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "Context menus",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "Provide either a context menu or an edit menu for an item, but not both",
      "section_path": [
        "Context menus",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "4845f8c3d33a172d47495d34bf1d8b98acd5edf7584e8250b101054b39d6135c",
      "word_count": 15
    },
    {
      "text": "In iPadOS, consider using a context menu to let people create a new object in your app",
      "section_path": [
        "Context menus",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "3dfb4bd1c010a06434860d389dd446cf611556b33479ca75dfd0f74f1c89528e",
      "word_count": 17
    },
    {
      "text": "Prefer a graphical preview that clarifies the target of a context menu’s commands",
      "section_path": [
        "Context menus",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "2155a1308f89a36a878509eefbd277923dfc38f3ed6b11248d89f3767821b42c",
      "word_count": 13
    },
    {
      "text": "Ensure that your preview looks good as it animates",
      "section_path": [
        "Context menus",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "c3b5a68babaf01efaf616f071fde5b2281a2d3471f64d7e84240dd6218fe0a8c",
      "word_count": 9
    },
    {
      "text": "Consider using a context menu instead of a panel or inspector window to present frequently used functionality",
      "section_path": [
        "Context menus",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "668691ddef8431b5b05fc7bf9f6bb4a2b90289f61260e94d5f1f9d17a4feaa3e",
      "word_count": 17
    },
    {
      "text": "In general, avoid letting a context menu’s height exceed the height of the window",
      "section_path": [
        "Context menus",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "a10a7682904c20dfa8aa82b5ff31bc85ec3f398c050d1b188fd7bf1f9b213429",
      "word_count": 14
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Context menus",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
