  "guidance_candidates": [
    {
      "text": "Create a recognizable, highly simplified design",
      "section_path": [
        "Icons",
        "Best practices"
      ],
      "source_sentence_hash": "66dd2b87ccbcc74a8523f7765333030ef2c05ea021bcb39122d7c8f3e89e247c",
      "word_count": 6
    },
    {
      "text": "Maintain visual consistency across all interface icons in your app",
      "section_path": [
        "Icons",
        "Best practices"
      ],
      "source_sentence_hash": "23e3ff1d26e45173fe8a3f94c9f31fa6bedcdd9ea6a98c32710ffc5a222137b5",
      "word_count": 10
    },
    {
      "text": "In general, match the weights of interface icons and adjacent text",
      "section_path": [
        "Icons",
        "Best practices"
      ],
      "source_sentence_hash": "dd074f596a9d52042f176b155719c041789ef78073237f0c718e31ec6d341739",
      "word_count": 11
    },
    {
      "text": "If necessary, add padding to a custom interface icon to achieve optical alignment",
      "section_path": [
        "Icons",
        "Best practices"
      ],
      "source_sentence_hash": "ab45ba4555d3c9ad641d0888f47c0c85f51d2cf74f105a847ca6ac6f13bc7596",
      "word_count": 13
    },
    {
      "text": "Provide a selected-state version of an interface icon only if necessary",
      "section_path": [
        "Icons",
        "Best practices"
      ],
      "source_sentence_hash": "71d0408d31cc800e68632b4d5a1d8a3f405c801287a45cb24565ce4c79d87e8c",
      "word_count": 11
    },
    {
      "text": "Use inclusive images",
      "section_path": [
        "Icons",
        "Best practices"
      ],
      "source_sentence_hash": "e0a8ec1666eece439c19ce9d813b43c57e1198bec135770736b47cd72d2032b6",
      "word_count": 3
    },
    {
      "text": "Include text in your design only when it’s essential for conveying meaning",
      "section_path": [
        "Icons",
        "Best practices"
      ],
      "source_sentence_hash": "b240a17c321d35cb37ce22b90abdb692c29291d0de94bdb66611a2818926674c",
      "word_count": 12
    },
    {
      "text": "If you create a custom interface icon, use a vector format like PDF or SVG",
      "section_path": [
        "Icons",
        "Best practices"
      ],
      "source_sentence_hash": "4ffe03d6bc849237a98520395cf9f6b96352e71a649887544bafbf7fbabb3521",
      "word_count": 15
    },
    {
      "text": "Provide alternative text labels for custom interface icons",
      "section_path": [
        "Icons",
        "Best practices"
      ],
      "source_sentence_hash": "012b232d195fc0809154a41d414b720d17a0c958eb697950f441b4aaddf42681",
      "word_count": 8
    },
    {
      "text": "Avoid using replicas of Apple hardware products",
      "section_path": [
        "Icons",
        "Best practices"
      ],
      "source_sentence_hash": "e049e29c3c135bcbab3f9a830f75e5dcb9580a966ee9cf406db8c1d40b073cc0",
      "word_count": 7
    },
    {
      "text": "Text formatting",
      "section_path": [
        "Icons",
        "Standard icons",
        "Text formatting"
      ],
      "source_sentence_hash": "c85a8d1cf19c80ce7f5c97b5730dcd3f1dfd10c38c450f78e4931ca2f85c43bb",
      "word_count": 2
    },
    {
      "text": "Sharing and exporting",
      "section_path": [
        "Icons",
        "Standard icons",
        "Sharing and exporting"
      ],
      "source_sentence_hash": "fca642b48739981247af3e69919e7a7402310d97abde150cd742bf44acc6dcc8",
      "word_count": 3
    },
    {
      "text": "Users and accounts",
      "section_path": [
        "Icons",
        "Standard icons",
        "Users and accounts"
      ],
      "source_sentence_hash": "3040585f00bf148844f20c5d6647ff68e355e710da000f82b2eccbf718b2b8a1",
      "word_count": 3
    },
    {
      "text": "Layer ordering",
      "section_path": [
        "Icons",
        "Standard icons",
        "Layer ordering"
      ],
      "source_sentence_hash": "39ad7602ebba3797b74d5e9ce3e5d6a26b572ec731237ab3ce212ae6aaab0460",
      "word_count": 2
    },
    {
      "text": "Document icons",
      "section_path": [
        "Icons",
        "Platform considerations",
        "macOS",
        "Document icons"
      ],
      "source_sentence_hash": "50e19dd6cc8dbebb4f87077f7248745b08d65a4ac17cc8da1167900876efea12",
      "word_count": 2
    },
    {
      "text": "Design simple images that clearly communicate the document type",
      "section_path": [
        "Icons",
        "Platform considerations",
        "macOS",
        "Document icons"
      ],
      "source_sentence_hash": "4376456ce8befe8d3b36f994c6fac577b65db83f6b3f1bc1a6022eab7e544af1",
      "word_count": 9
    },
    {
      "text": "Designing a single, expressive image for the background fill can be a great way to help people understand and",
      "section_path": [
        "Icons",
        "Platform considerations",
        "macOS",
        "Document icons"
      ],
      "source_sentence_hash": "ddc4e766a8214fd352eb46c89ec6b0cccd446a3cf409bf22d0165832cfa6fdf6",
      "word_count": 19
    },
    {
      "text": "Consider reducing complexity in the small versions of your document icon",
      "section_path": [
        "Icons",
        "Platform considerations",
        "macOS",
        "Document icons"
      ],
      "source_sentence_hash": "3e5acc0e8e8ee472e59ba996c27af121e68bd09532e54b18ef894fb97d424572",
      "word_count": 11
    },
    {
      "text": "Avoid placing important content in the top-right corner of your background fill",
      "section_path": [
        "Icons",
        "Platform considerations",
        "macOS",
        "Document icons"
      ],
      "source_sentence_hash": "1eceb03a340c555710e73d12f026285556f948803aa366c63e0c2c5dddf1f81f",
      "word_count": 12
    },
    {
      "text": "If a familiar object can convey a document’s type or its connection with your app, consider creating a center",
      "section_path": [
        "Icons",
        "Platform considerations",
        "macOS",
        "Document icons"
      ],
      "source_sentence_hash": "cbcf33e4b11cf7acc52983899e55def99edceeda098a4c54aeec3def9259ec9c",
      "word_count": 19
    },
    {
      "text": "Define a margin that measures about 10% of the image canvas and keep most of the image within it",
      "section_path": [
        "Icons",
        "Platform considerations",
        "macOS",
        "Document icons"
      ],
      "source_sentence_hash": "8311e2e1dd8fdd77051cf884e61d1011930a49727026a999b4eb0eba1db9bcc8",
      "word_count": 19
    },
    {
      "text": "Specify a succinct term if it helps people understand your document type",
      "section_path": [
        "Icons",
        "Platform considerations",
        "macOS",
        "Document icons"
      ],
      "source_sentence_hash": "916bd6b099484bb37b9b9bce56ef9a94298a3ae151968c93e54c2f4a29462862",
      "word_count": 12
    }
  ],
