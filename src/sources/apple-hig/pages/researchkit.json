  "guidance_candidates": [
    {
      "text": "Always display the onboarding screens in the correct order",
      "section_path": [
        "ResearchKit",
        "Creating the onboarding experience"
      ],
      "source_sentence_hash": "8613b1bc4efe6121fbf0dad6c3db1bbf00ea2262aca4dc64d4d6a2723fc34eca",
      "word_count": 9
    },
    {
      "text": "1. Introduction",
      "section_path": [
        "ResearchKit",
        "Creating the onboarding experience",
        "1. Introduction"
      ],
      "source_sentence_hash": "6e62ee82e3df2a7dfcaba91e18eab2a77c9c7f7b4a5dceb49528346078b636d2",
      "word_count": 2
    },
    {
      "text": "Provide an introduction that informs and provides a call to action",
      "section_path": [
        "ResearchKit",
        "Creating the onboarding experience",
        "1. Introduction"
      ],
      "source_sentence_hash": "dc65f682003b925984b8ddc1e503cc48b6a74f4b98f42a7f60fccc4871fa9a53",
      "word_count": 11
    },
    {
      "text": "Clearly describe the study subject and purpose",
      "section_path": [
        "ResearchKit",
        "Creating the onboarding experience",
        "1. Introduction"
      ],
      "source_sentence_hash": "7881391b9cbb700fe609c124683ae232857bb287b70000bc64090c5fd60c298d",
      "word_count": 7
    },
    {
      "text": "Allow existing participants to quickly resume an in-progress study",
      "section_path": [
        "ResearchKit",
        "Creating the onboarding experience",
        "1. Introduction"
      ],
      "source_sentence_hash": "7881391b9cbb700fe609c124683ae232857bb287b70000bc64090c5fd60c298d",
      "word_count": 9
    },
    {
      "text": "2. Determine eligibility",
      "section_path": [
        "ResearchKit",
        "Creating the onboarding experience",
        "2. Determine eligibility"
      ],
      "source_sentence_hash": "56d015d999d89851272e0b4e574ccacfa16f925c93cd16e504a88e9cc2b0e9e6",
      "word_count": 3
    },
    {
      "text": "Determine eligibility as soon as possible",
      "section_path": [
        "ResearchKit",
        "Creating the onboarding experience",
        "2. Determine eligibility"
      ],
      "source_sentence_hash": "5100d084bc54c8ed47d96149a33625ef295185200995c8b3be9c33e6b58b81b6",
      "word_count": 6
    },
    {
      "text": "Present only eligibility requirements necessary for the study",
      "section_path": [
        "ResearchKit",
        "Creating the onboarding experience",
        "2. Determine eligibility"
      ],
      "source_sentence_hash": "c3498e3792cb1dda35ec88277352e4cb3a497f33b7cf9a86ff1ea0824ab530d8",
      "word_count": 8
    },
    {
      "text": "Use simple, straightforward language for eligibility requirements",
      "section_path": [
        "ResearchKit",
        "Creating the onboarding experience",
        "2. Determine eligibility"
      ],
      "source_sentence_hash": "c3498e3792cb1dda35ec88277352e4cb3a497f33b7cf9a86ff1ea0824ab530d8",
      "word_count": 7
    },
    {
      "text": "Make eligibility information easy to enter",
      "section_path": [
        "ResearchKit",
        "Creating the onboarding experience",
        "2. Determine eligibility"
      ],
      "source_sentence_hash": "c3498e3792cb1dda35ec88277352e4cb3a497f33b7cf9a86ff1ea0824ab530d8",
      "word_count": 6
    },
    {
      "text": "3. Get informed consent",
      "section_path": [
        "ResearchKit",
        "Creating the onboarding experience",
        "3. Get informed consent"
      ],
      "source_sentence_hash": "72f1b4d2dd3137a7cfd2dca35e5855f077165dbcbc857dd786a4629355864379",
      "word_count": 4
    },
    {
      "text": "Make sure participants understand your study before you get their consent",
      "section_path": [
        "ResearchKit",
        "Creating the onboarding experience",
        "3. Get informed consent"
      ],
      "source_sentence_hash": "ffb4a851997dc9c7ca0fd2a6be3f69f4c0111af06962f664767e99f47892f72e",
      "word_count": 11
    },
    {
      "text": "Make sure the app complies with applicable App Store consent requirements",
      "section_path": [
        "ResearchKit",
        "Creating the onboarding experience",
        "3. Get informed consent"
      ],
      "source_sentence_hash": "94610c6da3f51a20c2898096a255a70c66b97ae1dbc569f33b3a0218569f580b",
      "word_count": 11
    },
    {
      "text": "Break up a long consent form into easily digestible sections",
      "section_path": [
        "ResearchKit",
        "Creating the onboarding experience",
        "3. Get informed consent"
      ],
      "source_sentence_hash": "d381e537bb9898ab9a2b30527e379dca0751b933fee2977e6446ddfa3ae6fee0",
      "word_count": 10
    },
    {
      "text": "Use simple language for high-level consent section overviews",
      "section_path": [
        "ResearchKit",
        "Creating the onboarding experience",
        "3. Get informed consent"
      ],
      "source_sentence_hash": "0a50185f9443e9a242450d9e1fb367554b037670122d8677b1542d2d5083737e",
      "word_count": 8
    },
    {
      "text": "Provide detailed consent explanations when necessary",
      "section_path": [
        "ResearchKit",
        "Creating the onboarding experience",
        "3. Get informed consent"
      ],
      "source_sentence_hash": "0a50185f9443e9a242450d9e1fb367554b037670122d8677b1542d2d5083737e",
      "word_count": 6
    },
    {
      "text": "Ensure participants can view the entire consent form before agreeing",
      "section_path": [
        "ResearchKit",
        "Creating the onboarding experience",
        "3. Get informed consent"
      ],
      "source_sentence_hash": "0a50185f9443e9a242450d9e1fb367554b037670122d8677b1542d2d5083737e",
      "word_count": 10
    },
    {
      "text": "Consider a comprehension quiz when appropriate",
      "section_path": [
        "ResearchKit",
        "Creating the onboarding experience",
        "3. Get informed consent"
      ],
      "source_sentence_hash": "f571a4d62c2bb56b2d66331586b301f2dfccfa13ba4bc64e53d067511f17ec83",
      "word_count": 6
    },
    {
      "text": "Confirm participant consent before joining the study",
      "section_path": [
        "ResearchKit",
        "Creating the onboarding experience",
        "3. Get informed consent"
      ],
      "source_sentence_hash": "a233e63f84539762e02bc84ea2221e207fb4d49f16b4ada66fa4efd8f6e4b614",
      "word_count": 7
    },
    {
      "text": "Consider collecting participant contact information when appropriate",
      "section_path": [
        "ResearchKit",
        "Creating the onboarding experience",
        "3. Get informed consent"
      ],
      "source_sentence_hash": "a233e63f84539762e02bc84ea2221e207fb4d49f16b4ada66fa4efd8f6e4b614",
      "word_count": 7
    },
    {
      "text": "4. Request permission to access data",
      "section_path": [
        "ResearchKit",
        "Creating the onboarding experience",
        "4. Request permission to access data"
      ],
      "source_sentence_hash": "24bc48bccade2c6da1cab0ea49b65dbf574e524e7eafca71b9c81943fe22db56",
      "word_count": 6
    },
    {
      "text": "Require permission before accessing participant devices or data",
      "section_path": [
        "ResearchKit",
        "Creating the onboarding experience",
        "4. Request permission to access data"
      ],
      "source_sentence_hash": "08098d6ad1968f40fb9e7e65c0aeba43f4b288cdf85755081858d741893c8edf",
      "word_count": 8
    },
    {
      "text": "Clearly explain why the study needs each requested data type",
      "section_path": [
        "ResearchKit",
        "Creating the onboarding experience",
        "4. Request permission to access data"
      ],
      "source_sentence_hash": "129e3723c8a8a28bc2d07b1960a9efbef561cd5525040bd694e5531dc4581d81",
      "word_count": 10
    },
    {
      "text": "Don’t request access to data that isn’t critical to the study",
      "section_path": [
        "ResearchKit",
        "Creating the onboarding experience",
        "4. Request permission to access data"
      ],
      "source_sentence_hash": "129e3723c8a8a28bc2d07b1960a9efbef561cd5525040bd694e5531dc4581d81",
      "word_count": 11
    },
    {
      "text": "Ask for notification permission when the study requires notifications",
      "section_path": [
        "ResearchKit",
        "Creating the onboarding experience",
        "4. Request permission to access data"
      ],
      "source_sentence_hash": "129e3723c8a8a28bc2d07b1960a9efbef561cd5525040bd694e5531dc4581d81",
      "word_count": 9
    },
    {
      "text": "Create surveys that keep participants engaged",
      "section_path": [
        "ResearchKit",
        "Conducting research"
      ],
      "source_sentence_hash": "ad5bd615c5021b2c47c1b38f596a30ad02fd870a9134b23b4978d4ea032b1d95",
      "word_count": 6
    },
    {
      "text": "Communicate the survey question count and estimated duration",
      "section_path": [
        "ResearchKit",
        "Conducting research"
      ],
      "source_sentence_hash": "473662e30330c53eab20f263ff4ed27c444189350150c6d3d10af580e4cbcb78",
      "word_count": 8
    },
    {
      "text": "Use one screen per question",
      "section_path": [
        "ResearchKit",
        "Conducting research"
      ],
      "source_sentence_hash": "dc4045f27f6c792379b1df894b0fb4903dc5fd5543b4b5c0c51f5cb71eb04868",
      "word_count": 5
    },
    {
      "text": "Show participants their progress in the survey",
      "section_path": [
        "ResearchKit",
        "Conducting research"
      ],
      "source_sentence_hash": "62fb0ec08b256b6019f1be7c3418f281ea91c353fc30dafb0abcd5ff37b1a1a8",
      "word_count": 7
    },
    {
      "text": "Keep the survey as short as possible. Several short surveys tend to work better than one long survey",
      "section_path": [
        "ResearchKit",
        "Conducting research"
      ],
      "source_sentence_hash": "f9a920d80f4e7bf8f999675e7e60e1b4c8c4c52f63d143e839c12222b7f9abce",
      "word_count": 18
    },
    {
      "text": "Use standard question text and slightly smaller explanatory text",
      "section_path": [
        "ResearchKit",
        "Conducting research"
      ],
      "source_sentence_hash": "e8b20ef87e4533208d06fc44ac541901357943af36536170c233fc22795ba7a9",
      "word_count": 9
    },
    {
      "text": "Indicate when participants complete a survey",
      "section_path": [
        "ResearchKit",
        "Conducting research"
      ],
      "source_sentence_hash": "472a5dd6fc5d9ef100a54287b3e4b5a269e26742ffa8311f4c1f98f2e4cfd88e",
      "word_count": 6
    },
    {
      "text": "Make active tasks easy to understand",
      "section_path": [
        "ResearchKit",
        "Conducting research"
      ],
      "source_sentence_hash": "cd3b9075c0c47d1a58c1be758136cfd7521286e09dbcbf7247bfc3f159c8a182",
      "word_count": 6
    },
    {
      "text": "Describe how to perform the task using clear, simple language",
      "section_path": [
        "ResearchKit",
        "Conducting research"
      ],
      "source_sentence_hash": "490906d1fce15558f63e8f0c5064804253971d3de8ac2c653100acaf9c0fd080",
      "word_count": 10
    },
    {
      "text": "Describe task timing and circumstance requirements",
      "section_path": [
        "ResearchKit",
        "Conducting research"
      ],
      "source_sentence_hash": "899162fc6811e09325de507d91abb1e44d9f6273daa277a564cafb1f5dfe5d80",
      "word_count": 6
    },
    {
      "text": "Make sure participants can tell when the task is complete",
      "section_path": [
        "ResearchKit",
        "Conducting research"
      ],
      "source_sentence_hash": "e3c34c5ecf6862d727029275fc2595926138d5ba64e35e4417fab7a8a988bd04",
      "word_count": 10
    },
    {
      "text": "Use a profile to help participants manage personal data related to your study",
      "section_path": [
        "ResearchKit",
        "Managing personal information and providing encouragement"
      ],
      "source_sentence_hash": "35120a9bb7d04116bdc7d0cbfcd6f7dd03493013dfe66881154a7eba8df67bb1",
      "word_count": 13
    },
    {
      "text": "Keep profile and dashboard screens accessible throughout the app",
      "section_path": [
        "ResearchKit",
        "Managing personal information and providing encouragement"
      ],
      "source_sentence_hash": "77401789231f9e0531ca3ffec89196cc5e7b4ff3a10ab3c85708d511c59b4b6e",
      "word_count": 9
    },
    {
      "text": "Provide an easy way to leave a study from the profile",
      "section_path": [
        "ResearchKit",
        "Managing personal information and providing encouragement"
      ],
      "source_sentence_hash": "2a7d36d571e4c8dd4a1256e8bd26f6e0969cfa2c285b710be3e270c20282f9ba",
      "word_count": 11
    },
    {
      "text": "Provide profile access to the consent document and privacy policy",
      "section_path": [
        "ResearchKit",
        "Managing personal information and providing encouragement"
      ],
      "source_sentence_hash": "2a7d36d571e4c8dd4a1256e8bd26f6e0969cfa2c285b710be3e270c20282f9ba",
      "word_count": 10
    },
    {
      "text": "Use a dashboard to show progress and motivate participants to continue",
      "section_path": [
        "ResearchKit",
        "Managing personal information and providing encouragement"
      ],
      "source_sentence_hash": "e7a764f9adb5e1a2784bb2eb80b185c7848618db426341b16bb4268ebf436b23",
      "word_count": 11
    },
    {
      "text": "Avoid using ResearchKit on macOS, tvOS, visionOS, or watchOS",
      "section_path": [
        "ResearchKit",
        "Platform considerations"
      ],
      "source_sentence_hash": "2ec3f085b0c134724e9f7910d2fabc6e2faf405a8938fc1e68661571673c4197",
      "word_count": 9
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "ResearchKit",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
