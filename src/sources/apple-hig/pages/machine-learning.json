  "guidance_candidates": [
    {
      "text": "Critical or complementary",
      "section_path": [
        "Machine learning",
        "The role of machine learning in your app",
        "Critical or complementary"
      ],
      "source_sentence_hash": "df8abdd3cfcde4238e541b0928ba16ebabf01794b6f9fb0576a9f72cc8901fd9",
      "word_count": 3
    },
    {
      "text": "Private or public",
      "section_path": [
        "Machine learning",
        "The role of machine learning in your app",
        "Private or public"
      ],
      "source_sentence_hash": "6dacde1225d25e1dfe003ef734cdc9bf2d6462381fe637c14b8d190d57ebd8dc",
      "word_count": 3
    },
    {
      "text": "Proactive or reactive",
      "section_path": [
        "Machine learning",
        "The role of machine learning in your app",
        "Proactive or reactive"
      ],
      "source_sentence_hash": "10d8fe231779d607e9ba9c867038feb7221f1887537d7d2ace0b8ed6b4fc75c6",
      "word_count": 3
    },
    {
      "text": "Visible or invisible",
      "section_path": [
        "Machine learning",
        "The role of machine learning in your app",
        "Visible or invisible"
      ],
      "source_sentence_hash": "851e6dc9c5fd9c073675a01edf1a6896243d243d823620e439520369e025f2ac",
      "word_count": 3
    },
    {
      "text": "Dynamic or static",
      "section_path": [
        "Machine learning",
        "The role of machine learning in your app",
        "Dynamic or static"
      ],
      "source_sentence_hash": "12d9d4e762bff6a251124d7f7647e6015da0e6dd85ca2d5a41ec563c2baa8591",
      "word_count": 3
    },
    {
      "text": "Request explicit feedback only when necessary",
      "section_path": [
        "Machine learning",
        "Explicit feedback"
      ],
      "source_sentence_hash": "37887674ecff1448bc21f3a21ea853321033f1adf5bc56cdd4f50f790586f3b0",
      "word_count": 6
    },
    {
      "text": "Always make providing explicit feedback a voluntary task",
      "section_path": [
        "Machine learning",
        "Explicit feedback"
      ],
      "source_sentence_hash": "bbc4518982a469afd7b510b9cd4e4316597642f88d8743669ce222c52f903eb6",
      "word_count": 8
    },
    {
      "text": "Use simple, direct language to describe each explicit feedback option and its consequences",
      "section_path": [
        "Machine learning",
        "Explicit feedback"
      ],
      "source_sentence_hash": "8f4d31f37cf0519b76ea6516befc61e81bd912376a519f7e6a580ee602342617",
      "word_count": 13
    },
    {
      "text": "Add icons to an option description if it helps people understand it",
      "section_path": [
        "Machine learning",
        "Explicit feedback"
      ],
      "source_sentence_hash": "0f08f4468915e9658a4ab7651cd089478de883825adcaf13e50b90e934962ad7",
      "word_count": 12
    },
    {
      "text": "Consider offering multiple options when requesting explicit feedback",
      "section_path": [
        "Machine learning",
        "Explicit feedback"
      ],
      "source_sentence_hash": "1f24bc73fb6985f01eb9cc65a9e3c1bdd0ad0b0dde7e6b5b8f27a6e57820cc36",
      "word_count": 8
    },
    {
      "text": "Act immediately when you receive explicit feedback and persist the resulting changes",
      "section_path": [
        "Machine learning",
        "Explicit feedback"
      ],
      "source_sentence_hash": "dde07b18f9d3d03f48d4a66f1b746bb8363dfb84634ba0f5ed33753dc826501e",
      "word_count": 12
    },
    {
      "text": "Consider using explicit feedback to help improve when and where you show results",
      "section_path": [
        "Machine learning",
        "Explicit feedback"
      ],
      "source_sentence_hash": "4dff81df56a4323010dd5483d683c4fe9651493d3ac2fca5a06a11e6a5a992fe",
      "word_count": 13
    },
    {
      "text": "Always secure people’s information",
      "section_path": [
        "Machine learning",
        "Implicit feedback"
      ],
      "source_sentence_hash": "b91d4a19c28b6ee95ce4143b218257faced19baea00ee5cd4f0663d16e612349",
      "word_count": 4
    },
    {
      "text": "Help people control their information",
      "section_path": [
        "Machine learning",
        "Implicit feedback"
      ],
      "source_sentence_hash": "33e0a68d0450b61bbb09c76e3df46c736f4cd32b0c242f1d3cf04f9627cd7bb5",
      "word_count": 5
    },
    {
      "text": "Don’t let implicit feedback decrease people’s opportunities to explore",
      "section_path": [
        "Machine learning",
        "Implicit feedback"
      ],
      "source_sentence_hash": "d653eee71d348ede1b205c403758f93b99e70626c4c9aea92301aa4fc335c03d",
      "word_count": 9
    },
    {
      "text": "When possible, use multiple feedback signals to improve suggestions and mitigate mistakes",
      "section_path": [
        "Machine learning",
        "Implicit feedback"
      ],
      "source_sentence_hash": "c954e551aa04ad94f39d3f0f51f1183b318017fe0824316ccf7904bc68bf29e9",
      "word_count": 12
    },
    {
      "text": "Consider withholding private or sensitive suggestions",
      "section_path": [
        "Machine learning",
        "Implicit feedback"
      ],
      "source_sentence_hash": "b47bc529aa5a32661db1acb5b1a2ffec0dfc191de94d636e2477c87888e6a5ef",
      "word_count": 6
    },
    {
      "text": "Prioritize recent feedback",
      "section_path": [
        "Machine learning",
        "Implicit feedback"
      ],
      "source_sentence_hash": "3effebbd57647ec047afd8b88803a7d0df3eda39c64c42ae3635b6e4123fbb46",
      "word_count": 3
    },
    {
      "text": "Use feedback to update predictions on a cadence that matches the person’s mental model of the feature",
      "section_path": [
        "Machine learning",
        "Implicit feedback"
      ],
      "source_sentence_hash": "e0d27e510bfb799aced6320145f951561b10b3fc1492b9ea8115e495174fde63",
      "word_count": 17
    },
    {
      "text": "Be prepared for changes in implicit feedback when you make changes to your app’s UI",
      "section_path": [
        "Machine learning",
        "Implicit feedback"
      ],
      "source_sentence_hash": "129a90d234ef3d9c893ccfcc40060e383258211cc3dcb1ac6f8157982edcd947",
      "word_count": 15
    },
    {
      "text": "Beware of confirmation bias",
      "section_path": [
        "Machine learning",
        "Implicit feedback"
      ],
      "source_sentence_hash": "47e680fee488113be47660112cbe41741836308270da0152ca3d2227a71e8723",
      "word_count": 4
    },
    {
      "text": "Always secure people’s information",
      "section_path": [
        "Machine learning",
        "Calibration"
      ],
      "source_sentence_hash": "b91d4a19c28b6ee95ce4143b218257faced19baea00ee5cd4f0663d16e612349",
      "word_count": 4
    },
    {
      "text": "Be clear about why you need people’s information",
      "section_path": [
        "Machine learning",
        "Calibration"
      ],
      "source_sentence_hash": "7c2fcbd697748a79a9ad67a6bbe85f3537f7921a241e2014ef815a08a6596e65",
      "word_count": 8
    },
    {
      "text": "Collect only the most essential information",
      "section_path": [
        "Machine learning",
        "Calibration"
      ],
      "source_sentence_hash": "c3309be1ff60e19e8f4003f7e42cdb2061ed6b3c6a4a60a5a8a22c852450e200",
      "word_count": 6
    },
    {
      "text": "Avoid asking people to participate in calibration more than once",
      "section_path": [
        "Machine learning",
        "Calibration"
      ],
      "source_sentence_hash": "e1695518c46bd1b7e122a1bf8caafe9d15f9a83f4268b658acb9c2c6e64224af",
      "word_count": 10
    },
    {
      "text": "Make calibration quick and easy",
      "section_path": [
        "Machine learning",
        "Calibration"
      ],
      "source_sentence_hash": "f1354133e07ec02bdbb556a1e54540f4edb593cf202b780a35a526c3a6cba125",
      "word_count": 5
    },
    {
      "text": "Make sure people know how to perform calibration successfully",
      "section_path": [
        "Machine learning",
        "Calibration"
      ],
      "source_sentence_hash": "6fec911a5542a74401d0631434ebc8e9b1a7cdc25d930fa013a9fc57ed1949d1",
      "word_count": 9
    },
    {
      "text": "Immediately provide assistance if progress stalls",
      "section_path": [
        "Machine learning",
        "Calibration"
      ],
      "source_sentence_hash": "eeec05e89f0c69d22f81ac284c6752ab203c28b3819cb1dd1b6a9de455fe0f8e",
      "word_count": 6
    },
    {
      "text": "Confirm success",
      "section_path": [
        "Machine learning",
        "Calibration"
      ],
      "source_sentence_hash": "9e89fa886716496c498018fe321a054f49a734fbe0d39fe6a42ba2e520e0d849",
      "word_count": 2
    },
    {
      "text": "Let people cancel calibration at any time",
      "section_path": [
        "Machine learning",
        "Calibration"
      ],
      "source_sentence_hash": "89c5745028d6829f3ef2d4431eecfc4481cee5879751824553078ddf3ca0087f",
      "word_count": 7
    },
    {
      "text": "Give people a way to update or remove information they provided during calibration",
      "section_path": [
        "Machine learning",
        "Calibration"
      ],
      "source_sentence_hash": "050efec130d3db40078ef8ffc7538685079927aca2b2c87d900ec565e231d3d5",
      "word_count": 13
    },
    {
      "text": "Understand the significance of a mistake’s consequences",
      "section_path": [
        "Machine learning",
        "Mistakes"
      ],
      "source_sentence_hash": "48d991f2eb08396fdaf3fbf451935937d6165c3959f98b4887ea97510960edbc",
      "word_count": 7
    },
    {
      "text": "Make it easy for people to correct frequent or predictable mistakes",
      "section_path": [
        "Machine learning",
        "Mistakes"
      ],
      "source_sentence_hash": "9c6d4cda11808c7538e4b28c9c1adf34c2ff53867375afe23239c9e8b59ed2f3",
      "word_count": 11
    },
    {
      "text": "Continuously update your feature to reflect people’s evolving interests and preferences and help avoid mistakes",
      "section_path": [
        "Machine learning",
        "Mistakes"
      ],
      "source_sentence_hash": "0740ef4ad77d11aaa31d450f0f0d893d67f46d3f4d7d86e2fdb1025f82dc036f",
      "word_count": 15
    },
    {
      "text": "When possible, address mistakes without complicating the UI",
      "section_path": [
        "Machine learning",
        "Mistakes"
      ],
      "source_sentence_hash": "229c202c0e13785bd1b2f79855ce647c63caff5b722cc475f5c98e2e0789c76a",
      "word_count": 8
    },
    {
      "text": "Be especially careful to avoid mistakes in proactive features",
      "section_path": [
        "Machine learning",
        "Mistakes"
      ],
      "source_sentence_hash": "1591d644d8284176150dd69d481c479fc9f9196b84be020efa3e27e010fadc36",
      "word_count": 9
    },
    {
      "text": "As you work on reducing mistakes in one area, always consider the effect your work has on other areas",
      "section_path": [
        "Machine learning",
        "Mistakes"
      ],
      "source_sentence_hash": "e7316532391155ca4e9de23a7ae9affcc7f63c8c836c82ee086276e7e38c6b17",
      "word_count": 19
    },
    {
      "text": "Give people familiar, easy ways to make corrections",
      "section_path": [
        "Machine learning",
        "Corrections"
      ],
      "source_sentence_hash": "680e0c8307a5527765b1d419049145ea65bdcc5b879c5f087c4c50a5ac57018f",
      "word_count": 8
    },
    {
      "text": "Provide immediate value when people make a correction",
      "section_path": [
        "Machine learning",
        "Corrections"
      ],
      "source_sentence_hash": "c77cda145f4652446277acfb0419014a63184d1cddecf88fe9a88622d5ee312c",
      "word_count": 8
    },
    {
      "text": "Let people correct their corrections",
      "section_path": [
        "Machine learning",
        "Corrections"
      ],
      "source_sentence_hash": "3be4602f24749111d9ec9fc9db49a0c8e0f9a254c2a5ae6592e4daa7de47e8ed",
      "word_count": 5
    },
    {
      "text": "Always balance the benefits of a feature with the effort required to make a correction",
      "section_path": [
        "Machine learning",
        "Corrections"
      ],
      "source_sentence_hash": "b6467572f2542a7d068355e1fe070fb23e42534b9bfc0c8d36afd6f2e4003df9",
      "word_count": 15
    },
    {
      "text": "Never rely on corrections to make up for low-quality results",
      "section_path": [
        "Machine learning",
        "Corrections"
      ],
      "source_sentence_hash": "c62e5b2c4638d8e4a0829948f0062fe3346a838b7c694ecff8e8eac772f41be3",
      "word_count": 10
    },
    {
      "text": "Learn from corrections when it makes sense",
      "section_path": [
        "Machine learning",
        "Corrections"
      ],
      "source_sentence_hash": "6713e2f8e817615df232f1403fb168ccd3e8734e66a7a5a6eadacc4400835c26",
      "word_count": 7
    },
    {
      "text": "When possible, use guided corrections instead of freeform corrections",
      "section_path": [
        "Machine learning",
        "Corrections"
      ],
      "source_sentence_hash": "4cbf13876a318747abc735feef2d9f70c0de2e482b7d14676ed8895a8fe15236",
      "word_count": 9
    },
    {
      "text": "Prefer diverse options",
      "section_path": [
        "Machine learning",
        "Multiple options"
      ],
      "source_sentence_hash": "e6711f01d33403012f36447c0b4303b534413a1807e90ee35b08b39f6a1e321f",
      "word_count": 3
    },
    {
      "text": "In general, avoid providing too many options",
      "section_path": [
        "Machine learning",
        "Multiple options"
      ],
      "source_sentence_hash": "8e9f4dd1e3eb82c89bbab46d4b6bed3f7636202a037cc6297a46f7ee1baf1de1",
      "word_count": 7
    },
    {
      "text": "List the most likely option first",
      "section_path": [
        "Machine learning",
        "Multiple options"
      ],
      "source_sentence_hash": "80918e80b4139568b2ece80ac218569cb8d97c78312bdfa01c24710bde5389c6",
      "word_count": 6
    },
    {
      "text": "Make options easy to distinguish and choose",
      "section_path": [
        "Machine learning",
        "Multiple options"
      ],
      "source_sentence_hash": "80bc3e55bbbe4ddd4ece09fe00af50b18438177d208cc38fd3e02b48d950c7b5",
      "word_count": 7
    },
    {
      "text": "Learn from selections when it makes sense",
      "section_path": [
        "Machine learning",
        "Multiple options"
      ],
      "source_sentence_hash": "96a9e069ec35c7a45332d05d9a9c2724cb84e80763070e0bed03be505cb3634d",
      "word_count": 7
    },
    {
      "text": "Know what your confidence values mean before you decide how to present them",
      "section_path": [
        "Machine learning",
        "Confidence"
      ],
      "source_sentence_hash": "14865d8839f77dee13fed8197869b01ac454cc41c27c8fe3daec2394cdde5d60",
      "word_count": 13
    },
    {
      "text": "In general, translate confidence values into concepts that people already understand",
      "section_path": [
        "Machine learning",
        "Confidence"
      ],
      "source_sentence_hash": "ef3f35c30c529959aac470b9bb798db1b44b96722d54a117db7cf5a0029cedef",
      "word_count": 11
    },
    {
      "text": "In situations where attributions aren’t helpful, consider ranking or ordering the results in a way that implies confidence levels",
      "section_path": [
        "Machine learning",
        "Confidence"
      ],
      "source_sentence_hash": "e6220a4a1ba3a823c65cee50e9a5dee2d2fb14e996729d3205bfb2aef3243956",
      "word_count": 19
    },
    {
      "text": "In scenarios where people expect statistical or numerical information, display confidence values that help them interpret the results",
      "section_path": [
        "Machine learning",
        "Confidence"
      ],
      "source_sentence_hash": "6b914d678d457381c3f835929c27c7181f28c304bb1adb5b2b14c47f7b713b28",
      "word_count": 18
    },
    {
      "text": "Whenever possible, help people make decisions by conveying confidence in terms of actionable suggestions",
      "section_path": [
        "Machine learning",
        "Confidence"
      ],
      "source_sentence_hash": "b268211330c730ccadf070890a200ce0f6d1027df62605b95aea19e2243e4b48",
      "word_count": 14
    },
    {
      "text": "Consider changing how you present results based on different confidence thresholds",
      "section_path": [
        "Machine learning",
        "Confidence"
      ],
      "source_sentence_hash": "a15b3d505fbe8fe32269057fba81342e050ef7c140e614c96b95b21774d105fd",
      "word_count": 11
    },
    {
      "text": "When you know that confidence values correspond to result quality, you generally want to avoid showing results when confidence",
      "section_path": [
        "Machine learning",
        "Confidence"
      ],
      "source_sentence_hash": "97bd49e9114b5e58d4642800b8ffe8a3cd65e501d4b2ee4970f574e47e474987",
      "word_count": 19
    },
    {
      "text": "Consider using attributions to help people distinguish among results",
      "section_path": [
        "Machine learning",
        "Attribution"
      ],
      "source_sentence_hash": "5f9fee0dd1adb024eea7f09942d5a8ab6fc5a166b0fedee45f113bc6c795664c",
      "word_count": 9
    },
    {
      "text": "Avoid being too specific or too general",
      "section_path": [
        "Machine learning",
        "Attribution"
      ],
      "source_sentence_hash": "1213bc7ec51ebea1ee10e432a4f76694784d9ee638ef87bc451739cd4678b874",
      "word_count": 7
    },
    {
      "text": "Keep attributions factual and based on objective analysis",
      "section_path": [
        "Machine learning",
        "Attribution"
      ],
      "source_sentence_hash": "65fe4034f4f49b6cf982012f34b11ea1875ca4ad42cfb73def30f717a85f9f10",
      "word_count": 8
    },
    {
      "text": "In general, avoid technical or statistical jargon",
      "section_path": [
        "Machine learning",
        "Attribution"
      ],
      "source_sentence_hash": "4c29913480602054cc5553abeb6de8a8910c9e6d0551e681bbbff9e456daaf7f",
      "word_count": 7
    },
    {
      "text": "Help people establish realistic expectations",
      "section_path": [
        "Machine learning",
        "Limitations"
      ],
      "source_sentence_hash": "76a1e5481783ab7f8897360243c569233eddcdc24d8b852325b281a1e12bfcdc",
      "word_count": 5
    },
    {
      "text": "Demonstrate how to get the best results",
      "section_path": [
        "Machine learning",
        "Limitations"
      ],
      "source_sentence_hash": "0be46d3184605db6fc50f1ea4abd65e50b9ea1363882f056e77e814a7a33590d",
      "word_count": 7
    },
    {
      "text": "Explain how limitations can cause unsatisfactory results",
      "section_path": [
        "Machine learning",
        "Limitations"
      ],
      "source_sentence_hash": "f32e521090086bed51b9ad5a516398b777229927d570a0eb1a10ef3b7706da09",
      "word_count": 7
    },
    {
      "text": "Consider telling people when limitations are resolved",
      "section_path": [
        "Machine learning",
        "Limitations"
      ],
      "source_sentence_hash": "dff59ba612e13781cbb04f64bd6f7263825aca9f301d1cb209bc19f2399ab787",
      "word_count": 7
    },
