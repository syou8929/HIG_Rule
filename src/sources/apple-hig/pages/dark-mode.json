  "guidance_candidates": [
    {
      "text": "Avoid offering an app-specific appearance setting",
      "section_path": [
        "Dark Mode",
        "Best practices"
      ],
      "source_sentence_hash": "8cff52f9844bc936e7d56a5519aeb079b735a5c95054166c6fa158c3a702bf4f",
      "word_count": 6
    },
    {
      "text": "Ensure that your app looks good in both appearance modes",
      "section_path": [
        "Dark Mode",
        "Best practices"
      ],
      "source_sentence_hash": "9837fd60a805a5cf757ae8a5805e6cc45a03711f26d3dc5a0dd49b37a5a6a923",
      "word_count": 10
    },
    {
      "text": "Test your content to make sure that it remains comfortably legible in both appearance modes",
      "section_path": [
        "Dark Mode",
        "Best practices"
      ],
      "source_sentence_hash": "5a1e32f34e318c8dc88e098bc6084d34460b5b2144185889acfc4abb570556d6",
      "word_count": 15
    },
    {
      "text": "In rare cases, consider using only a dark appearance in the interface",
      "section_path": [
        "Dark Mode",
        "Best practices"
      ],
      "source_sentence_hash": "08b8800b6cee9828431cff3cf0f68212a26bb9dbc495caee349f58bdf344fc2e",
      "word_count": 12
    },
    {
      "text": "Embrace colors that adapt to the current appearance",
      "section_path": [
        "Dark Mode",
        "Dark Mode colors"
      ],
      "source_sentence_hash": "f46f7d69dfbe48883c6100330259e2b67e334e61a493e17cd7a0ec27f2fd76ed",
      "word_count": 8
    },
    {
      "text": "Aim for sufficient color contrast in all appearances",
      "section_path": [
        "Dark Mode",
        "Dark Mode colors"
      ],
      "source_sentence_hash": "72828c64c9c22bc84f03e1f7adfc2e478848f82db228054cfa59cf52bdf79980",
      "word_count": 8
    },
    {
      "text": "Soften the color of white backgrounds",
      "section_path": [
        "Dark Mode",
        "Dark Mode colors"
      ],
      "source_sentence_hash": "36a2cbfc7e36f2cc89a1b5ded819e866f4640471e12e0301f2f7c58348580e4e",
      "word_count": 6
    },
    {
      "text": "Icons and images",
      "section_path": [
        "Dark Mode",
        "Dark Mode colors",
        "Icons and images"
      ],
      "source_sentence_hash": "27b630d85162575ea6da6647f4ffa92da33bdaf5b264239b851c0415f492fafa",
      "word_count": 3
    },
    {
      "text": "Use SF Symbols wherever possible",
      "section_path": [
        "Dark Mode",
        "Dark Mode colors",
        "Icons and images"
      ],
      "source_sentence_hash": "d6b38005693197981ee9b73d1d2c0c70df25d0ba2c2be6bf97abaf7e3b30673a",
      "word_count": 5
    },
    {
      "text": "Design separate interface icons for the light and dark appearances if necessary",
      "section_path": [
        "Dark Mode",
        "Dark Mode colors",
        "Icons and images"
      ],
      "source_sentence_hash": "00721c7e674e4a349bc6d3cd8f5f82e8f7c2185f97f4078099f870d82d24c25f",
      "word_count": 12
    },
    {
      "text": "Make sure full-color images and icons look good in both appearances",
      "section_path": [
        "Dark Mode",
        "Dark Mode colors",
        "Icons and images"
      ],
      "source_sentence_hash": "057595bdb0999eef433f5a8cfcf09067f4be1a05cf8f9277cb746e726c381fc7",
      "word_count": 11
    },
    {
      "text": "Use the system-provided label colors for labels",
      "section_path": [
        "Dark Mode",
        "Dark Mode colors",
        "Text"
      ],
      "source_sentence_hash": "67f4b4b44ae90d38b5b546d5b4dfe981a26ffe7005de029d9941f6e548680302",
      "word_count": 7
    },
    {
      "text": "Use system views to draw text fields and text views",
      "section_path": [
        "Dark Mode",
        "Dark Mode colors",
        "Text"
      ],
      "source_sentence_hash": "95798a92900287d40bfaa9e214fed9554c6b62f9690185b1352ee3251676ee07",
      "word_count": 10
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "Dark Mode",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "Prefer the system background colors",
      "section_path": [
        "Dark Mode",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "a274e259c19a03b9ccf100d01474f276454d765148691ec1bf20b07441704c3a",
      "word_count": 5
    },
    {
      "text": "Include some transparency in custom component backgrounds when appropriate",
      "section_path": [
        "Dark Mode",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "dc226fb4a5be6300557c08e7bf32440b89f486ccb6ebf1a5c798f3502df6f053",
      "word_count": 9
    },
    {
      "text": "Avoid transparency in custom component backgrounds when the state uses color",
      "section_path": [
        "Dark Mode",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "8d0a34d6fc5163dd24ce0b3dbd45d02c41ca31e5187ae36cd544cb77a58cc6a9",
      "word_count": 11
    }
  ],
