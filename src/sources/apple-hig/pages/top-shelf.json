  "guidance_candidates": [
    {
      "text": "Help people jump right into your content",
      "section_path": [
        "Top Shelf",
        "Best practices"
      ],
      "source_sentence_hash": "dcb1158ec7bdca7da4a50439b87d37b5e33590d8619a3525d02be851a2943798",
      "word_count": 7
    },
    {
      "text": "Feature new content",
      "section_path": [
        "Top Shelf",
        "Best practices"
      ],
      "source_sentence_hash": "9ac0153c722fa576ac85bdd042d7dfabbd1949b92cf1ad5034b88eeaaec763c2",
      "word_count": 3
    },
    {
      "text": "Personalize people’s favorite content",
      "section_path": [
        "Top Shelf",
        "Best practices"
      ],
      "source_sentence_hash": "d1eb932894bf52e9ee5d3da26d36aba0b17e63799bb08d44e8794520eabb9423",
      "word_count": 4
    },
    {
      "text": "Avoid showing advertisements or prices",
      "section_path": [
        "Top Shelf",
        "Best practices"
      ],
      "source_sentence_hash": "12bea064d3d951502d05dd26587a5b9ea1bf7b6aee0c909f1eb7049c5c4b7af1",
      "word_count": 5
    },
    {
      "text": "Showcase compelling dynamic content that can help draw people in and encourage them to view more",
      "section_path": [
        "Top Shelf",
        "Best practices"
      ],
      "source_sentence_hash": "f3b1c4b2787626568a0a426a45c14e2424776917792c43734036404cb7378462",
      "word_count": 16
    },
    {
      "text": "If you don’t provide the recommended full-screen content, supply at least one static image as a fallback",
      "section_path": [
        "Top Shelf",
        "Best practices"
      ],
      "source_sentence_hash": "afcf5e2630557d2a4076f5e9788c3d6f5be90a7ecf7a9262ce3301657b220e86",
      "word_count": 17
    },
    {
      "text": "Avoid implying interactivity in a static image",
      "section_path": [
        "Top Shelf",
        "Best practices"
      ],
      "source_sentence_hash": "59a52b6673ae586bfbe7c5bfc668440947cea06ae0c2f73a2679618d9ad28b7c",
      "word_count": 7
    },
    {
      "text": "Carousel actions",
      "section_path": [
