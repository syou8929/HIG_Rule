  "guidance_candidates": [
    {
      "text": "In a watchOS fitness app, use workout sessions to provide useful data and relevant controls",
      "section_path": [
        "Workouts",
        "Best practices"
      ],
      "source_sentence_hash": "45450fa3d578233edc282c58b83477616aa606c164661a365e002f242008747e",
      "word_count": 15
    },
    {
      "text": "Avoid distracting people from a workout with information that’s not relevant",
      "section_path": [
        "Workouts",
        "Best practices"
      ],
      "source_sentence_hash": "13a0321f29ec4f8d0a0a504170734d66b9e22cd3ecb34af4005782ae9bf7e9b3",
      "word_count": 11
    },
    {
      "text": "Use a distinct visual appearance to indicate an active workout",
      "section_path": [
        "Workouts",
        "Best practices"
      ],
      "source_sentence_hash": "30960507f5a1b54781a7f4701027e694889142c85cff326af85bae7b5475ef73",
      "word_count": 10
    },
    {
      "text": "Provide workout controls that are easy to find and tap",
      "section_path": [
        "Workouts",
        "Best practices"
      ],
      "source_sentence_hash": "2ee113ee8f5168bdb7f0ee82c67dd71fdcdb73ba47a7a5f86901023d8b96e10b",
      "word_count": 10
    },
    {
      "text": "Help people understand the health information your app records if sensor data is unavailable during a workout",
      "section_path": [
        "Workouts",
        "Best practices"
      ],
      "source_sentence_hash": "c7f5b28dc403da89b81b95a008ede230727a5c792b8d6c4087d6a73aed3ec603",
      "word_count": 17
    },
    {
      "text": "Provide a summary at the end of a session",
      "section_path": [
        "Workouts",
        "Best practices"
      ],
      "source_sentence_hash": "6912f883d8e4cac1943aa76387c2e756e9b561506d1bf8022d6d9aec82092acc",
      "word_count": 9
    },
    {
      "text": "Discard extremely brief workout sessions",
      "section_path": [
        "Workouts",
        "Best practices"
      ],
      "source_sentence_hash": "0ac264e406602fb53c4e84a2a99405015956d56eeb036288796790f88b800c61",
      "word_count": 5
    },
    {
      "text": "Make sure text is legible for when people are in motion",
      "section_path": [
        "Workouts",
        "Best practices"
      ],
      "source_sentence_hash": "28b4d525ae49da0eedb3e6aad41efe5bebf33f06617b8652e4d703988bbdff48",
      "word_count": 11
    },
    {
      "text": "Use Activity rings correctly",
