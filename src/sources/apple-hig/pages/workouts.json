  "guidance_candidates": [
    {
      "text": "Use workout sessions to provide useful data and relevant controls in a watchOS fitness app",
      "section_path": [
        "Workouts",
        "Best practices"
      ],
      "source_sentence_hash": "76e4a5fd75e218a289b65f09b5ddbad7cee2a072d6f0c0455e5231c7e2431933",
      "word_count": 15
    },
    {
      "text": "Prioritize the workout data people are most likely to care about",
      "section_path": [
        "Workouts",
        "Best practices"
      ],
      "source_sentence_hash": "76e4a5fd75e218a289b65f09b5ddbad7cee2a072d6f0c0455e5231c7e2431933",
      "word_count": 10
    },
    {
      "text": "Avoid distracting people from a workout with information that’s not relevant",
      "section_path": [
        "Workouts",
        "Best practices"
      ],
      "source_sentence_hash": "4c314f2784790827a07b7d0e7200c9eab4295d0eee68e58470f211cdf1af3aa9",
      "word_count": 11
    },
    {
      "text": "Use a distinct visual appearance to indicate an active workout",
      "section_path": [
        "Workouts",
        "Best practices"
      ],
      "source_sentence_hash": "3625604506ede4935faf3894ce6658476849d95a03e1681d0ad5bc50119603b1",
      "word_count": 10
    },
    {
      "text": "Provide workout controls that are easy to find and tap",
      "section_path": [
        "Workouts",
        "Best practices"
      ],
      "source_sentence_hash": "785af1a4f9d507ff7350f659eb05aeb6b36db6e01848e2522c2efefbbfcc72c8",
      "word_count": 10
    },
    {
      "text": "Be sure to provide clear feedback that indicates when a session starts or stops",
      "section_path": [
        "Workouts",
        "Best practices"
      ],
      "source_sentence_hash": "785af1a4f9d507ff7350f659eb05aeb6b36db6e01848e2522c2efefbbfcc72c8",
      "word_count": 13
    },
    {
      "text": "Help people understand the health information your app records if sensor data is unavailable during a workout",
      "section_path": [
        "Workouts",
        "Best practices"
      ],
      "source_sentence_hash": "5ffd8065f7021a3ef0ab282624c7bc3054ae350b7123a908e6dab3ac8e43bd52",
      "word_count": 17
    },
    {
      "text": "Use language similar to the system Workout app when explaining unavailable sensor data for Swimming or Other workout types",
      "section_path": [
        "Workouts",
        "Best practices"
      ],
      "source_sentence_hash": "5ffd8065f7021a3ef0ab282624c7bc3054ae350b7123a908e6dab3ac8e43bd52",
      "word_count": 18
    },
    {
      "text": "Provide a summary at the end of a session",
      "section_path": [
        "Workouts",
        "Best practices"
      ],
      "source_sentence_hash": "842d9ea0e1129f3c116933e22aa6c919c7bd21011695f8ea7dcbb781b6c350e4",
      "word_count": 9
    },
    {
      "text": "Consider including Activity rings in the workout summary",
      "section_path": [
        "Workouts",
        "Best practices"
      ],
      "source_sentence_hash": "842d9ea0e1129f3c116933e22aa6c919c7bd21011695f8ea7dcbb781b6c350e4",
      "word_count": 8
    },
    {
      "text": "Discard extremely brief workout sessions",
      "section_path": [
        "Workouts",
        "Best practices"
      ],
      "source_sentence_hash": "4e82fc79279651080cfa4338c02270b0a4cc3cabdfa614108a582bfb84775901",
      "word_count": 5
    },
    {
      "text": "Make sure text is legible for when people are in motion",
      "section_path": [
        "Workouts",
        "Best practices"
      ],
      "source_sentence_hash": "731876b75ef831fc071011e5ae26b89ac6cdaa64e0f59180353d0729f08749db",
      "word_count": 11
    },
    {
      "text": "Use large font sizes when a workout session requires movement",
      "section_path": [
        "Workouts",
        "Best practices"
      ],
      "source_sentence_hash": "731876b75ef831fc071011e5ae26b89ac6cdaa64e0f59180353d0729f08749db",
      "word_count": 10
    },
    {
      "text": "Use high-contrast colors when a workout session requires movement",
      "section_path": [
        "Workouts",
        "Best practices"
      ],
      "source_sentence_hash": "731876b75ef831fc071011e5ae26b89ac6cdaa64e0f59180353d0729f08749db",
      "word_count": 9
    },
    {
      "text": "Make the most important workout information easy to read during movement",
      "section_path": [
        "Workouts",
        "Best practices"
      ],
      "source_sentence_hash": "731876b75ef831fc071011e5ae26b89ac6cdaa64e0f59180353d0729f08749db",
      "word_count": 11
    },
    {
      "text": "Use Activity rings correctly",
      "section_path": [
        "Workouts",
        "Best practices"
      ],
      "source_sentence_hash": "c3c630e016e9b48aeab5afc0fc5d880abacefa03a51c71580174055c2574bb97",
      "word_count": 4
    },
