  "guidance_candidates": [
    {
      "text": "Immersion styles",
      "section_path": [
        "Immersive experiences",
        "Immersion and passthrough",
        "Immersion styles"
      ],
      "source_sentence_hash": "a4798cb4b679e6b5d94f5f1b648a7134797d4b9f689597326ccffb886acf7bdb",
      "word_count": 2
    },
    {
      "text": "Use dimmed passthrough to bring attention to your content",
      "section_path": [
        "Immersive experiences",
        "Immersion and passthrough",
        "Immersion styles"
      ],
      "source_sentence_hash": "7eda7f61adfaed8db046858f2cf36cedeaa2d5af2da99c06ed0cdbe8842ddf79",
      "word_count": 9
    },
    {
      "text": "Create unbounded 3D experiences",
      "section_path": [
        "Immersive experiences",
        "Immersion and passthrough",
        "Immersion styles"
      ],
      "source_sentence_hash": "b570d560ff0e900e39227b11623aaa2c2e672f0335a692be1a0b619311510ddc",
      "word_count": 4
    },
    {
      "text": "Use progressive immersion to blend your custom environment with a person’s surroundings",
      "section_path": [
        "Immersive experiences",
        "Immersion and passthrough",
        "Immersion styles"
      ],
      "source_sentence_hash": "99bbec277cf4eb3f3a9c97685a33a18c236f5335b313259d257c58eaca02c29c",
      "word_count": 12
    },
    {
      "text": "Use full immersion to create a fully immersive experience",
      "section_path": [
        "Immersive experiences",
        "Immersion and passthrough",
        "Immersion styles"
      ],
      "source_sentence_hash": "8bb210a64fcd44490f4dbecb1248a0c5b6fa956330283b37a2b4865563086aac",
      "word_count": 9
    },
    {
      "text": "Offer multiple ways to use your app or game",
      "section_path": [
        "Immersive experiences",
        "Best practices"
      ],
      "source_sentence_hash": "3ee51f228f02a5a619b5b300605a442b78fcd56f90a7d902d56c8c58681752c9",
      "word_count": 9
    },
    {
      "text": "Prefer launching your app or game in the Shared Space or using the mixed immersion style",
      "section_path": [
        "Immersive experiences",
        "Best practices"
      ],
      "source_sentence_hash": "854213a88aa65437f535eeae997a9f19a5be219025ebb2c2fafb18f73d0c10d3",
      "word_count": 16
    },
    {
      "text": "Reserve immersion for meaningful moments and content",
      "section_path": [
        "Immersive experiences",
        "Best practices"
      ],
      "source_sentence_hash": "12fae367e795c4495537ac1664bec8b7973f0382228c082301f29c1654d37da5",
      "word_count": 7
    },
    {
      "text": "Help people engage with key moments in your app or game, regardless of the level of immersion",
      "section_path": [
        "Immersive experiences",
        "Best practices"
      ],
      "source_sentence_hash": "94dffe061c9d3924fe1bf41b9218d925372d0ffb022f93c7bfe0e8ff81f652bc",
      "word_count": 17
    },
    {
      "text": "Prefer subtle tint colors for passthrough",
      "section_path": [
        "Immersive experiences",
        "Best practices"
      ],
      "source_sentence_hash": "da78d94be0a37b54b81219e6bf6196b6530efb8192f3d9f681814eb40a4bbaf6",
      "word_count": 6
    },
    {
      "text": "Be mindful of people’s visual comfort",
      "section_path": [
        "Immersive experiences",
        "Promoting comfort"
      ],
      "source_sentence_hash": "321f826113612e5087ca3110a8ed6fd96fba5b5f8aff1f2c6f7f1abfb2e83cfe",
      "word_count": 6
    },
    {
      "text": "Make sure you display motion in comfortable ways while your software runs in a Full Space",
      "section_path": [
        "Immersive experiences",
        "Promoting comfort"
      ],
      "source_sentence_hash": "fd94b3abb33cd44a3f1527de3f2b943ae653e3be5e570d3629f88f56c96ed98c",
      "word_count": 16
    },
    {
      "text": "Choose a style of immersion that supports the movements people might make while they’re in your app or game",
      "section_path": [
        "Immersive experiences",
        "Promoting comfort"
      ],
      "source_sentence_hash": "d9848c68e171f64e48369fc9b8e73a9e4ca7950628ebb58b95385cd9554a6993",
      "word_count": 19
    },
    {
      "text": "Avoid encouraging people to move while they’re in a progressive or fully immersive experience",
      "section_path": [
        "Immersive experiences",
        "Promoting comfort"
      ],
      "source_sentence_hash": "9b8adfab0c8cea83ce0e896a02ea7087d1111a8a9065f0e70811ef035c4107b9",
      "word_count": 14
    },
    {
      "text": "If you use the mixed immersion style, avoid obscuring passthrough too much",
      "section_path": [
        "Immersive experiences",
        "Promoting comfort"
      ],
      "source_sentence_hash": "b0f3fc356340c96eb2399c3e7fdad4d2a038a9bea7d84f10ef46b12061b23095",
      "word_count": 12
    },
    {
      "text": "Adopt ARKit if you want to blend custom content with someone’s surroundings",
      "section_path": [
        "Immersive experiences",
        "Promoting comfort"
      ],
      "source_sentence_hash": "b04ad6593a0ede93ae197290286453497565bc5bf3bc142e9e3ba24c629c0449",
      "word_count": 12
    },
    {
      "text": "You must request people’s permission",
      "section_path": [
        "Immersive experiences",
        "Promoting comfort"
      ],
      "source_sentence_hash": "81fc8d5638e6590e2dd6e262d0974e540eda33f4b488076c62511d953e8ef782",
      "word_count": 5
    },
    {
      "text": "Design smooth, predictable transitions when changing immersion",
      "section_path": [
        "Immersive experiences",
        "Transitioning between immersive styles"
      ],
      "source_sentence_hash": "0c8369bc8e9ce864698bdb62bd01d8272b6e14d534864280fd9ae8ceb4f37f52",
      "word_count": 7
    },
    {
      "text": "Let people choose when to enter or exit a more immersive experience",
      "section_path": [
        "Immersive experiences",
        "Transitioning between immersive styles"
      ],
      "source_sentence_hash": "b9485a30c778ebb68580781791708fac1510f4de603f4aae544cc5908427e6ea",
      "word_count": 12
    },
    {
      "text": "Indicate the purpose of an exit control",
      "section_path": [
        "Immersive experiences",
        "Transitioning between immersive styles"
      ],
      "source_sentence_hash": "af5dead1d9d0c44c6396cb4dc9161dc98031fcb34722726c9bf9563db9feb5e6",
      "word_count": 7
    },
    {
      "text": "Make sure your button clarifies whether it returns people to a previous, less immersive context or quits an experience",
      "section_path": [
        "Immersive experiences",
        "Transitioning between immersive styles"
      ],
      "source_sentence_hash": "09c7c66d88d7904388c352dabbf4a23db63096cdb6f0ce9c5fbc500deee94c4b",
      "word_count": 19
    },
    {
      "text": "Prefer virtual hands that match familiar characteristics",
      "section_path": [
        "Immersive experiences",
        "Displaying virtual hands"
      ],
      "source_sentence_hash": "ee6816d2e11bbd12661f82b65cf4f1bf7bac7e61c9e33c9dfb72cdef98316259",
      "word_count": 7
    },
    {
      "text": "Use caution if you create virtual hands that are larger than the viewer’s hands",
      "section_path": [
        "Immersive experiences",
        "Displaying virtual hands"
      ],
      "source_sentence_hash": "0fb12315a362a496fe5fefb7de7c85a189d0f4ecbbde8c9b834488f8a3db7af3",
      "word_count": 14
    },
    {
      "text": "If there’s an interruption in hand-tracking data, fade out virtual hands and reveal the viewer’s own hands",
      "section_path": [
        "Immersive experiences",
        "Displaying virtual hands"
      ],
      "source_sentence_hash": "af36c0478cb3475a5efff9e588c8009f5652d93e9eb1845255bc2da27d065c09",
      "word_count": 17
    },
    {
      "text": "Don’t let the virtual hands become unresponsive and appear frozen",
      "section_path": [
        "Immersive experiences",
        "Displaying virtual hands"
      ],
      "source_sentence_hash": "ba92fe52b2d97d09b16e7f92df7d14bb795e2fe9bfb65a0d3f384b19c8a95fa8",
      "word_count": 10
    },
    {
      "text": "Minimize distracting content",
      "section_path": [
        "Immersive experiences",
        "Creating an environment"
      ],
      "source_sentence_hash": "c0ed5bb65ff899009596393369d64efd0f792c202c4aebb082f207208573e2ee",
      "word_count": 3
    },
    {
      "text": "Help people distinguish interactive objects in your environment",
      "section_path": [
        "Immersive experiences",
        "Creating an environment"
      ],
      "source_sentence_hash": "55f424216e6db62a115ff6074c90cef74fc1006a4f6647381702e6cdaee55a7e",
      "word_count": 8
    },
    {
      "text": "Keep animation subtle",
      "section_path": [
        "Immersive experiences",
        "Creating an environment"
      ],
      "source_sentence_hash": "43165aa9ac9da38bc6d40c0f0e8fe13d6c551a3b6fd82844682d3332b22f505a",
      "word_count": 3
    },
    {
      "text": "Always avoid displaying too much movement near the edges of a person’s field of view",
      "section_path": [
        "Immersive experiences",
        "Creating an environment"
      ],
      "source_sentence_hash": "c988e4555da10c8be5b95a0e9400f37926165e267d71b37c1197fc4ad7355fad",
      "word_count": 15
    },
    {
      "text": "Create an expansive environment, regardless of the place it depicts",
      "section_path": [
        "Immersive experiences",
        "Creating an environment"
      ],
      "source_sentence_hash": "1a5c9f54871b06760fd1321a844953b03bcee486ac7cd4da8e3405fbf9b638ed",
      "word_count": 10
    },
    {
      "text": "Use Spatial Audio to create atmosphere",
      "section_path": [
        "Immersive experiences",
        "Creating an environment"
      ],
      "source_sentence_hash": "8eda70e4b1aa075050137b24b4ecb58e10229629ccb5a5e26656fa3ca6cf9e2b",
      "word_count": 6
    },
    {
      "text": "Be sure to lower the volume of the soundscape or stop it completely",
      "section_path": [
        "Immersive experiences",
        "Creating an environment"
      ],
      "source_sentence_hash": "9c03d3cc0de20ba603b7d25761d84837e2d9c3847c1b3bab36efddc4636ca34e",
      "word_count": 13
    },
    {
      "text": "In general, avoid using a flat 360-degree image to create your environment",
      "section_path": [
        "Immersive experiences",
        "Creating an environment"
      ],
      "source_sentence_hash": "cff15f0058794a1e76c9c2a2d7c58f2c7024bfbd46cb1dea9631d9785d5a23e3",
      "word_count": 12
    },
    {
      "text": "Help people feel grounded",
      "section_path": [
        "Immersive experiences",
        "Creating an environment"
      ],
      "source_sentence_hash": "4421c2de7b915d441f4ad48a60900af625c32d4a252ec25e9b52b0675424b32e",
      "word_count": 4
    },
    {
      "text": "Always provide a ground plane mesh so people don’t feel like they’re floating",
      "section_path": [
        "Immersive experiences",
        "Creating an environment"
      ],
      "source_sentence_hash": "100a24e445990f1d718c80d94dbb52ada8c01b75b0352cf665195e3187061ec0",
      "word_count": 13
    },
    {
      "text": "Minimize asset redundancy",
      "section_path": [
        "Immersive experiences",
        "Creating an environment"
      ],
      "source_sentence_hash": "b7740d379ababb2ff95c8eff27c934d9a65af563583005739c9b54f399d5422c",
      "word_count": 3
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Immersive experiences",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    },
    {
      "text": "Ensure immersive software supports accessibility personalization",
      "section_path": [
        "Immersive experiences",
        "Best practices"
      ],
      "source_sentence_hash": "5ec6d3d95179cd3a3662091cdb70b0dca78d4896feaedcc8f7995278a91ffac4",
      "word_count": 6
    }
  ],
