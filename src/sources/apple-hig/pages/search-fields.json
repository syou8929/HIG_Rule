  "guidance_candidates": [
    {
      "text": "Use placeholder text to help people know what they can search for",
      "section_path": [
        "Search fields",
        "Best practices"
      ],
      "source_sentence_hash": "304f9e91e41390e28bc6ecd61a6b1b21fb33461e62ddca90aa8880143fce737c",
      "word_count": 12
    },
    {
      "text": "Provide search results immediately when possible as a person types",
      "section_path": [
        "Search fields",
        "Best practices"
      ],
      "source_sentence_hash": "a09768134400ade39bc1e3a3358a83f97f63cc2e42d8c34e83d915f3d554a898",
      "word_count": 10
    },
    {
      "text": "Consider showing suggested search terms",
      "section_path": [
        "Search fields",
        "Best practices"
      ],
      "source_sentence_hash": "0f51d5ed2a4d118e3c9a4f445c5f2dad745b1915e2ac0fcdaa8165eaa4a535af",
      "word_count": 5
    },
    {
      "text": "Simplify search results",
      "section_path": [
        "Search fields",
        "Best practices"
      ],
      "source_sentence_hash": "64973e5a50c79075f4d58be0460717b98744aba70445132bf4eaefa57c9aae37",
      "word_count": 3
    },
    {
      "text": "Consider categorizing search results to help people find what they want",
      "section_path": [
        "Search fields",
        "Best practices"
      ],
      "source_sentence_hash": "6015731a9a35c067cb5bf179e25d9c923190eaf967cb83b327c02b64a21d61d1",
      "word_count": 11
    },
    {
      "text": "Consider letting people filter search results",
      "section_path": [
        "Search fields",
        "Best practices"
      ],
      "source_sentence_hash": "fafbb38ee65f0f61a0c78a836a7035fcc3f50733d117da2c0854c5d396f6f0d1",
      "word_count": 6
    },
    {
      "text": "A scope bar is a control for filtering and adjusting the scope of a search",
      "section_path": [
        "Search fields",
        "Scope bars and tokens"
      ],
      "source_sentence_hash": "7743683c0d7bf6f5ec40bf3e6af8a6a6aa89129fdc9e927cc214ba102a446b7c",
      "word_count": 15
    },
    {
      "text": "A token is a visual representation of a search term that someone can select and edit, and acts as",
      "section_path": [
        "Search fields",
        "Scope bars and tokens"
      ],
      "source_sentence_hash": "e01f68ad248a2680e5c7351e108c987caff5724bbdd49b5a72e1254e5ce9e4ff",
      "word_count": 19
    },
    {
      "text": "Use a scope bar to filter among clearly defined search categories",
      "section_path": [
        "Search fields",
        "Scope bars and tokens"
      ],
      "source_sentence_hash": "d10d12cd0e1b525445a8f8aba12319e523d5b484fbb2fda18b938790be49597d",
      "word_count": 11
    },
    {
      "text": "Use a broad default scope and let people refine it",
      "section_path": [
        "Search fields",
        "Scope bars and tokens"
      ],
      "source_sentence_hash": "f8a6f09ccb2806cb5c3a334f17ebae6d7e7948225b52544b9d24a2a26b86992c",
      "word_count": 10
    },
    {
      "text": "Use tokens to filter by common search terms or items",
      "section_path": [
        "Search fields",
        "Scope bars and tokens"
      ],
      "source_sentence_hash": "03ee8fa71d92ad6b8fc9040801c4587c21bbf7d805c29734ffb213b3431bd085",
      "word_count": 10
    },
    {
      "text": "Consider pairing tokens with search suggestions",
      "section_path": [
        "Search fields",
        "Scope bars and tokens"
      ],
      "source_sentence_hash": "ae25b6562fae50e1ccf4589aaf6e37055e57d416c68d459b0d35994f9947c0c2",
      "word_count": 6
    },
    {
      "text": "As a tab in a tab bar",
      "section_path": [
        "Search fields",
        "Platform considerations",
        "iOS"
      ],
      "source_sentence_hash": "94815ac246f6d1190774f15a9733bbc3c52857d0a0ca42564986f93d2023852f",
      "word_count": 7
    },
    {
      "text": "In a toolbar at the bottom or top of the screen",
      "section_path": [
        "Search fields",
        "Platform considerations",
        "iOS"
      ],
      "source_sentence_hash": "674293bdee94bd8c8f43a2d09c8ef2143da1a081037baa6d611aa89287ab93db",
      "word_count": 11
    },
    {
      "text": "Directly inline with content",
      "section_path": [
        "Search fields",
        "Platform considerations",
        "iOS"
      ],
      "source_sentence_hash": "ad47bc37980ce3621d474086b3f3b62ec1c5be90c1c82968e7ba267ed3ff9989",
      "word_count": 4
    },
    {
      "text": "Search as a tab",
      "section_path": [
        "Search fields",
        "Platform considerations",
        "iOS",
        "Search as a tab"
      ],
      "source_sentence_hash": "a1fd53b1afb59206ab89e074d6f93f5f2a7a94cca4e4489a62d1c474724bdbe5",
      "word_count": 4
    },
    {
      "text": "Standard tab",
      "section_path": [
        "Search fields",
        "Platform considerations",
        "iOS",
        "Search as a tab"
      ],
      "source_sentence_hash": "3fea86a2e2bec543aeed138558be1c965ee60b937bfa0315bd0cb85fd4ae9a21",
      "word_count": 2
    },
    {
      "text": "Button appearance",
      "section_path": [
        "Search fields",
        "Platform considerations",
        "iOS",
        "Search as a tab"
      ],
      "source_sentence_hash": "fc8e03f86e03c90107f6c4392db64c3f2123638715c45a7f17f6e729a2d1ebb2",
      "word_count": 2
    },
    {
      "text": "Choose the standard tab style to provide suggestions, promote discovery, and encourage exploration",
      "section_path": [
        "Search fields",
        "Platform considerations",
        "iOS",
        "Search as a tab"
      ],
      "source_sentence_hash": "36c03990aaaaaf925b85f68e7ee319963085949979a3b58f6df153a715879338",
      "word_count": 13
    },
    {
      "text": "Choose the button appearance to help people quickly find what they need",
      "section_path": [
        "Search fields",
        "Platform considerations",
        "iOS",
        "Search as a tab"
      ],
      "source_sentence_hash": "a504c51eca2633dbaa0bb8bf49222737230f31978e6886978ee9a8bc64016ae5",
      "word_count": 12
    },
    {
      "text": "Search in a toolbar",
      "section_path": [
        "Search fields",
        "Platform considerations",
        "iOS",
        "Search in a toolbar"
      ],
      "source_sentence_hash": "10e8ac094607d241e0baf35c4d1bb829529f9eacddeddb4613110d40f75be873",
      "word_count": 4
    },
    {
      "text": "You can include search in a bottom toolbar either as an expanded field or as a toolbar button, depending",
      "section_path": [
        "Search fields",
        "Platform considerations",
        "iOS",
        "Search in a toolbar"
      ],
      "source_sentence_hash": "02001e8193e8d5a6aa5a4cb153464537c2d4b1a51df44f89e27c04cd3eb5052e",
      "word_count": 19
    },
    {
      "text": "You can include search in a top toolbar, also called a navigation bar, where it appears as a toolbar",
      "section_path": [
        "Search fields",
        "Platform considerations",
        "iOS",
        "Search in a toolbar"
      ],
      "source_sentence_hash": "45904d53225c0bd36d296ee711dbda4eecf56590c56fc7b25e3c66872b3c492b",
      "word_count": 19
    },
    {
      "text": "Place search at the bottom if there’s room",
      "section_path": [
        "Search fields",
        "Platform considerations",
        "iOS",
        "Search in a toolbar"
      ],
      "source_sentence_hash": "1347d29627974c1595a10f1e32075d4547a0e3334930091766ca26bab6d6ae31",
      "word_count": 8
    },
    {
      "text": "Place iOS search at the top to protect bottom content or when no bottom toolbar exists",
      "section_path": [
        "Search fields",
        "Platform considerations",
        "iOS",
        "Search in a toolbar"
      ],
      "source_sentence_hash": "bf6b6c8093629137aa8ab73b2ea63a00357a5790c7cfdc337e2d585915422ba3",
      "word_count": 16
    },
    {
      "text": "Search as an inline field",
      "section_path": [
        "Search fields",
        "Platform considerations",
        "iOS",
        "Search as an inline field"
      ],
      "source_sentence_hash": "7ca6eca7c12f7f488407f844e5cfd214629eb7868e7b99de4868e8b0f1c43120",
      "word_count": 5
    },
    {
      "text": "Place search as an inline field when its position alongside the content it searches strengthens that relationship",
      "section_path": [
        "Search fields",
        "Platform considerations",
        "iOS",
        "Search as an inline field"
      ],
      "source_sentence_hash": "9b23aa65f416e079a6469e3c67dc3a98fb6ce8e52a77b21de957493f99d5e72a",
      "word_count": 17
    },
    {
      "text": "Position a top inline search field above the list it searches",
      "section_path": [
        "Search fields",
        "Platform considerations",
        "iOS",
        "Search as an inline field"
      ],
      "source_sentence_hash": "eb159a561fe6eb0d41ba2e3b912052209e04a4be6c4a0077506aaa8ec5785d58",
      "word_count": 11
    },
    {
      "text": "Consider pinning a top inline search field while scrolling",
      "section_path": [
        "Search fields",
        "Platform considerations",
        "iOS",
        "Search as an inline field"
      ],
      "source_sentence_hash": "eb159a561fe6eb0d41ba2e3b912052209e04a4be6c4a0077506aaa8ec5785d58",
      "word_count": 9
    },
    {
      "text": "iPadOS, macOS",
      "section_path": [
        "Search fields",
        "Platform considerations",
        "iPadOS, macOS"
      ],
      "source_sentence_hash": "3ffc698a00f00e8d2ce8760202a3b44b535ff20c7038f9252fb28d1351bcc4d2",
      "word_count": 2
    },
    {
      "text": "Try to keep search consistent across iPadOS and macOS",
      "section_path": [
        "Search fields",
        "Platform considerations",
        "iPadOS, macOS"
      ],
      "source_sentence_hash": "b4b6c6c5f62c068dea230e9b70e87f87b0a733dc6e9083b2d4ab18b379ee04e2",
      "word_count": 9
    },
    {
      "text": "Place a search field at the toolbar’s trailing side for common uses",
      "section_path": [
        "Search fields",
        "Platform considerations",
        "iPadOS, macOS"
      ],
      "source_sentence_hash": "215dd350c6e2faf72bc34b54e9305cfb0d1f903c5ec3bd8ef2a1e4959ccc9a2f",
      "word_count": 12
    },
    {
      "text": "Include search at the top of the sidebar when filtering content or navigation there",
      "section_path": [
        "Search fields",
        "Platform considerations",
        "iPadOS, macOS"
      ],
      "source_sentence_hash": "535be0411accbb30672511410aa56e275aad1398f27fb97c17e956fe0eb12a77",
      "word_count": 14
    },
    {
      "text": "Include search as an item in the sidebar or tab bar when you want an area dedicated to discovery",
      "section_path": [
        "Search fields",
        "Platform considerations",
        "iPadOS, macOS"
      ],
      "source_sentence_hash": "63755f317349e19d06617e1130569da57d483a750f83d89356233f0240f58f65",
      "word_count": 19
    },
    {
      "text": "Consider immediately focusing a dedicated search field when people navigate to it",
      "section_path": [
        "Search fields",
        "Platform considerations",
        "iPadOS, macOS"
      ],
      "source_sentence_hash": "ca43aded2eb389f16cda90b426853ef97f8f948b4415396985286f0d1111cecf",
      "word_count": 12
    },
    {
      "text": "Place search to remain useful as iPadOS or macOS windows resize",
      "section_path": [
        "Search fields",
        "Platform considerations",
        "iPadOS, macOS"
      ],
      "source_sentence_hash": "e5b3ed3774e1c0844bc8bba004155a2b4ffadbbc7ab7c57cdc02a573d10ca7e5",
      "word_count": 11
    },
    {
      "text": "Provide suggestions to make searching easier",
      "section_path": [
        "Search fields",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "0da935de7d7018193d46b8fa2e20745251664631416d9e1abd940d2036625018",
      "word_count": 6
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Search fields",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
