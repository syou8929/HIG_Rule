  "guidance_candidates": [
    {
      "text": "Use system-provided haptic patterns according to their documented meanings",
      "section_path": [
        "Playing haptics",
        "Best practices"
      ],
      "source_sentence_hash": "bffbf9c0e29279e7ee8ae1aff166586e2f38d4ac9b16e361aa5fec2da3a77a51",
      "word_count": 9
    },
    {
      "text": "Use haptics consistently throughout your app or game",
      "section_path": [
        "Playing haptics",
        "Best practices"
      ],
      "source_sentence_hash": "1e641b28f949fd922609789f6b89b83ee5020c5090cfa0776ca107d3e748a3f9",
      "word_count": 8
    },
    {
      "text": "Prefer using haptics to complement other feedback in your app or game",
      "section_path": [
        "Playing haptics",
        "Best practices"
      ],
      "source_sentence_hash": "3ffc096e347e89c36c4e8efd94d17684a0965eec6d98dc68de895812025421c2",
      "word_count": 12
    },
    {
      "text": "Avoid overusing haptics",
      "section_path": [
        "Playing haptics",
        "Best practices"
      ],
      "source_sentence_hash": "b7009b5f5d0d5714f5993313dc36a4997d54f97bf2e35b72d54b2d161f780c22",
      "word_count": 3
    },
    {
      "text": "In most apps, prefer playing short haptics that complement discrete events",
      "section_path": [
        "Playing haptics",
        "Best practices"
      ],
      "source_sentence_hash": "eddc06e8a5a26669ad5d97cefd51ac8c3aedbb00b043975917c6500e57ea380e",
      "word_count": 11
    },
    {
      "text": "Make haptics optional",
      "section_path": [
        "Playing haptics",
        "Best practices"
      ],
      "source_sentence_hash": "af1d55c6932911b28df848877543b33bc16bb57a46773729c0c65a4c8ccc8762",
      "word_count": 3
    },
    {
      "text": "Be aware that playing haptics might impact other user experiences",
      "section_path": [
        "Playing haptics",
        "Best practices"
      ],
      "source_sentence_hash": "226da81742555fa992cfed63e5fed7322f44eefd5476fa537383b1e943de5f4c",
      "word_count": 10
