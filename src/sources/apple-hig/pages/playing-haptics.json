  "guidance_candidates": [
    {
      "text": "In an iPadOS, macOS, tvOS, or visionOS app or game, game controllers can provide haptic feedback (for developer guidance,",
      "section_path": [
        "Playing haptics"
      ],
      "source_sentence_hash": "3d0810758e12e65629566688e3e6a9623aed95eff6cd8e11517ef333670f315e",
      "word_count": 19
    },
    {
      "text": "Apple Pencil Pro and some trackpads can provide haptic feedback when connected to certain iPad models. (For details on",
      "section_path": [
        "Playing haptics"
      ],
      "source_sentence_hash": "dc5a9251139af03ca099642d9796775f0685847f734b3561e10ef17b422fcb5e",
      "word_count": 19
    },
    {
      "text": "Use system-provided haptic patterns according to their documented meanings",
      "section_path": [
        "Playing haptics",
        "Best practices"
      ],
      "source_sentence_hash": "bffbf9c0e29279e7ee8ae1aff166586e2f38d4ac9b16e361aa5fec2da3a77a51",
      "word_count": 9
    },
    {
      "text": "Use haptics consistently throughout your app or game",
      "section_path": [
        "Playing haptics",
        "Best practices"
      ],
      "source_sentence_hash": "1e641b28f949fd922609789f6b89b83ee5020c5090cfa0776ca107d3e748a3f9",
      "word_count": 8
    },
    {
      "text": "Prefer using haptics to complement other feedback in your app or game",
      "section_path": [
        "Playing haptics",
        "Best practices"
      ],
      "source_sentence_hash": "3ffc096e347e89c36c4e8efd94d17684a0965eec6d98dc68de895812025421c2",
      "word_count": 12
    },
    {
      "text": "Avoid overusing haptics",
      "section_path": [
        "Playing haptics",
        "Best practices"
      ],
      "source_sentence_hash": "b7009b5f5d0d5714f5993313dc36a4997d54f97bf2e35b72d54b2d161f780c22",
      "word_count": 3
    },
    {
      "text": "Prefer short haptics for discrete events in most apps",
      "section_path": [
        "Playing haptics",
        "Best practices"
      ],
      "source_sentence_hash": "eddc06e8a5a26669ad5d97cefd51ac8c3aedbb00b043975917c6500e57ea380e",
      "word_count": 9
    },
    {
      "text": "Make haptics optional",
      "section_path": [
        "Playing haptics",
        "Best practices"
      ],
      "source_sentence_hash": "af1d55c6932911b28df848877543b33bc16bb57a46773729c0c65a4c8ccc8762",
      "word_count": 3
    },
    {
      "text": "Be aware that playing haptics might impact other user experiences",
      "section_path": [
        "Playing haptics",
        "Best practices"
      ],
      "source_sentence_hash": "226da81742555fa992cfed63e5fed7322f44eefd5476fa537383b1e943de5f4c",
      "word_count": 10
    },
    {
      "text": "Transient events are brief and compact, often feeling like taps or impulses. The experience of tapping the Flashlight button",
      "section_path": [
        "Playing haptics",
        "Custom haptics"
      ],
      "source_sentence_hash": "3f844a5437811f1f55ac5a78140d9e6f6262d2086d943a102b0827ae9402cf61",
      "word_count": 19
    },
    {
      "text": "Continuous events feel like sustained vibrations, such as the experience of the lasers effect in a message",
      "section_path": [
        "Playing haptics",
        "Custom haptics"
      ],
      "source_sentence_hash": "37bbb9b83226c14f28218c998a8d0369f7afe7d6c705a45e4e67908fb88a0bca",
      "word_count": 17
    },
    {
      "text": "Use standard UI components — like toggles, sliders, and pickers — that play Apple-designed system haptics by default",
      "section_path": [
        "Playing haptics",
        "Platform considerations",
        "iOS"
      ],
      "source_sentence_hash": "c5bbb69ef9ba0fbf756a99d118cb2ecde444f537a3856c6bd48e1b492049b27b",
      "word_count": 18
    },
    {
      "text": "When it makes sense, use a feedback generator to play one of several predefined haptic patterns in the categories",
      "section_path": [
        "Playing haptics",
        "Platform considerations",
        "iOS"
      ],
      "source_sentence_hash": "b14d9dbf58d00a4d8b7e7e9c59effd451f41876337435cb9a3186ce604da7267",
      "word_count": 19
    },
    {
      "text": "Use an iOS feedback generator when predefined haptics fit",
      "section_path": ["Playing haptics", "Platform considerations", "iOS"],
      "source_sentence_hash": "b14d9dbf58d00a4d8b7e7e9c59effd451f41876337435cb9a3186ce604da7267",
      "word_count": 9
    },
    {
      "text": "Use Notification haptics for task or action outcomes",
      "section_path": ["Playing haptics", "Platform considerations", "iOS", "Notification"],
      "source_sentence_hash": "229a46ce520263c9eb59e1f4e92ae6d5b780dda6400e2faca6a19499fdfd9a9a",
      "word_count": 8
    },
    {
      "text": "Use Impact haptics as physical metaphors for visual events",
      "section_path": ["Playing haptics", "Platform considerations", "iOS", "Impact"],
      "source_sentence_hash": "5d442acba9eeec6bc3604c77070c65faa9c272b8bc3896fc8889c7d18fca4546",
      "word_count": 9
    },
    {
      "text": "Use Selection haptics while UI element values change",
      "section_path": ["Playing haptics", "Platform considerations", "iOS", "Selection"],
      "source_sentence_hash": "2ac1c0768e100ce7246ef82bae35ed37a4ce906765bccca51007d30742fba7eb",
      "word_count": 8
    },
    {
      "text": "Consider Magic Trackpad haptics for drag or force-click feedback",
      "section_path": ["Playing haptics", "Platform considerations", "macOS"],
      "source_sentence_hash": "77aea2c1bcc62477393337e5022ce4db7c07aac7528929b527401dfbd0e601af",
      "word_count": 9
    },
    {
      "text": "Use Alignment haptics for dragged-item alignment and boundary feedback",
      "section_path": ["Playing haptics", "Platform considerations", "macOS"],
      "source_sentence_hash": "887d922991eb09828765ddd198b10864e20c4cd9788327ca7a0c7dd984eefbc1",
      "word_count": 8
    },
    {
      "text": "Use Level change haptics for discrete pressure transitions",
      "section_path": ["Playing haptics", "Platform considerations", "macOS"],
      "source_sentence_hash": "4a565055717d5d12dcc4fe6f19aa48c10f0ce1d819746d330cfdeb049bc6acbd",
      "word_count": 8
    },
    {
      "text": "Use Generic haptics only when other macOS patterns do not apply",
      "section_path": ["Playing haptics", "Platform considerations", "macOS"],
      "source_sentence_hash": "2e8927dd824cdbee4827b0c29f9d0a4ef76be34f356eeb20329c08942c4f5bd1",
      "word_count": 10
    },
    {
      "text": "Use default Digital Crown haptic detents on supported Apple Watch models",
      "section_path": ["Playing haptics", "Platform considerations", "watchOS"],
      "source_sentence_hash": "1bc89160d520e43cc114cceb9b6be6a32c3b776e724f486590cfec816817e8df",
      "word_count": 11
    },
    {
      "text": "Use Notification haptics for significant watchOS events requiring attention",
      "section_path": ["Playing haptics", "Platform considerations", "watchOS"],
      "source_sentence_hash": "de4ba22723ef43c9098ef6dd3d46cb0040d9eb774bcd555148f35737b6b35425",
      "word_count": 9
    },
    {
      "text": "Use Up haptics when important values cross upper thresholds",
      "section_path": ["Playing haptics", "Platform considerations", "watchOS"],
      "source_sentence_hash": "229e64a1c67689a5f6942536c3c5b062044cd45bb8c81efc5f024a8d14d35287",
      "word_count": 9
    },
    {
      "text": "Use Down haptics when important values cross lower thresholds",
      "section_path": ["Playing haptics", "Platform considerations", "watchOS"],
      "source_sentence_hash": "0e62a2cd8cbdc0ad181aa04a72b93a593d31eaecf2c8798f541d7cbebac612f7",
      "word_count": 9
    },
    {
      "text": "Use Success haptics when watchOS actions complete successfully",
      "section_path": ["Playing haptics", "Platform considerations", "watchOS"],
      "source_sentence_hash": "3e9d41a152b20b2820bb0bd2cf19a43c5d393cffc0d0378ce855a2223d291c61",
      "word_count": 8
    },
    {
      "text": "Use Failure haptics when watchOS actions fail",
      "section_path": ["Playing haptics", "Platform considerations", "watchOS"],
      "source_sentence_hash": "8f5afa114bb646a373e9032bbb8f4d3121abeed63c55ae6e18703d2694ada3e7",
      "word_count": 7
    },
    {
      "text": "Use Retry haptics when failed watchOS actions can be retried",
      "section_path": ["Playing haptics", "Platform considerations", "watchOS"],
      "source_sentence_hash": "e91c6385a2bddcb89d4b39f1f2413d54ad625db1f8201b3cacf4a5bb55c56bed",
      "word_count": 9
    },
    {
      "text": "Use Start haptics when people begin controllable watchOS activities",
      "section_path": ["Playing haptics", "Platform considerations", "watchOS"],
      "source_sentence_hash": "bfe7e022673a6f81cf1f9ffedaff307712bf6242c2d40ed5129bde50a4f1a77f",
      "word_count": 9
    },
    {
      "text": "Use Stop haptics when people stop previously started watchOS activities",
      "section_path": ["Playing haptics", "Platform considerations", "watchOS"],
      "source_sentence_hash": "9878a75f72664aaa8009403df164c662fc0aa854fff70513fe32f6d33bb38e51",
      "word_count": 10
    },
    {
      "text": "Use Click haptics for progress at predefined increments or intervals",
      "section_path": ["Playing haptics", "Platform considerations", "watchOS"],
      "source_sentence_hash": "63a15105fae49f1b36cd95818b3aa9c56c5b7d13c2d5218ee405a92782916db5",
      "word_count": 10
    },
    {
      "text": "Avoid overusing or overlapping watchOS Click haptics",
      "section_path": ["Playing haptics", "Platform considerations", "watchOS"],
      "source_sentence_hash": "63a15105fae49f1b36cd95818b3aa9c56c5b7d13c2d5218ee405a92782916db5",
      "word_count": 8
    },
    {
      "text": "Avoid assigning a documented haptic pattern a different meaning",
      "section_path": ["Playing haptics", "Best practices"],
      "source_sentence_hash": "bffbf9c0e29279e7ee8ae1aff166586e2f38d4ac9b16e361aa5fec2da3a77a51",
      "word_count": 9
    },
    {
      "text": "Use generic or custom haptics when documented patterns do not fit",
      "section_path": ["Playing haptics", "Best practices"],
      "source_sentence_hash": "bffbf9c0e29279e7ee8ae1aff166586e2f38d4ac9b16e361aa5fec2da3a77a51",
      "word_count": 11
    },
    {
      "text": "Maintain clear causal relationships between haptics and actions",
      "section_path": ["Playing haptics", "Best practices"],
      "source_sentence_hash": "1e641b28f949fd922609789f6b89b83ee5020c5090cfa0776ca107d3e748a3f9",
      "word_count": 8
    },
    {
      "text": "Match haptic intensity and sharpness to its animation",
      "section_path": ["Playing haptics", "Best practices"],
      "source_sentence_hash": "3ffc096e347e89c36c4e8efd94d17684a0965eec6d98dc68de895812025421c2",
      "word_count": 8
    },
    {
      "text": "Consider synchronizing sound with haptics",
      "section_path": ["Playing haptics", "Best practices"],
      "source_sentence_hash": "3ffc096e347e89c36c4e8efd94d17684a0965eec6d98dc68de895812025421c2",
      "word_count": 5
    },
    {
      "text": "Ensure people can still enjoy the app or game without haptics",
      "section_path": ["Playing haptics", "Best practices"],
      "source_sentence_hash": "af1d55c6932911b28df848877543b33bc16bb57a46773729c0c65a4c8ccc8762",
      "word_count": 11
    },
    {
      "text": "Ensure haptic vibrations do not disrupt the camera gyroscope or microphone",
      "section_path": ["Playing haptics", "Best practices"],
      "source_sentence_hash": "226da81742555fa992cfed63e5fed7322f44eefd5476fa537383b1e943de5f4c",
      "word_count": 11
    },
    {
      "text": "Use iOS Success haptics for completed tasks or actions",
      "section_path": ["Playing haptics", "Platform considerations", "iOS", "Notification"],
      "source_sentence_hash": "98fd0fa57d76c16dad37b4a8ac1ba4ccb9f4a4e4b8c60f7e6cdf32139380b948",
      "word_count": 9
    },
    {
      "text": "Use iOS Warning haptics for warning outcomes",
      "section_path": ["Playing haptics", "Platform considerations", "iOS", "Notification"],
      "source_sentence_hash": "980db45970e3a8f2596f2e3e6e1b601e0d82c856076767ef4763354d41f80adf",
      "word_count": 7
    },
    {
      "text": "Use iOS Error haptics when an error occurs",
      "section_path": ["Playing haptics", "Platform considerations", "iOS", "Notification"],
      "source_sentence_hash": "d7205716ed7f6d6fcfdb553e2462e027313b6ad24d7a6267c197a36a6c1ba326",
      "word_count": 8
    },
    {
      "text": "Use iOS Light Impact haptics for small or lightweight object collisions",
      "section_path": ["Playing haptics", "Platform considerations", "iOS", "Impact"],
      "source_sentence_hash": "26030910cf5888800db0f1e81644b10b526a80c59a3e2342717c06a0e74ada0a",
      "word_count": 11
    },
    {
      "text": "Use iOS Medium Impact haptics for medium-sized or medium-weight object collisions",
      "section_path": ["Playing haptics", "Platform considerations", "iOS", "Impact"],
      "source_sentence_hash": "76f7ac6533c44fcadf2eaf21d79ef7b5d97bbe178d0d114b82f49b7c81351525",
      "word_count": 11
    },
    {
      "text": "Use iOS Heavy Impact haptics for large or heavyweight object collisions",
      "section_path": ["Playing haptics", "Platform considerations", "iOS", "Impact"],
      "source_sentence_hash": "3d9affc73f7a27e30aaa9e3f2fa8dd2b1245b47e386abdcba6050560376faef4",
      "word_count": 11
    },
    {
      "text": "Use iOS Rigid Impact haptics for hard or inflexible object collisions",
      "section_path": ["Playing haptics", "Platform considerations", "iOS", "Impact"],
      "source_sentence_hash": "56110492bbb74146a37a8b70b9cddc783694249420544817d545b1b11d53c31c",
      "word_count": 11
    },
    {
      "text": "Use iOS Soft Impact haptics for soft or flexible object collisions",
      "section_path": ["Playing haptics", "Platform considerations", "iOS", "Impact"],
      "source_sentence_hash": "e324d2e4c9ca12c60e6d749fe13864ef4344fed3b62ff2aa64e010024c2173cd",
      "word_count": 11
    },
    {
      "text": "Use iOS Selection haptics while a UI element value changes",
      "section_path": ["Playing haptics", "Platform considerations", "iOS", "Selection"],
      "source_sentence_hash": "36e083e4e45d678023a3d7107b7bb358615e0bd8b040c200f7019d33140990d9",
      "word_count": 10
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Playing haptics",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
