  "guidance_candidates": [
    {
      "text": "Use a table instead of an outline view to present data that’s not hierarchical",
      "section_path": [
        "Outline views",
        "Best practices"
      ],
      "source_sentence_hash": "51f4a0831d9cf53ab1c260b91fb792be182e17d3f62c01d8bd0634177a4c08b0",
      "word_count": 14
    },
    {
      "text": "Keep data hierarchy in the first column only",
      "section_path": [
        "Outline views",
        "Best practices"
      ],
      "source_sentence_hash": "24bb0bf77ed2c0cc17b942f87a3a16ec00ce35f8abd5ab002d596edcdcfb9255",
      "word_count": 8
    },
    {
      "text": "Use descriptive column headings to provide context",
      "section_path": [
        "Outline views",
        "Best practices"
      ],
      "source_sentence_hash": "cf03e31cb58a7d6409f446d1287db2c9994ee5b56f07b9415d34c154f927c345",
      "word_count": 7
    },
    {
      "text": "Use nouns or short noun phrases for column headings",
      "section_path": [
        "Outline views",
        "Best practices"
      ],
      "source_sentence_hash": "fc09f004e7ee61decc33a25d111616c55b3716129ddc398ede856ccc573be31c",
      "word_count": 9
    },
    {
      "text": "Use title-style capitalization for column headings",
      "section_path": [
        "Outline views",
        "Best practices"
      ],
      "source_sentence_hash": "fc09f004e7ee61decc33a25d111616c55b3716129ddc398ede856ccc573be31c",
      "word_count": 7
    },
    {
      "text": "Avoid punctuation in column headings, especially trailing colons",
      "section_path": [
        "Outline views",
        "Best practices"
      ],
      "source_sentence_hash": "fc09f004e7ee61decc33a25d111616c55b3716129ddc398ede856ccc573be31c",
      "word_count": 8
    },
    {
      "text": "Always provide column headings in a multi-column outline view",
      "section_path": [
        "Outline views",
        "Best practices"
      ],
      "source_sentence_hash": "15f526235d3d54c8e8feb717039a12b48558f377e792b6015ca617a5418bb80c",
      "word_count": 9
    },
    {
      "text": "If a single-column view omits its heading, use another source of context",
      "section_path": [
        "Outline views",
        "Best practices"
      ],
      "source_sentence_hash": "0a8f8975a0f6c8ab18fb548de5da3bde4404bfd62fc0782281a6c9f6b4d4368d",
      "word_count": 12
    },
    {
      "text": "Consider letting people click column headings to sort an outline view",
      "section_path": [
        "Outline views",
        "Best practices"
      ],
      "source_sentence_hash": "69b853c69ae066a52e11f218ea17d9d061cd375a97474f4248a65b3d93f0609b",
      "word_count": 11
    },
    {
      "text": "Support ascending and descending sorting through column headings",
      "section_path": [
        "Outline views",
        "Best practices"
      ],
      "source_sentence_hash": "5630a95097211733e722e309415c48591f4b89abb38a82b18ed107702166f72c",
      "word_count": 8
    },
    {
      "text": "If necessary, consider secondary-column sorting behind the scenes",
      "section_path": [
        "Outline views",
        "Best practices"
      ],
      "source_sentence_hash": "79b7f512ee9ea3aff108873a2c99d782defa1118c9110e2de7b1b808f4109c44",
      "word_count": 8
    },
    {
      "text": "Apply primary-column sorting at each hierarchy level",
      "section_path": [
        "Outline views",
        "Best practices"
      ],
      "source_sentence_hash": "3c970d3b649ee09cb91edd2dd80addf2f57024b041c1b8121e7ef563d559c47d",
      "word_count": 7
    },
    {
      "text": "Use the opposite sort direction when people click the sorted column heading",
      "section_path": [
        "Outline views",
        "Best practices"
      ],
      "source_sentence_hash": "bef76c683a09f34bbae49aec5f60cb280226339d166c239ad6665f7134489121",
      "word_count": 12
    },
    {
      "text": "Let people resize columns",
      "section_path": [
        "Outline views",
        "Best practices"
      ],
      "source_sentence_hash": "037373307c00fd6082a9a53cc5a19ce296876e8a5bcd914d47d1a4f4cd31323d",
      "word_count": 4
    },
    {
      "text": "Make it easy for people to expand or collapse nested containers",
      "section_path": [
        "Outline views",
        "Best practices"
      ],
      "source_sentence_hash": "28c7cb34e003a7e45c2f21acf21f387c53fc392a18a3c5693234d71f2cab211e",
      "word_count": 11
    },
    {
      "text": "Retain people’s expansion choices",
      "section_path": [
        "Outline views",
        "Best practices"
      ],
      "source_sentence_hash": "b74232a3550f294b52eaac14ef8e564ccd207b7bdd4d361575329a4b49a1d1e0",
      "word_count": 4
    },
    {
      "text": "Consider using alternating row colors in multi-column outline views",
      "section_path": [
        "Outline views",
        "Best practices"
      ],
      "source_sentence_hash": "3ab7fd55db811367e4fb9924f480a9724af3b2ccf2b15c5317d425cf70af081b",
      "word_count": 9
    },
    {
      "text": "Let people edit data if it makes sense in your app",
      "section_path": [
        "Outline views",
        "Best practices"
      ],
      "source_sentence_hash": "0b213348b10e993adf7494abfd5b62e65a9b00514ba2371bc17482ccb3174d55",
      "word_count": 11
    },
    {
      "text": "Use a single click to edit an editable outline-view cell",
      "section_path": [
        "Outline views",
        "Best practices"
      ],
      "source_sentence_hash": "4c61cac26ef1c2ab72ff9a39b91ff32f6d141aa2eb3473491c86f2cba920cf38",
      "word_count": 10
    },
    {
      "text": "If useful, consider letting people reorder, add, and remove rows",
      "section_path": [
        "Outline views",
        "Best practices"
      ],
      "source_sentence_hash": "5146dde7fc9185eca555863f667a99c82290be7e5e1ced47a0184fc0989fcecd",
      "word_count": 10
    },
    {
      "text": "Consider using a centered ellipsis to truncate cell text instead of clipping it",
      "section_path": [
        "Outline views",
        "Best practices"
      ],
      "source_sentence_hash": "d2571d433e8c6c7b829530a9d0a858c26df9334b7fc27de38512bd23c41cb9c6",
      "word_count": 13
    },
    {
      "text": "Consider offering a search field to help people find values quickly in a lengthy outline view",
      "section_path": [
        "Outline views",
        "Best practices"
      ],
      "source_sentence_hash": "204854d3ab799746a56706b54328d2ea5882ccc2002d1cca56edbceb441cb547",
      "word_count": 16
    },
    {
