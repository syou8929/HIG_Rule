    },
    {
      "text": "Always On",
      "section_path": [
        "Designing for watchOS"
      ],
      "source_sentence_hash": "e476af44b933cb48aeae7b46e4c637a46da622c77240e1555c28953b261e2eb9",
      "word_count": 2
    },
    {
      "text": "Watch faces",
      "section_path": [
        "Designing for watchOS"
      ],
      "source_sentence_hash": "d08a55c4d79619a7ddf3cdd6ea9de4c672ba0b5f5085260f57241a5908325923",
      "word_count": 2
    },
    {
      "text": "Support quick, glanceable, single-screen interactions for critical information and targeted actions in one or two gestures",
      "section_path": [
        "Designing for watchOS",
        "Best practices"
      ],
      "source_sentence_hash": "a4f6c6f7b3c79246b28b7c3e7105f38ed79fe7b14fe4c1748d4716970c2935b5",
      "word_count": 16
    },
    {
      "text": "Minimize hierarchy depth in watchOS app navigation",
      "section_path": [
        "Designing for watchOS",
        "Best practices"
      ],
      "source_sentence_hash": "edbe29391602f40228a8ef5684ec9b580cd7d8956c254696ee2dbb6e4bcbed81",
      "word_count": 7
    },
    {
      "text": "Use the Digital Crown for vertical scrolling or switching between watchOS screens",
      "section_path": [
        "Designing for watchOS",
        "Best practices"
      ],
      "source_sentence_hash": "edbe29391602f40228a8ef5684ec9b580cd7d8956c254696ee2dbb6e4bcbed81",
      "word_count": 12
    },
    {
      "text": "Personalize watchOS with on-device data that anticipates needs and provides actionable near-term content",
      "section_path": [
        "Designing for watchOS",
        "Best practices"
      ],
      "source_sentence_hash": "3b19e9ca4d172cc688261f4c93382fed714316e82e2d35e5266d55f66e688473",
      "word_count": 13
    },
    {
      "text": "Use complications for relevant, potentially dynamic watch-face data and graphics",
      "section_path": [
        "Designing for watchOS",
        "Best practices"
      ],
      "source_sentence_hash": "6cfc2e917951a0b8a14d92a712ee93fcc6e232580c6c466fc2cf1e695573d6f5",
      "word_count": 10
    },
    {
      "text": "Use complication taps to open the related watchOS app directly",
      "section_path": [
        "Designing for watchOS",
        "Best practices"
      ],
      "source_sentence_hash": "6cfc2e917951a0b8a14d92a712ee93fcc6e232580c6c466fc2cf1e695573d6f5",
      "word_count": 10
    },
    {
      "text": "Use notifications to deliver timely, high-value information and let people perform important actions without opening your app",
      "section_path": [
        "Designing for watchOS",
        "Best practices"
      ],
      "source_sentence_hash": "3451db8969a68e8a84b22d152046801df1e1ada006c1b9d8b08d72bab30d9693",
      "word_count": 17
    },
    {
      "text": "Use watchOS background content such as color to convey useful supporting information",
      "section_path": [
        "Designing for watchOS",
        "Best practices"
      ],
      "source_sentence_hash": "68bb4cde1ed41285bef74584768c550d98f0453652716eed3bf258b7be48e889",
      "word_count": 12
    },
    {
      "text": "Use watchOS materials to communicate hierarchy and a sense of place",
      "section_path": [
        "Designing for watchOS",
        "Best practices"
      ],
      "source_sentence_hash": "68bb4cde1ed41285bef74584768c550d98f0453652716eed3bf258b7be48e889",
      "word_count": 11
    },
    {
      "text": "Design your app to function independently, complementing your notifications and complications by providing additional details and functionality",
      "section_path": [
        "Designing for watchOS",
        "Best practices"
      ],
      "source_sentence_hash": "bf8bb097fd95a8b7aacf6a4f10ba197b95ce5f77329487f85daf75f882a3fd03",
      "word_count": 17
    },
