  "guidance_candidates": [
    {
      "text": "Support Full Keyboard Access when possible",
      "section_path": [
        "Keyboards",
        "Best practices"
      ],
      "source_sentence_hash": "4a9a0cedb294338f55a6818a42f8c265a06d42edc1df9932b46bb5d8a2a7669a",
      "word_count": 6
    },
    {
      "text": "Respect standard keyboard shortcuts",
      "section_path": [
        "Keyboards",
        "Best practices"
      ],
      "source_sentence_hash": "842b58f1660fb0c177f56e697d71e3f6de17728a63a045b3eb5265a5d68960b9",
      "word_count": 4
    },
    {
      "text": "In general, don’t repurpose standard keyboard shortcuts for custom actions",
      "section_path": [
        "Keyboards",
        "Standard keyboard shortcuts"
      ],
      "source_sentence_hash": "969f483d3d240d22920f242f18330db0c00ca023780541d1bdc55de65ea3a910",
      "word_count": 10
    },
    {
      "text": "Define custom keyboard shortcuts for only the most frequently used app-specific commands",
      "section_path": [
        "Keyboards",
        "Custom keyboard shortcuts"
      ],
      "source_sentence_hash": "e0fa3c4b47694153f8691f0d334057676e25849be21f46b947108a341b2842ed",
      "word_count": 12
    },
    {
      "text": "Use modifier keys in ways that people expect",
      "section_path": [
        "Keyboards",
        "Custom keyboard shortcuts"
      ],
      "source_sentence_hash": "c836b90baaa6fb21a0d419d6efce62a3dfc5eb1338d993fceb4bcaeb600a5db3",
      "word_count": 8
    },
    {
      "text": "List modifier keys in the correct order",
      "section_path": [
        "Keyboards",
        "Custom keyboard shortcuts"
      ],
      "source_sentence_hash": "83f87fbd357026fe2e87d1cd9cef4479c9ccc50981a27556c3a44c2c5ecabadb",
      "word_count": 7
    },
    {
      "text": "Avoid adding Shift to a shortcut that uses the upper character of a two-character key",
      "section_path": [
        "Keyboards",
        "Custom keyboard shortcuts"
      ],
      "source_sentence_hash": "1a9b947b8360a8c2b8bb3bb12112f9cb2ca18e68f69a47ae5dbffb63f222f289",
      "word_count": 15
    },
    {
      "text": "Let the system localize and mirror your keyboard shortcuts as needed",
      "section_path": [
        "Keyboards",
        "Custom keyboard shortcuts"
      ],
      "source_sentence_hash": "0091b1f331cbb0845afeb0c0087fd685e06c59f11300c60fbf0e3cf2f14d4b85",
      "word_count": 11
    },
    {
      "text": "Avoid creating a new shortcut by adding a modifier to an existing shortcut for an unrelated command",
      "section_path": [
        "Keyboards",
        "Custom keyboard shortcuts"
      ],
      "source_sentence_hash": "97bfc313a58ee50fae241013f7c7b1abcdedd68dcd358dfae2620333eb9c6e94",
      "word_count": 17
    },
    {
      "text": "Write descriptive shortcut titles",
      "section_path": [
        "Keyboards",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "d64fc25159a680c5e9283b8806bcdee174d0aa5ae806fbe1384a83c48ccde7da",
      "word_count": 4
    },
    {
      "text": "Recognize that people see an overlay when they use a physical keyboard with your visionOS app or game",
      "section_path": [
        "Keyboards",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "113db44262ecd86f27cb064e5020d93cbb7785de45516cc4a744413f7e7add4f",
      "word_count": 18
    },
