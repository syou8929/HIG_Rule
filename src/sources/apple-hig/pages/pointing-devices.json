  "guidance_candidates": [
    {
      "text": "Be consistent when responding to mouse and trackpad gestures",
      "section_path": [
        "Pointing devices",
        "Best practices"
      ],
      "source_sentence_hash": "5bbfa883ed266990504948a1b2bb4f29ab8a585528618e727c2b8c21c8241657",
      "word_count": 9
    },
    {
      "text": "Avoid redefining systemwide trackpad gestures",
      "section_path": [
        "Pointing devices",
        "Best practices"
      ],
      "source_sentence_hash": "70a8161f7bcffa01fd969e40ad52615194d78bf41b536c924f481ad3cddf045d",
      "word_count": 5
    },
    {
      "text": "Provide a consistent experience in your app, whether people are using gestures, eyes, a pointing device, or a keyboard",
      "section_path": [
        "Pointing devices",
        "Best practices"
      ],
      "source_sentence_hash": "8ab21ac8f527037ee383063b987b959f8c5edbb94d315c3fcdaa1c260fa2b2c6",
      "word_count": 19
    },
    {
      "text": "Let people use the pointer to reveal and hide controls that automatically minimize or fade out",
      "section_path": [
        "Pointing devices",
        "Best practices"
      ],
      "source_sentence_hash": "605ffdea7fde5988f656b32ce5024ca4399aee94c0e6bde2e97a4c06309e76db",
      "word_count": 16
    },
    {
      "text": "Provide a consistent experience when people press and hold a modifier key while interacting with objects in your app",
      "section_path": [
        "Pointing devices",
        "Best practices"
      ],
      "source_sentence_hash": "54c4c59722035279dbca13009c1771920523cab0346bcde85ab9ee222f0b8011",
      "word_count": 19
    },
    {
      "text": "Allow multiple selection in custom views when necessary",
      "section_path": [
        "Pointing devices",
        "Platform considerations",
        "iPadOS"
      ],
      "source_sentence_hash": "ba06401793a2b2cbe25cd238d25f855b5edebf99f2598b48f12d35dc8e0ea4b4",
      "word_count": 8
    },
    {
      "text": "Distinguish between pointer and finger input only if it provides value",
      "section_path": [
        "Pointing devices",
        "Platform considerations",
        "iPadOS"
      ],
      "source_sentence_hash": "60a6a3e195b8b082f859e2f06a5c9d4faa146d8f6322d0c30a398c80a2199321",
      "word_count": 11
    },
    {
      "text": "Pointer shape and content effects",
      "section_path": [
