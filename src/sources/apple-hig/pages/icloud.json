  "guidance_candidates": [
    {
      "text": "Make it easy to use your app with iCloud",
      "section_path": [
        "iCloud",
        "Best practices"
      ],
      "source_sentence_hash": "7c36e6bdba6085405ace50aca5de339d9c3c505d926436d1286ae42a8fbf393e",
      "word_count": 9
    },
    {
      "text": "Avoid asking which documents to keep in iCloud",
      "section_path": [
        "iCloud",
        "Best practices"
      ],
      "source_sentence_hash": "1d54354274a322611d7d68cdfa562ee8b4046d0723cab763029252c0111027e1",
      "word_count": 8
    },
    {
      "text": "Keep content up to date when possible",
      "section_path": [
        "iCloud",
        "Best practices"
      ],
      "source_sentence_hash": "b0e20efead465867c86b0da3d168b871febab424328c9fadc659b242e77ddc64",
      "word_count": 7
    },
    {
      "text": "Respect iCloud storage space",
      "section_path": [
        "iCloud",
        "Best practices"
      ],
      "source_sentence_hash": "00d601a7850d02d491ae768b995e70aa262020b4e21c6b8829c0aed359842b17",
      "word_count": 4
    },
    {
      "text": "Make sure your app behaves appropriately when iCloud is unavailable",
      "section_path": [
        "iCloud",
        "Best practices"
      ],
      "source_sentence_hash": "2dfc32d96dea3a9aade2b2cf1bea6c64714c4475b44066fec245339f1f797718",
      "word_count": 10
    },
    {
      "text": "Keep app state information in iCloud",
      "section_path": [
        "iCloud",
        "Best practices"
      ],
      "source_sentence_hash": "9ed7dab2a337b878d1a1eb5000b88d71cc39966db040b74b4a934f3872171943",
      "word_count": 6
    },
    {
      "text": "Warn about the consequences of deleting a document",
      "section_path": [
        "iCloud",
        "Best practices"
      ],
      "source_sentence_hash": "e44f69267545cdab2bd59cef494a1988f055f77920110314576d5a4a84f268b1",
      "word_count": 8
    },
    {
      "text": "Make conflict resolution prompt and easy",
      "section_path": [
        "iCloud",
        "Best practices"
      ],
      "source_sentence_hash": "f461540162ebf5230cef6b32f3dd499f3c136bcf0f4bd5696125b0d1e13ce2c4",
      "word_count": 6
    },
    {
      "text": "Include iCloud content in search results",
      "section_path": [
        "iCloud",
        "Best practices"
      ],
      "source_sentence_hash": "19c36c06c8ea44a10e60e79ed784610769616e8f7ac76a5e6a2149d4d387a311",
      "word_count": 6
    },
    {
      "text": "For games, consider saving player progress in iCloud",
      "section_path": [
        "iCloud",
        "Best practices"
      ],
      "source_sentence_hash": "df56cb484db0299f8c985c9a81f88d5c4432b1a924799c932de4919e7e8d2f1a",
      "word_count": 8
    },
    {
      "text": "show a simple option the first time your app opens",
      "section_path": [
        "iCloud",
        "Best practices"
      ],
      "source_sentence_hash": "1a5bd1f202317adb77bc825fd11e114cf34fe9b9ad732dfcc32199d597327267",
      "word_count": 10
    },
    {
      "text": "Consider how your app handles and exposes content",
      "section_path": [
        "iCloud",
        "Best practices"
      ],
      "source_sentence_hash": "291307e7f4ea8327cb1a1cf90e42ab4103acbdd4bd343f60da3e71cfa8fd5181",
      "word_count": 8
    },
    {
      "text": "try to perform more file-management tasks automatically",
      "section_path": [
        "iCloud",
        "Best practices"
      ],
      "source_sentence_hash": "228e052a44f611d69d2f4f25e512b5fab7404c0eae9cc0e810a647bd6bd575d0",
      "word_count": 7
    },
    {
      "text": "you need to balance this experience with respect to device storage and bandwidth constraints",
      "section_path": [
        "iCloud",
        "Best practices"
      ],
      "source_sentence_hash": "a5852a421113728080d0c4bdf50abbc49c76bcece3e5959a56bf243949b80650",
      "word_count": 14
    },
    {
      "text": "let people control when updated content is downloaded",
      "section_path": [
        "iCloud",
        "Best practices"
      ],
      "source_sentence_hash": "4b3094ff0839538699a28dbeb25c0ab5eb233f50ca6e4e7b13e9b08fce123d1b",
      "word_count": 8
    },
    {
      "text": "design a way to indicate that a more recent version of a document is available in iCloud",
      "section_path": [
        "iCloud",
        "Best practices"
      ],
      "source_sentence_hash": "a1c45d4cb32d3ea4b1c519668c9bd67fdfe4a0da139dacf01c72dddaec6f5ab4",
      "word_count": 17
    },
    {
      "text": "provide subtle feedback if the download takes more than a few seconds",
      "section_path": [
        "iCloud",
        "Best practices"
      ],
      "source_sentence_hash": "b2995597c112da83a1dbf857a648682381bfee9fc5d772621c7aa669b69ef43b",
      "word_count": 12
    },
    {
      "text": "Use iCloud to store information people create and understand",
      "section_path": [
        "iCloud",
        "Best practices"
      ],
      "source_sentence_hash": "512e9ae493ebbe99d050cc1e7d0d0ff840c143f804d870f8fc3039bdbed39fc9",
      "word_count": 9
    },
    {
      "text": "avoid using it for app resources or content you can regenerate",
      "section_path": [
        "iCloud",
        "Best practices"
      ],
      "source_sentence_hash": "b14366b469bb5e0bc0d55e7442335f2ce09c095ef41d704ca6504f647e7b7db4",
      "word_count": 11
    },
    {
      "text": "be picky about the content you place in the Documents folder",
      "section_path": [
        "iCloud",
        "Best practices"
      ],
      "source_sentence_hash": "4646fc4549add27fee45d013b6be8db962b79ddcecc30e0ec9b05f0ce641f269",
      "word_count": 11
    },
    {
      "text": "let people know that changes they make won’t be available on other devices",
      "section_path": [
        "iCloud",
        "Best practices"
      ],
      "source_sentence_hash": "234f9feb5d5c366ec4467af9eb409eeae606cd216e6f60ecdb0345bbd8f5456c",
      "word_count": 13
    },
    {
      "text": "make sure it’s for ones people want applied to all of their devices",
      "section_path": [
        "iCloud",
        "Best practices"
      ],
      "source_sentence_hash": "2677337c049ed8cf69fe834b4d8d6868635ae4baa9356056272c8af48e5b69c6",
      "word_count": 13
    },
    {
      "text": "ask for confirmation before performing the deletion",
      "section_path": [
        "iCloud",
        "Best practices"
      ],
      "source_sentence_hash": "1cf72e685cc2e0116985ec01a3422719e243d7128902b61a39985e9740170f76",
      "word_count": 7
    },
    {
      "text": "try to detect and resolve version conflicts automatically",
      "section_path": [
        "iCloud",
        "Best practices"
      ],
      "source_sentence_hash": "6fd57adcf1a1aca62b7cd3d4f0f62736deca71f49f41d94803e2079cd5eda8dc",
      "word_count": 8
    },
    {
      "text": "display an unobtrusive notification that makes it easy to differentiate and choose between the conflicting versions",
      "section_path": [
        "iCloud",
        "Best practices"
      ],
      "source_sentence_hash": "fa6c84bf31347630dfc39d8868e04ab80b64cab55c73e14233ea6f93d07ce3bd",
      "word_count": 16
    },
