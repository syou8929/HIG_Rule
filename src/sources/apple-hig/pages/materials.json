  "guidance_candidates": [
    {
      "text": "Don’t use Liquid Glass in the content layer",
      "section_path": [
        "Materials",
        "Liquid Glass"
      ],
      "source_sentence_hash": "b1f3fe05044e5629e4f67f242464307af194ba57ce29c91922a045e0cb3f6f6a",
      "word_count": 8
    },
    {
      "text": "Use Liquid Glass effects sparingly",
      "section_path": [
        "Materials",
        "Liquid Glass"
      ],
      "source_sentence_hash": "6994789e5108fd5605477f13cda096d06cf69c91fbcca84e0a085700e791afa2",
      "word_count": 5
    },
    {
      "text": "Use clear Liquid Glass only for components over visually rich backgrounds",
      "section_path": [
        "Materials",
        "Liquid Glass"
      ],
      "source_sentence_hash": "d1141d4efd0454cd344a740a5713824ecefe8aa2ae075a87f43194acab753695",
      "word_count": 11
    },
    {
      "text": "Use regular Liquid Glass when backgrounds threaten legibility or components contain significant text",
      "section_path": [
        "Materials",
        "Liquid Glass"
      ],
      "source_sentence_hash": "a1237ddab5ffa7dca55e24e2d45cf733c96a10c9dffe2082fe372d3b8fa4509b",
      "word_count": 13
    },
    {
      "text": "Determine whether clear Liquid Glass needs a dimming layer for contrast and legibility",
      "section_path": [
        "Materials",
        "Liquid Glass"
      ],
      "source_sentence_hash": "3c04a59bfa3c58a2b67bad56ff142ba1ae1cade601dc31cd4fb1497af956ab12",
      "word_count": 13
    },
    {
      "text": "If underlying content is bright, consider a dark dimming layer with 35% opacity",
      "section_path": [
        "Materials",
        "Liquid Glass"
      ],
      "source_sentence_hash": "5fd24afcdb3a45148f48e94f6dcc31971739abd9f58b4846f8ab992fef4b8543",
      "word_count": 14
    },
    {
      "text": "If content is dark or AVKit controls provide dimming, you don’t need another dimming layer",
      "section_path": [
        "Materials",
        "Liquid Glass"
      ],
      "source_sentence_hash": "5a2ada26f59fd2a7a57684340fb3ae7039eba1bb32b49eb225989041edbd6add",
      "word_count": 15
    },
    {
      "text": "Use standard materials and effects to convey structure in the content layer",
      "section_path": [
        "Materials",
        "Standard materials"
      ],
      "source_sentence_hash": "cd156e0d8770beedf818df35ed0d7628d9763337395d099a9ed17984639ff347",
      "word_count": 12
    },
    {
      "text": "Choose materials and effects based on semantic meaning and recommended usage",
      "section_path": [
        "Materials",
        "Standard materials"
      ],
      "source_sentence_hash": "a8401f43dffac470ec8c34e3cfc819dc5d7842dd518ec10236faf4cb1cc21252",
      "word_count": 11
    },
    {
      "text": "Avoid selecting materials or effects by their apparent color",
      "section_path": [
        "Materials",
        "Standard materials"
      ],
      "source_sentence_hash": "a8401f43dffac470ec8c34e3cfc819dc5d7842dd518ec10236faf4cb1cc21252",
      "word_count": 9
    },
    {
      "text": "Help ensure legibility by using vibrant colors on top of materials",
      "section_path": [
        "Materials",
        "Standard materials"
      ],
      "source_sentence_hash": "9a9773f0dec368f5021b352cefb470f157d570666c73d51619a8c19d7996187a",
      "word_count": 11
    },
    {
      "text": "Consider contrast and visual separation when choosing a material to combine with blur and vibrancy effects",
      "section_path": [
        "Materials",
        "Standard materials"
      ],
      "source_sentence_hash": "4692bd455cb5e25acadc7c8602123bfe94e29ac6102292b58d77e2b0304a23be",
      "word_count": 16
    },
    {
      "text": "Thicker materials can improve contrast for text and fine features",
      "section_path": [
        "Materials",
        "Standard materials"
      ],
      "source_sentence_hash": "ee91c5efe581e235d9cc2a3930ddaf9c251730322096db026f8aad5a2d16d8df",
      "word_count": 10
    },
    {
      "text": "Thinner materials can preserve context by revealing background content",
      "section_path": [
        "Materials",
        "Standard materials"
      ],
      "source_sentence_hash": "4649c0cc442fe7858af692549e90c06294ba48f10288be23938b3851b7f2ae18",
      "word_count": 9
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "Materials",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "UIVibrancyEffectStyle.label (default)",
      "section_path": [
        "Materials",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "27c0b51d8774001f795ec0613d94f72aa3051243e4a9faab42e8682ba56dc39d",
      "word_count": 2
    },
    {
      "text": "UIVibrancyEffectStyle.fill (default)",
      "section_path": [
        "Materials",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "b4c51b174a8432ecd230f293461e0275ac21546df4008b3fe1b5596bcf4c2047",
      "word_count": 2
    },
    {
      "text": "Choose when to allow vibrancy in custom views and controls",
      "section_path": [
        "Materials",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "5054d6c8f4208d4ef05c60d61ae93385683e4a9b4c6bf4928f301de4cc67da10",
      "word_count": 10
    },
    {
      "text": "Choose a background blending mode that complements your interface design",
      "section_path": [
        "Materials",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "3306285e69e2aac69e4cd419404237dd27785467c8448f9781195e33b54fcf8f",
      "word_count": 10
    },
    {
      "text": "Prefer translucency to opaque colors in windows",
      "section_path": [
        "Materials",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "dc96f37b86456881bdd2f1b707e1a54e969caff0ddff7ff39cf71d92bde3c36b",
      "word_count": 7
    },
    {
      "text": "If necessary, choose materials that help you create visual separations or indicate interactivity in your app",
      "section_path": [
        "Materials",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "4275c9da4ebed6fea090dd7e946e3602d260a88f4870efe5156c04a6e17bf7ec",
      "word_count": 16
    },
    {
      "text": "The thin material brings attention to interactive elements like buttons and selected items",
      "section_path": [
        "Materials",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "25f1cf68b8969403c71a19105f7c2037e3b49deced3a2866cf6a5c0d1fdc2c15",
      "word_count": 13
    },
    {
      "text": "The regular material can help you visually separate sections of your app, like a sidebar or a grouped table",
      "section_path": [
        "Materials",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "100518f454556b47bce294f9764d1f6b789441d1782ea6a6e2ae1ecd316b0c9e",
      "word_count": 19
    },
    {
      "text": "The thick material lets you create a dark element that remains visually distinct when it’s on top of an",
      "section_path": [
        "Materials",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "a88284429d62e7432e2eb5e55ebfe4767724023132632939ccb08d9adc1d7d28",
      "word_count": 19
    },
    {
      "text": "Use UIVibrancyEffectStyle.label for standard text",
      "section_path": [
        "Materials",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "7d483dac54ba138d27c035cdab6291cd5ebae53ce94ff0b704dd1d055518d92d",
      "word_count": 5
    },
    {
      "text": "Use UIVibrancyEffectStyle.secondaryLabel for descriptive text like footnotes and subtitles",
      "section_path": [
        "Materials",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "d682368a17ec39d01f51625f90d1f3910c6fb8d366d65151a918b42a9b919e28",
      "word_count": 9
    },
    {
      "text": "Use UIVibrancyEffectStyle.tertiaryLabel for inactive elements, and only when text doesn’t need high legibility",
      "section_path": [
        "Materials",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "232166349af1518f497635746c7761041087d07b63b8222589180ddb85d60244",
      "word_count": 13
    },
    {
      "text": "Use materials to provide context in a full-screen modal view",
      "section_path": [
        "Materials",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "cc8ef2eeffc6f81448c2e8c41f6d03c7203a6fbc50c41b32b790aa6873ec55e7",
      "word_count": 10
    },
    {
      "text": "Consider standard iOS and iPadOS materials for content-layer distinction",
      "section_path": [
        "Materials",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "5caf1ee2a03132b9cb78619f6eb755ff504d3dd5eed5d27033340827e7789029",
      "word_count": 9
    },
    {
      "text": "Use label, secondaryLabel, or tertiaryLabel vibrancy on any iOS or iPadOS material",
      "section_path": [
        "Materials",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "0e97be13636d612247fb5fe3b0331304d23480ca214f70d44450e595ef5d5104",
      "word_count": 12
    },
    {
      "text": "Avoid quaternaryLabel vibrancy on thin and ultraThin iOS or iPadOS materials",
      "section_path": [
        "Materials",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "f9fc4cc64e591b92b47aa537ff80fc5797dc691d0c6b685671a6c3b25ec3f97e",
      "word_count": 11
    },
    {
      "text": "Use fill, secondaryFill, or tertiaryFill vibrancy on any iOS or iPadOS material",
      "section_path": [
        "Materials",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "0e55ced26248adbdbc78a2e629b04e17a85a216026d947f36e8388924e28a32b",
      "word_count": 12
    },
    {
      "text": "Use default separator vibrancy on any iOS or iPadOS material",
      "section_path": [
        "Materials",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "0f65f0e5ef2828792642c510cbe7167e63420add354f93dacdb850296ca381b7",
      "word_count": 10
    },
    {
      "text": "Consider tvOS standard materials for documented view and color-scheme contexts",
      "section_path": [
        "Materials",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "20ca412120f6bd6a92e0d3482d02bd1d6f90da0e403174672d7859dac1a8bd18",
      "word_count": 10
    },
    {
      "text": "Choose system materials for custom visionOS components when necessary",
      "section_path": [
        "Materials",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "4275c9da4ebed6fea090dd7e946e3602d260a88f4870efe5156c04a6e17bf7ec",
      "word_count": 9
    },
    {
      "text": "Avoid removing or replacing default watchOS modal-sheet material backgrounds",
      "section_path": [
        "Materials",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "886d2f60278dddbf6d9ac084518a977cc7c1abc9a37a69a9346fdbada824914b",
      "word_count": 9
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Materials",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
