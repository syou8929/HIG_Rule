  "guidance_candidates": [
    {
      "text": "Use alerts sparingly",
      "section_path": [
        "Alerts",
        "Best practices"
      ],
      "source_sentence_hash": "901cefdb065f75eb2eb6d436a1f0641a7d2f2801496507ce0864e85aff671f75",
      "word_count": 3
    },
    {
      "text": "Avoid using an alert merely to provide information",
      "section_path": [
        "Alerts",
        "Best practices"
      ],
      "source_sentence_hash": "6891b165371cafd786fd87cb174dec8e1aac983e405867ad9933949fe8aa1110",
      "word_count": 8
    },
    {
      "text": "Avoid displaying alerts for common, undoable actions, even when they’re destructive",
      "section_path": [
        "Alerts",
        "Best practices"
      ],
      "source_sentence_hash": "db51c08f53aa832234c769236f67fa482905b491e92ef0e8151cc7204d2e163d",
      "word_count": 11
    },
    {
      "text": "Avoid showing an alert when your app starts",
      "section_path": [
        "Alerts",
        "Best practices"
      ],
      "source_sentence_hash": "6266f6273d0b2f9a974948c5539431ec87cc336d9d52a4b7f152257a12e6ef9e",
      "word_count": 8
    },
    {
      "text": "In all alert copy, be direct, and use a neutral, approachable tone",
      "section_path": [
        "Alerts",
        "Content"
      ],
      "source_sentence_hash": "ce4805fe09c6e4ddb88924416459229424dd2c1a6bb1c44738d865064ab0194a",
      "word_count": 12
    },
    {
      "text": "Write a title that clearly and succinctly describes the situation",
      "section_path": [
        "Alerts",
        "Content"
      ],
      "source_sentence_hash": "1b50a9eb61edd7d8b5587ff0a2e192e489d28c52c10126b3194bee1730dca77f",
      "word_count": 10
    },
    {
      "text": "Include informative text only if it adds value",
      "section_path": [
        "Alerts",
        "Content"
      ],
      "source_sentence_hash": "8a9b0c91ee9733f43d887074b56e104e9dcc54ec51c089a25d31b4a10c6a3e5c",
      "word_count": 8
    },
    {
      "text": "Avoid explaining alert buttons",
      "section_path": [
        "Alerts",
        "Content"
      ],
      "source_sentence_hash": "0f10baf266e585f131b54ff2358a4fef60c2903f2f65ee24fe4c3fca3ca7108a",
      "word_count": 4
    },
    {
      "text": "If supported, include a text field only if you need people’s input to resolve the situation",
      "section_path": [
        "Alerts",
        "Content"
      ],
      "source_sentence_hash": "8855ec51d1c6304e8e39bc8761effe805ece6437916038fcc8394be1cf2432e5",
      "word_count": 16
    },
    {
      "text": "Create succinct, logical button titles",
      "section_path": [
        "Alerts",
        "Buttons"
      ],
      "source_sentence_hash": "53c8c0fce4b0ff271103edf6964b5a3fec49b8b42b9a1327f065ed45603e6507",
      "word_count": 5
    },
    {
      "text": "Avoid using OK as the default button title unless the alert is purely informational",
      "section_path": [
        "Alerts",
        "Buttons"
      ],
      "source_sentence_hash": "f502738b0b86a32ab114715ecb6a772a171a060a36620f5e7023f3878185c06c",
      "word_count": 14
    },
    {
      "text": "Place buttons where people expect",
      "section_path": [
        "Alerts",
        "Buttons"
      ],
      "source_sentence_hash": "a2589b684ae3296490e17e39b7f1bcc9269e52ba9765d3598a2265f97401b05a",
      "word_count": 5
    },
    {
      "text": "Use the destructive style to identify a button that performs a destructive action people didn’t deliberately choose",
      "section_path": [
        "Alerts",
        "Buttons"
      ],
      "source_sentence_hash": "d9065ac8fb5dc14832185cbe4ab96108c34ee698ebcd84a0d8848b77bb368d8d",
      "word_count": 17
    },
    {
      "text": "If there’s a destructive action, include a Cancel button to give people a clear, safe way to avoid the",
      "section_path": [
        "Alerts",
        "Buttons"
      ],
      "source_sentence_hash": "0f60ef7913706ce1f963926812c09c23077044fad9bf1e050999efb8fb14e6a3",
      "word_count": 19
    },
    {
      "text": "Provide alternative ways to cancel an alert when it makes sense",
      "section_path": [
        "Alerts",
        "Buttons"
      ],
      "source_sentence_hash": "6a332bc380e29ff3d87c6f236d4004a3103fbdb607e8e0249025ba8fc247d0e3",
      "word_count": 11
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "Alerts",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "Use an action sheet — not an alert — to offer choices related to an intentional action",
      "section_path": [
        "Alerts",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "e9753a1ca2a1623f203c33279ba3dd2d065d18f96dc17e8a61b7a1add0a2b945",
      "word_count": 17
    },
    {
      "text": "When possible, avoid displaying an alert that scrolls",
      "section_path": [
        "Alerts",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "e25ab85f3d4668b2f8af3a810e725404be1e7efa4e7ecaaa478a6e5f59b8d8d9",
      "word_count": 8
    },
    {
      "text": "Use a caution symbol sparingly",
      "section_path": [
        "Alerts",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "1269efbdfc3a24981a73783afc70424e803d07a72a8d3bef392d583a377abfb3",
      "word_count": 5
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Alerts",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
