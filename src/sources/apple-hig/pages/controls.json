  "guidance_candidates": [
    {
      "text": "In Control Center, a control displays its symbol and, at larger sizes, its title and value",
      "section_path": [
        "Controls",
        "Anatomy"
      ],
      "source_sentence_hash": "180d699998fad7492bca2f2f9d5dc77f46079bbf72e1927b800b11ea899e48f6",
      "word_count": 16
    },
    {
      "text": "On the Lock Screen, a control displays its symbol",
      "section_path": [
        "Controls",
        "Anatomy"
      ],
      "source_sentence_hash": "3b9df811588d515b55bfc05c75483bcbd6c1bc4c0a71e33d27bae8467ef259c1",
      "word_count": 9
    },
    {
      "text": "On iPhone devices with a control assigned to the Action button, pressing and holding it displays the control’s symbol",
      "section_path": [
        "Controls",
        "Anatomy"
      ],
      "source_sentence_hash": "569055c750f7ad729bf6ba8871533a2f3a3e912c337c53f123e3389e097572c4",
      "word_count": 19
    },
    {
      "text": "Offer controls for actions that provide the most benefit without having to launch your app",
      "section_path": [
        "Controls",
        "Best practices"
      ],
      "source_sentence_hash": "c1a913583150b5391eb105c81d7a2f1c496fcb8265937c33987616634eba4b1d",
      "word_count": 15
    },
    {
      "text": "Update controls when someone interacts with them, when an action completes, or remotely with a push notification",
      "section_path": [
        "Controls",
        "Best practices"
      ],
      "source_sentence_hash": "18ea4eaa1519e5715e3b65dbad419ec7ebe0e6bdfa5c7841312b57b5efcf5ef6",
      "word_count": 17
    },
    {
      "text": "Choose a descriptive symbol that suggests the behavior of the control",
      "section_path": [
        "Controls",
        "Best practices"
      ],
      "source_sentence_hash": "d43780f456ef32fd0ee5452ac7e5413c8c3d5faf2e0d62b11d57cd28e6d926ba",
      "word_count": 11
    },
    {
      "text": "Use symbol animations to highlight state changes",
      "section_path": [
        "Controls",
        "Best practices"
      ],
      "source_sentence_hash": "89313ad9fc88d5a3b131dec3e06af6667c90fb8adc40696b681f7ad14a2b311e",
      "word_count": 7
    },
    {
      "text": "Select a tint color that works with your app’s brand",
      "section_path": [
        "Controls",
        "Best practices"
      ],
      "source_sentence_hash": "1b6bd2100094434c39d90c6aa61056ab76a4712f128a9c9c9d7491f71a3cc56e",
      "word_count": 10
    },
    {
      "text": "Help people provide additional information the system needs to perform an action",
      "section_path": [
        "Controls",
        "Best practices"
      ],
      "source_sentence_hash": "79928483dafe065caa8bb13cb194fb7ea0c164c48ad9f00cc4c9cd894071192f",
      "word_count": 12
    },
    {
      "text": "Provide hint text for the Action button",
      "section_path": [
        "Controls",
        "Best practices"
      ],
      "source_sentence_hash": "00eb8283be1dda3305af16e382eb7e908d7c88b9bb0ad56b7a74ce7c90a12b94",
      "word_count": 7
    },
    {
      "text": "If your control title or value can vary, include a placeholder",
      "section_path": [
        "Controls",
        "Best practices"
      ],
      "source_sentence_hash": "d08d5873d968142bad0ea6451ff7aefee470efbac5858cbc572db1c76fb072ae",
      "word_count": 11
    },
    {
      "text": "Hide sensitive information when the device is locked",
      "section_path": [
        "Controls",
        "Best practices"
      ],
      "source_sentence_hash": "a1c5ec9e9f87acd387b2815c5af08238509d5e82bb5430be69a5dc33fca52008",
      "word_count": 8
    },
    {
      "text": "Require authentication for actions that affect security",
      "section_path": [
        "Controls",
        "Best practices"
      ],
      "source_sentence_hash": "5c64331662528e46beb9f27febf9f4bb4058ef13d76fbd4f38a06f3708408e1b",
      "word_count": 7
    },
    {
      "text": "Use the same camera UI in your app and your camera experience",
      "section_path": [
        "Controls",
        "Camera experiences on a locked device"
      ],
      "source_sentence_hash": "153324014b53c3f9486aead746c1156c92686a5e1106879ea2aaf9d7c82fbf97",
      "word_count": 12
    },
    {
      "text": "Provide instructions for adding the control",
      "section_path": [
        "Controls",
        "Camera experiences on a locked device"
      ],
      "source_sentence_hash": "34074374c2a791e5557aa3e72d1a7b034b6c140031dda1eda1703c658f1d5327",
      "word_count": 6
    },
