  "guidance_candidates": [
    {
      "text": "Provide a coherent privacy policy",
      "section_path": [
        "HealthKit",
        "Privacy protection"
      ],
      "source_sentence_hash": "307a245394ee048f64de0901d13f490956cbd96f13fe159dc6dfeb6e9da9d2ba",
      "word_count": 5
    },
    {
      "text": "Request access to health data only when you need it",
      "section_path": [
        "HealthKit",
        "Privacy protection"
      ],
      "source_sentence_hash": "c73024d184277c728343be48226135792b563fab9b517321f24ecceb18a3e901",
      "word_count": 10
    },
    {
      "text": "Clarify your app’s intent by adding descriptive messages to the standard permission screen",
      "section_path": [
        "HealthKit",
        "Privacy protection"
      ],
      "source_sentence_hash": "1fc4a6f4ef658d161947f37a8a646295282a91e6a4cd81957ee633b9f0ef7795",
      "word_count": 13
    },
    {
      "text": "Manage health data sharing solely through the system’s privacy settings",
      "section_path": [
        "HealthKit",
        "Privacy protection"
      ],
      "source_sentence_hash": "d2620355cf9443cdc41ebe06ce34a5284caed57e423677a009069e1620f5f520",
      "word_count": 10
    },
    {
      "text": "Use Activity rings for Move, Exercise, and Stand information only",
      "section_path": [
        "HealthKit",
        "Activity rings"
      ],
      "source_sentence_hash": "bb7ff0a1085db1cd3c4d9253cc966cf05fa0ec7c3283a6fc1ed8376243fe7353",
      "word_count": 10
    },
    {
      "text": "Use Activity rings to show progress for a single person",
      "section_path": [
        "HealthKit",
        "Activity rings"
      ],
      "source_sentence_hash": "4480a8bdcecec06ef5f746ba5b7d4199c4f714f9cbaec39518dce5980d8a38ed",
      "word_count": 10
    },
    {
      "text": "Don’t use Activity rings for ornamentation",
      "section_path": [
        "HealthKit",
        "Activity rings"
      ],
      "source_sentence_hash": "537147fc26d577c5e8c81746c8c661deeaf457210ca539e863a25aa896af37f9",
      "word_count": 6
    },
    {
      "text": "Don’t use Activity rings for branding",
      "section_path": [
        "HealthKit",
        "Activity rings"
      ],
      "source_sentence_hash": "58a9db2f5760fca0b4c6ea767fe24ad8d12e2799d6efa53989c56e1601a3e7e8",
      "word_count": 6
    },
    {
      "text": "Maintain Activity ring and background colors",
      "section_path": [
        "HealthKit",
        "Activity rings"
      ],
      "source_sentence_hash": "ed828aa752c0f1b66367741d05edecad7e81be51b010697f5e7ce04c85fb084b",
      "word_count": 6
    },
    {
      "text": "Maintain Activity ring margins",
      "section_path": [
        "HealthKit",
        "Activity rings"
      ],
      "source_sentence_hash": "f335242e9313be9bc26c7301c598ec8ff6f194604b8d13bcf6d2de2291168d90",
      "word_count": 4
    },
    {
      "text": "Differentiate other ring-like elements from Activity rings",
      "section_path": [
        "HealthKit",
        "Activity rings"
      ],
      "source_sentence_hash": "df60c9d602bd3284a3c9890c45c9d15b12c1b5dd92c8bfab90e69a7c898a7892",
      "word_count": 7
    },
    {
      "text": "Provide app-specific information only in Activity notifications",
      "section_path": [
        "HealthKit",
        "Activity rings"
      ],
      "source_sentence_hash": "f4395b9f0bee43ba260587b4341e081a2216c5a6de3c2eda16a85faf9574f7cb",
      "word_count": 7
    },
    {
      "text": "Use only the Apple-provided icon",
      "section_path": [
        "HealthKit",
        "Apple Health icon"
      ],
      "source_sentence_hash": "ff5bb452f153c742329122ed82cbc311a0258868bb5dcc07052311109edf5f43",
      "word_count": 5
    },
    {
      "text": "Display the name Apple Health close to the Apple Health icon",
      "section_path": [
        "HealthKit",
        "Apple Health icon"
      ],
      "source_sentence_hash": "c0b61b071ffcdfae112382763ea08f9a9ab84bdfacc6e4f7aeea1e9d027bf960",
      "word_count": 11
    },
    {
      "text": "Display the Apple Health icon consistently with other health-related app icons",
      "section_path": [
        "HealthKit",
        "Apple Health icon"
      ],
      "source_sentence_hash": "3349df1b40d747581f2049687344568ddf9baa13e2f96ea406ed1f3bbb68f12b",
      "word_count": 11
    },
    {
      "text": "Don’t use the Apple Health icon as a button",
      "section_path": [
        "HealthKit",
        "Apple Health icon"
      ],
      "source_sentence_hash": "a69f669030e9e5d9b81250d87812ffe64f6b0ebcb07ccbbdecd3d2f263e81083",
      "word_count": 9
    },
    {
      "text": "Don’t alter the appearance of the Apple Health icon",
      "section_path": [
        "HealthKit",
        "Apple Health icon"
      ],
      "source_sentence_hash": "da5d5fe082b32d2e1c52c4e97504007f73447ad9a20c2ec06ea8a372460761a4",
      "word_count": 9
    },
    {
      "text": "Maintain a minimum clear space around the Apple Health icon of 1/10 of its height",
      "section_path": [
        "HealthKit",
        "Apple Health icon"
      ],
      "source_sentence_hash": "632c0ed3de1e7d6d577d3b5c148ce29618f99fbfe112d869119c2d8a18b285fb",
      "word_count": 15
    },
    {
      "text": "Don’t use the Apple Health icon within text or as a replacement for the terms Health, Apple Health, or",
      "section_path": [
        "HealthKit",
        "Apple Health icon"
      ],
      "source_sentence_hash": "fd8a07102e9507f54320c074d869e4553fd6499c3f2d49fbd729237167976dab",
      "word_count": 19
    },
    {
      "text": "Don’t display Health app images or screenshots",
      "section_path": [
        "HealthKit",
        "Apple Health icon"
      ],
      "source_sentence_hash": "cd1cccd1b2c3f96063af1eebf05bd0ba51f9d24094a2cf5c78d0fb892488f119",
      "word_count": 7
    },
    {
      "text": "Refer to the Health app as Apple Health or the Apple Health app",
      "section_path": [
        "HealthKit",
        "Editorial guidelines"
      ],
      "source_sentence_hash": "038a7586382d8536bc0f3ee1d6e6ff061b04a6fbe64bcd0615d388f8f0f81da1",
      "word_count": 13
    },
    {
      "text": "Don’t use the term HealthKit",
      "section_path": [
        "HealthKit",
        "Editorial guidelines"
      ],
      "source_sentence_hash": "267e10405296c0df9201b836aeb43e42f34ed441112478d2fe92d554d3a8b1e6",
      "word_count": 5
    },
    {
      "text": "Use correct capitalization when using the term Apple Health",
      "section_path": [
        "HealthKit",
        "Editorial guidelines"
      ],
      "source_sentence_hash": "565ce9b1535bb261835e6bf63916b0821ed336e3cd9bf8cf1352e9488fada69d",
      "word_count": 9
    },
    {
      "text": "Use the system-provided translation of Health to avoid confusing people",
      "section_path": [
        "HealthKit",
        "Editorial guidelines"
      ],
      "source_sentence_hash": "5e34db0b063d3f83d07b1261b769e19b8083ff15a68dc687d515b1260a8db17f",
      "word_count": 10
    },
