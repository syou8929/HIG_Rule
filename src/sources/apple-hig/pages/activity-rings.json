  "guidance_candidates": [
    {
      "text": "Display Activity rings when they’re relevant to the purpose of your app",
      "section_path": [
        "Activity rings",
        "Best practices"
      ],
      "source_sentence_hash": "1b8e2584f66ebf44276f740768f01352b449c625a3fa0181c321470915da0626",
      "word_count": 12
    },
    {
      "text": "Use Activity rings only to show Move, Exercise, and Stand information",
      "section_path": [
        "Activity rings",
        "Best practices"
      ],
      "source_sentence_hash": "f8763f17146755ae6242dd1aed97eeaf28cefdeadced9c21ef529c38c61c130a",
      "word_count": 11
    },
    {
      "text": "Use Activity rings to show progress for a single person",
      "section_path": [
        "Activity rings",
        "Best practices"
      ],
      "source_sentence_hash": "4480a8bdcecec06ef5f746ba5b7d4199c4f714f9cbaec39518dce5980d8a38ed",
      "word_count": 10
    },
    {
      "text": "Always keep the visual appearance of Activity rings the same, regardless of where you display them",
      "section_path": [
        "Activity rings",
        "Best practices"
      ],
      "source_sentence_hash": "69c274c654c0e3d6d12db4801d68a1092a7914011c8654fd63e56d04c7211557",
      "word_count": 16
    },
    {
      "text": "Never change the colors of the rings; for example, don’t use filters or modify opacity",
      "section_path": [
        "Activity rings",
        "Best practices"
      ],
      "source_sentence_hash": "09b88d00b91a63a2e4ee4a02f664746fff94ee25d68ed72cbf5709fbbc90995e",
      "word_count": 15
    },
    {
      "text": "Always display Activity rings on a black background",
      "section_path": [
        "Activity rings",
        "Best practices"
      ],
      "source_sentence_hash": "4a15673441fb499b998cc1d3582e04d59f34014d76c9f16c9daadd3c504e598c",
      "word_count": 8
    },
    {
      "text": "Prefer enclosing the rings and background within a circle. To do this, adjust the corner radius of the enclosing",
      "section_path": [
        "Activity rings",
        "Best practices"
      ],
      "source_sentence_hash": "f2d0be365d9e13df4a96a0ff28d30d724f5b80a226d21771202eebe5072c5c4a",
      "word_count": 19
    },
    {
      "text": "Ensure that the black background remains visible around the outermost ring. If necessary, add a thin, black stroke around",
      "section_path": [
        "Activity rings",
        "Best practices"
      ],
      "source_sentence_hash": "fb7a728029c849c664b686db62cacf9132df1c824436e21368c136de9077f0cf",
      "word_count": 19
    },
    {
      "text": "Always scale the rings appropriately so they don’t seem disconnected or out of place",
      "section_path": [
        "Activity rings",
        "Best practices"
      ],
      "source_sentence_hash": "87057fac4102c9700a9cacfcd41139583d48d8c806661753f9316a9eab4a4df0",
      "word_count": 14
    },
    {
      "text": "When necessary, design the surrounding interface to blend with the rings; never change the rings to blend with the",
      "section_path": [
        "Activity rings",
        "Best practices"
      ],
      "source_sentence_hash": "24544f7e679c8e3650080e2dbdb760eb63fdfa98f7118c5450bb668fafe6a118",
      "word_count": 19
    },
    {
      "text": "To display a label or value that’s directly associated with an Activity ring, use the colors that match it",
      "section_path": [
        "Activity rings",
        "Best practices"
      ],
      "source_sentence_hash": "0305db1ececba50be188b0c600b258c93e4e69ea6c0ed18ce6ad13f9c1042d76",
      "word_count": 19
    },
    {
      "text": "Maintain Activity ring margins",
      "section_path": [
        "Activity rings",
        "Best practices"
      ],
      "source_sentence_hash": "f335242e9313be9bc26c7301c598ec8ff6f194604b8d13bcf6d2de2291168d90",
      "word_count": 4
    },
    {
      "text": "Differentiate other ring-like elements from Activity rings",
      "section_path": [
        "Activity rings",
        "Best practices"
      ],
      "source_sentence_hash": "df60c9d602bd3284a3c9890c45c9d15b12c1b5dd92c8bfab90e69a7c898a7892",
      "word_count": 7
    },
    {
      "text": "Don’t send notifications that repeat the same information the Activity app sends",
      "section_path": [
        "Activity rings",
        "Best practices"
      ],
      "source_sentence_hash": "bb0d834c4d1aea3ed8f99d93c6201de229c0786f92b60a61b3241fdae26da39d",
      "word_count": 12
    },
    {
      "text": "Don’t use Activity rings for decoration",
      "section_path": [
        "Activity rings",
        "Best practices"
      ],
      "source_sentence_hash": "d1685e867723c962f0465fd57d0ad64497edc70fa374d596ae3d9a94eefe69ef",
      "word_count": 6
    },
    {
      "text": "Don’t use Activity rings for branding",
      "section_path": [
        "Activity rings",
        "Best practices"
      ],
      "source_sentence_hash": "58a9db2f5760fca0b4c6ea767fe24ad8d12e2799d6efa53989c56e1601a3e7e8",
      "word_count": 6
    },
    {
      "text": "With an Apple Watch paired, iOS shows all three Activity rings",
      "section_path": [
        "Activity rings",
        "Platform considerations",
        "iOS"
      ],
      "source_sentence_hash": "0dccee521f7f82625871b3a9185db470002361c4d2ce09f2870d35c1d14c741e",
      "word_count": 11
    },
    {
      "text": "Without an Apple Watch paired, iOS shows the Move ring only, which represents an approximation of a person’s activity",
      "section_path": [
        "Activity rings",
        "Platform considerations",
        "iOS"
      ],
      "source_sentence_hash": "637e1d348777157e3d0469cc3e8d30735e7bd0703ea44b3a2540c3079cff618d",
      "word_count": 19
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Activity rings",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
