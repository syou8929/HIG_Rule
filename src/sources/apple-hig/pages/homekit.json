  "guidance_candidates": [
    {
      "text": "Help people set up, name, and organize their accessories",
      "section_path": [
        "HomeKit"
      ],
      "source_sentence_hash": "d7de795663faae86e4b87546daf6c5139402ebfc34c1e48ea6f7729b7c59fa91",
      "word_count": 9
    },
    {
      "text": "Allow fine-grained accessory configuration and control",
      "section_path": [
        "HomeKit"
      ],
      "source_sentence_hash": "3ae17e2bce9be9892bf5fb61121e0c8404b4189ab2fbbe554847e39985d8c95c",
      "word_count": 6
    },
    {
      "text": "Provide access to custom accessory features",
      "section_path": [
        "HomeKit"
      ],
      "source_sentence_hash": "76ef4e0e96a04df6d8d5dfdb80c64aa4e2139621f4977562cedb1709b6a73565",
      "word_count": 6
    },
    {
      "text": "Show people how to create powerful, hands-free automations",
      "section_path": [
        "HomeKit"
      ],
      "source_sentence_hash": "e9ac998e42828a50e428a8fa1cc44d0e130ded34736c8cfad31f945e748dc184",
      "word_count": 8
    },
    {
      "text": "Provide support",
      "section_path": [
        "HomeKit"
      ],
      "source_sentence_hash": "1239287c13cdc86fe36148c3bcd5fedb69a6c099d699d8c152e2f7894dbbe012",
      "word_count": 2
    },
    {
      "text": "Acknowledge the hierarchical model that HomeKit uses",
      "section_path": [
        "HomeKit",
        "Terminology and layout"
      ],
      "source_sentence_hash": "acc6a0763679a967f02147ab713fe50afe5bed0864f2e12558b91ee4b3261889",
      "word_count": 7
    },
    {
      "text": "Make it easy for people to find an accessory’s related HomeKit details",
      "section_path": [
        "HomeKit",
        "Terminology and layout"
      ],
      "source_sentence_hash": "94223e047ff18f7d843fbb0f91b37a815919ec6dfebbaed0784747dd7746011d",
      "word_count": 12
    },
    {
      "text": "Recognize that people can have more than one home",
      "section_path": [
        "HomeKit",
        "Terminology and layout"
      ],
      "source_sentence_hash": "0d1e414e2373fcd3f2a5448c731122c5082b7b61e36db2f89e03e152b891d594",
      "word_count": 9
    },
    {
      "text": "Don’t present duplicate home settings",
      "section_path": [
        "HomeKit",
        "Terminology and layout"
      ],
      "source_sentence_hash": "d2808df99d4df4bea450fac4e9889aacf224f57e9fcd768d2ae18b86a92f03f2",
      "word_count": 5
    },
    {
      "text": "Accessories, services, and characteristics",
      "section_path": [
        "HomeKit",
        "Terminology and layout",
        "Accessories, services, and characteristics"
      ],
      "source_sentence_hash": "913c4612bf76230487ac2f2d4a066ffd8cdc83b47e1fbf0a1b23555c2ba76bd5",
      "word_count": 4
    },
    {
      "text": "Actions and scenes",
      "section_path": [
        "HomeKit",
        "Terminology and layout",
        "Actions and scenes"
      ],
      "source_sentence_hash": "d05daf641b87ec6799f1d0357c5983246056a609f7b0443e4c47e8f46c179f3e",
      "word_count": 3
    },
    {
      "text": "Use the system-provided setup flow to give people a familiar experience",
      "section_path": [
        "HomeKit",
        "Setup"
      ],
      "source_sentence_hash": "b8cbd5c4743ebdc0f6f2557946588f6ea2c2eaae004f69ed7f85df6e51c876b5",
      "word_count": 11
    },
    {
      "text": "Provide context to explain why you need access to people’s Home data",
      "section_path": [
        "HomeKit",
        "Setup"
      ],
      "source_sentence_hash": "bed580755eba039d039d413317ce5440ae6e4d91c70326ec26d1631cce70ea20",
      "word_count": 12
    },
    {
      "text": "Don’t require people to create an account or supply personal information",
      "section_path": [
        "HomeKit",
        "Setup"
      ],
      "source_sentence_hash": "28426b7188940f49b0874fdd1c9866bf05b4c942bc54e5fa9f9323e7cde30bfa",
      "word_count": 11
    },
    {
      "text": "Honor people’s setup choices",
      "section_path": [
        "HomeKit",
        "Setup"
      ],
      "source_sentence_hash": "f02a1aea0ccdb6e8b4ebf723cc13ef18bec3490702051b69e5ceb092bf8c87d8",
      "word_count": 4
    },
    {
      "text": "Carefully consider how and when to provide a custom accessory setup experience",
      "section_path": [
        "HomeKit",
        "Setup"
      ],
      "source_sentence_hash": "f7fef3c34db44998692414a886937287ae31e45acbb0afc0383e1b27a86995ef",
      "word_count": 12
    },
    {
      "text": "Help people choose useful names",
      "section_path": [
        "HomeKit",
        "Setup",
        "Help people choose useful names"
      ],
      "source_sentence_hash": "dbfb1dee7f3eef5df211e895bf7472e9527c7fba18ca8550835863074d2788d6",
      "word_count": 5
    },
    {
      "text": "Suggest service names that suit your accessory",
      "section_path": [
        "HomeKit",
        "Setup",
        "Help people choose useful names"
      ],
      "source_sentence_hash": "1e6a867b5ab1b11c558cea1f551e3e8e5e606ace5060c87641a5dcc6afad6d6b",
      "word_count": 7
    },
    {
      "text": "Check that the names people provide follow HomeKit naming rules",
      "section_path": [
        "HomeKit",
        "Setup",
        "Help people choose useful names"
      ],
      "source_sentence_hash": "c91b71a1187a208ce9f3cb123757e1aeee75dd9807244a109439ffcca959f9db",
      "word_count": 10
    },
    {
      "text": "Use only alphanumeric, space, and apostrophe characters",
      "section_path": [
        "HomeKit",
        "Setup",
        "Help people choose useful names"
      ],
      "source_sentence_hash": "b0fb13beb23cdae82b25eb91d87fe984eb5137ad89fdad907cd6421760065fef",
      "word_count": 7
    },
    {
      "text": "Start and end with an alphabetic or numeric character",
      "section_path": [
        "HomeKit",
        "Setup",
        "Help people choose useful names"
      ],
      "source_sentence_hash": "d7edee21dbd13b885f597d9c54fdd63b2448190cfaa95d80095f82c86c25c3b9",
      "word_count": 9
    },
    {
      "text": "Don’t include emojis",
      "section_path": [
        "HomeKit",
        "Setup",
        "Help people choose useful names"
      ],
      "source_sentence_hash": "3067d1ba55d22a0890de221781b9bdcd022d3b4fcf869d2a0c27316fb7428e5d",
      "word_count": 3
    },
    {
      "text": "Help people avoid creating names that include location information",
      "section_path": [
        "HomeKit",
        "Setup",
        "Help people choose useful names"
      ],
      "source_sentence_hash": "48934816a40ba1edd900af616c9a127708eed8e62467ae434c0308db9cf8d818",
      "word_count": 9
    },
    {
      "text": "Present example voice commands to demonstrate using Siri to control accessories during setup",
      "section_path": [
        "HomeKit",
        "Siri interactions"
      ],
      "source_sentence_hash": "74dfccfeedd62ec2776bcf55f2d20f776e2b69c4fbf432fb24f5032717334eed",
      "word_count": 13
    },
    {
      "text": "After setup, consider teaching people about more complex Siri commands",
      "section_path": [
        "HomeKit",
        "Siri interactions"
      ],
      "source_sentence_hash": "784a5392ff740da30f53ff98ebd19a130734bf9ffa1252ff4e3594142249c420",
      "word_count": 10
    },
    {
      "text": "Recommend that people create zones and service groups, if they make sense for your accessory",
      "section_path": [
        "HomeKit",
        "Siri interactions"
      ],
      "source_sentence_hash": "4668b9236e9060a6c427c44e6dd3865a80aadac071f8b5de41796431584e4d05",
      "word_count": 15
    },
    {
      "text": "Offer shortcuts only for accessory-specific functionality that HomeKit doesn’t support",
      "section_path": [
        "HomeKit",
        "Siri interactions"
      ],
      "source_sentence_hash": "660e64e7d917f5c5e0d567b4e6c0f8659e979cd0cc0da3c633faf43a67070fb2",
      "word_count": 10
    },
    {
      "text": "If your app supports both HomeKit and shortcuts, help people understand the difference between these types of voice control",
      "section_path": [
        "HomeKit",
        "Siri interactions"
      ],
      "source_sentence_hash": "e1b0788c7fe9ffa4a122920a1a7d9f81f2071cd90cadca126c51b7167718b17c",
      "word_count": 19
    },
    {
      "text": "Be clear about what people can do in your app and when they might want to use the Home",
      "section_path": [
        "HomeKit",
        "Custom functionality"
      ],
      "source_sentence_hash": "c65fb071f65952a42857bdce28a090e8399f44f4155e7bfc634f5bcaba6f1722",
      "word_count": 19
    },
    {
      "text": "Defer to HomeKit if your database differs from the HomeKit database",
      "section_path": [
        "HomeKit",
        "Custom functionality"
      ],
      "source_sentence_hash": "4e2f6c7002cf81bdfcd8c95f4647b8ce4b4c42a9ecd852c31ab05917a40b66ca",
      "word_count": 11
    },
    {
      "text": "Ask permission to update the HomeKit database when people make changes in your app",
      "section_path": [
        "HomeKit",
        "Custom functionality"
      ],
      "source_sentence_hash": "13cc7a5fabac219a40842d3a4ce129494c18e215c79e90da8536611238cad697",
      "word_count": 14
    },
    {
      "text": "Don’t block camera images",
      "section_path": [
        "HomeKit",
        "Custom functionality",
        "Cameras"
      ],
      "source_sentence_hash": "cd6d81bcbbadd320e7c4fb9b762c82311427259eeab31b64c14207ff6b6bd926",
      "word_count": 4
    },
    {
      "text": "Show a microphone button only if the camera supports bidirectional audio",
      "section_path": [
        "HomeKit",
        "Custom functionality",
        "Cameras"
      ],
      "source_sentence_hash": "484bce964a3fef093eb3356c344fb097025e2342357d9f105fa1821ac69be1f8",
      "word_count": 11
    },
    {
      "text": "Use only Apple-provided icons",
      "section_path": [
        "HomeKit",
        "Using HomeKit icons"
      ],
      "source_sentence_hash": "6f4d8f002a910853c37d867981b1ed044a823a218a1bee74999ab29ce685d58d",
      "word_count": 4
    },
    {
      "text": "Black HomeKit icon",
      "section_path": [
        "HomeKit",
        "Using HomeKit icons",
        "Styles",
        "Black HomeKit icon"
      ],
      "source_sentence_hash": "cdb488f4b3247c0daa41720a7b5ee3bae44a156c63bb5b34ecd2ed78b2935505",
      "word_count": 3
    },
    {
      "text": "White HomeKit icon",
      "section_path": [
        "HomeKit",
        "Using HomeKit icons",
        "Styles",
        "White HomeKit icon"
      ],
      "source_sentence_hash": "836523bbf9f13958b0a3ac9d2573199ed6d76ba31984125ff3d49c316f4cf079",
      "word_count": 3
    },
    {
      "text": "Custom color HomeKit icon",
      "section_path": [
        "HomeKit",
        "Using HomeKit icons",
        "Styles",
        "Custom color HomeKit icon"
      ],
      "source_sentence_hash": "8d7f512a8d344e7168f2b725014af44346bac7231007d96474ecfce60ae7d058",
      "word_count": 4
    },
    {
      "text": "Position the HomeKit icon consistently with other technology icons",
      "section_path": [
        "HomeKit",
        "Using HomeKit icons",
        "Styles",
        "Custom color HomeKit icon"
      ],
      "source_sentence_hash": "3c70ca1cf087a94037fe97808fd846fb982ee22617ec28428b33a634b321157b",
      "word_count": 9
    },
    {
      "text": "Use the HomeKit icon noninteractively",
      "section_path": [
        "HomeKit",
        "Using HomeKit icons",
        "Styles",
        "Custom color HomeKit icon"
      ],
      "source_sentence_hash": "c7bbf1e5205fe2102b5907f5edc06d01062f17986626c6b53b8c5ed7991ea284",
      "word_count": 5
    },
    {
      "text": "Don’t use the HomeKit icon within text or as a replacement for the word HomeKit",
      "section_path": [
        "HomeKit",
        "Using HomeKit icons",
        "Styles",
        "Custom color HomeKit icon"
      ],
      "source_sentence_hash": "61d87f04f4903821f413d71ba8afa265c39df535d9d94697c7fd829789105039",
      "word_count": 15
    },
    {
      "text": "Pair the icon with the name HomeKit correctly",
      "section_path": [
        "HomeKit",
        "Using HomeKit icons",
        "Styles",
        "Custom color HomeKit icon"
      ],
      "source_sentence_hash": "dda0f8ba6b41db57a0bacb0b180901da10a0fba777cb9704dde4f64325a87fae",
      "word_count": 8
    },
    {
      "text": "Emphasize your app over HomeKit",
      "section_path": [
        "HomeKit",
        "Referring to HomeKit"
      ],
      "source_sentence_hash": "b95aea10ebb72ae96c56474d1e40f8d0f307a804efb1bece18e8b22efca6eb87",
      "word_count": 5
    },
    {
      "text": "Adhere to Apple’s trademark guidelines",
      "section_path": [
        "HomeKit",
        "Referring to HomeKit"
      ],
      "source_sentence_hash": "c71e99f06e3d1e564085664b4fc6229a306fae4594b545c305dfcf4c047ed551",
      "word_count": 5
    },
    {
      "text": "Use Apple product names in singular form only; do not make Apple product names possessive",
      "section_path": [
        "HomeKit",
        "Referring to HomeKit"
      ],
      "source_sentence_hash": "fa98b780f200921db7da83dc4f2a5459117ad4693721aa8bdae0206cd9226ead",
      "word_count": 15
    },
    {
      "text": "Don’t translate Apple, Apple Home, HomeKit, or any other Apple trademark",
      "section_path": [
        "HomeKit",
        "Referring to HomeKit"
      ],
      "source_sentence_hash": "d86f37e3d7bd642453de24cae652157a4b537f8177c4d1248fa6314437dd9ffd",
      "word_count": 11
    },
    {
      "text": "Don’t use category descriptors. For example, say iPad, not tablet",
      "section_path": [
        "HomeKit",
        "Referring to HomeKit"
      ],
      "source_sentence_hash": "47489bcaf56f8a09da9e8d45ba69b421066b226b4b86c2a0f8a8b48ac3512a2f",
      "word_count": 10
    },
    {
      "text": "Don’t indicate any kind of sponsorship, partnership, or endorsement from Apple",
      "section_path": [
        "HomeKit",
        "Referring to HomeKit"
      ],
      "source_sentence_hash": "4432828a59f87b06401e4e5a9741e72983364d9770791e871ced3f32c350e2f6",
      "word_count": 11
    },
    {
      "text": "Attribute Apple, HomeKit, and all other Apple trademarks with the correct credit lines wherever legal information appears within your",
      "section_path": [
        "HomeKit",
        "Referring to HomeKit"
      ],
      "source_sentence_hash": "3b556346a1039cc8a9e52871fa16aa29d6e4f98690fe05d9c42b19845ba133cb",
      "word_count": 19
    },
    {
      "text": "Refer to Apple devices and operating systems only in technical specifications or compatibility descriptions",
      "section_path": [
        "HomeKit",
        "Referring to HomeKit"
      ],
      "source_sentence_hash": "c3ca25b9757a29c5f383d5225d76036652ad121ee1d08889110d6ee46e521b1a",
      "word_count": 14
    },
    {
      "text": "Referencing HomeKit and the Home app",
      "section_path": [
        "HomeKit",
        "Referring to HomeKit",
        "Referencing HomeKit and the Home app"
      ],
      "source_sentence_hash": "545acd4eba3bcecfd679961db69c50e2ee3f153ccb24a2e2b442f48172bb253b",
      "word_count": 6
    },
    {
      "text": "Use correct capitalization when using the term HomeKit",
      "section_path": [
        "HomeKit",
        "Referring to HomeKit",
        "Referencing HomeKit and the Home app"
      ],
      "source_sentence_hash": "e28b34217f56e0cf0c6ca375fcf00c98c22a535144a5a8cca5a51154236774fb",
      "word_count": 8
    },
    {
      "text": "Don’t use the name HomeKit as a descriptor",
      "section_path": [
        "HomeKit",
        "Referring to HomeKit",
        "Referencing HomeKit and the Home app"
      ],
      "source_sentence_hash": "94970a2ee1f43cb1b42eae94139e32830d95be487c969de80a89d7eacd8dd184",
      "word_count": 8
    },
    {
      "text": "Don’t suggest that HomeKit is performing an action or function",
      "section_path": [
        "HomeKit",
        "Referring to HomeKit",
        "Referencing HomeKit and the Home app"
      ],
      "source_sentence_hash": "c0a4e63e17f8969df388ee4653316a37b2a1299991c9963a43769fac08e2e67c",
      "word_count": 10
    },
    {
      "text": "Use the name Apple with the name HomeKit, if desired",
      "section_path": [
        "HomeKit",
        "Referring to HomeKit",
        "Referencing HomeKit and the Home app"
      ],
      "source_sentence_hash": "365cb82ac69f3362aa62a55065e41efdb73e66f805e444a48fb85caf5ce8b9f7",
      "word_count": 10
    },
    {
      "text": "Use the name HomeKit for setup, configuration, and instructions, if desired",
      "section_path": [
        "HomeKit",
        "Referring to HomeKit",
        "Referencing HomeKit and the Home app"
      ],
      "source_sentence_hash": "ff09b4d2529463c227fbf1c2869c926374086d088577b9915000ef94b11016bb",
      "word_count": 11
    },
    {
      "text": "Use the app name Apple Home whenever referring specifically to the app",
      "section_path": [
        "HomeKit",
        "Referring to HomeKit",
        "Referencing HomeKit and the Home app"
      ],
      "source_sentence_hash": "617d194d956ff0aa43acf03fbc1e0698cf2c7a4ebcdc179d7d50ec229aa7a4ba",
      "word_count": 12
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "HomeKit",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
