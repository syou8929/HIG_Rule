  "guidance_candidates": [
    {
      "text": "Offer Apple Pay on all devices and browsers that support it",
      "section_path": [
        "Apple Pay",
        "Offering Apple Pay"
      ],
      "source_sentence_hash": "895e98fed45b215305817ad7249f9e207589df5da68aaab0af0a46aca2e80fb6",
      "word_count": 11
    },
    {
      "text": "Make Apple Pay the primary payment option when credentials are available",
      "section_path": [
        "Apple Pay",
        "Offering Apple Pay"
      ],
      "source_sentence_hash": "c96ed06a377abe2144d7e191905de014c941a33f7dce2e357c2218530227c15c",
      "word_count": 11
    },
    {
      "text": "Use Apple Pay buttons only to initiate payment or, when appropriate, the Apple Pay setup process",
      "section_path": [
        "Apple Pay",
        "Offering Apple Pay"
      ],
      "source_sentence_hash": "e96d1ccbd122b4b9e0c39d8e2a0a5dc4723585bbe5bef6510ecf71f807657d53",
      "word_count": 16
    },
    {
      "text": "If you use a custom button to start the Apple Pay payment process, make sure your custom button doesn’t",
      "section_path": [
        "Apple Pay",
        "Offering Apple Pay"
      ],
      "source_sentence_hash": "a8003030c857bf7cdc15f2958b9d68b79f54072cd1aee39963acef5b732b7eca",
      "word_count": 19
    },
    {
      "text": "Use the Apple Pay mark graphic only to communicate that you accept Apple Pay",
      "section_path": [
        "Apple Pay",
        "Offering Apple Pay"
      ],
      "source_sentence_hash": "d7f2738b53d1fb8f04cb9a48a3cf569c804ff557b4ae45a730247928f971f0d4",
      "word_count": 14
    },
    {
      "text": "Don’t hide an Apple Pay button or make it appear unavailable",
      "section_path": [
        "Apple Pay",
        "Offering Apple Pay"
      ],
      "source_sentence_hash": "956e6cdc43c823be2caed3187cc333047e4b57bce36a8c23fef08465a9eb9c25",
      "word_count": 11
    },
    {
      "text": "Inform search engines that Apple Pay is accepted on your website",
      "section_path": [
        "Apple Pay",
        "Offering Apple Pay"
      ],
      "source_sentence_hash": "cc0206d9dc88e86faeacd2c40f2a66bda3417d45f565a221c4729f9ec813763e",
      "word_count": 11
    },
    {
      "text": "Provide a cohesive checkout experience",
      "section_path": [
        "Apple Pay",
        "Streamlining checkout"
      ],
      "source_sentence_hash": "ee5156f63f4fd798a5882166638c4ec5b9164d880f0f7c351667234042150267",
      "word_count": 5
    },
    {
      "text": "If Apple Pay is available, assume people want to use it",
      "section_path": [
        "Apple Pay",
        "Streamlining checkout"
      ],
      "source_sentence_hash": "4fcf3e03a32b208a1acd9975ec372e76181b0827f9ddfc59347b5ce93d2884cf",
      "word_count": 11
    },
    {
      "text": "Accelerate single-item purchases with Apple Pay buttons on product detail pages",
      "section_path": [
        "Apple Pay",
        "Streamlining checkout"
      ],
      "source_sentence_hash": "005e493a887d48d937d2350f27396488b316ee01ac417350e57df749082ea544",
      "word_count": 11
    },
    {
      "text": "Accelerate multi-item purchases with express checkout",
      "section_path": [
        "Apple Pay",
        "Streamlining checkout"
      ],
      "source_sentence_hash": "0bd2bacec10f9700583f8cfa31b5ae372ec1b9a6b8dcb8efff4ab3c7d684664b",
      "word_count": 6
    },
    {
      "text": "Support coupons and promotional codes in the payment sheet",
      "section_path": [
        "Apple Pay",
        "Streamlining checkout"
      ],
      "source_sentence_hash": "f0cdb496d991d658b19c39f489d59ad094ca161f3cc26bad3b818f22c18956c9",
      "word_count": 9
    },
    {
      "text": "Collect necessary information, like color and size options, before people reach the Apple Pay button",
      "section_path": [
        "Apple Pay",
        "Streamlining checkout"
      ],
      "source_sentence_hash": "fc2faa43f79b64983f8160f199a91e13d7b58b12055263dd9687a99b9ced7436",
      "word_count": 15
    },
    {
      "text": "Collect optional information before checkout begins",
      "section_path": [
        "Apple Pay",
        "Streamlining checkout"
      ],
      "source_sentence_hash": "4676edd48680d1458c26fd5df556008465afdf8181b68233bdcd5800b7874a0a",
      "word_count": 6
    },
    {
      "text": "Gather multiple shipping methods and destinations before showing the payment sheet",
      "section_path": [
        "Apple Pay",
        "Streamlining checkout"
      ],
      "source_sentence_hash": "551f47eee256788a02a2fe81f95a1b43d027f26d221fb451b5c16c22618e04aa",
      "word_count": 11
    },
    {
      "text": "For in-store pickup, help people choose a pickup location before displaying the payment sheet",
      "section_path": [
        "Apple Pay",
        "Streamlining checkout"
      ],
      "source_sentence_hash": "14e101473b0c9e1071a33c48277015c7134414971f858d82d8332e567c22d6e9",
      "word_count": 14
    },
    {
      "text": "Prefer checkout information from Apple Pay",
      "section_path": [
        "Apple Pay",
        "Streamlining checkout"
      ],
      "source_sentence_hash": "307cd2aa06520ef3ac19e29d1c5caac2d065d8057cd2618ac8f37897ff199275",
      "word_count": 6
    },
    {
      "text": "Avoid requiring account creation before purchase",
      "section_path": [
        "Apple Pay",
        "Streamlining checkout"
      ],
      "source_sentence_hash": "b0ae4672407bba79a2aa17c6bcfbf952314c8c27784555bafde8c402f42aa7ee",
      "word_count": 6
    },
    {
      "text": "Report transaction results in the payment sheet",
      "section_path": [
        "Apple Pay",
        "Streamlining checkout"
      ],
      "source_sentence_hash": "110d572b6d72d5c65899d8aa4e0a1e9ac865fe3d5757eff0df372f3c89d006f7",
      "word_count": 7
    },
    {
      "text": "Display an order confirmation or thank-you page",
      "section_path": [
        "Apple Pay",
        "Streamlining checkout"
      ],
      "source_sentence_hash": "56906c711e68cd88960a21bc5ea9f7c7f6c77d87d0c4438f816d7b9b01c79163",
      "word_count": 7
    },
    {
      "text": "Customizing the payment sheet",
      "section_path": [
        "Apple Pay",
        "Streamlining checkout",
        "Customizing the payment sheet"
      ],
      "source_sentence_hash": "74a473ddd4961f14484bb6da8a05aa9fbd730a444b406c202988121ea866f7fb",
      "word_count": 4
    },
    {
      "text": "Only present and request essential information",
      "section_path": [
        "Apple Pay",
        "Streamlining checkout",
        "Customizing the payment sheet"
      ],
      "source_sentence_hash": "db1f4bf6971d9afa34e242a48dd1d04e84fd6393f48202885dfff03cec5bc5c8",
      "word_count": 6
    },
    {
      "text": "Display the active coupon or promotional code, or let people enter one",
      "section_path": [
        "Apple Pay",
        "Streamlining checkout",
        "Customizing the payment sheet"
      ],
      "source_sentence_hash": "0b007b0f03be9ce888417cce468223cd7353eeff101ddb1cde9b863098418a99",
      "word_count": 12
    },
    {
      "text": "Let people choose the shipping method in the payment sheet",
      "section_path": [
        "Apple Pay",
        "Streamlining checkout",
        "Customizing the payment sheet"
      ],
      "source_sentence_hash": "4d50cabf1ef1447cf636f07c759a3d256ac7129de6533cdbf1fccb7af13192f3",
      "word_count": 10
    },
    {
      "text": "For in-store pickup, consider letting people choose a pickup window that works for them",
      "section_path": [
        "Apple Pay",
        "Streamlining checkout",
        "Customizing the payment sheet"
      ],
      "source_sentence_hash": "b860855e3fdb3d0c920db113c2152df86236f675630da93ec72280efdaebd8e9",
      "word_count": 14
    },
    {
      "text": "Use line items to explain additional charges, discounts, pending costs, add-on donations, recurring payments, and future payments",
      "section_path": [
        "Apple Pay",
        "Streamlining checkout",
        "Customizing the payment sheet"
      ],
      "source_sentence_hash": "055bc190f6c3386621e8594e39d67e9118ab1bd2a0091169b1d73e1bdee3f85f",
      "word_count": 17
    },
    {
      "text": "Keep line items short",
      "section_path": [
        "Apple Pay",
        "Streamlining checkout",
        "Customizing the payment sheet"
      ],
      "source_sentence_hash": "05be8853177c1f09f33222776fdeafc591b0c28255bf235fc395e807900bff2f",
      "word_count": 4
    },
    {
      "text": "Provide a business name after the word Pay on the same line as the total",
      "section_path": [
        "Apple Pay",
        "Streamlining checkout",
        "Customizing the payment sheet"
      ],
      "source_sentence_hash": "221b009cd932581ad209953111b68d93dd8484cca72462de3fa77c6840efcde6",
      "word_count": 15
    },
    {
      "text": "If you’re not the end merchant, identify both businesses in the payment sheet",
      "section_path": [
        "Apple Pay",
        "Streamlining checkout",
        "Customizing the payment sheet"
      ],
      "source_sentence_hash": "9bc51df3ca1ba25f5c226fb3e84139f0e7e81cfdc4eed2f58f7c4ad6a968c173",
      "word_count": 13
    },
    {
      "text": "Clearly disclose when people may incur additional costs after payment authorization",
      "section_path": [
        "Apple Pay",
        "Streamlining checkout",
        "Customizing the payment sheet"
      ],
      "source_sentence_hash": "e1d0e42ec924130f6c52179a71ecc93de8d58e579b411371a5d8d84ab51b43d1",
      "word_count": 11
    },
    {
      "text": "Handle data entry and payment errors gracefully",
      "section_path": [
        "Apple Pay",
        "Streamlining checkout",
        "Customizing the payment sheet"
      ],
      "source_sentence_hash": "559c59b6ef061317ac1e5a98ff269ebd39814f9b2873473dc9cf875d9af48cff",
      "word_count": 7
    },
    {
      "text": "Defer to the payment sheet for progress information during payment",
      "section_path": [
        "Apple Pay",
        "Streamlining checkout",
        "Customizing the payment sheet"
      ],
      "source_sentence_hash": "1655c03b2c6c14db5f191cf5526e60b584582b37f5bbfa6d11a87c332ba2e12e",
      "word_count": 10
    },
    {
      "text": "Data validation errors",
      "section_path": [
        "Apple Pay",
        "Handling problems",
        "Data validation errors"
      ],
      "source_sentence_hash": "d74e8bc428eb334b664525144f2c1c91dad43bd7ab2aeab74196840187814f0f",
      "word_count": 3
    },
    {
      "text": "Avoid forcing compliance with your business logic",
      "section_path": [
        "Apple Pay",
        "Handling problems",
        "Data validation errors"
      ],
      "source_sentence_hash": "6d1fac1a0da0b9754c17074a18e49c7c42162778cfd16f3b32f9f544ab0ecf30",
      "word_count": 7
    },
    {
      "text": "Accurately report problems to the system",
      "section_path": [
        "Apple Pay",
        "Handling problems",
        "Data validation errors"
      ],
      "source_sentence_hash": "be35d326492325d1dd854ea1ef6e3d64d925607416d3069c3d84a3eb410e0f75",
      "word_count": 6
    },
    {
      "text": "Explain the problem clearly and succinctly when data is invalid or incorrectly formatted",
      "section_path": [
        "Apple Pay",
        "Handling problems",
        "Data validation errors"
      ],
      "source_sentence_hash": "c003a06be9c596e42bbd27876eb59dfca4db89f17e5165e4e902204bc9c22b24",
      "word_count": 13
    },
    {
      "text": "Payment processing problems",
      "section_path": [
        "Apple Pay",
        "Handling problems",
        "Payment processing problems"
      ],
      "source_sentence_hash": "5c2ca369d2b085f271bd64a152abc397c115cfa286229caa7659e442d85adab5",
      "word_count": 3
    },
    {
      "text": "Handle interruptions correctly",
      "section_path": [
        "Apple Pay",
        "Handling problems",
        "Payment processing problems"
      ],
      "source_sentence_hash": "7c8dd884635ae27667890c2c108a4037ae6067d907e7fd765821c1540795a5a2",
      "word_count": 3
    },
    {
      "text": "Clarify subscription details before showing the payment sheet",
      "section_path": [
        "Apple Pay",
        "Supporting subscriptions"
      ],
      "source_sentence_hash": "633fcd83705a72f2f311b64ae4a8d10596058128a215846e0f1cd382b4b0adf4",
      "word_count": 8
    },
    {
      "text": "Include line items that reiterate billing frequency, discounts, and additional upfront fees",
      "section_path": [
        "Apple Pay",
        "Supporting subscriptions"
      ],
      "source_sentence_hash": "3581b9a66af059bce0d6148be03172b35ac37f47ee308106745641d917e591fa",
      "word_count": 12
    },
    {
      "text": "Clearly communicate trial period terms",
      "section_path": [
        "Apple Pay",
        "Supporting subscriptions"
      ],
      "source_sentence_hash": "b582b7be3a044714d632ab475ccc501c4aff53d27ed5147309ddee13fabd6721",
      "word_count": 5
    },
    {
      "text": "Clarify the current payment amount in the total line",
      "section_path": [
        "Apple Pay",
        "Supporting subscriptions"
      ],
      "source_sentence_hash": "be8033fec2addc6de6575f77dc62f95a2e0168186a696fa7b849946d60166d74",
      "word_count": 9
    },
    {
      "text": "Only show the payment sheet when a subscription change results in additional fees",
      "section_path": [
        "Apple Pay",
        "Supporting subscriptions"
      ],
      "source_sentence_hash": "3eafdc747c6d08e166de1129d2ec60cb25e0e8d78ef51fa54f8d904fd4ed737b",
      "word_count": 13
    },
    {
      "text": "Use a line item to identify a donation",
      "section_path": [
        "Apple Pay",
        "Supporting donations"
      ],
      "source_sentence_hash": "e58c2b1e036b06ebbf94fccdf83b8b901c447be5ffffae3a4344982052d3dde7",
      "word_count": 8
    },
    {
      "text": "Streamline checkout by offering predefined donation amounts",
      "section_path": [
        "Apple Pay",
        "Supporting donations"
      ],
      "source_sentence_hash": "baa4f39c87687c7b6bc6e1111d51d755c491b1b472b814532153a2a760f8bb67",
      "word_count": 7
    },
    {
      "text": "Always use the Apple-provided API to display Apple Pay buttons",
      "section_path": [
        "Apple Pay",
        "Using Apple Pay buttons"
      ],
      "source_sentence_hash": "9cf91104b2f77988961c4a68a026e562c0180b254a4740ac32d9d3228db3d170",
      "word_count": 10
    },
    {
      "text": "Button types",
      "section_path": [
        "Apple Pay",
        "Using Apple Pay buttons",
        "Button types"
      ],
      "source_sentence_hash": "d35faad28e4e7368dda200eaa17dd1a196c1a1b1f0f16a8332a5c9bb9d0b4578",
      "word_count": 2
    },
    {
