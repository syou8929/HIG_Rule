      ],
      "source_sentence_hash": "5415fcb5b88a8742e88097f8fd2bc26c51851ac784907594c72dadae45abbc06",
      "word_count": 19
    },
    {
      "text": "When promoting Apple Pay in an app, follow App Store guidelines",
