      "source_sentence_hash": "f789fe656619f4dae578b417d781362ad24feba412e6114e5f9dd593b8d042f6",
      "word_count": 9
    },
    {
      "text": "In a payment selection context, you can display a text-only description of Apple Pay only when all payment options",
      "section_path": [
