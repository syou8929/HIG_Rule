    },
    {
      "text": "Never use the Apple logo to represent the name Apple in text",
      "section_path": [
        "Apple Pay",
        "Referring to Apple Pay"
      ],
      "source_sentence_hash": "74c38406a872797bf8821c5de344421ec8fa2fc7a875075d106b935f46fef2b7",
      "word_count": 12
    },
    {
      "text": "Coordinate the font face and size with your app or website",
      "section_path": [
