        "Using Apple Pay buttons",
        "Button types",
        "Apple Pay button"
      ],
      "source_sentence_hash": "b21f1db7ce0b51993a6f5adad3e8cdecd977fa9d05e429c4bdfdf99da2672fe9",
      "word_count": 3
    },
    {
      "text": "Set Up Apple Pay button",
      "section_path": [
        "Apple Pay",
        "Using Apple Pay buttons",
        "Button types",
        "Set Up Apple Pay button"
      ],
      "source_sentence_hash": "ea90888e30e4c06dbb9d7aa72805c92d1e37fcdad7547530d650ea6836d436af",
      "word_count": 5
    },
    {
      "text": "Button styles",
      "section_path": [
        "Apple Pay",
        "Using Apple Pay buttons",
        "Button styles"
      ],
      "source_sentence_hash": "2d22d98960d3aeb9267218207a14109ac7823196750f71444c749f89f87bddd2",
      "word_count": 2
    },
    {
      "text": "White with outline",
      "section_path": [
        "Apple Pay",
        "Using Apple Pay buttons",
        "Button styles",
        "White with outline"
      ],
      "source_sentence_hash": "fc6918e356cdbf8b4791c53276b8e430da1045d7b73b43ed733e7585a5c50391",
      "word_count": 3
    },
    {
      "text": "Button size and position",
      "section_path": [
        "Apple Pay",
        "Using Apple Pay buttons",
        "Button size and position"
      ],
      "source_sentence_hash": "444eef658eb71dd6d1cdfd878ab9807664bcaa9573e1aa439799ac4250cc1923",
      "word_count": 4
    },
    {
      "text": "Prominently display the Apple Pay button",
      "section_path": [
        "Apple Pay",
        "Using Apple Pay buttons",
        "Button size and position"
      ],
      "source_sentence_hash": "7cec7d23c8f1b771af765f9f4a9aa1c30cf88a2074d7fb61b4a963b924ba5fb8",
      "word_count": 6
    },
    {
      "text": "Position the Apple Pay button correctly in relation to an Add to Cart button",
      "section_path": [
        "Apple Pay",
        "Using Apple Pay buttons",
        "Button size and position"
      ],
      "source_sentence_hash": "2839c0fea3b8edbc964173299177031b7483d0b2952e236aa5fd27b1b6d6f9e0",
      "word_count": 14
    },
    {
      "text": "Adjust the corner radius to match the appearance of other buttons",
      "section_path": [
        "Apple Pay",
        "Using Apple Pay buttons",
        "Button size and position"
      ],
      "source_sentence_hash": "01dbf48eb68acca81843296104da0f479b3627503a0ed2a7cfaa81927ad7d645",
      "word_count": 11
    },
    {
      "text": "Maintain the minimum button size and margins around the button",
      "section_path": [
        "Apple Pay",
        "Using Apple Pay buttons",
        "Button size and position"
      ],
      "source_sentence_hash": "a33cf16e801502f86051f7cd5c04661ffcfade6d5f93a0a9cdf82a9078a60157",
      "word_count": 10
    },
    {
      "text": "Apple Pay mark",
      "section_path": [
        "Apple Pay",
        "Using Apple Pay buttons",
        "Apple Pay mark"
      ],
      "source_sentence_hash": "f2dc793db63e774e94aca31d55708d04d8ce21d5e379cafbdebb6e654d434c44",
      "word_count": 3
    },
    {
      "text": "Use only the artwork provided by Apple, with no alterations other than height",
      "section_path": [
        "Apple Pay",
        "Using Apple Pay buttons",
        "Apple Pay mark"
      ],
      "source_sentence_hash": "2c41baab052214c69dc6a21de107b12ce74d9a24898b742f2f468ea5360e7bd0",
      "word_count": 13
    },
    {
      "text": "Maintain a minimum clear space around the mark of 1/10 of its height",
      "section_path": [
        "Apple Pay",
        "Using Apple Pay buttons",
        "Apple Pay mark"
      ],
      "source_sentence_hash": "e18f082079abc9768d40b6917c6ae28766a5e2f2f77fa158e0fd791b53d5c0f2",
      "word_count": 13
    },
    {
      "text": "Capitalize Apple Pay in text as it appears in the Apple Trademark List",
      "section_path": [
        "Apple Pay",
        "Referring to Apple Pay"
      ],
