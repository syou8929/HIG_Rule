  "guidance_candidates": [
    {
      "text": "Use a text field to request a small amount of information, such as a name or an email address",
      "section_path": [
        "Text fields",
        "Best practices"
      ],
      "source_sentence_hash": "4646f22fa901dac85a2e23a670c0dab7920fbc7876add6d793487165526c7285",
      "word_count": 19
    },
    {
      "text": "Use a text view for larger amounts of text",
      "section_path": [
        "Text fields",
        "Best practices"
      ],
      "source_sentence_hash": "deb9950b0870354a8747f3d0a04752a879a8954b7ca0eca7cd836ef28aaa4592",
      "word_count": 9
    },
    {
      "text": "Show a hint in a text field to help communicate its purpose",
      "section_path": [
        "Text fields",
        "Best practices"
      ],
      "source_sentence_hash": "ec18a9f02db268f31773b98aa7c2fdf1b0caa95d3e4363930e9e85d306646cbb",
      "word_count": 12
    },
    {
      "text": "Consider a separate label because placeholder text disappears during input",
      "section_path": [
        "Text fields",
        "Best practices"
      ],
      "source_sentence_hash": "5917d4e0252c3afbc476e90f472c7e26af4d1b28f4715400d6a827b9df247c60",
      "word_count": 10
    },
    {
      "text": "Use secure text fields to hide private data",
      "section_path": [
        "Text fields",
        "Best practices"
      ],
      "source_sentence_hash": "973d57b1cce4119e637bb5a640c566c2cbb25550e5472fe386273200e77c3712",
      "word_count": 8
    },
    {
      "text": "Always use a secure text field for sensitive data",
      "section_path": [
        "Text fields",
        "Best practices"
      ],
      "source_sentence_hash": "283d0604d531fa959fd8611ce9f5f44d91d38b5dabfcd7740eb1a52994124420",
      "word_count": 9
    },
    {
      "text": "Match text-field size to anticipated text quantity when possible",
      "section_path": [
        "Text fields",
        "Best practices"
      ],
      "source_sentence_hash": "09c56948040bedc23e07588252f2bd3b5b50a365a954586ed0835582b1d74eb1",
      "word_count": 9
    },
    {
      "text": "Keep spacing between multiple text fields even",
      "section_path": [
        "Text fields",
        "Best practices"
      ],
      "source_sentence_hash": "3c71c0813402e780bf7d8ff643861ae567105da3a306c12f248d80c9f49cf9a1",
      "word_count": 7
    },
    {
      "text": "Place multiple text fields in a vertical stack when possible",
      "section_path": [
        "Text fields",
        "Best practices"
      ],
      "source_sentence_hash": "e0b59f667454f35e46ec32fe65aeb2490eedec196403312637a944e91a09dc04",
      "word_count": 10
    },
    {
      "text": "Use consistent widths for multiple text fields",
      "section_path": [
        "Text fields",
        "Best practices"
      ],
      "source_sentence_hash": "e0b59f667454f35e46ec32fe65aeb2490eedec196403312637a944e91a09dc04",
      "word_count": 7
    },
    {
      "text": "Ensure that tabbing between multiple fields flows as people expect",
      "section_path": [
        "Text fields",
        "Best practices"
      ],
      "source_sentence_hash": "52bb26f05b137d5a4bd756ee8a75128d26f0f7503db36287153d11ccf2ce3e15",
      "word_count": 10
    },
    {
      "text": "Use context-appropriate text-field validation",
      "section_path": [
        "Text fields",
        "Best practices"
      ],
      "source_sentence_hash": "e4496084ae5ca58bea70152e359a780e0a1e1dacaa382a4fce79f58471af09a1",
      "word_count": 4
    },
    {
      "text": "You need to alert people when a digits-only field contains other characters",
      "section_path": [
        "Text fields",
        "Best practices"
      ],
      "source_sentence_hash": "3d7d6da1fc881cfce934793666b097b95bdc43de01d1b1ac5bac7a3239eb1d31",
      "word_count": 12
    },
    {
      "text": "Use email validation when people switch to another field",
      "section_path": [
        "Text fields",
        "Best practices"
      ],
      "source_sentence_hash": "3d7d6da1fc881cfce934793666b097b95bdc43de01d1b1ac5bac7a3239eb1d31",
      "word_count": 9
    },
    {
      "text": "Ensure user-name or password validation happens before people leave the field",
      "section_path": [
        "Text fields",
        "Best practices"
      ],
      "source_sentence_hash": "3d7d6da1fc881cfce934793666b097b95bdc43de01d1b1ac5bac7a3239eb1d31",
      "word_count": 11
    },
    {
      "text": "Use a number formatter to help with numeric data",
      "section_path": [
        "Text fields",
        "Best practices"
      ],
      "source_sentence_hash": "5d6218c0a18c224558e67b70373eedcef558f28454a9c453710ae1876ef5f474",
      "word_count": 9
    },
    {
      "text": "Don't assume numeric presentation across people's locales",
      "section_path": [
        "Text fields",
        "Best practices"
      ],
      "source_sentence_hash": "d2951cbcaf4c4fb8530ee7a94188c58de20348d925fad8f0d9dee1d18af6e55f",
      "word_count": 7
    },
    {
      "text": "Choose line-break behavior according to the text field's needs",
      "section_path": [
        "Text fields",
        "Best practices"
      ],
      "source_sentence_hash": "834031f828c8b5a60515b61e92fd32deee6a8f66748314b0c70431bff55450b1",
      "word_count": 9
    },
    {
      "text": "Consider using an expansion tooltip to show the full version of clipped or truncated text",
      "section_path": [
        "Text fields",
        "Best practices"
      ],
      "source_sentence_hash": "9678f3ab11cdcd42a9c3754af72227e3d7a4b68b3f193d6270200f83b1ed974b",
      "word_count": 15
    },
    {
      "text": "Show the appropriate keyboard for iOS, iPadOS, tvOS, and visionOS input",
      "section_path": [
        "Text fields",
        "Best practices"
      ],
      "source_sentence_hash": "d27861a39b8a92c315030a846caf5bee31fe9a028fa9e13cd0377f8760f5c979",
      "word_count": 11
    },
    {
      "text": "Minimize text entry in your tvOS and watchOS apps",
      "section_path": [
        "Text fields",
        "Best practices"
      ],
      "source_sentence_hash": "07db499cd8cea9f2104d4b8070a383bce57eb1390051f0c22a6bd61c73b11c15",
      "word_count": 9
    },
    {
      "text": "Consider buttons to gather tvOS or watchOS information more efficiently",
      "section_path": [
        "Text fields",
        "Best practices"
      ],
      "source_sentence_hash": "6bb79b0a96f56b96eb7643186aeeca6600a8d36d75cd1f461f0f067783f9a57e",
      "word_count": 10
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "Text fields",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "Display a Clear button in the trailing end of a text field to help people erase their input",
      "section_path": [
        "Text fields",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "2fd38a209915ca6e0157eb88ad91daf943625020066846a8460daed327cb68f6",
      "word_count": 18
    },
    {
      "text": "Use images and buttons to provide clarity and functionality in text fields",
      "section_path": [
        "Text fields",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "320a39febeb095ab63db969fa019a931c3579167c1a3f7629fbdde2fa67c8e52",
      "word_count": 12
    },
    {
      "text": "Use the leading end of a text field to indicate purpose",
      "section_path": [
        "Text fields",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "3ff55dd86c853b34a5118f20e2b56befc614259a1b61f04697fcd41e029bfb78",
      "word_count": 11
    },
    {
      "text": "Use the trailing end of a text field for additional features",
      "section_path": [
        "Text fields",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "3ff55dd86c853b34a5118f20e2b56befc614259a1b61f04697fcd41e029bfb78",
      "word_count": 11
    },
    {
      "text": "Consider using a combo box if you need to pair text input with a list of choices",
      "section_path": [
        "Text fields",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "334e2d17408e72c190efe5b0974fc8aff505c4ad20ca4024f4a5d34539494f11",
      "word_count": 17
    },
    {
      "text": "Present a text field only when necessary",
      "section_path": [
        "Text fields",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "8bd6f3437010725e0b4887cc74502056f145c5140fd5a3245384dfa84f241166",
      "word_count": 7
    },
    {
      "text": "Prefer a list of options over watchOS text entry when possible",
      "section_path": [
        "Text fields",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "b1bdceaf96aefe774ba614d2f21bff34ba20c7853ef3e40b694162136c9817a3",
      "word_count": 11
    },
