  "guidance_candidates": [
    {
      "text": "Use system-defined CarPlay templates appropriate to app type",
      "section_path": [
        "CarPlay"
      ],
      "source_sentence_hash": "3222a3d38978e1a4598b0e8c23617d97a2a820f6506937a1cca63e9c08715266",
      "word_count": 8
    },
    {
      "text": "Keep CarPlay driving tasks quick and minimally interactive",
      "section_path": [
        "CarPlay"
      ],
      "source_sentence_hash": "f27ce930e2229e5addeeff32ffbcfd14ca79a5ced7b3f736479ab6c8b5398e4a",
      "word_count": 8
    },
    {
      "text": "Avoid requiring iPhone app interactions while CarPlay is active",
      "section_path": [
        "CarPlay",
        "iPhone interactions"
      ],
      "source_sentence_hash": "9423d18b92d889b098658853693b6b53779a94981cde8024b5dcc7df1b75ae3d",
      "word_count": 9
    },
    {
      "text": "Make sure required iPhone setup finishes before vehicle motion",
      "section_path": [
        "CarPlay",
        "iPhone interactions"
      ],
      "source_sentence_hash": "9b4e3d0a2409cdd09d4bea6062e724d8c5bc2a88db1754ceb81ebe5e62c44a89",
      "word_count": 9
    },
    {
      "text": "Never lock people out of CarPlay because the connected iPhone requires input",
      "section_path": [
        "CarPlay",
        "iPhone interactions"
      ],
      "source_sentence_hash": "2bf658bcedcfd0da72d93c5f3bf0f9c728ca3bcc72a6d075f19a649830ca6463",
      "word_count": 12
    },
    {
      "text": "Make sure your app works without requiring people to unlock iPhone",
      "section_path": [
        "CarPlay",
        "iPhone interactions"
      ],
      "source_sentence_hash": "2d1ed01d71fc51c8dc8ef5a1665198a61e65ca4183267bd1ca39df10012d25eb",
      "word_count": 11
    },
    {
      "text": "Let people choose when to start playback",
      "section_path": [
        "CarPlay",
        "iPhone interactions",
        "Audio"
      ],
      "source_sentence_hash": "4176f0c401e04512a307a87c14b31bcae863437c1b0589814a87242ded3075da",
      "word_count": 7
    },
    {
      "text": "Use immediate playback once CarPlay audio is sufficiently loaded",
      "section_path": [
        "CarPlay",
        "iPhone interactions",
        "Audio"
      ],
      "source_sentence_hash": "eb8b85f524202e98205d46466cd94c2e811b1abca33f557ca24aa4ce3204f3e4",
      "word_count": 9
    },
    {
      "text": "Display the Now Playing screen when audio is ready to play",
      "section_path": [
        "CarPlay",
        "iPhone interactions",
        "Audio"
      ],
      "source_sentence_hash": "0aa9e1cbc86131f6729b9a112e1eb694d392489bbc22bdcf78c45e5bfd4be150",
      "word_count": 11
    },
    {
      "text": "Use appropriate CarPlay audio resumption after an interruption",
      "section_path": [
        "CarPlay",
        "iPhone interactions",
        "Audio"
      ],
      "source_sentence_hash": "ddf8a0d23e87f712a7b4bfba578e053ea7be3764577b42b26b817bef5992275c",
      "word_count": 8
    },
    {
      "text": "Use relative CarPlay audio-level adjustments only when necessary",
      "section_path": [
        "CarPlay",
        "iPhone interactions",
        "Audio"
      ],
      "source_sentence_hash": "e6af2af9bd7fb785a85404c4ca9b61eff903158dd38107162fb23b8db16735ba",
      "word_count": 8
    },
    {
      "text": "Avoid starting a CarPlay audio session before audio is ready",
      "section_path": [
        "CarPlay",
        "iPhone interactions",
        "Audio"
      ],
      "source_sentence_hash": "23ded631efeae44ed583760e34df0adadf8c5b0d1f854777c11d963e3a7f23ee",
      "word_count": 10
    },
    {
      "text": "Avoid changing the overall CarPlay output volume",
      "section_path": [
        "CarPlay",
        "iPhone interactions",
        "Audio"
      ],
      "source_sentence_hash": "f87081c12048dce44bef6d84f29a4231e58038525b3565c91e64ad48c66615b4",
      "word_count": 7
    },
    {
      "text": "Provide useful, high-value information in a clean layout that’s easy to scan from the driver’s seat",
      "section_path": [
        "CarPlay",
        "Layout"
      ],
      "source_sentence_hash": "8caf304e30d8aae5ee150e8d003351523a149444bb04817ba33508f360aefa38",
      "word_count": 16
    },
    {
      "text": "Maintain an overall consistent appearance throughout your app",
      "section_path": [
        "CarPlay",
        "Layout"
      ],
      "source_sentence_hash": "2e0f525d0946c5711d5201a08d1716a7e7c9d98b06057ba8feb5f1dc36946683",
      "word_count": 8
    },
    {
      "text": "Ensure that primary content stands out and feels actionable",
      "section_path": [
        "CarPlay",
        "Layout"
      ],
      "source_sentence_hash": "2f822802341836c549d702e14baef1bbf35fe4dd74bd8d03e6ea466fcbeb93be",
      "word_count": 9
    },
    {
      "text": "Use a limited CarPlay color palette coordinated with the app logo",
      "section_path": [
        "CarPlay",
        "Color"
      ],
      "source_sentence_hash": "1c34668b408ebddabc5738ec4bdd370db7798cb088307e7defab24d4826a6057",
      "word_count": 11
    },
    {
      "text": "Avoid using the same color for interactive and noninteractive elements",
      "section_path": [
        "CarPlay",
        "Color"
      ],
      "source_sentence_hash": "45b183bed26b997e7437302642a8f38c5bfe48cc08510857bb8b70c97cdcbf9e",
      "word_count": 10
    },
    {
      "text": "Test your app’s color scheme under a variety of lighting conditions in an actual car",
      "section_path": [
        "CarPlay",
        "Color"
      ],
      "source_sentence_hash": "427df3405629e1c68b50409d342ded1924dd6d1bb689d9c5d1c6d99da455e123",
      "word_count": 15
    },
    {
      "text": "Ensure your app looks great in both dark and light environments",
      "section_path": [
        "CarPlay",
        "Color"
      ],
      "source_sentence_hash": "0316541efb542be26ae8dacce1a99a795b4713dcbf09dad678af152ed91bf9b9",
      "word_count": 11
    },
    {
      "text": "Choose colors that help you communicate effectively with everyone",
      "section_path": [
        "CarPlay",
        "Color"
      ],
      "source_sentence_hash": "092e686bb15eeaa8805a56c175c204483b34277c1b2f6e1546832f734c14d4e1",
      "word_count": 9
    },
    {
      "text": "Use @2x and @3x high-resolution images for all CarPlay artwork",
      "section_path": [
        "CarPlay",
        "Icons and images"
      ],
      "source_sentence_hash": "81876df7ab59d6320c569ae7f67ec65fe4ff0103bf903987e5fc5e219cf4adb8",
      "word_count": 10
    },
    {
      "text": "Use the iPhone app icon design in CarPlay",
      "section_path": [
        "CarPlay",
        "Icons and images"
      ],
      "source_sentence_hash": "5c842665e755029585fb410eba1377c82d35b112fb3e2d17aec0dcfbc9635ec7",
      "word_count": 8
    },
    {
      "text": "Don’t use black for your icon’s background",
      "section_path": [
        "CarPlay",
        "Icons and images"
      ],
      "source_sentence_hash": "313bd06f8c249eecb55c0a4311fed26187510308bcad73954c048a7eb4a374cf",
      "word_count": 7
    },
    {
      "text": "Show CarPlay errors on the vehicle display rather than iPhone",
      "section_path": [
        "CarPlay",
        "Error handling"
      ],
      "source_sentence_hash": "2e0fc63ff0e0aa5151794e37a97e46ab1f00d24b2060865c27d90ce6c59a0100",
      "word_count": 10
    },
    {
      "text": "Use graceful CarPlay error handling",
      "section_path": [
        "CarPlay",
        "Error handling"
      ],
      "source_sentence_hash": "e0fb4bfd0066acab0803f0d90ac21ce1dfbfb6fe51f63b5a8378c2723bceaacf",
      "word_count": 5
    },
    {
      "text": "Avoid reporting CarPlay errors unless absolutely necessary",
      "section_path": [
        "CarPlay",
        "Error handling"
      ],
      "source_sentence_hash": "e0fb4bfd0066acab0803f0d90ac21ce1dfbfb6fe51f63b5a8378c2723bceaacf",
      "word_count": 7
    },
    {
      "text": "Never direct people to use iPhone to read or resolve CarPlay errors",
      "section_path": [
        "CarPlay",
        "Error handling"
      ],
      "source_sentence_hash": "f90ba28bc9856966951dbb50ab6f92bf752204a5c7520931c70c674dc9765595",
      "word_count": 12
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "CarPlay",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
