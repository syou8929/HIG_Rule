  "guidance_candidates": [
    {
      "text": "Describe account benefits and signup steps",
      "section_path": [
        "Managing accounts",
        "Best practices"
      ],
      "source_sentence_hash": "cbe02ac1140186a26d6c95d67adeb97b3fccfd8afaf8b95685e9a8355beb8474",
      "word_count": 6
    },
    {
      "text": "Defer sign-in for as long as possible",
      "section_path": [
        "Managing accounts",
        "Best practices"
      ],
      "source_sentence_hash": "91a74a3c0aa9417e0f985eb939a16d6038970c5969437fc6e12197ca7b7c8011",
      "word_count": 7
    },
    {
      "text": "Prefer passkeys when Sign in with Apple is not used",
      "section_path": [
        "Managing accounts",
        "Best practices"
      ],
      "source_sentence_hash": "0bf66154459a083b8afcda1bd63002ead1101dada18af328d469077547409ce6",
      "word_count": 10
    },
    {
      "text": "Always identify the authentication method you offer",
      "section_path": [
        "Managing accounts",
        "Best practices"
      ],
      "source_sentence_hash": "23ada0f605e0d85e90202158c6b33d250852f299b2b59f0005b4a7b9ca557465",
      "word_count": 7
    },
    {
      "text": "Use only authentication methods available in the current context",
      "section_path": [
        "Managing accounts",
        "Best practices"
      ],
      "source_sentence_hash": "e5ad5330d1a98ec67cbae1dd3e1c4abbfcf41fb41b2bd3629e100d23c1b34223",
      "word_count": 9
    },
    {
      "text": "In general, avoid offering an app-specific setting for opting in to biometric authentication",
      "section_path": [
        "Managing accounts",
        "Best practices"
      ],
      "source_sentence_hash": "be38872d48c3abce8b984dca29ae4c9c9c951e747a5ee117fe3216538095405c",
      "word_count": 13
    },
    {
      "text": "Avoid using the term passcode to refer to account authentication",
      "section_path": [
        "Managing accounts",
        "Best practices"
      ],
      "source_sentence_hash": "c254680164579b6bb0a691ed1fdf6fe42972b54e6b47c15f18af4770f80c0cd2",
      "word_count": 10
    },
    {
      "text": "Provide a clear way to initiate account deletion within your app or game",
      "section_path": [
        "Managing accounts",
        "Deleting accounts"
      ],
      "source_sentence_hash": "2d09458373fb4265cd774e4ee667a9d69e95dede29979e561984efadfcb7990f",
      "word_count": 13
    },
    {
      "text": "Provide a consistent account-deletion experience whether people perform it within your app or game or on the website",
      "section_path": [
        "Managing accounts",
        "Deleting accounts"
      ],
      "source_sentence_hash": "9031b69b9b6637b9b0e2a98a1e4d96eedfdfed4dc326cee00ee568c8a201c9d4",
      "word_count": 18
    },
    {
      "text": "Consider letting people schedule account deletion to occur in the future",
      "section_path": [
        "Managing accounts",
        "Deleting accounts"
      ],
      "source_sentence_hash": "15d2a1a4a986634043d3e83fd27c6ea544fed82d843c9c7297b03418e5d94248",
      "word_count": 11
    },
    {
      "text": "Ensure people know when account deletion will complete",
      "section_path": [
        "Managing accounts",
        "Deleting accounts"
      ],
      "source_sentence_hash": "3e850b1b95da6f15509ab8e4f650e2519b43fc8a10b036903b92caef737b06a1",
      "word_count": 8
    },
    {
      "text": "Describe deletion-related billing and cancellation for in-app purchases",
      "section_path": [
        "Managing accounts",
        "Deleting accounts"
      ],
      "source_sentence_hash": "d5e86f6fd7de315660664ebd443d79cf7b5efdd8f6c7ca17db0d0b181d93dd3f",
      "word_count": 8
    },
    {
      "text": "Billing for an auto-renewable subscription continues through Apple until people cancel the subscription, regardless of whether they delete their",
      "section_path": [
        "Managing accounts",
        "Deleting accounts"
      ],
      "source_sentence_hash": "adc5677584112cceb23e4bd3be1bd32148d6a917135a8b413d889c43146ab360",
      "word_count": 19
    },
    {
      "text": "After they delete their account, people need to cancel their subscription or request a refund",
      "section_path": [
        "Managing accounts",
        "Deleting accounts"
      ],
      "source_sentence_hash": "e045770f2dc2d4967f3c5903acd497029f8e0c4cb6b4ea7e56c35d83b6bb5d27",
      "word_count": 15
    },
    {
      "text": "Avoid displaying a sign-out option when people are signed in at the system level",
      "section_path": [
        "Managing accounts",
        "TV provider accounts"
      ],
      "source_sentence_hash": "82e8c64abd336fc6480b541299a597a96643fedae4e491ffab7bd27b6f7fdd65",
      "word_count": 14
    },
    {
      "text": "Never instruct people to sign out by adjusting privacy controls",
      "section_path": [
        "Managing accounts",
        "TV provider accounts"
      ],
      "source_sentence_hash": "2c87575bb1e4dc0c418da4f94a5e7ebdb65dcbb7f0148660bcf109b202fdaa9c",
      "word_count": 10
    },
    {
      "text": "Prefer letting people use another device to sign up or authenticate",
      "section_path": [
        "Managing accounts",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "b8f510f31d55a6bd2e87659146a7f72d224bcfae79da98784f7ff14b99895c4a",
      "word_count": 11
    },
    {
      "text": "When people are signed in to a shared account, avoid asking them to choose their profile every time they",
      "section_path": [
        "Managing accounts",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "a16e30e35a1d3fe64ad5dd6457c255c833f9672fcb665a85d79e57433c2449bc",
      "word_count": 19
    },
    {
      "text": "Avoid repeated profile selection for shared tvOS accounts",
      "section_path": [
        "Managing accounts",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "a16e30e35a1d3fe64ad5dd6457c255c833f9672fcb665a85d79e57433c2449bc",
      "word_count": 8
    },
    {
      "text": "Consider sharing tvOS credentials while storing each user profile separately",
      "section_path": [
        "Managing accounts",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "a16e30e35a1d3fe64ad5dd6457c255c833f9672fcb665a85d79e57433c2449bc",
      "word_count": 10
    },
    {
      "text": "Consider automatically using the current tvOS user profile with shared credentials",
      "section_path": [
        "Managing accounts",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "a16e30e35a1d3fe64ad5dd6457c255c833f9672fcb665a85d79e57433c2449bc",
      "word_count": 11
    },
    {
      "text": "Minimize data entry",
      "section_path": [
        "Managing accounts",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "37654f1756eeadbd7a84058f3cde9b59af0de66b58c38352dd05124a764c21e8",
      "word_count": 3
    },
    {
      "text": "Use a website on another device for longer tvOS data entry",
      "section_path": [
        "Managing accounts",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "37654f1756eeadbd7a84058f3cde9b59af0de66b58c38352dd05124a764c21e8",
      "word_count": 11
    },
    {
      "text": "Show the email keyboard when requesting an email address",
      "section_path": [
        "Managing accounts",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "37654f1756eeadbd7a84058f3cde9b59af0de66b58c38352dd05124a764c21e8",
      "word_count": 9
    },
    {
      "text": "Require an account only when core functionality depends on it",
      "section_path": [
        "Managing accounts"
      ],
      "source_sentence_hash": "d316ddcd21cadcf4df5364a437b564a497bf154be82f4d14fb9b8347154dfbab",
      "word_count": 10
    },
    {
      "text": "Consider Sign in with Apple when an account is required",
      "section_path": [
        "Managing accounts"
      ],
      "source_sentence_hash": "d316ddcd21cadcf4df5364a437b564a497bf154be82f4d14fb9b8347154dfbab",
      "word_count": 10
    },
    {
      "text": "Use two-factor authentication when passwords remain necessary",
      "section_path": [
        "Managing accounts",
        "Best practices"
      ],
      "source_sentence_hash": "6e9af77449ba9a29f47239e6f69b2aac90d6a71a3ca4f2b1b29f4756186a130b",
      "word_count": 7
    },
    {
      "text": "Ensure people can delete accounts they create in the app or game",
      "section_path": [
        "Managing accounts",
        "Deleting accounts"
      ],
      "source_sentence_hash": "bddfff945748b942f38ca8f4b4f3109b4eb01e880c9edecdb985c4672732a76a",
      "word_count": 12
    },
    {
      "text": "Be sure to comply with regional account-deletion and right-to-be-forgotten requirements",
      "section_path": [
        "Managing accounts",
        "Deleting accounts"
      ],
      "source_sentence_hash": "bddfff945748b942f38ca8f4b4f3109b4eb01e880c9edecdb985c4672732a76a",
      "word_count": 10
    },
    {
      "text": "Describe legally required account retention or deletion processes clearly",
      "section_path": [
        "Managing accounts",
        "Deleting accounts"
      ],
      "source_sentence_hash": "842de43cedfa46b515ae263156f76b17131282493d6759931dc6f1fa9a193be5",
      "word_count": 9
    },
    {
      "text": "Ensure a direct account-deletion webpage link when in-app deletion is unavailable",
      "section_path": [
        "Managing accounts",
        "Deleting accounts"
      ],
      "source_sentence_hash": "812b9325bb38160719fc7bc4c34c3d9fdc328fdb164d1c1ab6338017df872c80",
      "word_count": 11
    },
    {
      "text": "Avoid burying account-deletion links in policy or terms pages",
      "section_path": [
        "Managing accounts",
        "Deleting accounts"
      ],
      "source_sentence_hash": "812b9325bb38160719fc7bc4c34c3d9fdc328fdb164d1c1ab6338017df872c80",
      "word_count": 9
    },
    {
      "text": "Use Sign in with Apple token revocation during account deletion",
      "section_path": [
        "Managing accounts",
        "Deleting accounts"
      ],
      "source_sentence_hash": "ef47e373e8836ebdc76ecaa6794db8071f519b8cdbfb212036f33a23c268f1ca",
      "word_count": 10
    },
    {
      "text": "Offer immediate deletion when scheduled deletion is available",
      "section_path": [
        "Managing accounts",
        "Deleting accounts"
      ],
      "source_sentence_hash": "bfb677116c1996450e603fff2624aa7c152c3dfd0b664f44bdca6134205a68f1",
      "word_count": 8
    },
    {
      "text": "Ensure people are notified when account deletion finishes",
      "section_path": [
        "Managing accounts",
        "Deleting accounts"
      ],
      "source_sentence_hash": "bdf64f29bff10a77401503bf60c6076fe44bd6db52c3804800d4bd8f4ceff627",
      "word_count": 8
    },
    {
      "text": "Describe how to cancel subscriptions and manage purchases during account deletion",
      "section_path": [
        "Managing accounts",
        "Deleting accounts"
      ],
      "source_sentence_hash": "d6091bc23575c74889e02d85429e28bafce20d230560b55a21e5067955a1021f",
      "word_count": 11
    },
    {
      "text": "Ensure account deletion remains available for externally purchased subscriptions",
      "section_path": [
        "Managing accounts",
        "Deleting accounts"
      ],
      "source_sentence_hash": "a64a7e38356fcfcacaac8d5f418401775c5ecf685a22ccf3f12bf28fd9cd7718",
      "word_count": 9
    },
    {
      "text": "Use TV Provider Authentication when a provider app requires sign-in",
      "section_path": [
        "Managing accounts",
        "TV provider accounts"
      ],
      "source_sentence_hash": "969a58d05a3e6b21237588f8454cb6154c2e9b5d9e15165769e814a2c6a4ed11",
      "word_count": 10
    },
    {
      "text": "Ensure TV-provider sign-out routes to Settings when the app exposes sign-out",
      "section_path": [
        "Managing accounts",
        "TV provider accounts"
      ],
      "source_sentence_hash": "aed3c91344c3f30657687076e651868e9caa4caf886f3d33f4e473bf277321e1",
      "word_count": 11
    },
    {
      "text": "Use iCloud synchronization for watchOS Keychain access",
      "section_path": [
        "Managing accounts",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "b852133b82258bcfec30f1bcd514bfbaf39ab273b719eeaf9aeb8094555afb6a",
      "word_count": 7
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Managing accounts",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
