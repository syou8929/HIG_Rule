  "guidance_candidates": [
    {
      "text": "Consider using an ornament to present frequently needed controls or information in a consistent location that doesn’t clutter the",
      "section_path": [
        "Ornaments",
        "Best practices"
      ],
      "source_sentence_hash": "624e78184f4cc3adc8dc0a8b4bf8da3fd71e713aae7d4af766a801c9495f01e7",
      "word_count": 19
    },
    {
      "text": "In general, keep an ornament visible",
      "section_path": [
        "Ornaments",
        "Best practices"
      ],
      "source_sentence_hash": "b8167810d250f61a7a5852ca2aee7229925ac807e65394d1e3be063070828fc0",
      "word_count": 6
    },
    {
      "text": "If you need to display multiple ornaments, prioritize the overall visual balance of the window",
      "section_path": [
        "Ornaments",
        "Best practices"
      ],
      "source_sentence_hash": "d3b17674931a75f985bf2fda3c8e508926d5640883355fcfa0c6bb115fe81cf7",
      "word_count": 15
    },
    {
      "text": "Aim to keep an ornament’s width the same or narrower than the width of the associated window",
      "section_path": [
        "Ornaments",
        "Best practices"
      ],
      "source_sentence_hash": "fe35ca1aa5d98ae6a45fa856e904b50eb7ccf648fa23fdfb53dedbe1d9638877",
      "word_count": 17
    },
    {
      "text": "Consider using borderless buttons in an ornament",
      "section_path": [
        "Ornaments",
        "Best practices"
      ],
      "source_sentence_hash": "92c7217a34db28fe643ab1859d7612246e6de50de4a93805c92b52f1044ea9ab",
      "word_count": 7
    },
    {
      "text": "Use system-provided toolbars and tab bars unless you need to create custom components",
      "section_path": [
        "Ornaments",
        "Best practices"
      ],
      "source_sentence_hash": "e212df3d08caae35573d5db5d05ad7fde141560d05d0607553a2b4f5140b6f49",
      "word_count": 13
    },
