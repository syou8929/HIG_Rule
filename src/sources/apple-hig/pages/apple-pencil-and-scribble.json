  "guidance_candidates": [
    {
      "text": "Support behaviors people intuitively expect when using a marking instrument",
      "section_path": [
        "Apple Pencil and Scribble",
        "Best practices"
      ],
      "source_sentence_hash": "c64e82710802b3622d8fed2c1bc85c49313c6a772dbeb2bb833f4d0d4255c86c",
      "word_count": 10
    },
    {
      "text": "Let people choose when to switch between Apple Pencil and finger input",
      "section_path": [
        "Apple Pencil and Scribble",
        "Best practices"
      ],
      "source_sentence_hash": "beecd17ac7961b5521b7fb5d48c71f6f88ea00a271cb55f6503402df343204ab",
      "word_count": 12
    },
    {
      "text": "Let people make a mark the moment Apple Pencil touches the screen",
      "section_path": [
        "Apple Pencil and Scribble",
        "Best practices"
      ],
      "source_sentence_hash": "64bc5a248112caa7a22f3231d96024291629a6276c3f34ee5b5864abd294b453",
      "word_count": 12
    },
    {
      "text": "Help people express themselves by responding to the way they use Apple Pencil",
      "section_path": [
        "Apple Pencil and Scribble",
        "Best practices"
      ],
      "source_sentence_hash": "29c01251ebe262bf47322e75325bd0fed8c706765baf754b2730928556a45b42",
      "word_count": 13
    },
    {
      "text": "Provide visual feedback to indicate a direct connection with content",
      "section_path": [
        "Apple Pencil and Scribble",
        "Best practices"
      ],
      "source_sentence_hash": "6c8f8d0df33e906e7610d3ed64450e54985895dec11fed14428e0d33e0893aab",
      "word_count": 10
    },
    {
      "text": "Design a great left- and right-handed experience",
      "section_path": [
        "Apple Pencil and Scribble",
        "Best practices"
      ],
      "source_sentence_hash": "63cf07b94be178c60c82d6d2ca571a99057c13ac752ba32029e2bfc247f41547",
      "word_count": 7
    },
    {
      "text": "Use hover to help people predict what will happen when Apple Pencil touches the screen",
      "section_path": [
        "Apple Pencil and Scribble",
        "Hover"
      ],
      "source_sentence_hash": "4e8be5345faa48a603d16f55cf039d066d3717358c363adc12eef713d25e270f",
      "word_count": 15
    },
    {
      "text": "Avoid using hover to initiate an action",
      "section_path": [
        "Apple Pencil and Scribble",
        "Hover"
      ],
      "source_sentence_hash": "40145a7ebba2fc0bd69f841ba13e7530c8c8e6f65bdfd649e2f797dd98118f4d",
      "word_count": 7
    },
    {
      "text": "Prefer showing a preview value that’s near the middle in a range of dynamic values",
      "section_path": [
        "Apple Pencil and Scribble",
        "Hover"
      ],
      "source_sentence_hash": "1283357a5dd162aa80e29b31fb85a322721aa6fe234c2dc0065b004f3b225c64",
      "word_count": 15
    },
    {
      "text": "Consider using hover to support relevant interactions close to where people are marking",
      "section_path": [
        "Apple Pencil and Scribble",
        "Hover"
      ],
      "source_sentence_hash": "7eccee485397e30cfcf8790692d25d4392badc66f509661d5b49202b4c2ccaa6",
      "word_count": 13
    },
    {
      "text": "Prefer showing hover previews for Apple Pencil, not for a pointing device",
      "section_path": [
        "Apple Pencil and Scribble",
        "Hover"
      ],
      "source_sentence_hash": "7e44b10e12320622d98efbb04695954f273a1b6d6c7f6b052c4f3394a2d79730",
      "word_count": 12
    },
    {
      "text": "Respect people’s settings for the double-tap gesture when they make sense in your app",
      "section_path": [
        "Apple Pencil and Scribble",
        "Double tap"
      ],
      "source_sentence_hash": "511655e565ef6274e519beab1d4615855aaf15bd02d38e8c4606c4a15bf83d52",
      "word_count": 14
    },
    {
      "text": "Give people a way to specify custom double-tap behavior if necessary",
      "section_path": [
        "Apple Pencil and Scribble",
        "Double tap"
      ],
      "source_sentence_hash": "d1154a6be01a698eed34f977290f0d03b40242378850a1cf76196942b69d6675",
      "word_count": 11
    },
    {
      "text": "Avoid using the double-tap gesture to perform an action that modifies content",
      "section_path": [
        "Apple Pencil and Scribble",
        "Double tap"
      ],
      "source_sentence_hash": "a70f9dce62c6a47b1b7a5b230a4cef1d805059510e356beed48f3c5a08a08f3d",
      "word_count": 12
    },
    {
      "text": "Treat squeeze as a single, quick gesture that performs a discrete — not continuous — action",
      "section_path": [
        "Apple Pencil and Scribble",
        "Squeeze"
      ],
      "source_sentence_hash": "a8906b15cad5b2f3bc1b34706f4d8b79a991c2b4cb653a0b47321f6ab2958bb4",
      "word_count": 16
    },
    {
      "text": "If you use squeeze to reveal app UI, like a contextual menu, display it close to Apple Pencil Pro",
      "section_path": [
        "Apple Pencil and Scribble",
        "Squeeze"
      ],
      "source_sentence_hash": "324dd2384bfc1583617d856a7fc3d1e765edb8a1bb1542471ba05ada6b3d14c6",
      "word_count": 19
    },
    {
      "text": "Define squeeze actions that are nondestructive and easy to undo",
      "section_path": [
        "Apple Pencil and Scribble",
        "Squeeze"
      ],
      "source_sentence_hash": "e6a22ca7cb5e7496f5e23a19fd5882ba707468eb88eda5b6063f27bd4078d07a",
      "word_count": 10
    },
    {
      "text": "Use barrel roll only to modify marking behavior, not to enable navigation or display other controls",
      "section_path": [
        "Apple Pencil and Scribble",
        "Barrel roll"
      ],
      "source_sentence_hash": "46cf6e2005b365fec4d3281fdef7320ce333cb3366251afca9f0de33bd06d208",
      "word_count": 16
    },
    {
      "text": "Make text entry feel fluid and effortless",
      "section_path": [
        "Apple Pencil and Scribble",
        "Scribble"
      ],
      "source_sentence_hash": "0d1dcbc329e1af2862543d596735cdefa8ed3419c332f946d027c49b35c06630",
      "word_count": 7
    },
    {
      "text": "Make Scribble available everywhere people might want to enter text",
      "section_path": [
        "Apple Pencil and Scribble",
        "Scribble"
      ],
      "source_sentence_hash": "0f7a2239399356a5624dfb5225902f717f6e2aaf0228b545ccd88aa7b308806b",
      "word_count": 10
    },
    {
      "text": "Avoid distracting people while they write",
      "section_path": [
        "Apple Pencil and Scribble",
        "Scribble"
      ],
      "source_sentence_hash": "5507666e8235efd12a926af0be0da72d9f516fc50c4bd6d0357bee49dcd5d83b",
      "word_count": 6
    },
    {
      "text": "While people are writing in a text field, make sure it remains stationary",
      "section_path": [
        "Apple Pencil and Scribble",
        "Scribble"
      ],
      "source_sentence_hash": "8982d05adaaed586d0ec5081209b4a238138c5fa650304636f21373604b7c9a4",
      "word_count": 13
    },
    {
      "text": "Prevent autoscrolling text while people are writing and editing in a text field",
      "section_path": [
        "Apple Pencil and Scribble",
        "Scribble"
      ],
      "source_sentence_hash": "b15e27e855dc4b64528e3db80aeb67b056d46e7fc20876a62d632a30e6e1ac65",
      "word_count": 13
    },
    {
      "text": "Give people enough space to write",
      "section_path": [
        "Apple Pencil and Scribble",
        "Scribble"
      ],
      "source_sentence_hash": "9f7701fd49a6a3ced1d41a4146655015acc4d499aecd4500f15e189b943c5794",
      "word_count": 6
    },
    {
      "text": "Help people draw on top of existing content",
      "section_path": [
        "Apple Pencil and Scribble",
        "Custom drawing"
      ],
      "source_sentence_hash": "34f248fd1a86432c8d6cb9f851bf1e5020ff043965d99a7024dac7a7f06b8d7f",
      "word_count": 8
    },
    {
      "text": "Consider displaying custom undo and redo buttons when your app runs in a compact environment",
      "section_path": [
        "Apple Pencil and Scribble",
        "Custom drawing"
      ],
      "source_sentence_hash": "af61a6fb2198658ce859e9b0947502f97c8511fb2af204ac81e3146f0c190324",
      "word_count": 15
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Apple Pencil and Scribble",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
