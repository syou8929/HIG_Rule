  "guidance_candidates": [
    {
      "text": "You need to get permission before sending any notification",
      "section_path": [
        "Managing notifications"
      ],
      "source_sentence_hash": "161c45e32709f3882efe702a1aa3e720db68e6a15381f95cfe1c3722e968801f",
      "word_count": 9
    },
    {
      "text": "A Focus helps people filter notifications during a time period they reserve for an activity like sleeping, working, reading,",
      "section_path": [
        "Managing notifications",
        "Integrating with Focus"
      ],
      "source_sentence_hash": "cdcca0f0a2e7a41d8c8de82c43ca7cfc3b28afb57873a70a520a51d04c352d4a",
      "word_count": 19
    },
    {
      "text": "Delivery scheduling lets people choose whether to receive notification alerts immediately or in a summary that’s delivered at times",
      "section_path": [
        "Managing notifications",
        "Integrating with Focus"
      ],
      "source_sentence_hash": "38b533d32974517488a8576e086e5911d72f2f673b74f22088fa24935ecdb678",
      "word_count": 19
    },
    {
      "text": "Passive. Information people can view at their leisure, like a restaurant recommendation",
      "section_path": [
        "Managing notifications",
        "Integrating with Focus"
      ],
      "source_sentence_hash": "891afb5496d337e4a06c42851aec46b2ea10f865d9c57c1f519c367e3b911978",
      "word_count": 12
    },
    {
      "text": "Active (the default). Information people might appreciate knowing about when it arrives, like a score update on their favorite",
      "section_path": [
        "Managing notifications",
        "Integrating with Focus"
      ],
      "source_sentence_hash": "f87521db8de3ce1f20867891dadf4a74c952f198fd2431c6df13b2986adda581",
      "word_count": 19
    },
    {
      "text": "Time Sensitive. Information that directly impacts the person and requires their immediate attention, like an account security issue or",
      "section_path": [
        "Managing notifications",
        "Integrating with Focus"
      ],
      "source_sentence_hash": "f114c113a332652ea54cc4444203b3f8583448ab84ed6fde88d399dfc6a2fa6b",
      "word_count": 19
    },
    {
      "text": "You first identify the types of notifications your app or game can send",
      "section_path": [
        "Managing notifications",
        "Integrating with Focus"
      ],
      "source_sentence_hash": "74571b3bda092c9355f8ffa8d9354f6c365cecdaad8d48dc0b24f84b51ee06b0",
      "word_count": 12
    },
    {
      "text": "If you support direct communications, use communication notifications",
      "section_path": [
        "Managing notifications",
        "Integrating with Focus"
      ],
      "source_sentence_hash": "c353078c7275f0ccc1194ad2cdef1abee30e810240d4021926193407fa777630",
      "word_count": 8
    },
    {
      "text": "For all other types of tasks, use noncommunication notifications",
      "section_path": [
        "Managing notifications",
        "Integrating with Focus"
      ],
      "source_sentence_hash": "c353078c7275f0ccc1194ad2cdef1abee30e810240d4021926193407fa777630",
      "word_count": 9
    },
    {
      "text": "Adopt SiriKit intents to support communication notifications",
      "section_path": [
        "Managing notifications",
        "Integrating with Focus"
      ],
      "source_sentence_hash": "90454e20373be3af49d3443b2d4f2d7fa661725074a08d9adc185fb13dfd173e",
      "word_count": 7
    },
    {
      "text": "You need to specify a system-defined interruption level for each noncommunication notification",
      "section_path": [
        "Managing notifications",
        "Integrating with Focus"
      ],
      "source_sentence_hash": "b2a34acb9588c3ee35e3d5374759210f421a2ed5ce58ffcab48f57d0232d48ca",
      "word_count": 12
    },
    {
      "text": "You must get an entitlement to send a Critical notification",
      "section_path": [
        "Managing notifications",
        "Integrating with Focus"
      ],
      "source_sentence_hash": "d41120ebe905c28b99e34cc50ebf6e90266cc9fc60e1980b09f6d717c4d2a85f",
      "word_count": 10
    },
    {
      "text": "Build trust by accurately representing the urgency of each notification",
      "section_path": [
        "Managing notifications",
        "Best practices"
      ],
      "source_sentence_hash": "328ad4b334d4d9e03b852b9b72568c56a7bb4568f04723eb980578d58e1173b3",
      "word_count": 10
    },
    {
      "text": "Use the Time Sensitive interruption level only for notifications that are relevant in the moment",
      "section_path": [
        "Managing notifications",
        "Best practices"
      ],
      "source_sentence_hash": "0a967253f214170299e9d568a432b206cf560d19492a7bdc95fbc57bfd8d0570",
      "word_count": 15
    },
    {
      "text": "Don’t use notifications to send marketing or promotional content unless people explicitly agree to receive such information",
      "section_path": [
        "Managing notifications",
        "Sending marketing notifications"
      ],
      "source_sentence_hash": "ed925c82c1bf6d7e884d40ca7aa90d36df7b28906cd7b94173b5caa03813be6b",
      "word_count": 18
    },
    {
      "text": "Never use the Time Sensitive interruption level to send a marketing notification",
      "section_path": [
        "Managing notifications",
        "Sending marketing notifications"
      ],
      "source_sentence_hash": "3ae1e688bfcb5878b76b03537e64c08861cfc12632b9c30a77aeb4f0fc22b6aa",
      "word_count": 12
    },
    {
      "text": "Get people’s permission if you want to send them promotional or marketing notifications",
      "section_path": [
        "Managing notifications",
        "Sending marketing notifications"
      ],
      "source_sentence_hash": "2987e44d5edc884de0406c5bea105027fd6052b6a5e4109565cf1a0d918d3a21",
      "word_count": 13
    },
    {
      "text": "Create an alert, modal view, or other interface that describes the types of information you want to send",
      "section_path": [
        "Managing notifications",
        "Sending marketing notifications"
      ],
      "source_sentence_hash": "311afa682d34d2d37cb4f84c767beb00a7255685871475a73b5dbd311942d49a",
      "word_count": 18
    },
    {
      "text": "Give people a clear way to opt in or out",
      "section_path": [
        "Managing notifications",
        "Sending marketing notifications"
      ],
      "source_sentence_hash": "311afa682d34d2d37cb4f84c767beb00a7255685871475a73b5dbd311942d49a",
      "word_count": 10
    },
    {
      "text": "Make sure people can manage their notification settings within your app",
      "section_path": [
        "Managing notifications",
        "Sending marketing notifications"
      ],
      "source_sentence_hash": "e54c40976769ba7885d14170e87454940502cd40406bfa3fbd6486e291f6381a",
      "word_count": 11
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Managing notifications",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
