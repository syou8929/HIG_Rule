  "guidance_candidates": [
    {
      "text": "Use font sizes that most people can read easily",
      "section_path": [
        "Typography",
        "Ensuring legibility"
      ],
      "source_sentence_hash": "5753acfa9868478899bc7b4f44dea85f0f9232b0090265bc27164a66b886b3ed",
      "word_count": 9
    },
    {
      "text": "Test legibility in different contexts",
      "section_path": [
        "Typography",
        "Ensuring legibility"
      ],
      "source_sentence_hash": "6750eea1a943791871dde5b624e181803361923dad365d97fa7a6fc45b931163",
      "word_count": 5
    },
    {
      "text": "In general, avoid light font weights",
      "section_path": [
        "Typography",
        "Ensuring legibility"
      ],
      "source_sentence_hash": "d6128f01f7be7211ed236dd0b74f9ddabcc7d45b784d74996f5ceeb81b4b14cd",
      "word_count": 6
    },
    {
      "text": "Adjust font weight, size, and color as needed to emphasize important information and help people visualize hierarchy",
      "section_path": [
        "Typography",
        "Conveying hierarchy"
      ],
      "source_sentence_hash": "e03d2662bdea3240810f5a30d1273c7146676691547aea51e06fb695fb3c11bc",
      "word_count": 17
    },
    {
      "text": "Minimize the number of typefaces you use, even in a highly customized interface",
      "section_path": [
        "Typography",
        "Conveying hierarchy"
      ],
      "source_sentence_hash": "5053a783fed343e8aa7d4fb07bfeb9deddedcfeaadd4e96d64bf932eab3c330a",
      "word_count": 13
    },
    {
      "text": "Prioritize important content when responding to text-size changes",
      "section_path": [
        "Typography",
        "Conveying hierarchy"
      ],
      "source_sentence_hash": "512ed518d32a43bbf249b100461eb9db8265281c11dbb7030df3eca1366039f4",
      "word_count": 8
    },
    {
      "text": "San Francisco (SF)",
      "section_path": [
        "Typography",
        "Using system fonts"
      ],
      "source_sentence_hash": "0d6e118ab851c2bfef46fc59e07b06a9d9e3a51621c2dbbef7f54913970c215a",
      "word_count": 3
    },
    {
      "text": "New York (NY)",
      "section_path": [
        "Typography",
        "Using system fonts"
      ],
      "source_sentence_hash": "e299f62a9c289e6bf04b337ad506a775cbe14945686b8a43f15fa415eb644dc4",
      "word_count": 3
    },
    {
      "text": "Consider using the built-in text styles",
      "section_path": [
        "Typography",
        "Using system fonts"
      ],
      "source_sentence_hash": "97929a9b82fef06138966d160c1db76ed62ad1d76a67818efbf8a6b2f3458f1f",
      "word_count": 6
    },
    {
      "text": "Modify the built-in text styles if necessary",
      "section_path": [
        "Typography",
        "Using system fonts"
      ],
      "source_sentence_hash": "833906fda319d27f0f195dd32d421a5234fa4b1fcef01070fb6af9291a820832",
      "word_count": 7
    },
    {
      "text": "If necessary, adjust tracking in interface mockups",
      "section_path": [
        "Typography",
        "Using system fonts"
      ],
      "source_sentence_hash": "19c0ab7452f8427b6ff82d92604d15cb21ff8a7a5725b695cf6f032dc8124beb",
      "word_count": 7
    },
    {
      "text": "Make sure custom fonts are legible",
      "section_path": [
        "Typography",
        "Using custom fonts"
      ],
      "source_sentence_hash": "f7ab2d066f70483621d276167ad4c20c07b4fd3760c30279a77ee7fd500bedc9",
      "word_count": 6
    },
    {
      "text": "Implement accessibility features for custom fonts",
      "section_path": [
        "Typography",
        "Using custom fonts"
      ],
      "source_sentence_hash": "28f459d8ff4bceddff122b6ebb66a4c743f1f4d0a0b38f8bd0b4ee7916b333e7",
      "word_count": 6
    },
    {
      "text": "Make sure your app’s layout adapts to all font sizes",
      "section_path": [
        "Typography",
        "Supporting Dynamic Type"
      ],
      "source_sentence_hash": "9ace3024cc0ae5794d97ee67c1cded4df1c7c769f9758a95543cc635a1be824d",
      "word_count": 10
    },
    {
      "text": "Increase the size of meaningful interface icons as font size increases",
      "section_path": [
        "Typography",
        "Supporting Dynamic Type"
      ],
      "source_sentence_hash": "c47ffb75d650e4051416cae6c3ca6f85de9000284865826ad49a6d50184455b8",
      "word_count": 11
    },
    {
      "text": "Keep text truncation to a minimum as font size increases",
      "section_path": [
        "Typography",
        "Supporting Dynamic Type"
      ],
      "source_sentence_hash": "cbeff4e091ec978dc695d59b589e5c7fc28e339dea932a9cd735b95007ca9ea0",
      "word_count": 10
    },
    {
      "text": "Consider adjusting your layout at large font sizes",
      "section_path": [
        "Typography",
        "Supporting Dynamic Type"
      ],
      "source_sentence_hash": "0be693baf5406cdeb42288ad238289a6ba51ec4619bc298dd795cd52b15a61c7",
      "word_count": 8
    },
    {
      "text": "Maintain a consistent information hierarchy regardless of the current font size",
      "section_path": [
        "Typography",
        "Supporting Dynamic Type"
      ],
      "source_sentence_hash": "0dae8a332065fbd10db6c3e87f589c5bca5ac4539d3c438248aa2037172b814b",
      "word_count": 11
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "Typography",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "When necessary, use dynamic system font variants to match the text in standard controls",
      "section_path": [
        "Typography",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "a79ef2da19120819dcf543176c95afa4e9237bf60c4f7fc42012a7dfc692d5d5",
      "word_count": 14
    },
    {
      "text": "In general, prefer 2D text",
      "section_path": [
        "Typography",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "cb3a787d81467115311dd62a251f5646c484b8323248feb2163ae67391038c82",
      "word_count": 5
    },
    {
      "text": "Make sure text looks good and remains legible when people scale it",
      "section_path": [
        "Typography",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "558b5296a93aa76ae06bd48d0745ce32e610c15cc5f2d3214194ef85dda7e4af",
      "word_count": 12
    },
    {
      "text": "Maximize the contrast between text and the background of its container",
      "section_path": [
        "Typography",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "197bc66e07b5114434a46a68883ef9ca75b769cdbaf9d551534598b5074d0e26",
      "word_count": 11
    },
    {
      "text": "If you need to display text that’s not on a background, consider making it bold to improve legibility",
      "section_path": [
        "Typography",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "f9960aad0d71d04f6b81f53e3190868d1a9d719d12618de5a916d3b51258717a",
      "word_count": 18
    },
    {
      "text": "Keep text facing people as much as possible",
      "section_path": [
        "Typography",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "d13cd5d14547361156a99fe1bdece466a83dfa520538877c47870dabe37eb807",
      "word_count": 8
    },
