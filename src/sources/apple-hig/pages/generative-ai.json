  "guidance_candidates": [
    {
      "text": "Design your experience responsibly",
      "section_path": [
        "Generative AI",
        "Best practices"
      ],
      "source_sentence_hash": "60c9be660cb430d2080ae77d1a04c68f8962eecb479a29e3e7bc1a4bb396620e",
      "word_count": 4
    },
    {
      "text": "Keep people in control",
      "section_path": [
        "Generative AI",
        "Best practices"
      ],
      "source_sentence_hash": "9a81594a657fd0c0d8bc1a5fc201453f802225b500aa06acb0e48bf850640842",
      "word_count": 4
    },
    {
      "text": "Ensure an inclusive experience for all",
      "section_path": [
        "Generative AI",
        "Best practices"
      ],
      "source_sentence_hash": "ad67b43e1fe3ea26ccb0576e0203985fceb3fce9cf0eb9eb6b6624aa1243e5d3",
      "word_count": 6
    },
    {
      "text": "Design engaging and useful generative features",
      "section_path": [
        "Generative AI",
        "Best practices"
      ],
      "source_sentence_hash": "db82c1f359ede23506cd6bf0db9930706953f47f63eb14c40b4ae858248f004a",
      "word_count": 6
    },
    {
      "text": "Ensure a great experience even when generative features aren’t available or people opt not to use them",
      "section_path": [
        "Generative AI",
        "Best practices"
      ],
      "source_sentence_hash": "6de54863accbfb7a9a4627783ba2883157beb37f22436a6b0af507ebe2511c4b",
      "word_count": 17
    },
    {
      "text": "Communicate where your app uses AI",
      "section_path": [
        "Generative AI",
        "Transparency"
      ],
      "source_sentence_hash": "914478ca95c1d33437cb93ece62e55fc5d7712a1622d71d644a8d5da93705d59",
      "word_count": 6
    },
    {
      "text": "Set clear expectations about what your AI-powered feature can and can’t do",
      "section_path": [
        "Generative AI",
        "Transparency"
      ],
      "source_sentence_hash": "e542efea9063df6b89da90d0f98e9cc3e6564a45cc2d1cc78d45a0276befe023",
      "word_count": 12
    },
    {
      "text": "Choose a model type that fits your feature’s needs and protects people’s privacy",
      "section_path": [
        "Generative AI",
        "Privacy"
      ],
      "source_sentence_hash": "cc5024c6157c4baf018ab6a41bc6a18f49ac0fe270d65acbcbc6fb8b8fa62029",
      "word_count": 13
    },
    {
      "text": "Ask permission before using personal information and usage data",
      "section_path": [
        "Generative AI",
        "Privacy"
      ],
      "source_sentence_hash": "3e68ef28880a31c0dd4bceab3f2164064b1003140912f014f58461ac10c311eb",
      "word_count": 9
    },
    {
      "text": "Clearly disclose how your app and its model use and store personal information",
      "section_path": [
        "Generative AI",
        "Privacy"
      ],
      "source_sentence_hash": "6116773d8f767a036d50843c2027424f542c6d554076a833dd1f4ce7aeb91f7f",
      "word_count": 13
    },
    {
      "text": "Thoughtfully evaluate model capabilities",
      "section_path": [
        "Generative AI",
        "Models and datasets"
      ],
      "source_sentence_hash": "2e2f3c4dcc5f9d5e2ccb8dabeaac9091400755c0a21cb1cfa8aa102f0ec8614f",
      "word_count": 4
    },
    {
      "text": "Be intentional when choosing or creating a dataset",
      "section_path": [
        "Generative AI",
        "Models and datasets"
      ],
      "source_sentence_hash": "98d6f53788c4560ff4137724ff5188446279c2a919db3c3c6ee0da9da3af30fb",
      "word_count": 8
    },
    {
      "text": "Guide people on how to use your generative feature",
      "section_path": [
        "Generative AI",
        "Inputs"
      ],
      "source_sentence_hash": "6ab61baf723f1ac957dc0d0593608a03999a5f2025e4420a82587a672d14bc19",
      "word_count": 9
    },
    {
      "text": "Raise awareness about and minimize the chance of hallucinations",
      "section_path": [
        "Generative AI",
        "Inputs"
      ],
      "source_sentence_hash": "d1d286535721e1c194a5620b888a78da0b9d3af0b2d0373e3f43db7f11813283",
      "word_count": 9
    },
    {
      "text": "Consider consequences and get permission before performing irreversible or potentially problematic tasks",
      "section_path": [
        "Generative AI",
        "Inputs"
      ],
      "source_sentence_hash": "50ec98ef87abbc3d8a7bb89353f116161bb30b9f8c9ae681a1fde0ece17076c6",
      "word_count": 12
    },
    {
      "text": "Make it easy for people to refine or revert generated results, and acknowledge when their corrections take effect",
      "section_path": [
        "Generative AI",
        "Outputs"
      ],
      "source_sentence_hash": "3f42c6199c800ed90fd35724cfec0a1a3eac2f4a52f6816ba2cd5365636c053b",
      "word_count": 18
    },
    {
      "text": "Help people improve requests when blocked or undesirable results occur",
      "section_path": [
        "Generative AI",
        "Outputs"
      ],
      "source_sentence_hash": "feb2d2b2b50f2b48c2365764c615f9fa3c6274d27278261810a9ef6abf3b7668",
      "word_count": 10
    },
    {
      "text": "Reduce unexpected and harmful outcomes with thoughtful design and thorough testing",
      "section_path": [
        "Generative AI",
        "Outputs"
      ],
      "source_sentence_hash": "a9a7234d4ad5f9822cd9c857454f6eaa748ac908da1246813754047bbe04e635",
      "word_count": 11
    },
    {
      "text": "Strive to avoid replicating copyrighted content",
      "section_path": [
        "Generative AI",
        "Outputs"
      ],
      "source_sentence_hash": "16bf0ebceb3b9811edc96f539c0c2517d3682713667adddfb88242ef41fcd45c",
      "word_count": 6
    },
    {
      "text": "Factor processing time into your design",
      "section_path": [
        "Generative AI",
        "Outputs"
      ],
      "source_sentence_hash": "1014b6a8637d73b6ee56adb40962b91ea711a23f2d9b6c4b8577772b4942390c",
      "word_count": 6
    },
    {
      "text": "Consider giving specific, reassuring feedback during generation",
      "section_path": [
        "Generative AI",
        "Outputs"
      ],
      "source_sentence_hash": "4bf6b46f029dca0cf5930ea51420900e24007fca6e55719087963c76cb1d182b",
      "word_count": 7
    },
    {
      "text": "Consider offering alternate versions of results",
      "section_path": [
        "Generative AI",
        "Outputs"
      ],
      "source_sentence_hash": "e81fc0edf39e38e6eaeae0b98754256ccdee759eec718822240a985e1c978439",
      "word_count": 6
    },
    {
      "text": "Consider ways to improve your model over time",
      "section_path": [
        "Generative AI",
        "Continuous improvement"
      ],
      "source_sentence_hash": "370df2312ea441ad49deedfc6ec9a341fb8ebebc2929953d6c383d6bd532b66e",
      "word_count": 8
    },
    {
      "text": "Let people share feedback on outputs",
      "section_path": [
        "Generative AI",
        "Continuous improvement"
      ],
      "source_sentence_hash": "f9e99b03ecce8bce383d9251815536676f70541ce9debce1500ed4ecb552c61c",
      "word_count": 6
    },
    {
      "text": "Design flexible, adaptable features",
      "section_path": [
        "Generative AI",
        "Continuous improvement"
      ],
      "source_sentence_hash": "5fe5f5de1c81455ba65375543d684544354398d04581c0799acf4a704296f655",
      "word_count": 4
    },
    {
      "text": "Ensure people remain in charge of AI decision making and the overall experience",
      "section_path": [
        "Generative AI",
        "Best practices"
      ],
      "source_sentence_hash": "f1f0030771c2b6cda72d43f659c7b4c17d26544cc6a182bad396ef025fa2a322",
      "word_count": 12
    },
    {
      "text": "Let people dismiss unwanted AI content and revert or retry unwanted transformations or actions",
      "section_path": [
        "Generative AI",
        "Best practices"
      ],
      "source_sentence_hash": "4232eab32c686c3e1b971dfcfcd4300212c14d82893baece671f173d9845ffe6",
      "word_count": 14
    },
    {
      "text": "Consider offering a non-AI fallback when possible",
      "section_path": [
        "Generative AI",
        "Best practices"
      ],
      "source_sentence_hash": "94f6fe31de104005683dbbf8b232f33fe743c2592288af662636253dd48be108",
      "word_count": 7
    },
    {
      "text": "Ask people for needed personal or cultural information instead of solely inferring it",
      "section_path": [
        "Generative AI",
        "Best practices"
      ],
      "source_sentence_hash": "977ce606a7d1563161e366e1f775bbc523b59380a84e514d8ee44eb8b3cfc1be",
      "word_count": 13
    },
    {
      "text": "Confirm personal assumptions before they can cause common stereotypes",
      "section_path": [
        "Generative AI",
        "Best practices"
      ],
      "source_sentence_hash": "d46616b269630f9ba0d10730d52acbcd3b8e6f5410597818527340d3e552e714",
      "word_count": 9
    },
    {
      "text": "Test AI features across diverse people and correct stereotypes",
      "section_path": [
        "Generative AI",
        "Best practices"
      ],
      "source_sentence_hash": "992f6b7156ce57996e876007401440c9fa3dcb38b9ec4b11b1db514c5caa89b5",
      "word_count": 9
    },
    {
      "text": "Never misrepresent AI interactions or content as human-authored",
      "section_path": [
        "Generative AI",
        "Transparency"
      ],
      "source_sentence_hash": "c00e37f8c09c3abbba43bf4467d7779b09dbe049591f7e41906aa5dcef5de643",
      "word_count": 8
    },
    {
      "text": "Ensure AI disclosure follows applicable regional regulations",
      "section_path": [
        "Generative AI",
        "Transparency"
      ],
      "source_sentence_hash": "2aa3faf482f0cbeaeca087168b3690a21b4b75b3397b1cf5e9cf853f7a5613fd",
      "word_count": 7
    },
    {
      "text": "Always weigh privacy alongside capability and performance",
      "section_path": [
        "Generative AI",
        "Privacy"
      ],
      "source_sentence_hash": "4acac7e3fe45fc820e379b61d990a4228f21f11f8719000517e9e60984183b33",
      "word_count": 7
    },
    {
      "text": "For server-based processing, take steps to protect people’s privacy",
      "section_path": [
        "Generative AI",
        "Privacy"
      ],
      "source_sentence_hash": "9c9d4f78bdc511631eba7d5bd29d1549a6a768fe0f9add43562eb8d0c9d46af7",
      "word_count": 9
    },
    {
      "text": "Clearly disclose server transfer, shared data, off-device storage, and training use",
      "section_path": [
        "Generative AI",
        "Privacy"
      ],
      "source_sentence_hash": "e13af7d94c74934ab9b2c3b47b734c843adfe9298d0efd00955c5db974949aac",
      "word_count": 10
    },
    {
      "text": "Use only the minimum personal data needed after permission",
      "section_path": [
        "Generative AI",
        "Privacy"
      ],
      "source_sentence_hash": "46dcea2f7c476f8b4332108f70212aa1c817ee4e613c6f0dfce07d6e745b2746",
      "word_count": 9
    },
    {
      "text": "Ask for explicit permission before using sensitive data for model improvement or storage",
      "section_path": [
        "Generative AI",
        "Privacy"
      ],
      "source_sentence_hash": "32d32911b5ca90cf98e471d8923abae38ecdbb39b15959e9865191d57077ef3d",
      "word_count": 13
    },
    {
      "text": "Enable informed decisions about personal data shared with an AI model",
      "section_path": [
        "Generative AI",
        "Privacy"
      ],
      "source_sentence_hash": "5c2df73cd2a236ded67d0e7bc95e3274e62605c9dec6f7c7518abcf23bb22d00",
      "word_count": 11
    },
    {
      "text": "Describe permission benefits concisely, specifically, and clearly",
      "section_path": [
        "Generative AI",
        "Privacy"
      ],
      "source_sentence_hash": "429d0f8e27828112f3ca9cdd64119bca8da83c4083bd7682b91e8ec198c9fb13",
      "word_count": 7
    },
    {
      "text": "Clearly disclose personal-data use for model training and improvement",
      "section_path": [
        "Generative AI",
        "Privacy"
      ],
      "source_sentence_hash": "cd12b33e65c255b736dadbc98ee3a1bd7b123870ca223a5d2dbc33a809b7f493",
      "word_count": 9
    },
    {
      "text": "Choose diverse datasets for model teaching and evaluation",
      "section_path": [
        "Generative AI",
        "Models and datasets"
      ],
      "source_sentence_hash": "e067dd334335e0e5cacff44a4c2cc741ad19d447cc2133b8a391bd3e76a99b17",
      "word_count": 8
    },
    {
      "text": "Identify where data comes from and how it was gathered",
      "section_path": [
        "Generative AI",
        "Models and datasets"
      ],
      "source_sentence_hash": "6a23eed92339637e5a09bc54e91b2911ad3ca85bc91f454ef39c8100a7964423",
      "word_count": 9
    },
    {
      "text": "Ensure licenses cover all data you don’t own",
      "section_path": [
        "Generative AI",
        "Models and datasets"
      ],
      "source_sentence_hash": "1300962c313c1e98ee462c20978081e7c9406d0c70816c330e0a33c63ddcbe43",
      "word_count": 8
    },
    {
      "text": "Clearly communicate that AI-generated content may contain errors",
      "section_path": [
        "Generative AI",
        "Inputs"
      ],
      "source_sentence_hash": "724b45c120f4dec852f7b4a0d98a53eb4c91e257395ee6e84efa6c53c80014f7",
      "word_count": 8
    },
    {
      "text": "Avoid factual generation without verified and current model information",
      "section_path": [
        "Generative AI",
        "Inputs"
      ],
      "source_sentence_hash": "330b8e4c57a0c7abd434f0fb13bbdc1d4229d3dfadd25822234369739b344f4d",
      "word_count": 9
    },
    {
      "text": "Avoid AI-generated content where hallucinations could misinform and harm",
      "section_path": [
        "Generative AI",
        "Inputs"
      ],
      "source_sentence_hash": "28033953c5a325e681369e6a0e45095785858f02c4c946373b426410ab685135",
      "word_count": 9
    },
    {
      "text": "Avoid automating destructive or hard-to-undo actions",
      "section_path": [
        "Generative AI",
        "Inputs"
      ],
      "source_sentence_hash": "54689524b6b56dbf5ac9f70825b240090fceeb240951b39b83555ca11e1a7e78",
      "word_count": 7
    },
    {
      "text": "Ask for confirmation before significant actions on someone’s behalf",
      "section_path": [
        "Generative AI",
        "Inputs"
      ],
      "source_sentence_hash": "1690b5746251b97b5deece4b2580d601ee43584ba3d645f314e9a2ab2f206904",
      "word_count": 9
    },
    {
      "text": "Adhere to model, government, and regional AI policies",
      "section_path": [
        "Generative AI",
        "Inputs"
      ],
      "source_sentence_hash": "0942a7ab725401be8d7e8ad933209d7a7ee86933de1729116dd7a3fc61b99783",
      "word_count": 8
    },
    {
      "text": "Provide a clear signal when output corrections take effect",
      "section_path": [
        "Generative AI",
        "Outputs"
      ],
      "source_sentence_hash": "8e9fdd93f32f8a22bd44bdd0b85048f06593e305b27bce97cc9968e51e4e6ab8",
      "word_count": 9
    },
    {
      "text": "Describe generation errors plainly and offer a clear next step",
      "section_path": [
        "Generative AI",
        "Outputs"
      ],
      "source_sentence_hash": "17be84a159cd25f2be40dd17da9cf37fd6d1a024d94d3bf1fffdeffeeaa66346",
      "word_count": 10
    },
    {
      "text": "Test and refine all model updates for unexpected behavior",
      "section_path": [
        "Generative AI",
        "Continuous improvement"
      ],
      "source_sentence_hash": "c785fc092eac46052e459355a8b7f5cc2c9afc1ad2dadf6b6e71144a3176215c",
      "word_count": 9
    },
    {
      "text": "Always keep AI-output feedback voluntary",
      "section_path": [
        "Generative AI",
        "Continuous improvement"
      ],
      "source_sentence_hash": "763a0d8ab09de9706e848c796915bfc91d226e83d84179a12d5a98ea2cb1d5ec",
      "word_count": 5
    },
    {
      "text": "Place AI feedback controls clearly without interrupting the experience",
      "section_path": [
        "Generative AI",
        "Continuous improvement"
      ],
      "source_sentence_hash": "43ff4f8eafc2c4d74610f2a9b8abcae454a9555251de29764c61e60347b63237",
      "word_count": 9
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Generative AI",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
