  "guidance_candidates": [
    {
      "text": "Design your experience responsibly",
      "section_path": [
        "Generative AI",
        "Best practices"
      ],
      "source_sentence_hash": "60c9be660cb430d2080ae77d1a04c68f8962eecb479a29e3e7bc1a4bb396620e",
      "word_count": 4
    },
    {
      "text": "Keep people in control",
      "section_path": [
        "Generative AI",
        "Best practices"
      ],
      "source_sentence_hash": "9a81594a657fd0c0d8bc1a5fc201453f802225b500aa06acb0e48bf850640842",
      "word_count": 4
    },
    {
      "text": "Ensure an inclusive experience for all",
      "section_path": [
        "Generative AI",
        "Best practices"
      ],
      "source_sentence_hash": "ad67b43e1fe3ea26ccb0576e0203985fceb3fce9cf0eb9eb6b6624aa1243e5d3",
      "word_count": 6
    },
    {
      "text": "Design engaging and useful generative features",
      "section_path": [
        "Generative AI",
        "Best practices"
      ],
      "source_sentence_hash": "db82c1f359ede23506cd6bf0db9930706953f47f63eb14c40b4ae858248f004a",
      "word_count": 6
    },
    {
      "text": "Ensure a great experience even when generative features aren’t available or people opt not to use them",
      "section_path": [
        "Generative AI",
        "Best practices"
      ],
      "source_sentence_hash": "6de54863accbfb7a9a4627783ba2883157beb37f22436a6b0af507ebe2511c4b",
      "word_count": 17
    },
    {
      "text": "Communicate where your app uses AI",
      "section_path": [
        "Generative AI",
        "Transparency"
      ],
      "source_sentence_hash": "914478ca95c1d33437cb93ece62e55fc5d7712a1622d71d644a8d5da93705d59",
      "word_count": 6
    },
    {
      "text": "Set clear expectations about what your AI-powered feature can and can’t do",
      "section_path": [
        "Generative AI",
        "Transparency"
      ],
      "source_sentence_hash": "e542efea9063df6b89da90d0f98e9cc3e6564a45cc2d1cc78d45a0276befe023",
      "word_count": 12
    },
    {
      "text": "Choose a model type that fits your feature’s needs and protects people’s privacy",
      "section_path": [
        "Generative AI",
        "Privacy"
      ],
      "source_sentence_hash": "cc5024c6157c4baf018ab6a41bc6a18f49ac0fe270d65acbcbc6fb8b8fa62029",
      "word_count": 13
    },
    {
      "text": "Ask permission before using personal information and usage data",
      "section_path": [
        "Generative AI",
        "Privacy"
      ],
      "source_sentence_hash": "3e68ef28880a31c0dd4bceab3f2164064b1003140912f014f58461ac10c311eb",
      "word_count": 9
    },
    {
      "text": "Clearly disclose how your app and its model use and store personal information",
      "section_path": [
        "Generative AI",
        "Privacy"
      ],
      "source_sentence_hash": "6116773d8f767a036d50843c2027424f542c6d554076a833dd1f4ce7aeb91f7f",
      "word_count": 13
    },
    {
      "text": "Thoughtfully evaluate model capabilities",
      "section_path": [
        "Generative AI",
        "Models and datasets"
      ],
      "source_sentence_hash": "2e2f3c4dcc5f9d5e2ccb8dabeaac9091400755c0a21cb1cfa8aa102f0ec8614f",
      "word_count": 4
    },
    {
      "text": "Be intentional when choosing or creating a dataset",
      "section_path": [
        "Generative AI",
        "Models and datasets"
      ],
      "source_sentence_hash": "98d6f53788c4560ff4137724ff5188446279c2a919db3c3c6ee0da9da3af30fb",
      "word_count": 8
    },
    {
      "text": "Guide people on how to use your generative feature",
      "section_path": [
        "Generative AI",
        "Inputs"
      ],
      "source_sentence_hash": "6ab61baf723f1ac957dc0d0593608a03999a5f2025e4420a82587a672d14bc19",
      "word_count": 9
    },
    {
      "text": "Raise awareness about and minimize the chance of hallucinations",
      "section_path": [
        "Generative AI",
        "Inputs"
      ],
      "source_sentence_hash": "d1d286535721e1c194a5620b888a78da0b9d3af0b2d0373e3f43db7f11813283",
      "word_count": 9
    },
    {
      "text": "Consider consequences and get permission before performing irreversible or potentially problematic tasks",
      "section_path": [
        "Generative AI",
        "Inputs"
      ],
      "source_sentence_hash": "50ec98ef87abbc3d8a7bb89353f116161bb30b9f8c9ae681a1fde0ece17076c6",
      "word_count": 12
    },
    {
      "text": "Make it easy for people to refine or revert generated results, and acknowledge when their corrections take effect",
      "section_path": [
        "Generative AI",
        "Outputs"
      ],
      "source_sentence_hash": "3f42c6199c800ed90fd35724cfec0a1a3eac2f4a52f6816ba2cd5365636c053b",
      "word_count": 18
    },
    {
      "text": "Help people improve requests when blocked or undesirable results occur",
      "section_path": [
        "Generative AI",
        "Outputs"
      ],
      "source_sentence_hash": "feb2d2b2b50f2b48c2365764c615f9fa3c6274d27278261810a9ef6abf3b7668",
      "word_count": 10
    },
    {
      "text": "Reduce unexpected and harmful outcomes with thoughtful design and thorough testing",
      "section_path": [
        "Generative AI",
        "Outputs"
      ],
      "source_sentence_hash": "a9a7234d4ad5f9822cd9c857454f6eaa748ac908da1246813754047bbe04e635",
      "word_count": 11
    },
    {
      "text": "Strive to avoid replicating copyrighted content",
      "section_path": [
        "Generative AI",
        "Outputs"
      ],
      "source_sentence_hash": "16bf0ebceb3b9811edc96f539c0c2517d3682713667adddfb88242ef41fcd45c",
      "word_count": 6
    },
    {
      "text": "Factor processing time into your design",
      "section_path": [
        "Generative AI",
        "Outputs"
      ],
      "source_sentence_hash": "1014b6a8637d73b6ee56adb40962b91ea711a23f2d9b6c4b8577772b4942390c",
      "word_count": 6
    },
    {
      "text": "Consider giving specific, reassuring feedback during generation",
      "section_path": [
        "Generative AI",
        "Outputs"
      ],
      "source_sentence_hash": "4bf6b46f029dca0cf5930ea51420900e24007fca6e55719087963c76cb1d182b",
      "word_count": 7
    },
    {
      "text": "Consider offering alternate versions of results",
      "section_path": [
        "Generative AI",
        "Outputs"
      ],
      "source_sentence_hash": "e81fc0edf39e38e6eaeae0b98754256ccdee759eec718822240a985e1c978439",
      "word_count": 6
    },
    {
      "text": "Consider ways to improve your model over time",
      "section_path": [
        "Generative AI",
        "Continuous improvement"
      ],
      "source_sentence_hash": "370df2312ea441ad49deedfc6ec9a341fb8ebebc2929953d6c383d6bd532b66e",
      "word_count": 8
    },
    {
      "text": "Let people share feedback on outputs",
      "section_path": [
        "Generative AI",
        "Continuous improvement"
      ],
      "source_sentence_hash": "f9e99b03ecce8bce383d9251815536676f70541ce9debce1500ed4ecb552c61c",
      "word_count": 6
    },
    {
      "text": "Design flexible, adaptable features",
      "section_path": [
        "Generative AI",
        "Continuous improvement"
      ],
      "source_sentence_hash": "5fe5f5de1c81455ba65375543d684544354398d04581c0799acf4a704296f655",
      "word_count": 4
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Generative AI",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
