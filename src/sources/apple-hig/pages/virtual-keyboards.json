  "reference_notes": [
    {
      "section_path": [
        "Virtual keyboards"
      ],
      "note": "Virtual keyboards don't support keyboard shortcuts; this is a platform capability constraint, not a normative app rule."
    },
    {
      "section_path": [
        "Virtual keyboards",
        "Custom keyboards"
      ],
      "note": "Installable custom keyboards are unavailable in secure text and phone number fields; people can configure and switch multiple keyboards."
    },
    {
      "section_path": [
        "Virtual keyboards",
        "Platform considerations"
      ],
      "note": "Virtual keyboards are not supported in macOS; the remaining platform behavior was reviewed in its platform-specific subsections."
    },
    {
      "section_path": [
        "Virtual keyboards",
        "Platform considerations",
        "tvOS"
      ],
      "note": "tvOS chooses linear, grid, or digit-specific system keyboard layouts from the active input device and field context."
    },
    {
      "section_path": [
        "Virtual keyboards",
        "Platform considerations",
        "visionOS"
      ],
      "note": "The movable visionOS system keyboard supports direct and indirect gestures and requires no fixed-location layout reservation."
    },
    {
      "section_path": [
        "Virtual keyboards",
        "Platform considerations",
        "watchOS"
      ],
      "note": "watchOS keyboard availability depends on screen size; the system also supports dictation, Scribble, and nearby-iPhone entry."
    },
