  "guidance_candidates": [
    {
      "text": "Support larger text sizes",
      "section_path": [
        "Accessibility",
        "Vision"
      ],
      "source_sentence_hash": "078f60e5dd883d3995edf23799d90cdfa723cb54c50229c29715fbf988763fb4",
      "word_count": 4
    },
    {
      "text": "Use recommended defaults for custom type sizes",
      "section_path": [
        "Accessibility",
        "Vision"
      ],
      "source_sentence_hash": "e8a8ef580398bc1ee1bcd944fb626e84976328b48d7b81a0f6861afcf3708b2d",
      "word_count": 7
    },
    {
      "text": "Bear in mind that font weight can also impact how easy text is to read",
      "section_path": [
        "Accessibility",
        "Vision"
      ],
      "source_sentence_hash": "8e265f6965dfebf4d569c846bec39adbfde2946c989fe3d417b970ce263a5f34",
      "word_count": 15
    },
    {
      "text": "Strive to meet color contrast minimum standards",
      "section_path": [
        "Accessibility",
        "Vision"
      ],
      "source_sentence_hash": "b8d42391cd3f29c6612fa6972d1e93d8d23522c1bcdc7dd8fcaa2a5fa1da9d2e",
      "word_count": 7
    },
    {
      "text": "Prefer system-defined colors",
      "section_path": [
        "Accessibility",
        "Vision"
      ],
      "source_sentence_hash": "a2a41c0f22796ffd93c66cf5d8eb64a1d91589105910b0e2c053b2c0c6a465a3",
      "word_count": 3
    },
    {
      "text": "Convey information with more than color alone",
      "section_path": [
        "Accessibility",
        "Vision"
      ],
      "source_sentence_hash": "7349e0c28c8d83b9a8763cd1b02e6506f9f71bb25648f8611c505f48df39f1cd",
      "word_count": 7
    },
    {
      "text": "Describe your app’s interface and content for VoiceOver",
      "section_path": [
        "Accessibility",
        "Vision"
      ],
      "source_sentence_hash": "9a88ea11af4345ba7d658022d9bf5a65b94f57d2e5ec9d069690dcde4579538e",
      "word_count": 8
    },
    {
      "text": "Support text-based ways to enjoy audio and video",
      "section_path": [
        "Accessibility",
        "Hearing"
      ],
      "source_sentence_hash": "6895def921031060f84610def48507cae2406a408f4cbecfde0a4f62f8a9bc93",
      "word_count": 8
    },
    {
      "text": "Audio descriptions",
      "section_path": [
        "Accessibility",
        "Hearing"
      ],
      "source_sentence_hash": "95dc221d05c0d7ff4a11de848401feb24fedb788e289659356aec7c83cc50757",
      "word_count": 2
    },
    {
      "text": "Use haptics in addition to audio cues",
      "section_path": [
        "Accessibility",
        "Hearing"
      ],
      "source_sentence_hash": "8cfd75e769d188e87f94c7915389cf2c42835fb81388c94eaa4fc125c4228dfe",
      "word_count": 7
    },
    {
      "text": "Augment audio cues with visual cues",
      "section_path": [
        "Accessibility",
        "Hearing"
      ],
      "source_sentence_hash": "d85711c579d5fb5605f34133a15777c7abf9470f5ad3a782453c85521c49eee4",
      "word_count": 6
    },
    {
      "text": "Offer sufficiently sized controls",
      "section_path": [
        "Accessibility",
        "Mobility"
      ],
      "source_sentence_hash": "95519e44be5aba7632fe555f3756be11b8df9b4c5e218071eeb874207ef3aac7",
      "word_count": 4
    },
    {
      "text": "Consider spacing between controls as important as size",
      "section_path": [
        "Accessibility",
        "Mobility"
      ],
      "source_sentence_hash": "d15522430298b1e1fda2270ab365642951896525e930401766efb61c999a13e7",
      "word_count": 8
    },
    {
      "text": "Support simple gestures for common interactions",
      "section_path": [
        "Accessibility",
        "Mobility"
      ],
      "source_sentence_hash": "9a3bca40a0c5d8d7e1e6bb469db01adb1892b52bf2aaf0ef670074bcd88cf325",
      "word_count": 6
    },
    {
      "text": "Offer alternatives to gestures",
      "section_path": [
        "Accessibility",
        "Mobility"
      ],
      "source_sentence_hash": "638e6da5ef4c0cf79f2b16403b36de31a2a7dc92377bfca1f526ec6c2b73ddd5",
      "word_count": 4
    },
    {
      "text": "Let people use Voice Control to give guidance and enter information verbally",
      "section_path": [
        "Accessibility",
        "Mobility"
      ],
      "source_sentence_hash": "057ce80b7e7e6253e4b2e29c47197db2a2f07b1f652b7eb13eff0dc4f1f467b4",
      "word_count": 12
    },
    {
      "text": "Integrate with Siri and Shortcuts to let people perform tasks using voice alone",
      "section_path": [
        "Accessibility",
        "Mobility"
      ],
      "source_sentence_hash": "738fbe9b76a322acf61e0d1a091d321236ed46c9ca4bfd60bee291626cbe573c",
      "word_count": 13
    },
    {
      "text": "Support mobility-related assistive technologies",
      "section_path": [
        "Accessibility",
        "Mobility"
      ],
      "source_sentence_hash": "379663fbe792845d78d6fe15256c2358aeeb8b2a710fd2b14511916f4d37533c",
      "word_count": 4
    },
    {
      "text": "Let people use the keyboard alone to navigate and interact with your app",
      "section_path": [
        "Accessibility",
        "Speech"
      ],
      "source_sentence_hash": "139a0a23a8c597102729c693584c07df81766392c868f8d7e300538b6feaf7aa",
      "word_count": 13
    },
    {
      "text": "Support Switch Control",
      "section_path": [
        "Accessibility",
        "Speech"
      ],
      "source_sentence_hash": "a641ab4f6af7f9f927cb43ff1660531f611bee2f231b712837e3b2d560dfdfec",
      "word_count": 3
    },
    {
      "text": "Keep actions simple and intuitive",
      "section_path": [
        "Accessibility",
        "Cognitive"
      ],
      "source_sentence_hash": "2b280541c45bc0cda8c0ee204d4bf3983604d1dcae936e34fdc96258937ce13f",
      "word_count": 5
    },
    {
      "text": "Minimize use of time-boxed interface elements",
      "section_path": [
        "Accessibility",
        "Cognitive"
      ],
      "source_sentence_hash": "c4e4901a16216c12ce3b5ecec89cf840f0d9d2c3e710a48a63e4b6071de4c535",
      "word_count": 6
    },
    {
      "text": "Consider offering difficulty accommodations in games",
      "section_path": [
        "Accessibility",
        "Cognitive"
      ],
      "source_sentence_hash": "ab0e4dbd3ffc19db76eef91792ee547e4b79d609f149a6b9ad921ba3ac091614",
      "word_count": 6
    },
    {
      "text": "Let people control audio and video playback",
      "section_path": [
        "Accessibility",
        "Cognitive"
      ],
      "source_sentence_hash": "53cbb63ca0da377aab72e9252ff4ab8cfe20e6fbe27edd81352863e232b5364b",
      "word_count": 7
    },
    {
      "text": "Allow people to opt out of flashing lights in video playback",
      "section_path": [
        "Accessibility",
        "Cognitive"
      ],
      "source_sentence_hash": "ba65e102ab646f9bf7131566eb3c0d6ddc79727827903397034fd77dad6780b3",
      "word_count": 11
    },
    {
      "text": "Be cautious with fast-moving and blinking animations",
      "section_path": [
        "Accessibility",
        "Cognitive"
      ],
      "source_sentence_hash": "836e3e9d386eab0683a1de5c9f4ebdb71ac1a58605bec13c1e29bdd73fc5adc8",
      "word_count": 7
    },
    {
      "text": "Optimize your app’s UI for Assistive Access",
      "section_path": [
        "Accessibility",
        "Cognitive"
      ],
      "source_sentence_hash": "f43c20b6687a4d4990080e90f8d772fe223069f2d62f931d31e95c0350abef32",
      "word_count": 7
    },
    {
      "text": "Prioritize comfort",
      "section_path": [
        "Accessibility",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "4e01b6389808861da60d686727eec0eb5e6f64eb4914543041152a6f8f404745",
      "word_count": 2
    },
    {
      "text": "Developer documentation",
      "section_path": [
