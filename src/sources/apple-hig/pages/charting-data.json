  "guidance_candidates": [
    {
      "text": "Use a chart when you want to highlight important information about a dataset",
      "section_path": [
        "Charting data",
        "Best practices"
      ],
      "source_sentence_hash": "8328fbe63f1c4c030a9fe4dcccde77bb780049023e0acdb32e3d6925da11e5af",
      "word_count": 13
    },
    {
      "text": "Keep a chart simple, letting people choose when they want additional details",
      "section_path": [
        "Charting data",
        "Best practices"
      ],
      "source_sentence_hash": "b5e4b673c85b6042c3f197f4685c3b1a72557d876fd41248c6c9f944f0ed3eb3",
      "word_count": 12
    },
    {
      "text": "Make every chart in your app accessible",
      "section_path": [
        "Charting data",
        "Best practices"
      ],
      "source_sentence_hash": "399c6903451f9e32f7884b101661ca00290424b719975aeeb796e0fe6d8a0584",
      "word_count": 7
    },
    {
      "text": "In general, prefer using common chart types",
      "section_path": [
        "Charting data",
        "Designing effective charts"
      ],
      "source_sentence_hash": "c3a9e3d8a5b4b72f3b30704ef4deee1c11216d77ed20ad2dd24502e94f699155",
      "word_count": 7
    },
    {
      "text": "If you need to create a chart that presents data in a novel way, help people learn how to",
      "section_path": [
        "Charting data",
        "Designing effective charts"
      ],
      "source_sentence_hash": "180cd98491b6eb0ed02c316d9549a148f4895324732204229b48aaf8c2d52fb8",
      "word_count": 19
    },
    {
      "text": "Examine the data from multiple levels or perspectives to find details you can display to enhance the chart",
      "section_path": [
        "Charting data",
        "Designing effective charts"
      ],
      "source_sentence_hash": "b3e543629770405f6cbf0921edfab5f46cc7c70a6a72696f8546a96b8ca9ac79",
      "word_count": 18
    },
    {
      "text": "Aid comprehension by adding descriptive text to the chart",
      "section_path": [
        "Charting data",
        "Designing effective charts"
      ],
      "source_sentence_hash": "1ea3055978335d3a066445ee795c08d89b86146947715c9ee9ca37659fa5a35e",
      "word_count": 9
    },
    {
      "text": "Match the size of a chart to its functionality, topic, and level of detail",
      "section_path": [
        "Charting data",
        "Designing effective charts"
      ],
      "source_sentence_hash": "99f9a8d6b697dea9178196102c79d1b4885bca6eb7fde5506aa0c99d98df9743",
      "word_count": 14
    },
    {
      "text": "Prefer consistency across multiple charts, deviating only when you need to highlight differences",
      "section_path": [
        "Charting data",
        "Designing effective charts"
      ],
      "source_sentence_hash": "8cd0b6fdda9756a632b81e2569768bd5712184f173cdc3b1a85898ca186aff86",
      "word_count": 13
    },
    {
      "text": "Maintain continuity among multiple charts that use the same data",
      "section_path": [
        "Charting data",
        "Designing effective charts"
      ],
      "source_sentence_hash": "08e008397226f5a6afb5bee50dc29e3d99e7b719b3c0863d5a2bebfd20ef6d9a",
      "word_count": 10
