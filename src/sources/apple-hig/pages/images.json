  "guidance_candidates": [
    {
      "text": "Provide high-resolution assets for all bitmap images in your app, for every device you support",
      "section_path": [
        "Images",
        "Resolution"
      ],
      "source_sentence_hash": "14d73c205e3fe7be7fe9c427d58f06d63bac4f726002cf99a62aacaea866381b",
      "word_count": 15
    },
    {
      "text": "In general, design images at the lowest resolution and scale them up to create high-resolution assets",
      "section_path": [
        "Images",
        "Resolution"
      ],
      "source_sentence_hash": "aeb611bc25bb46cb5be04fb37bced0882a735be9c9757a511e1f1c84f7ec51eb",
      "word_count": 16
    },
    {
      "text": "Include a color profile with each image",
      "section_path": [
        "Images",
        "Best practices"
      ],
      "source_sentence_hash": "17cb3fe0705ea3bd5323e40532db03620ce6b6f2a5f623c420aa816852b68c16",
      "word_count": 7
    },
    {
      "text": "Always test images on a range of actual devices",
      "section_path": [
        "Images",
        "Best practices"
      ],
      "source_sentence_hash": "ef39e3e5e6b703828d867b415b3dbd48c380607f663a4d5dd4aaa7b435ab7d67",
      "word_count": 9
    },
    {
      "text": "Parallax effect",
      "section_path": [
        "Images",
        "Platform considerations",
        "tvOS",
        "Parallax effect"
      ],
      "source_sentence_hash": "7a58279ba0197f1ead3ad683d5d366f976007fc911e1c00aca184b30a1c40f95",
      "word_count": 2
    },
    {
      "text": "Layered images",
      "section_path": [
        "Images",
        "Platform considerations",
        "tvOS",
        "Layered images"
      ],
      "source_sentence_hash": "77f554d144c65720b4cb4f990a117fb076c4448af3bb08de90de55f2fb0643c6",
      "word_count": 2
    },
    {
      "text": "Use standard interface elements to display layered images",
      "section_path": [
        "Images",
        "Platform considerations",
        "tvOS",
        "Layered images"
      ],
      "source_sentence_hash": "9c5f631c8f91ac7c703d0a97b0e2f38752dcccc5344072e713838a86f7618a4b",
      "word_count": 8
    },
    {
      "text": "Identify logical foreground, middle, and background elements",
      "section_path": [
        "Images",
        "Platform considerations",
        "tvOS",
        "Layered images"
      ],
      "source_sentence_hash": "83f8aa63c19b1900a439a9b58db1ab4a4c9b95ef99d5e6309accebd6194cf6a6",
      "word_count": 7
    },
    {
      "text": "Generally, keep text in the foreground",
      "section_path": [
        "Images",
        "Platform considerations",
        "tvOS",
        "Layered images"
      ],
      "source_sentence_hash": "5bf6bb67eded82bca9a8b84a7d77b6a1f2514ffcc7cb000a536d70cc44a0488a",
      "word_count": 6
    },
    {
      "text": "Keep the background layer opaque",
      "section_path": [
        "Images",
        "Platform considerations",
        "tvOS",
        "Layered images"
      ],
      "source_sentence_hash": "17f16bb1a14a38252d10c635d06b19b452aa8738b5912d2e5346065c25ff7651",
      "word_count": 5
    },
    {
      "text": "Keep layering simple and subtle",
      "section_path": [
        "Images",
        "Platform considerations",
        "tvOS",
        "Layered images"
      ],
      "source_sentence_hash": "7b1ab014b695c557ec9bdd65646fde54636eb8df7f600e2d84f5b0bec29b3e93",
      "word_count": 5
    },
    {
      "text": "Leave a safe zone around the foreground layers of your image",
      "section_path": [
        "Images",
        "Platform considerations",
        "tvOS",
        "Layered images"
      ],
      "source_sentence_hash": "0dbe7b335f55de64e6a7bef3182d5fd0f106d5e8e2d9fd0dc756b9e115679fe7",
      "word_count": 11
    },
    {
      "text": "Always preview layered images",
      "section_path": [
        "Images",
        "Platform considerations",
        "tvOS",
        "Layered images"
      ],
      "source_sentence_hash": "adc92d0b5d20dbbaeed297b77da3b796b7a0c6d57d5427c6eeabf22ed825ad36",
      "word_count": 4
    },
    {
      "text": "Create a layered app icon",
      "section_path": [
        "Images",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "0d96f752daaed34164c8ee0970847f922499ae516dee6c5c63894020b8a21b8f",
      "word_count": 5
    },
    {
      "text": "Prefer vector-based art for 2D images",
      "section_path": [
        "Images",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "5b81628d498f22f55dde31dc3f9e507de7d0ecfd2ae8f35aa37251591ad6ab7e",
      "word_count": 6
    },
    {
      "text": "If you need to use rasterized images, balance quality with performance as you choose a resolution",
      "section_path": [
        "Images",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "48641f4036ff9c04bebac09066a56ef5d261edb78c8362c6d2b558c3e9ff6e36",
      "word_count": 16
    },
    {
      "text": "Spatial photos and spatial scenes",
      "section_path": [
        "Images",
        "Platform considerations",
        "visionOS",
        "Spatial photos and spatial scenes"
      ],
      "source_sentence_hash": "0efa8751d29ea8b74041442d91704433df29886fed38d8bfb4298ff6513d290c",
      "word_count": 5
    },
    {
      "text": "Make sure spatial photos render correctly in your app",
      "section_path": [
        "Images",
        "Platform considerations",
        "visionOS",
        "Spatial photos and spatial scenes"
      ],
      "source_sentence_hash": "dbd483934f7dea1416db8a7cc13e48f30f12b570b57ba4456696431ed8d2b305",
      "word_count": 9
    },
    {
      "text": "Prefer the feathered glass background effect to display text over spatial photos",
      "section_path": [
        "Images",
        "Platform considerations",
        "visionOS",
        "Spatial photos and spatial scenes"
      ],
      "source_sentence_hash": "9026f90d951d798da618a3790b4445f49140950ab79993a60d8abb8504a9a4dc",
      "word_count": 12
    },
    {
      "text": "Take visual comfort into consideration when you make spatial photos from existing 2D content",
      "section_path": [
        "Images",
        "Platform considerations",
        "visionOS",
        "Spatial photos and spatial scenes"
      ],
      "source_sentence_hash": "9410ae4074555e9c61a7fbf6b4a66789bf9cc9acec07333882856b58fc1bba7f",
      "word_count": 14
    },
    {
      "text": "Display spatial photos and spatial scenes in standalone views",
      "section_path": [
        "Images",
        "Platform considerations",
        "visionOS",
        "Spatial photos and spatial scenes"
      ],
      "source_sentence_hash": "5199d87dcdaebf597706100e764dbb3dac2d17d7ab4f7f042e58cfbe69c80975",
      "word_count": 9
    },
    {
      "text": "Use spatial scenes in your app for specific moments",
      "section_path": [
        "Images",
        "Platform considerations",
        "visionOS",
        "Spatial photos and spatial scenes"
      ],
      "source_sentence_hash": "40daea98e574f0f5757b7fefc7b3c91a625876a1dcea44356fbe80977035a241",
      "word_count": 9
    },
    {
      "text": "When displaying immersively, prefer minimal UI",
      "section_path": [
        "Images",
        "Platform considerations",
        "visionOS",
        "Spatial photos and spatial scenes"
      ],
      "source_sentence_hash": "d57e0c5857c224eb4503976297f85b31c35aa8f1e17a4eb7859e39d9717a6900",
      "word_count": 6
    },
    {
      "text": "Prefer displaying larger spatial scenes that you center in someone’s field of view",
      "section_path": [
        "Images",
        "Platform considerations",
        "visionOS",
        "Spatial photos and spatial scenes"
      ],
      "source_sentence_hash": "ee1b9d21b0ccf8be16de8543c904edb2bc8b742f98c9f4c04be3fff5e3e3ca8d",
      "word_count": 13
    },
    {
      "text": "In general, avoid transparency to keep image files small",
      "section_path": [
        "Images",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "aaf1f53ed412fdb4e4f29f191566914678ebe07e7f14d7192f8ddf2e8781be96",
      "word_count": 9
    },
    {
      "text": "Use autoscaling PDFs to let you provide a single asset for all screen sizes",
      "section_path": [
        "Images",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "a7b98b3995399796e438e71ba408c41c6fcb28a06bd8aecfe049c8730487c7e1",
      "word_count": 14
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Images",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
