  "guidance_candidates": [
    {
      "text": "Even though all platforms except watchOS support physical game controllers, not every player might have access to one",
      "section_path": [
        "Game controls"
      ],
      "source_sentence_hash": "8b008cb6851047eb8d4f100fa5d794ac4f121b4993c55fe79a1238eeb35ccd01",
      "word_count": 18
    },
    {
      "text": "Players appreciate games that let them use the platform interaction method they’re most familiar with",
      "section_path": [
        "Game controls"
      ],
      "source_sentence_hash": "fdcc55db9be5cc8206b8d084d03386cada9b13cc71ab7b2b88765c3395c24dfe",
      "word_count": 15
    },
    {
      "text": "Determine whether it makes sense to display virtual controls on top of game content",
      "section_path": [
        "Game controls",
        "Touch controls"
      ],
      "source_sentence_hash": "8045e1c5f4e0cdac4ee1623423953dee0caa9f4bb8af9cf5c5fc260700c44aea",
      "word_count": 14
    },
    {
      "text": "Place virtual buttons where they’re easy to access",
      "section_path": [
        "Game controls",
        "Touch controls"
      ],
      "source_sentence_hash": "8351eb1f09b8022befef4c730ac35a9f107e68a647a66e66f480810ae8c07b2e",
      "word_count": 8
    },
    {
      "text": "Make sure controls are large enough",
      "section_path": [
        "Game controls",
        "Touch controls"
      ],
      "source_sentence_hash": "16f767e48047c135869bbded3af48351b5e51a7c36f52dc93acf96764ffdfe35",
      "word_count": 6
    },
    {
      "text": "Always include visible and tactile press states",
      "section_path": [
        "Game controls",
        "Touch controls"
      ],
      "source_sentence_hash": "390f249ef78e45b262e145be768751f147081a266ecae5053f33e5a5598fbeba",
      "word_count": 7
    },
    {
      "text": "Use symbols that communicate the actions they perform",
      "section_path": [
        "Game controls",
        "Touch controls"
      ],
      "source_sentence_hash": "0afdbce57d043b5201669ed08c97f89a99ff74644d34b1ed60154cf73ce3acc4",
      "word_count": 8
    },
    {
      "text": "Show and hide virtual controls to reflect gameplay",
      "section_path": [
        "Game controls",
        "Touch controls"
      ],
      "source_sentence_hash": "45d0619bf495f598b592af4c3ef8bb18cf3afaa7845ffaee49454eb60b56dcfe",
      "word_count": 8
    },
    {
      "text": "Combine functionality into a single control",
      "section_path": [
        "Game controls",
        "Touch controls"
      ],
      "source_sentence_hash": "0db28ad5366e01db9e2b468bea50ba0b258d90aa320e2387823858629193bf61",
      "word_count": 6
    },
    {
      "text": "Map movement and camera controls to predictable behavior",
      "section_path": [
        "Game controls",
        "Touch controls"
      ],
      "source_sentence_hash": "ccb7884621f4b19e15659bcdccdbe9e92951fa8649c70393c69f35426d157cfe",
      "word_count": 8
    },
    {
      "text": "Support the platform’s default interaction method",
      "section_path": [
        "Game controls",
        "Physical controllers"
      ],
      "source_sentence_hash": "6e5482baacfa584f3fccd6ad3cd579a966213b00c8b2f5fd6cd8177ec1450c7e",
      "word_count": 6
    },
    {
      "text": "Tell people about game controller requirements",
      "section_path": [
        "Game controls",
        "Physical controllers"
      ],
      "source_sentence_hash": "024c4d867f6fef9f1982dbd5b5d4da47a8e9d2bbf2a5de7a3a47e3473a88e750",
      "word_count": 6
    },
    {
      "text": "Automatically detect whether a controller is paired",
      "section_path": [
        "Game controls",
        "Physical controllers"
      ],
      "source_sentence_hash": "a4e27759fcff39955803687d3cba4c6889da13cc200b1d0bf1c79966aa461bb7",
      "word_count": 7
    },
    {
      "text": "Customize onscreen content to match the connected game controller",
      "section_path": [
        "Game controls",
        "Physical controllers"
      ],
      "source_sentence_hash": "5daab59934572293091c866ada9f7811509e2d906d56b0d38f06704399c8bf65",
      "word_count": 9
    },
    {
      "text": "Map controller buttons to expected UI behavior",
      "section_path": [
        "Game controls",
        "Physical controllers"
      ],
      "source_sentence_hash": "cfb22eac910ba30b5cc998a601c7baba5cb7d84e6ed18983f3ca15ffd9c07a41",
      "word_count": 7
    },
    {
      "text": "Support multiple connected controllers",
      "section_path": [
        "Game controls",
        "Physical controllers"
      ],
      "source_sentence_hash": "17de3036cfd09643f7409103a97bc2694a2029b8b15f077f72654bf0871d9bd6",
      "word_count": 4
    },
    {
      "text": "Prefer using symbols, not text, to refer to game controller elements",
      "section_path": [
        "Game controls",
        "Physical controllers"
      ],
      "source_sentence_hash": "8ade6941e1dd8ca3f37c4a66ea831a18f2522b4aade5547828e254b03f927d13",
      "word_count": 11
    },
    {
      "text": "Prioritize single-key commands",
      "section_path": [
        "Game controls",
        "Keyboards"
      ],
      "source_sentence_hash": "7b9f835d8447d9aaca86f9007c3a2343e75a2ca54a6142eb7cbadd84fe5a06ff",
      "word_count": 3
    },
    {
      "text": "Test key binding comfort game using an Apple keyboard",
      "section_path": [
        "Game controls",
        "Keyboards"
      ],
      "source_sentence_hash": "1025e4c5f06a92750de55f04fe6c4a4cbdddc2b1bd9f96fd16a0920fc16edfa6",
      "word_count": 9
    },
    {
      "text": "Take the proximity of keys into account",
      "section_path": [
        "Game controls",
        "Keyboards"
      ],
      "source_sentence_hash": "08bd1b5a792bed64732f4af212c34f76a2f6919d225bb5f37b61c2e6dcbde3fc",
      "word_count": 7
    },
    {
      "text": "Let players customize key bindings",
      "section_path": [
        "Game controls",
        "Keyboards"
      ],
      "source_sentence_hash": "83214683c89626f25627f61390a278bdb5daa7cb470c30ef80cc4a4edd47d59e",
      "word_count": 5
    },
    {
      "text": "Match spatial game controller behavior to hand input",
      "section_path": [
        "Game controls",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "e93afe82398bfafd6d2acc9e41a3a1e8dbc1f830d051183ee650c3c32b408e52",
      "word_count": 8
    },
    {
      "text": "Support looking at an object and pressing a controller trigger to interact indirectly",
      "section_path": [
        "Game controls",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "e93afe82398bfafd6d2acc9e41a3a1e8dbc1f830d051183ee650c3c32b408e52",
      "word_count": 13
    },
    {
      "text": "Support reaching out and pressing a controller trigger to interact directly",
      "section_path": [
        "Game controls",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "e93afe82398bfafd6d2acc9e41a3a1e8dbc1f830d051183ee650c3c32b408e52",
      "word_count": 11
    },
    {
      "text": "Use a single virtual touch control for related functionality",
      "section_path": [
        "Game controls",
        "Touch controls"
      ],
      "source_sentence_hash": "0db28ad5366e01db9e2b468bea50ba0b258d90aa320e2387823858629193bf61",
      "word_count": 9
    },
    {
      "text": "Use predictable movement and camera control behavior",
      "section_path": [
        "Game controls",
        "Touch controls"
      ],
      "source_sentence_hash": "ccb7884621f4b19e15659bcdccdbe9e92951fa8649c70393c69f35426d157cfe",
      "word_count": 7
    },
    {
      "text": "Warn people when a physical game controller is required",
      "section_path": [
        "Game controls",
        "Physical controllers"
      ],
      "source_sentence_hash": "024c4d867f6fef9f1982dbd5b5d4da47a8e9d2bbf2a5de7a3a47e3473a88e750",
      "word_count": 9
    },
    {
      "text": "Use automatic detection for paired game controllers",
      "section_path": [
        "Game controls",
        "Physical controllers"
      ],
      "source_sentence_hash": "a4e27759fcff39955803687d3cba4c6889da13cc200b1d0bf1c79966aa461bb7",
      "word_count": 7
    },
    {
      "text": "Match onscreen content to the connected game controller",
      "section_path": [
        "Game controls",
        "Physical controllers"
      ],
      "source_sentence_hash": "5daab59934572293091c866ada9f7811509e2d906d56b0d38f06704399c8bf65",
      "word_count": 8
    },
    {
      "text": "Use expected UI behavior for physical-controller buttons",
      "section_path": [
        "Game controls",
        "Physical controllers"
      ],
      "source_sentence_hash": "cfb22eac910ba30b5cc998a601c7baba5cb7d84e6ed18983f3ca15ffd9c07a41",
      "word_count": 7
    },
    {
      "text": "Keep physical key proximity in mind for game bindings",
      "section_path": [
        "Game controls",
        "Keyboards"
      ],
      "source_sentence_hash": "08bd1b5a792bed64732f4af212c34f76a2f6919d225bb5f37b61c2e6dcbde3fc",
      "word_count": 9
    },
    {
      "text": "Ensure virtual buttons don't overlap system features",
      "section_path": [
        "Game controls",
        "Touch controls"
      ],
      "source_sentence_hash": "9abde37ac15b9818c61b075dcddb5060dfa0cef442e40f1ded57e4543997e7b7",
      "word_count": 7
    },
    {
      "text": "Ensure interface labels match the connected controller",
      "section_path": [
        "Game controls",
        "Physical controllers"
      ],
      "source_sentence_hash": "e8388b272024d42d918d6be3fa490a5e50b83028d9d4151bc8d772ed2396adfc",
      "word_count": 7
    },
    {
      "text": "Avoid abstract or controller-named artwork for virtual controls",
      "section_path": [
        "Game controls",
        "Touch controls"
      ],
      "source_sentence_hash": "5861ab4f0cb999e22cf4ac5c8d02f19e8c5b87511543935527aeabbadc128308",
      "word_count": 8
    },
    {
      "text": "Avoid game-control features on watchOS",
      "section_path": [
        "Game controls",
        "Platform considerations"
      ],
      "source_sentence_hash": "21eab31707fe04c1fdf29260ea5ac1bacd4b165d2de91f4f0f2000a2af0a1b25",
      "word_count": 6
    },
