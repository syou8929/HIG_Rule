  "guidance_candidates": [
    {
      "text": "Sharing contextual information",
      "section_path": [
        "Siri",
        "Getting your app to work with Siri",
        "Sharing contextual information"
      ],
      "source_sentence_hash": "c8856588f0b43be1a7756158ff843c7f5a3581a3a365faf29ff4c0d7424fcb4c",
      "word_count": 3
    },
    {
      "text": "Identify your app’s most popular actions, and when and where they occur",
      "section_path": [
        "Siri",
        "Best practices"
      ],
      "source_sentence_hash": "848a69717452344d6e372ad287d2676f6c5706d2130c8dc9a138a09e30bbe8c0",
      "word_count": 12
    },
    {
      "text": "Use familiar terms for your content and actions",
      "section_path": [
        "Siri",
        "Best practices"
      ],
      "source_sentence_hash": "8690cc9cf044d3f8e9e2379b4073bd7948e25782c710084bb0864952399d0d35",
      "word_count": 8
    },
    {
      "text": "Offer relevant content",
      "section_path": [
        "Siri",
        "Best practices"
      ],
      "source_sentence_hash": "1b15136da99dc3db9a26dc7b2598d9c70472562754059f0f719485d9651816a5",
      "word_count": 3
    },
    {
      "text": "Don’t advertise",
      "section_path": [
        "Siri",
        "Best practices"
      ],
      "source_sentence_hash": "21e0c33674ed6333b133ca172e078e232c8d287e219e61ab67b34e0c20516240",
      "word_count": 2
    },
    {
      "text": "Only provide a custom response if built-in responses don’t meet your app’s needs",
      "section_path": [
        "Siri",
        "Best practices"
      ],
      "source_sentence_hash": "422a9beaed8b941fe7660004ea30ae3630b948acb5532c74f3bb491c14dea25e",
      "word_count": 13
    },
    {
      "text": "Write response dialogue that’s clear and descriptive",
      "section_path": [
        "Siri",
        "Customizing your app’s experience with Siri"
      ],
      "source_sentence_hash": "dd74bfe11588fee8ceed9dc411060b07bc1fbb79def2b168209a7f9b87f33fae",
      "word_count": 7
    },
    {
      "text": "Keep responses as succinct as possible",
      "section_path": [
        "Siri",
        "Customizing your app’s experience with Siri"
      ],
      "source_sentence_hash": "3e75e554f769df42f6f8adebc6fc85e02bbdf39aceaa7bd4fa78308b55b3cdd7",
      "word_count": 6
    },
    {
      "text": "Provide responses that Siri can deliver audibly and visually",
      "section_path": [
        "Siri",
        "Customizing your app’s experience with Siri"
      ],
      "source_sentence_hash": "4a4420bdac16b6206040691459ac914acf539d87427819586cc7881fa0f00b70",
      "word_count": 9
    },
    {
      "text": "Design inclusive interactions",
      "section_path": [
        "Siri",
        "Customizing your app’s experience with Siri"
      ],
      "source_sentence_hash": "5e5955d46c35ceb4cf58c78d41c5921b20d30b799bd381668c74a6a3bd6a107b",
      "word_count": 3
    },
    {
      "text": "Ask an open-ended question when the full list of options is too long",
      "section_path": [
        "Siri",
        "Customizing your app’s experience with Siri"
      ],
      "source_sentence_hash": "014cb795b5af85ac69aae2c48b44b45f2c3e81eb3daaf47065b8ad164ecc05d3",
      "word_count": 13
    },
    {
      "text": "Keep responses device-independent whenever possible",
      "section_path": [
        "Siri",
        "Customizing your app’s experience with Siri"
      ],
      "source_sentence_hash": "ac8f41dcd80a918e1d4de5254082e684e226f5507e6434fdd5f38a7fc3b99728",
      "word_count": 5
    },
    {
      "text": "Omit your app name from responses",
      "section_path": [
        "Siri",
        "Customizing your app’s experience with Siri"
      ],
      "source_sentence_hash": "4a7f8ce8280dcf240476fa48e73b0e237c5de988583d591be872d57f0d5b6697",
      "word_count": 6
    },
    {
      "text": "Use appropriate language and respect parental controls",
      "section_path": [
        "Siri",
        "Customizing your app’s experience with Siri"
      ],
      "source_sentence_hash": "528b600d3e654f918e20fe93d5afeb67b8f477e7710c9acdaff40b21692aef6b",
      "word_count": 7
    },
    {
      "text": "Help people understand errors and failures",
      "section_path": [
        "Siri",
        "Customizing your app’s experience with Siri"
      ],
      "source_sentence_hash": "9e442f654f0fb08cc61d19364b54abfbade3f90735c121a67d87ce02d2697016",
      "word_count": 6
    },
    {
      "text": "Refer to Siri by name",
      "section_path": [
        "Siri",
        "Editorial guidelines"
      ],
      "source_sentence_hash": "4b1020ed437c612b0f83ab059a31562dd22619d8d4e4ab992b47826f2f0ba934",
      "word_count": 5
    },
    {
      "text": "Be aware that the system reserves important actions and phrases for Siri",
      "section_path": [
        "Siri",
        "Editorial guidelines"
      ],
      "source_sentence_hash": "634a01be57133ed2281b84fdce5123dc8d6bfafaa3b21d40cc0d611233bf5334",
      "word_count": 12
    },
    {
      "text": "In a localized context, translate only the word Hey in the phrase “Hey Siri.”",
      "section_path": [
        "Siri",
        "Editorial guidelines"
      ],
      "source_sentence_hash": "c85c143fd8a920625865564cd4e1639db4aae27de654a68f00da73142c643d68",
      "word_count": 14
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Siri",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
