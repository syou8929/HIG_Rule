  "guidance_candidates": [
    {
      "text": "Prefer using standard gestures to perform standard actions",
      "section_path": [
        "Remotes",
        "Best practices"
      ],
      "source_sentence_hash": "f529839c20138298b3abe868421b756df9bc27702c303b498964e114c671ec7b",
      "word_count": 8
    },
    {
      "text": "Be consistent with the tvOS focus experience",
      "section_path": [
        "Remotes",
        "Best practices"
      ],
      "source_sentence_hash": "bfdfb0b7bc5bb670102883e989ff75914abadaf1990f124391f26512808173be",
      "word_count": 7
    },
    {
      "text": "Provide clear feedback that shows people what happens when they make gestures in your app",
      "section_path": [
        "Remotes",
        "Best practices"
      ],
      "source_sentence_hash": "661fc37a62950f5be8c8192107929b97944976eb1971e7c51387805ac165fa25",
      "word_count": 15
    },
    {
      "text": "Define new gestures only when it makes sense in your app",
      "section_path": [
        "Remotes",
        "Best practices"
      ],
      "source_sentence_hash": "3dc1f921e4c34d0f629c3cf51d79985a67f3542bfed2e83db23162ac1b4669d4",
      "word_count": 11
    },
    {
      "text": "Distinguish intentional presses from taps",
      "section_path": [
        "Remotes",
        "Best practices"
      ],
      "source_sentence_hash": "f773459ee924c053e76741ae0e5faa77f5459290b551b3d00f58e0da343923b3",
      "word_count": 5
    },
    {
      "text": "Avoid responding to inadvertent remote taps",
      "section_path": [
        "Remotes",
        "Best practices"
      ],
      "source_sentence_hash": "f773459ee924c053e76741ae0e5faa77f5459290b551b3d00f58e0da343923b3",
      "word_count": 6
    },
    {
      "text": "Consider using the position of a tap to aid with navigation or gameplay",
      "section_path": [
        "Remotes",
        "Best practices"
      ],
      "source_sentence_hash": "5b1f361d3c2752567c58af30a547265fcba9b84c96b0414d6f746f8a8f867ef7",
      "word_count": 13
    },
    {
      "text": "Use Back to open the parent screen in almost all cases",
      "section_path": [
        "Remotes",
        "Best practices"
      ],
      "source_sentence_hash": "4bcd5c02b266c524acd4b96967c07203e017c8fa9c34f6a6737ec29f93eca2bf",
      "word_count": 11
    },
    {
      "text": "Use Back to open an in-game pause menu during active gameplay",
      "section_path": [
        "Remotes",
        "Best practices"
      ],
      "source_sentence_hash": "4bcd5c02b266c524acd4b96967c07203e017c8fa9c34f6a6737ec29f93eca2bf",
      "word_count": 11
    },
    {
      "text": "Use Back to close the in-game pause menu and resume gameplay",
      "section_path": [
        "Remotes",
        "Best practices"
      ],
      "source_sentence_hash": "4bcd5c02b266c524acd4b96967c07203e017c8fa9c34f6a6737ec29f93eca2bf",
      "word_count": 11
    },
    {
      "text": "Respond correctly to the Play/Pause button during media playback",
      "section_path": [
        "Remotes",
        "Best practices"
      ],
      "source_sentence_hash": "2e5aadfa288a31a82c961d2b1eeadd7faab8a34db5eaa1861021bb2ef5bf6ba2",
      "word_count": 9
    },
    {
      "text": "Use touch surface swipes to navigate or change focus in an app",
      "section_path": [
        "Remotes",
        "Buttons"
      ],
      "source_sentence_hash": "0c315a21cd7f07c506e788c1d4aa62980f2d26413114ad1955405fa589c9b920",
      "word_count": 12
    },
    {
      "text": "Use touch surface swipes for directional pad behavior in a game",
      "section_path": [
        "Remotes",
        "Buttons"
      ],
      "source_sentence_hash": "0c315a21cd7f07c506e788c1d4aa62980f2d26413114ad1955405fa589c9b920",
      "word_count": 11
    },
    {
      "text": "Use touch surface presses to activate controls or navigate deeper in an app",
      "section_path": [
        "Remotes",
        "Buttons"
      ],
      "source_sentence_hash": "ab55b4d790098c18126243f5806498684a4f05f63e2c9afe85ff01c2747ef571",
      "word_count": 13
    },
    {
      "text": "Use touch surface presses for primary button behavior in a game",
      "section_path": [
        "Remotes",
        "Buttons"
      ],
      "source_sentence_hash": "ab55b4d790098c18126243f5806498684a4f05f63e2c9afe85ff01c2747ef571",
      "word_count": 11
    },
    {
      "text": "Use Back to return to the previous screen or Home in an app",
      "section_path": [
        "Remotes",
        "Buttons"
      ],
      "source_sentence_hash": "699575b940705f1d7d3ce66d6f48e9172b0b6dd3aec1edcc3625c334ac6df06b",
      "word_count": 13
    },
    {
      "text": "Use Back to pause or resume gameplay or navigate outward in a game",
      "section_path": [
        "Remotes",
        "Buttons"
      ],
      "source_sentence_hash": "699575b940705f1d7d3ce66d6f48e9172b0b6dd3aec1edcc3625c334ac6df06b",
      "word_count": 13
    },
    {
      "text": "Use Play/Pause for secondary button behavior or intro skipping in a game",
      "section_path": [
        "Remotes",
        "Buttons"
      ],
      "source_sentence_hash": "0a00b5bd719cc63ca9201b00651e75c515166291b052014a6b067abd41e21347",
      "word_count": 12
    },
    {
      "text": "Use guide or browse button presses to open an app's EPG",
      "section_path": [
        "Remotes",
        "Compatible remotes"
      ],
      "source_sentence_hash": "77b32b89f302945bae87fa449068c0e59080f0918fc5429f4e5af36d94a39d01",
      "word_count": 11
    },
    {
      "text": "Use page up or page down buttons to navigate an open EPG",
      "section_path": [
        "Remotes",
        "Compatible remotes"
      ],
      "source_sentence_hash": "77b32b89f302945bae87fa449068c0e59080f0918fc5429f4e5af36d94a39d01",
      "word_count": 12
    },
    {
      "text": "Avoid repurposing EPG-browsing buttons while the EPG is open",
      "section_path": [
        "Remotes",
        "Compatible remotes"
      ],
      "source_sentence_hash": "77b32b89f302945bae87fa449068c0e59080f0918fc5429f4e5af36d94a39d01",
      "word_count": 9
    },
    {
      "text": "Change channels for page up or page down during content playback",
      "section_path": [
        "Remotes",
        "Compatible remotes"
      ],
      "source_sentence_hash": "2272ddeddeab99c4d7af0e573842f679c2eec6cc2a9bf4b010976bcdb52aeeec",
      "word_count": 11
    }
  ],
