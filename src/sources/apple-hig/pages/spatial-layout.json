  "guidance_candidates": [
    {
      "text": "Center important content within the field of view",
      "section_path": [
        "Spatial layout",
        "Field of view"
      ],
      "source_sentence_hash": "88656a70bb8c817f02ee5069e6c2c3b6ba8771040d9cc93d8c8e9a696cebeb0c",
      "word_count": 8
    },
    {
      "text": "Avoid anchoring content to the wearer’s head",
      "section_path": [
        "Spatial layout",
        "Field of view"
      ],
      "source_sentence_hash": "48aeb18a424a17abe9b4d1ef6fc3439fd50ff81b77a4f7874be7d1b12f877274",
      "word_count": 7
    },
    {
      "text": "Provide visual cues that accurately communicate the depth of your content",
      "section_path": [
        "Spatial layout",
        "Depth"
      ],
      "source_sentence_hash": "72c78d72e426c3e11682ecdfe0fc60fdf5e9cbdeec075959d337a25b0fa1278c",
      "word_count": 11
    },
    {
      "text": "Use depth to communicate hierarchy",
      "section_path": [
        "Spatial layout",
        "Depth"
      ],
      "source_sentence_hash": "8b1755450c4a685336de5d2c44d25600a5f5a4112decca4d072ee70ff80c6fa3",
      "word_count": 5
    },
    {
      "text": "In general, avoid adding depth to text",
      "section_path": [
        "Spatial layout",
        "Depth"
      ],
      "source_sentence_hash": "8622587e1d7c0f88b47176099c8802d0add8c7aa7efc3f1840bad229d742a78f",
      "word_count": 7
    },
    {
      "text": "Make sure depth adds value",
      "section_path": [
        "Spatial layout",
        "Depth"
      ],
      "source_sentence_hash": "33a1d2b5e86ef81b1b3ad53f83e2328c7a49a2bf676e7e55fbd817f0d8c09311",
      "word_count": 5
    },
    {
      "text": "Consider using fixed scale when you want a virtual object to look exactly like a physical object",
      "section_path": [
        "Spatial layout",
        "Scale"
      ],
      "source_sentence_hash": "2555cd00d97d5f7ce15ece72f35258a83297d06da511982d975c27652c509351",
      "word_count": 17
    },
    {
      "text": "Avoid displaying too many windows",
      "section_path": [
        "Spatial layout",
        "Best practices"
      ],
      "source_sentence_hash": "fb23221d977ea651d6932a52c47e24b33c0db96ff9ac557529649fbd75c93b72",
      "word_count": 5
    },
    {
      "text": "Prioritize standard, indirect gestures",
      "section_path": [
        "Spatial layout",
        "Best practices"
      ],
      "source_sentence_hash": "6ced9651be4e8369da23df3ceb36f101f6f92871810f431cb3b12ac987f815b5",
      "word_count": 4
    },
    {
      "text": "Rely on the Digital Crown to help people recenter windows in their field of view",
      "section_path": [
        "Spatial layout",
        "Best practices"
      ],
      "source_sentence_hash": "2e6f391e9a75b52134e085761b7838001a005eeae14103bb5323d139a9eaa870",
      "word_count": 15
    },
    {
      "text": "Include enough space around interactive components to make them easy for people to look at",
      "section_path": [
        "Spatial layout",
        "Best practices"
      ],
      "source_sentence_hash": "6c82d684f34207f73689e98feddfeba7413b98c1ae23ba007d3231c742d6b2a3",
      "word_count": 15
    },
    {
      "text": "Let people use your app with minimal or no physical movement",
      "section_path": [
        "Spatial layout",
        "Best practices"
      ],
      "source_sentence_hash": "2178b357cb90b40930d3d8075c5fba6f97d93825ca4190fbb61da93fd3b214d1",
      "word_count": 11
    },
    {
      "text": "Use the floor to help you place a large immersive experience",
      "section_path": [
        "Spatial layout",
        "Best practices"
      ],
      "source_sentence_hash": "3bc16a091e516688bac12c2bd95cdc667443e821aea156db60a49eecc304c12f",
      "word_count": 11
    },
    {
      "text": "Developer documentation",
      "section_path": [
