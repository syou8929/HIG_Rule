  "guidance_candidates": [
    {
      "text": "Design loading to avoid disrupting or harming the user experience",
      "section_path": [
        "Loading"
      ],
      "source_sentence_hash": "53f70a051d8ecdbb57859f6516a97f36c6348c24f64748cf5cb6af8a2f4e5757",
      "word_count": 10
    },
    {
      "text": "Show something as soon as possible",
      "section_path": [
        "Loading",
        "Best practices"
      ],
      "source_sentence_hash": "138f3c448e8006e254f1d84d16daba58249c2b22a1646dd41f4928c336a170dc",
      "word_count": 6
    },
    {
      "text": "Consider placeholder text, graphics, or animations while content loads",
      "section_path": [
        "Loading",
        "Best practices"
      ],
      "source_sentence_hash": "0b2bfcdc33b3af49ea021d96991e78f2fc7f8ad3712e98b9f2dcd4ae50f5e2f1",
      "word_count": 9
    },
    {
      "text": "Let people do other things in your app or game while they wait for content to load",
      "section_path": [
        "Loading",
        "Best practices"
      ],
      "source_sentence_hash": "f027c490910d93a64b9112f93f7b2c74903f2b5953ff2e485cc376b8f1e92529",
      "word_count": 17
    },
    {
      "text": "Give people interesting content during unavoidably long loading",
      "section_path": [
        "Loading",
        "Best practices"
      ],
      "source_sentence_hash": "ae9cb15c0745da9a3851bd9c3dc49c7d8193f352f9459f5b388620b08727ca93",
      "word_count": 8
    },
    {
      "text": "Communicate remaining loading time as accurately as possible",
      "section_path": [
        "Loading",
        "Best practices"
      ],
      "source_sentence_hash": "c5dae293b87b866982e8a28176c2f6e17b0071b4b4aec27e37b90de9fe897203",
      "word_count": 8
    },
    {
      "text": "Use background downloads for large assets to improve installation and launch time",
      "section_path": [
        "Loading",
        "Best practices"
      ],
      "source_sentence_hash": "4b8e8b8c44c6d3b4c7905289c2958b8ad4d146d5d59e49632da7f53709d7bee1",
      "word_count": 12
    },
    {
      "text": "Clearly communicate that content is loading and how long it might take to complete",
      "section_path": [
        "Loading",
        "Showing progress"
      ],
      "source_sentence_hash": "faee42e281d4f5b9249f57571670fc0706d2f5e07162b81fe00957943b3def73",
      "word_count": 14
    },
    {
      "text": "Use determinate indicators for known durations and indeterminate indicators for unknown durations",
      "section_path": [
        "Loading",
        "Showing progress"
      ],
      "source_sentence_hash": "51854166384c63ca3aae5949d972ad2e18644406826f459dbc6292b88d67c5b8",
      "word_count": 12
    },
    {
      "text": "For games, consider creating a custom loading view",
      "section_path": [
        "Loading",
        "Showing progress"
      ],
      "source_sentence_hash": "cbb1c4022ac3adb69298c5fed9029739bf43900b1db5a1b613c128389fa1521a",
      "word_count": 8
    },
    {
      "text": "As much as possible, avoid showing a loading indicator in your watchOS experience",
      "section_path": [
        "Loading",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "eb62e80bd865ccd510315bf00c45ae9146995a1ea972a96ba89d4a3c890192a1",
      "word_count": 13
    },
    {
      "text": "Aim to display watchOS content immediately",
      "section_path": [
        "Loading",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "d8c1367d99a95641a723be0e36b5d9272c6f9881f05013d7bb4ef26ed3c0a308",
      "word_count": 6
    },
    {
      "text": "Prefer a loading indicator to a blank watchOS screen during brief loading",
      "section_path": [
        "Loading",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "d8c1367d99a95641a723be0e36b5d9272c6f9881f05013d7bb4ef26ed3c0a308",
      "word_count": 12
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Loading",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
