  "guidance_candidates": [
    {
      "text": "Adjust levels automatically when necessary — don’t adjust the overall volume",
      "section_path": [
        "Playing audio",
        "Best practices"
      ],
      "source_sentence_hash": "15e51b7874585c7cbe10da09eeb2f6a2dd0b9863f47fda214fb11e2dc693071d",
      "word_count": 11
    },
    {
      "text": "Permit rerouting of audio when possible",
      "section_path": [
        "Playing audio",
        "Best practices"
      ],
      "source_sentence_hash": "9030b181e43b3fc62b01f710df5969156afd60446ffc749cec46696b25965f13",
      "word_count": 6
    },
    {
      "text": "Use the system-provided volume view to let people make audio adjustments",
      "section_path": [
        "Playing audio",
        "Best practices"
      ],
      "source_sentence_hash": "937ed5f8a06ebdd9c119e1d5497e1fd740c54ffcc9e6901b32adb50e26c6957a",
      "word_count": 11
    },
    {
      "text": "Choose an audio category that fits the way your app or game uses sound",
      "section_path": [
        "Playing audio",
        "Best practices"
      ],
      "source_sentence_hash": "244df2a2d6f869f177570e12f98cbbf9a2e8232a5273b44b498e167b7b4fe238",
      "word_count": 14
    },
    {
      "text": "Respond to audio controls only when it makes sense",
      "section_path": [
        "Playing audio",
        "Best practices"
      ],
      "source_sentence_hash": "dec3ef51f4f981484f5d58a33e7adb1ae07d7d86383c32fe0dc72dcddc33b41d",
      "word_count": 9
    },
    {
      "text": "Avoid repurposing audio controls",
      "section_path": [
        "Playing audio",
        "Best practices"
      ],
      "source_sentence_hash": "53605f8ac0bec8afbc69912d0950c258ea9121b23bb3659876ae3c87bdc55a53",
      "word_count": 4
    },
    {
      "text": "Consider creating custom audio player controls only if you need to offer commands that the system doesn’t support",
      "section_path": [
        "Playing audio",
        "Best practices"
      ],
      "source_sentence_hash": "4d736bd34c00c3cbb310b8696cbc52c17e66dc2b9f62b85a185a2a526163e1a1",
      "word_count": 18
    },
    {
      "text": "Let other apps know when your app finishes playing temporary audio",
      "section_path": [
        "Playing audio",
        "Best practices"
      ],
      "source_sentence_hash": "95af83c74447dfb1462a8ccd1bc3cc748833c9f6d783912af6be78d0dd3a7f6c",
      "word_count": 11
    },
    {
      "text": "Determine how to respond to audio-session interruptions",
      "section_path": [
        "Playing audio",
        "Handling interruptions"
      ],
      "source_sentence_hash": "8d84138757fc90ac3205c447bc5aeba6ffdae797ddbf37a5781fd2e386a1caf8",
      "word_count": 7
    },
    {
      "text": "When an interruption ends, determine whether to resume audio playback automatically",
      "section_path": [
        "Playing audio",
        "Handling interruptions"
      ],
      "source_sentence_hash": "bd013e9235b1d096428140d1698b26274b55791be81b98c3a19fc296a1cba6d7",
      "word_count": 11
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "Playing audio",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "Use the system’s sound services to play short sounds and vibrations",
      "section_path": [
        "Playing audio",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "fd11890fdec0307d83e6627c3a695cd7e8f9d3fba2ab5973dc9612a6bacd0e5d",
      "word_count": 11
    },
    {
      "text": "Prefer playing sound",
      "section_path": [
        "Playing audio",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "6c2ca0f2992ef4ec8dc6f841204f3c1fb6abbe9e37b7f2785cbea5177856cff0",
      "word_count": 3
    },
    {
      "text": "Design custom sounds for custom UI elements",
      "section_path": [
        "Playing audio",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "f3c4f49463c3e7614f8aef9285a2d5e74d8069cd8c5ecb87cdd48d3914e98d78",
      "word_count": 7
    },
    {
      "text": "Use Spatial Audio to create an intuitive, engaging experience",
      "section_path": [
        "Playing audio",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "cf20672f5742eaad61add187e023147b62b3e0fb3596634b410f5e1358b6ba3b",
      "word_count": 9
    },
    {
      "text": "Consider defining a range of places from which your app sounds can originate",
      "section_path": [
        "Playing audio",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "d1b2df1762a3b7644f61683bb23ed872186a91d05821cab5f0f43d2a21d27381",
      "word_count": 13
    },
    {
      "text": "Consider varying sounds that people could perceive as repetitive over time",
      "section_path": [
        "Playing audio",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "0c014e7e0e523289b1f75ab1fe7b7f443081d305bd0813b7dbccd34474e5f188",
      "word_count": 11
    },
    {
      "text": "Decide whether you need to play sound that’s fixed to the wearer or tracked by the wearer",
      "section_path": [
        "Playing audio",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "8a0252881e204030402d64faa0c0b860c6d139988b0a4639bfc55e6ec3c6d2ff",
      "word_count": 17
    },
    {
      "text": "Use the recommended encoding values for media assets",
      "section_path": [
        "Playing audio",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "20243faff73a3e9f94011424c8549755ec7bbcfc23bb524e65692a9d1532c8c5",
      "word_count": 8
    },
    {
