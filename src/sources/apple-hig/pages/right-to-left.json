  "guidance_candidates": [
    {
      "text": "Adjust text alignment to match the interface direction, if the system doesn’t do so automatically",
      "section_path": [
        "Right to left",
        "Text alignment"
      ],
      "source_sentence_hash": "49bb88b11e73b88bb88d184bd28c8528b74fd280a3dd989516cb4c279501dd7f",
      "word_count": 15
    },
    {
      "text": "Align a paragraph based on its language, not on the current context",
      "section_path": [
        "Right to left",
        "Text alignment"
      ],
      "source_sentence_hash": "3fe9e97e407ab9b8c706c87ee19a55cfe88cbb8bdeffb8a4029e669cef1d4cec",
      "word_count": 12
    },
    {
      "text": "Use a consistent alignment for all text items in a list",
      "section_path": [
        "Right to left",
        "Text alignment"
      ],
      "source_sentence_hash": "807a9f278806df1219043be49a7032f6c8510d59861c1203672dec1af77fc9fb",
      "word_count": 11
    },
    {
      "text": "Don’t reverse the order of numerals in a specific number",
      "section_path": [
        "Right to left",
        "Numbers and characters"
      ],
      "source_sentence_hash": "f739bb824f1b40cf1a31a0dc97e9a73debd56aac5159f5dad18cce1946dc668d",
      "word_count": 10
    },
    {
      "text": "Reverse the order of numerals that show progress or a counting direction; never flip the numerals themselves",
      "section_path": [
        "Right to left",
        "Numbers and characters"
      ],
      "source_sentence_hash": "455aa9f4cffb043311680207ee0e6d33435911a33411ab1739bbc541e618eac0",
      "word_count": 17
    },
    {
      "text": "Flip controls that show progress from one value to another",
      "section_path": [
        "Right to left",
        "Controls"
      ],
      "source_sentence_hash": "bbeac0fc71bb893ef389c92434edd2971f479817b56e2abe04a8d6ecfbee4fbc",
      "word_count": 10
    },
    {
      "text": "Flip controls that help people navigate or access items in a fixed order",
      "section_path": [
        "Right to left",
        "Controls"
      ],
      "source_sentence_hash": "296ab419363ec604b0b41b10cf728b61799521b97cc3d938640ae4ac28af09b1",
      "word_count": 13
    },
    {
      "text": "Preserve the direction of a control that refers to an actual direction or points to an onscreen area",
      "section_path": [
        "Right to left",
        "Controls"
      ],
      "source_sentence_hash": "cf3c1476cd3e4683f6f43829fbcab66f55d51b12faab4610bbba50354c43cccf",
      "word_count": 18
    },
    {
      "text": "Visually balance adjacent Latin and RTL scripts when necessary",
      "section_path": [
        "Right to left",
        "Controls"
      ],
      "source_sentence_hash": "daa1dc2acf6f205d5078cd7c83cf518af87c2e6f5ab7908f9476934e9b06f82c",
      "word_count": 9
    },
    {
      "text": "Avoid flipping images like photographs, illustrations, and general artwork",
      "section_path": [
        "Right to left",
        "Images"
      ],
      "source_sentence_hash": "9f11411dc26d439849a742ded5aaac701924dbb42e2fd0fde072e542fd520457",
      "word_count": 9
    },
    {
      "text": "Reverse the positions of images when their order is meaningful",
      "section_path": [
        "Right to left",
        "Images"
      ],
      "source_sentence_hash": "206ea5cb0e07e435425dda7bc7187f6e38d85f932a24d42e486b2e8ebd4989b9",
      "word_count": 10
    },
    {
      "text": "Flip interface icons that represent text or reading direction",
      "section_path": [
        "Right to left",
        "Interface icons"
      ],
      "source_sentence_hash": "6aac670a1162326d04f3ab8c14295eeea62ab82235cdcaa7dbbc0075e04b8176",
      "word_count": 9
    },
    {
      "text": "Consider creating a localized version of an interface icon that displays text",
      "section_path": [
        "Right to left",
        "Interface icons"
      ],
      "source_sentence_hash": "aa89a255b1bc574c9e34d80a23ec94a90a69de75764324b529b2b9b23829a703",
      "word_count": 12
    },
    {
      "text": "Flip an interface icon that shows forward or backward motion",
      "section_path": [
        "Right to left",
        "Interface icons"
      ],
      "source_sentence_hash": "e84916ac419ae747202c635096e2d73f2afe5daf6c5f82721b1bf5b028960524",
      "word_count": 10
    },
    {
      "text": "Don’t flip logos or universal signs and marks",
      "section_path": [
        "Right to left",
        "Interface icons"
      ],
      "source_sentence_hash": "d6e8b6f52831dc19db328dc2480336bfcf6e4086c447f1c8b7ee3531df96ac49",
      "word_count": 8
    },
    {
      "text": "In general, avoid flipping interface icons that depict real-world objects",
      "section_path": [
        "Right to left",
        "Interface icons"
      ],
      "source_sentence_hash": "c28eae42b5d2f5afd9450672f9c0981b425e1e8314b0e2f409b9745d0318f610",
      "word_count": 10
    },
    {
      "text": "Before merely flipping a complex custom interface icon, consider its individual components and the overall visual balance",
      "section_path": [
        "Right to left",
        "Interface icons"
      ],
      "source_sentence_hash": "f7a39c804a981c5412e0d44fc3d2e9d591d6ef396dd0101887f3419c8b7a977e",
      "word_count": 17
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Right to left",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
