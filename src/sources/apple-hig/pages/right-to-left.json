  "guidance_candidates": [
    {
      "text": "Match text alignment to interface direction when the system doesn’t do so automatically",
      "section_path": [
        "Right to left",
        "Text alignment"
      ],
      "source_sentence_hash": "49bb88b11e73b88bb88d184bd28c8528b74fd280a3dd989516cb4c279501dd7f",
      "word_count": 13
    },
    {
      "text": "Match paragraph alignment to its language rather than the current interface direction",
      "section_path": [
        "Right to left",
        "Text alignment"
      ],
      "source_sentence_hash": "3fe9e97e407ab9b8c706c87ee19a55cfe88cbb8bdeffb8a4029e669cef1d4cec",
      "word_count": 12
    },
    {
      "text": "Use a consistent alignment for all text items in a list",
      "section_path": [
        "Right to left",
        "Text alignment"
      ],
      "source_sentence_hash": "807a9f278806df1219043be49a7032f6c8510d59861c1203672dec1af77fc9fb",
      "word_count": 11
    },
    {
      "text": "Identify locale-appropriate number representations for number-centric content",
      "section_path": [
        "Right to left",
        "Numbers and characters"
      ],
      "source_sentence_hash": "45817f663668510482bc4572507b9f54f74052b1066daf7b671d18d9b72756dd",
      "word_count": 7
    },
    {
      "text": "Consider system-provided number representations for content that isn’t number-centric",
      "section_path": [
        "Right to left",
        "Numbers and characters"
      ],
      "source_sentence_hash": "45817f663668510482bc4572507b9f54f74052b1066daf7b671d18d9b72756dd",
      "word_count": 9
    },
    {
      "text": "Don’t reverse the order of numerals in a specific number",
      "section_path": [
        "Right to left",
        "Numbers and characters"
      ],
      "source_sentence_hash": "f739bb824f1b40cf1a31a0dc97e9a73debd56aac5159f5dad18cce1946dc668d",
      "word_count": 10
    },
    {
      "text": "Be sure to reverse numeral sequences that show progress or counting direction",
      "section_path": [
        "Right to left",
        "Numbers and characters"
      ],
      "source_sentence_hash": "455aa9f4cffb043311680207ee0e6d33435911a33411ab1739bbc541e618eac0",
      "word_count": 12
    },
    {
      "text": "Never flip numeral glyphs themselves",
      "section_path": [
        "Right to left",
        "Numbers and characters"
      ],
      "source_sentence_hash": "455aa9f4cffb043311680207ee0e6d33435911a33411ab1739bbc541e618eac0",
      "word_count": 5
    },
    {
      "text": "Match progress-control direction to the reading direction",
      "section_path": [
        "Right to left",
        "Controls"
      ],
      "source_sentence_hash": "bbeac0fc71bb893ef389c92434edd2971f479817b56e2abe04a8d6ecfbee4fbc",
      "word_count": 7
    },
    {
      "text": "Be sure to reverse accompanying start and end glyph positions when flipping a progress control",
      "section_path": [
        "Right to left",
        "Controls"
      ],
      "source_sentence_hash": "bbeac0fc71bb893ef389c92434edd2971f479817b56e2abe04a8d6ecfbee4fbc",
      "word_count": 15
    },
    {
      "text": "Ensure fixed-order navigation controls flip to match RTL reading order",
      "section_path": [
        "Right to left",
        "Controls"
      ],
      "source_sentence_hash": "296ab419363ec604b0b41b10cf728b61799521b97cc3d938640ae4ac28af09b1",
      "word_count": 10
    },
    {
      "text": "Preserve the direction of a control that refers to an actual direction or points to an onscreen area",
      "section_path": [
        "Right to left",
        "Controls"
      ],
      "source_sentence_hash": "cf3c1476cd3e4683f6f43829fbcab66f55d51b12faab4610bbba50354c43cccf",
      "word_count": 18
    },
    {
      "text": "Match the visual size of adjacent Latin and RTL scripts when necessary",
      "section_path": [
        "Right to left",
        "Controls"
      ],
      "source_sentence_hash": "daa1dc2acf6f205d5078cd7c83cf518af87c2e6f5ab7908f9476934e9b06f82c",
      "word_count": 12
    },
    {
      "text": "Avoid flipping images like photographs, illustrations, and general artwork",
      "section_path": [
        "Right to left",
        "Images"
      ],
      "source_sentence_hash": "9f11411dc26d439849a742ded5aaac701924dbb42e2fd0fde072e542fd520457",
      "word_count": 9
    },
    {
      "text": "Consider creating a new image when content is strongly connected to reading direction",
      "section_path": [
        "Right to left",
        "Images"
      ],
      "source_sentence_hash": "9f11411dc26d439849a742ded5aaac701924dbb42e2fd0fde072e542fd520457",
      "word_count": 13
    },
    {
      "text": "Preserve meaningful image order by reversing positions in RTL contexts",
      "section_path": [
        "Right to left",
        "Images"
      ],
      "source_sentence_hash": "206ea5cb0e07e435425dda7bc7187f6e38d85f932a24d42e486b2e8ebd4989b9",
      "word_count": 10
    },
    {
      "text": "Consider specifying directionality for custom symbols",
      "section_path": [
        "Right to left",
        "Interface icons"
      ],
      "source_sentence_hash": "3c42afacddcf5c3785b836a4ff5d16937e86590979d8d9e107083cab110c6c0e",
      "word_count": 6
    },
    {
      "text": "Match text or reading-direction icons to the RTL context",
      "section_path": [
        "Right to left",
        "Interface icons"
      ],
      "source_sentence_hash": "6aac670a1162326d04f3ab8c14295eeea62ab82235cdcaa7dbbc0075e04b8176",
      "word_count": 9
    },
    {
      "text": "Consider creating a localized version of an interface icon that displays text",
      "section_path": [
        "Right to left",
        "Interface icons"
      ],
      "source_sentence_hash": "aa89a255b1bc574c9e34d80a23ec94a90a69de75764324b529b2b9b23829a703",
      "word_count": 12
    },
    {
      "text": "Consider a text-free alternative for custom icon text unrelated to reading or writing",
      "section_path": [
        "Right to left",
        "Interface icons"
      ],
      "source_sentence_hash": "0f4ad028da50e019cde731e247f47f8c82e84503d995b34ac520d120e81a2350",
      "word_count": 13
    },
    {
      "text": "Ensure forward or backward motion icons flip in RTL contexts",
      "section_path": [
        "Right to left",
        "Interface icons"
      ],
      "source_sentence_hash": "e84916ac419ae747202c635096e2d73f2afe5daf6c5f82721b1bf5b028960524",
      "word_count": 10
    },
    {
      "text": "Always display logos in their original form",
      "section_path": [
        "Right to left",
        "Interface icons"
      ],
      "source_sentence_hash": "d6e8b6f52831dc19db328dc2480336bfcf6e4086c447f1c8b7ee3531df96ac49",
      "word_count": 7
    },
    {
      "text": "Avoid flipping universal signs and marks",
      "section_path": [
        "Right to left",
        "Interface icons"
      ],
      "source_sentence_hash": "d6e8b6f52831dc19db328dc2480336bfcf6e4086c447f1c8b7ee3531df96ac49",
      "word_count": 6
    },
    {
      "text": "In general, avoid flipping interface icons that depict real-world objects",
      "section_path": [
        "Right to left",
        "Interface icons"
      ],
      "source_sentence_hash": "c28eae42b5d2f5afd9450672f9c0981b425e1e8314b0e2f409b9745d0318f610",
      "word_count": 10
    },
    {
      "text": "Consider components and visual balance before flipping a complex custom interface icon",
      "section_path": [
        "Right to left",
        "Interface icons"
      ],
      "source_sentence_hash": "f7a39c804a981c5412e0d44fc3d2e9d591d6ef396dd0101887f3419c8b7a977e",
      "word_count": 12
    },
    {
      "text": "Ensure localization-independent icon components preserve their visual design language",
      "section_path": [
        "Right to left",
        "Interface icons"
      ],
      "source_sentence_hash": "f7a39c804a981c5412e0d44fc3d2e9d591d6ef396dd0101887f3419c8b7a977e",
      "word_count": 9
    },
    {
      "text": "Ensure UI-representing icon badges flip when the represented interface flips",
      "section_path": [
        "Right to left",
        "Interface icons"
      ],
      "source_sentence_hash": "806295562c6df0486639a872989b03dc81832ac1fdfad8ef7a57afe878122356",
      "word_count": 10
    },
    {
      "text": "Consider whether flipping a meaning-modifying badge preserves meaning and visual balance",
      "section_path": [
        "Right to left",
        "Interface icons"
      ],
      "source_sentence_hash": "806295562c6df0486639a872989b03dc81832ac1fdfad8ef7a57afe878122356",
      "word_count": 11
    },
    {
      "text": "Consider preserving a handed tool’s orientation while flipping its icon base",
      "section_path": [
        "Right to left",
        "Interface icons"
      ],
      "source_sentence_hash": "f2533be8bce337ffa251117468be8577cfc5bfe140e2eb1aabd63aeca8efc32d",
      "word_count": 11
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Right to left",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
