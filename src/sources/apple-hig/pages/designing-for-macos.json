      "word_count": 3
    },
    {
      "text": "Dock menus",
      "section_path": [
        "Designing for macOS"
      ],
      "source_sentence_hash": "987cecf6d0f6fe46aa526032882f1e2dd45af72ac2572f2aae11f0fda1fe0150",
      "word_count": 2
    },
    {
      "text": "Use large macOS displays to present more content with fewer nested levels and less modality",
      "section_path": [
        "Designing for macOS",
        "Best practices"
      ],
      "source_sentence_hash": "b39a916493b246db689d3692e2fef2c0da9c106cd7f23606a788470466fd0a1d",
      "word_count": 15
    },
    {
      "text": "Let people resize, hide, show, and move your windows to fit their work style and device configuration, and support",
      "section_path": [
        "Designing for macOS",
        "Best practices"
      ],
      "source_sentence_hash": "a46d15e34b586f31b2a6d0b17e58055f26825ed80b1e81df08de3cdce82c36f6",
      "word_count": 19
    },
    {
      "text": "Support full-screen mode to provide a distraction-free macOS context",
      "section_path": [
        "Designing for macOS",
        "Best practices"
      ],
      "source_sentence_hash": "a46d15e34b586f31b2a6d0b17e58055f26825ed80b1e81df08de3cdce82c36f6",
      "word_count": 9
    },
    {
      "text": "Use the menu bar to give people easy access to all the commands they need to do things in",
      "section_path": [
        "Designing for macOS",
        "Best practices"
      ],
      "source_sentence_hash": "5f18e984e3492b26876c737cc437bbba6b0460ecc32e802d49cb7889acdd5089",
      "word_count": 19
    },
    {
      "text": "Help people take advantage of high-precision input modes to perform pixel-perfect selections and edits",
      "section_path": [
        "Designing for macOS",
        "Best practices"
      ],
      "source_sentence_hash": "f0502d022b8820ba9715b39bdbab2e7ca7a4b2ce1213b734d9740acd7fd4bf09",
      "word_count": 14
    },
    {
      "text": "Support macOS keyboard shortcuts for faster actions and keyboard-only work styles",
      "section_path": [
        "Designing for macOS",
        "Best practices"
      ],
      "source_sentence_hash": "b89fe87be3bad07626b3e36360ce9efcd146224e4738c7457599315570f33d4b",
      "word_count": 11
    },
    {
      "text": "Support personalization, letting people customize toolbars, configure windows to display the views they use most, and choose the colors",
      "section_path": [
        "Designing for macOS",
        "Best practices"
      ],
      "source_sentence_hash": "ee79c04612fe83fe782fc4e46d6f243e6d09c52b2761b47f609c39f3353cc4d3",
      "word_count": 19
    },
