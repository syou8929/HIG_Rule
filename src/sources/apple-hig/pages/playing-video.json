  "guidance_candidates": [
    {
      "text": "Use the system video player to give people a familiar and convenient experience",
      "section_path": [
        "Playing video",
        "Best practices"
      ],
      "source_sentence_hash": "389d26988555e1bdb200f97ebc97270db6c468199f1cfd8b2a1cf19198445536",
      "word_count": 13
    },
    {
      "text": "Always display video content at its original aspect ratio",
      "section_path": [
        "Playing video",
        "Best practices"
      ],
      "source_sentence_hash": "0ee5529b707cbf9b9e92e21b46cb16ffe2b08923964da13b290a1c8a5420b48f",
      "word_count": 9
    },
    {
      "text": "Provide additional information when it adds value",
      "section_path": [
        "Playing video",
        "Best practices"
      ],
      "source_sentence_hash": "bb352de971b33973fc68b3b15774533f37ffe2f48c030a2a873f5b921c62c591",
      "word_count": 7
    },
    {
      "text": "Support the interactions people expect, regardless of the input device they’re using to control playback",
      "section_path": [
        "Playing video",
        "Best practices"
      ],
      "source_sentence_hash": "c9affdd0ef8b7e7882a88937498611310ae6942b8d266c53d799e17678bd67a8",
      "word_count": 15
    },
    {
      "text": "If people need to access playback options or content-specific information in your tvOS app, consider adding a transport control",
      "section_path": [
        "Playing video",
        "Best practices"
      ],
      "source_sentence_hash": "5d62201d1401a6cb7adfb25814bd3f59edf8c922fbe98f93e85ffd52ef09b2f9",
      "word_count": 19
    },
    {
      "text": "Avoid allowing audio from different sources to mix as viewers switch between modes",
      "section_path": [
        "Playing video",
        "Best practices"
      ],
      "source_sentence_hash": "4623a022ac051687b76f984f7f0b2f7e43da1f2088fbe1aad416ed2ed3367098",
      "word_count": 13
    },
    {
      "text": "Ensure a smooth transition to your app",
      "section_path": [
        "Playing video",
        "Integrating with the TV app"
      ],
      "source_sentence_hash": "4abf20e8cd2c397732fc525f9456c2ef1e81beb8bc5c279bd489bce1386c29be",
      "word_count": 7
    },
    {
      "text": "Show the expected content immediately",
      "section_path": [
        "Playing video",
        "Integrating with the TV app"
      ],
      "source_sentence_hash": "c5ccda5fc26d3a4dc4f168d3887fab173168a2e983f30f0be339846cf4e21ab3",
      "word_count": 5
    },
    {
      "text": "Avoid asking people if they want to resume playback",
      "section_path": [
        "Playing video",
        "Integrating with the TV app"
      ],
      "source_sentence_hash": "71863e2b6017858a61de43666f17fe0b5b574d40d4010faf3ed251ad86c54ca0",
      "word_count": 9
    },
    {
      "text": "Play or pause playback when people press Space on a connected Bluetooth keyboard",
      "section_path": [
        "Playing video",
        "Integrating with the TV app"
      ],
      "source_sentence_hash": "84ecac3c168451f35b5aa28f5d2a2daea567b165f58d7bb8df1cf0dd7dbf335d",
      "word_count": 13
    },
    {
      "text": "Make sure content plays for the correct viewer",
      "section_path": [
        "Playing video",
        "Integrating with the TV app"
      ],
      "source_sentence_hash": "7f430af874cf7b1c6bbda274209f212f05cd90ad37d702959074f198b4c63837",
      "word_count": 8
    },
    {
      "text": "Use the previous end time when resuming playback of a long video clip",
      "section_path": [
        "Playing video",
        "Integrating with the TV app"
      ],
      "source_sentence_hash": "ec9134e322b15470e98b93194e45c9e4b7601ef1529a1d91ecd0a2a279cb9966",
      "word_count": 13
    },
    {
      "text": "Loading content",
      "section_path": [
        "Playing video",
        "Integrating with the TV app",
        "Loading content"
      ],
      "source_sentence_hash": "d1049c5e8c3bbbf700f67b12b508be0875bd24d364a3a95ee6adc7f6bd77aaa2",
      "word_count": 2
    },
    {
      "text": "Avoid displaying loading screens when possible",
      "section_path": [
        "Playing video",
        "Integrating with the TV app",
        "Loading content"
      ],
      "source_sentence_hash": "d8a6a8fb6daf9443169738ed550e48033618f82950203df9c7e963ccb42353bb",
      "word_count": 6
    },
    {
      "text": "Start playback immediately",
      "section_path": [
        "Playing video",
        "Integrating with the TV app",
        "Loading content"
      ],
      "source_sentence_hash": "5ab472c77daae9a4da4709139cfdbcb33fe832e34db969f93634549c77338ea9",
      "word_count": 3
    },
    {
      "text": "Minimize loading screen content",
      "section_path": [
        "Playing video",
        "Integrating with the TV app",
        "Loading content"
      ],
      "source_sentence_hash": "a527faca465ac2423c655e0e734a93049c74530135e6883ad0e204b9d8b66a4b",
      "word_count": 4
    },
    {
      "text": "Exiting playback",
      "section_path": [
        "Playing video",
        "Integrating with the TV app",
        "Exiting playback"
      ],
      "source_sentence_hash": "1179f1ee86be19eb4ec3772ba8edc74cc4cf91ffd5e7548731938e3ad336ce66",
      "word_count": 2
    },
    {
      "text": "Show a contextually relevant screen",
      "section_path": [
        "Playing video",
        "Integrating with the TV app",
        "Exiting playback"
      ],
      "source_sentence_hash": "5463713a7f708cce84f7bc60897c8b19827952a3079afad20008e2db2cd23b59",
      "word_count": 5
    },
    {
      "text": "Be prepared for an immediate exit",
      "section_path": [
        "Playing video",
        "Integrating with the TV app",
        "Exiting playback"
      ],
      "source_sentence_hash": "ed332288a67714c2940cd447924a012ee138693d0557e2b0929ecad667ef42c2",
      "word_count": 6
    },
    {
      "text": "Defer to content when displaying logos or noninteractive overlays above video",
      "section_path": [
        "Playing video",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "52d02aa57a4e2f3f736a0e62befff6219a5d370ab1a2f191fcbfaca8e8ce2036",
      "word_count": 11
    },
    {
      "text": "Show interactive overlays gracefully",
      "section_path": [
        "Playing video",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "1927eaa395a0c0eed4e7421968edba84ae4988fb9fca3319487b626879be81b2",
      "word_count": 4
    },
    {
      "text": "Help people stay comfortable when playing video in your app",
      "section_path": [
        "Playing video",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "27babc06ff5c97b8cbf1b231263936e7bb6869511a0cf9d33eb99811c7c54abf",
      "word_count": 10
    },
    {
      "text": "In a fully immersive experience, avoid letting virtual content obscure playback or transport controls",
      "section_path": [
        "Playing video",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "afca18759aaf184db0a313ac3d9fe503eef8fa412c387a8239b4b482b14fd69f",
      "word_count": 14
    },
    {
      "text": "Avoid automatically starting a fully immersive video playback experience",
      "section_path": [
        "Playing video",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "3bb572ef5e57be017f82c9955d7d38ddabe41c7992dde2f487c700623cc60e0a",
      "word_count": 9
    },
    {
      "text": "Create a thumbnail track if you want to support scrubbing",
      "section_path": [
        "Playing video",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "20d19572817cd0444e0461a4ab1335312af76d1d0efb2b285f9de995307aba43",
      "word_count": 10
    },
    {
      "text": "Avoid expanding an inline video player to fill a window",
      "section_path": [
        "Playing video",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "6d1112c46b16d5730a6de06400e03f281c438dfccf13aaa6e07e276a70b62725",
      "word_count": 10
    },
    {
      "text": "Use a RealityKit video player if you need to play video in a view like a splash screen or",
      "section_path": [
        "Playing video",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "d66ea2485d8a37229003c65c1aae02c64dbc3245f16bba9de5de46b3f4b48773",
      "word_count": 19
    },
    {
      "text": "Keep video clips short",
      "section_path": [
        "Playing video",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "e7a7ee9fffbfd191a276b253e0cc5ecbc7daec2e838cd175b4466efa822d52a2",
      "word_count": 4
    },
    {
      "text": "Use the recommended sizes and encoding values for media assets",
      "section_path": [
        "Playing video",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "2bf41dc2401035f283222235c4f9828855a18e1e31456c841aa803f5c04ead6d",
      "word_count": 10
    },
    {
      "text": "Avoid creating a poster image that looks like a system control",
      "section_path": [
        "Playing video",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "f57b09928cf54575e9a87e1d8f7032ecf5acbc1b6991cb6f5c15f7354edc6a0e",
      "word_count": 11
    },
    {
      "text": "Consider creating a poster image that represents a video clip’s contents",
      "section_path": [
        "Playing video",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "c135dd903f1c8cea010fb850b00061f3e6573928b40558d6f83ce867037966c6",
      "word_count": 11
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Playing video",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
