  "guidance_candidates": [
    {
      "text": "Choose items deliberately to avoid overcrowding",
      "section_path": [
        "Toolbars",
        "Best practices"
      ],
      "source_sentence_hash": "fb26f4b8d4f9b69489fbd4053deec840b415829a0e0b62af0dfd05806ae99c54",
      "word_count": 6
    },
    {
      "text": "Add a More menu to contain additional actions",
      "section_path": [
        "Toolbars",
        "Best practices"
      ],
      "source_sentence_hash": "7d9b88e25da1249b78ad4ead2f707fcecd9852f60a0eed4aed87f7894167233f",
      "word_count": 8
    },
    {
      "text": "In iPadOS and macOS apps, consider letting people customize the toolbar to include their most common items",
      "section_path": [
        "Toolbars",
        "Best practices"
      ],
      "source_sentence_hash": "0d7119d3f3a98de10ba0b9bf65adbb8645b00bbfb8f0a27d607aa3b77f1aa4a7",
      "word_count": 17
    },
    {
      "text": "Reduce the use of toolbar backgrounds and tinted controls",
      "section_path": [
        "Toolbars",
        "Best practices"
      ],
      "source_sentence_hash": "1e1c56a2f4805c34b93e6182e5086b8a6a2dbcd91a52227e6b37e08316a3d5f7",
      "word_count": 9
    },
    {
      "text": "Avoid applying a similar color to toolbar item labels and content layer backgrounds",
      "section_path": [
        "Toolbars",
        "Best practices"
      ],
      "source_sentence_hash": "30fde731fc8279a8a75887ac55b0bb165cadf2f28dd88a4a22eef21e9da3b78a",
      "word_count": 13
    },
    {
      "text": "Prefer using standard components in a toolbar",
      "section_path": [
        "Toolbars",
        "Best practices"
      ],
      "source_sentence_hash": "7d82a25a7f21defccf251d2e5e8900d0cb0934ab1363bfd39601e5d06b67455b",
      "word_count": 7
    },
    {
      "text": "Consider temporarily hiding toolbars for a distraction-free experience",
      "section_path": [
        "Toolbars",
        "Best practices"
      ],
      "source_sentence_hash": "42dd1bd6af069d57905d19ec5c50ee1dfac13439ae9e0997d51809551bb416d1",
      "word_count": 8
    },
    {
      "text": "Provide a useful title for each window",
      "section_path": [
        "Toolbars",
        "Titles"
      ],
      "source_sentence_hash": "b9556cae9f1b1b272760667db27c49855bc63ae2d752f316bd58284ef641f1e9",
      "word_count": 7
    },
    {
      "text": "Don’t title windows with your app name",
      "section_path": [
        "Toolbars",
        "Titles"
      ],
      "source_sentence_hash": "56103a959b2596227247aeca2a8af5f8df1a12d7d7908c06738e3ff4dc8f7082",
      "word_count": 7
    },
    {
      "text": "Write a concise title",
      "section_path": [
        "Toolbars",
        "Titles"
      ],
      "source_sentence_hash": "0de39a27fb6c3152320e748fb4adac8c6fce637c7f92080b9c2351d2e80be18f",
      "word_count": 4
    },
    {
      "text": "Use the standard Back and Close buttons",
      "section_path": [
        "Toolbars",
        "Navigation"
      ],
      "source_sentence_hash": "026df5ea5fee6dac02ac10d6884ed1ca44311c3b996f44ecc963b1e3b93845e7",
      "word_count": 7
    },
    {
      "text": "Provide actions that support the main tasks people perform",
      "section_path": [
        "Toolbars",
        "Actions"
      ],
      "source_sentence_hash": "1a616cd04f710d9b0acebe49db5b4777bb7c5d87b8473be06f65c6293f7ab4f4",
      "word_count": 9
    },
    {
      "text": "Make sure the meaning of each control is clear",
      "section_path": [
        "Toolbars",
        "Actions"
      ],
      "source_sentence_hash": "bfeed9cfba4d272b38f52aa95880bac99ec5eb33e45b23ebe1f4fa8e687d7602",
      "word_count": 9
    },
    {
      "text": "Prefer system-provided symbols without borders",
      "section_path": [
        "Toolbars",
        "Actions"
      ],
      "source_sentence_hash": "6eaeaddfdecd47d867dd15bcdf432c4760920166646d918c144cfaa1fe1c879a",
      "word_count": 5
    },
    {
      "text": "Use the .prominent style for key actions such as Done or Submit",
      "section_path": [
        "Toolbars",
        "Actions"
      ],
      "source_sentence_hash": "d287ef0fb0b5f03ed191edd093a8af29e44d7209220331ee27c6323e6accd788",
      "word_count": 12
    },
    {
      "text": "Leading edge",
      "section_path": [
        "Toolbars",
        "Item groupings"
      ],
      "source_sentence_hash": "39b9e3b5c421f81b6a1428e567aff626c54051d849bcbda4998d567b1ce97bf2",
      "word_count": 2
    },
    {
      "text": "Center area",
      "section_path": [
        "Toolbars",
        "Item groupings"
      ],
      "source_sentence_hash": "460e112c59aba93635ac10f61a458fd7093123611ef68d7d2f8907aef2bf918a",
      "word_count": 2
    },
    {
      "text": "Trailing edge",
      "section_path": [
        "Toolbars",
        "Item groupings"
      ],
      "source_sentence_hash": "b187d65f8d0658e63ba56178df7242c34eafdb6242aac21914f922cd87258eca",
      "word_count": 2
    },
    {
      "text": "Group toolbar items logically by function and frequency of use",
      "section_path": [
        "Toolbars",
        "Item groupings"
      ],
      "source_sentence_hash": "1e03844fd38e003691528ec2ba4aa4f1d40cdc57218ca617e450a2047617859c",
      "word_count": 10
    },
    {
      "text": "Group navigation controls and critical actions like Done, Close, or Save in dedicated, familiar, and visually distinct sections",
      "section_path": [
        "Toolbars",
        "Item groupings"
      ],
      "source_sentence_hash": "00863c0aad6affb06d5b5b1316ec4ff5d2ac15db5b0f187ce8336c04e0c72aa2",
      "word_count": 18
    },
    {
      "text": "Keep consistent groupings and placement across platforms",
      "section_path": [
        "Toolbars",
        "Item groupings"
      ],
      "source_sentence_hash": "cd03ba1034d0b65e0fcc6cf8c8e7b87d3f23d26613e99a0e5a36245dde94270f",
      "word_count": 7
    },
    {
      "text": "Minimize the number of groups",
      "section_path": [
        "Toolbars",
        "Item groupings"
      ],
      "source_sentence_hash": "17ce1d614fd859578de1ea2eed5424ed59d25a3e30128e8f33a14fcc90b295e7",
      "word_count": 5
    },
    {
      "text": "Keep actions with text labels separate",
      "section_path": [
        "Toolbars",
        "Item groupings"
      ],
      "source_sentence_hash": "d788270e719ea8868b228e241b43203a124d8e8cd90ba4618eeeef9cca13d61e",
      "word_count": 6
    },
    {
      "text": "Prioritize only the most important items for inclusion in the main toolbar area",
      "section_path": [
        "Toolbars",
        "Platform considerations",
        "iOS"
      ],
      "source_sentence_hash": "251ef3bc84df76304d709873cc369d4605e2c6ae1164145dc5b6529195d3c44f",
      "word_count": 13
    },
    {
      "text": "Use a large title to help people stay oriented as they navigate and scroll",
      "section_path": [
        "Toolbars",
        "Platform considerations",
        "iOS"
      ],
      "source_sentence_hash": "dde3510716af9f417af3bd21136d922344131942554afffb8e6e5c36e6657946",
      "word_count": 14
    },
    {
      "text": "Consider combining a toolbar with a tab bar",
      "section_path": [
        "Toolbars",
        "Platform considerations",
        "iPadOS"
      ],
      "source_sentence_hash": "4fb2bd77c2fabb772aaeb418e34e668e4ed13d4d18f5984c757f11e2ed939080",
      "word_count": 8
    },
    {
      "text": "Make every toolbar item available as a command in the menu bar",
      "section_path": [
        "Toolbars",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "c4cf3e38fd41b70123e8156d09432d1e30b91ed0c0f2528ba9bdb48965745dc3",
      "word_count": 12
    },
    {
      "text": "Prefer using a system-provided toolbar",
      "section_path": [
        "Toolbars",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "a4c3b0c220e205654b713932076c3a560e63496957c24346ae97d036e41a7dea",
      "word_count": 5
    },
    {
      "text": "Avoid creating a vertical toolbar",
      "section_path": [
        "Toolbars",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "c09b7bd3dd3a18ec7a1b79c50d9b9c3031547084e25e64d47f1c005dacc724c8",
      "word_count": 5
    },
    {
      "text": "Try to prevent windows from resizing below the width of the toolbar",
      "section_path": [
        "Toolbars",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "bac703fb0757b07ec13ff4f005d31d82b8d61c2e8c52a87c8baac1aec4dbf59b",
      "word_count": 12
    },
    {
      "text": "If your app can enter a modal state, consider offering contextually relevant toolbar controls",
      "section_path": [
        "Toolbars",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "66c728a77e171408375f87a2a756efaded97ee99f3651158ef6b16d826aae03d",
      "word_count": 14
    },
    {
      "text": "Avoid using a pull-down menu in a toolbar",
      "section_path": [
        "Toolbars",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "f82d836da6e818377ad339bd04606ea380356d14f0549ef27cb5fc0fd9eb4bb9",
      "word_count": 8
    },
    {
      "text": "Use a scrolling toolbar button for an important action that isn’t a primary app function",
      "section_path": [
        "Toolbars",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "efe265e42a4a564f5e809b2d8b694d3a72972f975b8c15661890b830acc4c20b",
      "word_count": 15
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Toolbars",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
