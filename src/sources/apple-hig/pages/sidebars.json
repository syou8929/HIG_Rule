  "guidance_candidates": [
    {
      "text": "Extend visually rich content beneath the sidebar",
      "section_path": [
        "Sidebars",
        "Best practices"
      ],
      "source_sentence_hash": "5a9582153d0a5eb36d02366c28bbef41303d9a455c71b324b5ac1c2394c88037",
      "word_count": 7
    },
    {
      "text": "When possible, let people customize the contents of a sidebar",
      "section_path": [
        "Sidebars",
        "Best practices"
      ],
      "source_sentence_hash": "7b153ee7d5fdc3425967e78d2bc9073b8674d897f396008724c37907513b804b",
      "word_count": 10
    },
    {
      "text": "Group hierarchy with disclosure controls if your app has a lot of content",
      "section_path": [
        "Sidebars",
        "Best practices"
      ],
      "source_sentence_hash": "6b1e47eea1810081a21575982ae5623f78296ce478cbcc564cbc345b4a0dd27f",
      "word_count": 13
    },
    {
      "text": "Consider using familiar symbols to represent items in the sidebar",
      "section_path": [
        "Sidebars",
        "Best practices"
      ],
      "source_sentence_hash": "ac080e8900f129bc6a9406a410e26719fe54397cd1c640a99523bd5dff9c6ea9",
      "word_count": 10
    },
    {
      "text": "Consider letting people hide the sidebar",
      "section_path": [
        "Sidebars",
        "Best practices"
      ],
      "source_sentence_hash": "ad6087972a7c6cf7e64483fa2c10db7d2b5b4ef7d1fb66ad214d1152db9ad460",
      "word_count": 6
    },
    {
      "text": "In general, show no more than two levels of hierarchy in a sidebar",
      "section_path": [
        "Sidebars",
        "Best practices"
      ],
      "source_sentence_hash": "e49a3a75097d5fd1628e2a649490bc38d13f4a3b737a16a19289f4e8adb9c500",
      "word_count": 13
    },
    {
      "text": "If you need to include two levels of hierarchy in a sidebar, use succinct, descriptive labels to title each",
      "section_path": [
        "Sidebars",
        "Best practices"
      ],
      "source_sentence_hash": "2268869c0fe4f8b9165c19f19377bf576650a06b88bfb813a637395088366378",
      "word_count": 19
    },
    {
      "text": "Make sure any sidebar icon colors you choose serve a clear purpose",
      "section_path": [
        "Sidebars",
        "Best practices"
      ],
      "source_sentence_hash": "22745f76b81004ab484bb80406abbd827fd15d799da5b20670db801c469c191b",
      "word_count": 12
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "Sidebars",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "Consider using a tab bar first",
      "section_path": [
        "Sidebars",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "59fa673b5707db02022e720e16f4ac715733646c52355b8bfcedcb17fae53ee5",
      "word_count": 6
    },
    {
      "text": "If necessary, apply the correct appearance to a sidebar",
      "section_path": [
        "Sidebars",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "07bf7df1124e51367c5bb2e2330cf98eed5ad0765d18e5df9b5ec07909a0b5e0",
      "word_count": 9
    },
    {
      "text": "Consider automatically hiding and revealing a sidebar when its container window resizes",
      "section_path": [
        "Sidebars",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "f4c6d84311f39740bc90fe5ec158f905a0a617d4d3797d4f42862fa208c56c48",
      "word_count": 12
    },
    {
      "text": "Avoid putting critical information or actions at the bottom of a sidebar",
      "section_path": [
        "Sidebars",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "c7e3120cf0a525efcd1d48b0633ef132fb1749b57026d8751963051bcb2e3cd1",
      "word_count": 12
    },
    {
      "text": "If your app’s hierarchy is deep, consider using a sidebar within a tab in a tab bar",
      "section_path": [
        "Sidebars",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "48d2c2f742d2e82489801b62e1a40af2660fe0cf9ba3f94598d95d88ac27bd94",
      "word_count": 17
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Sidebars",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
