  "guidance_candidates": [
    {
      "text": "Give people more than one way to interact with your app",
      "section_path": [
        "Gestures",
        "Best practices"
      ],
      "source_sentence_hash": "73740bbe184b4e9557de33a0c76f2baba9705ffc05dbba18ab35bd39063178e6",
      "word_count": 11
    },
    {
      "text": "In general, respond to gestures in ways that are consistent with people’s expectations",
      "section_path": [
        "Gestures",
        "Best practices"
      ],
      "source_sentence_hash": "8d23fd312039505cc3c1afce5ddf21a7ec84174fa53385be894d521afa66d585",
      "word_count": 13
    },
    {
      "text": "Handle gestures as responsively as possible",
      "section_path": [
        "Gestures",
        "Best practices"
      ],
      "source_sentence_hash": "ae90680ef0cdde3399ebc9b9e641205a2c4187f7ed0d1acda11b7f5935830ae7",
      "word_count": 6
    },
    {
      "text": "Indicate when a gesture isn’t available",
      "section_path": [
        "Gestures",
        "Best practices"
      ],
      "source_sentence_hash": "4ffdab7a2cfedf33d276c8de08ac829c9852bef6a508b15c7481e5cb8f4d63db",
      "word_count": 6
    },
    {
      "text": "Add custom gestures only when necessary",
      "section_path": [
        "Gestures",
        "Custom gestures"
      ],
      "source_sentence_hash": "ba938aa945e659349fdd0404b4da2cfd9c71584176469a16216061d7825eca2e",
      "word_count": 6
    },
    {
      "text": "Straightforward to perform",
      "section_path": [
        "Gestures",
        "Custom gestures"
      ],
      "source_sentence_hash": "351ac9c6e9b2fb65cd2102975b3ca0e84075ee3c75394914f56c4a1179b6f6f4",
      "word_count": 3
    },
    {
      "text": "Distinct from other gestures",
      "section_path": [
        "Gestures",
        "Custom gestures"
      ],
      "source_sentence_hash": "58728180def4a5f25e13ecb52ff6e996f705295e4efcdb4a18dd27c3106bc4c4",
      "word_count": 4
    },
    {
      "text": "Not the only way to perform an important action in your app or game",
      "section_path": [
        "Gestures",
        "Custom gestures"
      ],
      "source_sentence_hash": "c4acbc2dde2ae962dd43f505fd41cc561d8f9b494692f57e0a9546d2008f1f12",
      "word_count": 14
    },
    {
      "text": "Make custom gestures easy to learn",
      "section_path": [
        "Gestures",
        "Custom gestures"
      ],
      "source_sentence_hash": "0b1591020325b68ae440e2b3413dd961102e48b5e5d696ec171ae0ee7330ae19",
      "word_count": 6
    },
    {
      "text": "Use shortcut gestures to supplement standard gestures, not replace them",
      "section_path": [
        "Gestures",
        "Custom gestures"
      ],
      "source_sentence_hash": "583c155cd6066b472ca6fdc995f037e9cca2d985485b6f0b4303747424600aab",
      "word_count": 10
    },
    {
      "text": "Avoid conflicting with gestures that access system UI",
      "section_path": [
        "Gestures",
        "Custom gestures"
      ],
      "source_sentence_hash": "e40455bf79688710a6966ed236e1f4b74b31ea1d5363910e5153c66b864bf4e6",
      "word_count": 8
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "Gestures",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "Consider allowing simultaneous recognition of multiple gestures if it enhances the experience",
      "section_path": [
        "Gestures",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "034449b904ba0c2a68469503398c781c3716f4786389ed5e7d75f09a041cdbe2",
      "word_count": 12
    },
    {
      "text": "Support standard gestures everywhere you can",
      "section_path": [
        "Gestures",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "9a1c33fefd5aeaa26024b050f1fe528a1ff9584d9bed607d6695ae9360299caf",
      "word_count": 6
    },
    {
      "text": "Offer both indirect and direct interactions when possible",
      "section_path": [
        "Gestures",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "137d81b60d38f79a9be491afabec329ceb60923cf965c11cd27b73444f5f3760",
      "word_count": 8
    },
    {
      "text": "Avoid requiring specific body movements or positions for input",
      "section_path": [
        "Gestures",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "bf06801b593e599dd5f2154f961e1fe4ea289b85c563747059d716546d87fe78",
      "word_count": 9
    },
    {
      "text": "Designing custom gestures in visionOS",
      "section_path": [
        "Gestures",
        "Platform considerations",
        "visionOS",
        "Designing custom gestures in visionOS"
      ],
      "source_sentence_hash": "b96e3052eb67887419f69d91ea48b54e8e6d080c60220cb79b1c77c328c04cf3",
      "word_count": 5
    },
    {
      "text": "Prioritize comfort",
      "section_path": [
        "Gestures",
        "Platform considerations",
        "visionOS",
        "Designing custom gestures in visionOS"
      ],
      "source_sentence_hash": "4e01b6389808861da60d686727eec0eb5e6f64eb4914543041152a6f8f404745",
      "word_count": 2
    },
    {
      "text": "Carefully consider complex custom gestures that involve multiple fingers or both hands",
      "section_path": [
        "Gestures",
        "Platform considerations",
        "visionOS",
        "Designing custom gestures in visionOS"
      ],
      "source_sentence_hash": "49bdc29fb8ccda4317e9e13a74d68b4a8686c01c51eb2e552dd090e29d93b127",
      "word_count": 12
    },
    {
      "text": "Avoid custom gestures that require using a specific hand",
      "section_path": [
        "Gestures",
        "Platform considerations",
        "visionOS",
        "Designing custom gestures in visionOS"
      ],
      "source_sentence_hash": "d41353d87ddc51357d97a520688dd617307a454e561c8e1056d3954a21ac605c",
      "word_count": 9
    },
    {
      "text": "Working with system overlays in visionOS",
      "section_path": [
        "Gestures",
        "Platform considerations",
        "visionOS",
        "Working with system overlays in visionOS"
      ],
      "source_sentence_hash": "e5ee8261a1cb36a2ec92d5eabe061a5451e208ef6ebcb7376fe09a7662ad28d3",
      "word_count": 6
    },
    {
      "text": "Reserve the area around a person’s hand for system overlays and their related gestures",
      "section_path": [
        "Gestures",
        "Platform considerations",
        "visionOS",
        "Working with system overlays in visionOS"
      ],
      "source_sentence_hash": "15c4ab91eaf867da541d48b6b2d45e110a9c04c1c76e492f9ce50ca74a9b8168",
      "word_count": 14
    },
    {
      "text": "Consider deferring the system overlay behavior when designing an immersive app or game",
      "section_path": [
        "Gestures",
        "Platform considerations",
        "visionOS",
        "Working with system overlays in visionOS"
      ],
      "source_sentence_hash": "874943f7b6bbac02e3815fc22a57a54b6700c88d81f667974f03ecc245f7fe24",
      "word_count": 13
    },
    {
      "text": "Use caution when designing custom gestures that involve a rolling motion of the hand, wrist, and forearm",
      "section_path": [
        "Gestures",
        "Platform considerations",
        "visionOS",
        "Working with system overlays in visionOS"
      ],
      "source_sentence_hash": "bc08ca79c9c9d3e160b207047bfc905e86c5cdd11378f1e542957e36b27d2f18",
      "word_count": 17
    },
    {
      "text": "Double tap",
      "section_path": [
        "Gestures",
        "Platform considerations",
        "watchOS",
        "Double tap"
      ],
      "source_sentence_hash": "b7f18903d7ca55dde65f4cd88cf7ee05ab86ce74e1fa4872bf6da4f569791574",
      "word_count": 2
    },
    {
      "text": "Avoid setting a primary action in views with lists, scroll views, or vertical tabs",
      "section_path": [
        "Gestures",
        "Platform considerations",
        "watchOS",
        "Double tap"
      ],
      "source_sentence_hash": "924b9c412e30bf73ae25a95c7ad6b51a40562247eb043f30d5c26da79d786dc3",
      "word_count": 14
    },
    {
      "text": "Choose the button that people use most commonly as the primary action in a view",
      "section_path": [
        "Gestures",
        "Platform considerations",
        "watchOS",
        "Double tap"
      ],
      "source_sentence_hash": "70f87f85703e17b25b6e8604fac4f83845bde5d80a14becd8da5937ffe5ba322",
      "word_count": 15
    },
    {
      "text": "Standard gestures",
      "section_path": [
        "Gestures",
        "Specifications",
        "Standard gestures"
      ],
      "source_sentence_hash": "44df3bb53bed1c8f5d3cc3ee05ada36219276f0d5996cf966d6c3220b790e529",
      "word_count": 2
    },
    {
      "text": "Avoid assuming people can use a specific gesture for a task",
      "section_path": [
        "Gestures",
        "Best practices"
      ],
      "source_sentence_hash": "5d938ba9ee08bb6fe2ef900d2f7bba7f0ea6bb6e82fe5948a1d7ed880da91fa1",
      "word_count": 11
    },
    {
      "text": "Respond to gestures in familiar, expectation-consistent ways",
      "section_path": [
        "Gestures",
        "Best practices"
      ],
      "source_sentence_hash": "cd76155edea277f7f4aa9cc06f687a26bfa3063b8d0005017ecb101ad12869ba",
      "word_count": 8
    },
    {
      "text": "Avoid using familiar gestures for unique app actions",
      "section_path": [
        "Gestures",
        "Best practices"
      ],
      "source_sentence_hash": "cd76155edea277f7f4aa9cc06f687a26bfa3063b8d0005017ecb101ad12869ba",
      "word_count": 8
    },
    {
      "text": "Avoid using unique gestures for standard actions",
      "section_path": [
        "Gestures",
        "Best practices"
      ],
      "source_sentence_hash": "cd76155edea277f7f4aa9cc06f687a26bfa3063b8d0005017ecb101ad12869ba",
      "word_count": 7
    },
    {
      "text": "Provide feedback that predicts a gesture’s result and required movement",
      "section_path": [
        "Gestures",
        "Best practices"
      ],
      "source_sentence_hash": "5cbcdce2295c6b709cc6383f7ffd08608ce3a6c23bb6eea89091692fdc32322a",
      "word_count": 10
    },
    {
      "text": "Respond to gestures as responsively as possible",
      "section_path": [
        "Gestures",
        "Best practices"
      ],
      "source_sentence_hash": "5cbcdce2295c6b709cc6383f7ffd08608ce3a6c23bb6eea89091692fdc32322a",
      "word_count": 7
    },
    {
      "text": "Make sure custom gestures are discoverable",
      "section_path": [
        "Gestures",
        "Custom gestures"
      ],
      "source_sentence_hash": "5ef47be0714eaa04997e99033d941695a95b044a98985e63d3eeb409c8ca444c",
      "word_count": 6
    },
    {
      "text": "Make sure custom gestures are straightforward to perform",
      "section_path": [
        "Gestures",
        "Custom gestures"
      ],
      "source_sentence_hash": "5ef47be0714eaa04997e99033d941695a95b044a98985e63d3eeb409c8ca444c",
      "word_count": 8
    },
    {
      "text": "Make sure custom gestures are distinct from other gestures",
      "section_path": [
        "Gestures",
        "Custom gestures"
      ],
      "source_sentence_hash": "5ef47be0714eaa04997e99033d941695a95b044a98985e63d3eeb409c8ca444c",
      "word_count": 9
    },
    {
      "text": "Make sure important actions have alternatives to custom gestures",
      "section_path": [
        "Gestures",
        "Custom gestures"
      ],
      "source_sentence_hash": "5ef47be0714eaa04997e99033d941695a95b044a98985e63d3eeb409c8ca444c",
      "word_count": 9
    },
    {
      "text": "Use custom gestures only when necessary",
      "section_path": [
        "Gestures",
        "Custom gestures"
      ],
      "source_sentence_hash": "5ef47be0714eaa04997e99033d941695a95b044a98985e63d3eeb409c8ca444c",
      "word_count": 6
    },
    {
      "text": "Make sure custom gestures are tested in real use scenarios",
      "section_path": [
        "Gestures",
        "Custom gestures"
      ],
      "source_sentence_hash": "19327dcad8449e5c2dc64258660bf5f97adc0e525031c47183d640ca9bc967e5",
      "word_count": 10
    },
    {
      "text": "Support expected iOS and iPadOS gesture mappings",
      "section_path": [
        "Gestures",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "680bf9f82529c9ff2bf2e37980795beed7ccf1ec2e9405a6c820dc8af9d4b04f",
      "word_count": 8
    },
    {
      "text": "Consider custom visionOS gestures only when system gestures cannot provide the interaction",
      "section_path": [
        "Gestures",
        "Platform considerations",
        "visionOS",
        "Designing custom gestures in visionOS"
      ],
      "source_sentence_hash": "c9093b1a40216847db4b2c1ed8e2f5b80035735b18b728f7923e9a67b0dc59af",
      "word_count": 12
    },
    {
      "text": "You need to run custom visionOS gestures in a Full Space",
      "section_path": [
        "Gestures",
        "Platform considerations",
        "visionOS",
        "Designing custom gestures in visionOS"
      ],
      "source_sentence_hash": "c9093b1a40216847db4b2c1ed8e2f5b80035735b18b728f7923e9a67b0dc59af",
      "word_count": 11
    },
    {
      "text": "You must request permission to access hand information",
      "section_path": [
        "Gestures",
        "Platform considerations",
        "visionOS",
        "Designing custom gestures in visionOS"
      ],
      "source_sentence_hash": "c9093b1a40216847db4b2c1ed8e2f5b80035735b18b728f7923e9a67b0dc59af",
      "word_count": 9
    },
    {
      "text": "Support standard gesture mappings on each documented platform",
      "section_path": [
        "Gestures",
        "Specifications",
        "Standard gestures"
      ],
      "source_sentence_hash": "459be5e35692c45c09a6fb4ff82c6e1b715d309109332d8ee326479001516fcd",
      "word_count": 9
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Gestures",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
