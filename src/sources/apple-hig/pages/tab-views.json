  "guidance_candidates": [
    {
      "text": "Use a tab view to present closely related areas of content",
      "section_path": [
        "Tab views",
        "Best practices"
      ],
      "source_sentence_hash": "58317e6958f1f39821de60ebbdf1afed89a538d6a48e2c912cc3bffb41931fa5",
      "word_count": 11
    },
    {
      "text": "Make sure the controls within a pane affect content only in the same pane",
      "section_path": [
        "Tab views",
        "Best practices"
      ],
      "source_sentence_hash": "86e672be8811b86aba72cfeea602fcf4505b78c161ef943a7fb5bf9b4eb90c97",
      "word_count": 14
    },
    {
      "text": "Provide a label for each tab that describes the contents of its pane",
      "section_path": [
        "Tab views",
        "Best practices"
      ],
      "source_sentence_hash": "d5a82f29a040ac0ad0d6b04f15d5cc596cd90a1e264148dce7bcbedf58e487bb",
      "word_count": 13
    },
    {
      "text": "Avoid using a pop-up button to switch between tabs",
      "section_path": [
        "Tab views",
        "Best practices"
      ],
      "source_sentence_hash": "2f1c9b00192a93f6fa697d987f34ea4105f6e32ca18fc7ec8b4910fd3496fc79",
      "word_count": 9
    },
    {
      "text": "Avoid providing more than six tabs in a tab view",
      "section_path": [
        "Tab views",
        "Best practices"
      ],
      "source_sentence_hash": "edc06d1a984973af0873bee63bd3d3f4b8029b860e5276153b998d43091df5e7",
      "word_count": 10
    },
    {
      "text": "In general, inset a tab view by leaving a margin of window-body area on all sides of a tab",
      "section_path": [
        "Tab views",
        "Anatomy"
      ],
      "source_sentence_hash": "b7fd3e7579f1a298d4f746fac6632f2315d2d40003c7d541474161e689bf4232",
