      ],
      "source_sentence_hash": "6a4b65683d1c6d3a27a5c1127c1185d1cb10a5186ce2c464821e190a72c0e485",
      "word_count": 7
    },
    {
      "text": "Separate advanced features from frequently used features",
      "section_path": [
