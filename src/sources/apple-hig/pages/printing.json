      ],
      "source_sentence_hash": "ff1f8de7b225fd0f1e235818c7ac368d8e8c1f614e34cd510b937c1a2499aaa4",
      "word_count": 7
    },
    {
      "text": "Consider letting people preview the effect of a setting",
