  "guidance_candidates": [
    {
      "text": "Make printing discoverable",
      "section_path": [
        "Printing",
        "Best practices"
      ],
      "source_sentence_hash": "bc9f05b7771ae94777dce9df83a66b531e6584c48919b4303877c7a1632d2d62",
      "word_count": 3
    },
    {
      "text": "Present a printing option only when it’s possible",
      "section_path": [
        "Printing",
        "Best practices"
      ],
      "source_sentence_hash": "a4fa1b92b2034bf4ca1d73b6b0063e99a431da4a2956b7971ab7562292a41adc",
      "word_count": 8
    },
    {
      "text": "Present relevant printing options",
      "section_path": [
        "Printing",
        "Best practices"
      ],
      "source_sentence_hash": "467a734069a72d932b57c83a5d9ac5ef083c997da03970dbbdeb4a1b2e84b01d",
      "word_count": 4
    },
    {
      "text": "If your macOS app offers app-specific print options that the system doesn’t offer, consider creating a custom category for",
      "section_path": [
        "Printing",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "e25a2943e177e8ebcd5ad920fc565da2664f7d928dda4920bf06441286e32e00",
      "word_count": 19
    },
    {
      "text": "If your app supports document-specific page settings, consider presenting a page setup dialog",
      "section_path": [
        "Printing",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "10a975d8febe11d9b58712bea2369cb84fb7a7f0149a89ca2794178eaf0d02d2",
      "word_count": 13
    },
    {
      "text": "Make sure interdependencies between options are clear",
      "section_path": [
        "Printing",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "6a4b65683d1c6d3a27a5c1127c1185d1cb10a5186ce2c464821e190a72c0e485",
      "word_count": 7
    },
    {
      "text": "Separate advanced features from frequently used features",
      "section_path": [
        "Printing",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "ff1f8de7b225fd0f1e235818c7ac368d8e8c1f614e34cd510b937c1a2499aaa4",
      "word_count": 7
    },
    {
      "text": "Consider letting people preview the effect of a setting",
      "section_path": [
        "Printing",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "1be04830109bb582182932646e91be842f34a63a13c260e7e22bde74ceb9052d",
      "word_count": 9
    },
    {
      "text": "Consider storing modified settings with the document",
      "section_path": [
        "Printing",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "0656f545df5b78084e1c750ebbd96d4775246485f5a186137e5f90dfc92fc139",
      "word_count": 7
    },
    {
      "text": "Avoid offering printing on tvOS or watchOS",
      "section_path": [
        "Printing",
        "Platform considerations"
      ],
      "source_sentence_hash": "c2b0c4f88e48d9eea0203ca38b41708787d8bfe97d2fbcf8cfff03e22f4df4d4",
      "word_count": 7
    },
    {
      "text": "Give a custom print category a unique name",
      "section_path": [
        "Printing",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "5ef8ca7e4b2ca9f936607ebc0003bed1d0350854e5df309570e526f846975b74",
      "word_count": 8
    },
    {
      "text": "Include app-specific options that help people have a great print experience",
      "section_path": [
        "Printing",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "5ef8ca7e4b2ca9f936607ebc0003bed1d0350854e5df309570e526f846975b74",
      "word_count": 10
    },
    {
      "text": "Avoid implementing print features the system already provides",
      "section_path": [
        "Printing",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "d8498db363f893f80ee18a8c1b77546cc910217357041f48d16351bcca49b974",
      "word_count": 8
    },
    {
      "text": "Keep advanced print features separate from frequently used features",
      "section_path": [
        "Printing",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "ff1f8de7b225fd0f1e235818c7ac368d8e8c1f614e34cd510b937c1a2499aaa4",
      "word_count": 9
    },
    {
      "text": "Consider a disclosure control that hides advanced options until needed",
      "section_path": [
        "Printing",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "5f6c8c3fae727f460107812e48432587ec745493ecd122e52e66f94570ef7173",
      "word_count": 10
    },
    {
      "text": "Use Advanced Options as the label for advanced print options",
      "section_path": [
        "Printing",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "504702907d724fbb95e12c4891e2bd393be41a94d1b828dcee07c6f060e7eaf2",
      "word_count": 10
    },
    {
      "text": "Keep modified print settings until the document closes at minimum",
      "section_path": [
        "Printing",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "d7bc8385752efc00e3feca79698ccfb65b3e665e8921e0ba2e98117c051d0af3",
      "word_count": 10
    },
