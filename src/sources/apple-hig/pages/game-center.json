  "guidance_candidates": [
    {
      "text": "Discover new games their friends are playing",
      "section_path": [
        "Game Center"
      ],
      "source_sentence_hash": "4794c36ee7862c6b1b4ad1d77c1f56d40a993849b0b8e699866f0d5953ae25e1",
      "word_count": 7
    },
    {
      "text": "Seamlessly invite friends to play",
      "section_path": [
        "Game Center"
      ],
      "source_sentence_hash": "057998bfd95fde5a72c34eafbf7436887f7b46cd79da9e10fa20a156958129e0",
      "word_count": 5
    },
    {
      "text": "See the latest activity from their games across the system, in the Apple Games app, the App Store, notifications,",
      "section_path": [
        "Game Center"
      ],
      "source_sentence_hash": "86a23d78d9d0e4abc0dec37b3c415fc6cfe9fab6c75b611818c98d32703acf88",
      "word_count": 19
    },
    {
      "text": "Integrating the access point",
      "section_path": [
        "Game Center",
        "Accessing Game Center",
        "Integrating the access point"
      ],
      "source_sentence_hash": "c6b701ac83e15ce73109946587372031e3a9a2d2811fef8b7ab664dd26378ea2",
      "word_count": 4
    },
    {
      "text": "Display the access point in menu screens",
      "section_path": [
        "Game Center",
        "Accessing Game Center",
        "Integrating the access point"
      ],
      "source_sentence_hash": "5da58146724aa543129c67eb8ca58cb031043eae71ddcab4f59492a76ae8d804",
      "word_count": 7
    },
    {
      "text": "Avoid placing controls near the access point",
      "section_path": [
        "Game Center",
        "Accessing Game Center",
        "Integrating the access point"
      ],
      "source_sentence_hash": "2405f22da2904d42118640664a15314f2d9c51ff1e0ffbad1db8d6f656373d64",
      "word_count": 7
    },
    {
      "text": "Consider pausing your game while the Game Overlay or dashboard is present",
      "section_path": [
        "Game Center",
        "Accessing Game Center",
        "Integrating the access point"
      ],
      "source_sentence_hash": "358008bad80043ab0910dcd6f02c530b00e634b26c5221436e8432374b18db5c",
      "word_count": 12
    },
    {
      "text": "Using custom UI",
      "section_path": [
        "Game Center",
        "Accessing Game Center",
        "Using custom UI"
      ],
      "source_sentence_hash": "130f3cd0e0493a393e81f1c463334400f81573643aec39e205dce42e00bc7ecd",
      "word_count": 3
    },
    {
      "text": "Use the artwork Game Center provides in custom links",
      "section_path": [
        "Game Center",
        "Accessing Game Center",
        "Using custom UI"
      ],
      "source_sentence_hash": "6c65749c12fa4b05a2b7ecc50801fbecb5c90bdf3f99ce0c0ada977c0edcf58d",
      "word_count": 9
    },
    {
      "text": "Use the correct terminology in custom links",
      "section_path": [
        "Game Center",
        "Accessing Game Center",
        "Using custom UI"
      ],
      "source_sentence_hash": "92cc6145feec25b8293862321e5e501b291a153b327dc09bb9be068455e6625b",
      "word_count": 7
    },
    {
      "text": "Integrating achievements into your game",
      "section_path": [
        "Game Center",
        "Achievements",
        "Integrating achievements into your game"
      ],
      "source_sentence_hash": "5fa8a1c5cb69e7cad87220dee6aab6b0bb7a5f8682b7603f8651a6d9625562b3",
      "word_count": 5
    },
    {
      "text": "Align with Game Center achievement states",
      "section_path": [
        "Game Center",
        "Achievements",
        "Integrating achievements into your game"
      ],
      "source_sentence_hash": "d8dcef1db6c04eab45a061f8516e924a2c1bad456a6741416781f70ce36fd181",
      "word_count": 6
    },
    {
      "text": "Determine a display order",
      "section_path": [
        "Game Center",
        "Achievements",
        "Integrating achievements into your game"
      ],
      "source_sentence_hash": "0bde71682c94a52cd8161f7e914309c5226b7c403e3f932a69a7c360965324db",
      "word_count": 4
    },
    {
      "text": "Be succinct when describing achievements",
      "section_path": [
        "Game Center",
        "Achievements",
        "Integrating achievements into your game"
      ],
      "source_sentence_hash": "1c0a62926317f1072accc61ecd459435772dc3e29e1e6b498c33f4cafa4be307",
      "word_count": 5
    },
    {
      "text": "Give players a sense of progress",
      "section_path": [
        "Game Center",
        "Achievements",
        "Integrating achievements into your game"
      ],
      "source_sentence_hash": "318c74e12481cf43f859fbf2becdc515c25a986bb58ebab8fa4af718d449f538",
      "word_count": 6
    },
    {
      "text": "Creating achievement images",
      "section_path": [
        "Game Center",
        "Achievements",
        "Creating achievement images"
      ],
      "source_sentence_hash": "d4ff636b6759c5b85fb008b8c3f4beab01e289281a49685c7b5199fc5ae6955b",
      "word_count": 3
    },
    {
      "text": "Design rich, high-quality images that help players feel rewarded",
      "section_path": [
        "Game Center",
        "Achievements",
        "Creating achievement images"
      ],
      "source_sentence_hash": "e71c25d56dc8254ec0b0e8844a65bb8c9ecf3184c7963d036e22f9f0a04f3817",
      "word_count": 9
    },
    {
      "text": "Create artwork in the appropriate size and format",
      "section_path": [
        "Game Center",
        "Achievements",
        "Creating achievement images"
      ],
      "source_sentence_hash": "6d1b1f64dfc3a9590ca223f4e000eae61c6633c6550466f6813d203f7167e4bd",
      "word_count": 8
    },
    {
      "text": "Choose a leaderboard type",
      "section_path": [
        "Game Center",
        "Leaderboards"
      ],
      "source_sentence_hash": "6435087e1b5689977e12728388b9e7d98ffa0ed7ce50954eb23cfa94796413d0",
      "word_count": 4
    },
    {
      "text": "A classic leaderboard tracks a player’s best all-time score. Classic leaderboards are always active with no ending. The following",
      "section_path": [
        "Game Center",
        "Leaderboards"
      ],
      "source_sentence_hash": "f0f407b25da6d1503c45e4d331536930d3c47b75958365f55b4cd3cabadacb40",
      "word_count": 19
    },
    {
      "text": "Strive for the most perfect score in a rhythm game",
      "section_path": [
        "Game Center",
        "Leaderboards"
      ],
      "source_sentence_hash": "bad09cb9b78cd62afbe2520ebc510e2ab77b125a20f32ea4b39da4f1ba7bf4dc",
      "word_count": 10
    },
    {
      "text": "Collect the most coins in a single dungeon run",
      "section_path": [
        "Game Center",
        "Leaderboards"
      ],
      "source_sentence_hash": "e30b995c07801e3ba6e22b1e92096da45a6641b0bd78a2c59225377cac858447",
      "word_count": 9
    },
    {
      "text": "Achieve the longest continuous time in an endless runner",
      "section_path": [
        "Game Center",
        "Leaderboards"
      ],
      "source_sentence_hash": "ee14141f28f83ba9ab3bf82186c2ec20143d6767c88bf47fa41592cbf7ea1959",
      "word_count": 9
    },
    {
      "text": "Daily rotating puzzles",
      "section_path": [
        "Game Center",
        "Leaderboards"
      ],
      "source_sentence_hash": "1ec903b87fbe5e0d0d4902b49313f2f5340acb5868927a816dfe9afb1b807028",
      "word_count": 3
    },
    {
      "text": "Seasonal or holiday-themed events",
      "section_path": [
        "Game Center",
        "Leaderboards"
      ],
      "source_sentence_hash": "acf8dd425c6e89f41d9bbdc789c2e78bf00eb4317295ac6a3910dad080d144cc",
      "word_count": 4
    },
    {
      "text": "Weekly leaderboards for different battle modes",
      "section_path": [
        "Game Center",
        "Leaderboards"
      ],
      "source_sentence_hash": "786b591b594a430a8f09d2646ea19aaf5dd6e2050c9f554896e29a69820363b0",
      "word_count": 6
    },
    {
      "text": "Take advantage of leaderboard sets for multiple leaderboards",
      "section_path": [
        "Game Center",
        "Leaderboards"
      ],
      "source_sentence_hash": "841ea6e131f8c52ac9126142f26049f83c02f2f064fa5eb8d87b8777042c8eb5",
      "word_count": 8
    },
    {
      "text": "Difficulty modes (Easy, Standard, Hard)",
      "section_path": [
        "Game Center",
        "Leaderboards"
      ],
      "source_sentence_hash": "cd8d9ea46f68d60d6160584f02f60aea51be8d894ebe1e95429575348dbc9df0",
      "word_count": 5
    },
    {
      "text": "Activity types (Combat, Crafting, Farming)",
      "section_path": [
        "Game Center",
        "Leaderboards"
      ],
      "source_sentence_hash": "fd532f902825ed93206e1077c9c611cd8dd3b8507ef7baf4a7abac3f3d1ecdbb",
      "word_count": 5
    },
    {
      "text": "Genres and themes (Disco, Pop, Rock)",
      "section_path": [
        "Game Center",
        "Leaderboards"
      ],
      "source_sentence_hash": "c2055002a81f4042402e88a082e2090d23479bda8bb9e4acc9ea7f5de20622bb",
      "word_count": 6
    },
    {
      "text": "Add leaderboard images",
      "section_path": [
        "Game Center",
        "Leaderboards"
      ],
      "source_sentence_hash": "7d81f7b29a9bae970f967aae0bbce0ea1f5c3b3054162e85d93439fad9b31c47",
      "word_count": 3
    },
    {
      "text": "Create engaging challenges",
      "section_path": [
        "Game Center",
        "Challenges"
      ],
      "source_sentence_hash": "e5d9905debce9f3721087b7cab5dbad4dd6acaa7ef2be4820b0ece3708cbde47",
      "word_count": 3
    },
    {
      "text": "Complete the fastest lap in a racing level",
      "section_path": [
        "Game Center",
        "Challenges"
      ],
      "source_sentence_hash": "80ecc3baa21ca8458c381975e05fd8aa566b2088c03abb6f277d0db567081ae6",
      "word_count": 8
    },
    {
      "text": "Defeat the most enemies in a single round",
      "section_path": [
        "Game Center",
        "Challenges"
      ],
      "source_sentence_hash": "04608476a58e382d7351bfa9ba1d27588a95c9104e59b18c14c562b96ea06929",
      "word_count": 8
    },
    {
      "text": "Solve a daily puzzle with the fewest mistakes",
      "section_path": [
        "Game Center",
        "Challenges"
      ],
      "source_sentence_hash": "89ad958e29e7c7141823453d35c80d897a140b9fe78cea6f5bec380cd796c072",
      "word_count": 8
    },
    {
      "text": "Avoid creating challenges that track overall progress or personal best scores",
      "section_path": [
        "Game Center",
        "Challenges"
      ],
      "source_sentence_hash": "4fd4a2c6cd7fa8629bbfe999c32f21020bbdeb981cfae114a4e603969cc06a97",
      "word_count": 11
    },
    {
      "text": "Make it easy to jump into your challenge",
      "section_path": [
        "Game Center",
        "Challenges"
      ],
      "source_sentence_hash": "dfe4c666eee8ffcb880dbc5671e9b85c8b6872d0a91aa2feab3ea473442b7828",
      "word_count": 8
    },
    {
      "text": "Create high-quality artwork that encourages players to engage with your challenges",
      "section_path": [
        "Game Center",
        "Challenges"
      ],
      "source_sentence_hash": "7698bc7f8d02b45ba99c6a85d557de1e2274bd5d5ee073a2d40c6936a3ad73f2",
      "word_count": 11
    },
    {
      "text": "Use party codes to invite players to multiplayer activities",
      "section_path": [
        "Game Center",
        "Multiplayer activities"
      ],
      "source_sentence_hash": "03d86acce28b39586a5107bd34f13326009f5fa7a3591c99e27ecb7073a73ca8",
      "word_count": 9
    },
    {
      "text": "Allow players to join gameplay late, leave early, and return later",
      "section_path": [
        "Game Center",
        "Multiplayer activities"
      ],
      "source_sentence_hash": "46710184fba26e1066e0d60e3d6c654d628dd0023b2454274339e093aeac0e55",
      "word_count": 11
    },
    {
      "text": "Provide a way for players to view the current party code in your game",
      "section_path": [
        "Game Center",
        "Multiplayer activities"
      ],
      "source_sentence_hash": "ab353bfd14aee4c0ce63928a72be6ce3e93779e81bb4d7c5e19c09d639c970e7",
      "word_count": 14
    },
    {
      "text": "Allow players to enter a party code manually",
      "section_path": [
        "Game Center",
        "Multiplayer activities"
      ],
      "source_sentence_hash": "49e20254d8410ac9a8f24a05b72673caaf0144123ddbeba23cb38b8064e92c52",
      "word_count": 8
    },
    {
      "text": "Support multiplayer activities through in-game UI",
      "section_path": [
        "Game Center",
        "Multiplayer activities"
      ],
      "source_sentence_hash": "8aff9843304ce386ca60a070d3f82ffe0408ad716ebc17e7f13a101e78252382",
      "word_count": 6
    },
    {
      "text": "Provide engaging activity artwork",
      "section_path": [
        "Game Center",
        "Multiplayer activities"
      ],
      "source_sentence_hash": "67fd0c6770b33b741c398109feaa6a7adebafb89b63ffdc376250b6503ef86b0",
      "word_count": 4
    },
    {
      "text": "Display an optional image at the top of the dashboard",
      "section_path": [
        "Game Center",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "8cd79fdbd186377868a4991be27d827a56e86de3e45375b28776f50b50a17994",
      "word_count": 10
    },
    {
      "text": "Be aware of Game Center support on watchOS",
      "section_path": [
        "Game Center",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "de93041d13b75c3dd8ede834b9a65a634c7db94c1081182c173e049551a2fb7c",
      "word_count": 8
    },
    {
      "text": "Use a simple recognizable tvOS dashboard image that works at a distance",
      "section_path": ["Game Center", "Platform considerations", "tvOS"],
      "source_sentence_hash": "e3bc07e562d236008c937bf9dfd2242996b78564968121463a45d423cdac5380",
      "word_count": 11
    },
    {
      "text": "Consider a game logo or word mark for the tvOS dashboard image",
      "section_path": ["Game Center", "Platform considerations", "tvOS"],
      "source_sentence_hash": "e3bc07e562d236008c937bf9dfd2242996b78564968121463a45d423cdac5380",
      "word_count": 11
    },
    {
      "text": "Avoid using the app icon as the tvOS dashboard image",
      "section_path": ["Game Center", "Platform considerations", "tvOS"],
      "source_sentence_hash": "e3bc07e562d236008c937bf9dfd2242996b78564968121463a45d423cdac5380",
      "word_count": 10
    },
    {
      "text": "Use a 600x180-point tvOS dashboard image at 1200x360 pixels for @2x",
      "section_path": ["Game Center", "Platform considerations", "tvOS"],
      "source_sentence_hash": "f55383b7032acb4b5514e232001ce46430f1d29bf4597ef80c6c3ba56541a5f3",
      "word_count": 10
    },
    {
      "text": "Use PNG TIF or JPG for the tvOS dashboard image",
      "section_path": ["Game Center", "Platform considerations", "tvOS"],
      "source_sentence_hash": "f55383b7032acb4b5514e232001ce46430f1d29bf4597ef80c6c3ba56541a5f3",
      "word_count": 9
    },
    {
      "text": "Use sRGB or P3 for the tvOS dashboard image color space",
      "section_path": ["Game Center", "Platform considerations", "tvOS"],
      "source_sentence_hash": "f55383b7032acb4b5514e232001ce46430f1d29bf4597ef80c6c3ba56541a5f3",
      "word_count": 11
    },
    {
      "text": "Use at least 72 DPI for the tvOS dashboard image",
      "section_path": ["Game Center", "Platform considerations", "tvOS"],
      "source_sentence_hash": "f55383b7032acb4b5514e232001ce46430f1d29bf4597ef80c6c3ba56541a5f3",
      "word_count": 9
    },
    {
      "text": "Present watchOS Game Center content on a connected iPhone",
      "section_path": ["Game Center", "Platform considerations", "watchOS"],
      "source_sentence_hash": "c198f0ee9d54322809d29e7b4b44573b0adb335ec9bd0aad3aedb615b58e0064",
      "word_count": 9
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Game Center",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
