  "guidance_candidates": [
    {
      "text": "Ensure that people receive critical information and, if necessary, act on it",
      "section_path": [
        "Modality"
      ],
      "source_sentence_hash": "da6998b6704624b12ab4a7efd67ea3a2552299e72bf3690b09532b897c94260c",
      "word_count": 12
    },
    {
      "text": "Provide options that let people confirm or modify their most recent action",
      "section_path": [
        "Modality"
      ],
      "source_sentence_hash": "9c069fc4d6384f13ce93d6b0c0f56f2f55cdd49e46508b5c621af7777a775c85",
      "word_count": 12
    },
    {
      "text": "Help people perform a distinct, narrowly scoped task without losing track of their previous context",
      "section_path": [
        "Modality"
      ],
      "source_sentence_hash": "fa4230d9f58f8a95f30f1fe799589cb41715b7e114882453a607d4559b236f1e",
      "word_count": 15
    },
    {
      "text": "Give people an immersive experience or help them concentrate on a complex task",
      "section_path": [
        "Modality"
      ],
      "source_sentence_hash": "c5e6f8cf00ca281a2e4b1d6d07aca7ef1c99dac177ea8f23326d2995d7965c35",
      "word_count": 13
    },
    {
      "text": "Present content modally only when there’s a clear benefit",
      "section_path": [
        "Modality",
        "Best practices"
      ],
      "source_sentence_hash": "d3f26619a0a8873d66e46a5be5cdcf1e682a39e99d15e6b4e26324cca1704a59",
      "word_count": 9
    },
    {
      "text": "Aim to keep modal tasks simple, short, and streamlined",
      "section_path": [
        "Modality",
        "Best practices"
      ],
      "source_sentence_hash": "eb27820d77365a7f01a5601c7c541f35c9f4521d5a765be4b0696b51fa686c65",
      "word_count": 9
    },
    {
      "text": "Take care to avoid creating a modal experience that feels like an app within your app",
      "section_path": [
        "Modality",
        "Best practices"
      ],
      "source_sentence_hash": "a91166393bc290c93e6902833e9319bb5ccc6b0151dd1d6f3fa1e20c8114ac3e",
      "word_count": 16
    },
    {
      "text": "If a modal task must contain subviews, provide a single path through the hierarchy",
      "section_path": [
        "Modality",
        "Best practices"
      ],
      "source_sentence_hash": "2d79a3401846e1351c03b87d0830f93166473e699d8887136a3ac509c271d809",
      "word_count": 14
    },
    {
      "text": "Avoid buttons people might mistake for the modal view’s dismissal button",
      "section_path": [
        "Modality",
        "Best practices"
      ],
      "source_sentence_hash": "2d79a3401846e1351c03b87d0830f93166473e699d8887136a3ac509c271d809",
      "word_count": 11
    },
    {
      "text": "Consider using a full-screen modal style for in-depth content or a complex task",
      "section_path": [
        "Modality",
        "Best practices"
      ],
      "source_sentence_hash": "354c17910f0be969d08ee3a66f4824d7f9330ad6e3f4be98aab0d85d6b7432dd",
      "word_count": 13
    },
    {
      "text": "Always give people an obvious way to dismiss a modal view",
      "section_path": [
        "Modality",
        "Best practices"
      ],
      "source_sentence_hash": "a4d496ea49d4ba482e38ae5103781c08f90f8ba006d9dfd1e7007bba95dfffd1",
      "word_count": 11
    },
    {
      "text": "When necessary, help people avoid data loss by getting confirmation before closing a modal view",
      "section_path": [
        "Modality",
        "Best practices"
      ],
      "source_sentence_hash": "abd2226d656230a7b67db0fa4597631a691f4c62b5e1a3d297a38a1f35b76b40",
      "word_count": 15
    },
    {
      "text": "Be sure to explain the situation when closing could lose user-generated content",
      "section_path": [
        "Modality",
        "Best practices"
      ],
      "source_sentence_hash": "ed38717ac42e2e6e4bccf398ffa2a7a88a382ca14cad1743bfbe5110eef76f76",
      "word_count": 12
    },
    {
      "text": "Be sure to give people ways to resolve potential data loss",
      "section_path": [
        "Modality",
        "Best practices"
      ],
      "source_sentence_hash": "ed38717ac42e2e6e4bccf398ffa2a7a88a382ca14cad1743bfbe5110eef76f76",
      "word_count": 11
    },
    {
      "text": "Make it easy to identify a modal view’s task",
      "section_path": [
        "Modality",
        "Best practices"
      ],
      "source_sentence_hash": "29cf6afb80b4045e7b7845e8b321c44aaaecb1daac7199e098a2742a1ab1f54f",
      "word_count": 9
    },
    {
      "text": "Let people dismiss a modal view before presenting another one",
      "section_path": [
        "Modality",
        "Best practices"
      ],
      "source_sentence_hash": "e338fdf10618ba454521f22532474fee102c5048b991a77ef7dd6facadd1e794",
      "word_count": 10
    },
    {
      "text": "Never display more than one alert at the same time",
      "section_path": [
        "Modality",
        "Best practices"
      ],
      "source_sentence_hash": "22ca589b4f70d7d4fb64625a95a08d8645707660c8c4517599ebc77ea95a4d6b",
      "word_count": 10
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Modality",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
