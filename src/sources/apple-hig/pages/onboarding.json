  "guidance_candidates": [
    {
      "text": "Use interactive onboarding whenever possible",
      "section_path": [
        "Onboarding",
        "Best practices"
      ],
      "source_sentence_hash": "da32e45a54f82123928f2c9acdf5e6b7342086095cc912190ce51f050dd69f1a",
      "word_count": 5
    },
    {
      "text": "Consider providing a collection of context-specific tips instead of a single onboarding flow",
      "section_path": [
        "Onboarding",
        "Best practices"
      ],
      "source_sentence_hash": "301ee5ab81e61bd41fa0aa625e9aedd803405dcdcfdf05217f91fbbc19f8d14a",
      "word_count": 13
    },
    {
      "text": "Keep prerequisite onboarding brief, enjoyable, and easy to remember",
      "section_path": [
        "Onboarding",
        "Best practices"
      ],
      "source_sentence_hash": "9c81c710d1525b8f17b48c3fd7041ec992f8a5dc7e792d9294581980585815c7",
      "word_count": 9
    },
    {
      "text": "If it makes sense to offer a separate tutorial, consider making it optional",
      "section_path": [
        "Onboarding",
        "Best practices"
      ],
      "source_sentence_hash": "a769ca6ee5e140e54066f61a05b5fd05d01b43994c820c6b90272a006d928851",
      "word_count": 13
    },
    {
      "text": "Keep onboarding content focused on the experience you provide",
      "section_path": [
        "Onboarding",
        "Best practices"
      ],
      "source_sentence_hash": "e499765f2611efa445889f31185758589564aa2e2e0864e5cd329e17121728dd",
      "word_count": 9
    },
    {
      "text": "Keep necessary splash screens brief",
      "section_path": [
        "Onboarding",
        "Additional content"
      ],
      "source_sentence_hash": "e831cab053feddc90692165e30522b7bf558095eab3ea55022dbac17191376bf",
      "word_count": 5
    },
    {
      "text": "Don’t let large downloads hinder onboarding",
      "section_path": [
        "Onboarding",
        "Additional content"
      ],
      "source_sentence_hash": "ebe91dcc85b8b18defe9477af9ad22d9025a2387f6aabb1825593ef23a37d382",
      "word_count": 6
    },
    {
      "text": "Avoid displaying licensing details within your onboarding flow",
      "section_path": [
        "Onboarding",
        "Additional content"
      ],
      "source_sentence_hash": "a953411b4dc7f7a25bcea82b9ef5a5eb9df018f7f8884ce0e52a59b0f11a6801",
      "word_count": 8
    },
    {
      "text": "Defer nonessential setup and customization",
      "section_path": [
        "Onboarding",
        "Additional requests"
      ],
      "source_sentence_hash": "c31d973d0a8cc24b5dc8fad0ae2e5fec7205b4149f136f6dc09244ebe90724c5",
      "word_count": 5
    },
    {
      "text": "Consider integrating essential permission requests into onboarding",
      "section_path": [
        "Onboarding",
        "Additional requests"
      ],
      "source_sentence_hash": "134f307c13c668e303dd484eec745ce7a164d3b45b0f4c7f816ee5c359483ddc",
      "word_count": 7
    },
    {
      "text": "Prefer letting people experience your app or game before prompting them for ratings or purchases",
      "section_path": [
        "Onboarding",
        "Additional requests"
      ],
      "source_sentence_hash": "d7d339df3e71ce33ed54d6a83d8463f68ab025537271a37ed8fd831a27e95237",
      "word_count": 15
    },
    {
      "text": "Keep onboarding fast, engaging, and optional",
      "section_path": [
        "Onboarding"
      ],
      "source_sentence_hash": "68089abd22916e28831dd04f763884e4ba88ccf51d0b8e7d438ad04fd7e7427b",
      "word_count": 6
    },
    {
      "text": "Keep onboarding separate from the launch experience",
      "section_path": [
        "Onboarding"
      ],
      "source_sentence_hash": "68089abd22916e28831dd04f763884e4ba88ccf51d0b8e7d438ad04fd7e7427b",
      "word_count": 7
    },
    {
      "text": "Display interface-specific instructions near the relevant area",
      "section_path": [
        "Onboarding",
        "Best practices"
      ],
      "source_sentence_hash": "70cd3118581092c6010de6afab04ec1eca24917d597fffd9a9de589acde08aab",
      "word_count": 7
    },
    {
      "text": "Avoid repeating a skipped tutorial on later launches",
      "section_path": [
        "Onboarding",
        "Best practices"
      ],
      "source_sentence_hash": "9b6f7c3d14e0c6a40dcb1f901d23255b81aacbb9c9db2defe4f5cbe0fbced36c",
      "word_count": 8
    },
    {
      "text": "Ensure skipped tutorials remain easy to find later",
      "section_path": [
        "Onboarding",
        "Best practices"
      ],
      "source_sentence_hash": "9b6f7c3d14e0c6a40dcb1f901d23255b81aacbb9c9db2defe4f5cbe0fbced36c",
      "word_count": 8
    },
    {
      "text": "Use bundled initial content to prevent blocking downloads",
      "section_path": [
        "Onboarding",
        "Additional content"
      ],
      "source_sentence_hash": "94ecc3d3aac77ee61f91422aeb5522cc56663f009f72239f38e36a19c784f7af",
      "word_count": 8
    },
    {
      "text": "Keep required onboarding licensing balanced and nondisruptive",
      "section_path": [
        "Onboarding",
        "Additional content"
      ],
      "source_sentence_hash": "9c52610fcfac1d0dd70e2343c79b7abd8a3f8d456ecbb7b397e9b50ca139e40a",
      "word_count": 7
    },
    {
      "text": "Provide reasonable defaults for immediate first use",
      "section_path": [
        "Onboarding",
        "Additional requests"
      ],
      "source_sentence_hash": "ad52bd5293141d542d5192726375ae8d6391e3266cd91640280af6a68878221e",
      "word_count": 7
    },
    {
      "text": "Use just-in-time permission requests for nonessential features",
      "section_path": [
        "Onboarding",
        "Additional requests"
      ],
      "source_sentence_hash": "8ea42ac11c791dfa3e8785515df6cf4cb2bb499a760583a452051ffe503f0601",
      "word_count": 7
    }
  ],
