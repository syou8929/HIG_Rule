  "guidance_candidates": [
    {
      "text": "When possible, use a determinate progress indicator",
      "section_path": [
        "Progress indicators",
        "Best practices"
      ],
      "source_sentence_hash": "e661de2e841cf1da9803ef3f60226fea56c79f048500b0445b25ec1b590015f5",
      "word_count": 7
    },
    {
      "text": "Be as accurate as possible when reporting advancement in a determinate progress indicator",
      "section_path": [
        "Progress indicators",
        "Best practices"
      ],
      "source_sentence_hash": "a03e58b1af6a00711888192df2aa1798ca907805a52527688e352ae5b78b6bf1",
      "word_count": 13
    },
    {
      "text": "Keep progress indicators moving so people know something is continuing to happen",
      "section_path": [
        "Progress indicators",
        "Best practices"
      ],
      "source_sentence_hash": "86535f7cc446349666d427724173be55d3f0fb101ac285d77523410b500be8a7",
      "word_count": 12
    },
    {
      "text": "When possible, switch a progress bar from indeterminate to determinate",
      "section_path": [
        "Progress indicators",
        "Best practices"
      ],
      "source_sentence_hash": "cba812081ce416a63b88e80745ea7279a7a325bc41ec56f3a1b9f22cbbf00ca9",
      "word_count": 10
    },
    {
      "text": "Don’t switch from the circular style to the bar style",
      "section_path": [
        "Progress indicators",
        "Best practices"
      ],
      "source_sentence_hash": "727c82fc7be1828ea5908920ff861a551509095b7ab62ce8d38d29dc2fcc5b4b",
      "word_count": 10
    },
    {
      "text": "If it’s helpful, display a description that provides additional context for the task",
      "section_path": [
        "Progress indicators",
        "Best practices"
      ],
      "source_sentence_hash": "2cde5983d21854b51d714fa48ace3b8b5850ef7dc2dca1da2125223408f4782a",
      "word_count": 13
    },
    {
      "text": "Display a progress indicator in a consistent location",
      "section_path": [
        "Progress indicators",
        "Best practices"
      ],
      "source_sentence_hash": "c434245efbda7b06692c73fcac310bc7cebcec5a27feada9857d5ca62b03e645",
      "word_count": 8
    },
    {
      "text": "When it’s feasible, let people halt processing",
      "section_path": [
        "Progress indicators",
        "Best practices"
      ],
      "source_sentence_hash": "08f01e33f02b52f752c6cce7607e3fac7a5201dedc02032b6c19f4b79f0317d9",
      "word_count": 7
    },
    {
      "text": "Let people know when halting a process has a negative consequence",
      "section_path": [
        "Progress indicators",
        "Best practices"
      ],
      "source_sentence_hash": "8eddcf973802a4736ec62d64f60dabe16acfef4484050b13b83cd5fbc43472a2",
      "word_count": 11
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "Progress indicators",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "Refresh content controls",
      "section_path": [
        "Progress indicators",
        "Platform considerations",
        "iOS, iPadOS",
        "Refresh content controls"
      ],
      "source_sentence_hash": "a2db0b23048503a72ccfa6776b1626c5914ba0d465bb2801340d4377a576437c",
      "word_count": 3
    },
    {
      "text": "Perform automatic content updates",
      "section_path": [
        "Progress indicators",
        "Platform considerations",
        "iOS, iPadOS",
        "Refresh content controls"
      ],
      "source_sentence_hash": "dcd3f149d36130127cf4d9785bd659cbd844378769f7013736d22cfd7a67c429",
      "word_count": 4
    },
    {
      "text": "Supply a short title only if it adds value",
      "section_path": [
        "Progress indicators",
        "Platform considerations",
        "iOS, iPadOS",
        "Refresh content controls"
      ],
      "source_sentence_hash": "759ce1a59ae7ed89c6bc979d8010074dbaafd7db85baf31a2a585c3eb98c60a9",
      "word_count": 9
    },
    {
      "text": "Prefer an activity indicator (spinner) to communicate the status of a background operation or when space is constrained",
      "section_path": [
        "Progress indicators",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "9774e78ac810d9a62f67260e50ec5b71b3e19aecf9de7cd62dbb6552bfa908d5",
      "word_count": 18
    },
    {
      "text": "Avoid labeling a spinning progress indicator",
      "section_path": [
        "Progress indicators",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "f236e2f1a48ba10bfdb23849f30087797fa8b429328e7845f5120194bc99d306",
      "word_count": 6
    },
    {
      "text": "Developer documentation",
