  "guidance_candidates": [
    {
      "text": "Require people's consent before sending notifications",
      "section_path": [
        "Notifications"
      ],
      "source_sentence_hash": "1b54721af1495fff14c19c66daeabf4273c5a7e66654e5c716c392e14ce517f0",
      "word_count": 6
    },
    {
      "text": "A banner or view on a Lock Screen, Home Screen, Home View, or desktop",
      "section_path": [
        "Notifications",
        "Anatomy"
      ],
      "source_sentence_hash": "065b4344133f1a38a53de91cbb506be9a5bfab888a4b6bc89f71aee6ca4b8721",
      "word_count": 14
    },
    {
      "text": "A badge on an app icon",
      "section_path": [
        "Notifications",
        "Anatomy"
      ],
      "source_sentence_hash": "05a57f88d071a5914c1fdc5c420628ebe3fd9a8eaba8048a11b3ab74888830be",
      "word_count": 6
    },
    {
      "text": "An item in Notification Center",
      "section_path": [
        "Notifications",
        "Anatomy"
      ],
      "source_sentence_hash": "720aec84a67cc40d72e3418ff6cea0dafabac3215460d12d09a26e7f845c9e72",
      "word_count": 5
    },
    {
      "text": "Provide concise, informative notifications",
      "section_path": [
        "Notifications",
        "Best practices"
      ],
      "source_sentence_hash": "947190a67e37384b87155a0226929fa72ad5832fba56edb3ef477a93d1580175",
      "word_count": 4
    },
    {
      "text": "Avoid sending multiple notifications for the same thing, even if someone hasn’t responded",
      "section_path": [
        "Notifications",
        "Best practices"
      ],
      "source_sentence_hash": "69dc6ea8f10a16c04b1fae736c33826f41a22937c2974553e9ba0f2beb5e345d",
      "word_count": 13
    },
    {
      "text": "Avoid sending a notification that tells people to perform specific tasks within your app",
      "section_path": [
        "Notifications",
        "Best practices"
      ],
      "source_sentence_hash": "c55d7ac467ee677720b834daf70589f6915773c88042b9d69971ae1bac2a185d",
      "word_count": 14
    },
    {
      "text": "Use an alert — not a notification — to display an error message",
      "section_path": [
        "Notifications",
        "Best practices"
      ],
      "source_sentence_hash": "4f2e99a32b86192d993d5067b156373646c853e787188bffe734df9a4c4385d4",
      "word_count": 13
    },
    {
      "text": "Keep foreground notification updates discoverable and unobtrusive",
      "section_path": [
        "Notifications",
        "Best practices"
      ],
      "source_sentence_hash": "0a119700dbd67d8c9ac287a196e5e95c8f5eb7cc1bbedb3d1921a686f32f397c",
      "word_count": 7
    },
    {
      "text": "Avoid including sensitive, personal, or confidential information in a notification",
      "section_path": [
        "Notifications",
        "Best practices"
      ],
      "source_sentence_hash": "a917a79ccaabaafdc1300098161708596de22155a6e14686ea1eb4a5b25869c8",
      "word_count": 10
    },
    {
      "text": "Create a short title if it provides context for the notification content",
      "section_path": [
        "Notifications",
        "Content"
      ],
      "source_sentence_hash": "32dd2f03826cc69114ee317ac7df8a9d43b55e99184e9e314b8b81e20fbf1e27",
      "word_count": 12
    },
    {
      "text": "Write succinct, easy-to-read notification content",
      "section_path": [
        "Notifications",
        "Content"
      ],
      "source_sentence_hash": "c94f2ee41489c2d775b2b751782032bff11269d257922789d8a3e2102ec09f5b",
      "word_count": 5
    },
    {
      "text": "Provide generically descriptive text to display when notification previews aren’t available",
      "section_path": [
        "Notifications",
        "Content"
      ],
      "source_sentence_hash": "3eb76c534fbe22a2f3670e10ab69a2231fed66c09daf46d7501c327d9ddb0c59",
      "word_count": 11
    },
    {
      "text": "Avoid including your app name or icon",
      "section_path": [
        "Notifications",
        "Content"
      ],
      "source_sentence_hash": "ab1a54d7736d5ff79f7acbf0d387f49857fc24880cb3e71258f8eaa0f9fe9ea5",
      "word_count": 7
    },
    {
      "text": "Consider providing a sound to supplement your notifications",
      "section_path": [
        "Notifications",
        "Content"
      ],
      "source_sentence_hash": "a45ef5333c6873ee300aa51f76bee1a49d3b571771c6302c05c82af094a6b0bb",
      "word_count": 8
    },
    {
      "text": "Ensure custom notification sounds are short, distinctive, and professionally produced",
      "section_path": [
        "Notifications",
        "Content"
      ],
      "source_sentence_hash": "a45ef5333c6873ee300aa51f76bee1a49d3b571771c6302c05c82af094a6b0bb",
      "word_count": 10
    },
    {
      "text": "Ensure important notification information remains available without sound",
      "section_path": [
        "Notifications",
        "Content"
      ],
      "source_sentence_hash": "a45ef5333c6873ee300aa51f76bee1a49d3b571771c6302c05c82af094a6b0bb",
      "word_count": 8
    },
    {
      "text": "Keep notification detail views to at most four action buttons",
      "section_path": [
        "Notifications",
        "Notification actions"
      ],
      "source_sentence_hash": "0defbbb8bac6c0074a5053e29b96dd9db87a28d9f86a2afa363da466187aecca",
      "word_count": 10
    },
    {
      "text": "Provide beneficial actions that make sense in the context of your notification",
      "section_path": [
        "Notifications",
        "Notification actions"
      ],
      "source_sentence_hash": "a15099c554343060f26f4065d08f2f68f965fd89a99bf12bfb629144ce4b229d",
      "word_count": 12
    },
    {
      "text": "Use short title-case labels for notification action buttons",
      "section_path": [
        "Notifications",
        "Notification actions"
      ],
      "source_sentence_hash": "a15099c554343060f26f4065d08f2f68f965fd89a99bf12bfb629144ce4b229d",
      "word_count": 8
    },
    {
      "text": "Describe each notification action result clearly",
      "section_path": [
        "Notifications",
        "Notification actions"
      ],
      "source_sentence_hash": "a15099c554343060f26f4065d08f2f68f965fd89a99bf12bfb629144ce4b229d",
      "word_count": 6
    },
    {
      "text": "Avoid app names and extraneous information in notification action labels",
      "section_path": [
        "Notifications",
        "Notification actions"
      ],
      "source_sentence_hash": "a15099c554343060f26f4065d08f2f68f965fd89a99bf12bfb629144ce4b229d",
      "word_count": 10
    },
    {
      "text": "Write notification action labels for localization",
      "section_path": [
        "Notifications",
        "Notification actions"
      ],
      "source_sentence_hash": "a15099c554343060f26f4065d08f2f68f965fd89a99bf12bfb629144ce4b229d",
      "word_count": 6
    },
    {
      "text": "Avoid providing an action that merely opens your app",
      "section_path": [
        "Notifications",
        "Notification actions"
      ],
      "source_sentence_hash": "6684fc2e356645e8405369d36ef6eb4a1d7948d7efac580e2b8d20ae110b9283",
      "word_count": 9
    },
    {
      "text": "Prefer nondestructive actions",
      "section_path": [
        "Notifications",
        "Notification actions"
      ],
      "source_sentence_hash": "c7f4878ca034603949c753338a9a29e4b516f42374522d6d531028ab4080c67d",
      "word_count": 3
    },
    {
      "text": "Ensure destructive notification actions provide enough context to prevent unintended consequences",
      "section_path": [
        "Notifications",
        "Notification actions"
      ],
      "source_sentence_hash": "c7f4878ca034603949c753338a9a29e4b516f42374522d6d531028ab4080c67d",
      "word_count": 11
    },
    {
      "text": "Provide a simple, recognizable interface icon for each notification action",
      "section_path": [
        "Notifications",
        "Notification actions"
      ],
      "source_sentence_hash": "612129c3aa8dd03b3a81815ae787db368ff8b739e0d7e321b39430520a873c56",
      "word_count": 10
    },
    {
      "text": "Use a badge only to show people how many unread notifications they have",
      "section_path": [
        "Notifications",
        "Badging"
      ],
      "source_sentence_hash": "7d7134933a7242cc82298e89a3eb42777dbf6d724b3172aa6fa9e3834d0033be",
      "word_count": 13
    },
    {
      "text": "Avoid using badges for numeric information unrelated to notifications",
      "section_path": [
        "Notifications",
        "Badging"
      ],
      "source_sentence_hash": "7d7134933a7242cc82298e89a3eb42777dbf6d724b3172aa6fa9e3834d0033be",
      "word_count": 9
    },
    {
      "text": "Make sure badging isn’t the only method you use to communicate essential information",
      "section_path": [
        "Notifications",
        "Badging"
      ],
      "source_sentence_hash": "6c622874bfd456325a20dddf32f480cc03e82cf7304054243a3fe6135569dad5",
      "word_count": 13
    },
    {
      "text": "Ensure important notification information is easy to find when the app opens",
      "section_path": [
        "Notifications",
        "Badging"
      ],
      "source_sentence_hash": "6c622874bfd456325a20dddf32f480cc03e82cf7304054243a3fe6135569dad5",
      "word_count": 11
    },
    {
      "text": "Keep badges up to date",
      "section_path": [
        "Notifications",
        "Badging"
      ],
      "source_sentence_hash": "ff57d081f494dc34f5f3197fa62706f1115c7badb0d39a98e54bb1a52768a032",
      "word_count": 5
    },
    {
      "text": "Avoid creating a custom image or component that mimics the appearance or behavior of a badge",
      "section_path": [
        "Notifications",
        "Badging"
      ],
      "source_sentence_hash": "dfe64cd718cfd239031921e367ed0ed536db5f84cdebcfd15faed9238007c505",
      "word_count": 16
    },
    {
      "text": "Short looks",
      "section_path": [
        "Notifications",
        "Platform considerations",
        "watchOS",
        "Short looks"
      ],
      "source_sentence_hash": "b5ada6720beba2690d4923aba9baa3e08ad6fcac38ba84c3dca9e34a38198112",
      "word_count": 2
    },
    {
      "text": "Avoid using a short look as the only way to communicate important information",
      "section_path": [
        "Notifications",
        "Platform considerations",
        "watchOS",
        "Short looks"
      ],
      "source_sentence_hash": "3038c0735184e99b545fcc09a511854e616eb99c742f3b383358b58da118fafe",
      "word_count": 13
    },
    {
      "text": "Keep privacy in mind",
      "section_path": [
        "Notifications",
        "Platform considerations",
        "watchOS",
        "Short looks"
      ],
      "source_sentence_hash": "6d365b82f7bcf7aaf2c2cc7dc14bd1df93a255c949717016e71c0f5ef01418c1",
      "word_count": 4
    },
    {
      "text": "Avoid sensitive information in a watchOS short-look title",
      "section_path": [
        "Notifications",
        "Platform considerations",
        "watchOS",
        "Short looks"
      ],
      "source_sentence_hash": "6d365b82f7bcf7aaf2c2cc7dc14bd1df93a255c949717016e71c0f5ef01418c1",
      "word_count": 8
    },
    {
      "text": "Long looks",
      "section_path": [
        "Notifications",
        "Platform considerations",
        "watchOS",
        "Long looks"
      ],
      "source_sentence_hash": "ba6e27f8f7372b2d23969d403aaed933c860cd4676e85dc672a39bbe508f074e",
      "word_count": 2
    },
    {
      "text": "Consider using a rich, custom long-look notification to let people get the information they need without launching your app",
      "section_path": [
        "Notifications",
        "Platform considerations",
        "watchOS",
        "Long looks"
      ],
      "source_sentence_hash": "3eec2ac5f47883d044005951c78c47f30b078e4867b9bf3af5369a493b70931d",
      "word_count": 19
    },
    {
      "text": "Provide a static interface for every custom watchOS long look",
      "section_path": [
        "Notifications",
        "Platform considerations",
        "watchOS",
        "Long looks"
      ],
      "source_sentence_hash": "688b3998bf1553455ccdc48b1942efa49742700282bcf85c94d2bec75bfcb285",
      "word_count": 10
    },
    {
      "text": "Prefer a dynamic interface in addition to the static watchOS long-look interface",
      "section_path": [
        "Notifications",
        "Platform considerations",
        "watchOS",
        "Long looks"
      ],
      "source_sentence_hash": "688b3998bf1553455ccdc48b1942efa49742700282bcf85c94d2bec75bfcb285",
      "word_count": 12
    },
    {
      "text": "Ensure static watchOS long-look resources are packaged with the app in advance",
      "section_path": [
        "Notifications",
        "Platform considerations",
        "watchOS",
        "Long looks"
      ],
      "source_sentence_hash": "688b3998bf1553455ccdc48b1942efa49742700282bcf85c94d2bec75bfcb285",
      "word_count": 11
    },
    {
      "text": "Avoid changing the system-defined watchOS long-look structure",
      "section_path": [
        "Notifications",
        "Platform considerations",
        "watchOS",
        "Long looks"
      ],
      "source_sentence_hash": "e98dad6d9f0fd2f2ce26def66edff15dd327394d65e45663525c1e82d68d6c6d",
      "word_count": 7
    },
    {
      "text": "Choose a background appearance for the sash",
      "section_path": [
        "Notifications",
        "Platform considerations",
        "watchOS",
        "Long looks"
      ],
      "source_sentence_hash": "41163e3f080f3baeb0bbead11989b09e7ac3f7c0f046fdbad28460668256624b",
      "word_count": 7
    },
    {
      "text": "Choose a background color for the content area",
      "section_path": [
        "Notifications",
        "Platform considerations",
        "watchOS",
        "Long looks"
      ],
      "source_sentence_hash": "5bfa4551182442b773ca9c0551cf92aca07758348a70a0d3df5e4664cd4f1d09",
      "word_count": 8
    },
    {
      "text": "Provide up to four custom actions below the content area",
      "section_path": [
        "Notifications",
        "Platform considerations",
        "watchOS",
        "Long looks"
      ],
      "source_sentence_hash": "7e08cc1cce05998a0ec5a4fa742e71abb55beea25ec1eeb83429e17c13d440fd",
      "word_count": 10
    },
    {
      "text": "Double tap",
      "section_path": [
        "Notifications",
        "Platform considerations",
        "watchOS",
        "Double tap"
      ],
      "source_sentence_hash": "b7f18903d7ca55dde65f4cd88cf7ee05ab86ce74e1fa4872bf6da4f569791574",
      "word_count": 2
    },
    {
      "text": "Keep double tap in mind when choosing the order of custom actions you present as responses to a notification",
      "section_path": [
        "Notifications",
        "Platform considerations",
        "watchOS",
        "Double tap"
      ],
      "source_sentence_hash": "447eadde363cdd1af63f706930890cb95a99c6d8f71f68fa093222fcb20f4b0f",
      "word_count": 19
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Notifications",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    },
    {
      "text": "Avoid relying on programmatic vibration for notification alert sounds",
      "section_path": [
        "Notifications",
        "Content"
      ],
      "source_sentence_hash": "a45ef5333c6873ee300aa51f76bee1a49d3b571771c6302c05c82af094a6b0bb",
      "word_count": 9
    }
