  "guidance_candidates": [
    {
      "text": "A banner or view on a Lock Screen, Home Screen, Home View, or desktop",
      "section_path": [
        "Notifications",
        "Anatomy"
      ],
      "source_sentence_hash": "065b4344133f1a38a53de91cbb506be9a5bfab888a4b6bc89f71aee6ca4b8721",
      "word_count": 14
    },
    {
      "text": "A badge on an app icon",
      "section_path": [
        "Notifications",
        "Anatomy"
      ],
      "source_sentence_hash": "05a57f88d071a5914c1fdc5c420628ebe3fd9a8eaba8048a11b3ab74888830be",
      "word_count": 6
    },
    {
      "text": "An item in Notification Center",
      "section_path": [
        "Notifications",
        "Anatomy"
      ],
      "source_sentence_hash": "720aec84a67cc40d72e3418ff6cea0dafabac3215460d12d09a26e7f845c9e72",
      "word_count": 5
    },
    {
      "text": "Provide concise, informative notifications",
      "section_path": [
        "Notifications",
        "Best practices"
      ],
      "source_sentence_hash": "af9a4fa6c77a5ee5b6ad8e26bc5fa6b4a16fd84eadcad6a08dcbd36673746298",
      "word_count": 4
    },
    {
      "text": "Avoid sending multiple notifications for the same thing, even if someone hasn’t responded",
      "section_path": [
        "Notifications",
        "Best practices"
      ],
      "source_sentence_hash": "c2b67b1eaa221e55d949532cf2d349c6d14babb51ad7d65c1c011036a5cc9ce2",
      "word_count": 13
    },
    {
      "text": "Avoid sending a notification that tells people to perform specific tasks within your app",
      "section_path": [
        "Notifications",
        "Best practices"
      ],
      "source_sentence_hash": "6fbdc1ccff9184ce6c968774f8c903603908313a417712481105da768c476512",
      "word_count": 14
    },
    {
      "text": "Use an alert — not a notification — to display an error message",
      "section_path": [
        "Notifications",
        "Best practices"
      ],
      "source_sentence_hash": "445a98a973f7578d926dcb552868bc21b0f04185b63108a64e1d5903c2c612b2",
      "word_count": 13
    },
    {
      "text": "Handle notifications gracefully when your app is in the foreground",
      "section_path": [
        "Notifications",
        "Best practices"
      ],
      "source_sentence_hash": "2751eadb464445b37abdece1ec0c0a62772cf921c9f8830729e10c1f06358d1f",
      "word_count": 10
    },
    {
      "text": "Avoid including sensitive, personal, or confidential information in a notification",
      "section_path": [
        "Notifications",
        "Best practices"
      ],
      "source_sentence_hash": "c32de0ac7e0cd1fae31fbd61c84bfb07594ab0c7376e1d1581790333e405dc0d",
      "word_count": 10
    },
    {
      "text": "Create a short title if it provides context for the notification content",
      "section_path": [
        "Notifications",
        "Content"
      ],
      "source_sentence_hash": "84e437ed31fbf47e072d198f9961e200218432ca8a4e58b9bb6f39dd30fae061",
      "word_count": 12
    },
    {
      "text": "Write succinct, easy-to-read notification content",
      "section_path": [
        "Notifications",
        "Content"
      ],
      "source_sentence_hash": "b8f5dafcb5223e0527255341463c1c419aa5627c2b1a60de3df616bedb45dfce",
      "word_count": 5
    },
    {
      "text": "Provide generically descriptive text to display when notification previews aren’t available",
      "section_path": [
        "Notifications",
        "Content"
      ],
      "source_sentence_hash": "d9427bc2386bf308498f2b3f5b8ae586640caeec291f32efeb5bf7167b9a6a4d",
      "word_count": 11
    },
    {
      "text": "Avoid including your app name or icon",
      "section_path": [
        "Notifications",
        "Content"
      ],
      "source_sentence_hash": "4a2d3c36d4c90fffd54c52bb74e5818eb8590a582918f7f7ff7a4b62ca29039f",
      "word_count": 7
    },
    {
      "text": "Consider providing a sound to supplement your notifications",
      "section_path": [
        "Notifications",
        "Content"
      ],
      "source_sentence_hash": "254533e0e42be8f73d0f7e9455d0bc7677544313572f50c7eec442fa3653eb2e",
      "word_count": 8
    },
    {
      "text": "Provide beneficial actions that make sense in the context of your notification",
      "section_path": [
        "Notifications",
        "Notification actions"
      ],
      "source_sentence_hash": "d4ece0d23edb26d676f0a8ebbaab6192a9e1d72473929c51ce6b7a3ce1916d20",
      "word_count": 12
    },
    {
      "text": "Avoid providing an action that merely opens your app",
      "section_path": [
        "Notifications",
        "Notification actions"
      ],
      "source_sentence_hash": "6a6396e70efb24b338603abf98c4d6763a6908c01a76cce826d681dd396c1df6",
      "word_count": 9
    },
    {
      "text": "Prefer nondestructive actions",
      "section_path": [
        "Notifications",
        "Notification actions"
      ],
      "source_sentence_hash": "dd833375c5d196de5f3707ed7581cbd6acfe1017e0a2fe5bd9392ebe26400806",
      "word_count": 3
    },
    {
      "text": "Provide a simple, recognizable interface icon for each notification action",
      "section_path": [
        "Notifications",
        "Notification actions"
      ],
      "source_sentence_hash": "0dec8d2dc66ef3a5d8c8f3e9a4c4c2eb31d8c6863cb3bcd34b3fc50bf7acad5c",
      "word_count": 10
    },
    {
      "text": "Use a badge only to show people how many unread notifications they have",
      "section_path": [
        "Notifications",
        "Badging"
      ],
      "source_sentence_hash": "01e22a229c412ec09371e2f08ab7bcaee1d685dc79277ba0a22e411f987de6fb",
      "word_count": 13
    },
    {
      "text": "Make sure badging isn’t the only method you use to communicate essential information",
      "section_path": [
        "Notifications",
        "Badging"
      ],
      "source_sentence_hash": "2386c913da51a0dffed22d345ae28de2ac096706e4fd41a4c95a02696510bc8d",
      "word_count": 13
    },
    {
      "text": "Keep badges up to date",
      "section_path": [
        "Notifications",
        "Badging"
      ],
      "source_sentence_hash": "ba349ee3e3bc43cc55421c03335f789f4919a3ce3b6df3e51bfcef71016f5618",
      "word_count": 5
    },
    {
      "text": "Avoid creating a custom image or component that mimics the appearance or behavior of a badge",
      "section_path": [
        "Notifications",
        "Badging"
      ],
      "source_sentence_hash": "64c0a1b1b3988c3371d8b41da6d8d1735f35589223afcf5d1c6628f91d0c386d",
      "word_count": 16
    },
    {
      "text": "Short looks",
      "section_path": [
        "Notifications",
        "Platform considerations",
        "watchOS",
        "Short looks"
      ],
      "source_sentence_hash": "b5ada6720beba2690d4923aba9baa3e08ad6fcac38ba84c3dca9e34a38198112",
      "word_count": 2
    },
    {
      "text": "Avoid using a short look as the only way to communicate important information",
      "section_path": [
        "Notifications",
        "Platform considerations",
        "watchOS",
        "Short looks"
      ],
      "source_sentence_hash": "2c3fad2dbf36cecf7ca4489bfc4918d9fa96e74491d5cd8c8ed438a60a738796",
      "word_count": 13
    },
    {
      "text": "Keep privacy in mind",
      "section_path": [
        "Notifications",
        "Platform considerations",
        "watchOS",
        "Short looks"
      ],
      "source_sentence_hash": "33749ad7a4b9d03aa2976ae7c0931f8ba7f63b8a02347e7591c34d9c540eae52",
      "word_count": 4
    },
    {
      "text": "Long looks",
      "section_path": [
        "Notifications",
        "Platform considerations",
        "watchOS",
        "Long looks"
      ],
      "source_sentence_hash": "ba6e27f8f7372b2d23969d403aaed933c860cd4676e85dc672a39bbe508f074e",
      "word_count": 2
    },
    {
      "text": "Consider using a rich, custom long-look notification to let people get the information they need without launching your app",
      "section_path": [
        "Notifications",
        "Platform considerations",
        "watchOS",
        "Long looks"
      ],
      "source_sentence_hash": "875f5effb48a34b4a6cc72f465880fd8a826cfa676249b139335a79e268a61f6",
      "word_count": 19
    },
    {
      "text": "At the minimum, provide a static interface; prefer providing a dynamic interface too",
      "section_path": [
        "Notifications",
        "Platform considerations",
        "watchOS",
        "Long looks"
      ],
      "source_sentence_hash": "b0a0af3d3553c92f7c40db22a4533d175f7851110411680a52299596a32970cb",
      "word_count": 13
    },
    {
      "text": "Choose a background appearance for the sash",
      "section_path": [
        "Notifications",
        "Platform considerations",
        "watchOS",
        "Long looks"
      ],
      "source_sentence_hash": "4487afa1f58d02a91ec9f765c03f2b62b5266ff140e28849c7c2149ac47e01d5",
      "word_count": 7
    },
    {
      "text": "Choose a background color for the content area",
      "section_path": [
        "Notifications",
        "Platform considerations",
        "watchOS",
        "Long looks"
      ],
      "source_sentence_hash": "12b85c436fc0bf470968a69587f719061f6fcc37b6f5440b58dbce7f0b514d73",
      "word_count": 8
    },
    {
      "text": "Provide up to four custom actions below the content area",
      "section_path": [
        "Notifications",
        "Platform considerations",
        "watchOS",
        "Long looks"
      ],
      "source_sentence_hash": "7d9e95616d21d3886d55ee3dcc981d2fbf5d4ec88f8c7f9db081b0e5ab68cb08",
      "word_count": 10
    },
    {
      "text": "Double tap",
      "section_path": [
        "Notifications",
        "Platform considerations",
        "watchOS",
        "Double tap"
      ],
      "source_sentence_hash": "b7f18903d7ca55dde65f4cd88cf7ee05ab86ce74e1fa4872bf6da4f569791574",
      "word_count": 2
    },
    {
      "text": "Keep double tap in mind when choosing the order of custom actions you present as responses to a notification",
      "section_path": [
        "Notifications",
        "Platform considerations",
        "watchOS",
        "Double tap"
      ],
      "source_sentence_hash": "a92823fc368c004ea1c837f9f8b62d0cbfa2701ac8f058a9d2a4b3d94f4db7f3",
      "word_count": 19
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Notifications",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
