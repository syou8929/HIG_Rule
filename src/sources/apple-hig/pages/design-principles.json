  "guidance_candidates": [
    {
      "text": "Make something meaningful",
      "section_path": [
        "Design principles",
        "Purpose"
      ],
      "source_sentence_hash": "46c740a621582af152ff76f07c93fd770ef5322e95554958ba46ba004fd604dd",
      "word_count": 3
    },
    {
      "text": "Let people do things their own way",
      "section_path": [
        "Design principles",
        "Agency"
      ],
      "source_sentence_hash": "9cbe05b88caeb62c4473988380ab8f181e9da21e371b9eb60f94577e09b1d63c",
      "word_count": 7
    },
    {
      "text": "Act in people’s best interest",
      "section_path": [
        "Design principles",
        "Responsibility"
      ],
      "source_sentence_hash": "d6cf7a2479bd1869ae66a04148d2632bf98b1e29da49c8a76cba358492e0e517",
      "word_count": 5
    },
    {
      "text": "Build on what people know",
      "section_path": [
        "Design principles",
        "Familiarity"
      ],
      "source_sentence_hash": "ffccce49c23a17f16e1283c0d6851f14aa0bf86a371bd6a1f29a94b83286e29a",
      "word_count": 5
    },
    {
      "text": "Adapt to diverse contexts and needs",
      "section_path": [
        "Design principles",
        "Flexibility"
      ],
      "source_sentence_hash": "44b8f37c7f15a0ce5e50d75873fad2540cb3f7f93928279149f83c60e7c1436d",
      "word_count": 6
    },
    {
      "text": "Be clear and direct",
      "section_path": [
        "Design principles",
        "Simplicity"
      ],
      "source_sentence_hash": "0cda88d44ce5a514dc26cf915a46c605a622ec94fe102d87499e08f2b5e6a5ac",
      "word_count": 4
    },
    {
      "text": "Care about every detail",
      "section_path": [
        "Design principles",
        "Craft"
      ],
      "source_sentence_hash": "ddf23e45e8045a1bf14190b6e407de7e1119f52d47ef5a1562afdd557fd57493",
      "word_count": 4
    },
    {
      "text": "Make it human",
      "section_path": [
        "Design principles",
        "Delight"
      ],
      "source_sentence_hash": "c2080eb9fa23cb35f577020b6c4890db4eab2849ea472898d8e46e51ae4e189d",
      "word_count": 3
    },
    {
      "text": "Create value",
      "section_path": [
        "Design principles",
        "Purpose"
      ],
      "source_sentence_hash": "73f712f18ed2b35a25b47748dd633a734124ddd2ac2a4774ef97b93413b9fe18",
      "word_count": 2
    },
    {
      "text": "Keep focused",
      "section_path": [
        "Design principles",
        "Purpose"
      ],
      "source_sentence_hash": "0c0aa97388fc25e38656bb20b88e5d60495e6cf298f3d1c82a548f6523601e77",
      "word_count": 2
    },
    {
      "text": "Find new ways to solve the problem",
      "section_path": [
        "Design principles",
        "Purpose"
      ],
      "source_sentence_hash": "8569cefaa21293adcdae9bbfd67498478ebbf2b3ab0e550acaf7ed3517f05372",
      "word_count": 7
    },
    {
      "text": "Stay out of the way",
      "section_path": [
        "Design principles",
        "Agency"
      ],
      "source_sentence_hash": "f8fa9df8c648ffefe4204e55cf11dd31c1b7583f685184b48bbfb14e0bff1585",
      "word_count": 5
    },
    {
      "text": "Give people the freedom to explore",
      "section_path": [
        "Design principles",
        "Agency"
      ],
      "source_sentence_hash": "874821d6856721a245849860df26acdd0698d8d19a977957d41aafbcb2ca044f",
      "word_count": 6
    },
    {
      "text": "Help people recover from mistakes",
      "section_path": [
        "Design principles",
        "Agency"
      ],
      "source_sentence_hash": "1cd5bc3ec7ebb68186090e608ae7c912aa6a3614c4816e7739e2bbce827e0846",
      "word_count": 5
    },
    {
      "text": "Be fully transparent about what your product does and why",
      "section_path": [
        "Design principles",
        "Responsibility"
      ],
      "source_sentence_hash": "50db3a8ba569e326f5cc042807621befceeb452016490d58836f3ff0ae189704",
      "word_count": 10
    },
    {
      "text": "Make app intentions clear from the start",
      "section_path": [
        "Design principles",
        "Responsibility"
      ],
      "source_sentence_hash": "2612127e0e46a290bdc752a0d95b5c71565d5516c9722810a9976b916718963d",
      "word_count": 7
    },
    {
      "text": "Provide a clear rationale when asking for permission",
      "section_path": [
        "Design principles",
        "Responsibility"
      ],
      "source_sentence_hash": "29f1fb0e7d17a99bbba1585311c002d6cb6fc399a20832eafff051fba2399d12",
      "word_count": 8
    },
    {
      "text": "Disclose what data you collect and how you use it",
      "section_path": [
        "Design principles",
        "Responsibility"
      ],
      "source_sentence_hash": "29f1fb0e7d17a99bbba1585311c002d6cb6fc399a20832eafff051fba2399d12",
      "word_count": 10
    },
    {
      "text": "Keep people’s information safe",
      "section_path": [
        "Design principles",
        "Responsibility"
      ],
      "source_sentence_hash": "022359be92269ab60c1023ed24b00c1e9138b6dd981d1782e9b49f84f8bb5eba",
      "word_count": 4
    },
    {
      "text": "Collect only the data your product needs to function",
      "section_path": [
        "Design principles",
        "Responsibility"
      ],
      "source_sentence_hash": "2e79f0da8709985af5e7a72c1e66cb99e1eb3d5f6dff18ccd24c8c619feaa109",
      "word_count": 9
    },
    {
      "text": "Protect data against abuse and unintended consequences",
      "section_path": [
        "Design principles",
        "Responsibility"
      ],
      "source_sentence_hash": "f2c05a3c4e95fd6205a893317c2d11729ee6eaea538c2f69732437a354ea643b",
      "word_count": 7
    },
    {
      "text": "Use concepts that people know",
      "section_path": [
        "Design principles",
        "Familiarity"
      ],
      "source_sentence_hash": "904cd190858194ee3ee12aabec4c9aef0acdcebc8acfa4d135825629eaffb923",
      "word_count": 5
    },
    {
      "text": "Keep visuals and interactions consistent",
      "section_path": [
        "Design principles",
        "Familiarity"
      ],
      "source_sentence_hash": "7358d6e5e7fa44275d6a33a1d4c8103426b42819e04fd31a1017d252752c8b9d",
      "word_count": 5
    },
    {
      "text": "Provide clear feedback",
      "section_path": [
        "Design principles",
        "Familiarity"
      ],
      "source_sentence_hash": "ab117b431b848b50c2cc71339c9fe000d219cb1798cee53c2b692ab02caaf3ef",
      "word_count": 3
    },
    {
      "text": "Design for everyone",
      "section_path": [
        "Design principles",
        "Flexibility"
      ],
      "source_sentence_hash": "794d07004317256e6dfd44bf1c63bf646cb0ba3d82b1b831fab0ceeb593fde81",
      "word_count": 3
    },
    {
      "text": "Treat accessibility as a priority from the start",
      "section_path": [
        "Design principles",
        "Flexibility"
      ],
      "source_sentence_hash": "b7087b1146296d97529e7c6dd9b19474fe84ebb4e7361b891354d23c30d04ad9",
      "word_count": 8
    },
    {
      "text": "Preserve a person’s context",
      "section_path": [
        "Design principles",
        "Flexibility"
      ],
      "source_sentence_hash": "ab789e57c9fafe039ea93283305d58db8839aa1fdbcfadd3128c929c2acf475d",
      "word_count": 4
    },
    {
      "text": "Consider a variety of input methods",
      "section_path": [
        "Design principles",
        "Flexibility"
      ],
      "source_sentence_hash": "a915490b0532ee20788b1358474a847032e3869689a81b23369e811e6c2b83fd",
      "word_count": 6
    },
    {
      "text": "Approach every platform with intention",
      "section_path": [
        "Design principles",
        "Flexibility"
      ],
      "source_sentence_hash": "7519a76bf912d17463326199207ed4cadaff19b3689837660e9cdc2d88907804",
      "word_count": 5
    },
    {
      "text": "Include just what’s necessary",
      "section_path": [
        "Design principles",
        "Simplicity"
      ],
      "source_sentence_hash": "9be2a2a469ac5dbc853f163f281e6a9a32f6643cf52ac1dbb7c75be5b35bae63",
      "word_count": 4
    },
    {
      "text": "Be concise",
      "section_path": [
        "Design principles",
        "Simplicity"
      ],
      "source_sentence_hash": "ab018bdb7d92dcdb652e75498db55773bbb1a281f2a436aaebf05ab0d531484c",
      "word_count": 2
    },
    {
      "text": "Establish hierarchy",
      "section_path": [
        "Design principles",
        "Simplicity"
      ],
      "source_sentence_hash": "a0199558e3e7cf9f9e4ee1193c1bd18f04fd1e07b4a2b1ec229a45d16233293d",
      "word_count": 2
    },
    {
      "text": "Quality sets the tone",
      "section_path": [
        "Design principles",
        "Craft"
      ],
      "source_sentence_hash": "9007f72192afd8d972b1059f04b347cffb71dee20ec5bdbfa919c245e3f38a46",
      "word_count": 4
    },
    {
      "text": "Experiment and iterate",
      "section_path": [
        "Design principles",
        "Craft"
      ],
      "source_sentence_hash": "a1a74aa9962fc9b781f42682a89253f1f6ca68f64b9943c98a824665bac92db0",
      "word_count": 3
    },
    {
      "text": "Maintain your craft",
      "section_path": [
        "Design principles",
        "Craft"
      ],
      "source_sentence_hash": "62385d11a24e04e02712ed46b199a860e84a5682b3b7851afd4a62bf41136b2f",
      "word_count": 3
    },
    {
      "text": "Identify the emotion you want to inspire",
      "section_path": [
        "Design principles",
        "Delight"
      ],
      "source_sentence_hash": "642175e481c75fb666bbcc79ac56bb872d9e5885f01311e882a2e105c68d5175",
      "word_count": 7
    },
    {
      "text": "Create defining moments",
      "section_path": [
        "Design principles",
        "Delight"
      ],
      "source_sentence_hash": "1f445d3ef6d7a3aa4ac8bed6018d2e6021525036a1650ce6407d3b0ef55b6618",
      "word_count": 3
    },
    {
      "text": "Don’t mistake delight for decoration",
      "section_path": [
        "Design principles",
        "Delight"
      ],
      "source_sentence_hash": "0de6a1e80d761db7b8e3f67ccf4b4ea2febe359442c70e0b9efb4c701d0cf2dd",
      "word_count": 5
    },
    {
      "text": "Consider the whole",
      "section_path": [
        "Design principles",
        "Delight"
      ],
      "source_sentence_hash": "7eb9d67790a6a71c1d079ae3f691f25dd1dbadf363ffa9a994bfdbccf0cf5393",
      "word_count": 3
    }
  ],
