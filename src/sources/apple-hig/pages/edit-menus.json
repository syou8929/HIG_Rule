  "guidance_candidates": [
    {
      "text": "Prefer the system-provided edit menu",
      "section_path": [
        "Edit menus",
        "Best practices"
      ],
      "source_sentence_hash": "0922061ae479ca380efe4d1aa1e088beca862da19b7bb42893d0e25692a33076",
      "word_count": 5
    },
    {
      "text": "Let people reveal an edit menu using the system-defined interactions they already know",
      "section_path": [
        "Edit menus",
        "Best practices"
      ],
      "source_sentence_hash": "72e5c5d4c35dfaf67f15bfcec292b3c4515d45cb1e43a81989b6c74f319c8d4d",
      "word_count": 13
    },
    {
      "text": "Offer commands that are relevant in the current context, removing or dimming commands that don’t apply",
      "section_path": [
        "Edit menus",
        "Best practices"
      ],
      "source_sentence_hash": "5b9c56c8964161e0fb9a32b7d9c93a5b98bea9da74f0a04501fb6973e2cf5849",
      "word_count": 16
    },
    {
      "text": "List custom commands near relevant system-provided ones",
      "section_path": [
        "Edit menus",
        "Best practices"
      ],
      "source_sentence_hash": "f09ab97187281e5d47e41156058d19ee545ae8de73b57b89796a37355d2add6a",
      "word_count": 7
    },
    {
      "text": "When it makes sense, let people select and copy noneditable text",
      "section_path": [
        "Edit menus",
        "Best practices"
      ],
      "source_sentence_hash": "e25bdc225c9d6e30b0515e4dc9227c1102cb0d0b06f9361804fbc1ee2cb92889",
      "word_count": 11
    },
    {
      "text": "Support undo and redo when possible",
      "section_path": [
        "Edit menus",
        "Best practices"
      ],
      "source_sentence_hash": "18535710e33decdd1e8c38692356f5fd7d2d84d815f5a3717155e004e9e90dfb",
      "word_count": 6
    },
    {
      "text": "In general, avoid implementing other controls that perform the same functions as edit menu items",
      "section_path": [
        "Edit menus",
        "Best practices"
      ],
      "source_sentence_hash": "7512bef8c41b7048e488db3d0f3cc1291c304d68d76ea1dcd0ce8eacbcdbf503",
      "word_count": 15
    },
    {
      "text": "Differentiate different types of deletion commands when necessary",
      "section_path": [
        "Edit menus",
        "Best practices"
      ],
      "source_sentence_hash": "e75a01619ef4380fa1584353cb1dfa410109dffdb24a64d5e5968370bf228a18",
      "word_count": 8
    },
    {
      "text": "Create short labels for custom commands",
      "section_path": [
        "Edit menus",
        "Content"
      ],
      "source_sentence_hash": "814f7ebcc7b6efa8b825534a0195ed9e7c7c2c8d1ddba09b6a74d3ae8d716c8d",
      "word_count": 6
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "Edit menus",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "Ensure your edit menu works well in both styles",
      "section_path": [
        "Edit menus",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "e5fb705390f0daa55bca69e298e1264bac5f3571011ac867d10b1f8e31ee406a",
      "word_count": 9
    },
    {
      "text": "Adjust an edit menu’s placement, if necessary",
      "section_path": [
        "Edit menus",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "25f15ca72bb3196775ee0713f99a9de0239ee6c44b4606380293fa5d57beeeb5",
