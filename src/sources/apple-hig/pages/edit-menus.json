  "guidance_candidates": [
    {
      "text": "In iOS, the edit menu displays commands in a compact, horizontal list that appears when people touch and hold",
      "section_path": [
        "Edit menus"
      ],
      "source_sentence_hash": "954243f19e1ca75a38bad6286e7c91aacd435873c920d49dacff0188b35f0802",
      "word_count": 19
    },
    {
      "text": "In macOS, people can access editing commands in a context menu they can reveal while in an editing task,",
      "section_path": [
        "Edit menus"
      ],
      "source_sentence_hash": "5cbdcd99652b30908da66eadbda7ac7e369508548c1a1252a37c488ad736d3dc",
      "word_count": 19
    },
    {
      "text": "In visionOS, people use the standard pinch and hold gesture to open the edit menu as a horizontal bar,",
      "section_path": [
        "Edit menus"
      ],
      "source_sentence_hash": "4be4ef5ff2fc21d146af78ea321660d6daf1dbcf5a60b085dcdb2edb337df4c7",
      "word_count": 19
    },
    {
      "text": "Prefer the system-provided edit menu",
      "section_path": [
        "Edit menus",
        "Best practices"
      ],
      "source_sentence_hash": "38396d999b13b926d0ca91b232ceff1d2b0ac32e7be67baa671542b71fd096a0",
      "word_count": 5
    },
    {
      "text": "Let people reveal an edit menu using the system-defined interactions they already know",
      "section_path": [
        "Edit menus",
        "Best practices"
      ],
      "source_sentence_hash": "c2585035b56f7d3b406bb0888992c373b8ee3d0de159c34aee3fb3ca123efc0b",
      "word_count": 13
    },
    {
      "text": "Offer commands that are relevant in the current context, removing or dimming commands that don’t apply",
      "section_path": [
        "Edit menus",
        "Best practices"
      ],
      "source_sentence_hash": "a6a86dc42bb3499166608e4e530c4193bc62e15052c61011e58bb0868dc5f752",
      "word_count": 16
    },
    {
      "text": "Place custom commands near relevant system-provided ones",
      "section_path": [
        "Edit menus",
        "Best practices"
      ],
      "source_sentence_hash": "e85436cc61480f2e8c6b3ae17d7eeb4150c7fb8e57745a442cce8e4c6e016080",
      "word_count": 7
    },
    {
      "text": "Avoid overwhelming people with too many custom commands",
      "section_path": [
        "Edit menus",
        "Best practices"
      ],
      "source_sentence_hash": "e85436cc61480f2e8c6b3ae17d7eeb4150c7fb8e57745a442cce8e4c6e016080",
      "word_count": 8
    },
    {
      "text": "Let people select and copy noneditable text when it makes sense",
      "section_path": [
        "Edit menus",
        "Best practices"
      ],
      "source_sentence_hash": "02c981d52276c2619f7ef43be4a1d2da3c1529486b4e3727d80078ba87927898",
      "word_count": 11
    },
    {
      "text": "Avoid making control labels copyable",
      "section_path": [
        "Edit menus",
        "Best practices"
      ],
      "source_sentence_hash": "02c981d52276c2619f7ef43be4a1d2da3c1529486b4e3727d80078ba87927898",
      "word_count": 5
    },
    {
      "text": "Support undo and redo when possible",
      "section_path": [
        "Edit menus",
        "Best practices"
      ],
      "source_sentence_hash": "c09d479891546102473ca33cdfae36255d2468e118ffff0932c60482901eaa4d",
      "word_count": 6
    },
    {
      "text": "In general, avoid implementing other controls that perform the same functions as edit menu items",
      "section_path": [
        "Edit menus",
        "Best practices"
      ],
      "source_sentence_hash": "fe451dc8139bf5bd8ae6b746b300ed960b0679f482585d4bd9ff62b7e26c43f4",
      "word_count": 15
    },
    {
      "text": "Distinguish deletion commands that behave differently when necessary",
      "section_path": [
        "Edit menus",
        "Best practices"
      ],
      "source_sentence_hash": "c1f3b2955bab6bb2eb74ad2d8cbabb7769e4c7df6bedcf652edddf9f7daee7c0",
      "word_count": 8
    },
    {
      "text": "Create short labels for custom commands",
      "section_path": [
        "Edit menus",
        "Content"
      ],
      "source_sentence_hash": "883b306cf7708346d6b36dc40b188dd772d0679c66d66a87c27318fef15d48dc",
      "word_count": 6
    },
    {
      "text": "Use verbs or short verb phrases that succinctly describe the command action",
      "section_path": [
        "Edit menus",
        "Content"
      ],
      "source_sentence_hash": "883b306cf7708346d6b36dc40b188dd772d0679c66d66a87c27318fef15d48dc",
      "word_count": 12
    },
    {
      "text": "Avoid relying on edit menus in tvOS or watchOS",
      "section_path": [
        "Edit menus",
        "Platform considerations"
      ],
      "source_sentence_hash": "7d8f8ae7e3c2194af3f2ee6e6d5cc9e239ef3a5593425ef8962afbce111009ea",
      "word_count": 9
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "Edit menus",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "Ensure your edit menu works well in both styles",
      "section_path": [
        "Edit menus",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "2d89cf22875ebb2750714f38699b582764ed3271a18da8c0a00962ea2b53686b",
      "word_count": 9
    },
    {
      "text": "Position an edit menu to avoid covering important content when necessary",
      "section_path": [
        "Edit menus",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "ed1184c316b52d25631400ede8ab0dda5942bc585e1544752a0656b12161c132",
      "word_count": 11
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Edit menus",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
