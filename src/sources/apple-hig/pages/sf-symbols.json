  "guidance_candidates": [
    {
      "text": "Confirm that a symbol’s rendering mode works well in every context",
      "section_path": [
        "SF Symbols",
        "Rendering modes"
      ],
      "source_sentence_hash": "951d3bdb6a70168a9a57191cb571755b41d10f41184baef91aa7ddea9308555d",
      "word_count": 11
    },
    {
      "text": "Use variable color to communicate change",
      "section_path": [
        "SF Symbols",
        "Variable color"
      ],
      "source_sentence_hash": "3ac173b62dfb8a4aa5be3ab43ed7148431c997b731fd6356c6c4023133abe064",
      "word_count": 6
    },
    {
      "text": "Use the outline variant alongside text",
      "section_path": [
        "SF Symbols",
        "Design variants"
      ],
      "source_sentence_hash": "8e85892a00ae38bcef9606e2d0be682ee7468c65a198bcb9ede1691709acf99e",
      "word_count": 6
    },
    {
      "text": "Consider an enclosing variant to improve legibility at small sizes",
      "section_path": [
        "SF Symbols",
        "Design variants"
      ],
      "source_sentence_hash": "2d1e9994cfc93073995487736cc7fe3b6a47403163dcb8ce5d7806ef9078108a",
      "word_count": 10
    },
    {
      "text": "Use a fill variant for emphasis or selection",
      "section_path": [
        "SF Symbols",
        "Design variants"
      ],
      "source_sentence_hash": "aedabd221476ab360f0a9c965ba8bf70d1233770fcaa4fc8ec69f37d2a2c4e97",
      "word_count": 8
    },
    {
      "text": "Variable color",
      "section_path": [
        "SF Symbols",
        "Animations"
      ],
      "source_sentence_hash": "d943d702f53e99067b6815323ab47d72a575048ff312ee95115f188c99734de6",
      "word_count": 2
    },
    {
      "text": "Down-up, where the outgoing symbol scales down and the incoming symbol scales up, communicating a change in state",
      "section_path": [
        "SF Symbols",
        "Animations"
      ],
      "source_sentence_hash": "3d14d90b0f480d3dd761a65f3b601e2f4de5c836d41eba885360690473b11022",
      "word_count": 18
    },
    {
      "text": "Up-up, where both the outgoing and incoming symbols scale up. This configuration communicates a change in state that includes",
      "section_path": [
        "SF Symbols",
        "Animations"
      ],
      "source_sentence_hash": "ee933a6ba884d0c6337433b39fe17cf5572e263ed016309951e6dcaff4ad1d93",
      "word_count": 19
    },
    {
      "text": "Off-up, where the outgoing symbol hides immediately and the incoming symbol scales up. This configuration communicates a state change",
      "section_path": [
        "SF Symbols",
        "Animations"
      ],
      "source_sentence_hash": "50a22b81108699f864b327c7ea7b0cc620202602483320680d60fdc849a7b6a6",
      "word_count": 19
    },
    {
      "text": "Magic Replace",
      "section_path": [
        "SF Symbols",
        "Animations"
      ],
      "source_sentence_hash": "5526bf91790fb7250316e447a40dd4fa494975b94607eeb64e02ab9e15189c44",
      "word_count": 2
    },
    {
      "text": "Draw On / Draw Off",
      "section_path": [
        "SF Symbols",
        "Animations"
      ],
      "source_sentence_hash": "9c4e693b149182ba9da9f2a58b39f1eb0be46c89e7203e4a1e27044aeec42c73",
      "word_count": 5
    },
    {
      "text": "Apply symbol animations judiciously",
      "section_path": [
        "SF Symbols",
        "Animations"
      ],
      "source_sentence_hash": "011050637b01d91100bbc71281999e0f6fac62381facd47810a47797da9d7670",
      "word_count": 4
    },
    {
      "text": "Make sure that animations serve a clear purpose in communicating a symbol’s intent",
      "section_path": [
        "SF Symbols",
        "Animations"
      ],
      "source_sentence_hash": "ce94fe0ffec89a52d7753e6c73e13403366ae9de063ea93b6e26ba764716740d",
      "word_count": 13
    },
    {
      "text": "Use symbol animations to communicate information more efficiently",
      "section_path": [
        "SF Symbols",
        "Animations"
      ],
      "source_sentence_hash": "e53d5bfa48fdd20fb3c3d26f6a35777ff85d2b780e3f9d32eeb56d8f0fbe5377",
      "word_count": 8
    },
    {
      "text": "Consider your app’s tone when adding animations",
      "section_path": [
        "SF Symbols",
        "Animations"
      ],
      "source_sentence_hash": "5ed923e6073f68fa391a56c0dab1fbfd7fae052cf79a0d7b740c1f3372bc78c3",
      "word_count": 7
    },
    {
      "text": "Use the template as a guide",
      "section_path": [
        "SF Symbols",
        "Custom symbols"
      ],
      "source_sentence_hash": "1a9224cb4242396c8ad79f3991da495889d71fc0a268abb1674d9300f6838ef9",
      "word_count": 6
    },
    {
      "text": "Directly related to the action or content it represents",
      "section_path": [
        "SF Symbols",
        "Custom symbols"
      ],
      "source_sentence_hash": "2a832f88664a357b042f36b6ae6822f79116c2c0c3ce8cf951c89283da7bb3ea",
      "word_count": 9
    },
    {
      "text": "Consider negative side margins for optical alignment",
      "section_path": [
        "SF Symbols",
        "Custom symbols"
      ],
      "source_sentence_hash": "75b0293f77ca617c8a07d9faa92c3f901e7f1f99394f003d0d169245b56f00e5",
      "word_count": 7
    },
    {
      "text": "Optimize layers to use animations with custom symbols",
      "section_path": [
        "SF Symbols",
        "Custom symbols"
      ],
      "source_sentence_hash": "7a282fdf247e825e99d9177bf3decbc889e3ab0675233eb10031f4b712e6d9e6",
      "word_count": 8
    },
    {
      "text": "Test animations for custom symbols",
      "section_path": [
        "SF Symbols",
        "Custom symbols"
      ],
      "source_sentence_hash": "dd16892ff4fab90608ac00af2a93b035f1a428521b65e0343e8d0de8bb24c7c5",
      "word_count": 5
    },
    {
      "text": "Avoid making custom symbols that include common variants, such as enclosures or badges",
      "section_path": [
        "SF Symbols",
        "Custom symbols"
      ],
      "source_sentence_hash": "ec450e192d92de06dae45584fcc857b48d0202835717e4f500a2d6952159b200",
      "word_count": 13
    },
    {
      "text": "Provide alternative text labels for custom symbols",
      "section_path": [
        "SF Symbols",
        "Custom symbols"
      ],
      "source_sentence_hash": "0f75f44d0a484750b75400a2180e83db366ee087f53d9d572eef9745975901d8",
      "word_count": 7
    },
    {
      "text": "Don’t design replicas of Apple products",
      "section_path": [
        "SF Symbols",
        "Custom symbols"
      ],
      "source_sentence_hash": "77a638da959c6aeb92d3d5c3be35367f4655fa33cb33912690788c11d20a17da",
      "word_count": 6
    },
    {
      "text": "Confirm symbol and feature availability on each targeted system version",
      "section_path": [
        "SF Symbols"
      ],
      "source_sentence_hash": "d8155170c85938f8eb7b940d01b01750c3632f680936d9aebfdb67d38a5e2ee7",
      "word_count": 10
    },
    {
      "text": "Be sure to understand the SF Symbols terms and conditions",
      "section_path": [
        "SF Symbols"
      ],
      "source_sentence_hash": "b8f7ed97ff2340d47bd1d03827b18369e8b7b5aa73754059e6ca5ec3e9af7f75",
      "word_count": 10
    },
    {
      "text": "Avoid trademarked uses of SF Symbols or confusingly similar images",
      "section_path": [
        "SF Symbols"
      ],
      "source_sentence_hash": "b8f7ed97ff2340d47bd1d03827b18369e8b7b5aa73754059e6ca5ec3e9af7f75",
      "word_count": 10
    },
    {
      "text": "Use system-provided colors for adaptive symbol appearances",
      "section_path": [
        "SF Symbols",
        "Rendering modes"
      ],
      "source_sentence_hash": "7383245dc2eaa243ed8aa259ba97d175dcdc9a54871ed0548fcac4c8f7cfb85a",
      "word_count": 7
    },
    {
      "text": "Prefer gradients at larger symbol sizes",
      "section_path": [
        "SF Symbols",
        "Gradients"
      ],
      "source_sentence_hash": "b38159d674b6c692151876d7593d8de8687fe2e91c3e541e15d97feec132e8d8",
      "word_count": 6
    },
    {
      "text": "Avoid using variable color to communicate depth",
      "section_path": [
        "SF Symbols",
        "Variable color"
      ],
      "source_sentence_hash": "3ac173b62dfb8a4aa5be3ab43ed7148431c997b731fd6356c6c4023133abe064",
      "word_count": 7
    },
    {
      "text": "Use Hierarchical rendering mode to communicate depth",
      "section_path": [
        "SF Symbols",
        "Variable color"
      ],
      "source_sentence_hash": "3ac173b62dfb8a4aa5be3ab43ed7148431c997b731fd6356c6c4023133abe064",
      "word_count": 7
    },
    {
      "text": "Match symbol weight to adjacent San Francisco text",
      "section_path": [
        "SF Symbols",
        "Weights and scales"
      ],
      "source_sentence_hash": "5176429e76792fb97b87ed200fde66fb1ac1cdfcee368bd42492f5e450187006",
      "word_count": 8
    },
    {
      "text": "Consider symbol scale when adjusting emphasis beside text",
      "section_path": [
        "SF Symbols",
        "Weights and scales"
      ],
      "source_sentence_hash": "5cf200ca2b7b75e45298880efa3ba708efd9b547fcc09629cdf9ed31787fa551",
      "word_count": 8
    },
    {
      "text": "Use design variants to communicate precise states and actions",
      "section_path": [
        "SF Symbols",
        "Design variants"
      ],
      "source_sentence_hash": "65622de0e197dd04fd3110445ba931c5eddc152a8a658ded085fd750557004e6",
      "word_count": 9
    },
    {
      "text": "Consider letting the containing view choose outline or fill",
      "section_path": [
        "SF Symbols",
        "Design variants"
      ],
      "source_sentence_hash": "dd0dd36c42c9f03173c94b3ceef373acc05815a2bad9a49381353440a5d7352f",
      "word_count": 9
    },
    {
      "text": "Create custom symbols from a similar exported template",
      "section_path": [
        "SF Symbols",
        "Custom symbols"
      ],
      "source_sentence_hash": "b5e2fee2877ada41a52212f8960fef77fbb8d777f8e5034eaf3b909e395a2b84",
      "word_count": 8
    },
    {
      "text": "Do not customize SF Symbols that depict Apple products or features",
      "section_path": [
        "SF Symbols",
        "Custom symbols"
      ],
      "source_sentence_hash": "9255062724bfb42e9cca535de562a49291e6e028ca8c504c8baf5c7b96ce98b7",
      "word_count": 11
    },
    {
      "text": "Use the documented naming pattern for custom-symbol margins",
      "section_path": [
        "SF Symbols",
        "Custom symbols"
      ],
      "source_sentence_hash": "f379bb9e6253f8847696e9eb622e05b62bf6e91e4e01bf86d695413c452f6580",
      "word_count": 8
    },
    {
      "text": "Make sure to annotate custom-symbol layers before by-layer animation",
      "section_path": [
        "SF Symbols",
        "Custom symbols"
      ],
      "source_sentence_hash": "eb02e61b3d5dcd648ab1717892e4cf98378b502d37d3489f73461d88ec26e5f3",
      "word_count": 9
    },
    {
      "text": "Consider drawing custom symbols with whole shapes for animation",
      "section_path": [
        "SF Symbols",
        "Custom symbols"
      ],
      "source_sentence_hash": "b3deb805c0f8d1f371bef56d4731a115f13ae294510ee0556c347f893609fe3e",
      "word_count": 9
    },
