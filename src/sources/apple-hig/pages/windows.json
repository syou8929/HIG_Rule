  "guidance_candidates": [
    {
      "text": "A primary window presents the main navigation and content of an app, and actions associated with them",
      "section_path": [
        "Windows"
      ],
      "source_sentence_hash": "3b51f69738b0508570e8097a6eeea353f5dbaa7ea5d54e8a8bc9b556e2041752",
      "word_count": 17
    },
    {
      "text": "An auxiliary window presents a specific task or area in an app. Dedicated to one experience, an auxiliary window",
      "section_path": [
        "Windows"
      ],
      "source_sentence_hash": "ebe97037cdf479fc1854408697ad2614686bd8627f8ea6fda0d6bb2891a82286",
      "word_count": 19
    },
    {
      "text": "Make sure that your windows adapt fluidly to different sizes to support multitasking and multiwindow workflows",
      "section_path": [
        "Windows",
        "Best practices"
      ],
      "source_sentence_hash": "599e4eb5c360a790f9dddc6b3bca4e4548475d1b34e3594adab3aeea6257b3dd",
      "word_count": 16
    },
    {
      "text": "Choose the right moment to open a new window",
      "section_path": [
        "Windows",
        "Best practices"
      ],
      "source_sentence_hash": "2ec9a2db43c7a2bc708985311d6327563e15f1acc5fd104823103a22d0ffa357",
      "word_count": 9
    },
    {
      "text": "Avoid opening new windows by default unless it suits the app",
      "section_path": [
        "Windows",
        "Best practices"
      ],
      "source_sentence_hash": "2ec9a2db43c7a2bc708985311d6327563e15f1acc5fd104823103a22d0ffa357",
      "word_count": 11
    },
    {
      "text": "Consider providing the option to view content in a new window",
      "section_path": [
        "Windows",
        "Best practices"
      ],
      "source_sentence_hash": "0e8b7487ea426a07ecb517152735f506d651d2580b7c931ccc396c5a9417812c",
      "word_count": 11
    },
    {
      "text": "Avoid creating custom window UI",
      "section_path": [
        "Windows",
        "Best practices"
      ],
      "source_sentence_hash": "87525df8bdb091b07f31ab17070b8e1cf275de431b2f2cecbfed8e34aa9e5701",
      "word_count": 5
    },
    {
      "text": "Use the term window in user-facing content",
      "section_path": [
        "Windows",
        "Best practices"
      ],
      "source_sentence_hash": "9d64b356b35df10c334148ff1bbea41209abdf8cc2f2e2ecee5f9cdd23ca440d",
      "word_count": 7
    },
    {
      "text": "Full screen",
      "section_path": [
        "Windows",
        "Platform considerations",
        "iPadOS"
      ],
      "source_sentence_hash": "bf44d63e9b0ba577f6a7e11a511bf18d5d806b1c27a7b563ac6f14172ff9ada7",
      "word_count": 2
    },
    {
      "text": "Make sure window controls don’t overlap toolbar items",
      "section_path": [
        "Windows",
        "Platform considerations",
        "iPadOS"
      ],
      "source_sentence_hash": "d2f612da061aa4edcdd34be4578e869cc8152633239830df9634e3342f5ef993",
      "word_count": 8
    },
    {
      "text": "Consider letting people use a gesture to open content in a new window",
      "section_path": [
        "Windows",
        "Platform considerations",
        "iPadOS"
      ],
      "source_sentence_hash": "dea82006c266acf1bd47143e7dd9eb84a35ff560e3ac48f2aac9aad4ade77d83",
      "word_count": 13
    },
    {
      "text": "macOS window anatomy",
      "section_path": [
        "Windows",
        "Platform considerations",
        "macOS",
        "macOS window anatomy"
      ],
      "source_sentence_hash": "d1728c6e2e3b8cec7f88185d5f2af653b3a4cc75806dd4997ee10c360ba10ea3",
      "word_count": 3
    },
    {
      "text": "macOS window states",
      "section_path": [
        "Windows",
        "Platform considerations",
        "macOS",
        "macOS window states"
      ],
      "source_sentence_hash": "9e03aedf5fb029d97cb483f1af65de6c8e659ec73de3cb675b121e694db28fb4",
      "word_count": 3
    },
    {
      "text": "Make sure custom windows use the system-defined appearances",
      "section_path": [
        "Windows",
        "Platform considerations",
        "macOS",
        "macOS window states"
      ],
      "source_sentence_hash": "542af42d9e328ac9639d7b36490821646974a8667045ef238ca03cc640f21bf9",
      "word_count": 8
    },
    {
      "text": "Avoid putting critical information or actions in a bottom bar, because people often relocate a window in a way",
      "section_path": [
        "Windows",
        "Platform considerations",
        "macOS",
        "macOS window states"
      ],
      "source_sentence_hash": "0960b6018462278ed6fa6ebc62be75bad82f8b267396715926df9177b6478ecd",
      "word_count": 19
    },
    {
      "text": "visionOS windows",
      "section_path": [
        "Windows",
        "Platform considerations",
        "visionOS",
        "visionOS windows"
      ],
      "source_sentence_hash": "df8f76f3796b10d731cf63302bd9a5d5b49ef0ebca9e9d3207a0d84f6e930832",
      "word_count": 2
    },
    {
      "text": "Prefer using a window to present a familiar interface and to support familiar tasks",
      "section_path": [
        "Windows",
        "Platform considerations",
        "visionOS",
        "visionOS windows"
      ],
      "source_sentence_hash": "965779f72ffca3f85bf3960b76fd0ac2ff4417a85dcec9712b361542cd5b9a60",
      "word_count": 14
    },
    {
      "text": "Retain the window’s glass background",
      "section_path": [
        "Windows",
        "Platform considerations",
        "visionOS",
        "visionOS windows"
      ],
      "source_sentence_hash": "1a30d537435cb02a290d2a4ceddbb882301826daf936f7f0804694763b310113",
      "word_count": 5
    },
    {
      "text": "Choose an initial window size that minimizes empty areas within it",
      "section_path": [
        "Windows",
        "Platform considerations",
        "visionOS",
        "visionOS windows"
      ],
      "source_sentence_hash": "c90105c92c4f02a97c76d19ed965096cabfc2270e073c3218fe4aa75765f39cb",
      "word_count": 11
    },
    {
      "text": "Aim for an initial shape that suits a window’s content",
      "section_path": [
        "Windows",
        "Platform considerations",
        "visionOS",
        "visionOS windows"
      ],
      "source_sentence_hash": "959cbb74e8bbc158f6eaf62453dc5f776c59948dbfb04710132fb4cb8efb91ce",
      "word_count": 10
    },
    {
      "text": "Choose a minimum and maximum size for each window to help keep your content looking great",
      "section_path": [
        "Windows",
        "Platform considerations",
        "visionOS",
        "visionOS windows"
      ],
      "source_sentence_hash": "41087da2f724344baecdcd058703f1b119df059ba0967275144c94ff86e54a0c",
      "word_count": 16
    },
    {
      "text": "Minimize the depth of 3D content you display in a window",
      "section_path": [
        "Windows",
        "Platform considerations",
        "visionOS",
        "visionOS windows"
      ],
      "source_sentence_hash": "f7c84455e842478e713dad266db4dbff4504f17fb453c632e746516f750c7f99",
      "word_count": 11
    },
    {
      "text": "visionOS volumes",
      "section_path": [
        "Windows",
        "Platform considerations",
        "visionOS",
        "visionOS volumes"
      ],
      "source_sentence_hash": "7006789a2dc85c51952a0e4b86acf55d16bc57a1b9ac818c3b268ee454a519be",
      "word_count": 2
    },
    {
      "text": "Prefer using a volume to display rich, 3D content",
      "section_path": [
        "Windows",
        "Platform considerations",
        "visionOS",
        "visionOS volumes"
      ],
      "source_sentence_hash": "e8daa3f46c97d0ce20cbfd98e02b2926a32be4501748bf95934779513ffa48e6",
      "word_count": 9
    },
    {
      "text": "Place 2D content so it looks good from multiple angles",
      "section_path": [
        "Windows",
        "Platform considerations",
        "visionOS",
        "visionOS volumes"
      ],
      "source_sentence_hash": "792e35242794b88e6b3997cff77019b2d4989b80dbaa24372dbc9c1eb87d3aca",
      "word_count": 10
    },
    {
      "text": "In general, use dynamic scaling",
      "section_path": [
        "Windows",
        "Platform considerations",
        "visionOS",
        "visionOS volumes"
      ],
      "source_sentence_hash": "691a6f0d7abb089e34589e6a0773a70a51af714114954078d05c23480ea4f8d9",
      "word_count": 5
    },
    {
      "text": "Take advantage of the default baseplate appearance to help people discern the edges of a volume",
      "section_path": [
        "Windows",
        "Platform considerations",
        "visionOS",
        "visionOS volumes"
      ],
      "source_sentence_hash": "67810b9456d38ffa9eaadd5d9aab307e2bab143cf9e691fd0bc711e6a2857165",
      "word_count": 16
    },
    {
      "text": "Consider offering high-value content in an ornament",
      "section_path": [
        "Windows",
        "Platform considerations",
        "visionOS",
        "visionOS volumes"
      ],
      "source_sentence_hash": "ebfa0b846f5b7017213e5f5c7f3ab290bf897722adbbaa13fca18a4cef165f53",
      "word_count": 7
    },
    {
      "text": "Choose an alignment that supports the way people interact with your volume",
      "section_path": [
        "Windows",
        "Platform considerations",
        "visionOS",
        "visionOS volumes"
      ],
      "source_sentence_hash": "f75bae860c25c1b4774275f419b995a5d35012f9b2413acd794aa9b2d6f5e7be",
      "word_count": 12
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Windows",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    },
    {
      "text": "If you only need to let people view one file, you can present it without creating your own window",
      "section_path": [
        "Windows",
        "Platform considerations",
        "iPadOS"
      ],
      "source_sentence_hash": "e45dc43ad69b4a362a8164d2692194fcb62b2704fa3e4731c5aa0986f61095ea",
      "word_count": 19
    },
    {
      "text": "You must support multiple windows in your app",
      "section_path": [
        "Windows",
        "Platform considerations",
        "iPadOS"
      ],
      "source_sentence_hash": "e45dc43ad69b4a362a8164d2692194fcb62b2704fa3e4731c5aa0986f61095ea",
      "word_count": 8
    }
  ],
