  "guidance_candidates": [
    {
      "text": "Use a popover to expose a small amount of information or functionality",
      "section_path": [
        "Popovers",
        "Best practices"
      ],
      "source_sentence_hash": "ccb1b436050bcdfee5d4cec4cb6b2b184d94ebe8c11faa5b5e105469b215c667",
      "word_count": 12
    },
    {
      "text": "Keep popover functionality limited to a few related tasks",
      "section_path": [
        "Popovers",
        "Best practices"
      ],
      "source_sentence_hash": "ccb1b436050bcdfee5d4cec4cb6b2b184d94ebe8c11faa5b5e105469b215c667",
      "word_count": 9
    },
    {
      "text": "Consider using popovers when you want more room for content",
      "section_path": [
        "Popovers",
        "Best practices"
      ],
      "source_sentence_hash": "5ad5a4837590e80ee1de14fe8fe891d44cd5e0dd0e0da8d8844ce6dc0f33af8f",
      "word_count": 10
    },
    {
      "text": "Position popovers appropriately",
      "section_path": [
        "Popovers",
        "Best practices"
      ],
      "source_sentence_hash": "f2f343126150c0c3dc9cbe99ad4c6f0a88d45408b7db338f25bd396e4c53421c",
      "word_count": 3
    },
    {
      "text": "Make sure a popover's arrow points as directly as possible to its revealing element",
      "section_path": [
        "Popovers",
        "Best practices"
      ],
      "source_sentence_hash": "f2f343126150c0c3dc9cbe99ad4c6f0a88d45408b7db338f25bd396e4c53421c",
      "word_count": 14
    },
    {
      "text": "Keep the revealing element and essential content visible while using a popover",
      "section_path": [
        "Popovers",
        "Best practices"
      ],
      "source_sentence_hash": "f2f343126150c0c3dc9cbe99ad4c6f0a88d45408b7db338f25bd396e4c53421c",
      "word_count": 12
    },
    {
      "text": "Use a Close button for confirmation and guidance only",
      "section_path": [
        "Popovers",
        "Best practices"
      ],
      "source_sentence_hash": "ceb78dbaadb965c2157a40e797ab4802a74dadf054f526a67716a5b81e3a87ba",
      "word_count": 9
    },
    {
      "text": "Make sure a multi-selection popover stays open until explicit dismissal or an outside action",
      "section_path": [
        "Popovers",
        "Best practices"
      ],
      "source_sentence_hash": "ceb78dbaadb965c2157a40e797ab4802a74dadf054f526a67716a5b81e3a87ba",
      "word_count": 14
    },
    {
      "text": "Always save work when automatically closing a nonmodal popover",
      "section_path": [
        "Popovers",
        "Best practices"
      ],
      "source_sentence_hash": "0442349307420afeafe34eb9b9c01a955c9e49f4abb3278a492f4d7ee6ecc624",
      "word_count": 9
    },
    {
      "text": "Show one popover at a time",
      "section_path": [
        "Popovers",
        "Best practices"
      ],
      "source_sentence_hash": "544a3404720dfb1a1edfda4128487e795c736671dc68e1f79f9df35c5318212b",
      "word_count": 6
    },
    {
      "text": "Never show a cascade or hierarchy of popovers",
      "section_path": [
        "Popovers",
        "Best practices"
      ],
      "source_sentence_hash": "544a3404720dfb1a1edfda4128487e795c736671dc68e1f79f9df35c5318212b",
      "word_count": 8
    },
    {
      "text": "Don’t show another view over a popover",
      "section_path": [
        "Popovers",
        "Best practices"
      ],
      "source_sentence_hash": "0ba7a2bb98de6054e5cc0c49ffb9c90b4f1fbb9917010af78d1aecc3e844c491",
      "word_count": 7
    },
    {
      "text": "Let people close one popover and open another with one action when possible",
      "section_path": [
        "Popovers",
        "Best practices"
      ],
      "source_sentence_hash": "3afc9a9a94d11e583804f48807520c4b0e3b4ed5a58d51c4c475924b97c08b1d",
      "word_count": 13
    },
    {
      "text": "Avoid making a popover too big",
      "section_path": [
        "Popovers",
        "Best practices"
      ],
      "source_sentence_hash": "e905f555bbba949af3c5bd9e66f8cb48da01feca2eafacb0d61eaa3f104c6b05",
      "word_count": 6
    },
    {
      "text": "Provide a smooth transition when changing the size of a popover",
      "section_path": [
        "Popovers",
        "Best practices"
      ],
      "source_sentence_hash": "1f5dab0c108ec43211c284632953b13d7ad742cd31300cef3fe0dd7c3c587569",
      "word_count": 11
    },
    {
      "text": "Avoid using the word popover in help documentation",
      "section_path": [
        "Popovers",
        "Best practices"
      ],
      "source_sentence_hash": "f40a0190b1c7658de7135e9c4a96e69024d494e4e46933efd5b766cc2e9d2689",
      "word_count": 8
    },
    {
      "text": "Avoid using a popover to show a warning",
      "section_path": [
        "Popovers",
        "Best practices"
      ],
      "source_sentence_hash": "7fd1cdcb67156228856485d0b296595c6b830a116f25196983b5d8afefed5643",
      "word_count": 8
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "Popovers",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "Avoid relying on popovers in tvOS or watchOS",
      "section_path": [
        "Popovers",
        "Platform considerations"
      ],
      "source_sentence_hash": "7d8f8ae7e3c2194af3f2ee6e6d5cc9e239ef3a5593425ef8962afbce111009ea",
      "word_count": 8
    },
    {
      "text": "Avoid displaying popovers in compact views",
      "section_path": [
        "Popovers",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "d54bf5bed249213b06752aacd1d58e0835d526190a2941c04bde338d6e3b83e6",
      "word_count": 6
    },
    {
      "text": "Consider letting people detach a popover",
      "section_path": [
        "Popovers",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "b92b169fae21ee5d2cface0715ef63e58cbcd273b245638d9b0c696bf3693adb",
      "word_count": 6
    },
    {
      "text": "Make minimal appearance changes to a detached popover",
      "section_path": [
        "Popovers",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "67a0955eb4ebc273fdcebb20cecd1e39fc4400415dead4d94b93de01808bb27a",
      "word_count": 8
    },
