  "guidance_candidates": [
    {
      "text": "Ask people to sign in only in exchange for value",
      "section_path": [
        "Sign in with Apple",
        "Offering Sign in with Apple"
      ],
      "source_sentence_hash": "f4bda34f8ca79485e1a15ba4d41b00264204a783ba0ca3da51f898a8a010dd9e",
      "word_count": 10
    },
    {
      "text": "Delay sign-in as long as possible",
      "section_path": [
        "Sign in with Apple",
        "Offering Sign in with Apple"
      ],
      "source_sentence_hash": "7d88861cf50b7041f33ccb92af1ed69aba0efa02aef98eda92bbcdba742a17c7",
      "word_count": 6
    },
    {
      "text": "If you require an account, ask people to set it up before offering any sign-in options",
      "section_path": [
        "Sign in with Apple",
        "Offering Sign in with Apple"
      ],
      "source_sentence_hash": "588d92b17a126d071768ae52a498f2142c8d2b9a0a1f0b4364e4e600f78d1296",
      "word_count": 16
    },
    {
      "text": "Consider letting people link an existing account to Sign in with Apple",
      "section_path": [
        "Sign in with Apple",
        "Offering Sign in with Apple"
      ],
      "source_sentence_hash": "61b9f94a6556cde58e897f1286ae4684d3cbf737f0fd57f563f0c5c86d38e967",
      "word_count": 12
    },
    {
      "text": "In a commerce app, wait until after people make a purchase before asking them to create an account",
      "section_path": [
        "Sign in with Apple",
        "Offering Sign in with Apple"
      ],
      "source_sentence_hash": "404c69180e0500ec242d6b18f4e46e7ebdc783ea91e55962b872ac66eabbf2b9",
      "word_count": 18
    },
    {
      "text": "As soon as Sign in with Apple completes, welcome people to their new account",
      "section_path": [
        "Sign in with Apple",
        "Offering Sign in with Apple"
      ],
      "source_sentence_hash": "56472089347ca93312c4a597e7f5d1586db7f3ebb3d7fe41312b2c8973096864",
      "word_count": 14
    },
    {
      "text": "Indicate when people are currently signed in",
      "section_path": [
        "Sign in with Apple",
        "Offering Sign in with Apple"
      ],
      "source_sentence_hash": "6a52db9dc1732fa0b9131acc27a2991e35f3157dd7d893810206cf66b18a810b",
      "word_count": 7
    },
    {
      "text": "Clarify whether the additional data you request is required or just recommended",
      "section_path": [
        "Sign in with Apple",
        "Collecting data"
      ],
      "source_sentence_hash": "10ea151e1b781f43a8d6db582c39a95de9e343d470c64ea3c336742f9a928f4b",
      "word_count": 12
    },
    {
      "text": "Don’t ask people to supply a password",
      "section_path": [
        "Sign in with Apple",
        "Collecting data"
      ],
      "source_sentence_hash": "ae43f2caac500e8cd595948eab5a75d49558a23162b9d1871dcc3dac1c0c404a",
      "word_count": 7
    },
    {
      "text": "Avoid asking for a personal email address when people supply a private relay address",
      "section_path": [
        "Sign in with Apple",
        "Collecting data"
      ],
      "source_sentence_hash": "444bc6c563cb87f642343b12db30e032fb1c9cbedd279c766563a1a77c8aaa9b",
      "word_count": 14
    },
    {
      "text": "Give people a chance to engage with your app before asking for optional data",
      "section_path": [
        "Sign in with Apple",
        "Collecting data"
      ],
      "source_sentence_hash": "b83569f5784892777f62a966c446e35e3146842df6873149d409ec933b3687b4",
      "word_count": 14
    },
    {
      "text": "Be transparent about the data you collect",
      "section_path": [
        "Sign in with Apple",
        "Collecting data"
      ],
      "source_sentence_hash": "0fe1d555c716ff1ca6eddbdcd733c7b7cebd19ff6e2c6ab3b9df62d3fcb9acb4",
      "word_count": 7
    },
    {
      "text": "Prominently display a Sign in with Apple button",
      "section_path": [
        "Sign in with Apple",
        "Displaying buttons"
      ],
      "source_sentence_hash": "dddffb72388ade2fb2e23b09ac19a80eb35a24a2b457a5e2e159883ffb2d01f1",
      "word_count": 8
    },
    {
      "text": "Using the system-provided buttons",
      "section_path": [
        "Sign in with Apple",
        "Displaying buttons",
        "Using the system-provided buttons"
      ],
      "source_sentence_hash": "f42a7e985eb15a87e0554f4e5c92f8a621208965ecc8c5d57ffa9fc802d1bca7",
      "word_count": 4
    },
    {
      "text": "White with outline",
      "section_path": [
        "Sign in with Apple",
        "Displaying buttons",
        "Using the system-provided buttons",
        "White with outline"
      ],
      "source_sentence_hash": "fc6918e356cdbf8b4791c53276b8e430da1045d7b73b43ed733e7585a5c50391",
      "word_count": 3
    },
    {
      "text": "Button size and corner radius",
      "section_path": [
        "Sign in with Apple",
        "Displaying buttons",
        "Using the system-provided buttons",
        "Button size and corner radius"
      ],
      "source_sentence_hash": "48afb59b6ddb581573eeef6489a3b110f8105b6166ea4b2625831f7ee4335e61",
      "word_count": 5
    },
    {
      "text": "Adjust the corner radius to match the appearance of other buttons in your app",
      "section_path": [
        "Sign in with Apple",
        "Displaying buttons",
        "Using the system-provided buttons",
        "Button size and corner radius"
      ],
      "source_sentence_hash": "df3bff601baf50f1a836e3ed23a1d3b837f907ed29bc60432b7326347db05f7d",
      "word_count": 14
    },
    {
      "text": "Maintain the minimum button size and margin around the button in iOS, macOS, and the web",
      "section_path": [
        "Sign in with Apple",
        "Displaying buttons",
        "Using the system-provided buttons",
        "Button size and corner radius"
      ],
      "source_sentence_hash": "4a357ccf4fc7edc302018a2ec352309a7b16335a39772b6e9c834ef7cc9d13c1",
      "word_count": 16
    },
    {
      "text": "Creating a custom Sign in with Apple button",
      "section_path": [
        "Sign in with Apple",
        "Displaying buttons",
        "Creating a custom Sign in with Apple button"
      ],
      "source_sentence_hash": "03d01bc9e44a78e61fca37ef709057a24cc3d9fb8225bb746e84b5b6485891c9",
      "word_count": 8
    },
    {
      "text": "Custom buttons with a logo and text",
      "section_path": [
        "Sign in with Apple",
        "Displaying buttons",
        "Creating a custom Sign in with Apple button",
        "Custom buttons with a logo and text"
      ],
      "source_sentence_hash": "8d60916ea98fc2dcfafffddca8305629e0740af49ed16d69fbf71cec9b54d91a",
      "word_count": 7
    },
    {
      "text": "Choose the format of the logo file based on the height of your button",
      "section_path": [
        "Sign in with Apple",
        "Displaying buttons",
        "Creating a custom Sign in with Apple button",
        "Custom buttons with a logo and text"
      ],
      "source_sentence_hash": "65743a43423711f4c1670b5132d522267d5124e77f5dcd8f914a4ba91ad070d4",
      "word_count": 14
    },
    {
      "text": "Prefer the system font for the title — that is, Sign in with Apple, Sign up with Apple, or",
      "section_path": [
        "Sign in with Apple",
        "Displaying buttons",
        "Creating a custom Sign in with Apple button",
        "Custom buttons with a logo and text"
      ],
      "source_sentence_hash": "2993808f3422d06c500ff40f2282691d750a306a1e4251260d372cd90b7fe0d3",
      "word_count": 19
    },
    {
      "text": "In general, preserve the capitalization style of the title",
      "section_path": [
        "Sign in with Apple",
        "Displaying buttons",
        "Creating a custom Sign in with Apple button",
        "Custom buttons with a logo and text"
      ],
      "source_sentence_hash": "09aadf33d5c440bd93164452001263060a8cd37ec3ec2be2773d4b5196cb8d20",
      "word_count": 9
    },
    {
      "text": "Keep the title and logo vertically aligned within the button",
      "section_path": [
        "Sign in with Apple",
        "Displaying buttons",
        "Creating a custom Sign in with Apple button",
        "Custom buttons with a logo and text"
      ],
      "source_sentence_hash": "00e012bcda71d0f67d5ba9bffb996fc1c1603d53f6639d0d89d75ede0adfe474",
      "word_count": 10
    },
    {
      "text": "Inset the logo if necessary",
      "section_path": [
        "Sign in with Apple",
        "Displaying buttons",
        "Creating a custom Sign in with Apple button",
        "Custom buttons with a logo and text"
      ],
      "source_sentence_hash": "2e72b6380fca1864aaa079c2d1b32e1fc74c76155356d0b2017e7da5b1e31f5e",
      "word_count": 5
    },
    {
      "text": "Maintain a minimum margin between the title and the right edge of the button",
      "section_path": [
        "Sign in with Apple",
        "Displaying buttons",
        "Creating a custom Sign in with Apple button",
        "Custom buttons with a logo and text"
      ],
      "source_sentence_hash": "6e6c9bf79ef10f345a43e95b8fcd3aa1c1cb037896061e95d7cb3a5bf444611d",
      "word_count": 14
    },
    {
      "text": "Maintain the minimum button size and margin around the button",
      "section_path": [
        "Sign in with Apple",
        "Displaying buttons",
        "Creating a custom Sign in with Apple button",
        "Custom buttons with a logo and text"
      ],
      "source_sentence_hash": "93d08920355ee20754136135dc0f80b87a9b814070a5a419502f7e7f8c6514b5",
      "word_count": 10
    },
    {
      "text": "Custom logo-only buttons",
      "section_path": [
        "Sign in with Apple",
        "Displaying buttons",
        "Creating a custom Sign in with Apple button",
        "Custom logo-only buttons"
      ],
      "source_sentence_hash": "bfd9f60b03e9913deb763b9024693e93356a8eed476336eba3056150b771fc08",
      "word_count": 3
    },
    {
      "text": "Choose the format of the logo file based on the size of your button",
      "section_path": [
        "Sign in with Apple",
        "Displaying buttons",
        "Creating a custom Sign in with Apple button",
        "Custom logo-only buttons"
      ],
      "source_sentence_hash": "fbbdd06a9bcb20db40ac00856255b029036f60d253c43e546319a168e91d2e30",
      "word_count": 14
    },
    {
      "text": "Don’t add horizontal padding to a logo-only image",
      "section_path": [
        "Sign in with Apple",
        "Displaying buttons",
        "Creating a custom Sign in with Apple button",
        "Custom logo-only buttons"
      ],
      "source_sentence_hash": "ff8f1c91ba879c8eeafa1169a92835df5f76b88683d40adbb0ff55fe33bc9b8a",
      "word_count": 8
    },
    {
      "text": "Use a mask to change the default square shape of the logo-only image",
      "section_path": [
        "Sign in with Apple",
        "Displaying buttons",
        "Creating a custom Sign in with Apple button",
        "Custom logo-only buttons"
      ],
      "source_sentence_hash": "fbc84e3c187a5054dbb4790b7351e12f92d3e4ccdda7608c7f57b67edfd0fa7a",
      "word_count": 13
    },
    {
      "text": "Maintain a minimum margin around the button",
      "section_path": [
        "Sign in with Apple",
        "Displaying buttons",
        "Creating a custom Sign in with Apple button",
        "Custom logo-only buttons"
      ],
      "source_sentence_hash": "304f5079e1e8ff6b3b650fc45fc91a73ac00924ba544c3f81928904589ddabea",
      "word_count": 7
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Sign in with Apple",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
