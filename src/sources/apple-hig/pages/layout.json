  "guidance_candidates": [
    {
      "text": "Group related items to help people find the information they want",
      "section_path": [
        "Layout",
        "Best practices"
      ],
      "source_sentence_hash": "34a03e7e3110bc79092b6f7d5879170cfcb0f25895e26535dc0ccfed64744544",
      "word_count": 11
    },
    {
      "text": "Make essential information easy to find by giving it sufficient space",
      "section_path": [
        "Layout",
        "Best practices"
      ],
      "source_sentence_hash": "7e96f91f3e092e6257f75efcc92426a47cdc116043a07974874596d63f230607",
      "word_count": 11
    },
    {
      "text": "Extend content to fill the screen or window",
      "section_path": [
        "Layout",
        "Best practices"
      ],
      "source_sentence_hash": "328c5fce259b7791afaabe5e553fb5cd8d1e0adfbabadfe1aa3a0e35a0c22f11",
      "word_count": 8
    },
    {
      "text": "Differentiate controls from content",
      "section_path": [
        "Layout",
        "Visual hierarchy"
      ],
      "source_sentence_hash": "920b8282a164364978399bcf8eb03943e47946595ebea44202ece2ff666d68a9",
      "word_count": 4
    },
    {
      "text": "Place items to convey their relative importance",
      "section_path": [
        "Layout",
        "Visual hierarchy"
      ],
      "source_sentence_hash": "b1f02b000e5e7fac6380f949001abcbc4e28819a204471bfca9714babf60b93e",
      "word_count": 7
    },
    {
      "text": "Align components with one another to make them easier to scan and to communicate organization and hierarchy",
      "section_path": [
        "Layout",
        "Visual hierarchy"
      ],
      "source_sentence_hash": "f4be7c2235f649f3af44b5d498064cfb92af5606b660d0f0c59fc5835ef116b2",
      "word_count": 17
    },
    {
      "text": "Take advantage of progressive disclosure to help people discover content that’s currently hidden",
      "section_path": [
        "Layout",
        "Visual hierarchy"
      ],
      "source_sentence_hash": "e4d3969e3cc9069d3017b46accc8abb0fd7d2e0cf170a915b7ee6e110716e509",
      "word_count": 13
    },
    {
      "text": "Make controls easier to use by providing enough space around them and grouping them in logical sections",
      "section_path": [
        "Layout",
        "Visual hierarchy"
      ],
      "source_sentence_hash": "0ad9fd2b8748f47e189fada2e24ba1558a741564755217f0534ba34076b915e6",
      "word_count": 17
    },
    {
      "text": "Different device screen sizes, resolutions, and color spaces",
      "section_path": [
        "Layout",
        "Adaptability"
      ],
      "source_sentence_hash": "2d7906efa63153a94a4dd0beaf6d67989dd89151c02a36fffbd2a19ac907cfdc",
      "word_count": 8
    },
    {
      "text": "Different device orientations (portrait/landscape)",
      "section_path": [
        "Layout",
        "Adaptability"
      ],
      "source_sentence_hash": "777b9a670791e1e778e6516e1f15257c779021f30bb40587902fce86c4efc107",
      "word_count": 4
    },
    {
      "text": "System features like Dynamic Island and camera controls",
      "section_path": [
        "Layout",
        "Adaptability"
      ],
      "source_sentence_hash": "d9e7abe150ac6f17128f81c15610c3fd9110eefe4770bce7311811e2d7f289b5",
      "word_count": 8
    },
    {
      "text": "External display support, Display Zoom, and resizable windows on iPad",
      "section_path": [
        "Layout",
        "Adaptability"
      ],
      "source_sentence_hash": "a12419a386de9cd838b65f245011820219a378641bfa40b292ebec6f9a51f9e8",
      "word_count": 10
    },
    {
      "text": "Dynamic Type text-size changes",
      "section_path": [
        "Layout",
        "Adaptability"
      ],
      "source_sentence_hash": "e30b90196b4fcbd32c08a563724354bea19e5008c6b4348659eaf0b7ecb162cd",
      "word_count": 4
    },
    {
      "text": "Locale-based internationalization features like left-to-right/right-to-left layout direction, date/time/number formatting, font variation, and text length",
      "section_path": [
        "Layout",
        "Adaptability"
      ],
      "source_sentence_hash": "d6902b9bd6869799a26b31f43522f769d2202f2d1c43263c22aa36fefba6a1c2",
      "word_count": 14
    },
    {
      "text": "Design a layout that adapts gracefully to context changes while remaining recognizably consistent",
      "section_path": [
        "Layout",
        "Adaptability"
      ],
      "source_sentence_hash": "2da98d37ddc8cc0b16f247cc3af80dd485e64d84d54526d99b47f656da788e91",
      "word_count": 13
    },
    {
      "text": "Be prepared for text-size changes",
      "section_path": [
        "Layout",
        "Adaptability"
      ],
      "source_sentence_hash": "3bdc5c7b2b97bf7d65c92d4953c9094457425c9a26e91660054c2c1afd7a9886",
      "word_count": 5
    },
    {
      "text": "Preview your app on multiple devices, using different orientations, localizations, and text sizes",
      "section_path": [
        "Layout",
        "Adaptability"
      ],
      "source_sentence_hash": "881fd28277d74a6ff8318a9e9b9a05cb650016f885e1234d9fc281101104e385",
      "word_count": 13
    },
    {
      "text": "When necessary, scale artwork in response to display changes",
      "section_path": [
        "Layout",
        "Adaptability"
      ],
      "source_sentence_hash": "cbe0bf487f6eb6e0fec1372395f05cac7d1c40c0341c9f9fac358d997a6c494a",
      "word_count": 9
    },
    {
      "text": "Respect key display and system features in each platform",
      "section_path": [
        "Layout",
        "Guides and safe areas"
      ],
      "source_sentence_hash": "d320c0a4968f6aef1402586930df6cccdf36009bf9ee5a5ab6e07bf3f0d73aa0",
      "word_count": 9
    },
    {
      "text": "Aim to support both portrait and landscape orientations",
      "section_path": [
        "Layout",
        "Platform considerations",
        "iOS"
      ],
      "source_sentence_hash": "4b9b1f93f1c5b2029835fcd624397574fb683d7db23c42ef6efe3d70aca89e5e",
      "word_count": 8
    },
    {
      "text": "Prefer a full-bleed interface for your game",
      "section_path": [
        "Layout",
        "Platform considerations",
        "iOS"
      ],
      "source_sentence_hash": "3faaa920a52a79d2986f87ae664de34ac1658f4551e2c1570e75e7c8d9b39e86",
      "word_count": 7
    },
    {
      "text": "Avoid full-width buttons",
      "section_path": [
        "Layout",
        "Platform considerations",
        "iOS"
      ],
      "source_sentence_hash": "49829ad7863025de42e3f6994c95078f8b07893864c77385c26729e8c6ef02d0",
      "word_count": 3
    },
    {
      "text": "Hide the status bar only when it adds value or enhances your experience",
      "section_path": [
        "Layout",
        "Platform considerations",
        "iOS"
      ],
      "source_sentence_hash": "3110100afe2e5924ddf9bd7d2d63cbe33ad719f1aeb1e298e73ccb33f1f6a6fe",
      "word_count": 13
    },
    {
      "text": "As someone resizes a window, defer switching to a compact view for as long as possible",
      "section_path": [
        "Layout",
        "Platform considerations",
        "iPadOS"
      ],
      "source_sentence_hash": "b8c4a010ef4e40b4354f3d2671aff3f7eaed00c13998054b7ea7caabc6d235ca",
      "word_count": 16
    },
    {
      "text": "Test your layout at common system-provided sizes, and provide smooth transitions",
      "section_path": [
        "Layout",
        "Platform considerations",
        "iPadOS"
      ],
      "source_sentence_hash": "f1ab89ecdd9a24a895ee337e71e1f3c4a00e7b30e7bf5bc9314263c28aa06a89",
      "word_count": 11
    },
    {
      "text": "Consider a convertible tab bar for adaptive navigation",
      "section_path": [
        "Layout",
        "Platform considerations",
        "iPadOS"
      ],
      "source_sentence_hash": "7ec809aee7c3d4a7c7a4fc19ce7375e7ee23266842662588f7ee58f6e66e2613",
      "word_count": 8
    },
    {
      "text": "Avoid placing controls or critical information at the bottom of a window",
      "section_path": [
        "Layout",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "718eb555856e238964fb890453112d101ae6720e7021aa4ac47a2ca3f2287627",
      "word_count": 12
    },
    {
      "text": "Avoid displaying content within the camera housing at the top edge of the window",
      "section_path": [
        "Layout",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "d873af1875a56fa43e3f70128965753ecb2d2a3e17b87edbd5aa61fc59bf0135",
      "word_count": 14
    },
    {
      "text": "Be prepared for a wide range of TV sizes",
      "section_path": [
        "Layout",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "a1fe10aaf4d65c96c1e04fbc6cb1769a78c3ed53564d09a6dc5bfcf3a0df390a",
      "word_count": 9
    },
    {
      "text": "Adhere to the screen’s safe area",
      "section_path": [
        "Layout",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "4bbee34706dd5a9b782851315fe2f8f71eaf95ee012cb0547e4f8f080d111253",
      "word_count": 6
    },
    {
      "text": "Include appropriate padding between focusable elements",
      "section_path": [
        "Layout",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "e5adc6b4a93d8336da421da9f7a20f2b775d5a8c6bd0a4b6f76da570299ba758",
      "word_count": 6
    },
    {
      "text": "Two-column grid",
      "section_path": [
        "Layout",
        "Platform considerations",
        "tvOS",
        "Two-column grid"
      ],
      "source_sentence_hash": "1a36e53707200a5f9c0f8aa45ccdaa468e3b9eb77316642bfbe7e2d414d0f17f",
      "word_count": 2
    },
    {
      "text": "Three-column grid",
      "section_path": [
        "Layout",
        "Platform considerations",
        "tvOS",
        "Three-column grid"
      ],
      "source_sentence_hash": "374c9f9cd68e17e670d1fb58cabdc1f59c48a10ac4ab3d990f44854d19c2991c",
      "word_count": 2
    },
    {
      "text": "Four-column grid",
      "section_path": [
        "Layout",
        "Platform considerations",
        "tvOS",
        "Four-column grid"
      ],
      "source_sentence_hash": "63a3e4606c118e514aba4e3214cc5c4387b8c04a53a7bd57b3857a80b8636687",
      "word_count": 2
    },
    {
      "text": "Five-column grid",
      "section_path": [
        "Layout",
        "Platform considerations",
        "tvOS",
        "Five-column grid"
      ],
      "source_sentence_hash": "3d1a823d108b8d89d9d0f962dfe6fa770621afdca64ec61fb14eda77e1da3761",
      "word_count": 2
    },
    {
      "text": "Six-column grid",
      "section_path": [
        "Layout",
        "Platform considerations",
        "tvOS",
        "Six-column grid"
      ],
      "source_sentence_hash": "0339a0155c84a7056e597967b7921ea23549b7f6104d0190b1fde3306b05aa0b",
      "word_count": 2
    },
    {
      "text": "Seven-column grid",
      "section_path": [
        "Layout",
        "Platform considerations",
        "tvOS",
        "Seven-column grid"
      ],
      "source_sentence_hash": "27e9cf176f0f68fb380cb9368c03620cbdbc02b2a92c1c1df75996458505d6cb",
      "word_count": 2
    },
    {
      "text": "Eight-column grid",
      "section_path": [
        "Layout",
        "Platform considerations",
        "tvOS",
        "Eight-column grid"
      ],
      "source_sentence_hash": "f67ab2bb7a0ec53214946594598cd1a8a04794b0c55995b1730442c7dc6a7c53",
      "word_count": 2
    },
    {
      "text": "Nine-column grid",
      "section_path": [
        "Layout",
        "Platform considerations",
        "tvOS",
        "Nine-column grid"
      ],
      "source_sentence_hash": "620ed271853d3d3a29fd53d4a633a7b58ccf3795f3e94fcc5a1c3d8f27ed7694",
      "word_count": 2
    },
    {
      "text": "Include additional vertical spacing for titled rows",
      "section_path": [
        "Layout",
        "Platform considerations",
        "tvOS",
        "Nine-column grid"
      ],
      "source_sentence_hash": "2d40fb061b4833c8b38616becfd8c91dd0bc77cbe896a10a4e4605155b038c36",
      "word_count": 7
    },
    {
      "text": "Use consistent spacing",
      "section_path": [
        "Layout",
        "Platform considerations",
        "tvOS",
        "Nine-column grid"
      ],
      "source_sentence_hash": "d236f512c250f5957a15a07f434986dd2ec91f7dd4ef1ae03da3df639f688740",
      "word_count": 3
    },
    {
      "text": "Make partially hidden content look symmetrical",
      "section_path": [
        "Layout",
        "Platform considerations",
        "tvOS",
        "Nine-column grid"
      ],
      "source_sentence_hash": "e9f12fce698cb6ff132bea0be0581c322d834b0ccf1fb54bb31453b24bcd6164",
      "word_count": 6
    },
    {
      "text": "Consider centering the most important content and controls in your app or game",
      "section_path": [
        "Layout",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "cee2019a60290a6926a6c01a0fb4d56c35cfcdf0aadd7af5b452fc6773785805",
      "word_count": 13
    },
    {
      "text": "Keep a window’s content within its bounds",
      "section_path": [
        "Layout",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "75760c641dbb8b6fdfeff578da3855f51c64382d6ae34b56867c7e481fe92ef0",
      "word_count": 7
    },
    {
      "text": "If you need to display additional controls that don’t belong within a window, use an ornament",
      "section_path": [
        "Layout",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "384ae29ebe83d748fa14eb60b8dcc165d8a49a89fb953243e5897f212cc38084",
      "word_count": 16
    },
    {
      "text": "Make a window’s interactive components easy for people to look at",
      "section_path": [
        "Layout",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "5819cb6e4ee38bc0ef048a98758ded79b8329c59954b749a8147b472a7d23374",
      "word_count": 11
    },
    {
      "text": "Design your content to extend from one edge of the screen to the other",
      "section_path": [
        "Layout",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "0925a4eb294f53985aaa2578cfa2c20a5cb991716cae44bbe7a7faf0b87a7829",
      "word_count": 14
    },
    {
      "text": "Avoid placing more than two or three controls side by side in your interface",
      "section_path": [
        "Layout",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "0818afd0420888f59ec8e219cb36364f5918c6a38ee91430217e769550ee1588",
      "word_count": 14
    },
    {
      "text": "Support autorotation in views people might want to show others",
      "section_path": [
        "Layout",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "d5b01dc609e6a0cdf5f9a01262dac4ef52f530dad9ac4baf77e4ad02e0e9e070",
      "word_count": 10
    },
    {
