      "section_path": [
        "Layout",
        "Specifications",
        "iOS, iPadOS device screen dimensions"
      ],
      "source_sentence_hash": "9a7dab5530bb9f8751352e74feb23afef188974f32a07c9772a2f52f8f646d96",
      "word_count": 5
    },
