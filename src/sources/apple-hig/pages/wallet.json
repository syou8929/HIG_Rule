        "Order tracking",
        "Displaying order and fulfillment details"
      ],
      "source_sentence_hash": "bd155e0360a412b1daf5af0fe2090573ab2b2fbfd6d9b5f71439f80c55d83768",
      "word_count": 15
    },
    {
      "text": "Supply a prioritized list of your apps that might be installed on the device",
      "section_path": [
        "Wallet",
        "Order tracking",
        "Displaying order and fulfillment details"
      ],
      "source_sentence_hash": "b431e43d39584e09ac69e83186e240e2e65c752f6d5df9d03143baa7f4d57ece",
      "word_count": 14
    },
    {
      "text": "Avoid sending duplicate notifications",
      "section_path": [
        "Wallet",
        "Order tracking",
        "Displaying order and fulfillment details"
      ],
      "source_sentence_hash": "c7087a443bba9f8acd8028b066582d919f08578806e9e87a9ecb6d5f6342cb51",
      "word_count": 4
    },
    {
      "text": "Make it easy for customers to contact the merchant",
      "section_path": [
        "Wallet",
        "Order tracking",
        "Displaying order and fulfillment details"
      ],
      "source_sentence_hash": "79a69b644330b004e479055a62d691543e0e3c7cd4a8d41bc9960ca6f63c0087",
      "word_count": 9
    },
    {
      "text": "Help people track their order",
      "section_path": [
        "Wallet",
        "Order tracking",
        "Displaying order and fulfillment details"
      ],
      "source_sentence_hash": "221df9c7e055d013795667ddd2d392a5711a18a8a6bf13636c8816341bfa43df",
      "word_count": 5
    },
    {
      "text": "A scannable barcode when one is required to pick up the order in a pickup fulfillment. It’s convenient when",
      "section_path": [
        "Wallet",
        "Order tracking",
        "Displaying order and fulfillment details"
      ],
      "source_sentence_hash": "fb2bd626514645600b4bbff77c8202831778e208820f898bb3e09ef6e93f65dd",
      "word_count": 19
    },
    {
      "text": "Clear, detailed instructions that can help people receive or pick up their order",
      "section_path": [
        "Wallet",
        "Order tracking",
        "Displaying order and fulfillment details"
      ],
      "source_sentence_hash": "37427cb631a5cd643b67b754afb50facbe4218fb3deb0df74c2fbc2b065b44b4",
      "word_count": 13
    },
    {
      "text": "Keep the fulfillment screen centered on order tracking",
      "section_path": [
        "Wallet",
        "Order tracking",
        "Displaying order and fulfillment details"
      ],
      "source_sentence_hash": "0a80d4aad7b54f1b2f853bafddee54c2e455e0ee978eefbfef9fd580422fca84",
      "word_count": 8
    },
    {
      "text": "Choose shipping-fulfillment values that match the details you have about the shipping process",
      "section_path": [
        "Wallet",
        "Order tracking",
        "Displaying order and fulfillment details"
      ],
      "source_sentence_hash": "19c62b2e2981d754bc86cb5a4901b20d7dc4c2fdfe0a5d1125d89257d6dd34a6",
      "word_count": 13
    },
    {
      "text": "Keep customers informed through relevant fulfillment status descriptions",
      "section_path": [
        "Wallet",
        "Order tracking",
        "Displaying order and fulfillment details"
      ],
      "source_sentence_hash": "ad37570ae4eac1c42d6266da5e4b3f84561f73e9e9dc9579635731a3aea339dd",
      "word_count": 8
    },
    {
      "text": "Be direct and thorough when describing an Issue or Canceled status",
      "section_path": [
        "Wallet",
        "Order tracking",
        "Displaying order and fulfillment details"
      ],
      "source_sentence_hash": "6778c467710248d5a2cea1efdb4ed0c93be45bee8234460fe7ea603a53112262",
      "word_count": 11
    },
    {
      "text": "Present a Wallet verification option only when the device supports it",
      "section_path": [
        "Wallet",
        "Identity verification"
      ],
      "source_sentence_hash": "79b7cede6c2a666ab0b43a6b168c5839f5fc4f2ec22792be7f16be8fd644871b",
      "word_count": 11
    },
    {
      "text": "Ask for identity information only at the precise moment you need it",
      "section_path": [
        "Wallet",
        "Identity verification"
      ],
      "source_sentence_hash": "2a96fe99bf5a3af136d26028a1a2662fabb1e3256c91a2dc038e094e3aa20334",
      "word_count": 12
    },
    {
      "text": "Clearly and succinctly describe the reason you need the information you’re requesting",
      "section_path": [
        "Wallet",
        "Identity verification"
      ],
      "source_sentence_hash": "9fd128b1d3f87cd9f14c1189fc5e2a2a4c06c8cc3a1a4a1d11b084ca35a57b37",
      "word_count": 12
    },
    {
      "text": "Ask only for the data you actually need",
      "section_path": [
        "Wallet",
        "Identity verification"
      ],
      "source_sentence_hash": "c32c7e2308d500b14b3a32b26ac8bc379b3a43b05d5ed44e57b832273553bae2",
      "word_count": 8
    },
    {
      "text": "Clearly indicate whether you will keep the data and — if you need to keep it — specify how",
      "section_path": [
        "Wallet",
        "Identity verification"
      ],
      "source_sentence_hash": "e4d8ff4d7385e99bc141d5c2aa0c43c96889496b47d0eb96bf2c70684dc845e1",
      "word_count": 19
    },
    {
      "text": "Choose the system-provided verification button that matches your use case and the visual design of your app",
      "section_path": [
        "Wallet",
        "Identity verification"
      ],
      "source_sentence_hash": "b0d0d29052bedaaf0a10e4202e2b3bc6df1f3ad721658e5dc95cfd3156f7ed4a",
      "word_count": 17
    },
    {
      "text": "Don’t ask them again",
      "section_path": [
        "Wallet",
        "Passes"
      ],
      "source_sentence_hash": "78c5151e17de7b184dff3756fe965e3850a222e9620eea8dc3951b1584188272",
      "word_count": 4
    },
    {
      "text": "Never use a change message for marketing or other noncritical communication",
      "section_path": [
        "Wallet",
        "Passes"
      ],
      "source_sentence_hash": "bf698db69aba4db215f3adfb214cddc51a7a45db31e5004b3a9ef6cdc5de3f39",
      "word_count": 11
    },
    {
      "text": "semantic tags are required and enable automatic layout",
      "section_path": [
        "Wallet",
        "Pass anatomy"
      ],
      "source_sentence_hash": "a116ae61fa679401b55cb47bf98899d9240ddc9aa00d177072d59c32f179d483",
      "word_count": 8
    },
    {
      "text": "Include pass fields alongside semantic tags for these pass types too",
      "section_path": [
        "Wallet",
        "Pass anatomy"
      ],
      "source_sentence_hash": "a116ae61fa679401b55cb47bf98899d9240ddc9aa00d177072d59c32f179d483",
      "word_count": 10
    },
    {
      "text": "Don’t put essential information in elements that might be unavailable on certain devices",
      "section_path": [
        "Wallet",
        "Designing passes"
      ],
      "source_sentence_hash": "22e3f6c32d37d7bad91204832b5ec30bdef0e6573c5b96d6ff82ac3828624fde",
      "word_count": 13
    },
    {
      "text": "avoid adding padding to images",
      "section_path": [
        "Wallet",
        "Designing passes"
      ],
      "source_sentence_hash": "22e3f6c32d37d7bad91204832b5ec30bdef0e6573c5b96d6ff82ac3828624fde",
      "word_count": 5
    },
    {
      "text": "Use semantic tags for airline boarding passes",
      "section_path": [
        "Wallet",
        "Pass styles",
        "Boarding passes"
      ],
      "source_sentence_hash": "05ff175fc2e109b7f0672ea2548021cd120045396ffc138a6726154e92d4bf07",
      "word_count": 7
    },
    {
      "text": "use pass fields for all other transit types",
      "section_path": [
        "Wallet",
        "Pass styles",
        "Boarding passes"
      ],
      "source_sentence_hash": "05ff175fc2e109b7f0672ea2548021cd120045396ffc138a6726154e92d4bf07",
      "word_count": 8
    },
    {
      "text": "Create pass images in PNG format in @2x and @3x format",
      "section_path": [
        "Wallet",
        "Pass images"
      ],
      "source_sentence_hash": "433bedda58eefdd9ce2aa0f816bcfbda80c4c83f1f4fa316401ba7bae025c15b",
      "word_count": 11
    },
    {
      "text": "Use text fields and semantic tags instead",
      "section_path": [
        "Wallet",
        "Pass images"
      ],
      "source_sentence_hash": "ad4bdc1febc86f76742a53b462cf93e929b2f6e24e8d8ac46fd74c91c6a30a98",
      "word_count": 7
    },
    {
      "text": "Use Pass Designer or corresponding APIs to add barcodes rather than embedding them in pass images",
      "section_path": [
        "Wallet",
        "Pass images"
      ],
      "source_sentence_hash": "ad4bdc1febc86f76742a53b462cf93e929b2f6e24e8d8ac46fd74c91c6a30a98",
      "word_count": 15
    },
    {
      "text": "Keep areas behind text uncluttered",
      "section_path": [
        "Wallet",
        "Pass images",
        "Strip image"
      ],
      "source_sentence_hash": "6ceb0de516bb8637cfd15b9e182981d91a5f0902a1f2aa7bf36d212b5e541e80",
      "word_count": 5
    },
    {
      "text": "use rounded corners on your artwork and export as a transparent PNG",
      "section_path": [
        "Wallet",
        "Pass images",
        "Thumbnail"
      ],
      "source_sentence_hash": "ae9c88a75f708a5cc4471f2c6d0c3464e820142a0deae9e3e972ee594efbe6b4",
      "word_count": 12
    },
    {
      "text": "Position content within the safe area",
      "section_path": [
        "Wallet",
        "Pass images",
        "Background"
      ],
      "source_sentence_hash": "26c9c644d7dff393870bb86a9fe404adfe21bbb0a62d75072a76ed78c1a9a540",
      "word_count": 6
    },
    {
      "text": "make sure the price you show matches the final price the customer confirmed",
      "section_path": [
        "Wallet",
        "Order tracking"
      ],
      "source_sentence_hash": "2fc5360315cfd197f2a94f2ec36b6cc4f0f67374a1131e34450e3d2ac25c2217",
      "word_count": 13
    },
    {
      "text": "You need to provide a link to the merchant’s website or landing page",
      "section_path": [
        "Wallet",
        "Order tracking",
        "Displaying order and fulfillment details"
      ],
      "source_sentence_hash": "a78d891d206f5f69f480ad65ee1efd8ac569c7dbd6622673024a8dd51766949a",
      "word_count": 13
    },
    {
      "text": "provide a tracking link (when one is available) so people can track their order on their own",
      "section_path": [
        "Wallet",
        "Order tracking",
        "Displaying order and fulfillment details"
      ],
      "source_sentence_hash": "2352c4d41382210142fe210a345573c59fbd70a4b3e776525c10988e28c928ac",
      "word_count": 17
    },
    {
      "text": "Be prepared to present a fallback view that offers a different verification method",
      "section_path": [
        "Wallet",
        "Identity verification"
      ],
      "source_sentence_hash": "9c8fc53e4012160f7a4fd7a3c9b4c5d4445f935ff2041e95a7c189ef1c16ace6",
      "word_count": 13
    },
    {
      "text": "don’t request verification before people are ready to start the process or when they’re simply creating an account",
      "section_path": [
        "Wallet",
        "Identity verification"
      ],
      "source_sentence_hash": "d025916f800f9a211d5e782ca84c9ec03260e81cfee6b983b61753e4ecc33f47",
      "word_count": 18
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Wallet",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    },
    {
      "text": "Design simple passes that fit Wallet",
      "section_path": [
        "Wallet",
        "Designing passes"
      ],
      "source_sentence_hash": "f1236930440ef0f0d7a9c3974064a7bbd4ff18b6af5a9bd65fe51ca87a0c5905",
      "word_count": 6
    },
    {
      "text": "Use Pass Designer to design and preview Wallet passes",
      "section_path": [
        "Wallet",
        "Designing passes"
      ],
      "source_sentence_hash": "57d16607fd6542ec9144ab8ca8302c3ed3f9ed18a50b8029f83193f819eb04ae",
      "word_count": 9
    },
    {
      "text": "Provide as much relevant Wallet order information as possible",
      "section_path": [
        "Wallet",
        "Order tracking"
      ],
      "source_sentence_hash": "cf3ec2086f986434c45f51e2cbe273d8409bacea387d2633eb530111b124eee0",
      "word_count": 9
    },
    {
      "text": "Provide a scannable barcode when pickup requires one",
      "section_path": [
        "Wallet",
        "Order tracking",
        "Displaying order and fulfillment details"
      ],
      "source_sentence_hash": "fb2bd626514645600b4bbff77c8202831778e208820f898bb3e09ef6e93f65dd",
      "word_count": 8
    },
    {
      "text": "Provide clear instructions for receiving or picking up an order",
      "section_path": [
        "Wallet",
        "Order tracking",
        "Displaying order and fulfillment details"
      ],
      "source_sentence_hash": "37427cb631a5cd643b67b754afb50facbe4218fb3deb0df74c2fbc2b065b44b4",
      "word_count": 10
    },
    {
      "text": "Ensure order tracking takes priority over other recommendations",
      "section_path": [
        "Wallet",
        "Order tracking",
        "Displaying order and fulfillment details"
      ],
      "source_sentence_hash": "fefd5dcc2f805dfe82fe15f0983ed15a2de16df2fdf3819cdbd01f7a9f9e3e61",
      "word_count": 8
    },
    {
      "text": "Consider an outlined Wallet verification button for dark backgrounds",
      "section_path": [
        "Wallet",
        "Identity verification"
      ],
      "source_sentence_hash": "e73d7f9d70ca294ca60482aea7732b20946ac69a91d66b999a4255efe9a38b97",
      "word_count": 9
    },
    {
      "text": "Consider matching Wallet verification button corners to related controls",
      "section_path": [
        "Wallet",
        "Identity verification"
      ],
      "source_sentence_hash": "e73d7f9d70ca294ca60482aea7732b20946ac69a91d66b999a4255efe9a38b97",
      "word_count": 9
    }
  ],
