    },
    {
      "text": "Make it easy for people to add an order to Wallet",
      "section_path": [
        "Wallet",
        "Order tracking"
      ],
      "source_sentence_hash": "a3be2fe51b6420a525cf9ede4bc4a687a2884f2be14140777a23ff12340e846e",
      "word_count": 11
    },
    {
      "text": "Make information about an order available immediately after people place it",
      "section_path": [
        "Wallet",
        "Order tracking"
      ],
      "source_sentence_hash": "9dba55893f56170b93b088b0b4e178b5cd2d8ace95c985b1558615b0e598532b",
      "word_count": 11
    },
    {
      "text": "Provide fulfillment information as soon as it’s available, and keep the status up to date",
      "section_path": [
        "Wallet",
        "Order tracking"
      ],
      "source_sentence_hash": "3e45f5282861c9716be32c519d3ae9802180cc9e2237945d4cbf716aacf76525",
      "word_count": 15
    },
    {
      "text": "Supply a high-resolution logo image that uses a nontransparent background",
      "section_path": [
        "Wallet",
        "Order tracking"
      ],
      "source_sentence_hash": "ca490677389231e81d36dbf73770a520465863e9cc3293262b67e90729bc17ed",
      "word_count": 10
    },
    {
      "text": "Supply distinct, high-resolution product images that use nontransparent backgrounds",
      "section_path": [
        "Wallet",
        "Order tracking"
      ],
      "source_sentence_hash": "4a7dec7a9cb2c85d4f46367676264483de198766d431212f85d1fa0031fc9bd5",
      "word_count": 9
    },
    {
      "text": "In general, keep text brief",
      "section_path": [
        "Wallet",
        "Order tracking"
      ],
      "source_sentence_hash": "8a604c036280ed4211466a6b1f8c0707c210f969bdf941b97c92549efa6f6ff7",
      "word_count": 5
    },
    {
      "text": "Use clear, approachable language, and localize the text you provide",
      "section_path": [
        "Wallet",
        "Order tracking"
      ],
      "source_sentence_hash": "31e372f74a445ebec1ee59541bb2ff3021cf3796b171d992c7ea1a67aee71d7f",
      "word_count": 10
    },
    {
      "text": "Displaying order and fulfillment details",
      "section_path": [
        "Wallet",
        "Order tracking",
        "Displaying order and fulfillment details"
      ],
      "source_sentence_hash": "bd05655feebee340ae472c179d976b7ae328a74fe27ae4baca8bc373fb9b927f",
      "word_count": 5
    },
    {
      "text": "Provide a link to an area where people manage their order",
      "section_path": [
        "Wallet",
        "Order tracking",
        "Displaying order and fulfillment details"
      ],
      "source_sentence_hash": "b4ed7f8da1c6dde6c74506fd4a023356174640e468409b1a856a473cf3d6bb91",
      "word_count": 11
    },
    {
      "text": "Clearly describe each item so people can verify that their order contains everything they expect",
      "section_path": [
        "Wallet",
        "Order tracking",
        "Displaying order and fulfillment details"
      ],
      "source_sentence_hash": "bd155e0360a412b1daf5af0fe2090573ab2b2fbfd6d9b5f71439f80c55d83768",
      "word_count": 15
    },
    {
      "text": "Supply a prioritized list of your apps that might be installed on the device",
      "section_path": [
        "Wallet",
        "Order tracking",
        "Displaying order and fulfillment details"
      ],
      "source_sentence_hash": "b431e43d39584e09ac69e83186e240e2e65c752f6d5df9d03143baa7f4d57ece",
      "word_count": 14
    },
    {
      "text": "Avoid sending duplicate notifications",
      "section_path": [
        "Wallet",
        "Order tracking",
        "Displaying order and fulfillment details"
      ],
      "source_sentence_hash": "c7087a443bba9f8acd8028b066582d919f08578806e9e87a9ecb6d5f6342cb51",
      "word_count": 4
    },
    {
      "text": "Make it easy for customers to contact the merchant",
      "section_path": [
        "Wallet",
        "Order tracking",
        "Displaying order and fulfillment details"
      ],
      "source_sentence_hash": "79a69b644330b004e479055a62d691543e0e3c7cd4a8d41bc9960ca6f63c0087",
      "word_count": 9
    },
    {
      "text": "Help people track their order",
      "section_path": [
        "Wallet",
        "Order tracking",
        "Displaying order and fulfillment details"
      ],
      "source_sentence_hash": "221df9c7e055d013795667ddd2d392a5711a18a8a6bf13636c8816341bfa43df",
      "word_count": 5
    },
    {
      "text": "Keep the fulfillment screen centered on order tracking",
      "section_path": [
        "Wallet",
        "Order tracking",
        "Displaying order and fulfillment details"
      ],
      "source_sentence_hash": "0a80d4aad7b54f1b2f853bafddee54c2e455e0ee978eefbfef9fd580422fca84",
      "word_count": 8
    },
    {
      "text": "Choose shipping-fulfillment values that match the details you have about the shipping process",
      "section_path": [
        "Wallet",
        "Order tracking",
        "Displaying order and fulfillment details"
      ],
      "source_sentence_hash": "19c62b2e2981d754bc86cb5a4901b20d7dc4c2fdfe0a5d1125d89257d6dd34a6",
      "word_count": 13
    },
    {
      "text": "Keep customers informed through relevant fulfillment status descriptions",
      "section_path": [
        "Wallet",
        "Order tracking",
        "Displaying order and fulfillment details"
      ],
      "source_sentence_hash": "ad37570ae4eac1c42d6266da5e4b3f84561f73e9e9dc9579635731a3aea339dd",
      "word_count": 8
    },
    {
      "text": "Be direct and thorough when describing an Issue or Canceled status",
      "section_path": [
        "Wallet",
        "Order tracking",
        "Displaying order and fulfillment details"
      ],
      "source_sentence_hash": "6778c467710248d5a2cea1efdb4ed0c93be45bee8234460fe7ea603a53112262",
      "word_count": 11
    },
    {
      "text": "Present a Wallet verification option only when the device supports it",
      "section_path": [
        "Wallet",
        "Identity verification"
      ],
      "source_sentence_hash": "79b7cede6c2a666ab0b43a6b168c5839f5fc4f2ec22792be7f16be8fd644871b",
      "word_count": 11
    },
    {
      "text": "Ask for identity information only at the precise moment you need it",
      "section_path": [
        "Wallet",
        "Identity verification"
      ],
      "source_sentence_hash": "2a96fe99bf5a3af136d26028a1a2662fabb1e3256c91a2dc038e094e3aa20334",
      "word_count": 12
    },
    {
      "text": "Clearly and succinctly describe the reason you need the information you’re requesting",
      "section_path": [
        "Wallet",
        "Identity verification"
      ],
      "source_sentence_hash": "9fd128b1d3f87cd9f14c1189fc5e2a2a4c06c8cc3a1a4a1d11b084ca35a57b37",
      "word_count": 12
    },
    {
      "text": "Ask only for the data you actually need",
      "section_path": [
        "Wallet",
        "Identity verification"
      ],
      "source_sentence_hash": "c32c7e2308d500b14b3a32b26ac8bc379b3a43b05d5ed44e57b832273553bae2",
      "word_count": 8
    },
    {
      "text": "Clearly indicate whether you will keep the data and — if you need to keep it — specify how",
      "section_path": [
        "Wallet",
        "Identity verification"
      ],
      "source_sentence_hash": "e4d8ff4d7385e99bc141d5c2aa0c43c96889496b47d0eb96bf2c70684dc845e1",
      "word_count": 19
    },
    {
      "text": "Choose the system-provided verification button that matches your use case and the visual design of your app",
      "section_path": [
        "Wallet",
        "Identity verification"
      ],
      "source_sentence_hash": "b0d0d29052bedaaf0a10e4202e2b3bc6df1f3ad721658e5dc95cfd3156f7ed4a",
      "word_count": 17
    },
