  "guidance_candidates": [
    {
      "text": "Offer AR features only on capable devices",
      "section_path": [
        "Augmented reality"
      ],
      "source_sentence_hash": "f11affe0904e753546155a65d6711833827437b6efcc3fb936da206f4aacd13d",
      "word_count": 7
    },
    {
      "text": "Let people use the entire display",
      "section_path": [
        "Augmented reality",
        "Best practices"
      ],
      "source_sentence_hash": "6f91503603af2e93bb46eabeb10c7688ad502eb91ef1b7903641801fee18c7d2",
      "word_count": 6
    },
    {
      "text": "Strive for convincing illusions when placing realistic objects",
      "section_path": [
        "Augmented reality",
        "Best practices"
      ],
      "source_sentence_hash": "decc6027bec67e07bc2234d8a8528ec1f6822a615eddce8716e25363223f9a7d",
      "word_count": 8
    },
    {
      "text": "Consider how virtual objects with reflective surfaces show the environment",
      "section_path": [
        "Augmented reality",
        "Best practices"
      ],
      "source_sentence_hash": "b9d35cd9555733b56a89a75c8190aed18ac4ef57c51e6d72f3462236588c2c41",
      "word_count": 10
    },
    {
      "text": "Use audio and haptics to enhance the immersive experience",
      "section_path": [
        "Augmented reality",
        "Best practices"
      ],
      "source_sentence_hash": "0d087df05196f0f8e29d4224bb2a19d7a3258d5ce3292b008dc15834503f82a9",
      "word_count": 9
    },
    {
      "text": "Minimize text in the environment",
      "section_path": [
        "Augmented reality",
        "Best practices"
      ],
      "source_sentence_hash": "cfd2f8ee0d25cd8d684a2ff0e16aa72924ef67a6d37f7b0fed2701101c6a1f15",
      "word_count": 5
    },
    {
      "text": "If additional information or controls are necessary, consider displaying them in screen space",
      "section_path": [
        "Augmented reality",
        "Best practices"
      ],
      "source_sentence_hash": "354b979948d2d160113443d66b39ebbf3dbfc3b26c073937eb73a21c5bef4b4d",
      "word_count": 13
    },
    {
      "text": "Consider using indirect controls when you need to provide persistent controls",
      "section_path": [
        "Augmented reality",
        "Best practices"
      ],
      "source_sentence_hash": "e15d4afcf8064b6987b02178712f97eba26342713c64a0a55a342d75a2812c74",
      "word_count": 11
    },
    {
      "text": "Anticipate that people will use your app in a wide variety of real-world environments",
      "section_path": [
        "Augmented reality",
        "Best practices"
      ],
      "source_sentence_hash": "f9cb2af6583cef866105db63d1688df02ddf9f61ff4c5030449a85869dbf3b0f",
      "word_count": 14
    },
    {
      "text": "Be mindful of people’s comfort",
      "section_path": [
        "Augmented reality",
        "Best practices"
      ],
      "source_sentence_hash": "62e404a70d71710ba59c3bb66eb60bc8a218d29daded3373aa042630ac1c270a",
      "word_count": 5
    },
    {
      "text": "If your app encourages people to move, introduce motion gradually",
      "section_path": [
        "Augmented reality",
        "Best practices"
      ],
      "source_sentence_hash": "c8daed229f41f810fa42624a084ed52d067c406b458e9f712485cca5c707ac9f",
      "word_count": 10
    },
    {
      "text": "Be mindful of people’s safety",
      "section_path": [
        "Augmented reality",
        "Best practices"
      ],
      "source_sentence_hash": "9a0d229d5edf5fd121db7d7f303aad388206e60c392de03565af9660f4509779",
      "word_count": 5
    },
    {
      "text": "Hide unnecessary app UI while people are using a coaching view",
      "section_path": [
        "Augmented reality",
        "Providing coaching"
      ],
      "source_sentence_hash": "7ba6c18974b8ea5ec52ccad82daa48d898ef67546888359d783832b4fe84539a",
      "word_count": 11
    },
    {
      "text": "If necessary, offer a custom coaching experience",
      "section_path": [
        "Augmented reality",
        "Providing coaching"
      ],
      "source_sentence_hash": "2c4759905e7467cf9c8fb30c46ac048a7418ba5bf2550f7d6c7b93f15a7c2600",
      "word_count": 7
    },
    {
      "text": "Show people when to locate a surface and place an object",
      "section_path": [
        "Augmented reality",
        "Helping people place objects"
      ],
      "source_sentence_hash": "1c1332b148604a1f70977880fbf2d237be8f020188e7ca2f4309bd35bff7160a",
      "word_count": 11
    },
    {
      "text": "When people place an object, immediately integrate that object into the AR environment",
      "section_path": [
        "Augmented reality",
        "Helping people place objects"
      ],
      "source_sentence_hash": "e9bbaba118b0c4a36eb0c0ee61af7f7f9a692205fdd0bcdecebac8cd5c78e094",
      "word_count": 13
    },
    {
      "text": "Consider guiding people toward offscreen virtual objects",
      "section_path": [
        "Augmented reality",
        "Helping people place objects"
      ],
      "source_sentence_hash": "be8697351d6936391ecad1614cced46543acb0099de69e7496907fcd0ec9ff91",
      "word_count": 7
    },
    {
      "text": "Avoid trying to precisely align objects with the edges of detected surfaces",
      "section_path": [
        "Augmented reality",
        "Helping people place objects"
      ],
      "source_sentence_hash": "3085666c7ae2861a9f360e6d172a5abcc24060811e55b528b2a8f27f1f1d5752",
      "word_count": 12
    },
    {
      "text": "Incorporate plane classification information to inform object placement",
      "section_path": [
        "Augmented reality",
        "Helping people place objects"
      ],
      "source_sentence_hash": "198cd63f31fb58b33d0e6e03bb20fec721e56d8e8da43c820e4110af647df2d0",
      "word_count": 8
    },
    {
      "text": "Let people use direct manipulation to interact with objects when possible",
      "section_path": [
        "Augmented reality",
        "Designing object interactions"
      ],
      "source_sentence_hash": "3acb6016eaf905f259a672bf20a4ed3699a7d086ee3a6eb645a5bb9635c73879",
      "word_count": 11
    },
    {
      "text": "Let people directly interact with virtual objects using standard, familiar gestures",
      "section_path": [
        "Augmented reality",
        "Designing object interactions"
      ],
      "source_sentence_hash": "991c1bb47bc8ec7befd66719f50cc09287aafae140dd8498e6c2a74b6d89ce4d",
      "word_count": 11
    },
    {
      "text": "In general, keep interactions simple",
      "section_path": [
        "Augmented reality",
        "Designing object interactions"
      ],
      "source_sentence_hash": "7cf482063ac532d648a57a7ad2429c6185b8c948b1d7d8356cd225d9232e24e1",
      "word_count": 5
    },
    {
      "text": "Respond to gestures within reasonable proximity of interactive virtual objects",
      "section_path": [
        "Augmented reality",
        "Designing object interactions"
      ],
      "source_sentence_hash": "33eafbc2438625393a4445f70fd0e55ed5d4098ec97eb7d05c09be5f93ff55b4",
      "word_count": 10
    },
    {
      "text": "Let people initiate object scaling when it makes sense in your app",
      "section_path": [
        "Augmented reality",
        "Designing object interactions"
      ],
      "source_sentence_hash": "9bbd4b259896703281da4f4b57772fb6f83c2ca40fee9f71e2b552b19422964a",
      "word_count": 12
    },
    {
      "text": "Be wary of potentially conflicting gestures",
      "section_path": [
        "Augmented reality",
        "Designing object interactions"
      ],
      "source_sentence_hash": "a14b76f3bff4db219d34aff4d662338eaa5240d1ef5251c83991fd5db440e3e6",
      "word_count": 6
    },
    {
      "text": "Strive for virtual object movement that’s consistent with the physics of your app’s AR environment",
      "section_path": [
        "Augmented reality",
        "Designing object interactions"
      ],
      "source_sentence_hash": "61803f0874f2e7637dc0b2df7f3709f4c478771dd09b1912758f3e587a1943e3",
      "word_count": 15
    },
    {
      "text": "Explore even more engaging methods of interaction",
      "section_path": [
        "Augmented reality",
        "Designing object interactions"
      ],
      "source_sentence_hash": "be17cd5314ee936b9a1a3ed85a1b60cfdd2d886791c875c98a7f1d113f7a80fd",
      "word_count": 7
    },
    {
      "text": "Consider allowing people occlusion",
      "section_path": [
        "Augmented reality",
        "Offering a multiuser experience"
      ],
      "source_sentence_hash": "b2d9ad00986cff080b10b1b47e22dad39b48064255c1f3c3f8e312f135a4d4d2",
      "word_count": 4
    },
    {
      "text": "When possible, let new participants enter a multiuser AR experience",
      "section_path": [
        "Augmented reality",
        "Offering a multiuser experience"
      ],
      "source_sentence_hash": "3138e4b2cdcb11477b2d15528dba4528f29fbcd6dddc3cdcc58c633a334ae37e",
      "word_count": 10
    },
    {
      "text": "When a detected image first disappears, consider delaying the removal of virtual objects that are attached to it",
      "section_path": [
        "Augmented reality",
        "Reacting to real-world objects"
      ],
      "source_sentence_hash": "a0032b105b50844d83b3523f6b8eff3ae9f09aa8c9811f1770f02ee2571007ad",
      "word_count": 18
    },
    {
      "text": "Limit the number of reference images in use at one time",
      "section_path": [
        "Augmented reality",
        "Reacting to real-world objects"
      ],
      "source_sentence_hash": "cd585f3c546bfd138a11d84b3655fb3032e1793f5c236b8fb6622217b7950567",
      "word_count": 11
    },
    {
      "text": "Limit the number of reference images requiring an accurate position",
      "section_path": [
        "Augmented reality",
        "Reacting to real-world objects"
      ],
      "source_sentence_hash": "d5bba0258a6470ab3961eab881ae6b102ee2936b3a4194601b96d366a30781bf",
      "word_count": 10
    },
    {
      "text": "If you must display instructional text, use approachable terminology",
      "section_path": [
        "Augmented reality",
        "Communicating with people"
      ],
      "source_sentence_hash": "31bfe269e1579558cb995608f840a441bfa45f2ab0b2980ae4770ea09024304b",
      "word_count": 9
    },
    {
      "text": "In a three-dimensional context, prefer 3D hints",
      "section_path": [
        "Augmented reality",
        "Communicating with people"
      ],
      "source_sentence_hash": "bf8d00d54f091b1e0340904c12ce1d3c331a1290ffca5be0f49e12f3dfaabaaa",
      "word_count": 7
    },
    {
      "text": "Make important text readable",
      "section_path": [
        "Augmented reality",
        "Communicating with people"
      ],
      "source_sentence_hash": "f3aa2db8477aeaff3f8e60702c4f0e829e26757fbbe7bce51c2e4a70e9115fe2",
      "word_count": 4
    },
    {
      "text": "If necessary, provide a way to get more information",
      "section_path": [
        "Augmented reality",
        "Communicating with people"
      ],
      "source_sentence_hash": "3b3fd5a08e91eab2c92293da61f20d1642b7cc57f89ae61edd3d12120705ee30",
      "word_count": 9
    },
    {
      "text": "Consider using the system-provided coaching view to help people relocalize",
      "section_path": [
        "Augmented reality",
        "Handling interruptions"
      ],
      "source_sentence_hash": "2e5e8be87678efb3c674546e2767709e5d5b5da5e0f1b3d2fb29a7dee900ae8c",
      "word_count": 10
    },
    {
      "text": "Consider hiding previously placed virtual objects during relocalization",
      "section_path": [
        "Augmented reality",
        "Handling interruptions"
      ],
      "source_sentence_hash": "26260d072ef3eb1cc89b61a88d0aa4c8ca567be6047d1f9c10760db1d946a717",
      "word_count": 8
    },
    {
      "text": "Minimize interruptions if your app supports both AR and non-AR experiences",
      "section_path": [
        "Augmented reality",
        "Handling interruptions"
      ],
      "source_sentence_hash": "9d6440d197bcd238e94223154c99946d58e6db1a3d6fa28d9a406cea6520f831",
      "word_count": 11
    },
    {
      "text": "Allow people to cancel relocalization",
      "section_path": [
        "Augmented reality",
        "Handling interruptions"
      ],
      "source_sentence_hash": "2bd0e6e92bbc08f97f503b7cd1179ab5f10981bc825a80f7699a4b03fa91aaaf",
      "word_count": 5
    },
    {
      "text": "Indicate when the front-facing camera is unable to track a face for more than about half a second",
      "section_path": [
        "Augmented reality",
        "Handling interruptions"
      ],
      "source_sentence_hash": "a78be94ede0cdffdec6ba047863e505279f5ed3b2686cc845bd555a779616b85",
      "word_count": 18
    },
    {
      "text": "Let people reset the experience if it doesn’t meet their expectations",
      "section_path": [
        "Augmented reality",
        "Suggesting problem resolutions"
      ],
      "source_sentence_hash": "01d2c752adaf2cb604b3aed57fd6223ebddad80a96ff805fea2839b40c0ac1a0",
      "word_count": 11
    },
    {
      "text": "Suggest possible fixes if problems occur",
      "section_path": [
        "Augmented reality",
        "Suggesting problem resolutions"
      ],
      "source_sentence_hash": "e84d65f1a7c25acd12747fd13e4ed7f83c743dff15c1f2d1dbdf31ba1e729e12",
      "word_count": 6
    },
    {
      "text": "Use the AR glyph as intended",
      "section_path": [
        "Augmented reality",
        "Icons and badges"
      ],
      "source_sentence_hash": "f764d9dcec861c86322e9067e69fd647cf9d0ab412c70045317438ae3a0ae988",
      "word_count": 6
    },
    {
      "text": "Maintain minimum clear space",
      "section_path": [
        "Augmented reality",
        "Icons and badges"
      ],
      "source_sentence_hash": "92e160afc70790884dada081d05b24ea325fa03d61fdabf70359ad5d9eb1dca9",
      "word_count": 4
    },
    {
      "text": "Use the AR badges as intended and don’t alter them",
      "section_path": [
        "Augmented reality",
        "Icons and badges"
      ],
      "source_sentence_hash": "940f2d166101924146475a3d631b87d6ff80c00eb998be8dc55bff052c6fa408",
      "word_count": 10
    },
    {
      "text": "Prefer the AR badge to the glyph-only badge",
      "section_path": [
        "Augmented reality",
        "Icons and badges"
      ],
      "source_sentence_hash": "553c239c24fa3055f00a4ebabb62e36581d22e503a34d2e8972e293196be71fd",
      "word_count": 8
    },
    {
      "text": "Use badging only when your app contains a mixture of objects that can be viewed in AR and objects",
      "section_path": [
        "Augmented reality",
        "Icons and badges"
      ],
      "source_sentence_hash": "124667ca2b4749f983c9be3d839d6c1df1a6341a3e9f3d9248ef28e8247fb729",
      "word_count": 19
    },
    {
      "text": "Keep badge placement consistent and clear",
      "section_path": [
        "Augmented reality",
        "Icons and badges"
      ],
      "source_sentence_hash": "4759e3d838de126dbb8346875427aff7c0af19101de7b00676b7fbc6e780a658",
      "word_count": 6
    },
    {
      "text": "Design for varied real-world environments",
      "section_path": [
        "Augmented reality",
        "Best practices"
      ],
      "source_sentence_hash": "8d42d6ee6b7cee145df11e560d30ba924f231fa49697b8f0e2a8affb2a6f4ec7",
      "word_count": 5
    },
    {
      "text": "Design encouraged movement to begin gradually",
      "section_path": [
        "Augmented reality",
        "Best practices"
      ],
      "source_sentence_hash": "8bc008c13aebae782e2236251037c3f90681aab2f9c23dba5687e90e0b70307a",
      "word_count": 6
    },
    {
      "text": "Consider using the system coaching view during AR initialization",
      "section_path": [
        "Augmented reality",
        "Providing coaching"
      ],
      "source_sentence_hash": "ed5601e410dafbf3d859ec2245f826d2753ccc231b60842ee4cf9418c43ed5f6",
      "word_count": 9
    },
    {
      "text": "Use the system coaching view as the reference for custom coaching",
      "section_path": [
        "Augmented reality",
        "Providing coaching"
      ],
      "source_sentence_hash": "c7a4d18de76d8087a60c7d06616afc14826428361a18b6270cb15a9fcbd92625",
      "word_count": 11
    },
    {
      "text": "Integrate placed objects into the AR environment immediately",
      "section_path": [
        "Augmented reality",
        "Helping people place objects"
      ],
      "source_sentence_hash": "88628a7c7337d053244d05e39e37f49dc9fc549871878a1937d7b973620fc3f9",
      "word_count": 8
    },
    {
      "text": "Use plane classification information to guide object placement",
      "section_path": [
        "Augmented reality",
        "Helping people place objects"
      ],
      "source_sentence_hash": "2d4b690b8bc54632bf1845f87c8156052d54fb0b0613ebe8e077e62431b09753",
      "word_count": 8
    },
    {
      "text": "Keep AR object interactions simple",
      "section_path": [
        "Augmented reality",
        "Designing object interactions"
      ],
      "source_sentence_hash": "76b92422e4eef05bfd2de1d317ea41e8294266a2dbb839670f38f512e04d7f08",
      "word_count": 5
    },
    {
      "text": "Avoid using scaling to adjust an object’s distance",
      "section_path": [
        "Augmented reality",
        "Designing object interactions"
      ],
      "source_sentence_hash": "30fe7cbb84c42230a2ac46a688d48846e3667e5e02ad1c5a8d6220224da7e54e",
      "word_count": 8
    },
    {
      "text": "Let new participants join ongoing multiuser AR experiences when possible",
      "section_path": [
        "Augmented reality",
        "Offering a multiuser experience"
      ],
      "source_sentence_hash": "8d13cb60468018da61f65cdc6c10ec34699b8a0845ce16d64cee390aab8f1826",
      "word_count": 10
    },
    {
      "text": "Consider delaying virtual-object removal after a detected image disappears",
      "section_path": [
        "Augmented reality",
        "Reacting to real-world objects"
      ],
      "source_sentence_hash": "0ac1979f8637fba93a8dd529b74c5a4a479f2484f65627494b5886e240f32a5e",
      "word_count": 9
    },
    {
      "text": "Prefer active reference-image sets of 100 images or fewer",
      "section_path": [
        "Augmented reality",
        "Reacting to real-world objects"
      ],
      "source_sentence_hash": "ee2b723745041947ccdb2d950e7dacf7c689f4b62327e8e55b41775897fef6b2",
      "word_count": 9
    },
    {
      "text": "Minimize reference images that require accurate position tracking",
      "section_path": [
        "Augmented reality",
        "Reacting to real-world objects"
      ],
      "source_sentence_hash": "5eab235e8f487b7f0bc5475dc617fa4092b538126dd06dc99c9e8fb27678dcb0",
      "word_count": 8
    },
    {
      "text": "Prefer 3D hints in three-dimensional contexts",
      "section_path": [
        "Augmented reality",
        "Communicating with people"
      ],
      "source_sentence_hash": "9899cc7a526ca7dcb8d150f19e60cfa75e8f622bb5df1465bcc71644ead3306c",
      "word_count": 6
    },
    {
      "text": "Provide a way to get more information when necessary",
      "section_path": [
        "Augmented reality",
        "Communicating with people"
      ],
      "source_sentence_hash": "8ae4373c376026051d861060e7f3a15d7a79d1a96193056ccbcf50826ca2dabc",
      "word_count": 9
    },
    {
      "text": "Provide possible fixes when AR problems occur",
      "section_path": [
        "Augmented reality",
        "Suggesting problem resolutions"
      ],
      "source_sentence_hash": "7c85abaa5e177a31a3c4dd831ac35bb089d1c4d7b0640fb347014a2223665921",
      "word_count": 7
    },
    {
      "text": "Ensure AR scenes update 60 times per second",
      "section_path": [
        "Augmented reality",
        "Best practices"
      ],
      "source_sentence_hash": "38fde37a92b3efc5b811049b000a75320b57cc5570ec8853b855117044c270ff",
      "word_count": 8
    },
    {
      "text": "Be sure to test potentially conflicting gestures",
      "section_path": [
        "Augmented reality",
        "Designing object interactions"
      ],
      "source_sentence_hash": "e8ae2c045136b2683a66d8c7e84fd8328114bd10bda57dcb058cd36aacd553b8",
      "word_count": 7
    },
    {
      "text": "Ensure similar gestures are interpreted correctly",
      "section_path": [
        "Augmented reality",
        "Designing object interactions"
      ],
      "source_sentence_hash": "e8ae2c045136b2683a66d8c7e84fd8328114bd10bda57dcb058cd36aacd553b8",
      "word_count": 6
    },
    {
      "text": "Ensure text in 3D space faces people",
      "section_path": [
        "Augmented reality",
        "Communicating with people"
      ],
      "source_sentence_hash": "00594eed3a4dc962b8c790c244773b8d782155a6a40e70dfb1c2676103e07181",
      "word_count": 7
    },
    {
      "text": "Ensure 3D text uses the same type size at every distance",
      "section_path": [
        "Augmented reality",
        "Communicating with people"
      ],
      "source_sentence_hash": "00594eed3a4dc962b8c790c244773b8d782155a6a40e70dfb1c2676103e07181",
      "word_count": 10
    },
    {
      "text": "Never alter the AR glyph beyond adjustments to size and color",
      "section_path": [
        "Augmented reality",
        "Icons and badges"
      ],
      "source_sentence_hash": "a8635cc9f6ed259c905d9c7a8495e359a395c6b355de6d3ef7f05dd31d80eb91",
      "word_count": 10
    },
    {
      "text": "Never use the AR glyph for purposes other than starting an ARKit experience",
      "section_path": [
        "Augmented reality",
        "Icons and badges"
      ],
      "source_sentence_hash": "a8635cc9f6ed259c905d9c7a8495e359a395c6b355de6d3ef7f05dd31d80eb91",
      "word_count": 13
    },
    {
      "text": "Never use the AR glyph with experiences not created using ARKit",
      "section_path": [
        "Augmented reality",
        "Icons and badges"
      ],
      "source_sentence_hash": "a8635cc9f6ed259c905d9c7a8495e359a395c6b355de6d3ef7f05dd31d80eb91",
      "word_count": 11
    },
    {
      "text": "Never alter or recolor AR badges",
      "section_path": [
        "Augmented reality",
        "Icons and badges"
      ],
      "source_sentence_hash": "7cf5c275b80c002b52a9301eab342aebe5b30ed94284496d8b2e5f933a81a4ab",
      "word_count": 6
    },
    {
      "text": "Never use AR badges for purposes other than identifying ARKit-viewable items",
      "section_path": [
        "Augmented reality",
        "Icons and badges"
      ],
      "source_sentence_hash": "7cf5c275b80c002b52a9301eab342aebe5b30ed94284496d8b2e5f933a81a4ab",
      "word_count": 11
    },
    {
      "text": "Never use AR badges with experiences not created using ARKit",
      "section_path": [
        "Augmented reality",
        "Icons and badges"
      ],
      "source_sentence_hash": "7cf5c275b80c002b52a9301eab342aebe5b30ed94284496d8b2e5f933a81a4ab",
      "word_count": 10
    },
    {
      "text": "Always place an AR badge in the same photo corner",
      "section_path": [
        "Augmented reality",
        "Icons and badges"
      ],
      "source_sentence_hash": "aa0868c00e2c481dbdf34a2b3c3bc7008984b2b173add05d0932d6b6c2c087a9",
      "word_count": 9
    },
    {
      "text": "Ensure an AR badge is visible without obscuring important photo details",
      "section_path": [
        "Augmented reality",
        "Icons and badges"
      ],
      "source_sentence_hash": "aa0868c00e2c481dbdf34a2b3c3bc7008984b2b173add05d0932d6b6c2c087a9",
      "word_count": 11
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Augmented reality",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
