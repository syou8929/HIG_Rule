  "guidance_candidates": [
    {
      "text": "Use a panel to give people quick access to important controls or information related to the content they’re working",
      "section_path": [
        "Panels",
        "Best practices"
      ],
      "source_sentence_hash": "44948f53cb41b28b5b08be1ce86dbbd71a63dc471284ca6acbb8e079f0fbbca0",
      "word_count": 19
    },
    {
      "text": "Consider using a panel to present inspector functionality",
      "section_path": [
        "Panels",
        "Best practices"
      ],
      "source_sentence_hash": "b6d9c96622bcad5f7cf41734fc2ad51efc916a4180807b287db28ea07d84652f",
      "word_count": 8
    },
    {
      "text": "Prefer simple adjustment controls in a panel",
      "section_path": [
        "Panels",
        "Best practices"
      ],
      "source_sentence_hash": "084e4405b612ea6e7e9a0f1bc90ea3364291942db5689981b7ada1ccd8aa7cb0",
      "word_count": 7
    },
    {
      "text": "Write a brief title that describes the panel’s purpose",
      "section_path": [
        "Panels",
        "Best practices"
      ],
      "source_sentence_hash": "8af06f121577503e2e58df5ad5dd2c282f6a99bab892d34b891acec78ba73961",
      "word_count": 9
    },
    {
      "text": "Show and hide panels appropriately",
      "section_path": [
        "Panels",
        "Best practices"
      ],
      "source_sentence_hash": "b41b330527990bc2925f88061ea9455d5a8b6eee471d06663225f122b7a4e3b0",
      "word_count": 5
    },
    {
      "text": "Avoid including panels in the Window menu’s documents list",
      "section_path": [
        "Panels",
        "Best practices"
      ],
      "source_sentence_hash": "c7fa605c3b7cba055a23dd1862a006a42e3140125a277c8483c374108115bf48",
      "word_count": 9
    },
    {
      "text": "In general, avoid making a panel’s minimize button available",
      "section_path": [
        "Panels",
        "Best practices"
      ],
      "source_sentence_hash": "30e76913955f1bd6c5357f13c385ff00b9295159484f7cc7da3a2265a6f8214e",
      "word_count": 9
    },
    {
      "text": "Refer to panels by title in your interface and in help documentation",
      "section_path": [
        "Panels",
        "Best practices"
      ],
      "source_sentence_hash": "f144ca5f0811b8aaf036a940336cfccc5e19437581225be151a1ce3e696d5a96",
      "word_count": 12
    },
    {
      "text": "Prefer standard panels",
      "section_path": [
        "Panels",
        "HUD-style panels"
      ],
      "source_sentence_hash": "cf405c7d75ecf9c570a7b4da4ebf0cad5ca6f335da1f75e4e6573460d4cf26b5",
      "word_count": 3
    },
    {
      "text": "In a media-oriented app that presents movies, photos, or slides",
      "section_path": [
        "Panels",
        "HUD-style panels"
      ],
      "source_sentence_hash": "309cf4ce25602077ad0488d53bd0a43527409bf756e4a92809f233d983140cf8",
      "word_count": 10
    },
    {
      "text": "When a standard panel would obscure essential content",
      "section_path": [
        "Panels",
        "HUD-style panels"
      ],
      "source_sentence_hash": "4550f93bd00cfb894c38dccaf62d3cfc8db84227e56865b2b0c0fc992cc51a44",
      "word_count": 8
    },
    {
      "text": "When you don’t need to include controls — with the exception of the disclosure triangle, most system-provided controls don’t",
      "section_path": [
        "Panels",
        "HUD-style panels"
      ],
      "source_sentence_hash": "b9e5c380a8fda60863c2203e620b485668c2336c3729bb4b6e371a3d16b471f8",
      "word_count": 19
    },
    {
      "text": "Maintain one panel style when your app switches modes",
      "section_path": [
        "Panels",
        "HUD-style panels"
      ],
      "source_sentence_hash": "57b3339ffd81995bdae0c3e1e232e1944d983a460d08b8f7a34ceed6360a5d8d",
      "word_count": 9
    },
    {
      "text": "Use color sparingly in HUDs",
      "section_path": [
        "Panels",
        "HUD-style panels"
      ],
      "source_sentence_hash": "db677df8045fbf143158fe3842065934ef9887fd8a29b808b51d60e26cb29aa8",
      "word_count": 5
    },
    {
      "text": "Keep HUDs small",
      "section_path": [
        "Panels",
        "HUD-style panels"
      ],
      "source_sentence_hash": "1f5bab2fabb18c6830d697ef643a7aa3cf14fe4dded820ade90e4443c9a7711d",
      "word_count": 3
    },
