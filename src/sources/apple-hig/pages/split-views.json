  "guidance_candidates": [
    {
      "text": "To support navigation, persistently highlight the current selection in each pane that leads to the detail view",
      "section_path": [
        "Split views",
        "Best practices"
      ],
      "source_sentence_hash": "0ec0d77485bcafa2321f1665827c95d8506797cbd8a51e223094f2e06eae4374",
      "word_count": 17
    },
    {
      "text": "Consider letting people drag and drop content between panes",
      "section_path": [
        "Split views",
        "Best practices"
      ],
      "source_sentence_hash": "adf9199e2908163291f595934ec199a977c565dcbf30d3993db66f7d53407caf",
      "word_count": 9
    },
    {
      "text": "Prefer using a split view in a regular — not a compact — environment",
      "section_path": [
        "Split views",
        "Platform considerations",
        "iOS"
      ],
      "source_sentence_hash": "7669241d3c0b8fffffd5501e54464cb1fb4e047f4a9072564e1c319f0b90327c",
      "word_count": 14
    },
    {
      "text": "Account for narrow, compact, and intermediate window widths",
      "section_path": [
        "Split views",
        "Platform considerations",
        "iPadOS"
      ],
      "source_sentence_hash": "4505876a78e9882a47feeca06d57cee2f2ed0a35c0dccf973d0d66030abb30dc",
      "word_count": 8
    },
    {
      "text": "Set reasonable defaults for minimum and maximum pane sizes",
      "section_path": [
        "Split views",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "16749b5cffd25515bea28dc6135438b3aed700bf0c2ec64347d26949bf250785",
      "word_count": 9
    },
    {
      "text": "Consider letting people hide a pane when it makes sense",
      "section_path": [
        "Split views",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "b43e62985d328d0c2a9d580f69f55513a81ebc4cf1846fc62d2f3e265300653a",
      "word_count": 10
    },
    {
      "text": "Provide multiple ways to reveal hidden panes",
      "section_path": [
        "Split views",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "f42d720f745506f7ee45f4805382acbd84b0722f96192f9394e42cf657bebdf2",
      "word_count": 7
    },
    {
      "text": "Prefer the thin divider style",
      "section_path": [
        "Split views",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "8c2c07c5878d6d56cda581e28aed6a52833bbbbea614937147386a96dd9deca0",
      "word_count": 5
    },
    {
      "text": "Choose a split view layout that keeps the panes looking balanced",
      "section_path": [
        "Split views",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "ad73cf033119974e3fe544a299301a93ad998e912615321e6cc9feb6054f0d05",
      "word_count": 11
    },
    {
      "text": "Display a single title above a split view, helping people understand the content as a whole",
      "section_path": [
        "Split views",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "69ec8aa0d93a16f846b2247dc64107c02aca8d6375ba3ab1d0df0c38a090f1df",
      "word_count": 16
    },
    {
      "text": "Choose the title’s alignment based on the type of content the secondary pane contains",
      "section_path": [
        "Split views",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "6217fce543a6947521bf6635818795b37db8d40ed82333dfbc1b95e2f77bb941",
      "word_count": 14
    },
    {
      "text": "To display supplementary information, prefer a split view instead of a new window",
      "section_path": [
        "Split views",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "1094867fadebd76267688d98ec95dce7ff30a4f0ef8d9f9c7835fdfc94ff733f",
      "word_count": 13
    },
    {
      "text": "Automatically display the most relevant detail view",
      "section_path": [
        "Split views",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "ce86e1d35ab1a83846ff2f340ee0c9bd37148dc327dc3db59459d45f62feebc0",
      "word_count": 7
    },
    {
      "text": "If your app displays multiple detail pages, place the detail views in a vertical tab view",
      "section_path": [
        "Split views",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "3d457435e1d5eeb4dc48e587fa6b03e79eb2222d07427ebe5da29b0956c63947",
      "word_count": 16
    },
