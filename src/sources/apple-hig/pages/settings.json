  "guidance_candidates": [
    {
      "text": "Aim to provide default settings that give the best experience to the largest number of people",
      "section_path": [
        "Settings",
        "Best practices"
      ],
      "source_sentence_hash": "d3bc298c1db753078f8fc7135af0ef222efaaf9f9b4363ee79adde570e38f2dc",
      "word_count": 16
    },
    {
      "text": "Minimize the number of settings you offer",
      "section_path": [
        "Settings",
        "Best practices"
      ],
      "source_sentence_hash": "9742bf623b58a9f8c85565990a30cb924bd351207d0eb6fc4b285ff4d503f750",
      "word_count": 7
    },
    {
      "text": "Make settings available in ways people expect",
      "section_path": [
        "Settings",
        "Best practices"
      ],
      "source_sentence_hash": "8a5bf4e06a8d4b62b0e476e21ebf2456f2544433ef28d84961ec851075a4381d",
      "word_count": 7
    },
    {
      "text": "Avoid using settings to ask for setup information you can get in other ways",
      "section_path": [
        "Settings",
        "Best practices"
      ],
      "source_sentence_hash": "6de391e6747739bd45628824583b03d96d2fca68918e67cd702f4b1b93fd9105",
      "word_count": 14
    },
    {
      "text": "Respect people’s systemwide settings and avoid including redundant versions of them in your custom settings area",
      "section_path": [
        "Settings",
        "Best practices"
      ],
      "source_sentence_hash": "2d9202ecb106c6f83a6804ac52b46e1da33f39d7c990afcdad961ba5f99629ca",
      "word_count": 16
    },
    {
      "text": "Use custom settings for general infrequently changed options",
      "section_path": [
        "Settings",
        "General settings"
      ],
      "source_sentence_hash": "a08d12f9c99041ee939485bc5cdde8fe443d0ea11956dd6b5b84bfc63f159c9b",
      "word_count": 8
    },
    {
      "text": "Prefer task-specific controls within the screens they affect",
      "section_path": [
        "Settings",
        "Task-specific options"
      ],
      "source_sentence_hash": "de755fc3fa5e28d8046ba2c593234cf4f61fd8aa05f7357325986721b0498d08",
      "word_count": 8
    },
    {
      "text": "Minimize system Settings entries to rarely changed options",
      "section_path": [
        "Settings",
        "System settings"
      ],
      "source_sentence_hash": "05594457597c8e0684c0f1320c19ba130e0b9a4ba59eab1fbf1c366653076778",
      "word_count": 8
    },
    {
      "text": "Include a settings item in the App menu",
      "section_path": [
        "Settings",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "61e2ee24788be042c4f350fc5d46d83adfb9bfaf1b8ac5bb70b78ee0db094cc0",
      "word_count": 8
    },
    {
      "text": "Dim a settings window’s minimize and maximize buttons",
      "section_path": [
        "Settings",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "9511758eeb17905f77a81b431705b45aebbbf3c1dc86980697de960a33f273c0",
      "word_count": 8
    },
    {
      "text": "In your settings window, use a noncustomizable toolbar that remains visible and always indicates the active toolbar button",
      "section_path": [
        "Settings",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "9c35c414ba86683718bb89f2051363568bf90b27234bad534414e102c5dbe91f",
      "word_count": 18
    },
    {
      "text": "Update the window’s title to reflect the currently visible pane",
      "section_path": [
        "Settings",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "36a49bc371fe9a9d4dad60bc2311cc8371d70f236b88982e1d6d674891794191",
      "word_count": 10
    },
    {
      "text": "Restore the most recently viewed pane",
      "section_path": [
        "Settings",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "30b8650c6c32fa9e28051b968ba4f49a491cd0cd2380bef9111edd83a013611f",
      "word_count": 6
    },
    {
      "text": "Avoid adding settings buttons to a macOS window toolbar",
      "section_path": [
        "Settings",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "61e2ee24788be042c4f350fc5d46d83adfb9bfaf1b8ac5bb70b78ee0db094cc0",
      "word_count": 9
    },
    {
      "text": "Place document-level settings in the macOS File menu",
      "section_path": [
        "Settings",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "61e2ee24788be042c4f350fc5d46d83adfb9bfaf1b8ac5bb70b78ee0db094cc0",
      "word_count": 8
    },
    {
      "text": "Keep macOS settings-window minimize and maximize buttons dimmed",
      "section_path": [
        "Settings",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "9511758eeb17905f77a81b431705b45aebbbf3c1dc86980697de960a33f273c0",
      "word_count": 8
    },
    {
      "text": "Use a noncustomizable macOS settings toolbar",
      "section_path": [
        "Settings",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "9c35c414ba86683718bb89f2051363568bf90b27234bad534414e102c5dbe91f",
      "word_count": 6
    },
    {
      "text": "Keep the macOS settings toolbar visible",
      "section_path": [
        "Settings",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "9c35c414ba86683718bb89f2051363568bf90b27234bad534414e102c5dbe91f",
      "word_count": 6
    },
    {
      "text": "Always indicate the active macOS settings toolbar button",
      "section_path": [
        "Settings",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "9c35c414ba86683718bb89f2051363568bf90b27234bad534414e102c5dbe91f",
      "word_count": 8
    },
    {
      "text": "Keep the macOS settings window title aligned with the current pane",
      "section_path": [
        "Settings",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "36a49bc371fe9a9d4dad60bc2311cc8371d70f236b88982e1d6d674891794191",
      "word_count": 10
    },
    {
      "text": "Use App Name Settings as the title for a single-pane macOS settings window",
      "section_path": [
        "Settings",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "36a49bc371fe9a9d4dad60bc2311cc8371d70f236b88982e1d6d674891794191",
      "word_count": 13
    },
    {
      "text": "Use the most recently viewed macOS settings pane when reopening",
      "section_path": [
        "Settings",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "30b8650c6c32fa9e28051b968ba4f49a491cd0cd2380bef9111edd83a013611f",
      "word_count": 9
    },
    {
      "text": "Avoid relying on the watchOS Settings app for custom app settings",
      "section_path": [
        "Settings",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "9288f61cbdb279907a516b965e456b75812181612e52c4ad0e93031af225a865",
      "word_count": 10
    },
    {
      "text": "Consider exposing essential watchOS options at the bottom of the main view or in a More menu",
      "section_path": [
        "Settings",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "9288f61cbdb279907a516b965e456b75812181612e52c4ad0e93031af225a865",
      "word_count": 16
    },
    {
      "text": "Consider providing a direct button to system Settings",
      "section_path": [
        "Settings",
        "System settings"
      ],
      "source_sentence_hash": "05594457597c8e0684c0f1320c19ba130e0b9a4ba59eab1fbf1c366653076778",
      "word_count": 8
    },
    {
      "text": "Support Command-Comma for opening settings with a physical keyboard",
      "section_path": [
        "Settings",
        "Best practices"
      ],
      "source_sentence_hash": "8a5bf4e06a8d4b62b0e476e21ebf2456f2544433ef28d84961ec851075a4381d",
      "word_count": 9
    },
    {
      "text": "Support Escape for opening game settings with a physical keyboard",
      "section_path": [
        "Settings",
        "Best practices"
      ],
      "source_sentence_hash": "8a5bf4e06a8d4b62b0e476e21ebf2456f2544433ef28d84961ec851075a4381d",
      "word_count": 9
    },
    {
      "text": "Avoid redundant custom versions of systemwide settings",
      "section_path": [
        "Settings",
        "Best practices"
      ],
      "source_sentence_hash": "2d9202ecb106c6f83a6804ac52b46e1da33f39d7c990afcdad961ba5f99629ca",
      "word_count": 7
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Settings",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
