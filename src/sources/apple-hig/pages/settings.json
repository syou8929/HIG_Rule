  "guidance_candidates": [
    {
      "text": "Aim to provide default settings that give the best experience to the largest number of people",
      "section_path": [
        "Settings",
        "Best practices"
      ],
      "source_sentence_hash": "67c80a0a50c0ae4a3c7651cd2420dd55b2fffb069acafdadbdcbfb62ec7b98a5",
      "word_count": 16
    },
    {
      "text": "Minimize the number of settings you offer",
      "section_path": [
        "Settings",
        "Best practices"
      ],
      "source_sentence_hash": "345a76f2c26b963e66914bfe2e25524673f0f6e05e37f68871b43a592eeefca5",
      "word_count": 7
    },
    {
      "text": "Make settings available in ways people expect",
      "section_path": [
        "Settings",
        "Best practices"
      ],
      "source_sentence_hash": "58082b2ebc617e8413be02ea241821d85b7d32c5ceafd3cf0806bb45354bace9",
      "word_count": 7
    },
    {
      "text": "Avoid using settings to ask for setup information you can get in other ways",
      "section_path": [
        "Settings",
        "Best practices"
      ],
      "source_sentence_hash": "6e148e254071f90ea555207d1931603bb2818a1d50aa47c48b0294a7c6ea6461",
      "word_count": 14
    },
    {
      "text": "Respect people’s systemwide settings and avoid including redundant versions of them in your custom settings area",
      "section_path": [
        "Settings",
        "Best practices"
      ],
      "source_sentence_hash": "b7019a6e027d90125870097be3cfffa51998e6df7dedbbb9e2811f3e44998603",
      "word_count": 16
    },
    {
      "text": "Put general, infrequently changed settings in your custom settings area",
      "section_path": [
        "Settings",
        "General settings"
      ],
      "source_sentence_hash": "743d2eaffeb3360859b499e642943afbc32f9b4171999d1a54dc2469a5a81da8",
      "word_count": 10
    },
    {
      "text": "When possible, prefer letting people modify task-specific options without going to your settings area",
      "section_path": [
        "Settings",
        "Task-specific options"
      ],
      "source_sentence_hash": "056292d4820c021623a95d959f6dde7924af49aa6609663070439a96f11de4f4",
      "word_count": 14
    },
    {
      "text": "Add only the most rarely changed options to the system-provided Settings app",
      "section_path": [
        "Settings",
        "System settings"
      ],
      "source_sentence_hash": "d218fc3be81fec4387aafb85c4163129ca313301af190df799b5dd32276e7fb0",
      "word_count": 12
    },
    {
      "text": "Include a settings item in the App menu",
      "section_path": [
        "Settings",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "9cea21a79f2e1b22a845876c3603d3e859d1d7d27b4e1ddcc11e364345d90e73",
      "word_count": 8
    },
    {
      "text": "Dim a settings window’s minimize and maximize buttons",
      "section_path": [
        "Settings",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "f791a9a677875ecb0068dbea5fac2ae57eb9f2d7f4a38871d4bc0a50e81e40e6",
      "word_count": 8
    },
    {
      "text": "In your settings window, use a noncustomizable toolbar that remains visible and always indicates the active toolbar button",
      "section_path": [
        "Settings",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "6c5bcbed325ff2a9412a9c1e1ce607b4f98804ab1dabde7cb8d89e69cca98163",
      "word_count": 18
    },
    {
      "text": "Update the window’s title to reflect the currently visible pane",
      "section_path": [
        "Settings",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "19478db0b11733cd9c5386e553f2283b3ab3c8ef5cafe443b91f8a5d017a70c0",
      "word_count": 10
    },
    {
      "text": "Restore the most recently viewed pane",
      "section_path": [
        "Settings",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "0ef9f9643b84285f539aaffd581bdd44cd94a81e01f63645f1702f4a99346195",
      "word_count": 6
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Settings",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
