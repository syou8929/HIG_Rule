  "guidance_candidates": [
    {
      "text": "Use a pop-up button to present a flat list of mutually exclusive options or states",
      "section_path": [
        "Pop-up buttons",
        "Best practices"
      ],
      "source_sentence_hash": "790631d5bac02102e7d461fd77a5229d7c8b713368f8489668cf4e6e338e847d",
      "word_count": 15
    },
    {
      "text": "Offer a list of actions",
      "section_path": [
        "Pop-up buttons",
        "Best practices"
      ],
      "source_sentence_hash": "c727a0d622ae6c9800b783fc02bf467371a0aa7b36396d7213e57b79e040bbb3",
      "word_count": 5
    },
    {
      "text": "Let people select multiple items",
      "section_path": [
        "Pop-up buttons",
        "Best practices"
      ],
      "source_sentence_hash": "25b2797e45b8b290aeddae9e7422628bf9952bd37b56a257c8cfe447778eb4d5",
      "word_count": 5
    },
    {
      "text": "Include a submenu",
      "section_path": [
        "Pop-up buttons",
        "Best practices"
      ],
      "source_sentence_hash": "7206d1227b8eee7203b7a50d959de535e58e19b09ba783feb115fc047f117e57",
      "word_count": 3
    },
    {
      "text": "Provide a useful default selection",
      "section_path": [
        "Pop-up buttons",
        "Best practices"
      ],
      "source_sentence_hash": "05f63efb7b8002e72977ffdc5766f4ba27c0fccd5d547ad591dbcaf7b144f2d3",
      "word_count": 5
    },
    {
      "text": "Give people a way to predict a pop-up button’s options without opening it",
      "section_path": [
        "Pop-up buttons",
        "Best practices"
      ],
      "source_sentence_hash": "49d2ce3f8880368d9a18732d24ca40ad5c2db69a7242ee54309272adc8f7b130",
      "word_count": 13
    },
    {
      "text": "Consider using a pop-up button when space is limited and you don’t need to display all options all the",
      "section_path": [
        "Pop-up buttons",
        "Best practices"
      ],
      "source_sentence_hash": "df3d0431cd71b155b4a3ae2d1a0252f9c4e0c011b60a84037683f98802de0a77",
      "word_count": 19
    },
    {
      "text": "If necessary, include a Custom option in a pop-up button’s menu to provide additional items that are useful in",
      "section_path": [
        "Pop-up buttons",
        "Best practices"
      ],
      "source_sentence_hash": "71dc99250917b36f7e1d7e1f0dba519dc498e66895d8ba19c528ef0905b4d3e2",
      "word_count": 19
    },
    {
      "text": "Avoid using pop-up buttons on tvOS or watchOS",
      "section_path": [
        "Pop-up buttons",
        "Platform considerations"
      ],
      "source_sentence_hash": "55e045ddf6a583adc9d776fb5701cd92bb92ac48561315500934a52e2c4f84fd",
      "word_count": 8
    },
    {
      "text": "Within a popover or modal view, consider using a pop-up button instead of a disclosure indicator to present multiple",
      "section_path": [
        "Pop-up buttons",
        "Platform considerations",
        "iPadOS"
      ],
