  "guidance_candidates": [
    {
      "text": "Prefer clearly defined edges in foreground layers",
      "section_path": [
        "App icons",
        "Layer design"
      ],
      "source_sentence_hash": "bfaefdd3a872686e12f3f36aeb084b9dc2468b3de3fefde6ac1704836a69f350",
      "word_count": 7
    },
    {
      "text": "Vary opacity in foreground layers to increase the sense of depth and liveliness",
      "section_path": [
        "App icons",
        "Layer design"
      ],
      "source_sentence_hash": "4e46d2dd11aca0178b0f5ed60ff133de532e823d66f12dbb80a7b1496c9b8190",
      "word_count": 13
    },
    {
      "text": "Design a background that both stands out and emphasizes foreground content",
      "section_path": [
        "App icons",
        "Layer design"
      ],
      "source_sentence_hash": "f304836da3258908c4c306e8c0f59110f82084e56454b4d883b704dd59df79fb",
      "word_count": 11
    },
    {
      "text": "Prefer vector graphics when bringing layers into Icon Composer",
      "section_path": [
        "App icons",
        "Layer design"
      ],
      "source_sentence_hash": "cfe200618b36ca85fdb15dda73c270d50a74411d02deab3d19e3a8b4aa24407a",
      "word_count": 9
    },
    {
      "text": "Produce appropriately shaped, unmasked layers",
      "section_path": [
        "App icons",
        "Icon shape"
      ],
      "source_sentence_hash": "df94be6871809219013096f40decd825c37dde32449e0bedd96f73382f6ab5bb",
      "word_count": 5
    },
    {
      "text": "Keep primary content centered to avoid truncation when the system adjusts corners or applies masking",
      "section_path": [
        "App icons",
        "Icon shape"
      ],
      "source_sentence_hash": "823008fb72795b6ca860933d5fecee3885cc4f08ad1b8da2174ff663c239b1cb",
      "word_count": 15
    },
    {
      "text": "Provide a visually consistent icon design across all the platforms your app supports",
      "section_path": [
        "App icons",
        "Design"
      ],
      "source_sentence_hash": "c13d9fc2ed5c5d00d1b2ec2e808605ab0065187504a37edb32e1c1383f195f6c",
      "word_count": 13
    },
    {
      "text": "Consider basing your icon design around filled, overlapping shapes",
      "section_path": [
        "App icons",
        "Design"
      ],
      "source_sentence_hash": "a2f0a96eb7c3d1517c5e6739c06c6c0d77b9bea3070bd30c70864aafcd11957b",
      "word_count": 9
    },
    {
      "text": "Include text only when it’s essential to your experience or brand",
      "section_path": [
        "App icons",
        "Design"
      ],
      "source_sentence_hash": "4c0f62073ec801cd09915f50ea33a2166217e06488543874bafb7aea85a303f1",
      "word_count": 11
    },
    {
      "text": "Prefer illustrations to photos and avoid replicating UI components",
      "section_path": [
        "App icons",
        "Design"
      ],
      "source_sentence_hash": "afbacb43c3227e2dbaff31c06074ff8f99cd591981471e8ea97ad23a94086b1d",
      "word_count": 9
    },
    {
      "text": "Don’t use replicas of Apple hardware products",
      "section_path": [
        "App icons",
        "Design"
      ],
      "source_sentence_hash": "93509acad4fd1e6a778ceaf08dc912b674819c9937bedf068c5a75eade853352",
      "word_count": 7
    },
    {
      "text": "Let the system handle blurring and other visual effects",
      "section_path": [
        "App icons",
        "Visual effects"
      ],
      "source_sentence_hash": "89c24fbd194df482f66380e319d32216d7350eeecf72132877de63bc670a35bf",
      "word_count": 9
    },
    {
      "text": "Create layer groupings to apply effects to multiple layers at once",
      "section_path": [
        "App icons",
        "Visual effects"
      ],
      "source_sentence_hash": "53894ec5ea6cbfb15cbb37cedc8e6068c142a13fc3a414e669086c07e08506c7",
      "word_count": 11
    },
    {
      "text": "Keep your icon’s features consistent across appearances",
      "section_path": [
        "App icons",
        "Appearances"
      ],
      "source_sentence_hash": "c4c76ce469f92dcc12b16d72b660097013f7ef7676a3c9dc59b78e59b5d3a6a5",
      "word_count": 7
    },
    {
      "text": "Design dark and tinted icons that feel at home beside system app icons and widgets",
      "section_path": [
        "App icons",
        "Appearances"
      ],
      "source_sentence_hash": "9bf88057772872c457a98f2e1b3457965123cc5dba04dcb48e5d5ca7b4de3c64",
      "word_count": 15
    },
    {
      "text": "Use your light app icon as the basis for your dark icon",
      "section_path": [
        "App icons",
        "Appearances"
      ],
      "source_sentence_hash": "0e203baea4123cc14a652e80aaff7dc643b6a087af933631ad95a2462f66f92d",
      "word_count": 12
    },
    {
      "text": "Consider offering alternate app icons",
      "section_path": [
        "App icons",
        "Appearances"
      ],
      "source_sentence_hash": "d860c66c35273f8a5117bc61b4ba494482805aee4770e1534db3c5526b1226d4",
      "word_count": 5
    },
    {
      "text": "Include a safe zone to ensure the system doesn’t crop your content",
      "section_path": [
        "App icons",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "4700501817fbff636865e0a19ed5c875fd13cf5dda5213ec8c291b488cbf9852",
      "word_count": 12
    },
    {
      "text": "Avoid adding a shape that’s intended to look like a hole or concave area to the background layer",
      "section_path": [
        "App icons",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "446d38ecb38275777a0c881e6cf8cc2b0738445672503d5a3141a3e6bcdef66c",
      "word_count": 18
    },
    {
      "text": "Avoid using black for your icon’s background",
      "section_path": [
        "App icons",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "a95a74c0f496dacca17d3b65dfea2def7f1ee29a84066c957bb07ce0c7fa1a05",
      "word_count": 7
    },
    {
      "text": "sRGB (color)",
      "section_path": [
        "App icons",
        "Specifications"
      ],
      "source_sentence_hash": "bb0ba248b7e8bc2be6838a80b6664cabfb56d6967efd765436bab870c57fe4bb",
      "word_count": 2
    },
    {
      "text": "Gray Gamma 2.2 (grayscale)",
      "section_path": [
        "App icons",
        "Specifications"
      ],
      "source_sentence_hash": "4ae6687bca102046033c56d7d3a690204a7584e0e7595f19b648c6fcb51856b5",
      "word_count": 4
    },
    {
      "text": "Display P3 (wide-gamut color in iOS, iPadOS, macOS, tvOS, and watchOS only)",
      "section_path": [
        "App icons",
        "Specifications"
      ],
      "source_sentence_hash": "e928bdbf1747d46bd1cac6718eafa9a8e3b382f0b81c353c6b1f20fd67f0bbbb",
      "word_count": 12
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "App icons",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
