  "guidance_candidates": [
    {
      "text": "Minimize launch time before people can interact",
      "section_path": [
        "Launching",
        "Best practices"
      ],
      "source_sentence_hash": "d0d8fbd0ab5c825feff546e6b06c8e10675345348e7df0c380b0ed0950831ea2",
      "word_count": 7
    },
    {
      "text": "Ensure required platforms have a launch screen",
      "section_path": [
        "Launching",
        "Best practices"
      ],
      "source_sentence_hash": "387a6f90181e3bdefe07e71b9f9c7d415c688bda7d2bda047b64a124150ec60e",
      "word_count": 7
    },
    {
      "text": "If you need a splash screen, consider displaying it at the beginning of your onboarding flow",
      "section_path": [
        "Launching",
        "Best practices"
      ],
      "source_sentence_hash": "d86271c7ed6cb95d560023166f6b96f996f21ae6ed8f068646d4c1b3fbd7c214",
      "word_count": 16
    },
    {
      "text": "Preserve the previous state across app restarts",
      "section_path": [
        "Launching",
        "Best practices"
      ],
      "source_sentence_hash": "44edea1b68cb87e93cb079b0d39324727875ac9977105693a3ccbc6524b2a057",
      "word_count": 7
    },
    {
      "text": "Minimize the prominence of the launch experience",
      "section_path": [
        "Launching",
        "Launch screens"
      ],
      "source_sentence_hash": "287c2eb455a6349eca24950f34efa1f46ddd2c0a598815b0fd683b103d46e770",
      "word_count": 7
    },
    {
      "text": "Design a launch screen that’s nearly identical to the first screen of your app or game",
      "section_path": [
        "Launching",
        "Launch screens"
      ],
      "source_sentence_hash": "8ca732d7d7717dd58cb239c94fa31ff4864f5ab06519ebd4fe2152d003fbb577",
      "word_count": 16
    },
    {
      "text": "Avoid including text on your launch screen, even if your first screen displays text",
      "section_path": [
        "Launching",
        "Launch screens"
      ],
      "source_sentence_hash": "6def484b6d07547821b09365204f6f84497c13629d17bb4777f456abd0ed7ecb",
      "word_count": 14
    },
    {
      "text": "Don’t advertise",
      "section_path": [
        "Launching",
        "Launch screens"
      ],
      "source_sentence_hash": "21e0c33674ed6333b133ca172e078e232c8d287e219e61ab67b34e0c20516240",
      "word_count": 2
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "Launching",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "Use the appropriate orientation at launch",
      "section_path": [
        "Launching",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "2003c799ef390f2be016bbf799afea8dc766ba220b6b01cf47397a745ff16919",
      "word_count": 6
    },
    {
      "text": "Consider automatically starting playback in a tvOS live-viewing app",
      "section_path": [
        "Launching",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "373dce396a8684db1af332b9c1f617e00dd8a1b529315702dcf7035fd3ef9901",
      "word_count": 9
    },
    {
      "text": "Consider launching in the Shared Space even if your app is fully immersive",
      "section_path": [
        "Launching",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "75e60cfc2e7e3a298cf4131423f4ac67cba3d6cce75e5d4e7bda5b83e23add1a",
      "word_count": 13
    },
    {
      "text": "Avoid making people retrace steps after an app restart",
      "section_path": [
        "Launching",
        "Best practices"
      ],
      "source_sentence_hash": "ecce034c148583982cba3e452394ed7835605fa6701ed16c2bb66b955b6e865c",
      "word_count": 9
    },
    {
      "text": "Make sure the launch screen matches the current orientation and appearance mode",
      "section_path": [
        "Launching",
        "Launch screens"
      ],
      "source_sentence_hash": "7f519ddba4d74e6e8c3bac3c1959336c8c1164848bb561c9d3c329932383c34b",
      "word_count": 12
    },
    {
      "text": "Avoid making a launch screen resemble a splash screen or About window",
      "section_path": [
        "Launching",
        "Launch screens"
      ],
      "source_sentence_hash": "aaa434d5ad47d0c5d3fb90f250f794adb59d3be784989dd43783155e61004890",
      "word_count": 12
    },
    {
      "text": "Don’t include branding unless it is a fixed part of the first screen",
      "section_path": [
        "Launching",
        "Launch screens"
      ],
      "source_sentence_hash": "aaa434d5ad47d0c5d3fb90f250f794adb59d3be784989dd43783155e61004890",
      "word_count": 13
    },
    {
      "text": "Ensure landscape-only interfaces respond correctly after either left or right rotation",
      "section_path": [
        "Launching",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "99e7ff0f7effa42444b245b8fbf9f5f3723987be6701d1477aec11ea3e700350",
      "word_count": 11
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Launching",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
