  "guidance_candidates": [
    {
      "text": "Use a Display Only request for visual identity confirmation in system-provided UI",
      "section_path": ["ID Verifier"],
      "source_sentence_hash": "58bd689da1124b35955b9566d021ed1e7b6d0d62a089548590c588c829358ac8",
      "word_count": 12
    },
    {
      "text": "Use a Data Transfer request only for legal verification that requires storing or processing identity information",
      "section_path": ["ID Verifier"],
      "source_sentence_hash": "cdf6572078321b4aa9ef759287a3268df7163ac70630eac601b0483d28b1e5cf",
      "word_count": 15
    },
    {
      "text": "You must request an additional entitlement for a Data Transfer request",
      "section_path": ["ID Verifier"],
      "source_sentence_hash": "cdf6572078321b4aa9ef759287a3268df7163ac70630eac601b0483d28b1e5cf",
      "word_count": 11
    },
    {
      "text": "Ask only for the data you need",
      "section_path": ["ID Verifier", "Best practices"],
      "source_sentence_hash": "2fc254cd847ed7d58996d8f80a25d8efa9b82dbb0684ed0892eb0c8380313c13",
      "word_count": 7
    },
    {
      "text": "Use an age-threshold request to verify a minimum age",
      "section_path": ["ID Verifier", "Best practices"],
      "source_sentence_hash": "2fc254cd847ed7d58996d8f80a25d8efa9b82dbb0684ed0892eb0c8380313c13",
      "word_count": 9
    },
    {
      "text": "Avoid requesting a customer’s current age or birth date",
      "section_path": ["ID Verifier", "Best practices"],
      "source_sentence_hash": "2fc254cd847ed7d58996d8f80a25d8efa9b82dbb0684ed0892eb0c8380313c13",
      "word_count": 9
    },
    {
      "text": "Use Apple Business Register to register qualifying apps for ID Verifier",
      "section_path": ["ID Verifier", "Best practices"],
      "source_sentence_hash": "86a92fd550898e87ceebc06a77372a1dc60e1ed5fd7848a03e8b23fbc9ffed38",
      "word_count": 11
    },
    {
      "text": "Provide a button that initiates the verification process",
      "section_path": ["ID Verifier", "Best practices"],
      "source_sentence_hash": "89039226c1ec20874a31bc04333f8e209ff1b4dd90e1c8567802f5edd0cc2306",
      "word_count": 8
    },
    {
      "text": "Use Verify Age for simple checks and Verify Identity for detailed requests",
      "section_path": ["ID Verifier", "Best practices"],
      "source_sentence_hash": "89039226c1ec20874a31bc04333f8e209ff1b4dd90e1c8567802f5edd0cc2306",
      "word_count": 12
    },
    {
      "text": "Avoid symbols that imply a communication type, such as NFC or QR codes",
      "section_path": ["ID Verifier", "Best practices"],
      "source_sentence_hash": "89039226c1ec20874a31bc04333f8e209ff1b4dd90e1c8567802f5edd0cc2306",
      "word_count": 13
    },
    {
      "text": "Never include the Apple logo in any button label",
      "section_path": ["ID Verifier", "Best practices"],
      "source_sentence_hash": "89039226c1ec20874a31bc04333f8e209ff1b4dd90e1c8567802f5edd0cc2306",
      "word_count": 9
    },
    {
      "text": "In a Display Only request, help the requester provide visual-confirmation feedback",
      "section_path": ["ID Verifier", "Best practices"],
      "source_sentence_hash": "1e11f87c063afb410de50a40a7367279ef92247650937656ec4c7ceec04b4993",
      "word_count": 11
    },
    {
      "text": "Avoid using ID Verifier outside iOS because other Apple platforms do not support it",
      "section_path": ["ID Verifier", "Platform considerations"],
      "source_sentence_hash": "5ca98e17306fffc7a1087a73054c392a39a5aee13720278cea069e2bb56371a5",
      "word_count": 14
    }
  ],
