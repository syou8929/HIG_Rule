  "guidance_candidates": [
    {
      "text": "Live-viewing apps need to elevate and prioritize live content",
      "section_path": [
        "Live-viewing apps"
      ],
      "source_sentence_hash": "e9bab8acc933813ca60c24b4bfe769961da665b2739a3275918da3cab01d95da",
      "word_count": 9
    },
    {
      "text": "In every screen, draw people’s attention to live content",
      "section_path": [
        "Live-viewing apps"
      ],
      "source_sentence_hash": "69d6dda79d6d4a430afca1876e45ef29ec8b472fcbaa754659b87121bd5e72aa",
      "word_count": 9
    },
    {
      "text": "Make sure they can distinguish it from video-on-demand (VOD) content at a glance",
      "section_path": [
        "Live-viewing apps"
      ],
      "source_sentence_hash": "69d6dda79d6d4a430afca1876e45ef29ec8b472fcbaa754659b87121bd5e72aa",
      "word_count": 13
    },
    {
      "text": "Feature live content prominently and make it easy to access",
      "section_path": [
        "Live-viewing apps",
        "Best practices"
      ],
      "source_sentence_hash": "37cb3656ead46c14082619bd05e83c1e8dd302938e988375b764f7c1d5f595f1",
      "word_count": 10
    },
    {
      "text": "Let people tap once — or not at all — to start playback",
      "section_path": [
        "Live-viewing apps",
        "Best practices"
      ],
      "source_sentence_hash": "4279758234c5e1dd8e0a8dc10e40448803068886ff6645342b4357163b3a7ba5",
      "word_count": 13
    },
    {
      "text": "Make sure live content looks live",
      "section_path": [
        "Live-viewing apps",
        "Best practices"
      ],
      "source_sentence_hash": "5dd7a4f5abe8dc9bb975486cc3aff56446917d8cb08dbdac9b14ed9c6f94bfbd",
      "word_count": 6
    },
    {
      "text": "Consider indicating the progress of currently playing live content",
      "section_path": [
        "Live-viewing apps",
        "Best practices"
      ],
      "source_sentence_hash": "4f4bd9f762efff13c1f5c59d80cbd6b70501f69dfc49a872a562e35fea819ba6",
      "word_count": 9
    },
    {
      "text": "Give people additional actions and viewing alternatives",
      "section_path": [
        "Live-viewing apps",
        "Best practices"
      ],
      "source_sentence_hash": "b1c7e7bbd4eace493932ed71b19b8e5cbb8db542fe9d9932b6c1ecdb6db4d114",
      "word_count": 7
    },
    {
      "text": "Playback always needs to be the primary action",
      "section_path": [
        "Live-viewing apps",
        "Best practices"
      ],
      "source_sentence_hash": "68a22d990e6d6bd12eb3d822f8b28821a865679faa2b794020d4a21a453c5f49",
      "word_count": 8
    },
    {
      "text": "Display these actions in the same order throughout your app",
      "section_path": [
        "Live-viewing apps",
        "Best practices"
      ],
      "source_sentence_hash": "785e730f1440a1ac752950ed364da70a7b85eb0e3dae3f8439881537773949ac",
      "word_count": 10
    },
    {
      "text": "Show this information so that people can schedule their viewing",
      "section_path": [
        "Live-viewing apps",
        "Best practices"
      ],
      "source_sentence_hash": "bc97c682f57889b6e829de08e61eb839bade9cac80bd0b5cbfea8e4b3b96ba92",
      "word_count": 10
    },
    {
      "text": "Consider using a content footer for browsing channels during playback",
      "section_path": [
        "Live-viewing apps",
        "Best practices"
      ],
      "source_sentence_hash": "a75e42f30887e2fa05cfb8cd87895c0b1c81cfcb0534fb48ee3da29103475d73",
      "word_count": 10
    },
    {
      "text": "Give it a subtle treatment, such as a darkening, to keep text legible and help all items remain visually",
      "section_path": [
        "Live-viewing apps",
        "Best practices"
      ],
      "source_sentence_hash": "a8d898d0348baa96cb77f543ec3f5f1a9ff298db6b0ee9bd1629a85881fb8b75",
      "word_count": 19
    },
    {
      "text": "Make it easy for people to identify the thumbnail that represents the currently playing content by, for example, badging",
      "section_path": [
        "Live-viewing apps",
        "Best practices"
      ],
      "source_sentence_hash": "7d1d2f1e316d1164fb42eed0c703f783a7bc1c72a624410811d720d4acc82bbe",
      "word_count": 19
    },
    {
      "text": "Match the categories in the content footer to those in your electronic program guide (for related guidance, see EPG",
      "section_path": [
        "Live-viewing apps",
        "Best practices"
      ],
      "source_sentence_hash": "0dbfdef98426e352ce6cb4ecbbf0880c58b5122e1b1b1bbe4a201d3a5b7e5fff",
      "word_count": 19
    },
    {
      "text": "Design a simple, predictable way for people to invoke and dismiss the content footer — for example, if swiping",
      "section_path": [
        "Live-viewing apps",
        "Best practices"
      ],
      "source_sentence_hash": "e5eb5b06abd91a31d3900abac738f8b37cd1521626eb17d237fa96efc2a6f2d8",
      "word_count": 19
    },
    {
      "text": "Provide instant visual feedback when people change channels",
      "section_path": [
        "Live-viewing apps",
        "Best practices"
      ],
      "source_sentence_hash": "6ed45737015acbd9fd18340c213db0794952dbca2a1390bc12ac154de21792a2",
      "word_count": 8
    },
    {
      "text": "Match audio to the current context",
      "section_path": [
        "Live-viewing apps",
        "Best practices"
      ],
      "source_sentence_hash": "e3e4053e6fee8e0c219ad133cb2fe7aa22ca72f8fed00daf41857b927bebd2a1",
      "word_count": 6
    },
    {
      "text": "Audio needs to stop",
      "section_path": [
        "Live-viewing apps",
        "Best practices"
      ],
      "source_sentence_hash": "cc4094bedc96436b61982c3ef93326366fb7285d9690a2a83060af8085af59b6",
      "word_count": 4
    },
    {
      "text": "Prominently display current information and make it easy to return to playback",
      "section_path": [
        "Live-viewing apps",
        "EPG experience"
      ],
      "source_sentence_hash": "4471a5dcc401b05b0ed725cdb4ad50df4a22d7356822b99e3c0dd686d746929d",
      "word_count": 12
    },
    {
      "text": "Make browsing the EPG effortless",
      "section_path": [
        "Live-viewing apps",
        "EPG experience"
      ],
      "source_sentence_hash": "7753a0c75da21f8375e0eb5c7b4dd7a157f330b18cc4d8d909d00ac7c482f143",
      "word_count": 5
    },
    {
      "text": "Consider providing a My Channels group or a Favorites group",
      "section_path": [
        "Live-viewing apps",
        "EPG experience"
      ],
      "source_sentence_hash": "a3e2b281fd4965987cf2360c22651685c0d8514af7589c3815bd2fac8b020643",
      "word_count": 10
    },
    {
      "text": "Group content into familiar categories to help people find it more easily",
      "section_path": [
        "Live-viewing apps",
        "EPG experience"
      ],
      "source_sentence_hash": "8ab8a4810c72831ce05fe9e76e60cf1e264b22676b7ed470a5e8ca40f8dc6068",
      "word_count": 12
    },
    {
      "text": "Let people browse the EPG without leaving their current content",
      "section_path": [
        "Live-viewing apps",
        "EPG experience"
      ],
      "source_sentence_hash": "38ab2d0ed220285f7e8d21d0814bb48a85cb0e3667983c02208d779ee181215b",
      "word_count": 10
    },
    {
      "text": "Let people start and stop recording from the info panel",
      "section_path": [
        "Live-viewing apps",
        "Cloud DVR"
      ],
      "source_sentence_hash": "496d241da9a2d53ba5dce488b091ebec0c534a315f8e630967f326208439dfb6",
      "word_count": 10
    },
    {
      "text": "Let people record a future program in a view that provides details about the content",
      "section_path": [
        "Live-viewing apps",
        "Cloud DVR"
      ],
      "source_sentence_hash": "872ce2eb4acfd4897c4632f258ae9bf18566c1ac3cfc2a6e15206f18fec1f6eb",
      "word_count": 15
    },
    {
      "text": "Give people the option to record only that program or all future episodes",
      "section_path": [
        "Live-viewing apps",
        "Cloud DVR"
      ],
      "source_sentence_hash": "e7e6d059425e17834832fc07aa72a54c754df77ed563c6ef4056a9fd966da29c",
      "word_count": 13
    },
    {
      "text": "Help people adapt the recording experience to their needs",
      "section_path": [
        "Live-viewing apps",
        "Cloud DVR"
      ],
      "source_sentence_hash": "98717e65bcb5b4757f195f6e839b7faccad14969f3ce5e0a299563404cad4298",
      "word_count": 9
    },
    {
      "text": "Allow playback and other content-specific actions within your cloud DVR area",
      "section_path": [
        "Live-viewing apps",
        "Cloud DVR"
      ],
      "source_sentence_hash": "27fd9cf743533c78f4e141edc4b80bc05f80d04d5041a0f2e675b0151ed126a2",
      "word_count": 11
    },
    {
      "text": "Consider offering a control that lets people manage cloud DVR settings",
      "section_path": [
        "Live-viewing apps",
        "Cloud DVR"
      ],
      "source_sentence_hash": "3386aaa6be75744e7a717b836e6de0c2961687451d7e15d88a6b1e7a19de81de",
      "word_count": 11
    },
    {
      "text": "Ideally, help people avoid running out of space by letting them set up automatic storage management",
      "section_path": [
        "Live-viewing apps",
        "Cloud DVR"
      ],
      "source_sentence_hash": "8f72c1c80f762c74afcee62ad0e402fbf1003865455fd39199f2330b8ce34e8d",
      "word_count": 15
    }
  ],
