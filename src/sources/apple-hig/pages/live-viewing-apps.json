  "guidance_candidates": [
    {
      "text": "Feature live content prominently and make it easy to access",
      "section_path": [
        "Live-viewing apps",
        "Best practices"
      ],
      "source_sentence_hash": "37cb3656ead46c14082619bd05e83c1e8dd302938e988375b764f7c1d5f595f1",
      "word_count": 10
    },
    {
      "text": "Let people tap once — or not at all — to start playback",
      "section_path": [
        "Live-viewing apps",
        "Best practices"
      ],
      "source_sentence_hash": "4279758234c5e1dd8e0a8dc10e40448803068886ff6645342b4357163b3a7ba5",
      "word_count": 13
    },
    {
      "text": "Make sure live content looks live",
      "section_path": [
        "Live-viewing apps",
        "Best practices"
      ],
      "source_sentence_hash": "5dd7a4f5abe8dc9bb975486cc3aff56446917d8cb08dbdac9b14ed9c6f94bfbd",
      "word_count": 6
    },
    {
      "text": "Consider indicating the progress of currently playing live content",
      "section_path": [
        "Live-viewing apps",
        "Best practices"
      ],
      "source_sentence_hash": "4f4bd9f762efff13c1f5c59d80cbd6b70501f69dfc49a872a562e35fea819ba6",
      "word_count": 9
    },
    {
      "text": "Give people additional actions and viewing alternatives",
      "section_path": [
        "Live-viewing apps",
        "Best practices"
      ],
      "source_sentence_hash": "b1c7e7bbd4eace493932ed71b19b8e5cbb8db542fe9d9932b6c1ecdb6db4d114",
      "word_count": 7
    },
    {
      "text": "Consider using a content footer for browsing channels during playback",
      "section_path": [
        "Live-viewing apps",
        "Best practices"
      ],
      "source_sentence_hash": "a75e42f30887e2fa05cfb8cd87895c0b1c81cfcb0534fb48ee3da29103475d73",
      "word_count": 10
    },
    {
      "text": "Provide instant visual feedback when people change channels",
      "section_path": [
        "Live-viewing apps",
        "Best practices"
      ],
      "source_sentence_hash": "6ed45737015acbd9fd18340c213db0794952dbca2a1390bc12ac154de21792a2",
      "word_count": 8
    },
    {
      "text": "Match audio to the current context",
      "section_path": [
        "Live-viewing apps",
        "Best practices"
      ],
      "source_sentence_hash": "e3e4053e6fee8e0c219ad133cb2fe7aa22ca72f8fed00daf41857b927bebd2a1",
      "word_count": 6
    },
    {
      "text": "Prominently display current information and make it easy to return to playback",
      "section_path": [
        "Live-viewing apps",
        "EPG experience"
      ],
      "source_sentence_hash": "4471a5dcc401b05b0ed725cdb4ad50df4a22d7356822b99e3c0dd686d746929d",
      "word_count": 12
    },
    {
      "text": "Make browsing the EPG effortless",
      "section_path": [
        "Live-viewing apps",
        "EPG experience"
      ],
      "source_sentence_hash": "7753a0c75da21f8375e0eb5c7b4dd7a157f330b18cc4d8d909d00ac7c482f143",
      "word_count": 5
    },
    {
      "text": "Group content into familiar categories to help people find it more easily",
      "section_path": [
        "Live-viewing apps",
        "EPG experience"
      ],
      "source_sentence_hash": "8ab8a4810c72831ce05fe9e76e60cf1e264b22676b7ed470a5e8ca40f8dc6068",
      "word_count": 12
    },
    {
      "text": "Let people browse the EPG without leaving their current content",
      "section_path": [
        "Live-viewing apps",
        "EPG experience"
      ],
      "source_sentence_hash": "38ab2d0ed220285f7e8d21d0814bb48a85cb0e3667983c02208d779ee181215b",
      "word_count": 10
    },
    {
      "text": "Let people start and stop recording from the info panel",
      "section_path": [
        "Live-viewing apps",
        "Cloud DVR"
      ],
      "source_sentence_hash": "496d241da9a2d53ba5dce488b091ebec0c534a315f8e630967f326208439dfb6",
      "word_count": 10
    },
    {
      "text": "Let people record a future program in a view that provides details about the content",
      "section_path": [
        "Live-viewing apps",
        "Cloud DVR"
      ],
      "source_sentence_hash": "872ce2eb4acfd4897c4632f258ae9bf18566c1ac3cfc2a6e15206f18fec1f6eb",
      "word_count": 15
    },
    {
      "text": "Help people adapt the recording experience to their needs",
      "section_path": [
        "Live-viewing apps",
        "Cloud DVR"
      ],
      "source_sentence_hash": "98717e65bcb5b4757f195f6e839b7faccad14969f3ce5e0a299563404cad4298",
      "word_count": 9
    },
    {
      "text": "Allow playback and other content-specific actions within your cloud DVR area",
      "section_path": [
        "Live-viewing apps",
        "Cloud DVR"
      ],
      "source_sentence_hash": "27fd9cf743533c78f4e141edc4b80bc05f80d04d5041a0f2e675b0151ed126a2",
      "word_count": 11
    },
    {
      "text": "Consider offering a control that lets people manage cloud DVR settings",
      "section_path": [
        "Live-viewing apps",
        "Cloud DVR"
      ],
      "source_sentence_hash": "3386aaa6be75744e7a717b836e6de0c2961687451d7e15d88a6b1e7a19de81de",
      "word_count": 11
    }
  ],
