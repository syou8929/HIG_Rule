  "guidance_candidates": [
    {
      "text": "If search is important, give it a primary position in your app or view",
      "section_path": [
        "Searching",
        "Best practices"
      ],
      "source_sentence_hash": "99bff7dca8cb75e9059930de19174a354741cc3e8f9843cd94591470786ebeea",
      "word_count": 14
    },
    {
      "text": "Aim to make your app’s content searchable through a single location",
      "section_path": [
        "Searching",
        "Best practices"
      ],
      "source_sentence_hash": "fed6b8ff6f8dd7aff4c19692d675d0dd86d5c620d06caf0fcd82d8790902f55a",
      "word_count": 11
    },
    {
      "text": "Clearly display the current scope of a search",
      "section_path": [
        "Searching",
        "Best practices"
      ],
      "source_sentence_hash": "7a40d5d3364a022273ff5f21ce09921572cf551c8d97647b61c58a349e586276",
      "word_count": 8
    },
    {
      "text": "Provide suggestions to make searching easier",
      "section_path": [
        "Searching",
        "Best practices"
      ],
      "source_sentence_hash": "0da935de7d7018193d46b8fa2e20745251664631416d9e1abd940d2036625018",
      "word_count": 6
    },
    {
      "text": "Take privacy into consideration before displaying search history",
      "section_path": [
        "Searching",
        "Best practices"
      ],
      "source_sentence_hash": "e23998668d71a086c0ba1025fdd0e273f2532da2646d4817f9fe973e8e3bfd02",
      "word_count": 8
    },
    {
      "text": "Provide a way for people to clear displayed search history",
      "section_path": [
        "Searching",
        "Best practices"
      ],
      "source_sentence_hash": "30bbb5ad3e07edb0165e75627b661ede1db2e8c089acbb7c1f7e5666566ada00",
      "word_count": 10
    },
    {
      "text": "Make your app’s content searchable in Spotlight",
      "section_path": [
        "Searching",
        "Systemwide search"
      ],
      "source_sentence_hash": "768226f323b6723dbd3e3d8f2d0788ff40ec00326b712826cd2f6e90e3db90df",
      "word_count": 7
    },
    {
      "text": "Define metadata for custom file types you handle",
      "section_path": [
        "Searching",
        "Systemwide search"
      ],
      "source_sentence_hash": "ef569fae391a29814796e018e820796e89816631476ab8036ad4d70bda85c175",
      "word_count": 8
    },
    {
      "text": "Use Spotlight to offer advanced file-search capabilities within the context of your app",
      "section_path": [
        "Searching",
        "Systemwide search"
      ],
      "source_sentence_hash": "8c3137424c68b6670fce0b7ae018300c635fa72469a11d928fa8a736d862cf9f",
      "word_count": 13
    },
    {
      "text": "Prefer using the system-provided open and save views",
      "section_path": [
        "Searching",
        "Systemwide search"
      ],
      "source_sentence_hash": "eb95d8f5efe4a33157dd6a5ac3852411c748c6cf166606a7ada02ca570748c0d",
      "word_count": 8
    },
    {
      "text": "Implement a Quick Look generator if your app produces custom file types",
      "section_path": [
