  "guidance_candidates": [
    {
      "text": "Let your app’s tasks inform the types of help people might need",
      "section_path": [
        "Offering help",
        "Best practices"
      ],
      "source_sentence_hash": "dd99827d09331d0f8d35676571642bd0b2fcb3dc7c2c70e0c97904a2c2bf81fe",
      "word_count": 12
    },
    {
      "text": "Use relevant and consistent language and images in your help content",
      "section_path": [
        "Offering help",
        "Best practices"
      ],
      "source_sentence_hash": "8d5bc780eea0cb91235f1353e922f3f1a09e9313a5c96c5b512d50e3f8306028",
      "word_count": 11
    },
    {
      "text": "Make sure all help content is inclusive",
      "section_path": [
        "Offering help",
        "Best practices"
      ],
      "source_sentence_hash": "536c1abcca40dc4a82b51e0e82fdf962849502653112fe17bc8f1e40b1d8e2fc",
      "word_count": 7
    },
    {
      "text": "Avoid bloating your help content by explaining how standard components or patterns work",
      "section_path": [
        "Offering help",
        "Best practices"
      ],
      "source_sentence_hash": "0f19da9ad622d131d873e88c449e5788ad4b72d99fed87097ad3a765f4c7c266",
      "word_count": 13
    },
    {
      "text": "Use the most appropriate tip type for your app’s user interface",
      "section_path": [
        "Offering help",
        "Creating tips"
      ],
      "source_sentence_hash": "e580d5d7e7b071ab7c08618c4b0d75d817707eaf1cb4d27eeee228103128cac5",
      "word_count": 11
    },
    {
      "text": "Use tips for simple features",
      "section_path": [
        "Offering help",
        "Creating tips"
      ],
      "source_sentence_hash": "22d6e47380613ca057577d2db6e85c7ab614a3176c2aa653ec451bd97f7a590c",
      "word_count": 5
    },
    {
      "text": "Make tips short, actionable, and engaging",
      "section_path": [
        "Offering help",
        "Creating tips"
      ],
      "source_sentence_hash": "f6aba93d729390cbb7a9aab199bf867647ecd6d688974c3c0588ad183f21d569",
      "word_count": 6
    },
    {
      "text": "Define rules to help ensure your tips reach the intended audience",
      "section_path": [
        "Offering help",
        "Creating tips"
      ],
      "source_sentence_hash": "992136ef5ba6f63a96cdc841845529d5202f33138b6ff7ab3ac4c7b9c2dc35d1",
      "word_count": 11
    },
    {
      "text": "Consider including a familiar image or symbol in a tip",
      "section_path": [
        "Offering help",
        "Creating tips"
      ],
      "source_sentence_hash": "fddcdcd4ed75531e5feb62d3ef151c48fa4a7743f3fa6f9a47bb46ec80f30942",
      "word_count": 10
    },
    {
      "text": "Use buttons to direct people to information or options",
      "section_path": [
        "Offering help",
        "Creating tips"
      ],
      "source_sentence_hash": "9cb7b9a57c78e1e95b19bfc995d4f79fd7212a019a8e3b2e7de4b59e8ff1400d",
      "word_count": 9
    },
    {
      "text": "macOS, visionOS",
      "section_path": [
        "Offering help",
        "Platform considerations",
        "macOS, visionOS"
      ],
      "source_sentence_hash": "9114d7b7c80d0902ab8ca7cb1c98091a4258540a7fa124d417fee89b8b1e0341",
      "word_count": 2
    },
    {
      "text": "Consider showing macOS tooltips when people hold the pointer over controls",
      "section_path": [
        "Offering help",
        "Platform considerations",
        "macOS, visionOS"
      ],
      "source_sentence_hash": "0611b2a5a65edfe7b31120f1a80b711858a2457e09c22264c002a46695972124",
      "word_count": 11
    },
    {
      "text": "Consider showing visionOS tooltips on gaze or pointer hover",
      "section_path": [
        "Offering help",
        "Platform considerations",
        "macOS, visionOS"
      ],
      "source_sentence_hash": "0611b2a5a65edfe7b31120f1a80b711858a2457e09c22264c002a46695972124",
      "word_count": 9
    },
    {
      "text": "Describe only the control that people indicate interest in",
      "section_path": [
        "Offering help",
        "Platform considerations",
        "macOS, visionOS"
      ],
      "source_sentence_hash": "4271b30736edd3f9e107b5f9fa5606db1ffbb5ff7d8ded603380e2149a21b98e",
      "word_count": 9
    },
    {
      "text": "Explain the action or task the control initiates",
      "section_path": [
        "Offering help",
        "Platform considerations",
        "macOS, visionOS"
      ],
      "source_sentence_hash": "da34a596560f0fe24c415468907dc677e0a487a7347dcf5d487829f743137355",
      "word_count": 8
    },
    {
      "text": "Describe the action or task a tooltip control initiates",
      "section_path": [
        "Offering help",
        "Platform considerations",
        "macOS, visionOS"
      ],
      "source_sentence_hash": "da34a596560f0fe24c415468907dc677e0a487a7347dcf5d487829f743137355",
      "word_count": 9
    },
    {
      "text": "Prefer beginning tooltip descriptions with a verb",
      "section_path": [
        "Offering help",
        "Platform considerations",
        "macOS, visionOS"
      ],
      "source_sentence_hash": "da34a596560f0fe24c415468907dc677e0a487a7347dcf5d487829f743137355",
      "word_count": 7
    },
    {
      "text": "In general, avoid repeating a control’s name in its tooltip",
      "section_path": [
        "Offering help",
        "Platform considerations",
        "macOS, visionOS"
      ],
      "source_sentence_hash": "3b545e26aa82838faad067992544e4567d18f2caa34ff402bf392312a917fb8e",
      "word_count": 10
    },
    {
      "text": "Be brief",
      "section_path": [
        "Offering help",
        "Platform considerations",
        "macOS, visionOS"
      ],
      "source_sentence_hash": "213c22ed7234eb11116e1e88f314c73cb3a019b5c87fe224b6ce5665bd9ec50e",
      "word_count": 2
    },
    {
      "text": "Keep tooltip content within 60 to 75 characters when possible",
      "section_path": [
        "Offering help",
        "Platform considerations",
        "macOS, visionOS"
      ],
      "source_sentence_hash": "213c22ed7234eb11116e1e88f314c73cb3a019b5c87fe224b6ce5665bd9ec50e",
      "word_count": 10
    },
    {
      "text": "Consider using sentence fragments for concise tooltips",
      "section_path": [
        "Offering help",
        "Platform considerations",
        "macOS, visionOS"
      ],
      "source_sentence_hash": "213c22ed7234eb11116e1e88f314c73cb3a019b5c87fe224b6ce5665bd9ec50e",
      "word_count": 7
    },
    {
      "text": "Consider omitting articles from concise tooltip text",
      "section_path": [
        "Offering help",
        "Platform considerations",
        "macOS, visionOS"
      ],
      "source_sentence_hash": "213c22ed7234eb11116e1e88f314c73cb3a019b5c87fe224b6ce5665bd9ec50e",
      "word_count": 7
    },
    {
      "text": "Consider simplifying controls that need verbose tooltip descriptions",
      "section_path": [
        "Offering help",
        "Platform considerations",
        "macOS, visionOS"
      ],
      "source_sentence_hash": "213c22ed7234eb11116e1e88f314c73cb3a019b5c87fe224b6ce5665bd9ec50e",
      "word_count": 8
    },
    {
      "text": "Use sentence case",
      "section_path": [
        "Offering help",
        "Platform considerations",
        "macOS, visionOS"
      ],
      "source_sentence_hash": "bf75a37e91c639bb2ddf31fc4c16f4fe33e4acab87623984be400b6bbc6b92fa",
      "word_count": 3
    },
    {
      "text": "Use no ending punctuation for complete tooltip sentences when style permits",
      "section_path": [
        "Offering help",
        "Platform considerations",
        "macOS, visionOS"
      ],
      "source_sentence_hash": "bf75a37e91c639bb2ddf31fc4c16f4fe33e4acab87623984be400b6bbc6b92fa",
      "word_count": 11
    },
    {
      "text": "Consider offering context-sensitive tooltips",
      "section_path": [
        "Offering help",
        "Platform considerations",
        "macOS, visionOS"
      ],
      "source_sentence_hash": "aafbaec1069c4ae9907cd861d0250f32f726b46b280204c551f6b73d592cf68c",
      "word_count": 4
    },
    {
      "text": "Keep help directly related to the current task",
      "section_path": [
        "Offering help",
        "Best practices"
      ],
      "source_sentence_hash": "ff041f9fb030ed26a9e771b1e0adbe1e08004bc562f7d56308d7a11efefa1d8b",
      "word_count": 8
    },
    {
      "text": "Keep contextual help easy to dismiss or avoid",
      "section_path": [
        "Offering help",
        "Best practices"
      ],
      "source_sentence_hash": "ff041f9fb030ed26a9e771b1e0adbe1e08004bc562f7d56308d7a11efefa1d8b",
      "word_count": 8
    },
    {
      "text": "Ensure help guidance is appropriate for the current context",
      "section_path": [
        "Offering help",
        "Best practices"
      ],
      "source_sentence_hash": "7794092625b200775350fc635632a73b98ac4f99f54d725f7b96034ce50cc892",
      "word_count": 9
    },
    {
      "text": "Ensure help terminology matches the current platform",
      "section_path": [
        "Offering help",
        "Best practices"
      ],
      "source_sentence_hash": "7794092625b200775350fc635632a73b98ac4f99f54d725f7b96034ce50cc892",
      "word_count": 7
    },
    {
      "text": "Use quick orientation for unique controls or nonstandard input",
      "section_path": [
        "Offering help",
        "Best practices"
      ],
      "source_sentence_hash": "0ba8a49ed88b806d94db0eec69b581c325b0246dc6a80c8fee35e2e520c06124",
      "word_count": 9
    },
    {
      "text": "Prefer animation or graphics over lengthy control explanations",
      "section_path": [
        "Offering help",
        "Best practices"
      ],
      "source_sentence_hash": "0ba8a49ed88b806d94db0eec69b581c325b0246dc6a80c8fee35e2e520c06124",
      "word_count": 8
    },
    {
      "text": "Use direct action-oriented language in tips",
      "section_path": [
        "Offering help",
        "Creating tips"
      ],
      "source_sentence_hash": "12e18fd477e28df5e2c456ce551c2267109f11274ded691c95122a55c248f44f",
      "word_count": 6
    },
    {
      "text": "Keep tips to one or two sentences",
      "section_path": [
        "Offering help",
        "Creating tips"
      ],
      "source_sentence_hash": "12e18fd477e28df5e2c456ce551c2267109f11274ded691c95122a55c248f44f",
      "word_count": 7
    },
    {
      "text": "Avoid promotional or unrelated content in tips",
      "section_path": [
        "Offering help",
        "Creating tips"
      ],
      "source_sentence_hash": "12e18fd477e28df5e2c456ce551c2267109f11274ded691c95122a55c248f44f",
      "word_count": 7
    },
    {
      "text": "Use a reasonable cadence when displaying multiple tips",
      "section_path": [
        "Offering help",
        "Creating tips"
      ],
      "source_sentence_hash": "7fc292c28fc9c50ffc3add9644739d5feb36071baa3233d4457348a4cfd5746a",
      "word_count": 8
    },
    {
      "text": "Prefer filled variants of familiar tip symbols",
      "section_path": [
        "Offering help",
        "Creating tips"
      ],
      "source_sentence_hash": "a18f5f4b4250cb42aec4672c69932b411bc920e987ea0007a805236c9462a297",
      "word_count": 7
    },
    {
      "text": "Avoid repeating a directly connected feature image in its tip",
      "section_path": [
        "Offering help",
        "Creating tips"
      ],
      "source_sentence_hash": "380c1372dac0d76041079d7ddbcf1b2a64bbca4ce3bff9499f464f54236265b5",
      "word_count": 10
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Offering help",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
