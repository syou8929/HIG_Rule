  "guidance_candidates": [
    {
      "text": "As much as possible, support drag and drop throughout your app",
      "section_path": [
        "Drag and drop",
        "Best practices"
      ],
      "source_sentence_hash": "f8a024e1ce7b3e066787c0e02d2a9dccc05482554b45254a8de92f56580a6f14",
      "word_count": 11
    },
    {
      "text": "Offer alternative ways to accomplish drag-and-drop actions",
      "section_path": [
        "Drag and drop",
        "Best practices"
      ],
      "source_sentence_hash": "1b22548e8b8e0f6528ec607add73a50d1f21328673c70bf6e7bcfae2c8f3ffae",
      "word_count": 7
    },
    {
      "text": "Determine when dragging and dropping content within your app results in a move or a copy",
      "section_path": [
        "Drag and drop",
        "Best practices"
      ],
      "source_sentence_hash": "37a3c34adaf62def3379ba7984611535422448003b590b83cee12b6051c3e1b3",
      "word_count": 16
    },
    {
      "text": "Support multi-item drag and drop when it makes sense",
      "section_path": [
        "Drag and drop",
        "Best practices"
      ],
      "source_sentence_hash": "0217031f1cb00b596358c8d86f6c83f66f0efad858b9795ebc6b0ab2d0fc801d",
      "word_count": 9
    },
    {
      "text": "Prefer letting people undo a drag-and-drop operation",
      "section_path": [
        "Drag and drop",
        "Best practices"
      ],
      "source_sentence_hash": "02d22959cf1097f8d3c5aef177140f3f5681b0206fad4cc13b2afe040e254b37",
      "word_count": 7
    },
    {
      "text": "Consider offering multiple versions of dragged content, ordered from highest to lowest fidelity",
      "section_path": [
        "Drag and drop",
        "Best practices"
      ],
      "source_sentence_hash": "6abf7db8c7bc8b53f3082521af382df9d45fd4740bbf90e6f7bfd2ed1e44a914",
      "word_count": 13
    },
    {
      "text": "Consider supporting spring loading",
      "section_path": [
        "Drag and drop",
        "Best practices"
      ],
      "source_sentence_hash": "b691d5abdf7dfb9bab0cfa6565f0e38dd1bed3947f1da3f13256f907c27a859b",
      "word_count": 4
    },
    {
      "text": "Display a drag image as soon as people drag a selection about three points",
      "section_path": [
        "Drag and drop",
        "Providing feedback"
      ],
      "source_sentence_hash": "a444c237d6ed9dbb20ae3cd6f758df5ade35c0ba00287593e118c3a74d715972",
      "word_count": 14
    },
    {
      "text": "If it adds clarity, modify the drag image to help people predict the result of a drag-and-drop operation",
      "section_path": [
        "Drag and drop",
        "Providing feedback"
      ],
      "source_sentence_hash": "de70ed14e8b6914c2511226ed3f995850fbe2ceeb4988a166a7a358fbcaed6ce",
      "word_count": 18
    },
    {
      "text": "Show people whether a destination can accept dragged content",
      "section_path": [
        "Drag and drop",
        "Providing feedback"
      ],
      "source_sentence_hash": "379a3090cd68d16e881e491ef588cc16ca6fc36cac2be7082a66c59c536b07b6",
      "word_count": 9
    },
    {
      "text": "When people drop an item on an invalid destination, or when dropping fails, provide visual feedback",
      "section_path": [
        "Drag and drop",
        "Providing feedback"
      ],
      "source_sentence_hash": "168c253998d054dfa4ee90ce6ce0549a727e4ee5f88ecf54ad8c6ff655a7d68a",
      "word_count": 16
    },
    {
      "text": "Scroll the contents of a destination when necessary",
      "section_path": [
        "Drag and drop",
        "Accepting drops"
      ],
      "source_sentence_hash": "010a3fad6bf20a4079fdfaf5647be3acbd5b4289efaad50a8d3662dfe7407967",
      "word_count": 8
    },
    {
      "text": "When there’s a choice, pick the richest version of dropped content your app can accept",
      "section_path": [
        "Drag and drop",
        "Accepting drops"
      ],
      "source_sentence_hash": "496db26677fd8d76ac72efd4012f576c9465a5d36ce334d106d17e49ff047e08",
      "word_count": 15
    },
    {
      "text": "Extract only the relevant portion of dropped content if necessary",
      "section_path": [
        "Drag and drop",
        "Accepting drops"
      ],
      "source_sentence_hash": "db79622a3d0926ff35b5d24cec78df356698be34a62971fc08fc3ddaf9ee47b3",
      "word_count": 10
    },
    {
      "text": "When a physical keyboard is attached, check for the Option key at drop time",
      "section_path": [
        "Drag and drop",
        "Accepting drops"
      ],
      "source_sentence_hash": "82b463ea695d0407a2c0c8ff9870b1e7f8781e72814aa518cd3dbe1d84409d37",
      "word_count": 14
    },
    {
      "text": "Provide feedback when dropped content needs time to transfer",
      "section_path": [
        "Drag and drop",
        "Accepting drops"
      ],
      "source_sentence_hash": "3c8b6afd5416ea284bc2b13c04146a0bb2ee50c0273994d566fcf760be1f6f08",
      "word_count": 9
    },
    {
      "text": "Provide feedback when dropped content initiates a task or action",
      "section_path": [
        "Drag and drop",
        "Accepting drops"
      ],
      "source_sentence_hash": "bfd2255d090be277927f7b70e609021d1da6c71af45e07d3e98799622bca96dd",
      "word_count": 10
    },
    {
      "text": "Apply appropriate styling to dropped text",
      "section_path": [
        "Drag and drop",
        "Accepting drops"
      ],
      "source_sentence_hash": "aded906ab053710cb90e2ce754c1d6293516292975cc450a27d553105f028df1",
      "word_count": 6
    },
    {
      "text": "After a drop, maintain the content’s selection state in the destination, updating it in the source as needed",
      "section_path": [
        "Drag and drop",
        "Accepting drops"
      ],
      "source_sentence_hash": "85817eb26f82641a023c32b9e252f5ae344cc2ed5e8b22d64346d33d5722580c",
      "word_count": 18
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "Drag and drop",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "Let people perform multiple simultaneous drag activities",
      "section_path": [
        "Drag and drop",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "af604ad054f436a84f786bc698a8e952c1391b20cc04d55f7f6823e2cf131b8f",
      "word_count": 7
    },
    {
      "text": "Consider letting people drag content from your app into the Finder",
      "section_path": [
        "Drag and drop",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "2365203a4cff0e05874b8b08b7b185343e595e0b2c5216cd1c9b210799b78295",
      "word_count": 11
    },
    {
      "text": "Let people drag selected content from an inactive window without first making the window active",
      "section_path": [
        "Drag and drop",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "c5066ac0f330f0f812e8c4f4a9d3432b49d753364639a01c3020f55e99e70c88",
      "word_count": 15
    },
    {
      "text": "When possible, let people drag individual items from an inactive window without affecting an existing background selection",
      "section_path": [
        "Drag and drop",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "dfcd958aa0e1baebd26d7c005bfc4c0815a6a3ee3a19c301dd114afb947d83d5",
      "word_count": 17
    },
    {
      "text": "Consider displaying a badge during multi-item drag operations",
      "section_path": [
        "Drag and drop",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "7468bd4b52b7ee225e1b9bcf63e5f86d75d9139650baac5a8e779121af4b6e52",
      "word_count": 8
    },
    {
      "text": "Consider changing the pointer appearance to indicate what will happen when people drop content",
      "section_path": [
        "Drag and drop",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "5fbc560faebb62bc76e2767307e933ade93d151994b694cf260d1a682c7249d4",
      "word_count": 14
    },
    {
      "text": "As much as possible, let people select and drag content with a single motion",
      "section_path": [
        "Drag and drop",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "0a0b8155a3c0ce45ba960db4a05f9443bd3ea94acde9528ffac26c260606feb6",
      "word_count": 14
    },
    {
      "text": "When possible, launch your app to handle content that people drop into empty space",
      "section_path": [
        "Drag and drop",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "5598072c43790d1b84a9cc529eefa211e6a2712ea4733e1b37bf8608317e5b4b",
      "word_count": 14
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Drag and drop",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
