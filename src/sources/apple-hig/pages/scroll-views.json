  "guidance_candidates": [
    {
      "text": "Support default scrolling gestures and keyboard shortcuts",
      "section_path": [
        "Scroll views",
        "Best practices"
      ],
      "source_sentence_hash": "d08d739dfda11f5701bcba348fb2a445b92460b067dea1f9f5a3ea8cd5c8b918",
      "word_count": 7
    },
    {
      "text": "Make it apparent when content is scrollable",
      "section_path": [
        "Scroll views",
        "Best practices"
      ],
      "source_sentence_hash": "96922240b8e386f6b93ce7b5036ceb35bfd69a9944fcc1c7577e6be97bdbd984",
      "word_count": 7
    },
    {
      "text": "Avoid putting a scroll view inside another scroll view with the same orientation",
      "section_path": [
        "Scroll views",
        "Best practices"
      ],
      "source_sentence_hash": "36dfeabdd42cc7a654f4e96609b66b8beb9de560ecc575f8050858bf8473a8cc",
      "word_count": 13
    },
    {
      "text": "Consider supporting page-by-page scrolling if it makes sense for your content",
      "section_path": [
        "Scroll views",
        "Best practices"
      ],
      "source_sentence_hash": "b998e3791cbd0ddaa80af3bf6bef40c47fafd9a502c24b5cdd20ed2900ad00d9",
      "word_count": 11
    },
    {
      "text": "In some cases, scroll automatically to help people find their place",
      "section_path": [
        "Scroll views",
        "Best practices"
      ],
      "source_sentence_hash": "bd13c8384c0a9c460065f08744ed453d8e776108b54ba67ca65900d1784e0510",
      "word_count": 11
    },
    {
      "text": "If you support zoom, set appropriate maximum and minimum scale values",
      "section_path": [
        "Scroll views",
        "Best practices"
      ],
      "source_sentence_hash": "35a37b0e6ec8b6acffeaaa9ac611b79e53c6fdf00ea591ed7d0ab034fdf78869",
      "word_count": 11
    },
    {
      "text": "Prefer the automatic scroll edge effect style",
      "section_path": [
        "Scroll views",
        "Scroll edge effects"
      ],
      "source_sentence_hash": "79a451545d9c401de499b774bcf434100335faca054ca3fd552a4a5195cfd0c6",
      "word_count": 7
    },
    {
      "text": "Only use a scroll edge effect when a scroll view is behind floating interface elements",
      "section_path": [
        "Scroll views",
        "Scroll edge effects"
      ],
      "source_sentence_hash": "33065075c2c7f1e81a14f4758f74c2463f38203d29647ff422533fa83b740c7f",
      "word_count": 15
    },
    {
      "text": "Apply one scroll edge effect per view",
      "section_path": [
        "Scroll views",
        "Scroll edge effects"
      ],
      "source_sentence_hash": "31adeb75fd256f7735b42031c32651bed92a01bf179d63ddaaf9d7cc6827b6b7",
      "word_count": 7
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "Scroll views",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "Consider showing a page control when a scroll view is in page-by-page mode",
      "section_path": [
        "Scroll views",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "d9cb9d67eb236e546e5bae61fe492c2481db281e1d363c15da3d834fb0dfb2ab",
      "word_count": 13
    },
    {
      "text": "If necessary, use small or mini scroll bars in a panel",
      "section_path": [
        "Scroll views",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "47c1e2e22bed97ab48d85b7ff50f181e6849b59e15768c7086a6cd1f2ed06d60",
      "word_count": 11
    },
    {
      "text": "If necessary, account for the size of the scroll indicator",
      "section_path": [
        "Scroll views",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "3bcc3099ad10e0b9a736505b7bff4e4a3848791cea466e4e321b2031a63d772a",
      "word_count": 10
    },
    {
      "text": "Look to Scroll",
      "section_path": [
        "Scroll views",
        "Platform considerations",
        "visionOS",
        "Look to Scroll"
      ],
      "source_sentence_hash": "855d811ee68a97361fdfd6499d664dcf2c0803a4e20666683469271e51c6b519",
      "word_count": 3
    },
    {
      "text": "Support Look to Scroll for reading or browsing views",
      "section_path": [
        "Scroll views",
        "Platform considerations",
        "visionOS",
        "Look to Scroll"
      ],
      "source_sentence_hash": "72be95c0effd699e3c7535832f3287c9e435b4ae9bcb4eff5600418d7d865efd",
      "word_count": 9
    },
    {
      "text": "Avoid using Look to Scroll for secondary content",
      "section_path": [
        "Scroll views",
        "Platform considerations",
        "visionOS",
        "Look to Scroll"
      ],
      "source_sentence_hash": "76f8036eec12d818103fd55c78e775e8dcc13ca0d5cae71954df5d80677c18f3",
      "word_count": 8
    },
    {
      "text": "Maintain consistency across content",
      "section_path": [
        "Scroll views",
        "Platform considerations",
        "visionOS",
        "Look to Scroll"
      ],
      "source_sentence_hash": "889324adc29bcb343028f2a74cd1a932cdbd2619a5d66205638fccd13a5ac46a",
      "word_count": 4
    },
    {
      "text": "Define clear scroll areas within your app",
      "section_path": [
        "Scroll views",
        "Platform considerations",
        "visionOS",
        "Look to Scroll"
      ],
      "source_sentence_hash": "092bd5390499c748478a9cbd64d192146cc4faf9f22e784f816d8688cc43bafa",
      "word_count": 7
    },
    {
      "text": "If your app uses custom scroll effects or animations, remove them before supporting Look to Scroll",
      "section_path": [
        "Scroll views",
        "Platform considerations",
        "visionOS",
        "Look to Scroll"
      ],
      "source_sentence_hash": "8dbfe8e3bc12036d3aadda4e54d9ce42ede2ec6b42f3bb706d5c91392d3e331b",
      "word_count": 16
    },
    {
      "text": "Prefer vertically scrolling content",
      "section_path": [
        "Scroll views",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "95facd27a1f425bf2677de6a48026a4549a32319a7826f9119b22333d110f434",
      "word_count": 4
    },
    {
      "text": "Use tab views to provide page-by-page scrolling",
      "section_path": [
        "Scroll views",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "4ca040301e9ab3a3edaa86276dc5767a4e7ada5ce13978c4ada42fce43b5f3d5",
      "word_count": 7
    },
    {
      "text": "When displaying paged content, consider limiting the content of an individual page to a single screen height",
      "section_path": [
        "Scroll views",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "466625e4f8391e57fd3f23e9fbb16d119dc717cf3b9f15e1394a4e9b1cf0c78e",
      "word_count": 17
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Scroll views",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
