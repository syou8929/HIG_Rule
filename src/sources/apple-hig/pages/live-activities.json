  "guidance_candidates": [
    {
      "text": "Lock Screen",
      "section_path": [
        "Live Activities",
        "Anatomy",
        "Lock Screen"
      ],
      "source_sentence_hash": "91a007b58b9d0df5028fb7f9ab554d553b66ac41aee357f2a609c90f6583d02d",
      "word_count": 2
    },
    {
      "text": "Offer Live Activities for tasks and events that have a defined beginning and end",
      "section_path": [
        "Live Activities",
        "Best practices"
      ],
      "source_sentence_hash": "0ed8956f209f1ca47a8627d78a55553dc9edf14b0625a956ef9f318152c3441b",
      "word_count": 14
    },
    {
      "text": "Focus on important information that people need to see at a glance",
      "section_path": [
        "Live Activities",
        "Best practices"
      ],
      "source_sentence_hash": "66e9baebb414d0631c58a16ca4ae951e513d37fd7308f07aef558bcbef8cb18b",
      "word_count": 12
    },
    {
      "text": "Don’t use a Live Activity to display ads or promotions",
      "section_path": [
        "Live Activities",
        "Best practices"
      ],
      "source_sentence_hash": "cc1f065cf6fa526360d2de70615c6dcdfbe9712e3c66afc6b50b9b704e588aae",
      "word_count": 10
    },
    {
      "text": "Avoid displaying sensitive information",
      "section_path": [
        "Live Activities",
        "Best practices"
      ],
      "source_sentence_hash": "adb74525ef0a906b68f4f22c342ced88a6fecec44bf861ec8bafbb9ee07e3f7f",
      "word_count": 4
    },
    {
      "text": "Create a Live Activity that matches your app’s visual aesthetic and personality in both dark and light appearances",
      "section_path": [
        "Live Activities",
        "Best practices"
      ],
      "source_sentence_hash": "49b8808da84365caefa237e25f09f0d99988efffab6c457bb39bb7396eaffedf",
      "word_count": 18
    },
    {
      "text": "If you include a logo mark, display it without a container",
      "section_path": [
        "Live Activities",
        "Best practices"
      ],
      "source_sentence_hash": "0567d0cd607fab48d99752c4e232d0d3f24887105b33078ab2578e2ef9b6e512",
      "word_count": 11
    },
    {
      "text": "Don’t add elements to your app that draw attention to the Dynamic Island",
      "section_path": [
        "Live Activities",
        "Best practices"
      ],
      "source_sentence_hash": "2f2e54af6450a465577183ce33723536bb704a73b4650eb8067b39ad26bdf6a7",
      "word_count": 13
    },
    {
      "text": "Ensure text is easy to read",
      "section_path": [
        "Live Activities",
        "Best practices"
      ],
      "source_sentence_hash": "1428aab8e2836fdc6416795e4fd5faa52c894bb56882883e1431e282e90e2dbf",
      "word_count": 6
    },
    {
      "text": "Creating Live Activity layouts",
      "section_path": [
        "Live Activities",
        "Best practices",
        "Creating Live Activity layouts"
      ],
      "source_sentence_hash": "c619f0c9ad996f8b3f053a82b6070cc86afbf1df037c46bf866621b94388a2da",
      "word_count": 4
    },
    {
      "text": "Adapt to different screen sizes and presentations",
      "section_path": [
        "Live Activities",
        "Best practices",
        "Creating Live Activity layouts"
      ],
      "source_sentence_hash": "0fb0a777a5c2639e66a7b6c93f425e4c7aadf30b51972a35b92ae1748c67d610",
      "word_count": 7
    },
    {
      "text": "Adjust element size and placement for efficient use of space",
      "section_path": [
        "Live Activities",
        "Best practices",
        "Creating Live Activity layouts"
      ],
      "source_sentence_hash": "03cb010e774475503778e4d74acd49af9615fd21d7e8d36674e607d5002f0064",
      "word_count": 10
    },
    {
      "text": "Use familiar layouts for custom views and layouts",
      "section_path": [
        "Live Activities",
        "Best practices",
        "Creating Live Activity layouts"
      ],
      "source_sentence_hash": "92156ce4a569d4c8ec814bbdf00e5cbc38d2131ee7c5db8743a90586ed0fcce7",
      "word_count": 8
    },
    {
      "text": "Use consistent margins and concentric placement",
      "section_path": [
        "Live Activities",
        "Best practices",
        "Creating Live Activity layouts"
      ],
      "source_sentence_hash": "d9c0aebaea4496d467a711e8b5b538b19ffa70d1d0e62e8b78a1434d81ed02f2",
      "word_count": 6
    },
    {
      "text": "When separating a block of content, place it in an inset container shape or use a thick line",
      "section_path": [
        "Live Activities",
        "Best practices",
        "Creating Live Activity layouts"
      ],
      "source_sentence_hash": "df391f44d3393f2091ee08697b451b42de058d8d1a8e899f261731728175f33b",
      "word_count": 18
    },
    {
      "text": "Dynamically change the height of your Live Activity on the Lock Screen or in the expanded presentation",
      "section_path": [
        "Live Activities",
        "Best practices",
        "Creating Live Activity layouts"
      ],
      "source_sentence_hash": "8bff32a47d7e8acf115bd05323854b5cadb6d828bd05345ac75531ae8864daf7",
      "word_count": 17
    },
    {
      "text": "Choosing colors",
      "section_path": [
        "Live Activities",
        "Best practices",
        "Choosing colors"
      ],
      "source_sentence_hash": "93dbc840b193504311381417d21a8cd050cc3ddabc41347a80fb24268bd651ac",
      "word_count": 2
    },
    {
      "text": "Carefully consider using a custom background color and opacity",
      "section_path": [
        "Live Activities",
        "Best practices",
        "Choosing colors"
      ],
      "source_sentence_hash": "a363f10cc8cea990cd89462a88dfa43aea7c8e06d049a67bd1e2d1089fa0ca4c",
      "word_count": 9
    },
    {
      "text": "Use color to express the character and identity of your app",
      "section_path": [
        "Live Activities",
        "Best practices",
        "Choosing colors"
      ],
      "source_sentence_hash": "811c176252510d7e0aad7cc1203104b4db186c6e91f2d0e3473c3756a1bb9a50",
      "word_count": 11
    },
    {
      "text": "Tint your Live Activity’s key line color so that it matches your content",
      "section_path": [
        "Live Activities",
        "Best practices",
        "Choosing colors"
      ],
      "source_sentence_hash": "99ce7a6f230f1cc8e33983933a691ef6aaaa5fb2595a08c7021884b1e3c1bfca",
      "word_count": 13
    },
    {
      "text": "Adding transitions and animating content updates",
      "section_path": [
        "Live Activities",
        "Best practices",
        "Adding transitions and animating content updates"
      ],
      "source_sentence_hash": "c12d88533635973eb18daed81f1c2aed4b10551bb6f59af02019eaf271ec4a58",
      "word_count": 6
    },
    {
      "text": "Use animations to reinforce the information you’re communicating and to bring attention to updates",
      "section_path": [
        "Live Activities",
        "Best practices",
        "Adding transitions and animating content updates"
      ],
      "source_sentence_hash": "8f969885c23147360c53bc0d857118c3f627c8afad7f45576b3121e7ec5429fa",
      "word_count": 14
    },
    {
      "text": "Animate layout changes",
      "section_path": [
        "Live Activities",
        "Best practices",
        "Adding transitions and animating content updates"
      ],
      "source_sentence_hash": "f27f2125fc1aa99183f6a6b3e7bec67852a0c4d54067fee69b4c0e7df057371f",
      "word_count": 3
    },
    {
      "text": "Try to avoid overlapping elements",
      "section_path": [
        "Live Activities",
        "Best practices",
        "Adding transitions and animating content updates"
      ],
      "source_sentence_hash": "9cdb60231ca4d16f90ffcf89bc9a45a40ccf00087ec555b8f28ac60f339bffb9",
      "word_count": 5
    },
    {
      "text": "Offering interactivity",
      "section_path": [
        "Live Activities",
        "Best practices",
        "Offering interactivity"
      ],
      "source_sentence_hash": "443c92721a1ae35d20056fdd3f7d643187a3804a9e9997f39b3953b0f9c14ea9",
      "word_count": 2
    },
    {
      "text": "Make sure tapping the Live Activity opens your app at the right location",
      "section_path": [
        "Live Activities",
        "Best practices",
        "Offering interactivity"
      ],
      "source_sentence_hash": "6f9b0269ea435ddf6241a1581fd04b07bc44073fcbc863b55f521aeb938286ed",
      "word_count": 13
    },
    {
      "text": "Focus on simple, direct actions",
      "section_path": [
        "Live Activities",
        "Best practices",
        "Offering interactivity"
      ],
      "source_sentence_hash": "db47cf8ff0ae0339ff969352a615820ec9a8ab39f558fcaa7e232eadd80a8162",
      "word_count": 5
    },
    {
      "text": "Consider letting people respond to event or progress updates",
      "section_path": [
        "Live Activities",
        "Best practices",
        "Offering interactivity"
      ],
      "source_sentence_hash": "c2e03e014e689c68182d1cd8be3d6ca3bc27925431b683844bff198070599b58",
      "word_count": 9
    },
    {
      "text": "Starting, updating, and ending a Live Activity",
      "section_path": [
        "Live Activities",
        "Best practices",
        "Starting, updating, and ending a Live Activity"
      ],
      "source_sentence_hash": "dbfbed9b966563b0ad81e9f547d16ffdbbe7f2a4557c30eaa177782a42b7e466",
      "word_count": 7
    },
    {
      "text": "Start Live Activities at appropriate times, and make it easy for people to turn them off in your app",
      "section_path": [
        "Live Activities",
        "Best practices",
        "Starting, updating, and ending a Live Activity"
      ],
      "source_sentence_hash": "20239ea1855072839713d75ee3b53999e2104d944b394104a0dec4ebe442e084",
      "word_count": 19
    },
    {
      "text": "Offer an App Shortcut that starts your Live Activity",
      "section_path": [
        "Live Activities",
        "Best practices",
        "Starting, updating, and ending a Live Activity"
      ],
      "source_sentence_hash": "c714d62d6916736fbfe1aef74666f33454c32d96f31d115017922f8c9525547a",
      "word_count": 9
    },
    {
      "text": "Update a Live Activity only when new content is available",
      "section_path": [
        "Live Activities",
        "Best practices",
        "Starting, updating, and ending a Live Activity"
      ],
      "source_sentence_hash": "319c6594ea741835fb8c8c5638e91c1d72edd19ffa116d73022c3dddcc556630",
      "word_count": 10
    },
    {
      "text": "Alert people only for essential updates that require their attention",
      "section_path": [
        "Live Activities",
        "Best practices",
        "Starting, updating, and ending a Live Activity"
      ],
      "source_sentence_hash": "b69dc429ec57ec47574f354f184d165b9f908826b47ea808a9ef5eca63bfe21c",
      "word_count": 10
    },
    {
      "text": "Let people track multiple events efficiently with a single Live Activity",
      "section_path": [
        "Live Activities",
        "Best practices",
        "Starting, updating, and ending a Live Activity"
      ],
      "source_sentence_hash": "994b2e6782a5da7ddd50ee5890d23ce33f0426c4b4b3245fa593d2943b93e6fb",
      "word_count": 11
    },
    {
      "text": "Always end a Live Activity immediately when the task or event ends, and consider setting a custom dismissal time",
      "section_path": [
        "Live Activities",
        "Best practices",
        "Starting, updating, and ending a Live Activity"
      ],
      "source_sentence_hash": "7e494dca7a241bd40fbb91e7d95673a1be9491fc684dddd2ebce110cc12876c1",
      "word_count": 19
    },
    {
      "text": "Start with the iPhone design, then refine it for other contexts",
      "section_path": [
        "Live Activities",
        "Presentation"
      ],
      "source_sentence_hash": "5fcf612f9e4dbaa7b1f6e22f52385e4b186752a616147701c5eeca14b13a5e90",
      "word_count": 11
    },
    {
      "text": "Compact presentation",
      "section_path": [
        "Live Activities",
        "Presentation",
        "Compact presentation"
      ],
      "source_sentence_hash": "ef2b18f8bae46bb8a38d98f848986759ffe47979b464a2481050a50376cd5479",
      "word_count": 2
    },
    {
      "text": "Focus on the most important information",
      "section_path": [
        "Live Activities",
        "Presentation",
        "Compact presentation"
      ],
      "source_sentence_hash": "359dace2f321ff66c845692c6c1ae6d26b09981b03c7d5ef583f4c2a54d2ee97",
      "word_count": 6
    },
    {
      "text": "Ensure unified information and design of the compact presentations in the Dynamic Island",
      "section_path": [
        "Live Activities",
        "Presentation",
        "Compact presentation"
      ],
      "source_sentence_hash": "45325e54b1f3a66e08e911aa6b175b5380b8194ea87ec26f5c138c54df506946",
      "word_count": 13
    },
    {
      "text": "Keep content as narrow as possible and ensure it’s snug against the TrueDepth camera",
      "section_path": [
        "Live Activities",
        "Presentation",
        "Compact presentation"
      ],
      "source_sentence_hash": "8c16f6639222d7360577aaa8fd860b6000b828b0cf4cac04c3de3c248d08b9f2",
      "word_count": 14
    },
    {
      "text": "Link to relevant app content",
      "section_path": [
        "Live Activities",
        "Presentation",
        "Compact presentation"
      ],
      "source_sentence_hash": "55c5b7a40c0b7d329ae5d6d7231d6d8de9317696ea36646e86ff149a46b53566",
      "word_count": 5
    },
    {
      "text": "Minimal presentation",
      "section_path": [
        "Live Activities",
        "Presentation",
        "Minimal presentation"
      ],
      "source_sentence_hash": "8f8e7ca1bb500547c0a69bf2c2ad57417d06acecbeef6ee6e7380b19bd95421b",
      "word_count": 2
    },
    {
      "text": "Ensure that your Live Activity is recognizable in the minimal presentation",
      "section_path": [
        "Live Activities",
        "Presentation",
        "Minimal presentation"
      ],
      "source_sentence_hash": "e7e00619adc9e0fec1853180c95a7ca6829376fcfbddacbcf2b21d4d1bcfb95e",
      "word_count": 11
    },
    {
      "text": "Expanded presentation",
      "section_path": [
        "Live Activities",
        "Presentation",
        "Expanded presentation"
      ],
      "source_sentence_hash": "50cab9360df6e3b3098c65dd4069a410dd340409c1f7b9401961f5fa53bdf3f6",
      "word_count": 2
    },
    {
      "text": "Maintain the relative placement of elements to create a coherent layout between presentations",
      "section_path": [
        "Live Activities",
        "Presentation",
        "Expanded presentation"
      ],
      "source_sentence_hash": "c5abafc96793f644a856f2eb43272a44f401127a36c5ce9dae338c7c99f6f3b4",
      "word_count": 13
    },
    {
      "text": "Wrap content tightly around the TrueDepth camera",
      "section_path": [
        "Live Activities",
        "Presentation",
        "Expanded presentation"
      ],
      "source_sentence_hash": "8b0bec3313c0536f56453af2d0a19d4cc367c3a8145bdb681bb2fbc1244ef308",
      "word_count": 7
    },
    {
      "text": "Lock Screen presentation",
      "section_path": [
        "Live Activities",
        "Presentation",
        "Lock Screen presentation"
      ],
      "source_sentence_hash": "b97643ee5b24217d14d309ee56aaaeed1d259b70f44aff37b9e144e9bce7c828",
      "word_count": 3
    },
    {
      "text": "Don’t replicate notification layouts",
      "section_path": [
        "Live Activities",
        "Presentation",
        "Lock Screen presentation"
      ],
      "source_sentence_hash": "7d5224c66be62288d17f4f034774fd0cc0fc3f29769aa1eccd223e17b250e049",
      "word_count": 4
    },
    {
      "text": "Choose colors that work well on a personalized Lock Screen",
      "section_path": [
        "Live Activities",
        "Presentation",
        "Lock Screen presentation"
      ],
      "source_sentence_hash": "d08e14d5ca0d0680d2ccc8b871d0ef6da3b97ade09555a0fcde06286d6e187fe",
      "word_count": 10
    },
    {
      "text": "Make sure your design, assets, and colors look great and offer enough contrast in Dark Mode and on an",
      "section_path": [
        "Live Activities",
        "Presentation",
        "Lock Screen presentation"
      ],
      "source_sentence_hash": "41c71ef689dd26c15c3e3360917c38cec4746bdcbe2e8e93fa9177052e348700",
      "word_count": 19
    },
    {
      "text": "Verify the generated color of the dismiss button",
      "section_path": [
        "Live Activities",
        "Presentation",
        "Lock Screen presentation"
      ],
      "source_sentence_hash": "a74d3e197b283aa9a5395e659943a8bb66b4d673ffc0e66b39889c58af2edf1d",
      "word_count": 8
    },
    {
      "text": "Use standard margins to align your design with notifications",
      "section_path": [
        "Live Activities",
        "Presentation",
        "Lock Screen presentation"
      ],
      "source_sentence_hash": "cdabe7052fd80925e21af62d5be141f46350b3e0feec453161e288d5bb45d83f",
      "word_count": 9
    },
    {
      "text": "StandBy presentation",
      "section_path": [
        "Live Activities",
        "Presentation",
        "StandBy presentation"
      ],
      "source_sentence_hash": "f9eb4fdd0467076d200cc6a9ab39b4d9178e086056320a081d07b5592a0f8b6c",
      "word_count": 2
    },
    {
      "text": "Update your layout for StandBy",
      "section_path": [
        "Live Activities",
        "Presentation",
        "StandBy presentation"
      ],
      "source_sentence_hash": "b4fff680f66646ac978483d662c7bfc68b0454a9306b94a302cc194fcdac6c38",
      "word_count": 5
    },
    {
      "text": "Consider using the default background color in StandBy",
      "section_path": [
        "Live Activities",
        "Presentation",
        "StandBy presentation"
      ],
      "source_sentence_hash": "91cdf5eb4a36cf0b8974032d1c13976b05275ce7618b250392676f1267faaa0d",
      "word_count": 8
    },
    {
      "text": "Use standard margins and avoid extending graphic elements to the edge of the screen",
      "section_path": [
        "Live Activities",
        "Presentation",
        "StandBy presentation"
      ],
      "source_sentence_hash": "31bc189a5f5f4162181e0e78d33f463b82f5c1990866b14d82cd6f989f7d60a4",
      "word_count": 14
    },
    {
      "text": "Verify your design in Night Mode",
      "section_path": [
        "Live Activities",
        "Presentation",
        "StandBy presentation"
      ],
      "source_sentence_hash": "b16b4813e3eea18d9a1e4f3110ae5495c8d17782785daf0d033e80b147c2932b",
      "word_count": 6
    },
    {
      "text": "Consider creating a custom layout if your Live Activity would benefit from larger text or additional information",
      "section_path": [
        "Live Activities",
        "CarPlay"
      ],
      "source_sentence_hash": "173d224fb69a0196e87029bafb4edc3e4a60d90929532434a44b40a8ec2365b8",
      "word_count": 17
    },
