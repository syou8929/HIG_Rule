  "guidance_candidates": [
    {
      "text": "Learn how upcoming weather conditions might affect their plans",
      "section_path": [
        "Charts"
      ],
      "source_sentence_hash": "7d27208a2958ca55ff28bf0b26925a9b79350922e13ca6bf2564fd2d1edd5f78",
      "word_count": 9
    },
    {
      "text": "Analyze stock prices to understand past performance and discover trends",
      "section_path": [
        "Charts"
      ],
      "source_sentence_hash": "7f9546112ba3f637d0cb97c29085bfd6190d765cb8a380f45471111f97f00003",
      "word_count": 10
    },
    {
      "text": "Review fitness data to monitor their progress and set new goals",
      "section_path": [
        "Charts"
      ],
      "source_sentence_hash": "b1e61f12abcf827923db4c77f1d0bb053529c767fc35fee8954b8866d8e52921",
      "word_count": 11
    },
    {
      "text": "Choose a mark type based on the information you want to communicate about the data",
      "section_path": [
        "Charts",
        "Marks"
      ],
      "source_sentence_hash": "d0e186a1d36b0c11c219fcc6ae49d7d87dc60e5f2aeadded4c03ff501f35d096",
      "word_count": 15
    },
    {
      "text": "Consider combining mark types when it adds clarity to your chart",
      "section_path": [
        "Charts",
        "Marks"
      ],
      "source_sentence_hash": "dfa58ed40ed8d5dc8a5070bcff1159ed6887a0278c230c635b3327ba696176c1",
      "word_count": 11
    },
    {
      "text": "Use a fixed or dynamic axis range depending on the meaning of your chart",
      "section_path": [
        "Charts",
        "Axes"
      ],
      "source_sentence_hash": "6e564f5af78e593291bfdb5fc266d15569fc33a697aef6d153da17fc9f4f3bbf",
      "word_count": 14
    },
    {
      "text": "Define the value of the lower bound based on mark type and chart usage",
      "section_path": [
        "Charts",
        "Axes"
      ],
      "source_sentence_hash": "cce4fd8efca303cf0d3aa20aaf3c0a8bb363c7c6f8b7d7e17b845a0c2af0921e",
      "word_count": 14
    },
    {
      "text": "Prefer familiar sequences of values in the tick and grid-line labels for an axis",
      "section_path": [
        "Charts",
        "Axes"
      ],
      "source_sentence_hash": "3def0d8e84316ab0fd29f04878274dac9bfbd169ea8e34535f6c8dbb3a23723e",
      "word_count": 14
    },
    {
      "text": "Tailor the appearance of grid lines and labels to a chart’s use cases",
      "section_path": [
        "Charts",
        "Axes"
      ],
      "source_sentence_hash": "77ff6061a2dbaa33c4910c0ebb70f2069b2c873a75d4d5c7ae41c91884fc8617",
      "word_count": 13
    },
    {
      "text": "Write descriptions that help people understand what a chart does before they view it",
      "section_path": [
        "Charts",
        "Descriptive content"
      ],
      "source_sentence_hash": "d3b126dbcfb27e0a8bbe326c53895cfffa5aa66ddb6994fb03f58d79b64839e5",
      "word_count": 14
    },
    {
      "text": "Summarize the main message of your chart to help make it approachable and useful for everyone",
      "section_path": [
        "Charts",
        "Descriptive content"
      ],
      "source_sentence_hash": "6dd0ecde6729f05ea8eca4bbc87d6ac6f5c3e9d94677487568bda4ec137c3ab5",
      "word_count": 16
    },
    {
      "text": "Establish a consistent visual hierarchy that helps communicate the relative importance of various chart elements",
      "section_path": [
        "Charts",
        "Best practices"
      ],
      "source_sentence_hash": "85e53991fa3f160d6dbfb58808a0a8a64c2aeb53baff6562baa06ed092e8c10b",
      "word_count": 15
    },
    {
      "text": "In a compact environment, maximize the width of the plot area to give people enough space to comfortably examine",
      "section_path": [
        "Charts",
        "Best practices"
      ],
      "source_sentence_hash": "a5dceed56449466a191523bfe85f6a4b7f0083150bc17cbea55cd03482b676ce",
      "word_count": 19
    },
    {
      "text": "Make every chart in your app accessible",
      "section_path": [
        "Charts",
        "Best practices"
      ],
      "source_sentence_hash": "399c6903451f9e32f7884b101661ca00290424b719975aeeb796e0fe6d8a0584",
      "word_count": 7
    },
    {
      "text": "Let people interact with the data when it makes sense, but don’t require interaction to reveal critical information",
      "section_path": [
        "Charts",
        "Best practices"
      ],
      "source_sentence_hash": "3221f3ef38546e011781f682dcba476708259188d247f4d24ac336cac05cdc30",
      "word_count": 18
    },
    {
      "text": "Make it easy for everyone to interact with a chart",
      "section_path": [
        "Charts",
        "Best practices"
      ],
      "source_sentence_hash": "98f62a0cfceda88c9152e7c507397e9778c906a79c8f160ed6ff20c8f72273e4",
      "word_count": 10
    },
    {
      "text": "Make an interactive chart easy to navigate when using keyboard commands (including full keyboard access) or Switch Control",
      "section_path": [
        "Charts",
        "Best practices"
      ],
      "source_sentence_hash": "a110fb1a97c53268fc87fdbff9789342ca2d1f7331390036c6bb84ce7d630c88",
      "word_count": 18
    },
    {
      "text": "Help people notice important changes in a chart",
      "section_path": [
        "Charts",
        "Best practices"
      ],
      "source_sentence_hash": "b453492c04f375c4fabeab136423b3474c9764565efe219d243b5b82b8dd544a",
      "word_count": 8
    },
    {
      "text": "Align a chart with surrounding interface elements",
      "section_path": [
        "Charts",
        "Best practices"
      ],
      "source_sentence_hash": "a73d19bd54da8252ce53f3a3fb0eaeffa8d38b6a651a6c668266e6bc16809689",
      "word_count": 7
    },
    {
      "text": "Avoid relying solely on color to differentiate between different pieces of data or communicate essential information in a chart",
      "section_path": [
        "Charts",
        "Color"
      ],
      "source_sentence_hash": "965599a0fecdb42349c0d6be0c22bbd77865bd1bcd81213178ad5e53dedd67f4",
      "word_count": 19
    },
    {
      "text": "Aid comprehension by adding visual separation between contiguous areas of color",
      "section_path": [
        "Charts",
        "Color"
      ],
      "source_sentence_hash": "bbc345391e0b550046a710bc0c7f154c36e5e066a5068264f4e1d73cf09dc8cb",
      "word_count": 11
    },
    {
      "text": "Consider using Audio Graphs to give VoiceOver users more information about your chart",
      "section_path": [
        "Charts",
        "Enhancing the accessibility of a chart"
      ],
      "source_sentence_hash": "6343a916d9f1e210608ef83c8216b86d46a5fa159b581b43ee7ea1aa75cf884c",
      "word_count": 13
    },
    {
      "text": "Write accessibility labels that support the purpose of your chart",
      "section_path": [
        "Charts",
        "Enhancing the accessibility of a chart"
      ],
      "source_sentence_hash": "cb32de50a5e47bb8617b3281c4e387529b9ed8f75e494e92efe428dbb76e1eed",
      "word_count": 10
    },
    {
      "text": "Prioritize clarity and comprehensiveness",
      "section_path": [
        "Charts",
        "Enhancing the accessibility of a chart"
      ],
      "source_sentence_hash": "c45faafaf989e8628de4bd47709b8fc735025d2abb08e072d1e28a96d2ddf5ae",
      "word_count": 4
    },
    {
      "text": "Avoid using subjective terms",
      "section_path": [
        "Charts",
        "Enhancing the accessibility of a chart"
      ],
      "source_sentence_hash": "4808955beff65b69f6ca4974a362a8df096af191357b40b9b869fe08461ed17e",
      "word_count": 4
    },
    {
      "text": "Maximize clarity in data descriptions by avoiding potentially ambiguous formats and abbreviations",
      "section_path": [
        "Charts",
        "Enhancing the accessibility of a chart"
      ],
      "source_sentence_hash": "6b15498e25834514d5e2c499ee490c97c3d9eb68e103dd30a2c3d84695a2555c",
      "word_count": 12
    },
    {
      "text": "Describe what the chart’s details represent, not what they look like",
      "section_path": [
        "Charts",
        "Enhancing the accessibility of a chart"
      ],
      "source_sentence_hash": "116edcdaa8079353006cfd2c2f91e43fed239f98099da0f8d6fcd32a9c6ae15f",
      "word_count": 11
    },
    {
      "text": "Be consistent throughout your app when referring to a specific axis",
      "section_path": [
        "Charts",
        "Enhancing the accessibility of a chart"
      ],
      "source_sentence_hash": "81b60eca3d4fe5acbd145118a4c234e96ecc5a5cb3e7b2f3210081a483cdeb71",
      "word_count": 11
    },
    {
      "text": "Hide visible text labels for axes and ticks from assistive technologies",
      "section_path": [
        "Charts",
        "Enhancing the accessibility of a chart"
      ],
      "source_sentence_hash": "3982648bf3364b775eaeaf2ffd24422788984996206e31c2d71f155f32ae71ed",
      "word_count": 11
    },
    {
      "text": "In general, avoid requiring complex chart interactions in your watchOS app",
      "section_path": [
        "Charts",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "47ac7b2cfc05f80e29321321ef76dfd4dfc566c180159a5243a8dcfb8e35b278",
      "word_count": 11
    },
    {
      "text": "Use grid-line and label appearance suited to chart use cases",
      "section_path": [
        "Charts",
        "Axes"
      ],
      "source_sentence_hash": "77ff6061a2dbaa33c4910c0ebb70f2069b2c873a75d4d5c7ae41c91884fc8617",
      "word_count": 10
    },
    {
      "text": "Ensure chart descriptions summarize essential key information",
      "section_path": [
        "Charts",
        "Descriptive content"
      ],
      "source_sentence_hash": "6dd0ecde6729f05ea8eca4bbc87d6ac6f5c3e9d94677487568bda4ec137c3ab5",
      "word_count": 7
    },
    {
      "text": "Use a consistent visual hierarchy for chart elements",
      "section_path": [
        "Charts",
        "Best practices"
      ],
      "source_sentence_hash": "85e53991fa3f160d6dbfb58808a0a8a64c2aeb53baff6562baa06ed092e8c10b",
      "word_count": 8
    },
    {
      "text": "Use the full available plot width in compact environments",
      "section_path": [
        "Charts",
        "Best practices"
      ],
      "source_sentence_hash": "a5dceed56449466a191523bfe85f6a4b7f0083150bc17cbea55cd03482b676ce",
      "word_count": 9
    },
    {
      "text": "Ensure compact chart vertical-axis labels stay short without losing clarity",
      "section_path": [
        "Charts",
        "Best practices"
      ],
      "source_sentence_hash": "a5dceed56449466a191523bfe85f6a4b7f0083150bc17cbea55cd03482b676ce",
      "word_count": 10
    },
    {
      "text": "Avoid requiring interaction to reveal critical chart information",
      "section_path": [
        "Charts",
        "Best practices"
      ],
      "source_sentence_hash": "3221f3ef38546e011781f682dcba476708259188d247f4d24ac336cac05cdc30",
      "word_count": 8
    },
    {
      "text": "Consider expanding a chart hit target to the entire plot area",
      "section_path": [
        "Charts",
        "Best practices"
      ],
      "source_sentence_hash": "98f62a0cfceda88c9152e7c507397e9778c906a79c8f160ed6ff20c8f72273e4",
      "word_count": 11
    },
    {
      "text": "Ensure chart changes remain noticeable without animation",
      "section_path": [
        "Charts",
        "Best practices"
      ],
      "source_sentence_hash": "b453492c04f375c4fabeab136423b3474c9764565efe219d243b5b82b8dd544a",
      "word_count": 7
    },
    {
      "text": "Use surrounding interface alignment for chart placement",
      "section_path": [
        "Charts",
        "Best practices"
      ],
      "source_sentence_hash": "a73d19bd54da8252ce53f3a3fb0eaeffa8d38b6a651a6c668266e6bc16809689",
      "word_count": 7
    },
    {
      "text": "Use visual separation between contiguous areas of color",
      "section_path": [
        "Charts",
        "Color"
      ],
      "source_sentence_hash": "bbc345391e0b550046a710bc0c7f154c36e5e066a5068264f4e1d73cf09dc8cb",
      "word_count": 8
    },
    {
      "text": "Ensure noncolor alternatives convey essential chart information",
      "section_path": [
        "Charts",
        "Color"
      ],
      "source_sentence_hash": "965599a0fecdb42349c0d6be0c22bbd77865bd1bcd81213178ad5e53dedd67f4",
      "word_count": 7
    },
    {
      "text": "Ensure every chart supports VoiceOver",
      "section_path": [
        "Charts",
        "Best practices"
      ],
      "source_sentence_hash": "399c6903451f9e32f7884b101661ca00290424b719975aeeb796e0fe6d8a0584",
      "word_count": 5
    },
    {
      "text": "Provide chart structure and purpose overview when Audio Graphs are absent",
      "section_path": [
        "Charts",
        "Enhancing the accessibility of a chart"
      ],
      "source_sentence_hash": "6343a916d9f1e210608ef83c8216b86d46a5fa159b581b43ee7ea1aa75cf884c",
      "word_count": 10
    },
    {
      "text": "Provide purpose-appropriate labels for important or interactive chart elements",
      "section_path": [
        "Charts",
        "Enhancing the accessibility of a chart"
      ],
      "source_sentence_hash": "cdbdd9454adee31fbfd3092d3131ac3f420f5027a641ce2d360dda28f312ea68",
      "word_count": 9
    },
    {
      "text": "Avoid ambiguous formats and abbreviations in chart accessibility descriptions",
      "section_path": [
        "Charts",
        "Enhancing the accessibility of a chart"
      ],
      "source_sentence_hash": "6b15498e25834514d5e2c499ee490c97c3d9eb68e103dd30a2c3d84695a2555c",
      "word_count": 9
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Charts",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
