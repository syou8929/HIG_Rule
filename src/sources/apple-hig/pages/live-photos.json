  "guidance_candidates": [
    {
      "text": "Apply adjustments to all frames",
      "section_path": [
        "Live Photos",
        "Best practices"
      ],
      "source_sentence_hash": "57c7b9db695ab4f8985fe6aff0ef685fa2b105af120cd5640af34e4a91fc8e5c",
      "word_count": 5
    },
    {
      "text": "Keep Live Photo content intact",
      "section_path": [
        "Live Photos",
        "Best practices"
      ],
      "source_sentence_hash": "a99a3bc774f639ff5282f97f2ce4a116c6bfaa26ae6217de571166f8346f1eea",
      "word_count": 5
    },
    {
      "text": "Implement a great photo sharing experience",
      "section_path": [
        "Live Photos",
        "Best practices"
      ],
      "source_sentence_hash": "b13bb221c2b3b40dcb00493a8ef388c09cefce96328a574571ddb7e69a4b5cd4",
      "word_count": 6
    },
    {
      "text": "Clearly indicate when a Live Photo is downloading and when the photo is playable",
      "section_path": [
        "Live Photos",
        "Best practices"
      ],
      "source_sentence_hash": "d29958d555c68fa115064df440e4498a6d74996623836eb776e23708d31d9229",
      "word_count": 14
    },
    {
      "text": "Display Live Photos as traditional photos in environments that don’t support Live Photos",
      "section_path": [
        "Live Photos",
        "Best practices"
      ],
      "source_sentence_hash": "6ed2c864618ea95f1bf51126c6a538ef1b11cd580b9ab2346617d438d5092611",
      "word_count": 13
    },
    {
      "text": "Make Live Photos easily distinguishable from still photos",
      "section_path": [
        "Live Photos",
        "Best practices"
      ],
      "source_sentence_hash": "afd4a91536a95941cd95b1a4f2a8e7c3e73addf10227e917d7864bbda9c77ccf",
      "word_count": 8
    },
    {
      "text": "Keep badge placement consistent",
      "section_path": [
        "Live Photos",
        "Best practices"
      ],
      "source_sentence_hash": "3b23b88d5f5063fc932b30c562bb94867eafbe0b27a70e449959b29fd368a62e",
      "word_count": 4
    },
    {
      "text": "If full-frame adjustments aren’t supported, let people convert a Live Photo to a still photo",
      "section_path": [
        "Live Photos",
        "Best practices"
      ],
      "source_sentence_hash": "0014efe03717da4d6a35caea47682cf9b4a85d68e745cfecccd180f04c6b2f64",
      "word_count": 14
    },
    {
      "text": "Don’t disassemble a Live Photo into separate frames or audio",
      "section_path": [
        "Live Photos",
        "Best practices"
      ],
      "source_sentence_hash": "39278d6a4bc7d4f7a960c74e1e7c0316d7a77e1c60269b148497cfcf7a0ea296",
      "word_count": 10
    },
    {
      "text": "Let people preview all Live Photo content before sharing",
      "section_path": [
        "Live Photos",
        "Best practices"
      ],
      "source_sentence_hash": "0ac0e9c9501e116df4df52aff92d68a35b6db9869fed3a38d0dbb63558e3da54",
      "word_count": 9
    },
    {
      "text": "Always offer sharing Live Photos as traditional photos",
      "section_path": [
        "Live Photos",
        "Best practices"
      ],
      "source_sentence_hash": "2011fc898a4444a1e69d939df9e5d0b36d18c1fd939e4b6e588dca369d2b6db3",
      "word_count": 8
    },
    {
      "text": "Don’t replicate the Live Photos experience in unsupported environments",
      "section_path": [
        "Live Photos",
        "Best practices"
      ],
      "source_sentence_hash": "14e34958788b6741850ce846e7590ec48006a7d5a02205d9b22f256ac4045697",
      "word_count": 9
    },
    {
      "text": "When movement isn’t possible, show a system-provided Live Photo badge",
      "section_path": [
        "Live Photos",
        "Best practices"
      ],
      "source_sentence_hash": "46e783d130f5e09cff8af96e575d9e877ea5e418144dff3d39cd30ce6ad8b9d5",
      "word_count": 10
    },
    {
      "text": "Never use a playback button that resembles video playback",
      "section_path": [
        "Live Photos",
        "Best practices"
      ],
      "source_sentence_hash": "faa4d21df12e13898115ab92959cff8dfbd65972100f2a56cd08e423993c5623",
      "word_count": 9
    },
    {
      "text": "Avoid Live Photos in unsupported watchOS",
