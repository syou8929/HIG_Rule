  "guidance_candidates": [
    {
      "text": "Support the default system-defined menus and their ordering",
      "section_path": [
        "The menu bar",
        "Best practices"
      ],
      "source_sentence_hash": "f3523fd5957e1d1d4b9d90c556d47d08bbdacbe46da0ef509226466718d65870",
      "word_count": 8
    },
    {
      "text": "Always show the same set of menu items",
      "section_path": [
        "The menu bar",
        "Best practices"
      ],
      "source_sentence_hash": "2c0bcd19021878a6add9f780e281baf082b9cdb6fc7da32c9a825df9fc8cdc4e",
      "word_count": 8
    },
    {
      "text": "Represent menu item actions with familiar icons",
      "section_path": [
        "The menu bar",
        "Best practices"
      ],
      "source_sentence_hash": "a5de0d14dbfbe14814f53341694d8542e16587c9a864a1a725949cbb750e1d11",
      "word_count": 7
    },
    {
      "text": "Support the keyboard shortcuts defined for the standard menu items you include",
      "section_path": [
        "The menu bar",
        "Best practices"
      ],
      "source_sentence_hash": "257057a2732054068304d7f45862524d47b37e05d66df2ddb4553e52a12411c6",
      "word_count": 12
    },
    {
      "text": "Prefer short, one-word menu titles",
      "section_path": [
        "The menu bar",
        "Best practices"
      ],
      "source_sentence_hash": "179973d433aa257607fefd60bc86914320d9902272ca826105ce2e04f971cda3",
      "word_count": 5
    },
    {
      "text": "Display the About menu item first",
      "section_path": [
        "The menu bar",
        "App menu"
      ],
      "source_sentence_hash": "fc1a66ba7805159830cfa20c233bbd83b137423e6830f9472e9a501ccb258a07",
      "word_count": 6
    },
    {
      "text": "Determine whether Find menu items belong in the Edit menu",
      "section_path": [
        "The menu bar",
        "Edit menu"
      ],
      "source_sentence_hash": "1f4d126585ccfa2bc2cf43a861d812247453eda338b6ddae0568074c5b7fa9e6",
      "word_count": 10
    },
    {
      "text": "Provide a View menu even if your app supports only a subset of the standard view functions",
      "section_path": [
        "The menu bar",
        "View menu"
      ],
      "source_sentence_hash": "db168fe8df1732f547a167da292822bdc92e0a7f46f28b339b4aefa902c750f6",
      "word_count": 17
    },
    {
      "text": "Ensure that each show/hide item title reflects the current state of the corresponding view",
      "section_path": [
        "The menu bar",
        "View menu"
      ],
      "source_sentence_hash": "035cc4109c26179d029c66bd02fedd28b5435b8cad3f5508d564c7ba07c722d7",
      "word_count": 14
    },
    {
      "text": "Provide app-specific menus for custom commands",
      "section_path": [
        "The menu bar",
        "App-specific menus"
      ],
      "source_sentence_hash": "7a78f7739eb9ce5d6dbdc5332a06f600060075fde518039f732af362817897df",
      "word_count": 6
    },
    {
      "text": "As much as possible, reflect your app’s hierarchy in app-specific menus",
      "section_path": [
        "The menu bar",
        "App-specific menus"
      ],
      "source_sentence_hash": "d76e0a907ca1d4e98a85b65e53f4280f7ff68a3a6f263180f0788338c45a8c3a",
      "word_count": 11
    },
    {
      "text": "Aim to list app-specific menus in order from most to least general or commonly used",
      "section_path": [
        "The menu bar",
        "App-specific menus"
      ],
      "source_sentence_hash": "57894a6ac5e9f0e9cac449985f69c1e02985ef416b103ed5f41987b4de723fa5",
      "word_count": 15
    },
    {
      "text": "Provide a Window menu even if your app has only one window",
      "section_path": [
        "The menu bar",
        "Window menu"
      ],
      "source_sentence_hash": "02680a2a8b8a9472cac830a05a60880e9308ed128cd25b5e8215625da32f34e5",
      "word_count": 12
    },
    {
      "text": "Consider including menu items for showing and hiding panels",
      "section_path": [
        "The menu bar",
        "Window menu"
      ],
      "source_sentence_hash": "a4de7cefa2839c8c36d0a76fe72b58fcc1fe40dcf878d81eb0fda13f27ee2e91",
      "word_count": 9
    },
    {
      "text": "Avoid making a dynamic menu item the only way to accomplish a task",
      "section_path": [
        "The menu bar",
        "Dynamic menu items"
      ],
      "source_sentence_hash": "25f8c4eb2f950eb9ce4daea142dc17fb04cd4fe9ee97806d088e42a9bae3521f",
      "word_count": 13
    },
    {
      "text": "Use dynamic menu items primarily in menu bar menus",
      "section_path": [
        "The menu bar",
        "Dynamic menu items"
      ],
      "source_sentence_hash": "ac767a1aae20ac9a8e42b8c2a3af645411cea2b88fb6bc497dc68244b9a0e8f1",
      "word_count": 9
    },
    {
      "text": "Require only a single modifier key to reveal a dynamic menu item",
      "section_path": [
        "The menu bar",
        "Dynamic menu items"
      ],
      "source_sentence_hash": "0a7715cc1250062cdd895f5678014a4cc5dba8f3cd1cb5f689be206517c087c5",
      "word_count": 12
    },
    {
      "text": "Because the menu bar is often hidden when running an app full screen, ensure that people can access all",
      "section_path": [
        "The menu bar",
        "Platform considerations",
        "iPadOS"
      ],
      "source_sentence_hash": "6e5d37de53f20f517f411ff606d9291bd08595584c7ab70cc92bca23c450f565",
      "word_count": 19
    },
    {
      "text": "Reserve the YourAppName > Settings menu item for opening your app’s page in iPadOS Settings",
      "section_path": [
        "The menu bar",
        "Platform considerations",
        "iPadOS"
      ],
      "source_sentence_hash": "df4283665205ad3af2af5cdc791c7d65675d7533b771e6f59a9780d09104133a",
      "word_count": 15
    },
    {
      "text": "For apps with tab-style navigation, consider adding each tab as a menu item in the View menu",
      "section_path": [
        "The menu bar",
        "Platform considerations",
        "iPadOS"
      ],
      "source_sentence_hash": "eb724a9a5e7e858155b5b6270a47c21756b95ce87fde2d2579ecde090788a625",
      "word_count": 17
    },
    {
      "text": "Consider grouping menu items into submenus to conserve vertical space",
      "section_path": [
        "The menu bar",
        "Platform considerations",
        "iPadOS"
      ],
      "source_sentence_hash": "a3ec2967661dd90e41e4fd2e6f9b6f01f38c7f34478320f65644d11313d836cb",
      "word_count": 10
    },
    {
      "text": "Menu bar extras",
      "section_path": [
        "The menu bar",
        "Platform considerations",
        "macOS",
        "Menu bar extras"
      ],
      "source_sentence_hash": "ad4eb1c4dec0495b8af3c4d02b3d9ecf26315d25f77145115f098a6ceb816a7a",
      "word_count": 3
    },
    {
      "text": "Consider using a symbol to represent your menu bar extra",
      "section_path": [
        "The menu bar",
        "Platform considerations",
        "macOS",
        "Menu bar extras"
      ],
      "source_sentence_hash": "9e0525e30b645bd446a0e544d5b86fe8ae0e617ffa7556c3ff775aae8e4f7772",
      "word_count": 10
    },
    {
      "text": "Display a menu — not a popover — when people click your menu bar extra",
      "section_path": [
        "The menu bar",
        "Platform considerations",
        "macOS",
        "Menu bar extras"
      ],
      "source_sentence_hash": "12ef84c3b46083137a3363904424b5a15e3448721df539e4bfe2a060cb8b3655",
      "word_count": 15
    },
    {
      "text": "Let people — not your app — decide whether to put your menu bar extra in the menu bar",
      "section_path": [
        "The menu bar",
        "Platform considerations",
        "macOS",
        "Menu bar extras"
      ],
      "source_sentence_hash": "3d9602b27f40a308f9ce79df607623fc470da6f578d8bda27d39e6068cc76827",
      "word_count": 19
    },
    {
      "text": "Avoid relying on the presence of menu bar extras",
      "section_path": [
        "The menu bar",
        "Platform considerations",
        "macOS",
        "Menu bar extras"
      ],
      "source_sentence_hash": "8f6b11d603c409d6f5d0baa29651db3c6052e0b7ea50ada7ae6b18e2da38576a",
      "word_count": 9
    },
    {
      "text": "Consider exposing app-specific functionality in other ways, too",
      "section_path": [
        "The menu bar",
        "Platform considerations",
        "macOS",
        "Menu bar extras"
      ],
      "source_sentence_hash": "4b36f6842a3fd6ad7b8594bf05402a0e39bc902af7c473885e182fb9fe07b91e",
      "word_count": 8
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "The menu bar",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
