  "guidance_candidates": [
    {
      "text": "Place the Share button in a convenient location, like a toolbar, to make it easy for people to start",
      "section_path": [
        "Collaboration and sharing",
        "Best practices"
      ],
      "source_sentence_hash": "1d389c57bb71bef5969e1e39e74a36fff50ee737c5c30505ea9b56f39eb4b281",
      "word_count": 19
    },
    {
      "text": "If necessary, customize the share sheet or sharing popover to offer the types of file sharing your app supports",
      "section_path": [
        "Collaboration and sharing",
        "Best practices"
      ],
      "source_sentence_hash": "89c39be4a8ed342008123bc64c8135c9a417a93ac492ea268e475f60c29b1b02",
      "word_count": 19
    },
    {
      "text": "Write succinct phrases that summarize the sharing permissions you support",
      "section_path": [
        "Collaboration and sharing",
        "Best practices"
      ],
      "source_sentence_hash": "99bbc7dc7a13821257e2e7382d9e78687fe6ab034ecc127babd06cb7d3dae1a1",
      "word_count": 10
    },
    {
      "text": "Provide a set of simple sharing options that streamline collaboration setup",
      "section_path": [
        "Collaboration and sharing",
        "Best practices"
      ],
      "source_sentence_hash": "f545984aa9c5892479d843e555914f425dd7c2169bf0c2068075ab9fffbb9863",
      "word_count": 11
    },
    {
      "text": "Prominently display the Collaboration button as soon as collaboration starts",
      "section_path": [
        "Collaboration and sharing",
        "Best practices"
      ],
      "source_sentence_hash": "9bcf26ac4b35f81e00cc948b4de66d2e73a4a1857ec62db2f3143c34579e1ec2",
      "word_count": 10
    },
    {
      "text": "Provide custom actions in the collaboration popover only if needed",
      "section_path": [
        "Collaboration and sharing",
        "Best practices"
      ],
      "source_sentence_hash": "318eccafa682d1b31284cfd9fb7c947b9c30941230c30a0afbace79033404e3e",
      "word_count": 10
    },
    {
      "text": "If it makes sense in your app, customize the title of the modal view’s collaboration-management button",
      "section_path": [
        "Collaboration and sharing",
        "Best practices"
      ],
      "source_sentence_hash": "02d1bb73d5af45d2431d47cd44fe9f10d0d59fd762910faea875186c6e329c19",
      "word_count": 16
    },
    {
      "text": "Consider posting collaboration event notifications in Messages",
      "section_path": [
        "Collaboration and sharing",
        "Best practices"
      ],
      "source_sentence_hash": "9d216087db6237e26940af5bfd355b3265422cf9f4d83cf11e0117a602a58ecc",
