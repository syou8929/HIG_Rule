  "guidance_candidates": [
    {
      "text": "On iPhone 14 Pro and iPhone 14 Pro Max, the system displays Lock Screen items like Widgets and Live",
      "section_path": [
        "Always On"
      ],
      "source_sentence_hash": "808e2259e61687cf889f399bfe2914e211d9bde7ef05d0ee9183578845413da0",
      "word_count": 19
    },
    {
      "text": "When people drop their wrist while wearing Apple Watch, the system dims the watch face, continuing to display the",
      "section_path": [
        "Always On"
      ],
      "source_sentence_hash": "df65960baead855116f230f5a3da059c6fcf7d4895cd8e120f2eb6c87b090b6e",
      "word_count": 19
    },
    {
      "text": "Hide sensitive information",
      "section_path": [
        "Always On",
        "Best practices"
      ],
      "source_sentence_hash": "f30ef4d5fed42885f64f36ba1dc6d72b98e03c8852411df622a4d50d9e2be5d8",
      "word_count": 3
    },
    {
      "text": "Keep other types of personal information glanceable when it makes sense",
      "section_path": [
        "Always On",
        "Best practices"
      ],
      "source_sentence_hash": "3dbf06d68be54fce29ec46a8e8d5cb09d89e118ef9635e89d4176a14a26418f3",
      "word_count": 11
    },
    {
      "text": "Keep important content legible and dim nonessential content",
      "section_path": [
        "Always On",
        "Best practices"
      ],
      "source_sentence_hash": "922cded85a75b7739c20708e3f76892fcddfc39578e1d032234fc745f092779c",
      "word_count": 8
    },
    {
      "text": "Maintain a consistent layout",
      "section_path": [
        "Always On",
        "Best practices"
      ],
      "source_sentence_hash": "d3a77ac250bff8f9f22ac44cd4fcc0ac228b60b6b91a4e5a78c9c75e74f90648",
      "word_count": 4
    },
    {
      "text": "Gracefully transition motion to a resting state; don’t stop it instantly",
      "section_path": [
        "Always On",
        "Best practices"
      ],
      "source_sentence_hash": "129c96df31123790062eb5da6b9203afea1fb8ebbacd12caad91c53828dd47dd",
      "word_count": 11
    },
    {
      "text": "You need to hide personal information visible in Always On notifications",
      "section_path": [
        "Always On",
        "Best practices"
      ],
      "source_sentence_hash": "236cfdf82214ce5f61d0e73000f201736ab4e86ca13833a6aa52f31aaf7d6869",
      "word_count": 11
    },
    {
      "text": "Keep nonessential Always On content dimmed",
      "section_path": [
        "Always On",
        "Best practices"
      ],
      "source_sentence_hash": "922cded85a75b7739c20708e3f76892fcddfc39578e1d032234fc745f092779c",
      "word_count": 6
    },
    {
      "text": "Consider removing rich images and using dimmed colors in Always On",
      "section_path": [
        "Always On",
        "Best practices"
      ],
      "source_sentence_hash": "6e34d5ec8d08a1727d5fdf5b2e01b5ff8bd58cdd0c64b0276c210e536a462fb1",
      "word_count": 10
    },
    {
      "text": "Avoid distracting interface changes throughout Always On transitions",
      "section_path": [
        "Always On",
        "Best practices"
      ],
      "source_sentence_hash": "6f4da4004e1ae3d55ba7df7ba0a8699dd8ee462f0ff20d0502464d004a5a3ac2",
      "word_count": 8
    },
    {
      "text": "Prefer an unavailable appearance instead of removing interactive components when Always On begins",
      "section_path": [
        "Always On",
        "Best practices"
      ],
      "source_sentence_hash": "6f4da4004e1ae3d55ba7df7ba0a8699dd8ee462f0ff20d0502464d004a5a3ac2",
      "word_count": 12
    },
    {
      "text": "Aim for infrequent subtle interface updates during Always On",
      "section_path": [
        "Always On",
        "Best practices"
      ],
      "source_sentence_hash": "6f4da4004e1ae3d55ba7df7ba0a8699dd8ee462f0ff20d0502464d004a5a3ac2",
      "word_count": 9
    },
    {
      "text": "Use a graceful transition from motion to a resting state",
      "section_path": [
        "Always On",
        "Best practices"
      ],
      "source_sentence_hash": "129c96df31123790062eb5da6b9203afea1fb8ebbacd12caad91c53828dd47dd",
      "word_count": 9
    },
    {
      "text": "Avoid stopping motion instantly when Always On begins",
      "section_path": [
        "Always On",
        "Best practices"
      ],
      "source_sentence_hash": "129c96df31123790062eb5da6b9203afea1fb8ebbacd12caad91c53828dd47dd",
      "word_count": 8
    },
    {
      "text": "Avoid relying on Always On in iPadOS macOS tvOS or visionOS",
      "section_path": [
        "Always On",
        "Platform considerations"
      ],
      "source_sentence_hash": "b836897ea862ca4de23a3249d2c2ae90778c74e878b20bdfa2b13177a6faa485",
      "word_count": 11
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Always On",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
