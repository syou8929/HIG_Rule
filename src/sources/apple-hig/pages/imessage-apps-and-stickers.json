  "guidance_candidates": [
    {
      "text": "Prefer one primary experience in an iMessage app",
      "section_path": ["iMessage apps and stickers", "Best practices"],
      "source_sentence_hash": "5595c2276bb703d0ce8c7f86ddb7e13daa884798236c2b6c4ed7565f7b563f35",
      "word_count": 8
    },
    {
      "text": "Ensure iMessage app functionality is easy to understand and immediately available",
      "section_path": ["iMessage apps and stickers", "Best practices"],
      "source_sentence_hash": "5595c2276bb703d0ce8c7f86ddb7e13daa884798236c2b6c4ed7565f7b563f35",
      "word_count": 11
    },
    {
      "text": "Consider a separate iMessage app for each distinct experience or content collection",
      "section_path": ["iMessage apps and stickers", "Best practices"],
      "source_sentence_hash": "5595c2276bb703d0ce8c7f86ddb7e13daa884798236c2b6c4ed7565f7b563f35",
      "word_count": 12
    },
    {
      "text": "Consider surfacing content from the related iOS or iPadOS app",
      "section_path": ["iMessage apps and stickers", "Best practices"],
      "source_sentence_hash": "6bb4adf995895a8190c1845591d1c529b9f529eda8edc2891b84bfa020c95ffc",
      "word_count": 10
    },
    {
      "text": "Present essential iMessage app features in the compact view",
      "section_path": ["iMessage apps and stickers", "Best practices"],
      "source_sentence_hash": "bf729f95be536214af053d96b8fea8f02996f64212eee366ef9e491eceb63827",
      "word_count": 9
    },
    {
      "text": "Make sure frequently used items are available in the compact view",
      "section_path": ["iMessage apps and stickers", "Best practices"],
      "source_sentence_hash": "bf729f95be536214af053d96b8fea8f02996f64212eee366ef9e491eceb63827",
      "word_count": 11
    },
    {
      "text": "Reserve additional iMessage app content and features for the expanded view",
      "section_path": ["iMessage apps and stickers", "Best practices"],
      "source_sentence_hash": "bf729f95be536214af053d96b8fea8f02996f64212eee366ef9e491eceb63827",
      "word_count": 11
    },
    {
      "text": "Let people edit text only in the expanded view by default",
      "section_path": ["iMessage apps and stickers", "Best practices"],
      "source_sentence_hash": "83e599fd9ab7caa27d54cc7ae301657e82f6af1010c4919c0a64b16b4ac83d69",
      "word_count": 11
    },
    {
      "text": "Display the keyboard in the expanded view while people edit",
      "section_path": ["iMessage apps and stickers", "Best practices"],
      "source_sentence_hash": "83e599fd9ab7caa27d54cc7ae301657e82f6af1010c4919c0a64b16b4ac83d69",
      "word_count": 10
    },
    {
      "text": "Create stickers that are expressive, inclusive, and versatile",
      "section_path": ["iMessage apps and stickers", "Best practices"],
      "source_sentence_hash": "e8853a6a096125b4d38b55e25f3ae11da2871cb11fc0f231c8db18915a725ba2",
      "word_count": 8
    },
    {
      "text": "Make sure every sticker remains legible across backgrounds, rotations, and scales",
      "section_path": ["iMessage apps and stickers", "Best practices"],
      "source_sentence_hash": "e8853a6a096125b4d38b55e25f3ae11da2871cb11fc0f231c8db18915a725ba2",
      "word_count": 11
    },
    {
      "text": "Consider transparency to integrate stickers with surrounding conversation content",
      "section_path": ["iMessage apps and stickers", "Best practices"],
      "source_sentence_hash": "e8853a6a096125b4d38b55e25f3ae11da2871cb11fc0f231c8db18915a725ba2",
      "word_count": 9
    },
    {
      "text": "Provide a localized alternative description for every sticker",
      "section_path": ["iMessage apps and stickers", "Best practices"],
      "source_sentence_hash": "8c586347caa504b3a1c2c488b760bb28408bc063ed4ace919daf6607cb2ec45f",
      "word_count": 8
    },
    {
      "text": "Provide a square-cornered icon for each iMessage extension",
      "section_path": ["iMessage apps and stickers", "Specifications", "Icon sizes"],
      "source_sentence_hash": "a32ac45a8e2362bcdc8e4b69481ee284e3792e410c85e104d09ab479fb3aef4d",
      "word_count": 8
    },
    {
      "text": "Use the documented iMessage icon pixel dimensions for each usage and scale",
      "section_path": ["iMessage apps and stickers", "Specifications", "Icon sizes"],
      "source_sentence_hash": "4fdec5aad050c1645fc1c89e45d0f3f82b1f2dd486838e296aafa12fccfaf739",
      "word_count": 12
    },
    {
      "text": "Choose the sticker size that works best for the content",
      "section_path": ["iMessage apps and stickers", "Specifications", "Sticker sizes"],
      "source_sentence_hash": "87b1088acf5c704fd258a0471881ce22839ab3ca4ce792a6190448fc2f70e747",
      "word_count": 10
    },
    {
      "text": "Avoid mixing sticker sizes within one sticker pack",
      "section_path": ["iMessage apps and stickers", "Specifications", "Sticker sizes"],
      "source_sentence_hash": "87b1088acf5c704fd258a0471881ce22839ab3ca4ce792a6190448fc2f70e747",
      "word_count": 8
    },
    {
      "text": "Use 300x300, 408x408, or 618x618 pixels for small, regular, or large @3x stickers",
      "section_path": ["iMessage apps and stickers", "Specifications", "Sticker sizes"],
      "source_sentence_hash": "16bde17bb6912713eacd3064044dbcd1ce3d61e6ca3dfdac1448fe94bf05f99e",
      "word_count": 13
    },
    {
      "text": "Require each sticker file to be 500 KB or smaller",
      "section_path": ["iMessage apps and stickers", "Specifications", "Sticker sizes"],
      "source_sentence_hash": "26bbe8bba36122cb4cd0580a05f88ded6a1c5dbca3d21c041e1de57060092b98",
      "word_count": 10
    },
    {
      "text": "Use PNG for 8-bit transparency without animation",
      "section_path": ["iMessage apps and stickers", "Specifications", "Sticker sizes"],
      "source_sentence_hash": "8fb350a00552de9612ce62ef4945bbce51a1c776e92a5137ce1850cf075ad066",
      "word_count": 7
    },
    {
      "text": "Use APNG for 8-bit transparency with animation",
      "section_path": ["iMessage apps and stickers", "Specifications", "Sticker sizes"],
      "source_sentence_hash": "8fb350a00552de9612ce62ef4945bbce51a1c776e92a5137ce1850cf075ad066",
      "word_count": 7
    },
    {
      "text": "Use GIF for single-color transparency with animation",
      "section_path": ["iMessage apps and stickers", "Specifications", "Sticker sizes"],
      "source_sentence_hash": "8fb350a00552de9612ce62ef4945bbce51a1c776e92a5137ce1850cf075ad066",
      "word_count": 7
    },
    {
      "text": "Use JPEG when neither transparency nor animation is needed",
      "section_path": ["iMessage apps and stickers", "Specifications", "Sticker sizes"],
      "source_sentence_hash": "8fb350a00552de9612ce62ef4945bbce51a1c776e92a5137ce1850cf075ad066",
      "word_count": 9
    },
    {
      "text": "Avoid iMessage apps and stickers on unsupported Apple platforms",
      "section_path": ["iMessage apps and stickers", "Platform considerations"],
      "source_sentence_hash": "2ec3f085b0c134724e9f7910d2fabc6e2faf405a8938fc1e68661571673c4197",
      "word_count": 9
    }
  ],
