  "guidance_candidates": [
    {
      "text": "Consider using a picker to offer medium-to-long lists of items",
      "section_path": [
        "Pickers",
        "Best practices"
      ],
      "source_sentence_hash": "c5557e9cdedcf7ecc188ed5af00565684ee585902ac7b6c25ffc9c40f49765ee",
      "word_count": 10
    },
    {
      "text": "If a choice list is fairly short, consider using a pull-down button",
      "section_path": [
        "Pickers",
        "Best practices"
      ],
      "source_sentence_hash": "cad19eeac22fa9b799b05be65070d24fe06ac629afa72c414be67430149bb658",
      "word_count": 12
    },
    {
      "text": "If an item set is very large, consider using a list or table",
      "section_path": [
        "Pickers",
        "Best practices"
      ],
      "source_sentence_hash": "f2772e6ff92826cc74f35e28c9a893f531f098eab1c70512a6320d08b930d9da",
      "word_count": 13
    },
    {
      "text": "Use predictable and logically ordered values",
      "section_path": [
        "Pickers",
        "Best practices"
      ],
      "source_sentence_hash": "dd51dbf9c26f0b792bc4e3315398c6ec09b87a3d1224c07fa4deb8d4e2dac9ba",
      "word_count": 6
    },
    {
      "text": "Avoid switching views to show a picker",
      "section_path": [
        "Pickers",
        "Best practices"
      ],
      "source_sentence_hash": "e3682eccb50c0475be0bb8337a7c9d3b219abde9aeabcae122e9e4870ae2e1e2",
      "word_count": 7
    },
    {
      "text": "Consider providing less granularity when specifying minutes in a date picker",
      "section_path": [
        "Pickers",
        "Best practices"
      ],
      "source_sentence_hash": "7281616659d9b5a3ffb6dd62a5345ffa93d249e828e0eb65f69e3755d98eef63",
      "word_count": 11
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "Pickers",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "Compact — A button that displays editable date and time content in a modal view",
      "section_path": [
        "Pickers",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "f884562d804a1c4a94d1443b235afe99efc4792defb9ab2b5a9e038615734888",
      "word_count": 15
    },
    {
      "text": "Inline — For time only, a button that displays wheels of values; for dates and times, an inline calendar",
      "section_path": [
        "Pickers",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "2f66f093294a121d9fda37f302afbd9e523688747b99503a6794995fad838d0d",
      "word_count": 19
    },
    {
      "text": "Wheels — A set of scrolling wheels that also supports data entry through built-in or external keyboards",
      "section_path": [
        "Pickers",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "f1b2333ffb7d0db031644939962a78fd222ab6ac80756b3a63b3502753cb606e",
      "word_count": 17
    },
    {
      "text": "Automatic — A system-determined style based on the current platform and date picker mode",
      "section_path": [
        "Pickers",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "70acb23887a34afef200758f07bc6a757710a7d112b06f61ee3eb146165e5b73",
      "word_count": 14
    },
    {
      "text": "Date — Displays months, days of the month, and years",
      "section_path": [
        "Pickers",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "1e5192e33d339cfe0d3a86ebdeb6d8cdc7aef925689b0d672ff2276a2a92e1d9",
      "word_count": 10
    },
    {
      "text": "Time — Displays hours, minutes, and (optionally) an AM/PM designation",
      "section_path": [
        "Pickers",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "a60468143cfcf8a2165ca0cb6593dcc3ddbcaccc58c7bf5ae3c96f78cc691c90",
      "word_count": 10
    },
    {
      "text": "Date and time — Displays dates, hours, minutes, and (optionally) an AM/PM designation",
      "section_path": [
        "Pickers",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "db21f355a0c9bf0fb76dc33634a404ac7a816b1de209b8f6af1a4b46316e732c",
      "word_count": 13
    },
    {
      "text": "Keep countdown timer values within 23 hours and 59 minutes",
      "section_path": [
        "Pickers",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "eb8c3dc4e3ed02ef8c8f63230cd477bb5d6e908bf36c167dda4e29b1d393a9ff",
      "word_count": 10
    },
    {
      "text": "Use a compact date picker when space is constrained",
      "section_path": [
        "Pickers",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "e31a6c9ceccde58f1aa1cbb394e70fdefb601e2383fb255831e0819346bb97d7",
      "word_count": 9
    },
    {
      "text": "Choose a date picker style that suits your app",
      "section_path": [
        "Pickers",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "938279b324e3e9d65cac89c5e69aef258d6a183f77bf55016f2f5d122c7d2b87",
      "word_count": 9
    },
    {
      "text": "Developer documentation",
