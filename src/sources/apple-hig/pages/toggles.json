  "guidance_candidates": [
    {
      "text": "Use a toggle to help people choose between two opposing values that affect the state of content or a",
      "section_path": [
        "Toggles",
        "Best practices"
      ],
      "source_sentence_hash": "e51a82db925e1c93d8e571f3e34c04d2a3803b10732e16122146e118ea28d3f5",
      "word_count": 19
    },
    {
      "text": "Clearly identify the setting, view, or content the toggle affects",
      "section_path": [
        "Toggles",
        "Best practices"
      ],
      "source_sentence_hash": "6af6b64058548fd0a584ebc64a0547f58616c09f5b56533330c27c204cad9afd",
      "word_count": 10
    },
    {
      "text": "Make sure the visual differences in a toggle’s state are obvious",
      "section_path": [
        "Toggles",
        "Best practices"
      ],
      "source_sentence_hash": "9635e708a0d822ef29f6c14432efafdc8bf6e0fcb451a28aa1ee9f54a3d0e09e",
      "word_count": 11
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "Toggles",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "Use the switch toggle style only in a list row",
      "section_path": [
        "Toggles",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "51aeb46e5bb070d31b913a93bc3e28074e14d811e987be3924e76d1e90b6847f",
      "word_count": 10
    },
    {
      "text": "Change the default color of a switch only if necessary",
      "section_path": [
        "Toggles",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "7a55dfe415c4c23f18778219fdc30cb8db71bf46b17791193fd164514be14537",
      "word_count": 10
    },
    {
      "text": "Outside of a list, use a button that behaves like a toggle, not a switch",
      "section_path": [
        "Toggles",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "9ae8e6971f43e44ae329add52a19b10eaa690abb982b0d880cbdd27cd6241892",
      "word_count": 15
    },
    {
      "text": "Avoid supplying a label that explains the button’s purpose",
      "section_path": [
        "Toggles",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "9d6a3246bedfb79765051fc82a2fd73b2d99e24c571338493cdbdfea64b079ea",
      "word_count": 9
    },
    {
      "text": "Use switches, checkboxes, and radio buttons in the window body, not the window frame",
      "section_path": [
        "Toggles",
        "Platform considerations",
        "macOS"
      ],
      "source_sentence_hash": "b3d7592fdf95417ebb1312694cd65a86bf4fcc25023892172b40ec1bcaeb90d2",
      "word_count": 14
    },
    {
      "text": "Prefer a switch for settings that you want to emphasize",
      "section_path": [
        "Toggles",
        "Platform considerations",
        "macOS",
        "Switches"
      ],
      "source_sentence_hash": "bd17b9e80f534739c58a6ed8f1fd15bb1d10ca20e04cf20b6a77411b3d2bcb48",
      "word_count": 10
    },
    {
      "text": "Within a grouped form, consider using a mini switch to control the setting in a single row",
      "section_path": [
        "Toggles",
        "Platform considerations",
        "macOS",
        "Switches"
      ],
      "source_sentence_hash": "72f36e68eb6520ee41f9a0cc09e1c9da005ed52013bad6669c3db4e368017f2e",
      "word_count": 17
    },
    {
      "text": "In general, don’t replace a checkbox with a switch",
      "section_path": [
        "Toggles",
        "Platform considerations",
        "macOS",
        "Switches"
      ],
      "source_sentence_hash": "365fd6cd04436d76a79be4cad78e3f58f97970b380482524baa9d75b98f3d9cc",
      "word_count": 9
    },
    {
      "text": "Use a checkbox instead of a switch if you need to present a hierarchy of settings",
      "section_path": [
        "Toggles",
        "Platform considerations",
        "macOS",
        "Checkboxes"
      ],
      "source_sentence_hash": "be57527ad2d2e0c00ea9fa623bae4535ff889693f6de57a67ced87578a9dba9c",
      "word_count": 16
    },
    {
      "text": "Consider using radio buttons if you need to present a set of more than two mutually exclusive options",
      "section_path": [
        "Toggles",
        "Platform considerations",
        "macOS",
        "Checkboxes"
      ],
      "source_sentence_hash": "b3d1a44aaae285f14b9f72b47502af4489a17b8ccda2a43850a0a83527fc8b5e",
      "word_count": 18
    },
    {
      "text": "Consider using a label to introduce a group of checkboxes if their relationship isn’t clear",
      "section_path": [
        "Toggles",
        "Platform considerations",
        "macOS",
        "Checkboxes"
      ],
      "source_sentence_hash": "201c99a41c2b5e4936850f9353fa24fbfa28b06de573333a49fafca5342ad9d1",
      "word_count": 15
    },
    {
      "text": "Accurately reflect a checkbox’s state in its appearance",
      "section_path": [
        "Toggles",
        "Platform considerations",
        "macOS",
        "Checkboxes"
      ],
      "source_sentence_hash": "8315d88948bb7e28f7b7cf0188989bfc6b07b153defc00f6547b9c9712a196d5",
      "word_count": 8
    },
    {
      "text": "Radio buttons",
      "section_path": [
        "Toggles",
        "Platform considerations",
        "macOS",
        "Radio buttons"
      ],
      "source_sentence_hash": "0fe6209f74a65d6724f796b781da10805fd876ecbb76f31cf8b0554adc99461d",
      "word_count": 2
    },
    {
      "text": "Prefer a set of radio buttons to present mutually exclusive options",
      "section_path": [
        "Toggles",
        "Platform considerations",
        "macOS",
        "Radio buttons"
      ],
      "source_sentence_hash": "1b645a87c66bc01500914e4c18be85f95fb7412964a8b353e03429b70c9ec5e2",
      "word_count": 11
    },
    {
      "text": "Avoid listing too many radio buttons in a set",
      "section_path": [
        "Toggles",
        "Platform considerations",
        "macOS",
        "Radio buttons"
      ],
      "source_sentence_hash": "af558efeb7963470de409312343f458818ee72c5d71ce80c7844c8b826a2da93",
      "word_count": 9
    },
    {
      "text": "To present a single setting that can be on or off, prefer a checkbox",
      "section_path": [
        "Toggles",
        "Platform considerations",
        "macOS",
        "Radio buttons"
      ],
      "source_sentence_hash": "8a44bbe34b57ed94a432e7e43fd03ba6af36cd4641bdfa7199813afd8b22bdb0",
      "word_count": 14
    },
    {
      "text": "Use consistent spacing when you display radio buttons horizontally",
      "section_path": [
        "Toggles",
        "Platform considerations",
        "macOS",
        "Radio buttons"
      ],
      "source_sentence_hash": "d53e9bed2dbdbd9406a2c8229a10d5e53c09d1121118dd3bd7939e19c50bd69c",
      "word_count": 9
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Toggles",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
