  "guidance_candidates": [
    {
      "text": "The current status of something",
      "section_path": [
        "Feedback"
      ],
      "source_sentence_hash": "c0c28041644681373f2be690fc4555cdaebf4355030976817b342ea3ffd1ed8c",
      "word_count": 5
    },
    {
      "text": "The success or failure of an important task or action",
      "section_path": [
        "Feedback"
      ],
      "source_sentence_hash": "28fa235c8feb2dab8112bdca6953d10a4d9228636163113f5e5e427c66f95578",
      "word_count": 10
    },
    {
      "text": "A warning about an action that can have negative consequences",
      "section_path": [
        "Feedback"
      ],
      "source_sentence_hash": "b035fbcc5cfa730a6cddaa5224d9cc9cdf1298bcaca603d91cd4eabf21c7eca0",
      "word_count": 10
    },
    {
      "text": "An opportunity to correct a mistake or problematic situation",
      "section_path": [
        "Feedback"
      ],
      "source_sentence_hash": "23c4536f984860c1707e9ad6e983fbd1328bfeaadf111e79c777184fa09d90e7",
      "word_count": 9
    },
    {
      "text": "Match feedback delivery to the significance of the information",
      "section_path": [
        "Feedback"
      ],
      "source_sentence_hash": "4bffe1538c4283103b0693b22ad74aedfb1a4d7f31ccb895ac09f9625067fb2a",
      "word_count": 9
    },
    {
      "text": "Make sure all feedback is accessible",
      "section_path": [
        "Feedback",
        "Best practices"
      ],
      "source_sentence_hash": "14e63533792a4c0b44c538732f496dc77b5aeb5c8ee3b4fab3edf0b83922893e",
      "word_count": 6
    },
    {
      "text": "Consider integrating status feedback into your interface",
      "section_path": [
        "Feedback",
        "Best practices"
      ],
      "source_sentence_hash": "c6f20b1f44c8212b38a73e701cbc8f8f9ce913cffa4f2b82b1b96a3315e8b523",
      "word_count": 7
    },
    {
      "text": "Use alerts to deliver critical — and ideally actionable — information",
      "section_path": [
        "Feedback",
        "Best practices"
      ],
      "source_sentence_hash": "ca53bac4d64b40cb000b3b8080658d724b7316ece4ec5ac6959c538e5518d789",
      "word_count": 11
    },
    {
      "text": "Avoid overusing alerts or using them for unimportant information",
      "section_path": [
        "Feedback",
        "Best practices"
      ],
      "source_sentence_hash": "58954f5ff51cafde27e65c4f0dec396a30bd6377eb79af3f4449245e1fcc950c",
      "word_count": 9
    },
    {
      "text": "Warn people when they initiate a task that can cause data loss that’s unexpected and irreversible",
      "section_path": [
        "Feedback",
        "Best practices"
      ],
      "source_sentence_hash": "aa71751d251e5f94823bf1338903171f0319458ac06cae85b8b7889f84dd6374",
      "word_count": 16
    },
    {
      "text": "Do not warn people when data loss is the expected result of their action",
      "section_path": [
        "Feedback",
        "Best practices"
      ],
      "source_sentence_hash": "ca465d44b934d91fbec5b6a6e3ba75c5bc094bd32479b1e6fb02634ff116bf78",
      "word_count": 13
    },
    {
      "text": "Confirm significant action or task completion when appropriate",
      "section_path": [
        "Feedback",
        "Best practices"
      ],
      "source_sentence_hash": "cac234ee3cf09a530533fbbc05ded15237043e4fd6dc0462367644bf1e58cc0c",
      "word_count": 8
    },
    {
      "text": "Show people when a command can’t be carried out and help them understand why",
      "section_path": [
        "Feedback",
        "Best practices"
      ],
      "source_sentence_hash": "7b25f027e4cbce2b4dd78078b00c0c3315d289e9030354674faf8e2f90d0fda1",
      "word_count": 14
    },
    {
      "text": "Avoid displaying an indeterminate progress indicator — such as a loading indicator — in a watchOS app",
      "section_path": [
        "Feedback",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "420fcaba4dd3699def22e362ff1c5d1208465974a0c86392a1638a670e1ac8ce",
      "word_count": 17
    },
    {
      "text": "Provide a notification when a watchOS process completes",
      "section_path": [
        "Feedback",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "4b0cf2e968eda984d5833454c6f328902f70ddc48ec298be0650915a97b0b77c",
      "word_count": 8
    },
