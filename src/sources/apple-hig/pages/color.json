  "guidance_candidates": [
    {
      "text": "Avoid using the same color to mean different things",
      "section_path": [
        "Color",
        "Best practices"
      ],
      "source_sentence_hash": "6e8087fc021638dca96ab75ee4d1bd788f0089498909e0e80685de9e4e01554f",
      "word_count": 9
    },
    {
      "text": "Make sure all your app’s colors work well in light, dark, and increased contrast contexts",
      "section_path": [
        "Color",
        "Best practices"
      ],
      "source_sentence_hash": "92900882fe7b145fd638bc85cf1b7f0f113b34f45003d8090782f4841a6ef57d",
      "word_count": 15
    },
    {
      "text": "Prefer system colors that already provide appearance and contrast variants",
      "section_path": [
        "Color",
        "Best practices"
      ],
      "source_sentence_hash": "92900882fe7b145fd638bc85cf1b7f0f113b34f45003d8090782f4841a6ef57d",
      "word_count": 10
    },
    {
      "text": "Make sure every custom color supplies light, dark, and increased-contrast variants",
      "section_path": [
        "Color",
        "Best practices"
      ],
      "source_sentence_hash": "92900882fe7b145fd638bc85cf1b7f0f113b34f45003d8090782f4841a6ef57d",
      "word_count": 10
    },
    {
      "text": "Test your app’s color scheme under a variety of lighting conditions",
      "section_path": [
        "Color",
        "Best practices"
      ],
      "source_sentence_hash": "0cda5079571cd79ed3bf7b6bf005d8311a20ca09cfd6c361a073d68c2d14689a",
      "word_count": 11
    },
    {
      "text": "Test your app on different devices",
      "section_path": [
        "Color",
        "Best practices"
      ],
      "source_sentence_hash": "06dd9786a84cc2eb5dc8de027f13b3177d4eee3fc7beda61eb7b5f8c43c5f857",
      "word_count": 6
    },
    {
      "text": "Consider how artwork and translucency affect nearby colors",
      "section_path": [
        "Color",
        "Best practices"
      ],
      "source_sentence_hash": "b974af5dc9f731fa462149b773b647abf10959d27046a083a0270d9460437ce5",
      "word_count": 8
    },
    {
      "text": "Prefer system-provided color controls when people choose colors",
      "section_path": [
        "Color",
        "Best practices"
      ],
      "source_sentence_hash": "7e41efbf4cbeaa54aea4a3ef1019c19f168718fc03cbf77b428e0219a20f2e1b",
      "word_count": 8
    },
    {
      "text": "Avoid relying solely on color to differentiate between objects, indicate interactivity, or communicate essential information",
      "section_path": [
        "Color",
        "Inclusive color"
      ],
      "source_sentence_hash": "6f9c3b95fc4ded5c71796061669993b0941405c4ef1643fa9fd737acd61368eb",
      "word_count": 15
    },
    {
      "text": "Be sure to provide noncolor alternatives whenever color conveys information",
      "section_path": [
        "Color",
        "Inclusive color"
      ],
      "source_sentence_hash": "6f9c3b95fc4ded5c71796061669993b0941405c4ef1643fa9fd737acd61368eb",
      "word_count": 10
    },
    {
      "text": "Avoid using colors that make it hard to perceive content in your app",
      "section_path": [
        "Color",
        "Inclusive color"
      ],
      "source_sentence_hash": "79dd174bdbc9b810f94ab71c6711a2410490a61b9428557243bf5e852eebc289",
      "word_count": 13
    },
    {
      "text": "Consider how the colors you use might be perceived in other countries and cultures",
      "section_path": [
        "Color",
        "Inclusive color"
      ],
      "source_sentence_hash": "e9f220867bce798eb39219cf73a9d87d2dca542b1a167d79486445fe53f8aab2",
      "word_count": 14
    },
    {
      "text": "Make sure colors send the intended message in every supported culture",
      "section_path": [
        "Color",
        "Inclusive color"
      ],
      "source_sentence_hash": "e9f220867bce798eb39219cf73a9d87d2dca542b1a167d79486445fe53f8aab2",
      "word_count": 10
    },
    {
      "text": "Avoid hard-coding system color values in your app",
      "section_path": [
        "Color",
        "System colors"
      ],
      "source_sentence_hash": "c8e1cc72552afb63debe3c25602ce309d120926bf411beb62535f92d38dc2661",
      "word_count": 8
    },
    {
      "text": "Avoid redefining the semantic meanings of dynamic system colors",
      "section_path": [
        "Color",
        "System colors"
      ],
      "source_sentence_hash": "94c6e31d2a58a88fae449f85a9d1186124a497cf92eee559a44df3a477aacd6b",
      "word_count": 9
    },
    {
      "text": "Apply color sparingly to the Liquid Glass material, and to symbols or text on the material",
      "section_path": [
        "Color",
        "Liquid Glass color"
      ],
      "source_sentence_hash": "3a3a3ba533d13aa7f48a923383e3a2a7d00a6d70ca9d9b208b1a1ce83195491e",
      "word_count": 16
    },
    {
      "text": "Apply color to a Liquid Glass background rather than its symbol or text when emphasizing a primary action",
      "section_path": [
        "Color",
        "Liquid Glass color"
      ],
      "source_sentence_hash": "3a3a3ba533d13aa7f48a923383e3a2a7d00a6d70ca9d9b208b1a1ce83195491e",
      "word_count": 17
    },
    {
      "text": "Avoid adding color to the backgrounds of multiple Liquid Glass controls",
      "section_path": [
        "Color",
        "Liquid Glass color"
      ],
      "source_sentence_hash": "3a3a3ba533d13aa7f48a923383e3a2a7d00a6d70ca9d9b208b1a1ce83195491e",
      "word_count": 11
    },
    {
      "text": "Avoid using similar colors in control labels if your app has a colorful background",
      "section_path": [
        "Color",
        "Liquid Glass color"
      ],
      "source_sentence_hash": "470b1a0acf39b145a5f0e478451c4cd90c76e85efd5ba31b6d4a2341b34277b3",
      "word_count": 14
    },
    {
      "text": "Be aware of the placement of color in the content layer",
      "section_path": [
        "Color",
        "Liquid Glass color"
      ],
      "source_sentence_hash": "895a5dfd5b22d7b0914543ce45d347372e4bc23b92dc67f1a6f63160bc1bddc8",
      "word_count": 11
    },
    {
      "text": "Make sure the default or resting state maintains clear legibility",
      "section_path": [
        "Color",
        "Liquid Glass color"
      ],
      "source_sentence_hash": "895a5dfd5b22d7b0914543ce45d347372e4bc23b92dc67f1a6f63160bc1bddc8",
      "word_count": 10
    },
    {
      "text": "Apply color profiles to your images",
      "section_path": [
        "Color",
        "Color management"
      ],
      "source_sentence_hash": "163f962e06a262f4701b9f4bd540f59bf5986c27ae26bfda1d6fdbd4424c4937",
      "word_count": 6
    },
    {
      "text": "Use wide color to enhance the visual experience on compatible displays",
      "section_path": [
        "Color",
        "Color management"
      ],
      "source_sentence_hash": "6be3b1109c1afcec9728e38755172078dc7dac57db8cd0145424bba83e995dfd",
      "word_count": 11
    },
    {
      "text": "Use Display P3 at 16 bits per channel and PNG when wide color is appropriate",
      "section_path": [
        "Color",
        "Color management"
      ],
      "source_sentence_hash": "6be3b1109c1afcec9728e38755172078dc7dac57db8cd0145424bba83e995dfd",
      "word_count": 15
    },
    {
      "text": "You need to use a wide-color display when designing wide-color images or selecting P3 colors",
      "section_path": [
        "Color",
        "Color management"
      ],
      "source_sentence_hash": "6be3b1109c1afcec9728e38755172078dc7dac57db8cd0145424bba83e995dfd",
      "word_count": 15
    },
    {
      "text": "Provide color space–specific image and color variations if necessary",
      "section_path": [
        "Color",
        "Color management"
      ],
      "source_sentence_hash": "4dde7c2c244928e70a6745ce87858ae5c71be3579f66737015e3bfbda38149fc",
      "word_count": 9
    },
    {
      "text": "iOS, iPadOS",
      "section_path": [
        "Color",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "aea7203623b032aeb5e694acb18f1b1ac4defd9a0428ff1d7826233c1b3c3a21",
      "word_count": 2
    },
    {
      "text": "Use grouped background colors for grouped iOS and iPadOS table views",
      "section_path": [
        "Color",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "56a5bd6c465d02b77049f297a362c6b853ab5202d6c233f53b84a7ec02e6e084",
      "word_count": 11
    },
    {
      "text": "Use system background colors for other iOS and iPadOS views",
      "section_path": [
        "Color",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "56a5bd6c465d02b77049f297a362c6b853ab5202d6c233f53b84a7ec02e6e084",
      "word_count": 10
    },
    {
      "text": "Use primary iOS and iPadOS background colors for the overall view",
      "section_path": [
        "Color",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "09c80e54d3b46f2e21a39a764a900c0aad240ef9ec4e1be86533d0ac6557e2a0",
      "word_count": 11
    },
    {
      "text": "Use secondary iOS and iPadOS background colors to group content within the overall view",
      "section_path": [
        "Color",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "5aea2d28e8e5bc89a656b741ec9aca78205570a35f42db727e4c1431604eab2a",
      "word_count": 14
    },
    {
      "text": "Use tertiary iOS and iPadOS background colors to group content within secondary elements",
      "section_path": [
        "Color",
        "Platform considerations",
        "iOS, iPadOS"
      ],
      "source_sentence_hash": "154557c661737d53183c9d0f5f1d8a8610fb2f7581847c2ea6ff3f1118bb4b4d",
      "word_count": 13
    },
    {
      "text": "App accent colors",
      "section_path": [
        "Color",
        "Platform considerations",
        "macOS",
        "App accent colors"
      ],
      "source_sentence_hash": "3945e6bc6536fea5b7506ad3ab0aa3593357ee77fdb84e14c8f4164bde201e16",
      "word_count": 3
    },
    {
      "text": "Consider choosing a limited color palette that coordinates with your app logo",
      "section_path": [
        "Color",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "8d62cd1119b3dfbd3b819396a6f4f7e2cee9978e8d5bb7b9692adcdbba220b8e",
      "word_count": 12
    },
    {
      "text": "Avoid using only color to indicate focus",
      "section_path": [
        "Color",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "ccdad087e51f83d91f2a2dca05b455b550316d04a32f809378fd7cd897b35681",
      "word_count": 7
    },
    {
      "text": "Use color sparingly, especially on glass",
      "section_path": [
        "Color",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "894b827411a85abbea465c6d018eb0365379a16e2c1b5d339b9a7777fa95e121",
      "word_count": 6
    },
    {
      "text": "Prefer using color in bold text and large areas",
      "section_path": [
        "Color",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "d5edc94b001b908682b0cc50c060b5f220b063b1e75a36206041b9a87722966f",
      "word_count": 9
    },
    {
      "text": "In a fully immersive experience, help people maintain visual comfort by keeping brightness levels balanced",
      "section_path": [
        "Color",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "ddec3a6f8104cbc47dfa8c9693f631420473603c78c82ba4ec193c7b69c7ed0b",
      "word_count": 15
    },
    {
      "text": "Use background color to support existing content or supply additional information",
      "section_path": [
        "Color",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "57b5d2c9caeaa4377117850bdff69684505820f0c83f3be7c805a43dc9b00948",
      "word_count": 11
    },
    {
      "text": "Recognize that people might prefer graphic complications to use tinted mode instead of full color",
      "section_path": [
        "Color",
        "Platform considerations",
        "watchOS"
      ],
      "source_sentence_hash": "77d29238ffe92208cc2c0343e587ca0aa159bd7c5f8e4b1adf2a5f9e0b82165d",
      "word_count": 15
    },
    {
      "text": "System colors",
      "section_path": [
        "Color",
        "Specifications",
        "System colors"
      ],
      "source_sentence_hash": "ec8fa25cd40a4665742d45f78a57c6a42f4649e288e39a00040c713ab658996d",
      "word_count": 2
    },
    {
      "text": "iOS, iPadOS system gray colors",
      "section_path": [
        "Color",
        "Specifications",
        "iOS, iPadOS system gray colors"
      ],
      "source_sentence_hash": "a9da547d8ef6c129ada595bf5d57464329b88f6f3aab9c582674b7f3de89e6ef",
      "word_count": 5
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Color",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
