  "guidance_candidates": [
    {
      "text": "Help merchants accept Tap to Pay on iPhone terms and conditions before they begin interacting with their customers",
      "section_path": [
        "Tap to Pay on iPhone",
        "Enabling Tap to Pay on iPhone"
      ],
      "source_sentence_hash": "fbe3fbf991efef5fef8d57b0c4c4a64a1fcad7c285fa8f6ecacc70dee39d300e",
      "word_count": 18
    },
    {
      "text": "Present Tap to Pay on iPhone terms and conditions only to an administrative user",
      "section_path": [
        "Tap to Pay on iPhone",
        "Enabling Tap to Pay on iPhone"
      ],
      "source_sentence_hash": "9beb8c48fc627943c2714539e791411252fb8d7a0aedbaf588f000e3a17c88ca",
      "word_count": 14
    },
    {
      "text": "If necessary, help merchants make sure their device is up to date",
      "section_path": [
        "Tap to Pay on iPhone",
        "Enabling Tap to Pay on iPhone"
      ],
      "source_sentence_hash": "45303d26befd4fe7ef868adc69d00414b2f208e4edf457de22eb981e637258fe",
      "word_count": 12
    },
    {
      "text": "Provide a tutorial that describes the supported payment types and shows how to use Tap to Pay on iPhone",
      "section_path": [
        "Tap to Pay on iPhone",
        "Educating merchants"
      ],
      "source_sentence_hash": "0068a7bfb181d77f117763e47389be1743d7fa8384a875f6f95102d85e03216c",
      "word_count": 19
    },
    {
      "text": "Including it in a Learn More option in your in-app messaging",
      "section_path": [
        "Tap to Pay on iPhone",
        "Educating merchants"
      ],
      "source_sentence_hash": "c650b31e9eb01b905e8af4e4b3cfa25401252d109f6642553b6f8bb922e422f5",
      "word_count": 11
    },
    {
      "text": "Automatically presenting it after merchants accept the Tap to Pay on iPhone terms and conditions",
      "section_path": [
        "Tap to Pay on iPhone",
        "Educating merchants"
      ],
      "source_sentence_hash": "112b67c59ce5b34e0cf8ec02a8b21bc2422e0ca77b53429f5b1d6663f7ab9040",
      "word_count": 15
    },
    {
      "text": "Automatically presenting it to new users of your app",
      "section_path": [
        "Tap to Pay on iPhone",
        "Educating merchants"
      ],
      "source_sentence_hash": "25cba7c6c646513b489b4de493e4bcef6609449d5657cfd42c06b5918195b56a",
      "word_count": 9
    },
    {
      "text": "Making it easy to find in a consistent place like your app’s help content or settings area",
      "section_path": [
        "Tap to Pay on iPhone",
        "Educating merchants"
      ],
      "source_sentence_hash": "a4e63e7915f7efd4aebbbd2539fb125e68873b92ffbcc458bff2bb93fedcf5f5",
      "word_count": 17
    },
    {
      "text": "Launch a checkout flow for each type of payment",
      "section_path": [
        "Tap to Pay on iPhone",
        "Educating merchants"
      ],
      "source_sentence_hash": "0b3a677d1ebbc839f15382a27646c724ccda29e748eb3792e5d340f508366518",
      "word_count": 9
    },
    {
      "text": "Help a customer position their contactless card or digital wallet on the merchant’s device for payment",
      "section_path": [
        "Tap to Pay on iPhone",
        "Educating merchants"
      ],
      "source_sentence_hash": "9ceb5664530d97de40c10bb7b08f2100b47c39c3dad69569c00faf1efb6630f6",
      "word_count": 16
    },
    {
      "text": "Handle PIN entry for a card, including accessibility mode",
      "section_path": [
        "Tap to Pay on iPhone",
        "Educating merchants"
      ],
      "source_sentence_hash": "6b03a4302172b00252f45d9834daff7fe1144603cb9c5a2d9281aed639dc3ab4",
      "word_count": 9
    },
    {
      "text": "Offer payment options in addition to Tap to Pay on iPhone, as necessary",
      "section_path": [
        "Tap to Pay on iPhone",
        "Checking out"
      ],
      "source_sentence_hash": "7a8acdc75d40025314dbf1ccc10f8be8276aca06adbae888fdb570051e3c07f2",
      "word_count": 13
    },
    {
      "text": "Respond quickly if a merchant initiates checkout before enabling Tap to Pay on iPhone",
      "section_path": [
        "Tap to Pay on iPhone",
        "Checking out"
      ],
      "source_sentence_hash": "9829698284f951984089ecf8fa2a3940c42dfa238c0b2a001350f0249644b8f4",
      "word_count": 14
    },
    {
      "text": "Help merchants perform checkout even if device configuration is still in progress",
      "section_path": [
        "Tap to Pay on iPhone",
        "Checking out"
      ],
      "source_sentence_hash": "352a770e7f12afc1a8ee86ace0675de33a8724c4ad980bb42d3e51e72dc44d06",
      "word_count": 12
    },
    {
      "text": "Present pre-payment actions that affect the final total before checkout completes",
      "section_path": [
        "Tap to Pay on iPhone",
        "Checking out"
      ],
      "source_sentence_hash": "bb568cf0c7a68bd75f64e4f53b229c4d2f6334adfb5e26f4c8783665422a0fe4",
      "word_count": 11
    },
    {
      "text": "Provide Tap to Pay on iPhone as a checkout option whether the feature is enabled or not",
      "section_path": [
        "Tap to Pay on iPhone",
        "Checking out"
      ],
      "source_sentence_hash": "19f5a98f7c28cfc39d332b3838695b32e999b7cd7826f6b68c02268b8e36d9f1",
      "word_count": 17
    },
    {
      "text": "Avoid making merchants wait to use Tap to Pay on iPhone",
      "section_path": [
        "Tap to Pay on iPhone",
        "Checking out"
      ],
      "source_sentence_hash": "d6e738b1169b0bd677124cb4781d7b0701bd1e8c34f15a094c189e6c45e8d0a2",
      "word_count": 11
    },
    {
      "text": "Make sure the Tap to Pay on iPhone checkout option is available even if configuration is continuing in the",
      "section_path": [
        "Tap to Pay on iPhone",
        "Checking out"
      ],
      "source_sentence_hash": "21f4a1d9f280b131c4f4c244a186b66b19e525958ae5daf8de4c2b862341626a",
      "word_count": 19
    },
    {
      "text": "If your app supports multiple payment-acceptance methods, make the Tap to Pay on iPhone button easy to find",
      "section_path": [
        "Tap to Pay on iPhone",
        "Checking out"
      ],
      "source_sentence_hash": "fb5b5d63c77732f3b0c39db4119a69d5a74df735c04a090eb7be82014853d36f",
      "word_count": 18
    },
    {
      "text": "Make it easy for merchants to switch between Tap to Pay on iPhone and the hardware accessories you support",
      "section_path": [
        "Tap to Pay on iPhone",
        "Checking out"
      ],
      "source_sentence_hash": "a145e88eac95eaa9a31387f8179816032fdc6aaf37b8f69e48165c38c7d511b3",
      "word_count": 19
    },
    {
      "text": "For the label of the button that activates the feature, use “Tap to Pay on iPhone” or, if space",
      "section_path": [
        "Tap to Pay on iPhone",
        "Checking out"
      ],
      "source_sentence_hash": "2e88c78ca2c9fac11dcf96fb3d5d7c491a33c0110152a64a0da715312e96dd8c",
      "word_count": 19
    },
    {
      "text": "Design your Tap to Pay on iPhone button to match the other buttons in your app",
      "section_path": [
        "Tap to Pay on iPhone",
        "Checking out"
      ],
      "source_sentence_hash": "630f2a231018f24a85d7af006031eb37c29353e0a652e2af5c32967640e9eb45",
      "word_count": 16
    },
    {
      "text": "Determine the final amount that customers need to pay before merchants initiate the Tap to Pay on iPhone experience",
      "section_path": [
        "Tap to Pay on iPhone",
        "Checking out"
      ],
      "source_sentence_hash": "3d7c1efeffe0bf1c4d402f995c8ef07a19d1e24fa92795d52d89d999b03135f9",
      "word_count": 19
    },
    {
      "text": "If you support pre-payment options in your checkout flow, display them before the Tap to Pay on iPhone screen",
      "section_path": [
        "Tap to Pay on iPhone",
        "Checking out"
      ],
      "source_sentence_hash": "733157ce69cd100dcdf8519173c4733fc3243e2d63501e67a0c4cd34c7107295",
      "word_count": 19
    },
    {
      "text": "Start processing a transaction as soon as possible",
      "section_path": [
        "Tap to Pay on iPhone",
        "Displaying results"
      ],
      "source_sentence_hash": "c6b9e07baaae61d25a0c369694f75b2d6adb6e68de27aee0f22d686a2e86e33e",
      "word_count": 8
    },
    {
      "text": "Display a progress indicator while payment is authorizing before you show your transaction result screen",
      "section_path": [
        "Tap to Pay on iPhone",
        "Displaying results"
      ],
      "source_sentence_hash": "8fc6dc2e4be2e24cd0f5fd4b7489ae881f84e43c8555afda861bbab4baf82801",
      "word_count": 15
    },
    {
      "text": "Clearly display the result of a transaction, whether it’s declined or successful",
      "section_path": [
        "Tap to Pay on iPhone",
        "Displaying results"
      ],
      "source_sentence_hash": "6af12b8d6e199514126262e2bef8e5506a941d3b0d600ffc627200d6bacb1c90",
      "word_count": 12
    },
    {
      "text": "Help merchants complete the checkout flow when a payment can’t complete with Tap to Pay on iPhone",
      "section_path": [
        "Tap to Pay on iPhone",
        "Displaying results"
      ],
      "source_sentence_hash": "1420b417500db63a7bbd01aa358a5a05f283c5eabc0c65f87b0a5ca791dbf938",
      "word_count": 17
    },
    {
      "text": "Present a new screen or reuse your checkout screen, letting merchants accept an alternate form of payment, like cash",
      "section_path": [
        "Tap to Pay on iPhone",
        "Displaying results"
      ],
      "source_sentence_hash": "0ab98e83d1698c49e7f13b8b1898f144dc11080afa118e7ec9443d44f85f1e64",
      "word_count": 19
    },
    {
      "text": "Support checkout with a different method, like external hardware or a payment link",
      "section_path": [
        "Tap to Pay on iPhone",
        "Displaying results"
      ],
      "source_sentence_hash": "4d0052b9577bc2decedc878bc35604cd3b270fedd4fb2f8dbc757b8b2d164b48",
      "word_count": 13
    },
    {
      "text": "Relaunch Tap to Pay on iPhone, if a customer has another card they want to try",
      "section_path": [
        "Tap to Pay on iPhone",
        "Displaying results"
      ],
      "source_sentence_hash": "b83cf8585e31a29a9fbcf946c6ff95c171f0e9b0e1b6f7a74fee077c782e0e87",
      "word_count": 16
    },
    {
      "text": "If the system returns an error that the merchant must address, display a clear description of the problem and",
      "section_path": [
        "Tap to Pay on iPhone",
        "Displaying results"
      ],
      "source_sentence_hash": "e1ce714f0ca5de03ea7bfa848f4d0d0996e0bf5dd3c16374fe762f3dd1fa6dff",
      "word_count": 19
    },
    {
      "text": "Make it easy for merchants to get help with issues they can’t resolve",
      "section_path": [
        "Tap to Pay on iPhone",
        "Displaying results"
      ],
      "source_sentence_hash": "27e19be38d3e0fb6c10c754a114483e2127e0f371c2ff8256873f08606d44297",
      "word_count": 13
    },
    {
      "text": "Use a generic label in a button that opens the Tap to Pay on iPhone screen to read a",
      "section_path": [
        "Tap to Pay on iPhone",
        "Additional interactions"
      ],
      "source_sentence_hash": "4e35f0a4c3c14438c4ff6f6e531aeee8161624a341b8ea91f63f66b16ddb1896",
      "word_count": 19
    },
    {
      "text": "If your app supports an independent loyalty card transaction, distinguish this flow from a payment-acceptance flow that uses Tap",
      "section_path": [
        "Tap to Pay on iPhone",
        "Additional interactions"
      ],
      "source_sentence_hash": "1d29db32e73be5f40bf0ce3052c4e012a6ac1eb5f4ceb5f762eafab1a49f8c2e",
      "word_count": 19
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Tap to Pay on iPhone",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
