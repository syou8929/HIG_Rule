      "word_count": 5
    },
    {
      "text": "Language and culture",
      "section_path": [
        "Inclusion",
        "Inclusive by design"
      ],
      "source_sentence_hash": "67827e5ee5cdd7270294140541dee8b4503825da742378bac4f69f4126d3fca0",
      "word_count": 3
    },
    {
      "text": "Political or philosophical opinions",
      "section_path": [
        "Inclusion",
        "Inclusive by design"
      ],
      "source_sentence_hash": "215c58a5162e6bd2515d442b53b592dae089d02f69f28d113dd628d5cb71bed8",
      "word_count": 4
    },
    {
      "text": "Social and economic context",
      "section_path": [
        "Inclusion",
        "Inclusive by design"
      ],
      "source_sentence_hash": "96e9e215a9d6d249107b3b3dac7f08899ad2013983611b84cd9876e6350013c0",
      "word_count": 4
    },
    {
      "text": "Consider the tone of your copy from different perspectives",
      "section_path": [
        "Inclusion",
        "Welcoming language"
      ],
      "source_sentence_hash": "f1644d9b0e1f79d3d16bd4c9d807122e11b7ec208892cd06da9b86aeb0a279db",
      "word_count": 9
    },
    {
      "text": "Pay attention to how you refer to people",
      "section_path": [
        "Inclusion",
        "Welcoming language"
      ],
      "source_sentence_hash": "a9db0d521a40d4adfa102008f41a172a82a065c42ee3ffd848ae6bda93a8c139",
      "word_count": 8
    },
    {
      "text": "Avoid using specialized or technical terms without defining them",
      "section_path": [
        "Inclusion",
        "Welcoming language"
      ],
      "source_sentence_hash": "b989a0231b9f7d02713c0e6e2e13c2db4d13b114facdb38782842320e88bfa79",
      "word_count": 9
    },
    {
      "text": "Replace colloquial expressions with plain language",
      "section_path": [
        "Inclusion",
        "Welcoming language"
      ],
      "source_sentence_hash": "c27ba20cfd095e0229bf1c4b847f1703e2ce7a5135116f02ac52b8053da666d1",
      "word_count": 6
    },
    {
      "text": "Consider carefully before including humor",
      "section_path": [
        "Inclusion",
        "Welcoming language"
      ],
      "source_sentence_hash": "426c0ee9786fee0a68acf1aa84b0f8551ca490381cb25c2ee3e229d12254a87b",
      "word_count": 5
    },
    {
      "text": "Build in ways to learn how to use your app or game. Consider designing an onboarding flow that helps",
      "section_path": [
        "Inclusion",
        "Being approachable"
      ],
      "source_sentence_hash": "e7243caddbc1c4d37e1cf39ad138720291f29b6a478e46261053010fec619ca8",
      "word_count": 19
    },
    {
      "text": "What was your favorite subject in college?",
      "section_path": [
        "Inclusion",
        "Avoiding stereotypes"
      ],
      "source_sentence_hash": "640b3f285f204228702dbb3440f459785b17fe60f6a6ff5731f103312ad2061b",
      "word_count": 7
    },
    {
      "text": "What was the make of your first car?",
      "section_path": [
        "Inclusion",
        "Avoiding stereotypes"
      ],
      "source_sentence_hash": "9d6588dd6574c5de3cada6ed2308d24ba73d77186a0dcf186d1fd382506edcd3",
      "word_count": 8
    },
    {
      "text": "How did you feel when you first saw a rainbow?",
      "section_path": [
        "Inclusion",
        "Avoiding stereotypes"
      ],
      "source_sentence_hash": "c18231754e26f9cc9ed9e87b693d36c13318de83437eb1d1fd1b8c2d72de76c5",
      "word_count": 10
    },
    {
      "text": "What’s your favorite activity?",
      "section_path": [
        "Inclusion",
        "Avoiding stereotypes"
      ],
      "source_sentence_hash": "b5cb91917ee6fa4e3ed3c279f28373cc430d983b121527d0fa5dd3e9ba664a56",
      "word_count": 4
    },
    {
      "text": "What was the name of your first friend?",
      "section_path": [
        "Inclusion",
        "Avoiding stereotypes"
      ],
      "source_sentence_hash": "8c7f273fad51ed5383ae269a8cf5b69dec8748dd867f71e3506fb33f055f9653",
      "word_count": 8
    },
    {
      "text": "What quality describes you best?",
      "section_path": [
        "Inclusion",
        "Avoiding stereotypes"
      ],
      "source_sentence_hash": "3727692ace2820b3622d0ce99d5191ea2731af2dbb43376dca21175db7cbbcc8",
      "word_count": 5
    },
    {
      "text": "Each disability is a spectrum. For example, visual disabilities range from low vision to complete blindness, and include things",
      "section_path": [
        "Inclusion",
        "Accessibility"
      ],
      "source_sentence_hash": "a67828d2801a37e01e2c29c666f80101f703d8171533d820adb61ad0b415994e",
      "word_count": 19
    },
    {
      "text": "Avoid images and language that exclude people with disabilities",
      "section_path": [
        "Inclusion",
        "Accessibility"
      ],
      "source_sentence_hash": "26f901784133d45d7ae6ab2b66f8fdf15dda9382385fb3388c6ed10d120fd988",
      "word_count": 9
    },
    {
      "text": "Take a people-first approach when writing about people with disabilities",
      "section_path": [
        "Inclusion",
        "Accessibility"
      ],
      "source_sentence_hash": "d04a152288292719b251194a9e0e36ba204b394ae9b69b154501157255aef87b",
      "word_count": 10
    },
    {
      "text": "Prioritize simplicity and perceivability",
      "section_path": [
        "Inclusion",
        "Accessibility"
      ],
      "source_sentence_hash": "530579d7cc3a13733f8faea8cff6d13691fb42fe48c870335b678089c54511ff",
      "word_count": 4
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Inclusion",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
