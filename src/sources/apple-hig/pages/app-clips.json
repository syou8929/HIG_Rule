  "guidance_candidates": [
    {
      "text": "Allow people to complete a task or a demo in your App Clip",
      "section_path": [
        "App Clips",
        "Designing your App Clip"
      ],
      "source_sentence_hash": "0597f998974148057225df5579f333d29b7cd13b6d48ad3cdbc8aa865835a079",
      "word_count": 13
    },
    {
      "text": "Focus on essential features",
      "section_path": [
        "App Clips",
        "Designing your App Clip"
      ],
      "source_sentence_hash": "69c9bc4dec204791b06ba2266d2616cca743823d625276ecfb3a1b99ddfe2f25",
      "word_count": 4
    },
    {
      "text": "Don’t use App Clips solely for marketing purposes",
      "section_path": [
        "App Clips",
        "Designing your App Clip"
      ],
      "source_sentence_hash": "43278a77b39a1ccdaaabdc02d355628cec43e6f94f220d8d3ae8de88d64c56a9",
      "word_count": 8
    },
    {
      "text": "Avoid using web views in your App Clip",
      "section_path": [
        "App Clips",
        "Designing your App Clip"
      ],
      "source_sentence_hash": "1d50dcda0a1296fa0620168889d4b75f289e2abd8336464e6b48a00df16de5f0",
      "word_count": 8
    },
    {
      "text": "Design a linear, easy-to-use, and focused user interface",
      "section_path": [
        "App Clips",
        "Designing your App Clip"
      ],
      "source_sentence_hash": "6530bd3cb28128b59ed721a99432e4c0887ccf68f143f90abd142828ab343005",
      "word_count": 8
    },
    {
      "text": "On launch, show the most relevant part of your App Clip",
      "section_path": [
        "App Clips",
        "Designing your App Clip"
      ],
      "source_sentence_hash": "9f676cc736ed2a51364b96feb7631209e2f7494f4f84dec58ffbbc386600e775",
      "word_count": 11
    },
    {
      "text": "Ensure people can use your App Clip immediately",
      "section_path": [
        "App Clips",
        "Designing your App Clip"
      ],
      "source_sentence_hash": "67805bd730b245fe834c66d6a977ab3855feb749d90451a452e2d22948fada42",
      "word_count": 8
    },
    {
      "text": "Ensure your App Clip is small",
      "section_path": [
        "App Clips",
        "Designing your App Clip"
      ],
      "source_sentence_hash": "9e38d5bb499ff3004d7edbef121cd5dee4e42cac1d0512250c602a91bb67e4fe",
      "word_count": 6
    },
    {
      "text": "Make the App Clip shareable",
      "section_path": [
        "App Clips",
        "Designing your App Clip"
      ],
      "source_sentence_hash": "a55680a034c00f473aff856aee337ff534d883ec9269e094d518eeade6b60689",
      "word_count": 5
    },
    {
      "text": "Make it easy to pay for a service or product",
      "section_path": [
        "App Clips",
        "Designing your App Clip"
      ],
      "source_sentence_hash": "211c9746622d7912a12f4508f1671b7db43a55c141035168620861dabe7b03eb",
      "word_count": 10
    },
    {
      "text": "Avoid requiring people to create an account before they can benefit from your App Clip",
      "section_path": [
        "App Clips",
        "Designing your App Clip"
      ],
      "source_sentence_hash": "490815f8f8d6bb81081cda1047d51517641c6b2c6949f3856c55402ecaa1e2fa",
      "word_count": 15
    },
    {
      "text": "Provide a familiar, focused experience in your app",
      "section_path": [
        "App Clips",
        "Designing your App Clip"
      ],
      "source_sentence_hash": "734bbec943dd42dae58d2baf412c46c044270297b4e7b36cb63ff44a17119e80",
      "word_count": 8
    },
    {
      "text": "Preserving privacy",
      "section_path": [
        "App Clips",
        "Designing your App Clip",
        "Preserving privacy"
      ],
      "source_sentence_hash": "99ce2c5ab05e6fe667b9410abebc70a0a54eadc38c932b5753089ada0359da14",
      "word_count": 2
    },
    {
      "text": "Limit the amount of data you store and handle yourself",
      "section_path": [
        "App Clips",
        "Designing your App Clip",
        "Preserving privacy"
      ],
      "source_sentence_hash": "1621bf157126d4c07e7576a3b6a15f11aad0aa4f57f853c77a788ce183acff8b",
      "word_count": 10
    },
    {
      "text": "Consider offering Sign in with Apple",
      "section_path": [
        "App Clips",
        "Designing your App Clip",
        "Preserving privacy"
      ],
      "source_sentence_hash": "fe6ec5de00bb62b2734c0ab9aa52e24a3401a34d27a26ea019039de1eaa8d1a2",
      "word_count": 6
    },
    {
      "text": "Offer a secure way to pay for services or goods that also respects people’s privacy",
      "section_path": [
        "App Clips",
        "Designing your App Clip",
        "Preserving privacy"
      ],
      "source_sentence_hash": "2440381c59060774fee4ea8d5dc3b7a27beb924dd52561f911d2cfc1567e68c8",
      "word_count": 15
    },
    {
      "text": "Showcasing your app",
      "section_path": [
        "App Clips",
        "Designing your App Clip",
        "Showcasing your app"
      ],
      "source_sentence_hash": "b3a3258f45df049b205694ea176978edc9c38895171f9b6ff816cfaad41bc76b",
      "word_count": 3
    },
    {
      "text": "Don’t compromise the user experience by asking people to install the full app",
      "section_path": [
        "App Clips",
        "Designing your App Clip",
        "Showcasing your app"
      ],
      "source_sentence_hash": "4561788885f75d286443a1ea5192f3c7c053a4309d7254d6d183adfec0fbdcef",
      "word_count": 13
    },
    {
      "text": "Pick the right time to recommend your app",
      "section_path": [
        "App Clips",
        "Designing your App Clip",
        "Showcasing your app"
      ],
      "source_sentence_hash": "532ddf1dddef0e106f3e521482262ebee97b6a822bcd92eb53585db2e4601be7",
      "word_count": 8
    },
    {
      "text": "Recommend your app in a nonintrusive, polite way",
      "section_path": [
        "App Clips",
        "Designing your App Clip",
        "Showcasing your app"
      ],
      "source_sentence_hash": "5889568ebe412ac19fb0a13c7914213c8a8eb05467b4c46730faa8d390d23280",
      "word_count": 8
    },
    {
      "text": "Limiting notifications",
      "section_path": [
        "App Clips",
        "Designing your App Clip",
        "Limiting notifications"
      ],
      "source_sentence_hash": "b03c0fd5835099c0f9305bc67413b1ef59074171c1bf67145a4fea3d7e68991f",
      "word_count": 2
    },
    {
      "text": "Only ask for permission to use notifications for an extended period of time if it’s really needed",
      "section_path": [
        "App Clips",
        "Designing your App Clip",
        "Limiting notifications"
      ],
      "source_sentence_hash": "269f85ef27b9b3e87ac28cd6fd817585d65954b2322a3f6da01f126ab9b623ed",
      "word_count": 17
    },
    {
      "text": "Keep notifications focused",
      "section_path": [
        "App Clips",
        "Designing your App Clip",
        "Limiting notifications"
      ],
      "source_sentence_hash": "70d37e03eab9f35e4f468e6010841a103c6bb526ab81957fcf537a92c7ce63d3",
      "word_count": 3
    },
    {
      "text": "Use notifications to help people complete a task",
      "section_path": [
        "App Clips",
        "Designing your App Clip",
        "Limiting notifications"
      ],
      "source_sentence_hash": "e39a7489fd186424acf0c8a543024e78870a7f134ef53997ba5cff2e3dd68350",
      "word_count": 8
    },
    {
      "text": "Creating App Clips for businesses",
      "section_path": [
        "App Clips",
        "Designing your App Clip",
        "Creating App Clips for businesses"
      ],
      "source_sentence_hash": "6ba0eea60fd987db7ccb5546374152d28fe32133fb3526ae08f388f67439657f",
      "word_count": 5
    },
    {
      "text": "Use consistent branding",
      "section_path": [
        "App Clips",
        "Designing your App Clip",
        "Creating App Clips for businesses"
      ],
      "source_sentence_hash": "cf0c0d81fc43ac0ab682d96383d22fd01005d0ac5a741acb6860c18eb53eba52",
      "word_count": 3
    },
    {
      "text": "Consider multiple businesses",
      "section_path": [
        "App Clips",
        "Designing your App Clip",
        "Creating App Clips for businesses"
      ],
      "source_sentence_hash": "08bc62428b37a8112c00be642350356a451dab3be5c7ad5b6839821e11618b14",
      "word_count": 3
    },
    {
      "text": "Be informative",
      "section_path": [
        "App Clips",
        "Creating content for an App Clip card"
      ],
      "source_sentence_hash": "a930cada484e05b07e5eb0dad89f87d3cc2fccea3f4c077d5413c2c34b6cd7ec",
      "word_count": 2
    },
    {
      "text": "Prefer photography and graphics",
      "section_path": [
        "App Clips",
        "Creating content for an App Clip card"
      ],
      "source_sentence_hash": "d3571f7aedf89133fdfcd3219235a793e1e7853209e2e192c8373d399290415b",
      "word_count": 4
    },
    {
      "text": "Avoid using text",
      "section_path": [
        "App Clips",
        "Creating content for an App Clip card"
      ],
      "source_sentence_hash": "925e83eb98813be5634b705f875a4915f63804e71df8c4cb9b482ca7f72d3495",
      "word_count": 3
    },
    {
      "text": "Adhere to image requirements",
      "section_path": [
        "App Clips",
        "Creating content for an App Clip card"
      ],
      "source_sentence_hash": "6b2792756899b7a02f7fb83601c08d67dfa1c61b65a8481301befc76f10e4eda",
      "word_count": 4
    },
    {
      "text": "Use concise copy",
      "section_path": [
        "App Clips",
        "Creating content for an App Clip card"
      ],
      "source_sentence_hash": "99e5e5bfc288d4e09af23b13caf272b79734db62e44e76ab80b277cd53c6714f",
      "word_count": 3
    },
    {
      "text": "Pick a verb for the action button that best fits your App Clip",
      "section_path": [
        "App Clips",
        "Creating content for an App Clip card"
      ],
      "source_sentence_hash": "73e132f22dc7e012876c059baec217039e3069b4b0bec1085c9a060843a16caa",
      "word_count": 13
    },
    {
      "text": "Interacting with App Clip Codes",
      "section_path": [
        "App Clips",
        "App Clip Codes",
        "Interacting with App Clip Codes"
      ],
      "source_sentence_hash": "cb40a479ce6fbb4e911c06788475562f46da4aeaf43652141a2269b90826aa11",
      "word_count": 5
    },
    {
      "text": "Displaying App Clip Codes",
      "section_path": [
        "App Clips",
        "App Clip Codes",
        "Displaying App Clip Codes"
      ],
      "source_sentence_hash": "ee425f41052dbd19866967b959d86b3d454920fe6a02c268ee054d5ca256cce4",
      "word_count": 4
    },
    {
      "text": "Include the App Clip logo when space allows",
      "section_path": [
        "App Clips",
        "App Clip Codes",
        "Displaying App Clip Codes"
      ],
      "source_sentence_hash": "9daf3e739be750d138666dd439f40e1ade503af76c747e9cf7649bf4bfa29b6b",
      "word_count": 8
    },
    {
      "text": "Place your App Clip Code on a flat or cylindrical surface only",
      "section_path": [
        "App Clips",
        "App Clip Codes",
        "Displaying App Clip Codes"
      ],
      "source_sentence_hash": "d08bad87c1e2493299ab861f5ba440db21fb2c5b78eeb5f10f0b0f47effb63b7",
      "word_count": 12
    },
    {
      "text": "Help your App Clip Code remain as flat as possible so it’s easy for people to scan",
      "section_path": [
        "App Clips",
        "App Clip Codes",
        "Displaying App Clip Codes"
      ],
      "source_sentence_hash": "fd552c820740c91d4546b1d96db064aaa05809e1527f4f984fed398a9a1b10d1",
      "word_count": 17
    },
    {
      "text": "Place your App Clip Code in a location that helps ensure reliable scanning",
      "section_path": [
        "App Clips",
        "App Clip Codes",
        "Displaying App Clip Codes"
      ],
      "source_sentence_hash": "06d5bf96796c24252e12f3afe026afe8b3546c3c73b28d5b6159079d1661223f",
      "word_count": 13
    },
    {
      "text": "Make sure the App Clip Code is unobstructed",
      "section_path": [
        "App Clips",
        "App Clip Codes",
        "Displaying App Clip Codes"
      ],
      "source_sentence_hash": "23a30b1cb6c13f8334fe9dab9014f2e6ce25ad1c737bd6a84acaef51f20bebf1",
      "word_count": 8
    },
    {
      "text": "Display the App Clip Code in an upright position",
      "section_path": [
        "App Clips",
        "App Clip Codes",
        "Displaying App Clip Codes"
      ],
      "source_sentence_hash": "f23c14f1972e29aa9407993f7a9138f84820ddae690cfeb149acf3f09e9ec6ba",
      "word_count": 9
    },
    {
      "text": "Don’t create App Clip Codes that are too small",
      "section_path": [
        "App Clips",
        "App Clip Codes",
        "Displaying App Clip Codes"
      ],
      "source_sentence_hash": "b0c163f2ba123bc888815f43b6e2e2667686ca8c8eac8ac470df89e834e979ba",
      "word_count": 9
    },
    {
      "text": "Provide enough space between an App Clip Code and adjacent App Clip Codes, graphics, or materials",
      "section_path": [
        "App Clips",
        "App Clip Codes",
        "Displaying App Clip Codes"
      ],
      "source_sentence_hash": "832ed94d6bbf6e078d4fc3a7c9749bb48aeb53dd47dfdfd5ea71c8069758f387",
      "word_count": 16
    },
    {
      "text": "Using clear messaging",
      "section_path": [
        "App Clips",
        "App Clip Codes",
        "Using clear messaging"
      ],
      "source_sentence_hash": "d3e4d8b6d83bed3eda6672c3170029f944e3171828e4d507cb9df8be814b0d32",
      "word_count": 3
    },
    {
      "text": "Adhere to Guidelines for Using Apple Trademarks when referring to your App Clip and App Clip Codes",
      "section_path": [
        "App Clips",
        "App Clip Codes",
        "Using clear messaging"
      ],
      "source_sentence_hash": "6bf24863236be5be8acd542dbe33ff329d631d11362304adead7bd4f6865fcfb",
      "word_count": 17
    },
    {
      "text": "Customizing your App Clip Code",
      "section_path": [
        "App Clips",
        "App Clip Codes",
        "Customizing your App Clip Code"
      ],
      "source_sentence_hash": "b328e911aed41642f75672709e79cd95d8ae9c4e86e51d5514595d84953bc7dd",
      "word_count": 5
    },
    {
      "text": "Always use the generated App Clip Code",
      "section_path": [
        "App Clips",
        "App Clip Codes",
        "Customizing your App Clip Code"
      ],
      "source_sentence_hash": "4bdbafe3bcef124ce9ec0793e8137ef0b64605e37ca1e6e17a20f7211df8e556",
      "word_count": 7
    },
    {
      "text": "Choose colors with enough contrast that ensure accurate scanning",
      "section_path": [
        "App Clips",
        "App Clip Codes",
        "Customizing your App Clip Code"
      ],
      "source_sentence_hash": "8f38074d913592fff6a4b841c5d96c65c47c34e4717e81c89c8c4763feabb886",
      "word_count": 9
    },
    {
      "text": "Use high-quality, non-textured print materials",
      "section_path": [
        "App Clips",
        "Printing guidelines"
      ],
      "source_sentence_hash": "718773805143a1376840a0637c5508ee362fdb42d73b3c9810c32c53fa65ae6c",
      "word_count": 5
    },
    {
      "text": "Use high-resolution images and printer settings",
      "section_path": [
        "App Clips",
        "Printing guidelines"
      ],
      "source_sentence_hash": "cbd7f6027945a92502b1a8405f3ada22b8bc62fb9a37cc88c745838d5842c691",
      "word_count": 6
    },
    {
      "text": "Use correct color settings when you convert the generated SVG file to a CMYK image",
      "section_path": [
        "App Clips",
        "Printing guidelines"
      ],
      "source_sentence_hash": "b047a8ffc640276ddde8c406eba09ae54c109a4dcd4cced71480ac07ae6341a7",
      "word_count": 15
    },
    {
      "text": "If you’re using a printer that only prints in grayscale, only generate grayscale App Clip Codes",
      "section_path": [
        "App Clips",
        "Printing guidelines"
      ],
      "source_sentence_hash": "ec6087dd5480fd43cafe55a29d82a5dd41bc71c90731ecf642d624f88d803bd1",
      "word_count": 16
    },
    {
      "text": "For NFC-integrated App Clip Codes, choose Type 5 NFC tags",
      "section_path": [
        "App Clips",
        "Printing guidelines"
      ],
      "source_sentence_hash": "5140ddfb00bfffcb9beac5fcfc9037958d9bd2ab67b280496506775682f4cfa9",
      "word_count": 10
    },
    {
      "text": "If you create large batches of App Clip Codes, thoroughly test your printing workflow, and verify printed App Clip",
      "section_path": [
        "App Clips",
        "Printing guidelines"
      ],
      "source_sentence_hash": "42aac722c2c9cacd7918209424ce75a6e3de04a13f017ca6611fb16b21f1b438",
      "word_count": 19
    },
    {
      "text": "Verifying your printer’s calibration",
      "section_path": [
        "App Clips",
        "Printing guidelines",
        "Verifying your printer’s calibration"
      ],
      "source_sentence_hash": "fef42c16d374c6718a25d6d7bb835f08a30e1fc5853adccb58d39abe6140f6c9",
      "word_count": 4
    },
    {
      "text": "Verify print quality of your chosen color pair with the printer calibration test sheet that shows text boxes for",
      "section_path": [
        "App Clips",
        "Printing guidelines",
        "Verifying your printer’s calibration"
      ],
      "source_sentence_hash": "624aa2eb7695d2576dccaeee4e6739c049a4c698b1a4902b49273c7eef3853a8",
      "word_count": 19
    },
    {
      "text": "Verify your printer’s grayscale settings by printing the printer calibration test sheet that shows two grayscale bars",
      "section_path": [
        "App Clips",
        "Printing guidelines",
        "Verifying your printer’s calibration"
      ],
      "source_sentence_hash": "c9ba61bc252ef416c7e4f8c93af3e1db2e5bd41b6d9d6ac1a8e186cd0f6b57c7",
      "word_count": 17
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "App Clips",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
