  "guidance_candidates": [
    {
      "text": "Let people play as soon as installation completes",
      "section_path": [
        "Designing for games",
        "Jump into gameplay"
      ],
      "source_sentence_hash": "b62d34c891df93c8090ba9d09e9f8b676da45bf49449b8fdeee20ac2f55626bf",
      "word_count": 8
    },
    {
      "text": "Keep the initial download time to 30 minutes or less",
      "section_path": [
        "Designing for games",
        "Jump into gameplay"
      ],
      "source_sentence_hash": "d77af14c0d12eac1339745ac1dc2dff49d0207cac023331c45e45abd8a615757",
      "word_count": 10
    },
    {
      "text": "Keep additional content downloading in the background",
      "section_path": [
        "Designing for games",
        "Jump into gameplay"
      ],
      "source_sentence_hash": "d77af14c0d12eac1339745ac1dc2dff49d0207cac023331c45e45abd8a615757",
      "word_count": 7
    },
    {
      "text": "Provide great default settings",
      "section_path": [
        "Designing for games",
        "Jump into gameplay"
      ],
      "source_sentence_hash": "9aa6c89a639f1f6d3a5568ea2f641edbda13175fe3e5390294c04a06467c0b4a",
      "word_count": 4
    },
    {
      "text": "Make sure your game supports the platform’s most common interaction methods",
      "section_path": [
        "Designing for games",
        "Jump into gameplay"
      ],
      "source_sentence_hash": "0b0ec25804c2f6476aa915a20649e10bbd9f5ba8f90cf60f5ecc23fa1d8929f5",
      "word_count": 10
    },
    {
      "text": "Use gameplay to teach players",
      "section_path": [
        "Designing for games",
        "Jump into gameplay"
      ],
      "source_sentence_hash": "1a3286f377e2a73237c6f7b1f3ec915ed7013bbe02f88d51ea69fb39459a4243",
      "word_count": 5
    },
    {
      "text": "Defer requests until the right time",
      "section_path": [
        "Designing for games",
        "Jump into gameplay"
      ],
      "source_sentence_hash": "694862f249e86862bbec754d3c1b23591c59463eb19dfa0833e876e3b2cc4646",
      "word_count": 6
    },
    {
      "text": "You must first get the player’s permission",
      "section_path": [
        "Designing for games",
        "Jump into gameplay"
      ],
      "source_sentence_hash": "e274b1e84fe0dcc4fa6802baf1cb919219a941541b01043cb3d94db40ea42874",
      "word_count": 7
    },
    {
      "text": "Integrate the request into the scenario that requires the data",
      "section_path": [
        "Designing for games",
        "Jump into gameplay"
      ],
      "source_sentence_hash": "e274b1e84fe0dcc4fa6802baf1cb919219a941541b01043cb3d94db40ea42874",
      "word_count": 10
    },
    {
      "text": "Make sure people spend quality time with your game before requesting a rating or review",
      "section_path": [
        "Designing for games",
        "Jump into gameplay"
      ],
      "source_sentence_hash": "e274b1e84fe0dcc4fa6802baf1cb919219a941541b01043cb3d94db40ea42874",
      "word_count": 14
    },
    {
      "text": "Make sure text is always legible",
      "section_path": [
        "Designing for games",
        "Look stunning on every display"
      ],
      "source_sentence_hash": "2b2f6bb1f76d635d75665a8902f9cbfc80a297476d98270c470f98f6796fa543",
      "word_count": 6
    },
    {
      "text": "Make sure buttons are always easy to use",
      "section_path": [
        "Designing for games",
        "Look stunning on every display"
      ],
      "source_sentence_hash": "909dbabe7e77e62eb577854ba79878e162c88ab845e856ea52cd8320f528d097",
      "word_count": 8
    },
    {
      "text": "Prefer resolution-independent textures and graphics",
      "section_path": [
        "Designing for games",
        "Look stunning on every display"
      ],
      "source_sentence_hash": "805036ae5195db9321f71638df3543a3a332a6a91007464346c17b443335a288",
      "word_count": 5
    },
    {
      "text": "Integrate device features into your layout",
      "section_path": [
        "Designing for games",
        "Look stunning on every display"
      ],
      "source_sentence_hash": "21109dea81ec5538b5618b9a59367b081ed137dd36e256771adab8fd6f0693c7",
      "word_count": 6
    },
    {
      "text": "Make sure in-game menus adapt to different aspect ratios",
      "section_path": [
        "Designing for games",
        "Look stunning on every display"
      ],
      "source_sentence_hash": "f8f3499da12186f97c86ceaadc940bfbe78629c1dd992e279613264762d9ab1d",
      "word_count": 9
    },
    {
      "text": "Avoid fixed layouts as much as possible",
      "section_path": [
        "Designing for games",
        "Look stunning on every display"
      ],
      "source_sentence_hash": "855be2fb47e71ec7a4a7cc44efbb1611cd1e9e4a36e108e05c42212f4e7b1ace",
      "word_count": 7
    },
    {
      "text": "Design for the full-screen experience",
      "section_path": [
        "Designing for games",
        "Look stunning on every display"
      ],
      "source_sentence_hash": "410d37dadccfc909f30808f838841401ad5409390b6500e3c8530521be16b181",
      "word_count": 5
    },
    {
      "text": "Support each platform’s default interaction method",
      "section_path": [
        "Designing for games",
        "Enable intuitive interactions"
      ],
      "source_sentence_hash": "403090f598a9f72dbc287d81ab5330894c6b3b3b49e797cb3ff85c7a9ade2a5d",
      "word_count": 6
    },
    {
      "text": "Support physical game controllers, while also giving people alternatives",
      "section_path": [
        "Designing for games",
        "Enable intuitive interactions"
      ],
      "source_sentence_hash": "fab5585f39b5c8d88351383e87e59127cc86645215fb38f85fa7706fb7cd2321",
      "word_count": 9
    },
    {
      "text": "Offer touch-based game controls that embrace the touchscreen experience on iPhone and iPad",
      "section_path": [
        "Designing for games",
        "Enable intuitive interactions"
      ],
      "source_sentence_hash": "d2efb364535a1ffa92a08a8681c9751a627b66d5e8e639f1d59957c889cbea19",
      "word_count": 13
    },
    {
      "text": "Prioritize perceivability",
      "section_path": [
        "Designing for games",
        "Welcome everyone"
      ],
      "source_sentence_hash": "4eb8e3ea9f1eadf43f9043220143dd3296d2a81dea7ee376801a9443cf8ba9f4",
      "word_count": 2
    },
    {
      "text": "Make sure people can perceive content through sight, hearing, or touch",
      "section_path": [
        "Designing for games",
        "Welcome everyone"
      ],
      "source_sentence_hash": "032c50eb11630ccbfad6871208b7944b715c1ff7ac395dae49ad3df70a03a59c",
      "word_count": 11
    },
    {
      "text": "Text sizes",
      "section_path": [
        "Designing for games",
        "Welcome everyone"
      ],
      "source_sentence_hash": "6f19fd8763f3438aaeb41dc142034b5c43654b0dbc3bc0d15da496ff61e17c5a",
      "word_count": 2
    },
    {
      "text": "Color and effects",
      "section_path": [
        "Designing for games",
        "Welcome everyone"
      ],
      "source_sentence_hash": "014daa03d2919433daa0190724512b90d5471b3965c24eb5501287dbe7ec16ac",
      "word_count": 3
    },
    {
      "text": "Help players personalize their experience",
      "section_path": [
        "Designing for games",
        "Welcome everyone"
      ],
      "source_sentence_hash": "c7025ab36cdcfdb27ae832e9bc51fdd87fab5447168866648882847423496669",
      "word_count": 5
    },
    {
      "text": "Give players the tools they need to represent themselves",
      "section_path": [
        "Designing for games",
        "Welcome everyone"
      ],
      "source_sentence_hash": "9b109d86357f29608919faddc3b8149e3aacead9bd45cd36a65673b7fd6da727",
      "word_count": 9
    },
    {
      "text": "Avoid stereotypes in your stories and characters",
      "section_path": [
        "Designing for games",
        "Welcome everyone"
      ],
      "source_sentence_hash": "59e5a2911ed3975f51a890580d8a6b8a662f829b2ce20b4a52cc1abe615ebd43",
      "word_count": 7
    },
    {
      "text": "Be sure to keep necessary cultural or language references respectful",
      "section_path": [
        "Designing for games",
        "Welcome everyone"
      ],
      "source_sentence_hash": "4fa5867fafc2187bb76eda234ffdc48db9e6c839d63914ac9d1c05024dc36f88",
      "word_count": 10
    },
    {
      "text": "Integrate Game Center to help players discover your game across their devices and connect with their friends",
      "section_path": [
        "Designing for games",
        "Adopt Apple technologies"
      ],
      "source_sentence_hash": "24582d5007253faa0132a9ee0e71f6005a4780630f3d2a610760f6bab30f5eee",
      "word_count": 17
    },
    {
      "text": "Let players pick up their game on any of their devices",
      "section_path": [
        "Designing for games",
        "Adopt Apple technologies"
      ],
      "source_sentence_hash": "af0f09dd4ea9dba80f958934dd646ec0caa883df28001d6a770de9aaed9af7da",
      "word_count": 11
    },
    {
      "text": "Support haptics to help players feel the action",
      "section_path": [
        "Designing for games",
        "Adopt Apple technologies"
      ],
      "source_sentence_hash": "f5a5d1e0b36508500729a5f66149f9283408abf062e13eba5af50f8b8f29b870",
      "word_count": 8
    },
    {
      "text": "Use Spatial Audio to immerse players in your game’s soundscape",
      "section_path": [
        "Designing for games",
        "Adopt Apple technologies"
      ],
      "source_sentence_hash": "144b305f4491eb5a6bc2cbbaf9b90f58f5c95fba14fbf873fcf3d29195a7ebc7",
      "word_count": 10
    },
    {
      "text": "Take advantage of Apple technologies to enable unique gameplay mechanics",
      "section_path": [
        "Designing for games",
        "Adopt Apple technologies"
      ],
      "source_sentence_hash": "9d5d7a61279a4270b5691c0225fa60aa0100c5b70cbc28011643de2771fa0607",
      "word_count": 10
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Designing for games",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
