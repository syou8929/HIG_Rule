  "guidance_candidates": [
    {
      "text": "Determine your app’s voice",
      "section_path": [
        "Writing",
        "Getting started"
      ],
      "source_sentence_hash": "bfe5029c565c8c246deee38774d5be1a287e45d7d2b2252075ad32e2a0eb3d34",
      "word_count": 4
    },
    {
      "text": "Match your tone to the context",
      "section_path": [
        "Writing",
        "Getting started"
      ],
      "source_sentence_hash": "7d695e67f7c070b65d14fdb4e87d5ed79b5d10b824c35c99744725d66651dce8",
      "word_count": 6
    },
    {
      "text": "Be clear",
      "section_path": [
        "Writing",
        "Getting started"
      ],
      "source_sentence_hash": "5ed330a35717aee0c7d513748393a6752f6961ca051be6c45ccda585ff79b16b",
      "word_count": 2
    },
    {
      "text": "Write for everyone",
      "section_path": [
        "Writing",
        "Getting started"
      ],
      "source_sentence_hash": "b4b4f5032a441a51dcd64841d06f96a66c7e65f19d7b598efdfd48a67b6ba471",
      "word_count": 3
    },
    {
      "text": "Consider each screen’s purpose",
      "section_path": [
        "Writing",
        "Best practices"
      ],
      "source_sentence_hash": "035b52b04444c440719d3d80c25bf2cc0af8546a00f53e547e3ee5bd41b54614",
      "word_count": 4
    },
    {
      "text": "Place the most important information first on each screen",
      "section_path": [
        "Writing",
        "Best practices"
      ],
      "source_sentence_hash": "e69ed1ea49453b04d9bafeeffb5ca841ad1cf7a79b6cbd1ccc19e318288855b4",
      "word_count": 9
    },
    {
      "text": "Make text easy to read through formatting",
      "section_path": [
        "Writing",
        "Best practices"
      ],
      "source_sentence_hash": "e69ed1ea49453b04d9bafeeffb5ca841ad1cf7a79b6cbd1ccc19e318288855b4",
      "word_count": 7
    },
    {
      "text": "Consider splitting multiple ideas across screens",
      "section_path": [
        "Writing",
        "Best practices"
      ],
      "source_sentence_hash": "e69ed1ea49453b04d9bafeeffb5ca841ad1cf7a79b6cbd1ccc19e318288855b4",
      "word_count": 6
    },
    {
      "text": "Be action oriented",
      "section_path": [
        "Writing",
        "Best practices"
      ],
      "source_sentence_hash": "02d175df4850f7fa48b1a3d69a2d4e8a20eb0c8d74c81a1ae5cc52e5e618229a",
      "word_count": 3
    },
    {
      "text": "Use verbs to label buttons and links",
      "section_path": [
        "Writing",
        "Best practices"
      ],
      "source_sentence_hash": "e6160d556bcf5128c69de2e8d6d19c0d36f349bd7b971fc2cb43ba05c5b85d6a",
      "word_count": 7
    },
    {
      "text": "Avoid “Click here” in link text",
      "section_path": [
        "Writing",
        "Best practices"
      ],
      "source_sentence_hash": "e6160d556bcf5128c69de2e8d6d19c0d36f349bd7b971fc2cb43ba05c5b85d6a",
      "word_count": 6
    },
    {
      "text": "Build language patterns",
      "section_path": [
        "Writing",
        "Best practices"
      ],
      "source_sentence_hash": "866fb05e187f00dbfbfbfc742ee1d17cc8c2cb174d2541e18f5d337040a22a08",
      "word_count": 3
    },
    {
      "text": "Adopt capitalization rules that align with your app’s style, then apply them consistently",
      "section_path": [
        "Writing",
        "Best practices"
      ],
      "source_sentence_hash": "05c39c12a51a52110f6d1f44f411cf03d23e8c792cd250b3eff0e118e805ea7c",
      "word_count": 13
    },
    {
      "text": "Give clear guidance and use consistent language throughout processes with multiple steps",
      "section_path": [
        "Writing",
        "Best practices"
      ],
      "source_sentence_hash": "db982e3ec9e09d12dbd588f433fb763b7ac70e75bbf742cdde9c49b9e93fbfec",
      "word_count": 12
    },
    {
      "text": "Make it clear when a multistep flow is complete",
      "section_path": [
        "Writing",
        "Best practices"
      ],
      "source_sentence_hash": "dc652ae4fd777da6e0ebd21da4fd6efa8def16cd0bee1a0d5058936ead011d9c",
      "word_count": 9
    },
    {
      "text": "Use possessive pronouns sparingly",
      "section_path": [
        "Writing",
        "Best practices"
      ],
      "source_sentence_hash": "271f0497458f7f8fef4e8aa1fa0556bd86f9d702cd63aed1e4960c5131a9bbb2",
      "word_count": 4
    },
    {
      "text": "Avoid using “we” in interface writing",
      "section_path": [
        "Writing",
        "Best practices"
      ],
      "source_sentence_hash": "5f2cba26ba1e2a0c353d0c57045c42df1e4eeee58cbecd1f260c5ad2af9bc632",
      "word_count": 7
    },
    {
      "text": "Write for how people use each device",
      "section_path": [
        "Writing",
        "Best practices"
      ],
      "source_sentence_hash": "0a3ec9b131023caca40d9fd186024794fa6c7090a6189b4195b16a41bf796ac3",
      "word_count": 7
    },
    {
      "text": "Make sure gesture terms are correct for each device",
      "section_path": [
        "Writing",
        "Best practices"
      ],
      "source_sentence_hash": "055186da479edf070f52c94e84b241fb88047cf65023fdd05f6529332eabbe0c",
      "word_count": 9
    },
    {
      "text": "Keep text brief on small screens and distant displays",
      "section_path": [
        "Writing",
        "Best practices"
      ],
      "source_sentence_hash": "3c2b6164110a8aa362ae893921b117a8318ac32bb046799ebbed6d833f6e8617",
      "word_count": 9
    },
    {
      "text": "For shared TVs, consider who the message addresses",
      "section_path": [
        "Writing",
        "Best practices"
      ],
      "source_sentence_hash": "3c2b6164110a8aa362ae893921b117a8318ac32bb046799ebbed6d833f6e8617",
      "word_count": 8
    },
    {
      "text": "Provide clear next steps on any blank screens",
      "section_path": [
        "Writing",
        "Best practices"
      ],
      "source_sentence_hash": "0d7c1d0da1c1131bf6e64c19099eb1b6219cb105b7696ecf3cfd661a129b8471",
      "word_count": 8
    },
    {
      "text": "Make sure empty-state content is useful and fits its context",
      "section_path": [
        "Writing",
        "Best practices"
      ],
      "source_sentence_hash": "dd6f18856f2e1a147490d5d1dc608a859d80e188ca02297cdf7b0c4319eb958e",
      "word_count": 10
    },
    {
      "text": "Don’t show crucial information only in temporary empty states",
      "section_path": [
        "Writing",
        "Best practices"
      ],
      "source_sentence_hash": "dd6f18856f2e1a147490d5d1dc608a859d80e188ca02297cdf7b0c4319eb958e",
      "word_count": 9
    },
    {
      "text": "Write clear error messages",
      "section_path": [
        "Writing",
        "Best practices"
      ],
      "source_sentence_hash": "23f50044b6866fc9d423b887f9ccacffea5d5579074cc7e23bfcaf597dec5d6c",
      "word_count": 4
    },
    {
      "text": "Choose the right delivery method",
      "section_path": [
        "Writing",
        "Best practices"
      ],
      "source_sentence_hash": "121d779b8a3546675eeb213ffe02f9ed083b3385381627c2a511f53357125c11",
      "word_count": 5
    },
    {
      "text": "Keep settings labels clear and simple",
      "section_path": [
        "Writing",
        "Best practices"
      ],
      "source_sentence_hash": "c3291bcab08c015ae3e158c1f12c0353b4988c63d5ede87d226f24781730766b",
      "word_count": 6
    },
    {
      "text": "Provide a direct link or button to a referenced setting",
      "section_path": [
        "Writing",
        "Best practices"
      ],
      "source_sentence_hash": "c6fb488b574e44923522f858d465f8ab9b16f1e7ae280a0175c2e3ec5f2c4016",
      "word_count": 10
    },
    {
      "text": "Show hints in text fields",
      "section_path": [
        "Writing",
        "Best practices"
      ],
      "source_sentence_hash": "b5a9dbb5b7bedc9736757f028cee641dc062b77c6e63c0868cf5493dadeb206a",
      "word_count": 5
    }
  ],
