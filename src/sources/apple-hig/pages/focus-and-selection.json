  "guidance_candidates": [
    {
      "text": "Rely on system-provided focus effects",
      "section_path": [
        "Focus and selection",
        "Best practices"
      ],
      "source_sentence_hash": "dcf51e735ce3bf949e063393551fc6a975a99ef000051bd31f3423b5ee80425c",
      "word_count": 5
    },
    {
      "text": "Avoid changing focus without people’s interaction",
      "section_path": [
        "Focus and selection",
        "Best practices"
      ],
      "source_sentence_hash": "396dc62acf5577528d7528a7c7fabc248417214135ffd2e03da7eb90089a99ac",
      "word_count": 6
    },
    {
      "text": "Be consistent with the platform as you help people bring focus to items in your app",
      "section_path": [
        "Focus and selection",
        "Best practices"
      ],
      "source_sentence_hash": "3884ad27a832479e1ac37931ba381e8051d4e654414b84b1a842e636c1bb6056",
      "word_count": 16
    },
    {
      "text": "Make sure people can focus every onscreen tvOS element",
      "section_path": [
        "Focus and selection",
        "Best practices"
      ],
      "source_sentence_hash": "0324dfe2fce09d138f9aa8d839724497e420ad163db66677491dd09396c07a44",
      "word_count": 9
    },
    {
      "text": "Indicate focus using visual appearances that are consistent with the platform",
      "section_path": [
        "Focus and selection",
        "Best practices"
      ],
      "source_sentence_hash": "4bb6bbc7615a7a0e1e65389182919eebaa2e37830a4dfadcc18de55f749c031b",
      "word_count": 11
    },
    {
      "text": "In general, use a focus ring for a text or search field, but use a highlight in a list",
      "section_path": [
        "Focus and selection",
        "Best practices"
      ],
      "source_sentence_hash": "16ddc632daa53f6d1e12e91c0a6a39db33138f7d3757e21c4d7586590db0bc75",
      "word_count": 19
    },
    {
      "text": "Pressing the Tab key moves focus among focus groups, letting people navigate to sidebars, grids, and other app areas",
      "section_path": [
        "Focus and selection",
        "Platform considerations",
        "iPadOS"
      ],
      "source_sentence_hash": "e858f544bf25329b01b3e3233937a3082789d5d3338c3ff4374cb888beea7d3a",
      "word_count": 19
    },
    {
      "text": "Pressing an arrow key supports a directional focus interaction that’s similar to tvOS, but limited to navigation among items",
      "section_path": [
        "Focus and selection",
        "Platform considerations",
        "iPadOS"
      ],
      "source_sentence_hash": "adfe567e84ad7b6a70e541efbf5d3e1b0ab59b3d7a927b7f6ff96ecc880562fa",
      "word_count": 19
    },
    {
      "text": "Customize the halo focus effect when necessary",
      "section_path": [
        "Focus and selection",
        "Platform considerations",
        "iPadOS"
      ],
      "source_sentence_hash": "88f243fb1d5b168e23f47cf297610e2dfd614c9c6cdce1e1d5d6a83def4ae431",
      "word_count": 7
    },
    {
      "text": "Use a custom halo focus effect only when necessary",
      "section_path": [
        "Focus and selection",
        "Platform considerations",
        "iPadOS"
      ],
      "source_sentence_hash": "907ed0fe97f44aea0f5856a164a46843bcc2b312a22a4247263c59b2032144db",
      "word_count": 9
    },
    {
      "text": "Ensure that focus moves through your custom views in ways that make sense",
      "section_path": [
        "Focus and selection",
        "Platform considerations",
        "iPadOS"
      ],
      "source_sentence_hash": "b8b14622e2125eb14b63bccf19674ebe507801f9c830c9476b864bfc2475040d",
      "word_count": 13
    },
    {
      "text": "Adjust the priority of an item to reflect its importance within a focus group",
      "section_path": [
        "Focus and selection",
        "Platform considerations",
        "iPadOS"
      ],
      "source_sentence_hash": "092c6b72f0390d6aa0e0247ae959583eb41bb175982eccbe82bd80aaa2d21f0a",
      "word_count": 14
    },
    {
      "text": "Use focus priority to reflect an item’s importance within a focus group",
      "section_path": [
        "Focus and selection",
        "Platform considerations",
        "iPadOS"
      ],
      "source_sentence_hash": "a08fe73d5213424dc43711f0b2d6b2d1004935cb42f7c205fcfa99dca93f692b",
      "word_count": 12
    },
    {
      "text": "In a full-screen experience, let people use gestures to interact with the content, not to move focus",
      "section_path": [
        "Focus and selection",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "46f03b10baaca007920090daeb30d52a2bb0cc05a1dc3e9082922fd05a59a736",
      "word_count": 17
    },
    {
      "text": "Let full-screen gestures interact with content instead of moving focus",
      "section_path": [
        "Focus and selection",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "897a92b493b15fec29f6d9ddf3801d5e8924b774780902caa6e882495b083e94",
      "word_count": 10
    },
    {
      "text": "Avoid displaying a pointer",
      "section_path": [
        "Focus and selection",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "c021db8856b683979cdcfd8a0303252d60f8371649fb10897a41403ea58c2c25",
      "word_count": 4
    },
    {
      "text": "Make sure a required tvOS pointer is highly visible and integrated",
      "section_path": [
        "Focus and selection",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "0920e4049295ddabc49ffdd35891cc4bb23223ebf42d9ccf5daa19630e7b907f",
      "word_count": 11
    },
    {
      "text": "Design your interface to accommodate components in various focus states",
      "section_path": [
        "Focus and selection",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "468abc4728da5ae8d3acd8b4608200ce722bb503727530d7597419a7510cb446",
      "word_count": 10
    },
    {
      "text": "You need to supply larger focused-size assets that remain sharp",
      "section_path": [
        "Focus and selection",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "f7221cac30445985d9c07b45703f35c04d4298e76f22cefe67ee2259891da6e1",
      "word_count": 10
    },
    {
      "text": "Make sure enlarged focused items don’t crowd the surrounding interface",
      "section_path": [
        "Focus and selection",
        "Platform considerations",
        "tvOS"
      ],
      "source_sentence_hash": "f7221cac30445985d9c07b45703f35c04d4298e76f22cefe67ee2259891da6e1",
      "word_count": 10
    },
    {
      "text": "Use hover effects instead of focus effects for visionOS gaze feedback",
      "section_path": [
        "Focus and selection",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "d6628c89798972eef100a6cc17e32b25fd5a4780a154de23208ce692b4369b7d",
      "word_count": 11
    },
    {
      "text": "Developer documentation",
      "section_path": [
        "Focus and selection",
        "Resources",
        "Developer documentation"
      ],
      "source_sentence_hash": "b985db6433c8e9669caebab194ee62b3b3af7505decd93ea111f546d714e1907",
      "word_count": 2
    }
  ],
