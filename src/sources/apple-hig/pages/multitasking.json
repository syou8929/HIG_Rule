  "guidance_candidates": [
    {
      "text": "Make sure apps support multitasking except rare game and visionOS Full Space cases",
      "section_path": [
        "Multitasking"
      ],
      "source_sentence_hash": "e8432b29bb68cecc8c238f45ff0eb6a88b5d8706fed93a6dc0030aea626945ad",
      "word_count": 13
    },
    {
      "text": "Always prepare to save and restore context during multitasking",
      "section_path": [
        "Multitasking",
        "Best practices"
      ],
      "source_sentence_hash": "ddc1a89566554870941c62649f0c306412ed47acc0f69f25addbf81c12e6c494",
      "word_count": 9
    },
    {
      "text": "Use a paused state for attention-dependent activities when people switch away",
      "section_path": [
        "Multitasking",
        "Best practices"
      ],
      "source_sentence_hash": "448f6b1031f83624fc684b9aa2a30029a78f484b9512c6f14f599f335c99e0d1",
      "word_count": 11
    },
    {
      "text": "Make sure people don’t miss activity content when they switch apps",
      "section_path": [
        "Multitasking",
        "Best practices"
      ],
      "source_sentence_hash": "bf551ce583a3f5afce20300fda3c924a7700c678fbbf29952aeb9f1e83529fb1",
      "word_count": 11
    },
    {
      "text": "Let people resume an activity from the context they left",
      "section_path": [
        "Multitasking",
        "Best practices"
      ],
      "source_sentence_hash": "bf551ce583a3f5afce20300fda3c924a7700c678fbbf29952aeb9f1e83529fb1",
      "word_count": 10
    },
    {
      "text": "Respond smoothly to audio interruptions",
      "section_path": [
        "Multitasking",
        "Best practices"
      ],
      "source_sentence_hash": "9a2235c60cc48f30b0dcf6d2bf9424bc9fd215a0fd06e09081462cc694f906d7",
      "word_count": 5
    },
    {
      "text": "Use indefinite audio pauses during primary-audio interruptions",
      "section_path": [
        "Multitasking",
        "Best practices"
      ],
      "source_sentence_hash": "de3f7065f1e43ee36262b3f929537a3130ea6e7aa2dcc0f95e8fb558243aabec",
      "word_count": 7
    },
    {
      "text": "Use temporary volume reduction or pausing for short interruptions, then resume",
      "section_path": [
        "Multitasking",
        "Best practices"
      ],
      "source_sentence_hash": "ddba251b462509c97278abd86ff8d23373430a0045cc4ed1597478a1dd7068dc",
      "word_count": 11
    },
    {
      "text": "Keep user-initiated background tasks running until completion before suspension",
      "section_path": [
        "Multitasking",
        "Best practices"
      ],
      "source_sentence_hash": "7034c419e96cf212885223e6032fb8fc3459e2dab00759231158a819fce5c935",
      "word_count": 9
    },
    {
      "text": "Use notifications sparingly",
      "section_path": [
        "Multitasking",
        "Best practices"
      ],
      "source_sentence_hash": "f312b0dac5e180065b9f0fc1cd78368e374b3092c5c125574b0b02e6b2b13b3e",
      "word_count": 3
    },
    {
      "text": "Consider notifying people when an important or time-sensitive background task completes",
      "section_path": [
        "Multitasking",
        "Best practices"
      ],
      "source_sentence_hash": "ce80bb7f60ebd443f29489e3326ba96f867854d0cbaf3540a90cc5a24246fd30",
      "word_count": 11
    },
    {
      "text": "Avoid notifications for routine or secondary background-task completion",
      "section_path": [
        "Multitasking",
        "Best practices"
      ],
      "source_sentence_hash": "ce80bb7f60ebd443f29489e3326ba96f867854d0cbaf3540a90cc5a24246fd30",
      "word_count": 8
    },
    {
      "text": "Make sure iPadOS apps adapt gracefully to different window sizes",
      "section_path": [
        "Multitasking",
        "Platform considerations",
        "iPadOS"
      ],
      "source_sentence_hash": "2e449769bf6912d8649438896f404abdb9bda295fc2cd3809ed73ca2d2779b6f",
      "word_count": 10
    },
    {
      "text": "Avoid interfering with the system-provided multitasking behavior",
      "section_path": [
        "Multitasking",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "cbd94321e681e47b0ddc1990e308d2ac50845ef094b9507df9d7a2bbcccaa225",
      "word_count": 7
    },
    {
      "text": "Avoid changing visionOS window edges when gaze moves elsewhere",
      "section_path": [
        "Multitasking",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "6a9fc66a3b19c8e3bcda470b303918d99464ecc5e4ce0c42949db015041c55eb",
      "word_count": 9
    },
    {
      "text": "Don’t pause a window’s video playback when people look away from it",
      "section_path": [
        "Multitasking",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "2d36e48ffa06a2bf427c542b63a130a79e186521bf29bbdfa515cbb5ab370bd3",
      "word_count": 12
    },
    {
      "text": "Be prepared for situations where your audio can duck",
      "section_path": [
        "Multitasking",
        "Platform considerations",
        "visionOS"
      ],
      "source_sentence_hash": "d7c67a5d8b1c4ad2dd92e0a69ebe1d7fe255717fe1a281b3d97cd7528f9fbd00",
      "word_count": 9
    },
    {
